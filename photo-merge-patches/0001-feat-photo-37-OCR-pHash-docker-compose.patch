+# 忆述光华 · 本机开发基础设施（阶段 0 · 2026-09-03）
+# 一条命令起齐 4 个服务：docker compose up -d
+# 本机开发用：后端代码在宿主机 uvicorn 直接跑，不打包后端镜像。
+# 注意：与本机其他项目容器（如 minio/mysql-db）互不干扰，统一使用 yishu- 前缀命名。
+name: yishu
+
+services:
+  postgres:
+    image: pgvector/pgvector:pg16
+    container_name: yishu-postgres
+    environment:
+      POSTGRES_USER: postgres
+      POSTGRES_PASSWORD: postgres
+      POSTGRES_DB: yishu
+    ports:
+      - "5432:5432"
+    volumes:
+      - pgdata:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U postgres -d yishu"]
+      interval: 5s
+      timeout: 5s
+      retries: 15
+    restart: unless-stopped
+
+  redis:
+    image: redis:7-alpine
+    container_name: yishu-redis
+    ports:
+      - "6379:6379"
+    volumes:
+      - redisdata:/data
+    healthcheck:
+      test: ["CMD", "redis-cli", "ping"]
+      interval: 5s
+      timeout: 5s
+      retries: 15
+    restart: unless-stopped
+
+  qdrant:
+    image: qdrant/qdrant:v1.19.0
+    container_name: yishu-qdrant
+    ports:
+      - "6333:6333"
+      - "6334:6334"
+    volumes:
+      - qdrantdata:/qdrant/storage
+    restart: unless-stopped
+
+  minio:
+    image: minio/minio
+    container_name: yishu-minio
+    command: server /data --console-address ":9001"
+    environment:
+      MINIO_ROOT_USER: minioadmin
+      MINIO_ROOT_PASSWORD: minioadmin
+    ports:
+      - "9000:9000"
+      - "9001:9001"
+    volumes:
+      - miniodata:/data
+    restart: unless-stopped
+
+  # 一次性初始化：等待 MinIO 就绪后创建 originals / thumbnails 两桶（D2 决策）
+  minio-init:
+    image: minio/mc
+    container_name: yishu-minio-init
+    depends_on:
+      minio:
+        condition: service_started
+    entrypoint: ["/bin/sh", "-c"]
+    command:
+      - |
+        mc alias set local http://minio:9000 minioadmin minioadmin || true
+        for i in $$(seq 1 30); do
+          if mc ls local >/dev/null 2>&1; then break; fi
+          mc alias set local http://minio:9000 minioadmin minioadmin || true
+          echo "waiting for minio ($i/30)..."
+          sleep 2
+        done
+        mc mb -p local/originals || true
+        mc mb -p local/thumbnails || true
+        mc ls local
+        echo "buckets ready"
+    restart: "no"
+
+volumes:
+  pgdata:
+  redisdata:
+  qdrantdata:
+  miniodata:

+"""图片感知哈希（v4 · 阶段 2：imagehash pHash 服务端去重）
+
+决策（用户拍板）：照片去重用 imagehash 库的 pHash——
+同一张照片（改尺寸/重命名/二次导入）pHash 近似，精确重复则相等；
+服务端计算后写入 contents.image_phash，撞同用户已有 → 409/跳过。
+"""
+from __future__ import annotations
+
+import io
+import logging
+
+import imagehash
+from PIL import Image
+
+logger = logging.getLogger("yishu.photo")
+
+# PIL 解压炸弹防护（与缩略图管线同口径：40MP 上限）
+MAX_IMAGE_PIXELS = 40_000_000
+
+
+def compute_phash(image_bytes: bytes) -> str:
+    """计算图片 pHash（64 位十六进制字符串）
+
+    失败（非图片/损坏/超尺寸/超时）抛 ValueError/Exception，调用方自行降级：
+    服务端 pHash 失败时回退客户端 perceptual_hash（旧契约兜底）。
+    """
+    Image.MAX_IMAGE_PIXELS = MAX_IMAGE_PIXELS
+    try:
+        img = Image.open(io.BytesIO(image_bytes))
+    except Image.DecompressionBombError as exc:
+        raise ValueError(f"图片尺寸超限（解压炸弹）: {MAX_IMAGE_PIXELS} 像素上限") from exc
+    except Exception as exc:  # noqa: BLE001 —— 不可解码
+        raise ValueError(f"图片解码失败: {type(exc).__name__}") from exc
+    if img.width * img.height > MAX_IMAGE_PIXELS:
+        raise ValueError(f"图片尺寸超限: {img.width}x{img.height} > {MAX_IMAGE_PIXELS} 像素")
+    try:

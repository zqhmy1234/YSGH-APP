<template>
<!-- 卡12 F2a 存储与备份（2026-09-02 画布 JSON 真值整体重写）
     真值：.wt/missing-pages/uvue_gen/storage_canvas.json（60:565 · 63 节点）
     布局锚点：settings.uvue 二级页骨架（导航/卡片/行/toggle 全套项目先例）
     容量分区：后端无分类型字节 → 分类行诚实空态；总量接真 total_bytes（BA1 · FE2） -->
	<view class="page-root">
		<!-- 铁律 11.5：返回图标必须排在标题容器之后，否则被全宽标题盖住收不到 @tap（settings.uvue 先例） -->
		<view class="nav-title">
			<text class="nav-title-text">存储与备份</text>
		</view>
		<image class="nav-back" src="/static/icons/i4_135.svg" @tap="goBack" />

		<view class="list-flow">
			<!-- ═══ 卡1 · 存储用量（画布 60:606：容量分区 · radius 16 · 无阴影）
			     BA1（FE2）：总量接真字节 total_bytes（daily-summary），后端无分类型字节
			     → 照片/语音/文字分类行诚实空态（值 '—' · 填充 0），不造假分布 -->
			<view class="usage-card">
				<text class="usage-title">存储用量</text>
				<view class="usage-main-row">
					<text class="usage-num">{{ totalSize }}</text>
					<text class="usage-total">/ 128 GB</text>
				</view>
				<view class="cat-row">
					<view class="cat-dot cat-dot-photo"></view>
					<text class="cat-label">照片</text>
					<view class="cat-track">
						<view class="cat-fill cat-fill-photo" :style="{ width: photoFill }"></view>
					</view>
					<view class="cat-val-wrap"><text class="cat-val">{{ photoVal }}</text></view>
				</view>
				<view class="cat-row">
					<view class="cat-dot cat-dot-voice"></view>
					<text class="cat-label">语音</text>
					<view class="cat-track">
						<view class="cat-fill cat-fill-voice" :style="{ width: voiceFill }"></view>
					</view>
					<view class="cat-val-wrap"><text class="cat-val">{{ voiceVal }}</text></view>
				</view>
				<view class="cat-row">
					<view class="cat-dot cat-dot-text"></view>
					<text class="cat-label">文字</text>
					<view class="cat-track">
						<view class="cat-fill cat-fill-text" :style="{ width: textFill }"></view>
					</view>
					<view class="cat-val-wrap"><text class="cat-val">{{ textVal }}</text></view>
				</view>
			</view>

			<!-- ═══ 卡2 · 同步与备份（画布 60:570：自动同步「已开启」/ 上次同步 今天 17:42 / 待补传+一键重试） ═══ -->
			<view class="card card-gap">
				<view class="srow">
					<image class="srow-icon" src="/static/icons/storage-lock.svg" />
					<text class="srow-label">自动同步</text>
					<text class="srow-state">{{ syncOn ? '已开启' : '已暂停' }}</text>
				</view>
				<view class="srow">
					<image class="srow-icon" src="/static/icons/storage-bell.svg" />
					<text class="srow-label">上次同步</text>
					<text class="srow-time">{{ lastSyncText }}</text>
				<view class="toggle" :style="syncOn ? 'justify-content: flex-end;' : 'justify-content: flex-start;'" @tap="toggleSync"> <!-- 开关：滑块位置随状态（settings notifyOn 同款先例）；峰宝 09-03 反馈不可切换 -->
					<view class="toggle-knob"></view>
				</view>
				</view>
				<view v-if="pendingN > 0" class="srow">
					<view class="pending-dot"></view>
					<text class="srow-pending">{{ pendingN }} 条记忆待补传</text>
					<view class="retry-btn" @tap="onRetry">
						<text class="retry-btn-text">{{ retrying ? '重试中…' : '一键重试' }}</text>
					</view>
				</view>
				<view class="flow-hint">
					<text class="flow-hint-text">WiFi 传原图，蜂窝网络仅传缩略图与元数据</text>
				</view>
			</view>

			<!-- ═══ 卡3 · 数据管理（画布 60:571：回收站 + 导出全部记忆）
			     卡2→卡3 间距：画布原值 ~3pt（60:570 hug 底 → 60:571 y642）＝生成缺陷级贴死，
			     峰宝拍板（2026-09-02）覆盖为与卡1→卡2 同节奏 24pt，已登记 _diff_ledger.md -->
			<view class="card card-gap">
				<view class="srow" @tap="goTrash">
					<image class="srow-icon" src="/static/icons/i4_161.svg" />
					<text class="srow-label">回收站</text>
					<text class="srow-meta">{{ trashText }}</text>
				</view>
				<view class="srow" @tap="onExport">
					<image class="srow-icon" src="/static/icons/icon-refresh.svg" />
					<text class="srow-label">导出全部记忆</text>
					<text class="srow-meta">{{ cacheText }}</text>
					<image class="chev" src="/static/icons/i4_145.svg" />
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { onLoad, onShow } from '@dcloudio/uni-app'
	import { pendingSyncCount, isSyncPaused, runSyncChain, getLastSyncAt } from '@/utils/sync_client'
	import { pauseSync, resumeSync } from '@/utils/pause_controller'
	import { fetchExportFilePath } from '@/utils/api'
	import { fetchTotalBytes, fmtBytes } from '@/utils/capsule_api'
	import { formatIsoShortTime } from '@/utils/time'

	// ── 同步状态（真数据：sync_client 真实状态）──
	let pendingN = ref(0)
	let syncOn = ref(true)
	let retrying = ref(false)
	let exporting = ref(false)
	// 上次同步：B7（BB1）sync_client 已落盘 yishu_last_sync_at（ISO）→ onShow 读真值；
	// 无记录/空串保持「—」诚实空态
	let lastSyncText = ref('—')

	// ── 存储用量（BA1 · FE2 接真）──
	// 总量 = GET /api/v1/stats/daily-summary → total_bytes（该用户未删除内容 size_bytes
	// 求和；后端 coalesce 归 0，出参缺省按 0 处理），fmtBytes 格式化 KB/MB/GB。
	// 请求失败保持 '—'（api 层已全局 toast 显式原因，对齐本页 onExport 失败显式风格）。
	// 后端无分类型字节 → 照片/语音/文字分类行诚实空态（值 '—' · 填充 0），不造假分布。
	let totalSize = ref('—')
	let photoVal = ref('—')
	let voiceVal = ref('—')
	let textVal = ref('—')
	let photoFill = ref('0rpx')   // 分类填充宽（后端无分类型数据恒 0）
	let voiceFill = ref('0rpx')
	let textFill = ref('0rpx')

	// ── 数据管理（回收站文案为画布静态说明；缓存值无端点 → 诚实「—」）──
	let trashText = ref('30 天后清除')
	let cacheText = ref('—')

	onLoad(() => {
		loadUsage()
	})
	onShow(() => {
		// 同步真实状态 + 用量刷新（从回收站等子页返回时回读）
		pendingN.value = pendingSyncCount()
		syncOn.value = !isSyncPaused()
		refreshLastSync()
		loadUsage()
	})

	/** 上次同步真值（B7 · BB1）：ISO → MM-dd HH:mm（time.formatIsoShortTime 项目先例）；
	 *  无记录保持「—」 */
	function refreshLastSync(): void {
		const last = getLastSyncAt()
		if (last != '') {
			lastSyncText.value = formatIsoShortTime(last)
		}
	}

	/** 拉真字节总量（fetchTotalBytes；失败 -1 → 保持 '—'，api 层已全局 toast） */
	function loadUsage(): void {
		fetchTotalBytes().then((n: number) => {
			if (n < 0) {
				return
			}
			totalSize.value = fmtBytes(n)
		})
	}

	/** 一键重试：runSyncChain（补推→增量拉，内部全路径 resolve 永不 reject），完成后刷新待补传数 */
	/** 自动同步开关（峰宝 09-03 真机反馈「不可滑动」）：切换 pause_controller 真状态，滑块位置随 syncOn */
	function toggleSync(): void {
		syncOn.value = !syncOn.value
		if (syncOn.value) {
			resumeSync()
		} else {
			pauseSync('手动暂停同步')
		}
		uni.showToast({ title: syncOn.value ? '已开启同步' : '已暂停同步', icon: 'none', duration: 1500 })
	}

	function onRetry(): void {
		if (retrying.value) {
			return
		}
		retrying.value = true
		uni.showLoading({ title: '同步中…', mask: true })
		runSyncChain().then(() => {
			pendingN.value = pendingSyncCount()
			refreshLastSync()
			uni.hideLoading()
			retrying.value = false
			if (pendingN.value > 0) {
				uni.showToast({ title: '仍有 ' + pendingN.value + ' 条待下轮重试', icon: 'none' })
			} else {
				uni.showToast({ title: '同步完成', icon: 'success' })
			}
		})
	}

	/** 导出：GET /api/v1/export 全量 JSON（US-42 拍板链路恢复 · 总账 A9 关单）
	 * 通路 fetchExportFilePath（api.uts，header 带 token 的 downloadFile 既有拍板）：
	 * 成功 toast + 失败诚实提示；exporting 防重入（onRetry 同款） */
	function onExport(): void {
		if (exporting.value) {
			return
		}
		exporting.value = true
		uni.showLoading({ title: '导出中…', mask: true })
		fetchExportFilePath().then((path: string) => {
			uni.hideLoading()
			exporting.value = false
			if (path == '') {
				uni.showToast({ title: '导出失败，请检查网络后重试', icon: 'none' })
				return
			}
			uni.showToast({ title: '导出成功', icon: 'success' })
		})
	}

	function goTrash(): void {
		uni.navigateTo({ url: '/pages/storage/trash' })
	}

	function goBack(): void {
		// 铁律：reLaunch/redirectTo 直入时页面栈仅 1 页，navigateBack 静默失败 → 回落首页（settings.uvue 先例）
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/index/index' })
		}
	}
</script>


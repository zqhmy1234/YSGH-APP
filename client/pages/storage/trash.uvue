<template>
	<!-- 卡13 · F2b 回收站（2026-09-02 按画布 JSON 真值整体重写）
	     真值：.wt/missing-pages/uvue_gen/trash_canvas.json（60:629，390×844 · 36 节点）
	     SCALE=750/390=1.9231；节点坐标/颜色/字号/圆角/阴影全部取自 JSON，逐节点换算。
	     状态栏 9:41/电池=系统自绘（画布节点不还原，同全库先例）。
	     诚实化：后端无回收站列表/恢复/清空端点（软删数据在后端 deleted_at，无列表 API）→
	     默认空态；USE_MOCK_TRASH=true 常开 F2b 帧内三条演示行供视觉对拍（对齐 USE_MOCK_* 项目先例）。
	     恢复/清空=诚实 toast（A3 总账；真数据挂 W2-1 删除端点）。 -->
	<view class="page-root">
		<!-- 铁律 11.5：返回图标排在标题容器之后，否则被全宽标题盖住收不到 @tap（settings.uvue 先例） -->
		<view class="nav-title">
			<text class="nav-title-text">回收站</text>
		</view>
		<image class="nav-back" src="/static/icons/i4_135.svg" @tap="goBack" />

		<view class="list-flow">
			<text class="hint-line">删除的记忆将保留 30 天，之后彻底清除</text>

			<!-- 空态（画布无空态帧，自造；语义对齐回收站规则；真数据空时兜底） -->
			<view v-if="items.length == 0" class="empty-card">
				<image class="empty-icon" src="/static/icons/storage-moon.svg" />
				<text class="empty-title">回收站是空的</text>
				<text class="empty-sub">删除的记忆将在这里保留 30 天</text>
			</view>

			<!-- 列表（F2b 60:636：白底圆角卡 + 三行 = 圆底类型图标 + 标题/删除meta + 恢复） -->
			<view v-else class="card">
				<view v-for="it in items" :key="it.id" class="trow">
					<view class="tico" :class="ticoCls(it.kind)">
						<image class="tico-img" :src="iconOf(it.kind)" />
					</view>
					<view class="tmain">
						<text class="ttitle">{{ it.title }}</text>
						<text class="tmeta">{{ it.meta }}</text>
					</view>
					<!-- R4 修复（2026-09-05 验机实锤）：text@tap 小字号热区真机点击无响应（连点5次零请求），
					     改 view 容器承载 @tap（对齐项目内 view@tap 100% 可靠实证：清空按钮/菜单行） -->
					<view class="trestore-btn" @tap="onRestore(it)">
						<text class="trestore">恢复</text>
					</view>
				</view>
			</view>

			<!-- 清空（F2b 60:671 白底圆角行 + 60:673 灰色警示行；空态隐藏） -->
			<view v-if="items.length > 0" class="clear-btn" @tap="onClearAll">
				<text class="clear-btn-text">清空回收站</text>
			</view>
			<text v-if="items.length > 0" class="clear-hint">清空后 {{ clearCount }} 条记忆将立即彻底删除，不可恢复</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'

	// mock 开关（对齐 USE_MOCK_TIMELINE/USE_MOCK_STORAGE 先例）。
	// W2-1 端点已上线（2026-09-05）：GET /api/v1/trash + restore + 清空，真数据切换
	// （峰宝拍板「删除/回收站端点上线后改 false 并接真数据」兑现）
	const USE_MOCK_TRASH = false

	import { get, post, request, dataArr, dataObj, showErrorToast } from '@/utils/api'

	class TrashItem {
		id: string
		title: string
		meta: string
		kind: string // photo / voice / text
		constructor(id: string, title: string, meta: string, kind: string) {
			this.id = id
			this.title = title
			this.meta = meta
			this.kind = kind
		}
	}

	let items = ref<Array<TrashItem>>([])
	// 清空警示条条数：mock 时=画布真值「5 条记忆」；真数据时=实际条数
	let clearCount = ref(0)

	/** TrashItemOut（后端 W2-1）→ 页面行模型；title 缺省按类型取名（照片无 text 字段） */
	function mapTrashRow(o: UTSJSONObject): TrashItem {
		const id = o.getString('id') ?? ''
		const ct = o.getString('content_type') ?? 'text'
		const txt = o.getString('text') ?? ''
		const place = o.getString('place') ?? ''
		const deletedAt = o.getString('deleted_at') ?? ''
		const daysLeft = o.getNumber('days_left') ?? 0
		let title = txt != '' ? txt : place
		if (title == '') {
			if (ct == 'photo') { title = '照片' } else if (ct == 'voice') { title = '语音' } else { title = '文字' }
		}
		// 删除日 = deleted_at 截取 ISO 前 10 位 →「M月D日 删除」；days_left 后端已算好
		let delDate = ''
		if (deletedAt.length >= 10) {
			const mm = parseInt(deletedAt.substring(5, 7))
			const dd = parseInt(deletedAt.substring(8, 10))
			delDate = mm + '月' + dd + '日'
		}
		const meta = delDate + ' 删除 · ' + daysLeft + ' 天后清除'
		return new TrashItem(id, title, meta, ct)
	}

	/** 拉回收站真数据（resolve-only，失败=空态诚实） */
	function fetchTrash(): void {
		get('/api/v1/trash').then((res: UTSJSONObject | null) => {
			if (res == null) {
				items.value = []
				clearCount.value = 0
				return
			}
			const arr = dataArr(res)
			const rows: Array<TrashItem> = []
			for (let i = 0; i < arr.length; i++) {
				rows.push(mapTrashRow(arr[i]))
			}
			items.value = rows
			clearCount.value = rows.length
		})
	}

	onLoad(() => {
		if (USE_MOCK_TRASH) {
			// F2b 帧内三条演示数据（仅供视觉对拍，非真数据）
			items.value = [
				new TrashItem('m1', '陪妈逛菜市场（照片 · 4 张）', '8月30日 删除 · 12 天后清除', 'photo'),
				new TrashItem('m2', '周五聚餐（语音 2\'18"）', '8月28日 删除 · 10 天后清除', 'voice'),
				new TrashItem('m3', '读《活着》想到的（文字）', '8月20日 删除 · 2 天后清除', 'text')
			]
			clearCount.value = 5
		} else {
			fetchTrash()
		}
	})

	function ticoCls(kind: string): string {
		if (kind == 'photo') {
			return 'tico-photo'
		}
		if (kind == 'voice') {
			return 'tico-voice'
		}
		return 'tico-text'
	}
	function iconOf(kind: string): string {
		if (kind == 'photo') {
			return '/static/icons/trash-check.svg'
		}
		if (kind == 'voice') {
			return '/static/icons/trash-mic.svg'
		}
		return '/static/icons/trash-info.svg'
	}

	/** 恢复（W2-1 真端点）：POST /api/v1/trash/{id}/restore 成功后就地移除行 */
	function onRestore(it: TrashItem): void {
		post('/api/v1/trash/' + it.id + '/restore', {}).then((res: UTSJSONObject | null) => {
			if (res == null) {
				return
			}
			const rows: Array<TrashItem> = []
			for (let i = 0; i < items.value.length; i++) {
				if (items.value[i].id != it.id) {
					rows.push(items.value[i])
				}
			}
			items.value = rows
			clearCount.value = rows.length
			uni.showToast({ title: '已恢复', icon: 'none' })
		})
	}

	/** 清空（W2-1 真端点）：强确认 → DELETE /api/v1/trash（彻底删除，不可逆） */
	function onClearAll(): void {
		uni.showModal({
			title: '清空回收站',
			content: clearCount.value + ' 条记忆将立即彻底删除，不可恢复。确定清空吗？',
			confirmText: '清空',
			confirmColor: '#B05A3A',
			success: (res) => {
				if (!res.confirm) {
					return
				}
				request('/api/v1/trash', 'DELETE', null).then((res2: UTSJSONObject | null) => {
					if (res2 == null) {
						return
					}
					fetchTrash()
					uni.showToast({ title: '回收站已清空', icon: 'none' })
				})
			}
		})
	}

	function goBack(): void {
		// 铁律：reLaunch/redirectTo 直入时页面栈仅 1 页，navigateBack 静默失败 → 回落首页
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/index/index' })
		}
	}
</script>

<style>
	.page-root {
		flex: 1;
		flex-direction: column;
		font-family: "Sarasa Gothic SC", sans-serif;
		background-color: #F8F7F4;
	}
	/* ── 导航（60:633 标题 / 60:632 返回，settings.uvue 二级页先例） ── */
	.nav-title {
		position: absolute;
		/* absolute-ok: 固定页头·标题容器（全宽居中） */
		left: 0rpx;
		top: 115.4rpx;
		width: 750rpx;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}
	.nav-title-text {
		font-family: "Sarasa Gothic SC", sans-serif;

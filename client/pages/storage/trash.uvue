		color: #3A2E25;
	}
	.tmeta {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 23.1rpx;
		color: #8A7A6A;
		margin-top: 3.8rpx;
	}
	/* R4：view 热区容器（padding 扩大点击面积，负 margin 抵消布局位移） */
	.trestore-btn {
		padding-left: 20rpx;
		padding-right: 20rpx;
		padding-top: 24rpx;
		padding-bottom: 24rpx;
		margin-right: -20rpx;
		margin-top: -24rpx;
		margin-bottom: -24rpx;
	}
	.trestore {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 21.2rpx;
		color: #C4913C;
	}
	/* ── 清空行（60:671：白底 · 圆角 14pt · 高 48pt；文字 60:672 居中） ── */
	.clear-btn {
		width: 100%;
		height: 92.3rpx;
		background-color: #FFFFFF;
		border-radius: 26.9rpx;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		margin-top: 92.3rpx;
	}
	.clear-btn-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 600;
		font-size: 26.9rpx;
		color: #B05A3A;
	}
	.clear-hint {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 21.2rpx;
		color: #B3A696;
		text-align: center;
		width: 100%;
		margin-top: 15.4rpx;
	}
	/* ── 空态（自造，画布无空态帧；真数据空时兜底展示） ── */
	.empty-card {
		width: 100%;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding-top: 90rpx;
		padding-bottom: 90rpx;
		background-color: #FFFFFF;
		box-shadow: 0rpx 5.8rpx 23.1rpx rgba(59, 46, 38, 0.05);
		border-radius: 38.5rpx;
		margin-top: 38.5rpx;
	}
	.empty-icon {
		width: 56rpx;

		/* absolute-ok: 固定页头·返回钮（铁律 11.5 DOM 顺序约束） */
		left: 30.8rpx;
		top: 115.4rpx;
		width: 42.3rpx;
		height: 42.3rpx;
		z-index: 1;
	}
	/* ── 流（60:634 说明横幅 → 60:636 列表 → 60:671 清空行 → 60:673 清空说明） ── */
	.list-flow {
		margin-top: 215.4rpx;
		padding-left: 38.5rpx;
		padding-right: 38.5rpx;
		flex-direction: column;
	}
	.hint-line {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 600;
		font-size: 23.1rpx;
		line-height: 30.8rpx;
		color: #8A7A6A;
	}
	/* ── 回收站列表卡（60:636：白底 · 圆角 20pt · 阴影 y3/r12 · 内边距 6pt） ── */
	.card {
		width: 100%;
		flex-direction: column;
		padding-left: 11.5rpx;
		padding-right: 11.5rpx;
		padding-top: 11.5rpx;
		padding-bottom: 11.5rpx;
		background-color: #FFFFFF;
		box-shadow: 0rpx 5.8rpx 23.1rpx rgba(59, 46, 38, 0.05);
		border-radius: 38.5rpx;
		margin-top: 38.5rpx;
		overflow: hidden;
	}
	.trow {
		flex-direction: row;

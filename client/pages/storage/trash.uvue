	}
	.tico {
		width: 76.9rpx;
		height: 76.9rpx;
		border-radius: 38.5rpx;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}
	/* 图标底=JSON fill 色 @低透明度叠白底（颜色×1.9231 无透明度通道 → 按画布混合值） */
	.tico-photo {
		background-color: #F6EBE7;
	}
	.tico-voice {
		background-color: #ECEFE8;
	}

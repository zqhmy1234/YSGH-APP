<template>
	<view class="page">
		<view class="header">
			<text class="header-title serif">记录</text>
			<text class="header-sub">记下此刻，未来回响</text>
		</view>

		<!-- 分段切换：文字 / 语音 -->
		<view class="seg">
			<view class="seg-item" :class="mode === 'text' ? 'seg-active' : ''" @tap="switchMode('text')">
				<text class="seg-text" :class="mode === 'text' ? 'seg-text-active' : ''">文字</text>
			</view>
			<view class="seg-item" :class="mode === 'voice' ? 'seg-active' : ''" @tap="switchMode('voice')">
				<text class="seg-text" :class="mode === 'voice' ? 'seg-text-active' : ''">语音</text>
			</view>
		</view>

		<!-- ═══════════ 文字入口（T-TX-1/2）═══════════ -->
		<view v-if="mode === 'text'" class="text-panel">
			<textarea
				class="text-input serif"
				v-model="draft"
				placeholder="此刻在想什么？记下来…"
				:maxlength="2000"
			/>
			<view class="text-actions">
				<text class="muted">分类：{{ classifyLabel }}</text>
				<view class="btn" @tap="submitText">
					<text class="btn-text">{{ submitting ? '整理中…' : '记下来' }}</text>
				</view>
			</view>
			<!-- 分类标签（可点改 → 三层裁决 T-TX-2） -->
			<view v-if="classifyLabel != '' && classifyLabel != '整理中…'" class="tag-row">
				<text class="tag-hint">分类不对？点标签纠正：</text>
				<view class="tag-list">
					<view v-for="t in allLabels" :key="t.key" class="tag" :class="t.key === currentLabel ? 'tag-active' : ''" @tap="onTagTap(t.key)">
						<text class="tag-text">{{ t.cn }}</text>
					</view>
				</view>
			</view>
		</view>

		<!-- ═══════════ 语音入口（T-AU-1/2/3 + B5a J-4/J-7）═══════════ -->
		<view v-else class="voice-panel">
			<!-- 录音控制 -->
			<view class="record-box">
				<view class="mic-btn" :class="recording ? 'mic-recording' : ''" @tap="toggleRecord">
					<text class="mic-icon">{{ recording ? '⏹' : '🎤' }}</text>
				</view>
				<text class="record-hint">{{ recordHint }}</text>
				<text v-if="recording" class="record-timer">{{ recordSeconds }}s</text>
				<!-- J-7：中断/暂停状态 + 恢复按钮 -->
				<view v-if="recording && (recState === 'interrupted' || recState === 'paused')" class="interrupt-bar">
					<text class="interrupt-text">{{ recState === 'interrupted' ? '录音被来电/系统中断，已暂停' : '已暂停' }}</text>
					<view class="resume-btn" @tap="resumeRecordNow">
						<text class="resume-text">继续录音</text>
					</view>
				</view>
			</view>

			<!-- 转写结果（可编辑 T-AU-3） -->
			<view v-if="transcribing" class="center-box">
				<text class="muted">正在转写…</text>
			</view>
			<view v-else-if="transcript != ''" class="transcript-box">
				<view class="transcript-head">
					<text class="transcript-title serif">转写结果</text>
					<text v-if="emotion != ''" class="emotion-chip">情绪：{{ emotion }}</text>
				</view>
				<view v-if="voiceHints != ''" class="voice-hints">
					<text class="muted">{{ voiceHints }}</text>
				</view>
				<textarea class="text-input serif" v-model="transcript" :maxlength="2000" />
				<view class="text-actions">
					<text class="muted">{{ guardMsg }}</text>
					<view class="btn" @tap="submitVoice">
						<text class="btn-text">{{ saving ? '保存中…' : '确认入库' }}</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 底部 Tab -->
		<yishu-tabbar current="record" />
	</view>
		<!-- 玻璃 TabBar（半透明白 55% + 中央＋按钮） -->
		<view class="glass-tabbar">
			<view class="tabbar-item  pressable" @tap="goIndex">
				<text class="tabbar-icon">🏠</text>
				<text class="tabbar-label">时间轴</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goSearch">
				<text class="tabbar-icon">🔍</text>
				<text class="tabbar-label">搜索</text>
			</view>
			<view class="tabbar-fab pressable" @tap="goRecord">
				<text class="tabbar-fab-icon">+</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goMessages">
				<text class="tabbar-icon">💬</text>
				<text class="tabbar-label">消息</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goProfile">
				<text class="tabbar-icon">👤</text>
				<text class="tabbar-label">我的</text>
			</view>
		</view>

</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { ensureLogin } from '@/utils/auth'
	import { labelCn, createTextContent, submitClassify, pollClassify, submitCorrection, submitArbitrate, pollArbitrate, ALL_LABELS } from '@/utils/text_recorder'
	import {
		startRecord,
		stopRecord,
		resumeRecord,
		setShouldResume,
		recorderState,
		transcribeWav,
		saveVoiceContent,
		uploadVoicePersistent,
		REC_STATE_PAUSED
	} from '@/utils/voice'
	import { showErrorToast } from '@/utils/api'

	// 响应式数据
	let mode = 'text'
	let draft = ''
	let submitting = false
	let classifyLabel = ''
	let currentLabel = ''
	let lastContentId = ''
	let lastText = ''
	let allLabels = ALL_LABELS
	let recording = false
	let recordSeconds = 0
	let recordTimer = 0 as number
	let recState = 'idle'
	let recordHint = '点击开始录音（≤30 分钟）'
	let voiceHints = ''
	let transcribing = false
	let transcript = ''
	let emotion = ''
	let guardMsg = ''
	let saving = false
	let lastVoiceDuration = 0
	let lastVoiceFile = ''

	// 生命周期
	onLoad(() => {
		ensureLogin().then((ok: boolean) => {
			if (!ok) {
				showErrorToast(new Error('登录失败，请重试'))
			}
		})
	})
	onUnload(() => {
		if (recordTimer > 0) {
			clearInterval(recordTimer)
			recordTimer = 0
		}
	})

	// 导航方法
	function goIndex(): void {
		uni.navigateTo({ url: '/pages/index/index' })
	}
	function goSearch(): void {
		uni.navigateTo({ url: '/pages/search/search' })
	}
	function goRecord(): void {
		uni.navigateTo({ url: '/pages/record/record' })
	}
	function goMessages(): void {
		uni.navigateTo({ url: '/pages/messages/messages' })
	}
	function goProfile(): void {
		uni.navigateTo({ url: '/pages/profile/profile' })
	}

	// 文字记录方法
	function switchMode(m: string): void {
		mode = m
	}
	function submitText(): void {
		const text = draft.trim()
		console.log('[yishu] submitText: ' + text)
		if (text == '') {
			showErrorToast(new Error('先写点什么吧'))
			return
		}
		submitting = true
		classifyLabel = '整理中…'
		currentLabel = ''
		createTextContent(text).then((contentId: string | null) => {
			console.log('[yishu] createTextContent -> ' + contentId)
			if (contentId == null) {
				submitting = false
				classifyLabel = ''
				return
			}
			lastContentId = contentId
			lastText = text
			draft = ''
			submitClassify(text).then((jobId: string | null) => {
				console.log('[yishu] submitClassify -> ' + jobId)
				if (jobId == null) {
					submitting = false
					classifyLabel = '已记录'
					uni.showToast({ title: '已记下', icon: 'success' })
					return
				}
				pollClassify(jobId, 20, 3000).then((result) => {
					console.log('[yishu] pollClassify done, result=' + (result != null ? result.label : 'null'))
					submitting = false
					if (result != null) {
						currentLabel = result.label
						classifyLabel = result.labelCn
						uni.showToast({ title: '已分类：' + result.labelCn, icon: 'none' })
					} else {
						classifyLabel = '已记录（分类暂不可用）'
						uni.showToast({ title: '已记下', icon: 'success' })
					}
				})
			})
		})
	}
	function onTagTap(key: string): void {
		if (lastContentId == '' || key === currentLabel) {
			return
		}
		const oldLabel = currentLabel
		currentLabel = key
		classifyLabel = '纠正中…'
		submitArbitrate(lastText).then((jobId: string | null) => {
			if (jobId == null) {
				classifyLabel = labelCn(key)
				submitCorrection(lastContentId, lastText, key, oldLabel).then((ok: boolean) => {
					uni.showToast({ title: ok ? '已纠正' : '纠错记录失败', icon: 'none' })
				})
				return
			}
			pollArbitrate(jobId, 20, 3000).then((finalLabel: string | null) => {
				if (finalLabel != null) {
					currentLabel = finalLabel
					classifyLabel = labelCn(finalLabel)
					submitCorrection(lastContentId, lastText, finalLabel, oldLabel)
					uni.showToast({ title: '已纠正为：' + labelCn(finalLabel), icon: 'none' })
				} else {
					currentLabel = key
					classifyLabel = labelCn(key)
					submitCorrection(lastContentId, lastText, key, oldLabel)
					uni.showToast({ title: '已纠正', icon: 'none' })
				}
			})
		})
	}

	// 语音录音方法
	function toggleRecord(): void {
		if (recording) {
			stopRecordNow()
		} else {
			recording = true
			recordSeconds = 0
			recState = 'idle'
			recordHint = '录音中，再点停止'
			transcript = ''
			emotion = ''
			guardMsg = ''
			voiceHints = ''
			lastVoiceFile = ''
			setShouldResume(true)
			recordTimer = setInterval(() => {
				recordSeconds++
			}, 1000) as number
			startRecord(
				() => {
					console.log('[yishu] record started')
				},
				(path: string, durationMs: number) => {
					onRecordStopped(path, durationMs)
				},
				(msg: string) => {
					console.error('[yishu] record error: ' + msg)
					recording = false
					recState = 'idle'
					recordHint = '点击开始录音（≤30 分钟）'
					if (recordTimer > 0) {
						clearInterval(recordTimer)
						recordTimer = 0
					}
					showErrorToast(new Error('录音失败：' + msg))
				},
				(autoPaused: boolean) => {
					console.log('[yishu] record interrupted (autoPaused=' + autoPaused + ')')
					recState = recorderState()
					recordHint = '录音被中断，已暂停'
				},
				(path: string, durationMs: number) => {
					console.log('[yishu] record auto-stop at 30min, saving segment: ' + durationMs + 'ms')
					onRecordStopped(path, durationMs)
				}
			)
		}
	}
	function resumeRecordNow(): void {
		resumeRecord()
		recState = recorderState()
		recordHint = recState == REC_STATE_PAUSED ? '录音中，再点停止' : '已继续录音'
	}
	function stopRecordNow(): void {
		stopRecord()
	}
	function onRecordStopped(path: string, durationMs: number): void {
		recording = false
		recState = 'idle'
		recordHint = '点击开始录音（≤30 分钟）'
		if (recordTimer > 0) {
			clearInterval(recordTimer)
			recordTimer = 0
		}
		if (durationMs < 500) {
			showErrorToast(new Error('录音太短'))
			return
		}
		lastVoiceDuration = durationMs
		lastVoiceFile = path
		transcribing = true
		if (durationMs >= 300000) {
			transcribing = false
			voiceHints = '长录音已提交，云端整理中（>5min 自动分段转写）'
			uploadVoicePersistent(path, durationMs).then((res: UTSJSONObject | null) => {
				console.log('[yishu] long voice uploaded: ' + (res != null ? JSON.stringify(res) : 'null'))
			})
			return
		}
		transcribeWav(path).then((res) => {
			transcribing = false
			if (res == null) {
				return
			}
			transcript = res.text
			emotion = res.emotion
			const hints: Array<string> = []
			if (res.notOral) {
				hints.push('疑似非口述（键盘/环境音）')
			}
			if (res.silenceHint) {
				hints.push('检测到静音空段，可删除')
			}
			const merge = res.emotionMerge
			if (merge != null) {
				const dm = merge.getJSON('dominant')
				if (dm != null) {
					hints.push('主导情绪：' + (dm.getString('emotion') ?? '') + '（时长最长段）')
				}
			}
			if (res.noiseWeight == 'equal') {
				hints.push('噪音较大，情绪权重已降为持平')
			}
			voiceHints = hints.join('；')
			if (!res.guardPassed) {
				guardMsg = '内容未通过安全审核：' + res.guardReason
			} else {
				guardMsg = res.channel + ' 通道' + (res.mock ? '（mock）' : '') + ' · 置信度 ' + Math.round(res.confidence * 100) + '%'
			}
		})
	}
	function submitVoice(): void {
		const text = transcript.trim()
		if (text == '') {
			showErrorToast(new Error('转写内容为空'))
			return
		}
		saving = true
		saveVoiceContent(text, lastVoiceDuration, emotion, '', lastVoiceFile).then((contentId: string | null) => {
			saving = false
			if (contentId != null) {
				uni.showToast({ title: '已入库', icon: 'success' })
				transcript = ''
				emotion = ''
				guardMsg = ''
				voiceHints = ''
			} else {
				showErrorToast(new Error('入库失败'))
			}
		})
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #f8f7f4;
		padding-left: 0;
		padding-right: 0;
		padding-top: 88rpx;
		padding-bottom: 140rpx;
	}
	.serif {
		font-family: "Noto Serif CJK SC", serif;
	}
	.header {
		padding-top: 24rpx;
		padding-bottom: 24rpx;
	}
	.header-title {
		font-size: 52rpx;
		color: #3a2e25;
		font-weight: bold;
		letter-spacing: 6rpx;
	}
	.header-sub {
		margin-top: 8rpx;
		font-size: 26rpx;
		color: #8a7a6a;
	}

	/* 分段切换 */
	.seg {
		display: flex;
		flex-direction: row;
		background-color: #EBE3D4;
		border-radius: 10rpx;
		padding: 6rpx;
		margin-bottom: 28rpx;
	}
	.seg-item {
		flex: 1;
		align-items: center;
		justify-content: center;
		padding-top: 14rpx;
		padding-bottom: 14rpx;
		border-radius: 8rpx;
	}
	.seg-active {
		background-color: #ffffff;
	}
	.seg-text {
		font-size: 28rpx;
		color: #8a7a6a;
	}
	.seg-text-active {
		color: #3a2e25;
		font-weight: bold;
	}

	/* 文字面板 */
	.text-panel {
		display: flex;
		flex-direction: column;
	}
	.text-input {
		background-color: #ffffff;
		border-radius: 8rpx;
		padding: 24rpx;
		min-height: 280rpx;
		font-size: 30rpx;
		color: #3a2e25;
		box-shadow: 0 6rpx 16rpx rgba(58, 46, 37, 0.12);
	}
	.text-actions {
		margin-top: 24rpx;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}
	.muted {
		font-size: 24rpx;
		color: #b3a696;
	}
	.btn {
		padding-left: 48rpx;
		padding-right: 48rpx;
		padding-top: 18rpx;
		padding-bottom: 18rpx;
		background-color: #b05a3a;
		border-radius: 8rpx;
	}
	.btn-text {
		color: #f8f7f4;
		font-size: 28rpx;
	}

	/* 分类标签（纠错触点） */
	.tag-row {
		margin-top: 32rpx;
		display: flex;
		flex-direction: column;
	}
	.tag-hint {
		font-size: 24rpx;
		color: #8a7a6a;
		margin-bottom: 12rpx;
	}
	.tag-list {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
	}
	.tag {
		padding-left: 24rpx;
		padding-right: 24rpx;
		padding-top: 10rpx;
		padding-bottom: 10rpx;
		background-color: #EBE3D4;
		border-radius: 24rpx;
		margin-right: 16rpx;
		margin-bottom: 12rpx;
	}
	.tag-active {
		background-color: #b05a3a;
	}
	.tag-text {
		font-size: 24rpx;
		color: #3a2e25;
	}
	.tag-active .tag-text {
		color: #f8f7f4;
	}

	/* 语音面板 */
	.voice-panel {
		display: flex;
		flex-direction: column;
	}
	.record-box {
		align-items: center;
		padding-top: 40rpx;
		padding-bottom: 40rpx;
		display: flex;
		flex-direction: column;
	}
	.mic-btn {
		width: 160rpx;
		height: 160rpx;
		border-radius: 80rpx;
		background-color: #b05a3a;
		align-items: center;
		justify-content: center;
		display: flex;
		box-shadow: 0 8rpx 20rpx rgba(176, 90, 58, 0.4);
	}
	.mic-recording {
		background-color: #3a2e25;
	}
	.mic-icon {
		font-size: 64rpx;
		color: #f8f7f4;
	}
	.record-hint {
		margin-top: 24rpx;
		font-size: 26rpx;
		color: #8a7a6a;
	}
	.record-timer {
		margin-top: 12rpx;
		font-size: 40rpx;
		color: #b05a3a;

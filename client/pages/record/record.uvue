	const playIcon = `<svg viewBox="0 0 6 7" xmlns="http://www.w3.org/2000/svg"><path d="M0 0L5.5 3.25L0 6.5L0 0Z"/></svg>`
	const waveIcon = `<svg viewBox="0 0 183 22" xmlns="http://www.w3.org/2000/svg"><path d="M49.2 20L49.2 0Q49.2145 -0.5031 48.8485 -0.8485Q48.5031 -1.2145 48 -1.2Q47.4969 -1.2145 47.1515 -0.8485Q46.7855 -0.5031 46.8 0L46.8 20Q46.7855 20.5031 47.1515 20.8485Q47.4969 21.2145 48 21.2Q48.5031 21.2145 48.8485 20.8485Q49.2145 20.5031 49.2 20ZM109.2 19L109.2 1Q109.2145 0.4969 108.8485 0.1515Q108.5031 -0.2145 108 -0.2Q107.4969 -0.2145 107.1515 0.1515Q106.7855 0.4969 106.8 1L106.8 19Q106.7855 19.5031 107.1515 19.8485Q107.4969 20.2145 108 20.2Q108.5031 20.2145 108.8485 19.8485Q109.2145 19.5031 109.2 19ZM25.2 18L25.2 2Q25.2145 1.4969 24.8485 1.1515Q24.5031 0.7855 24 0.8Q23.4969 0.7855 23.1515 1.1515Q22.7855 1.4969 22.8 2L22.8 18Q22.7855 18.5031 23.1515 18.8485Q23.4969 19.2145 24 19.2Q24.5031 19.2145 24.8485 18.8485Q25.2145 18.5031 25.2 18ZM73.2 18L73.2 2Q73.2145 1.4969 72.8485 1.1515Q72.503 0.7855 72 0.8Q71.4969 0.7855 71.1515 1.1515Q70.7855 1.4969 70.8 2L70.8 18Q70.7855 18.5031 71.1515 18.8485Q71.4969 19.2145 72 19.2Q72.503 19.2145 72.8485 18.8485Q73.2145 18.5031 73.2 18ZM97.2 17L97.2 3Q97.2145 2.4969 96.8485 2.1515Q96.503 1.7855 96 1.8Q95.4969 1.7855 95.1515 2.1515Q94.7855 2.4969 94.8 3L94.8 17Q94.7855 17.5031 95.1515 17.8485Q95.4969 18.2145 96 18.2Q96.503 18.2145 96.8485 17.8485Q97.2145 17.5031 97.2 17ZM133.2 17L133.2 3Q133.2145 2.4969 132.8485 2.1515Q132.5031 1.7855 132 1.8Q131.4969 1.7855 131.1515 2.1515Q130.7855 2.4969 130.8 3L130.8 17Q130.7855 17.5031 131.1515 17.8485Q131.4969 18.2145 132 18.2Q132.5031 18.2145 132.8485 17.8485Q133.2145 17.5031 133.2 17ZM157.2 16L157.2 4Q157.2145 3.4969 156.8485 3.1515Q156.503 2.7855 156 2.8Q155.4969 2.7855 155.1515 3.1515Q154.7855 3.4969 154.8 4L154.8 16Q154.7855 16.5031 155.1515 16.8485Q155.4969 17.2145 156 17.2Q156.503 17.2145 156.8485 16.8485Q157.2145 16.5031 157.2 16ZM61.2 15L61.2 5Q61.2145 4.4969 60.8485 4.1515Q60.5031 3.7855 60 3.8Q59.4969 3.7855 59.1515 4.1515Q58.7855 4.4969 58.8 5L58.8 15Q58.7855 15.5031 59.1515 15.8485Q59.4969 16.2145 60 16.2Q60.5031 16.2145 60.8485 15.8485Q61.2145 15.5031 61.2 15ZM13.2 14L13.2 6Q13.2145 5.4969 12.8485 5.1515Q12.5031 4.7855 12 4.8Q11.4969 4.7855 11.1515 5.1515Q10.7855 5.4969 10.8 6L10.8 14Q10.7855 14.5031 11.1515 14.8485Q11.4969 15.2145 12 15.2Q12.5031 15.2145 12.8485 14.8485Q13.2145 14.5031 13.2 14ZM121.2 14L121.2 6Q121.2145 5.4969 120.8485 5.1515Q120.5031 4.7855 120 4.8Q119.4969 4.7855 119.1515 5.1515Q118.7855 5.4969 118.8 6L118.8 14Q118.7855 14.5031 119.1515 14.8485Q119.4969 15.2145 120 15.2Q120.5031 15.2145 120.8485 14.8485Q121.2145 14.5031 121.2 14ZM181.2 14L181.2 6Q181.2145 5.4969 180.8485 5.1515Q180.5031 4.7855 180 4.8Q179.4969 4.7855 179.1515 5.1515Q178.7855 5.4969 178.8 6L178.8 14Q178.7855 14.5031 179.1515 14.8485Q179.4969 15.2145 180 15.2Q180.5031 15.2145 180.8485 14.8485Q181.2145 14.5031 181.2 14ZM37.2 13L37.2 7Q37.2145 6.4969 36.8485 6.1515Q36.5031 5.7855 36 5.8Q35.4969 5.7855 35.1515 6.1515Q34.7855 6.4969 34.8 7L34.8 13Q34.7855 13.5031 35.1515 13.8485Q35.4969 14.2145 36 14.2Q36.5031 14.2145 36.8485 13.8485Q37.2145 13.5031 37.2 13ZM145.2 13L145.2 7Q145.2145 6.4969 144.8485 6.1515Q144.5031 5.7855 144 5.8Q143.4969 5.7855 143.1515 6.1515Q142.7855 6.4969 142.8 7L142.8 13Q142.7855 13.5031 143.1515 13.8485Q143.4969 14.2145 144 14.2Q144.5031 14.2145 144.8485 13.8485Q145.2145 13.5031 145.2 13ZM85.2 12L85.2 8Q85.2145 7.4969 84.8485 7.1515Q84.5031 6.7855 84 6.8Q83.4969 6.7855 83.1515 7.1515Q82.7855 7.4969 82.8 8L82.8 12Q82.7855 12.5031 83.1515 12.8485Q83.4969 13.2145 84 13.2Q84.5031 13.2145 84.8485 12.8485Q85.2145 12.5031 85.2 12ZM169.2 12L169.2 8Q169.2145 7.4969 168.8485 7.1515Q168.503 6.7855 168 6.8Q167.4969 6.7855 167.1515 7.1515Q166.7855 7.4969 166.8 8L166.8 12Q166.7855 12.5031 167.1515 12.8485Q167.4969 13.2145 168 13.2Q168.503 13.2145 168.8485 12.8485Q169.2145 12.5031 169.2 12ZM193.2 11L193.2 9Q193.2144 8.4969 192.8485 8.1515Q192.5031 7.7855 192 7.8Q191.4969 7.7855 191.1515 8.1515Q190.7855 8.4969 190.8 9L190.8 11Q190.7855 11.5031 191.1515 11.8485Q191.4969 12.2145 192 12.2Q192.5031 12.2145 192.8485 11.8485Q193.2144 11.5031 193.2 11Z"/></svg>`


	// ===== 响应式数据 =====
	// 弹层 / 表单状态
	let formMode = ''
	let formTitle = '写几句'
	let saveText = '记下来'
	let photoPreview = ''
	// 文字记录
	let draft = ''
	let submitting = false
	let classifyLabel = ''
	let currentLabel = ''
	let lastContentId = ''
	let lastText = ''
	let allLabels = ALL_LABELS
	// 语音记录
	let recording = false
	let recordSeconds = 0
	let recordTimer = 0 as number
	let recState = 'idle'
	let recordHint = '点击开始录音（≤30 分钟）'
	let voiceHints = ''
	let transcribing = false
	let transcript = ''
	let emotion = ''
	let guardMsg = ''
	let saving = false
	let lastVoiceDuration = 0
	let lastVoiceFile = ''

	// ===== 生命周期 =====
	onLoad(() => {
		ensureLogin().then((ok: boolean) => {
			if (!ok) {
				showErrorToast(new Error('登录失败，请重试'))
			}
		})
	})
	onUnload(() => {
		if (recordTimer > 0) {
			clearInterval(recordTimer)
			recordTimer = 0
		}
	})

	// ===== 弹层交互 =====
	function openMode(m: string): void {
		formMode = m
		if (m == 'photo') {
			formTitle = '拍照'
			saveText = '保存'
		} else if (m == 'gallery') {
			formTitle = '选照片'
			saveText = '保存'
		} else if (m == 'voice') {
			formTitle = '说一段'
			saveText = '确认入库'
		} else {
			formTitle = '写几句'
			saveText = '记下来'
		}
	}
	function closeForm(): void {
		// 录音中返回弹层：停止录音，避免后台空转
		if (recording) {
			stopRecordNow()
		}
		formMode = ''
	}
	function onSave(): void {
		if (formMode == 'text') {
			submitText()
		} else if (formMode == 'voice') {
			submitVoice()
		} else {
			savePhoto()
		}
	}

	// ===== 照片 / 相册（uni.chooseImage，保存后端待接入 → 仅本地预览提示） =====
	function pickPhoto(): void {
		const srcs: Array<string> = formMode == 'photo' ? ['camera'] : ['album']
		uni.chooseImage({
			count: 1,
			sourceType: srcs,
			success: (res) => {
				const tp = res.tempFilePaths[0]
				if (tp != null) {
					photoPreview = tp
				}
			},
			fail: () => {
				showErrorToast(new Error('未选择照片'))
			}
		})
	}
	function savePhoto(): void {
		if (photoPreview == '') {
			showErrorToast(new Error('请先拍照或选一张照片'))
			return
		}
		uni.showToast({ title: '照片记录后端待接入，已保留本地预览', icon: 'none' })
	}

	// ===== 文字记录方法 =====
	function submitText(): void {
		const text = draft.trim()
		console.log('[yishu] submitText: ' + text)
		if (text == '') {
			showErrorToast(new Error('先写点什么吧'))
			return
		}
		submitting = true
		classifyLabel = '整理中…'
		currentLabel = ''
		createTextContent(text).then((contentId: string | null) => {
			console.log('[yishu] createTextContent -> ' + contentId)
			if (contentId == null) {
				submitting = false
				classifyLabel = ''
				return
			}
			lastContentId = contentId
			lastText = text
			draft = ''
			submitClassify(text).then((jobId: string | null) => {
				console.log('[yishu] submitClassify -> ' + jobId)
				if (jobId == null) {
					submitting = false
					classifyLabel = '已记录'
					uni.showToast({ title: '已记下', icon: 'success' })
					return
				}
				pollClassify(jobId, 20, 3000).then((result) => {
					console.log('[yishu] pollClassify done, result=' + (result != null ? result.label : 'null'))
					submitting = false
					if (result != null) {
						currentLabel = result.label
						classifyLabel = result.labelCn
						uni.showToast({ title: '已分类：' + result.labelCn, icon: 'none' })
					} else {
						classifyLabel = '已记录（分类暂不可用）'
						uni.showToast({ title: '已记下', icon: 'success' })
					}
				})
			})
		})
	}
	function onTagTap(key: string): void {
		if (lastContentId == '' || key === currentLabel) {
			return
		}
		const oldLabel = currentLabel
		currentLabel = key
		classifyLabel = '纠正中…'
		submitArbitrate(lastText).then((jobId: string | null) => {
			if (jobId == null) {
				classifyLabel = labelCn(key)
				submitCorrection(lastContentId, lastText, key, oldLabel).then((ok: boolean) => {
					uni.showToast({ title: ok ? '已纠正' : '纠错记录失败', icon: 'none' })
				})
				return
			}
			pollArbitrate(jobId, 20, 3000).then((finalLabel: string | null) => {
				if (finalLabel != null) {
					currentLabel = finalLabel
					classifyLabel = labelCn(finalLabel)
					submitCorrection(lastContentId, lastText, finalLabel, oldLabel)
					uni.showToast({ title: '已纠正为：' + labelCn(finalLabel), icon: 'none' })
				} else {
					currentLabel = key
					classifyLabel = labelCn(key)
					submitCorrection(lastContentId, lastText, key, oldLabel)
					uni.showToast({ title: '已纠正', icon: 'none' })
				}
			})
		})
	}

	// ===== 语音录音方法 =====
	function toggleRecord(): void {
		if (recording) {
			stopRecordNow()
		} else {
			recording = true
			recordSeconds = 0
			recState = 'idle'
			recordHint = '录音中，再点停止'
			transcript = ''
			emotion = ''
			guardMsg = ''
			voiceHints = ''
			lastVoiceFile = ''
			setShouldResume(true)
			recordTimer = setInterval(() => {
				recordSeconds++
			}, 1000) as number
			startRecord(
				() => {
					console.log('[yishu] record started')
				},
				(path: string, durationMs: number) => {
					onRecordStopped(path, durationMs)
				},
				(msg: string) => {
					console.error('[yishu] record error: ' + msg)
					recording = false
					recState = 'idle'
					recordHint = '点击开始录音（≤30 分钟）'
					if (recordTimer > 0) {
						clearInterval(recordTimer)
						recordTimer = 0
					}
					showErrorToast(new Error('录音失败：' + msg))
				},
				(autoPaused: boolean) => {
					console.log('[yishu] record interrupted (autoPaused=' + autoPaused + ')')
					recState = recorderState()
					recordHint = '录音被中断，已暂停'
				},
				(path: string, durationMs: number) => {
					console.log('[yishu] record auto-stop at 30min, saving segment: ' + durationMs + 'ms')
					onRecordStopped(path, durationMs)
				}
			)
		}
	}
	function resumeRecordNow(): void {
		resumeRecord()
		recState = recorderState()
		recordHint = recState == REC_STATE_PAUSED ? '录音中，再点停止' : '已继续录音'
	}
	function stopRecordNow(): void {
		stopRecord()
	}
	function onRecordStopped(path: string, durationMs: number): void {
		recording = false
		recState = 'idle'
		recordHint = '点击开始录音（≤30 分钟）'
		if (recordTimer > 0) {
			clearInterval(recordTimer)
			recordTimer = 0
		}
		if (durationMs < 500) {
			showErrorToast(new Error('录音太短'))
			return
		}
		lastVoiceDuration = durationMs
		lastVoiceFile = path
		transcribing = true
		if (durationMs >= 300000) {
			transcribing = false
			voiceHints = '长录音已提交，云端整理中（>5min 自动分段转写）'
			uploadVoicePersistent(path, durationMs).then((res: UTSJSONObject | null) => {
				console.log('[yishu] long voice uploaded: ' + (res != null ? JSON.stringify(res) : 'null'))
			})
			return
		}
		transcribeWav(path).then((res) => {
			transcribing = false
			if (res == null) {
				return
			}
			transcript = res.text
			emotion = res.emotion
			const hints: Array<string> = []
			if (res.notOral) {
				hints.push('疑似非口述（键盘/环境音）')
			}
			if (res.silenceHint) {
				hints.push('检测到静音空段，可删除')
			}
			const merge = res.emotionMerge
			if (merge != null) {
				const dm = merge.getJSON('dominant')
				if (dm != null) {
					hints.push('主导情绪：' + (dm.getString('emotion') ?? '') + '（时长最长段）')
				}
			}
			if (res.noiseWeight == 'equal') {
				hints.push('噪音较大，情绪权重已降为持平')
			}
			voiceHints = hints.join('；')
			if (!res.guardPassed) {
				guardMsg = '内容未通过安全审核：' + res.guardReason
			} else {
				guardMsg = res.channel + ' 通道' + (res.mock ? '（mock）' : '') + ' · 置信度 ' + Math.round(res.confidence * 100) + '%'
			}
		})
	}
	function submitVoice(): void {
		const text = transcript.trim()
		if (text == '') {
			showErrorToast(new Error('转写内容为空'))
			return
		}
		saving = true
		saveVoiceContent(text, lastVoiceDuration, emotion, '', lastVoiceFile).then((contentId: string | null) => {
			saving = false
			if (contentId != null) {
				uni.showToast({ title: '已入库', icon: 'success' })
				transcript = ''
				emotion = ''
				guardMsg = ''
				voiceHints = ''
			} else {
				showErrorToast(new Error('入库失败'))
			}
		})
	}
</script>

<style>
	/* 视觉规范 v3：像素级还原 SVG 设计稿（390x844 画布）

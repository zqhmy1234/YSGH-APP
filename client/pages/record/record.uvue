		top: 0;
		left: 0;
		width: 750rpx;
		height: 100%;
		background-color: rgba(26, 20, 15, 0.55);
		z-index: 10;
	}

	/* ═══════ 底部弹层：新的记忆 ═══════ */
	.sheet {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 654rpx;
		background-color: #faf9f5;
		border-top-left-radius: 77rpx;
		border-top-right-radius: 77rpx;

<template>
	<view class="page">
		<!-- ═══════════ 背景层：时间轴主页（压暗前，仅作设计稿背景） ═══════════ -->
		<view class="backdrop">
			<image class="hero-photo" src="/static/hero-lake.jpg" mode="aspectFill" />
			<view class="hero-shade-top"></view>
			<view class="hero-shade-bottom"></view>

			<!-- 顶部 hero：标题 + 头像 -->
			<text class="hero-title serif">回忆</text>
			<view class="hero-avatar">
				<text class="hero-avatar-char serif">峰</text>
			</view>
			<text class="hero-sub1">八月 · 28 条新记忆</text>
			<text class="hero-sub2">清晨的湖边，风很轻 · 8月28日 07:42</text>

			<!-- 搜索胶囊 -->
			<view class="search-capsule">
				<image class="search-icon" src="/static/icons/record-search.svg" :width="14" :height="14" />
				<text class="search-placeholder">描述一段回忆，帮你找</text>
			</view>

			<!-- 日期 + 分隔线 -->
			<text class="date-label">8月28日 · 星期五</text>
			<view class="divider"></view>

			<!-- 语音卡（弹层之上露出的顶部） -->
			<view class="voice-card">
				<view class="voice-inner">
					<view class="play-btn">
						<image src="/static/icons/record-play.svg" :width="11" :height="13" />
					</view>
					<image class="wave" src="/static/icons/record-wave.svg" :width="182" :height="22" />
				</view>
				<text class="voice-title">和妈妈的通话</text>
				<text class="voice-meta">8月27日 12:36 · 语音 3分12秒 · 已转写</text>
			</view>
		</view>

		<!-- ═══════════ 模态遮罩（55% 暗色，压暗背景） ═══════════ -->
		<view class="scrim"></view>

		<!-- ═══════════ 底部弹层：新的记忆（设计稿默认态） ═══════════ -->
		<view class="sheet">
			<view class="grab"></view>
			<text class="sheet-title">新的记忆</text>
			<view class="sheet-options">
				<view class="option" @tap="openMode('photo')">
					<view class="option-circle c-photo">
						<image src="/static/icons/record-camera.svg" :width="22" :height="19" />
					</view>
					<text class="option-label">拍照</text>
				</view>
				<view class="option" @tap="openMode('gallery')">
					<view class="option-circle c-gallery">
						<image src="/static/icons/record-gallery.svg" :width="21" :height="18" />
					</view>
					<text class="option-label">选照片</text>
				</view>
				<view class="option" @tap="openMode('voice')">
					<view class="option-circle c-voice">
						<image src="/static/icons/record-mic.svg" :width="17" :height="22" />
					</view>
					<text class="option-label">说一段</text>
				</view>
				<view class="option" @tap="openMode('text')">
					<view class="option-circle c-text">
						<image src="/static/icons/record-keyboard.svg" :width="20" :height="20" />
					</view>
					<text class="option-label">写几句</text>
				</view>
			</view>
			<view class="home-indicator"></view>
			<text class="sheet-hint">长按 + 可直达完整记录表单</text>
		</view>

		<!-- ═══════════ 功能层：选中入口后的记录表单 ═══════════ -->
		<view v-if="formMode != ''" class="form-layer">
			<view class="form-head">
				<view class="form-back" @tap="closeForm">
					<text class="form-back-text">‹</text>
				</view>
				<text class="form-title serif">{{ formTitle }}</text>
				<view class="form-save" @tap="onSave">
					<text class="form-save-text">{{ saveText }}</text>
				</view>
			</view>
			<scroll-view class="form-scroll">
				<!-- 文字入口 -->
				<view v-if="formMode == 'text'" class="form-body">
					<textarea class="text-input serif" v-model="draft" placeholder="此刻在想什么？记下来…" :maxlength="2000" />
					<view class="text-actions">
						<text class="muted">分类：{{ classifyLabel }}</text>
					</view>
					<view v-if="classifyLabel != '' && classifyLabel != '整理中…'" class="tag-row">
						<text class="tag-hint">分类不对？点标签纠正：</text>
						<view class="tag-list">
							<view v-for="t in allLabels" :key="t.key" class="tag" :class="t.key === currentLabel ? 'tag-active' : ''" @tap="onTagTap(t.key)">
								<text class="tag-text" :class="t.key === currentLabel ? 'tag-active-text' : ''">{{ t.cn }}</text>
							</view>
						</view>
					</view>
				</view>
				<!-- 语音入口 -->
				<view v-else-if="formMode == 'voice'" class="form-body">
					<view class="record-box">
						<view class="mic-btn" :class="recording ? 'mic-recording' : ''" @tap="toggleRecord">
							<text class="mic-icon">{{ recording ? '⏹' : '🎤' }}</text>
						</view>
						<text class="record-hint">{{ recordHint }}</text>
						<text v-if="recording" class="record-timer">{{ recordSeconds }}s</text>
						<view v-if="recording && (recState === 'interrupted' || recState === 'paused')" class="interrupt-bar">
							<text class="interrupt-text">{{ recState === 'interrupted' ? '录音被来电/系统中断，已暂停' : '已暂停' }}</text>
							<view class="resume-btn" @tap="resumeRecordNow">
								<text class="resume-text">继续录音</text>
							</view>
						</view>
					</view>
					<view v-if="transcribing" class="center-box">
						<text class="muted">正在转写…</text>
					</view>
					<view v-else-if="transcript != ''" class="transcript-box">
						<view class="transcript-head">
							<text class="transcript-title serif">转写结果</text>
							<text v-if="emotion != ''" class="emotion-chip">情绪：{{ emotion }}</text>
						</view>
						<view v-if="voiceHints != ''" class="voice-hints">
							<text class="muted">{{ voiceHints }}</text>
						</view>
						<textarea class="text-input serif" v-model="transcript" :maxlength="2000" />
						<view class="text-actions">
							<text class="muted">{{ guardMsg }}</text>
						</view>
					</view>
				</view>
				<!-- 照片 / 相册入口 -->
				<view v-else class="form-body">
					<view class="photo-box" @tap="pickPhoto">
						<image v-if="photoPreview != ''" class="photo-preview" :src="photoPreview" mode="aspectFill" />
						<view v-else class="photo-empty">
							<image src="/static/icons/record-camera-gray.svg" :width="40" :height="36" />
							<text class="photo-empty-text">{{ formMode == 'photo' ? '点击拍照' : '点击从相册选择' }}</text>
						</view>
					</view>
					<textarea class="text-input serif" v-model="draft" placeholder="补充一句此刻的感想（可选）" :maxlength="500" />
					<view class="text-actions">
						<text class="muted">拍摄或选择后点保存，将上传到你的记忆库</text>
					</view>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { ensureLogin } from '@/utils/auth'
	import { labelCn, createTextContent, submitClassify, pollClassify, submitCorrection, submitArbitrate, pollArbitrate, ALL_LABELS } from '@/utils/text_recorder'
	import {
		startRecord,
		stopRecord,
		resumeRecord,
		setShouldResume,
		recorderState,
		transcribeWav,
		saveVoiceContent,
		uploadVoicePersistent,
		REC_STATE_PAUSED
	} from '@/utils/voice'
	import { showErrorToast } from '@/utils/api'
	import { uploadBatch, UploadProgress, UploadedPhoto } from '@/utils/uploader'
	import { PhotoItem } from '@/uni_modules/yishu-photo-watch/utssdk/app-android/index.uts'

	// ===== 设计稿图标（已落成 /static/icons/*.svg 静态资源） =====


	// ===== 响应式数据 =====
	// 弹层 / 表单状态
	let formMode = ''
	let formTitle = '写几句'
	let saveText = '记下来'
	let photoPreview = ''
	let photoSize = 0
	let photoUploading = false
	// 文字记录
	let draft = ''
	let submitting = false
	let classifyLabel = ''
	let currentLabel = ''
	let lastContentId = ''
	let lastText = ''
	let allLabels = ALL_LABELS
	// 语音记录
	let recording = false
	let recordSeconds = 0
	let recordTimer = 0 as number
	let recState = 'idle'
	let recordHint = '点击开始录音（≤30 分钟）'
	let voiceHints = ''
	let transcribing = false
	let transcript = ''
	let emotion = ''
	let guardMsg = ''
	let saving = false
	let lastVoiceDuration = 0
	let lastVoiceFile = ''

	// ===== 生命周期 =====
	onLoad(() => {
		ensureLogin().then((ok: boolean) => {
			if (!ok) {
				showErrorToast(new Error('登录失败，请重试'))
			}
		})
	})
	onUnload(() => {
		if (recordTimer > 0) {
			clearInterval(recordTimer)
			recordTimer = 0
		}
	})

	// ===== 弹层交互 =====
	function openMode(m: string): void {
		formMode = m
		if (m == 'photo') {
			formTitle = '拍照'
			saveText = '保存'
		} else if (m == 'gallery') {
			formTitle = '选照片'
			saveText = '保存'
		} else if (m == 'voice') {
			formTitle = '说一段'
			saveText = '确认入库'
		} else {
			formTitle = '写几句'
			saveText = '记下来'
		}
	}
	function closeForm(): void {
		// 录音中返回弹层：停止录音，避免后台空转
		if (recording) {
			stopRecordNow()
		}
		formMode = ''
	}
	function onSave(): void {
		if (formMode == 'text') {
			submitText()
		} else if (formMode == 'voice') {
			submitVoice()
		} else {
			savePhoto()
		}
	}

	// ===== 照片 / 相册（uni.chooseImage，保存后端待接入 → 仅本地预览提示） =====
	function pickPhoto(): void {
		const srcs: Array<string> = formMode == 'photo' ? ['camera'] : ['album']
		uni.chooseImage({
			count: 1,
			sourceType: srcs,
			success: (res) => {
				const tp = res.tempFilePaths[0]
				if (tp != null) {
					photoPreview = tp
				}
				const tf = res.tempFiles[0]
				if (tf != null) {
					photoSize = tf.size
				}
			},
			fail: () => {
				showErrorToast(new Error('未选择照片'))
			}
		})
	}
	function savePhoto(): void {
		if (photoPreview == '') {
			showErrorToast(new Error('请先拍照或选一张照片'))
			return
		}
		if (photoUploading) {
			return
		}
		photoUploading = true
		uni.showLoading({ title: '上传中…', mask: true })
		const now = Date.now()
		// 手动选图无 MediaStore id，用负时间戳作临时 id（上传只用 path/size/takenAt）
		const item = new PhotoItem(-now, photoPreview, now, 0, 0, null, null, photoSize)
		const items: Array<PhotoItem> = [item]
		uploadBatch(items, (p: UploadProgress): void => {}).then((uploaded: Array<UploadedPhoto>) => {
			uni.hideLoading()
			photoUploading = false
			if (uploaded.length > 0) {
				uni.showToast({ title: '照片已保存', icon: 'success' })
				photoPreview = ''
				photoSize = 0
				closeForm()
			} else {
				uni.showToast({ title: '上传失败，请重试', icon: 'none' })
			}
		})
	}

	// ===== 文字记录方法 =====
	function submitText(): void {
		const text = draft.trim()
		console.log('[yishu] submitText: ' + text)
		if (text == '') {
			showErrorToast(new Error('先写点什么吧'))
			return
		}
		submitting = true
		classifyLabel = '整理中…'
		currentLabel = ''
		createTextContent(text).then((contentId: string | null) => {
			console.log('[yishu] createTextContent -> ' + contentId)
			if (contentId == null) {
				submitting = false
				classifyLabel = ''
				return
			}
			lastContentId = contentId
			lastText = text
			draft = ''
			submitClassify(text).then((jobId: string | null) => {
				console.log('[yishu] submitClassify -> ' + jobId)
				if (jobId == null) {
					submitting = false
					classifyLabel = '已记录'
					uni.showToast({ title: '已记下', icon: 'success' })
					return
				}
				pollClassify(jobId, 20, 3000).then((result) => {
					console.log('[yishu] pollClassify done, result=' + (result != null ? result.label : 'null'))
					submitting = false
					if (result != null) {
						currentLabel = result.label
						classifyLabel = result.labelCn
						uni.showToast({ title: '已分类：' + result.labelCn, icon: 'none' })
					} else {
						classifyLabel = '已记录（分类暂不可用）'
						uni.showToast({ title: '已记下', icon: 'success' })
					}
				})
			})
		})
	}
	function onTagTap(key: string): void {
		if (lastContentId == '' || key === currentLabel) {
			return
		}
		const oldLabel = currentLabel
		currentLabel = key
		classifyLabel = '纠正中…'
		submitArbitrate(lastText).then((jobId: string | null) => {
			if (jobId == null) {
				classifyLabel = labelCn(key)
				submitCorrection(lastContentId, lastText, key, oldLabel).then((ok: boolean) => {
					uni.showToast({ title: ok ? '已纠正' : '纠错记录失败', icon: 'none' })
				})
				return
			}
			pollArbitrate(jobId, 20, 3000).then((finalLabel: string | null) => {
				if (finalLabel != null) {
					currentLabel = finalLabel
					classifyLabel = labelCn(finalLabel)
					submitCorrection(lastContentId, lastText, finalLabel, oldLabel)
					uni.showToast({ title: '已纠正为：' + labelCn(finalLabel), icon: 'none' })
				} else {
					currentLabel = key
					classifyLabel = labelCn(key)
					submitCorrection(lastContentId, lastText, key, oldLabel)
					uni.showToast({ title: '已纠正', icon: 'none' })
				}
			})
		})
	}

	// ===== 语音录音方法 =====
	function toggleRecord(): void {
		if (recording) {
			stopRecordNow()
		} else {
			recording = true
			recordSeconds = 0
			recState = 'idle'
			recordHint = '录音中，再点停止'
			transcript = ''
			emotion = ''
			guardMsg = ''
			voiceHints = ''
			lastVoiceFile = ''
			setShouldResume(true)
			recordTimer = setInterval(() => {
				recordSeconds++
			}, 1000) as number
			startRecord(
				() => {
					console.log('[yishu] record started')
				},
				(path: string, durationMs: number) => {
					onRecordStopped(path, durationMs)
				},
				(msg: string) => {
					console.error('[yishu] record error: ' + msg)
					recording = false
					recState = 'idle'
					recordHint = '点击开始录音（≤30 分钟）'
					if (recordTimer > 0) {
						clearInterval(recordTimer)
						recordTimer = 0
					}
					showErrorToast(new Error('录音失败：' + msg))
				},
				(autoPaused: boolean) => {
					console.log('[yishu] record interrupted (autoPaused=' + autoPaused + ')')
					recState = recorderState()
					recordHint = '录音被中断，已暂停'
				},
				(path: string, durationMs: number) => {
					console.log('[yishu] record auto-stop at 30min, saving segment: ' + durationMs + 'ms')
					onRecordStopped(path, durationMs)
				}
			)
		}
	}
	function resumeRecordNow(): void {
		resumeRecord()
		recState = recorderState()
		recordHint = recState == REC_STATE_PAUSED ? '录音中，再点停止' : '已继续录音'
	}
	function stopRecordNow(): void {
		stopRecord()
	}
	function onRecordStopped(path: string, durationMs: number): void {
		recording = false
		recState = 'idle'
		recordHint = '点击开始录音（≤30 分钟）'
		if (recordTimer > 0) {
			clearInterval(recordTimer)
			recordTimer = 0
		}
		if (durationMs < 500) {
			showErrorToast(new Error('录音太短'))
			return
		}
		lastVoiceDuration = durationMs
		lastVoiceFile = path
		transcribing = true
		if (durationMs >= 300000) {
			transcribing = false
			voiceHints = '长录音已提交，云端整理中（>5min 自动分段转写）'
			uploadVoicePersistent(path, durationMs).then((res: UTSJSONObject | null) => {
				console.log('[yishu] long voice uploaded: ' + (res != null ? JSON.stringify(res) : 'null'))
			})
			return
		}
		transcribeWav(path).then((res) => {
			transcribing = false
			if (res == null) {
				return
			}
			transcript = res.text
			emotion = res.emotion
			const hints: Array<string> = []
			if (res.notOral) {
				hints.push('疑似非口述（键盘/环境音）')
			}
			if (res.silenceHint) {
				hints.push('检测到静音空段，可删除')
			}
			const merge = res.emotionMerge
			if (merge != null) {
				const dm = merge.getJSON('dominant')
				if (dm != null) {
					hints.push('主导情绪：' + (dm.getString('emotion') ?? '') + '（时长最长段）')
				}
			}
			if (res.noiseWeight == 'equal') {
				hints.push('噪音较大，情绪权重已降为持平')
			}
			voiceHints = hints.join('；')
			if (!res.guardPassed) {
				guardMsg = '内容未通过安全审核：' + res.guardReason
			} else {
				guardMsg = res.channel + ' 通道' + (res.mock ? '（mock）' : '') + ' · 置信度 ' + Math.round(res.confidence * 100) + '%'
			}
		})
	}
	function submitVoice(): void {
		const text = transcript.trim()
		if (text == '') {
			showErrorToast(new Error('转写内容为空'))
			return
		}
		saving = true
		saveVoiceContent(text, lastVoiceDuration, emotion, '', lastVoiceFile).then((contentId: string | null) => {
			saving = false
			if (contentId != null) {
				uni.showToast({ title: '已入库', icon: 'success' })
				transcript = ''
				emotion = ''
				guardMsg = ''
				voiceHints = ''
			} else {
				showErrorToast(new Error('入库失败'))
			}
		})
	}
</script>

<style>
	/* 视觉规范 v3：像素级还原 SVG 设计稿（390x844 画布）
	   背景 #f8f7f4 / 主文字 #3a2e25 / 次文字 #8a7a6a / 辅助 #b3a696
	   琥珀 #c4913c / 锈红 #b05a3a / 卡片 #ffffff / 弹层面板 #faf9f5 */
	.page {
		width: 100%;
		height: 100%;
		position: relative;
		background-color: #f8f7f4;
		overflow: hidden;
	}
	.serif {
		font-family: "Noto Serif CJK SC", serif;
	}

	/* ═══════ 背景层 ═══════ */
	.backdrop {
		position: absolute;
		top: 0;
		left: 0;
		width: 750rpx;
		height: 100%;
	}
	.hero-photo {
		position: absolute;
		top: 0;
		left: 0;
		width: 750rpx;
		height: 577rpx;
	}
	.hero-shade-top {
		position: absolute;
		top: 0;
		left: 0;
		width: 750rpx;
		height: 269rpx;
		background-image: linear-gradient(to right, rgba(26, 20, 15, 0.38) 0%, rgba(26, 20, 15, 0.12) 60%, rgba(26, 20, 15, 0) 100%);
	}
	.hero-shade-bottom {
		position: absolute;
		top: 346rpx;
		left: 0;
		width: 750rpx;
		height: 269rpx;
		background-image: linear-gradient(to right, rgba(248, 247, 244, 0) 0%, rgba(248, 247, 244, 0.92) 78%, #f8f7f4 100%);
	}
	.hero-title {
		position: absolute;
		left: 38rpx;
		top: 115rpx;
		font-size: 76rpx;
		color: #ffffff;
		font-weight: bold;
		letter-spacing: 4rpx;
	}
	.hero-avatar {
		position: absolute;
		left: 635rpx;
		top: 112rpx;
		width: 77rpx;
		height: 77rpx;
		border-radius: 38rpx;
		background-color: #c4913c;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.hero-avatar-char {
		font-size: 34rpx;
		color: #ffffff;
		font-weight: 600;
	}
	.hero-sub1 {
		position: absolute;
		left: 38rpx;
		top: 213rpx;
		font-size: 24rpx;
		color: #ffffff;
		font-weight: 600;
	}
	.hero-sub2 {
		position: absolute;
		left: 38rpx;
		top: 244rpx;
		font-size: 24rpx;
		color: #ffffff;
		opacity: 0.92;
	}

	/* 搜索胶囊 */
	.search-capsule {
		position: absolute;
		left: 38rpx;
		top: 473rpx;
		width: 673rpx;
		height: 88rpx;
		border-radius: 44rpx;
		background-color: rgba(255, 255, 255, 0.32);
		border: 2rpx solid rgba(255, 255, 255, 0.52);

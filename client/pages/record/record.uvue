	}
	.center-box {
		align-items: center;
		padding-top: 80rpx;
		display: flex;
		flex-direction: column;
	}
	.transcript-box {
		display: flex;
		flex-direction: column;
	}
	.transcript-head {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16rpx;
	}
	.transcript-title {
		font-size: 30rpx;
		color: #3a2e25;
		font-weight: bold;
	}
	.emotion-chip {
		font-size: 24rpx;
		color: #b05a3a;
		background-color: #F3E8DC;
		padding-left: 16rpx;
		padding-right: 16rpx;
		padding-top: 6rpx;
		padding-bottom: 6rpx;
		border-radius: 20rpx;
	}
	/* J-7：中断/暂停条 */
	.interrupt-bar {
		margin-top: 24rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		background-color: #F3E8DC;
		border-radius: 8rpx;
		padding-left: 24rpx;
		padding-right: 24rpx;
		padding-top: 16rpx;
		padding-bottom: 16rpx;
	}
	.interrupt-text {
		flex: 1;
		font-size: 26rpx;
		color: #8a7a6a;
	}
	.resume-btn {
		background-color: #b05a3a;
		border-radius: 24rpx;
		padding-left: 28rpx;
		padding-right: 28rpx;
		padding-top: 10rpx;
		padding-bottom: 10rpx;
	}
	.resume-text {
		color: #f8f7f4;
		font-size: 26rpx;
	}
	/* J-1/J-3：音频事件/噪音/段级合并提示 */
	.voice-hints {
		margin-top: 12rpx;
		margin-bottom: 12rpx;
		background-color: #F3E8DC;
		border-radius: 8rpx;
		padding-left: 20rpx;
		padding-right: 20rpx;
		padding-top: 10rpx;
		padding-bottom: 10rpx;
	}
</style>

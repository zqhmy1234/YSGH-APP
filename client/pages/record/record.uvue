	const micIcon = `<svg viewBox="0 0 15 21" xmlns="http://www.w3.org/2000/svg"><path d="M10.1058 0.1859Q11.375 1.4551 11.375 3.25L11.375 8.6667Q11.375 10.4616 10.1058 11.7308Q8.8366 13 7.0417 13Q5.2467 13 3.9775 11.7308Q2.7083 10.4616 2.7083 8.6667L2.7083 3.25Q2.7083 1.4551 3.9775 0.1859Q5.2467 -1.0833 7.0417 -1.0833Q8.8366 -1.0833 10.1058 0.1859ZM8.5737 1.7179Q7.9391 1.0833 7.0417 1.0833Q6.1442 1.0833 5.5096 1.7179Q4.875 2.3525 4.875 3.25L4.875 8.6667Q4.875 9.5641 5.5096 10.1987Q6.1442 10.8333 7.0417 10.8333Q7.9391 10.8333 8.5737 10.1987Q9.2083 9.5641 9.2083 8.6667L9.2083 3.25Q9.2083 2.3525 8.5737 1.7179ZM2.8285 12.8799Q1.0833 11.1347 1.0833 8.6667Q1.0964 8.2125 0.766 7.9006Q0.4541 7.5703 0 7.5833Q-0.4541 7.5703 -0.766 7.9006Q-1.0964 8.2125 -1.0833 8.6667Q-1.0833 12.0322 1.2964 14.4119Q3.2837 16.3992 5.9583 16.7269L5.9583 19.5Q5.9453 19.9541 6.2756 20.266Q6.5875 20.5964 7.0417 20.5833Q7.4958 20.5964 7.8077 20.266Q8.1381 19.9541 8.125 19.5L8.125 16.7269Q10.7997 16.3992 12.7869 14.4119Q15.1667 12.0322 15.1667 8.6667Q15.1797 8.2125 14.8494 7.9006Q14.5375 7.5703 14.0833 7.5833Q13.6292 7.5703 13.3173 7.9006Q12.9869 8.2125 13 8.6667Q13 11.1347 11.2549 12.8799Q9.5097 14.625 7.0417 14.625Q4.5736 14.625 2.8285 12.8799Z"/></svg>`
	const keyboardIcon = `<svg viewBox="0 0 20 19" xmlns="http://www.w3.org/2000/svg"><path d="M0.0323 12.8679Q0.0679 12.725 0.1406 12.5969Q0.213 12.4686 0.3173 12.3646L12.776 -0.0941Q13.7666 -1.0837 15.1667 -1.0833Q15.3387 -1.0833 15.5059 -1.0676Q16.6938 -0.9561 17.5569 -0.0929Q18.547 0.8971 18.5473 2.2973Q18.5477 3.6974 17.5577 4.6883L5.0994 17.1467Q4.9953 17.2509 4.8671 17.3234Q4.739 17.3961 4.5961 17.4316L0.2628 18.515Q0.1334 18.5474 0 18.5473Q-0.1334 18.5474 -0.2628 18.515Q-0.7065 18.4175 -0.929 18.0213Q-1.1738 17.6386 -1.051 17.2012L0.0323 12.8679ZM1.4889 15.9751L2.0616 13.6845L11.375 4.371L13.0929 6.089L3.7795 15.4024L1.4889 15.9751ZM14.625 4.5569L16.0256 3.1563Q16.3808 2.8008 16.3806 2.2978Q16.3805 1.7948 16.0248 1.4391Q15.7138 1.1281 15.3033 1.0896Q15.2369 1.0834 15.1662 1.0833Q14.6632 1.0832 14.3073 1.4387L12.9071 2.839L14.625 4.5569Z"/></svg>`

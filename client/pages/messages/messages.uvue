<template>
	<view class="page">
		<!-- 顶部标题区（设计稿: y=16 标题 / y=60-65 分段 / y=110 副标题） -->
		<view class="header">
			<view class="header-row">
				<text class="header-title">消息</text>
				<view class="header-more pressable" @tap="onMore">
					<hens-svg :src="moreIconSvg" :size="18" color="#3A2E25" />
				</view>
			</view>

			<!-- 分段控件（设计稿: 系统通知 x=23 y=65 / AI互动 x=177 y=60） -->
			<view class="segment-row">
				<view
					v-for="(seg, idx) in segments"
					:key="idx"
					class="segment-item pressable"
					:class="{ 'segment-item-active': activeSegment === idx }"
					@tap="setSegment(idx)"
				>
					<text class="segment-text" :class="{ 'segment-text-active': activeSegment === idx }">{{ seg }}</text>
					<view v-if="idx === 0 && unreadCount > 0" class="segment-dot"></view>
				</view>
			</view>

			<text class="header-sub">今天有 {{ unreadCount }} 条未读消息</text>
		</view>

		<!-- 滚动内容区 -->
		<scroll-view class="content-scroll">
			<!-- AI 精选卡（设计稿: x=20 y=138 350x104 rx=20，渐变#D9E2CA，星标+波形+标题+副标题） -->
			<view class="featured-card pressable" @tap="openFeatured">
				<view class="featured-wave-row">
					<hens-svg :src="starSvg" :size="14" />
					<hens-svg :src="waveSvg" :width="260" :height="12" />
				</view>
				<text class="featured-title">本周记忆摘要</text>
				<text class="featured-sub">AI 为你整理了 12 条记忆，3 个重要时刻</text>
			</view>

			<!-- 消息列表卡（设计稿: x=20 y=300 350x204 rx=20，3行消息） -->
			<view class="message-card">
				<view
					v-for="(msg, idx) in filteredMessages"
					:key="idx"
					class="message-row pressable"
					:class="{ 'message-row-unread': !msg.read }"
					@tap="openMessage(msg)"
				>
					<view class="message-avatar" :style="{ backgroundColor: msg.avatarBg }">
						<hens-svg :src="msg.iconSvg" :size="18" />
					</view>
					<view class="message-body">
						<view class="message-top">
							<text class="message-title">{{ msg.title }}</text>
							<text class="message-time">{{ msg.time }}</text>
						</view>
						<text class="message-summary">{{ msg.summary }}</text>
					</view>
					<view v-if="!msg.read" class="unread-dot"></view>
				</view>
			</view>

			<!-- 空状态 -->
			<view v-if="filteredMessages.length === 0" class="empty-state">
				<text class="empty-text">暂无消息</text>
			</view>

			<view class="bottom-spacer"></view>
		</scroll-view>

		<!-- 统一 TabBar 组件 -->
		<TabBar active="messages" />
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onShow } from '@dcloudio/uni-app'
	import {
		fetchMessages,
		fetchUnreadCount,
		markMessageRead,
		markAllRead,
		AppMessage
	} from '@/utils/play'
	import { formatIsoShortTime } from '@/utils/time'

	// ===== hens-svg 图标（SVG 字符串，从设计稿 path 提取） =====
	const starSvg = `<svg viewBox="0 0 11 11" xmlns="http://www.w3.org/2000/svg"><path d="M5.25 0L6.4167 4.0833L10.5 5.25L6.4167 6.4167L5.25 10.5L4.0833 6.4167L0 5.25L4.0833 4.0833L5.25 0Z" fill="#7A8C5A"/></svg>`
	const waveSvg = `<svg viewBox="0 0 104 14" xmlns="http://www.w3.org/2000/svg"><path d="M2 7q4 4 8 0t8 0 8 0 8 0 8 0 8 0 8 0 8 0 8 0 8 0 8 0 8 0" stroke="#7A8C5A" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>`
	const moreIconSvg = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="5" cy="12" r="2" fill="#3A2E25"/><circle cx="12" cy="12" r="2" fill="#3A2E25"/><circle cx="19" cy="12" r="2" fill="#3A2E25"/></svg>`
	// 头像图标
	const bellSvg = `<svg viewBox="-1 -1 13 10" xmlns="http://www.w3.org/2000/svg"><path d="M3.375 5.9583L0.5834 3.1666Q0.3458 2.915 0 2.925Q-0.3458 2.915 -0.5834 3.1666Q-0.835 3.4042 -0.825 3.75Q-0.835 4.0958 -0.5834 4.3334L2.7916 7.7084Q3.0292 7.96 3.375 7.95Q3.7208 7.96 3.9584 7.7084L11.0834 0.5834Q11.335 0.3458 11.325 0Q11.335 -0.3458 11.0834 -0.5834Q10.8458 -0.835 10.5 -0.825Q10.1541 -0.835 9.9166 -0.5834L3.375 5.9583Z" fill="#B05A3A"/></svg>`
	const aiAvatarSvg = `<svg viewBox="-1 -1 12 16" xmlns="http://www.w3.org/2000/svg"><path d="M6.9963 0.1287Q7.875 1.0074 7.875 2.25L7.875 6Q7.875 7.2426 6.9963 8.1213Q6.1176 9 4.875 9Q3.6324 9 2.7537 8.1213Q1.875 7.2426 1.875 6L1.875 2.25Q1.875 1.0074 2.7537 0.1287Q3.6324 -0.75 4.875 -0.75Q6.1176 -0.75 6.9963 0.1287ZM5.9357 1.1893Q5.4963 0.75 4.875 0.75Q4.2537 0.75 3.8143 1.1893Q3.375 1.6287 3.375 2.25L3.375 6Q3.375 6.6213 3.8143 7.0607Q4.2537 7.5 4.875 7.5Q5.4963 7.5 5.9357 7.0607Q6.375 6.6213 6.375 6L6.375 2.25Q6.375 1.6287 5.9357 1.1893ZM1.9582 8.9168Q0.75 7.7086 0.75 6Q0.759 5.6856 0.5303 5.4697Q0.3144 5.241 0 5.25Q-0.3144 5.241 -0.5303 5.4697Q-0.759 5.6856 -0.75 6Q-0.75 8.33 0.8975 9.9775Q2.2733 11.3533 4.125 11.5802L4.125 13.5Q4.116 13.8144 4.3447 14.0303Q4.5606 14.259 4.875 14.25Q5.1894 14.259 5.4053 14.0303Q5.634 13.8144 5.625 13.5L5.625 11.5802Q7.4767 11.3533 8.8525 9.9775Q10.5 8.33 10.5 6Q10.509 5.6856 10.2803 5.4697Q10.0644 5.241 9.75 5.25Q9.4356 5.241 9.2197 5.4697Q8.9909 5.6856 9 6Q9 7.7086 7.7918 8.9168Q6.5836 10.125 4.875 10.125Q3.1664 10.125 1.9582 8.9168Z" fill="#7A8C5A"/></svg>`
	const tealAvatarSvg = `<svg viewBox="-2 -1 18 16" xmlns="http://www.w3.org/2000/svg"><path d="M13.1191 3.0053Q10.9874 -0.7285 6.7286 -0.7499Q2.3893 -0.7285 0.2425 3.0053Q-1.8969 6.7524 0.2446 10.4983Q2.3893 14.25 6.6808 14.25Q10.9723 14.25 13.1171 10.4983Q15.2585 6.7524 13.1191 3.0053Z" fill="#4E7D8C"/></svg>`

	// ===== 响应式状态 =====
	let activeSegment = ref(0)
	let segments = ['系统通知', 'AI 互动']
	let unreadCount = ref(0)
	let allMessages = ref<Array<AppMessage>>([])

	class MessageItem {
		id: number
		title: string
		summary: string
		time: string
		iconSvg: string
		avatarBg: string
		read: boolean
		type: number
		constructor(id: number, title: string, summary: string, time: string, iconSvg: string, avatarBg: string, read: boolean, type: number) {
			this.id = id
			this.title = title
			this.summary = summary
			this.time = time
			this.iconSvg = iconSvg
			this.avatarBg = avatarBg
			this.read = read
			this.type = type
		}
	}

	/** msg_type → 分段（0系统 / 1 AI）+ 头像图标/底色 */
	function msgSegment(t: string): number {
		// 关怀追问属 AI 互动；复盘/语音完成/回响等自动通知归系统
		return t == 'care_followup' ? 1 : 0
	}
	function msgIcon(t: string): string {
		if (t == 'care_followup') {
			return aiAvatarSvg
		}
		if (t == 'voice_done' || t == 'echo') {
			return tealAvatarSvg
		}
		return bellSvg
	}
	function msgBg(t: string): string {
		if (t == 'care_followup') {
			return '#7A8C5A'
		}
		if (t == 'voice_done' || t == 'echo') {
			return '#4E7D8C'
		}
		return '#B0593B'
	}

	function toItem(m: AppMessage): MessageItem {
		return new MessageItem(
			m.id,
			m.title,
			m.body,
			formatIsoShortTime(m.sentAt),
			msgIcon(m.msgType),
			msgBg(m.msgType),
			m.status != 'unread',
			msgSegment(m.msgType)
		)
	}

	let filteredMessages = computed((): Array<MessageItem> => {
		const out: Array<MessageItem> = []
		for (let i = 0; i < allMessages.value.length; i++) {
			const it = toItem(allMessages.value[i])
			if (it.type === activeSegment.value) {
				out.push(it)
			}
		}
		return out
	})

	/** 加载消息列表 + 未读数（onShow 每次进入刷新） */
	function loadMessages(): void {
		fetchMessages('').then((list: Array<AppMessage>) => {
			allMessages.value = list
		})
		fetchUnreadCount().then((n: number) => {
			unreadCount.value = n
		})
	}

	onShow(() => {
		loadMessages()
	})

	function setSegment(idx: number): void {
		activeSegment.value = idx
	}

	function openMessage(msg: MessageItem): void {
		if (!msg.read) {
			msg.read = true
			if (unreadCount.value > 0) {
				unreadCount.value--
			}
			markMessageRead(msg.id)
		}
	}

	function openFeatured(): void {
		uni.showToast({ title: '本周记忆摘要待接入', icon: 'none' })
	}

	function onMore(): void {
		uni.showActionSheet({
			itemList: ['全部标记已读'],
			success: (res) => {
				if (res.tapIndex === 0) {
					markAllRead().then((ok: boolean) => {
						if (ok) {
							unreadCount.value = 0
							for (let i = 0; i < allMessages.value.length; i++) {
								allMessages.value[i].status = 'read'
							}
						}
					})
				}
			}
		})
	}
</script>

<style>
	/* 视觉规范：像素级还原 消息中心.svg（390x844画布）
	   背景 #F8F7F4 / 精选卡渐变 #D9E2CA / 消息卡 #FFFFFF rx=20
	   头像: 锈红#B0593B / 绿#7A8C5A / 青#4E7D8C
	   玻璃 TabBar #F6F1E7 75% rx=31 / FAB #B05A3A */
	.page {
		width: 100%;
		height: 100%;
		background-color: #f8f7f4;
		display: flex;
		flex-direction: column;
	}

	/* ===== 顶部标题区 ===== */
	.header {
		padding: 32rpx 40rpx 0 40rpx;
	}
	.header-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20rpx;
	}
	.header-title {
		font-size: 44rpx;
		color: #3a2e25;
		font-weight: 700;
	}
	.header-more {
		width: 56rpx;
		height: 56rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.header-sub {
		font-size: 24rpx;
		color: #8a7a6a;
		margin-top: 12rpx;
	}

	/* ===== 分段控件 ===== */
	.segment-row {
		display: flex;
		flex-direction: row;
		margin-bottom: 8rpx;
	}
	.segment-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-right: 48rpx;
		padding: 8rpx 0;
		position: relative;
	}
	.segment-text {
		font-size: 30rpx;
		color: #b3a696;
		font-weight: 500;
	}
	.segment-text-active {
		color: #3a2e25;
		font-weight: 700;
	}
	.segment-dot {
		width: 12rpx;
		height: 12rpx;
		background-color: #b05a3a;
		border-radius: 6rpx;
		margin-left: 8rpx;
	}

	/* ===== 滚动内容区 ===== */
	.content-scroll {
		flex: 1;
		padding: 20rpx 40rpx 0 40rpx;
	}

	/* ===== AI 精选卡（设计稿: 350x104 rx=20） ===== */
	.featured-card {
		width: 700rpx;
		background-color: #ffffff;
		border-radius: 40rpx;
		padding: 28rpx;
		margin-bottom: 24rpx;
		box-shadow: 0 4rpx 16rpx rgba(58,46,37,0.06);
	}
	.featured-wave-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 16rpx;
	}
	.featured-title {
		font-size: 30rpx;
		color: #3a2e25;
		font-weight: 600;
		margin-bottom: 8rpx;
	}
	.featured-sub {
		font-size: 24rpx;
		color: #5a4c40;
	}

	/* ===== 消息列表卡（设计稿: 350x204 rx=20） ===== */
	.message-card {
		width: 700rpx;
		background-color: #ffffff;
		border-radius: 40rpx;
		padding: 8rpx 28rpx;
		box-shadow: 0 4rpx 16rpx rgba(58,46,37,0.06);
	}
	.message-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 24rpx 0;
		position: relative;
		border-bottom-width: 1rpx;
		border-bottom-color: rgba(58,46,37,0.06);
		border-bottom-style: solid;
	}
	.message-avatar {
		width: 80rpx;
		height: 80rpx;
		border-radius: 40rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 24rpx;
	}
	.message-body {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.message-top {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 6rpx;
	}
	.message-title {
		font-size: 28rpx;
		color: #3a2e25;
		font-weight: 600;
	}
	.message-time {
		font-size: 22rpx;
		color: #b3a696;
		margin-left: 16rpx;
	}
	.message-summary {
		font-size: 24rpx;
		color: #8a7a6a;
		line-height: 36rpx;
	}
	.unread-dot {
		width: 14rpx;
		height: 14rpx;
		background-color: #b05a3a;
		border-radius: 7rpx;
		margin-left: 16rpx;
		flex-shrink: 0;
	}

	/* ===== 空状态 ===== */
	.empty-state {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 80rpx 0;
	}
	.empty-text {
		font-size: 28rpx;
		color: #b3a696;
	}
	.bottom-spacer {
		height: 180rpx;
	}


	/* 按压态 */
	.pressable {
		transition: transform 0.15s ease, opacity 0.15s ease;
	}
</style>

<template>
	<view class="page">
		<view class="header">
			<text class="header-title serif">消息中心</text>
			<text class="header-sub">复盘与回响</text>
		</view>

		<!-- 过滤切换 -->
		<view class="seg">
			<view class="seg-item" :class="filter === 'unread' ? 'seg-active' : ''" @tap="switchFilter('unread')">
				<text class="seg-text" :class="filter === 'unread' ? 'seg-text-active' : ''">未读</text>
			</view>
			<view class="seg-item" :class="filter === 'all' ? 'seg-active' : ''" @tap="switchFilter('all')">
				<text class="seg-text" :class="filter === 'all' ? 'seg-text-active' : ''">全部</text>
			</view>
		</view>

		<!-- 加载中 -->
		<view v-if="loading" class="center-box">
			<text class="muted">加载中…</text>
		</view>

		<!-- 空态 -->
		<view v-else-if="messages.length === 0" class="center-box">
			<text class="empty-title serif">暂无消息</text>
			<text class="empty-desc">复盘推送和回响会出现在这里</text>
		</view>

		<!-- 消息列表 -->
		<view v-else class="msg-list">
			<view v-for="m in messages" :key="m.id" class="msg-card" :class="m.status === 'unread' ? 'msg-unread' : ''" @tap="onMsgTap(m)">
				<view class="msg-head">
					<text class="msg-title serif">{{ m.title }}</text>
					<text v-if="m.status === 'unread'" class="msg-dot">●</text>
				</view>
				<text class="msg-body">{{ m.body }}</text>
				<text class="msg-time">{{ shortTime(m.sentAt) }}</text>
			</view>
			<view v-if="filter === 'unread' && messages.length > 0" class="read-all-btn" @tap="readAll">
				<text class="read-all-text">全部标为已读</text>
			</view>
		</view>
		<!-- 玻璃 TabBar（半透明白 55% + 中央＋按钮） -->
<view class="glass-tabbar">
			<view class="tabbar-item  pressable" @tap="goIndex">
				<text class="tabbar-icon">🏠</text>
				<text class="tabbar-label">时间轴</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goSearch">
				<text class="tabbar-icon">🔍</text>
				<text class="tabbar-label">搜索</text>
			</view>
			<view class="tabbar-fab pressable" @tap="goRecord">
				<text class="tabbar-fab-icon">+</text>
			</view>
			<view class="tabbar-item active pressable" @tap="goMessages">
				<text class="tabbar-icon">💬</text>
				<text class="tabbar-label">消息</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goProfile">
				<text class="tabbar-icon">👤</text>
				<text class="tabbar-label">我的</text>
			</view>
		</view>
</view>

</template>

<script setup lang="uts">
	import { onLoad, onShow } from '@dcloudio/uni-app'
	import { ensureLogin } from '@/utils/auth'
	import { fetchMessages, markMessageRead, markAllRead, AppMessage } from '@/utils/play'
	import { showErrorToast } from '@/utils/api'
	import { formatIsoShortTime } from '@/utils/time'

	// 响应式数据
	let filter = 'unread'
	let loading = false
	let loadedOnce = false
	let messages: Array<AppMessage> = []

	// 生命周期
	onLoad(() => {
		ensureLogin().then((ok: boolean) => {
			if (!ok) {
				showErrorToast(new Error('登录失败，请重试'))
				return
			}
			reload()
		})
	})
	onShow(() => {
		// 切前台刷新（T-PL-3：打开/切前台刷新）
		if (loadedOnce) {
			reload()
		}
	})

	// 导航方法
	function goIndex(): void {
		uni.reLaunch({ url: '/pages/index/index' })
	}
	function goSearch(): void {
		uni.reLaunch({ url: '/pages/search/search' })
	}
	function goRecord(): void {
		uni.reLaunch({ url: '/pages/record/record' })
	}
	function goMessages(): void {
		uni.reLaunch({ url: '/pages/messages/messages' })
	}
	function goProfile(): void {
		uni.reLaunch({ url: '/pages/profile/profile' })
	}

	// 业务方法
	function reload(): void {
		loading = true
		fetchMessages(filter).then((list: Array<AppMessage>) => {
			messages = list
			loading = false
			loadedOnce = true
		})
	}
	function switchFilter(f: string): void {
		if (filter === f) {
			return
		}
		filter = f
		reload()
	}
	function onMsgTap(m: AppMessage): void {
		if (m.status === 'unread') {
			markMessageRead(m.id).then((ok: boolean) => {
				if (ok) {
					reload()
				}
			})
		}
	}
	function readAll(): void {
		markAllRead().then((ok: boolean) => {
			if (ok) {
				uni.showToast({ title: '已全部标为已读', icon: 'none' })
				reload()
			}
		})
	}
	function shortTime(iso: string): string {
		return formatIsoShortTime(iso)
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #f8f7f4;
		padding-left: 0;
		padding-right: 0;
		padding-top: 88rpx;
	}
	.serif {
		font-family: "Noto Serif CJK SC", serif;
	}
	.header {
		padding-top: 24rpx;
		padding-bottom: 24rpx;
	}
	.header-title {
		font-size: 52rpx;
		color: #3a2e25;
		font-weight: bold;
		letter-spacing: 6rpx;
	}
	.header-sub {
		margin-top: 8rpx;
		font-size: 26rpx;
		color: #8a7a6a;
	}

	/* 分段 */
	.seg {
		display: flex;
		flex-direction: row;
		background-color: #EBE3D4;
		border-radius: 10rpx;
		padding: 6rpx;
		margin-bottom: 28rpx;
	}
	.seg-item {
		flex: 1;
		align-items: center;
		justify-content: center;
		padding-top: 14rpx;
		padding-bottom: 14rpx;
		border-radius: 8rpx;
	}
	.seg-active {
		background-color: #ffffff;
	}
	.seg-text {
		font-size: 28rpx;
		color: #8a7a6a;
	}
	.seg-text-active {
		color: #3a2e25;
		font-weight: bold;
	}

	.center-box {
		padding-top: 140rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.muted {
		font-size: 24rpx;
		color: #b3a696;
	}
	.empty-title {
		font-size: 36rpx;
		color: #3a2e25;
		font-weight: bold;
	}
	.empty-desc {
		margin-top: 12rpx;
		font-size: 26rpx;
		color: #8a7a6a;
	}

	/* 消息卡 */
	.msg-list {
		display: flex;
		flex-direction: column;
		padding-bottom: 60rpx;
	}
	.msg-card {
		background-color: #ffffff;
		border-radius: 40rpx;
		padding: 24rpx;
		margin-bottom: 20rpx;
		box-shadow: 0 4rpx 12rpx rgba(58, 46, 37, 0.1);
	}
	.msg-unread {
		border-left-width: 6rpx;
		border-left-color: #b05a3a;
	}
	.msg-head {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}
	.msg-title {
		font-size: 30rpx;
		color: #3a2e25;
		font-weight: bold;
	}
	.msg-dot {
		font-size: 20rpx;
		color: #b05a3a;
	}
	.msg-body {
		margin-top: 10rpx;
		font-size: 26rpx;
		color: #5a4c40;
		line-height: 38rpx;
	}
	.msg-time {
		margin-top: 12rpx;
		font-size: 22rpx;
		color: #b3a696;
	}
	.read-all-btn {
		margin-top: 24rpx;
		align-items: center;
		display: flex;
		justify-content: center;
		padding-top: 18rpx;
		padding-bottom: 18rpx;
		border-width: 1rpx;
		border-color: #b05a3a;
		border-radius: 8rpx;
	}
	.read-all-text {
		color: #b05a3a;
		font-size: 26rpx;
	}
</style>

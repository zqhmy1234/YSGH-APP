<template>
	<view class="page">
		<!-- 顶部导航：返回箭头 ‹ + 居中标题「消息」~35rpx（设计稿: y=63.6，无右侧「⋯」） -->
		<view class="header">
			<view class="nav-row">
				<view class="back-btn pressable" @tap="goBack">
					<text class="back-arrow">‹</text>
				</view>
				<text class="nav-title">消息</text>
			</view>
			<text class="header-sub">今天</text>
		</view>

		<!-- 滚动内容区 -->
		<scroll-view class="content-scroll">
			<!-- 时间胶囊卡（设计稿: x=20 y=138 673x200 rx=20 白，内嵌 642x169 rx=12 鼠尾草绿横向渐变面板） -->
			<view class="featured-card pressable" @tap="openFeatured">
				<view class="featured-panel">
					<view class="featured-meta-row">
						<image src="/static/icons/msg-star.svg" :width="10" :height="10" />
						<text class="featured-meta">时间胶囊 · 8 个月前</text>
					</view>
					<text class="featured-title">去年今天：你在天台看了流星雨</text>
					<text class="featured-sub">点开重温…</text>
				</view>
			</view>

			<!-- 消息列表卡（设计稿: x=20 y=300 673x392 rx=20，3行消息，行间无分隔线） -->
			<view class="message-card">
				<view
					v-for="(msg, idx) in filteredMessages"
					:key="idx"
					class="message-row pressable"
					:class="{ 'message-row-unread': !msg.read }"
					@tap="openMessage(msg)"
				>
					<view class="message-avatar" :style="{ backgroundColor: msg.avatarBg }">
						<image :src="msg.iconPath" :width="18" :height="18" />
					</view>
					<view class="message-body">
						<view class="message-top">
							<text class="message-title">{{ msg.title }}</text>
							<text class="message-time">{{ msg.time }}</text>
						</view>
						<text class="message-summary">{{ msg.summary }}</text>
					</view>
					<view v-if="!msg.read" class="unread-dot"></view>
				</view>
			</view>

			<!-- 空状态 -->
			<view v-if="filteredMessages.length === 0" class="empty-state">
				<text class="empty-text">暂无消息</text>
			</view>

			<view class="bottom-spacer"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onShow } from '@dcloudio/uni-app'
	import {
		fetchMessages,
		fetchUnreadCount,
		markMessageRead,
		AppMessage
	} from '@/utils/play'
	import { formatIsoShortTime } from '@/utils/time'

	// ===== 响应式状态 =====
	let unreadCount = ref(0)
	let allMessages = ref<Array<AppMessage>>([])

	class MessageItem {
		id: number
		title: string
		summary: string
		time: string
		iconPath: string
		avatarBg: string
		read: boolean
		type: number
		constructor(id: number, title: string, summary: string, time: string, iconPath: string, avatarBg: string, read: boolean, type: number) {
			this.id = id
			this.title = title
			this.summary = summary
			this.time = time
			this.iconPath = iconPath
			this.avatarBg = avatarBg
			this.read = read
			this.type = type
		}
	}

	/** msg_type → 分段（0系统 / 1 AI）+ 头像图标/底色 */
	function msgSegment(t: string): number {
		// 关怀追问属 AI 互动；复盘/语音完成/回响等自动通知归系统
		return t == 'care_followup' ? 1 : 0
	}
	function msgIcon(t: string): string {
		if (t == 'care_followup') {
			return '/static/icons/msg-ai.svg'
		}
		if (t == 'voice_done' || t == 'echo') {
			return '/static/icons/msg-teal.svg'
		}
		return '/static/icons/msg-bell.svg'
	}
	function msgBg(t: string): string {
		if (t == 'care_followup') {
			return '#7A8C5A'
		}
		if (t == 'voice_done' || t == 'echo') {
			return '#4E7D8C'
		}
		return '#B0593B'
	}

	function toItem(m: AppMessage): MessageItem {
		return new MessageItem(
			m.id,
			m.title,
			m.body,
			formatIsoShortTime(m.sentAt),
			msgIcon(m.msgType),
			msgBg(m.msgType),
			m.status != 'unread',
			msgSegment(m.msgType)
		)
	}

	let filteredMessages = computed((): Array<MessageItem> => {
		const out: Array<MessageItem> = []
		for (let i = 0; i < allMessages.value.length; i++) {
			out.push(toItem(allMessages.value[i]))
		}
		return out
	})

	/** 返回上级（设计稿消息中心由别的页签进入，带返回导航） */
	function goBack(): void {
		uni.navigateBack({ delta: 1 })
	}

	/** 加载消息列表 + 未读数（onShow 每次进入刷新） */
	function loadMessages(): void {
		fetchMessages('').then((list: Array<AppMessage>) => {
			allMessages.value = list
		})
		fetchUnreadCount().then((n: number) => {
			unreadCount.value = n
		})
	}

	onShow(() => {
		loadMessages()
	})

	function openMessage(msg: MessageItem): void {
		if (!msg.read) {
			msg.read = true
			if (unreadCount.value > 0) {
				unreadCount.value--
			}
			markMessageRead(msg.id)
		}
	}

	function openFeatured(): void {
		uni.showToast({ title: '本周记忆摘要待接入', icon: 'none' })
	}
</script>

<style>
	/* 视觉规范：像素级还原 消息中心.svg（390x844画布）
	   背景 #F8F7F4 / 精选卡渐变 #D9E2CA / 消息卡 #FFFFFF rx=20
	   头像: 锈红#B0593B / 绿#7A8C5A / 青#4E7D8C */
	.page {
		width: 100%;
		height: 100%;
		background-color: #f8f7f4;
		display: flex;
		flex-direction: column;
	}

	/* ===== 顶部导航（返回箭头 ‹ + 居中标题 ~35rpx） ===== */
	.header {
		padding: 0 40rpx;
	}
	.nav-row {
		position: relative;
		height: 64rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-top: 94rpx;
		margin-bottom: 24rpx;
	}
	.back-btn {
		position: absolute;
		left: 0;
		top: 94rpx;
		width: 80rpx;
		height: 64rpx;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		z-index: 2;
	}
	.back-arrow {
		font-size: 48rpx;
		line-height: 64rpx;
		color: #3a2e25;
		font-weight: 300;
	}
	.nav-title {
		flex: 1;
		text-align: center;
		font-size: 35rpx;
		color: #3a2e25;
		font-weight: 700;
	}
	.header-sub {
		font-size: 22rpx;
		color: #8a7a6a;
		margin-top: 16rpx;
	}

	/* ===== 滚动内容区 ===== */
	.content-scroll {
		flex: 1;
		padding: 20rpx 38rpx 0 38rpx;
	}

	/* ===== 时间胶囊卡（设计稿: 673x200 rx=20，内嵌 642x169 rx=12 渐变面板） ===== */
	.featured-card {
		width: 673rpx;
		box-sizing: border-box;
		background-color: #ffffff;
		border-radius: 40rpx;
		padding: 15rpx;
		margin-bottom: 111rpx;
		box-shadow: 0 4rpx 16rpx rgba(58,46,37,0.06);
	}
	.featured-panel {
		width: 100%;
		background: linear-gradient(90deg, rgba(217,226,202,0.6), rgba(217,226,202,0.12));
		border-radius: 24rpx;
		padding: 28rpx;
		display: flex;
		flex-direction: column;
	}
	.featured-meta-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 12rpx;
	}
	.featured-meta {
		font-size: 21rpx;
		color: #7a8c5a;
		margin-left: 10rpx;
	}
	.featured-title {
		font-size: 30rpx;
		color: #3a2e25;
		font-weight: 700;
		margin-bottom: 8rpx;
	}
	.featured-sub {
		font-size: 23rpx;
		color: #5a4c40;
	}

	/* ===== 消息列表卡（设计稿: 673x392 rx=20，行距 123rpx，行间无分隔线） ===== */
	.message-card {
		width: 673rpx;
		box-sizing: border-box;
		background-color: #ffffff;
		border-radius: 40rpx;
		padding: 8rpx 28rpx;
		box-shadow: 0 4rpx 16rpx rgba(58,46,37,0.06);
	}
	.message-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 21rpx 0;
		min-height: 123rpx;
		position: relative;
	}
	.message-avatar {
		width: 80rpx;
		height: 80rpx;
		border-radius: 40rpx;
		display: flex;
		align-items: center;

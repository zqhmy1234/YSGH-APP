	}
	.message-top {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 6rpx;
	}
	.message-title {
		font-size: 27rpx;
		color: #3a2e25;
		font-weight: 600;
	}
	.message-time {
		font-size: 19rpx;
		color: #b3a696;
		margin-left: 16rpx;
	}
	.message-summary {
		font-size: 21rpx;
		color: #8a7a6a;
		line-height: 32rpx;
	}
	.unread-dot {
		width: 14rpx;
		height: 14rpx;
		background-color: #b05a3a;
		border-radius: 7rpx;
		margin-left: 16rpx;
		flex-shrink: 0;
	}

	/* ===== 空状态 ===== */
	.empty-state {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 80rpx 0;
	}
	.empty-text {
		font-size: 28rpx;
		color: #b3a696;
	}
	.bottom-spacer {
		height: 180rpx;
	}

	/* 按压态 */
	.pressable {
		transition: transform 0.15s ease, opacity 0.15s ease;
	}
</style>

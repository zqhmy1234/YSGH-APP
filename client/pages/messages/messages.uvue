	// ===== 响应式状态 =====
	let activeSegment = ref(0)
	let segments = ['系统通知', 'AI 互动']
	let unreadCount = ref(2)

	class MessageItem {
		id: string
		title: string
		summary: string
		time: string
		iconSvg: string
		avatarBg: string
		read: boolean
		type: number
		constructor(id: string, title: string, summary: string, time: string, iconSvg: string, avatarBg: string, read: boolean, type: number) {
			this.id = id
			this.title = title
			this.summary = summary
			this.time = time
			this.iconSvg = iconSvg
			this.avatarBg = avatarBg
			this.read = read
			this.type = type
		}
	}

	let messages = ref<Array<MessageItem>>([
		new MessageItem('1', '系统通知', '你的记忆备份已完成，共同步 12 张照片', '10:30', bellSvg, '#B0593B', false, 0),
		new MessageItem('2', 'AI 助手', '我为你整理了本周记忆摘要，点击查看', '昨天', aiAvatarSvg, '#7A8C5A', false, 1),
		new MessageItem('3', '互动提醒', '妈妈点赞了你的记忆「湖边的夕阳」', '3天前', tealAvatarSvg, '#4E7D8C', true, 0),
	])

	let filteredMessages = computed(() => {
		return messages.value.filter((m: MessageItem) => m.type === activeSegment.value)
	})

	function setSegment(idx: number): void {
		activeSegment.value = idx
	}

	function openMessage(msg: MessageItem): void {
		if (!msg.read) {
			msg.read = true
			if (unreadCount.value > 0) {
				unreadCount.value--
			}
		}
		uni.showToast({ title: '消息详情开发中', icon: 'none' })
	}

	function openFeatured(): void {
		uni.showToast({ title: 'AI 摘要详情开发中', icon: 'none' })
	}

	function onMore(): void {
		uni.showToast({ title: '更多操作', icon: 'none' })
	}

</script>


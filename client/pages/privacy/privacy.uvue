	/* ── 导航（settings.uvue 二级页先例原值；F3a 标题 18pt=34.6rpx） ── */
	.nav-title {
		position: absolute;
		/* absolute-ok: 固定页头·标题容器（全宽居中） */
		left: 0rpx;

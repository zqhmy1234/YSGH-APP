	/* ── 章节 chips（F3a y108：高 32px=61.5rpx，圆角 16px=30.8rpx，间距 gap8px=15.4rpx；行起 x20=38.5rpx） ── */
	.chips-row {
		position: absolute;
		/* absolute-ok: 固定筛选行（随内容滚动会失去锚点语义） */
		left: 38.5rpx;

		border-radius: 56rpx;
		background-color: #b05a3a;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-top: -40rpx;
		box-shadow: 0 8rpx 24rpx rgba(176, 90, 58, 0.4);
	}
	.tabbar-fab-icon {
		width: 48rpx;
		height: 48rpx;
		color: #f6f1e7;
		font-size: 48rpx;
		font-weight: 300;
		line-height: 48rpx;
		text-align: center;
	}

	/* 按压态动画 */
	.pressable {
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
</style>

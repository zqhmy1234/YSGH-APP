<template>
	<view class="page">
		<!-- 搜索框（设计稿: x=20 y=120 350x48 rx=24，琥珀描边#b0593b 60%） -->
		<view class="search-box">
			<view class="search-magnifier">
				<view class="search-magnifier-ring"></view>
				<view class="search-magnifier-handle"></view>
			</view>
			<input
				class="search-input"
				v-model="keyword"
				placeholder="搜索记忆、照片、主题…"
				placeholder-class="search-placeholder"
				confirm-type="search"
				@confirm="doSearch"
			/>
			<view v-if="keyword != ''" class="search-clear pressable" @tap="clearKeyword">
				<text class="search-clear-icon">×</text>
			</view>
			<view class="search-voice">
				<view class="search-mic-capsule"></view>
				<view class="search-mic-stem"></view>
				<view class="search-mic-base"></view>
			</view>
		</view>

		<!-- 筛选标签（设计稿: y=184 42x33 rx=16.5，激活态#b0593b 12%） -->
		<view class="filter-row">
			<view
				v-for="(f, idx) in filters"
				:key="idx"
				class="filter-tag pressable"
				:class="{ 'filter-tag-active': activeFilter === idx }"
				@tap="setFilter(idx)"
			>
				<text class="filter-text" :class="{ 'filter-text-active': activeFilter === idx }">{{ f }}</text>
			</view>
		</view>

		<!-- 结果区 -->
		<scroll-view class="result-list">
			<!-- 结果计数（设计稿: y=235.8 #8a7a6a） -->
			<text class="result-count">{{ resultCountText() }}</text>

			<!-- 语音卡（设计稿: y=258 350x133 rx=20，语音区#c4913c 14%） -->
			<view v-for="(item, idx) in voiceResults" :key="'v' + idx" class="result-card pressable" @tap="openResult(item)">
				<view class="voice-zone">
					<view class="voice-play-btn pressable" :class="{ 'is-playing': playingId === item.id }" @tap.stop="playVoice(item)">
						<view v-if="playingId !== item.id" class="voice-play-triangle"></view>
						<view v-else class="voice-pause">
							<view class="voice-pause-bar"></view>
							<view class="voice-pause-bar"></view>
						</view>
					</view>
					<view class="voice-wave">
						<view v-for="(h, i) in item.waveHeights" :key="i" class="voice-wave-bar" :style="{ height: h + 'rpx' }"></view>
					</view>
				</view>
				<text class="voice-title">{{ item.title }}</text>
				<view class="result-meta voice-card-meta">
					<text class="result-meta-text">{{ item.meta }}</text>
				</view>
			</view>

			<!-- 文字卡（设计稿: y=404 350x109 rx=20，引用区#c4913c 10%，引用竖线#c4913c） -->
			<view v-for="(item, idx) in textResults" :key="'t' + idx" class="result-card pressable" @tap="openResult(item)">
				<view class="quote-zone">
					<view class="quote-line"></view>
					<view class="quote-content">
						<text class="quote-text">{{ item.text }}</text>
					</view>
				</view>
				<view class="result-meta quote-card-meta">
					<text class="result-meta-text">{{ item.meta }}</text>
				</view>
			</view>

			<!-- 空状态 -->
			<view v-if="voiceResults.length === 0 && textResults.length === 0" class="empty-state">
				<text class="empty-icon">🔍</text>
				<text class="empty-text">{{ emptyText() }}</text>
			</view>
		</scroll-view>

		<!-- 玻璃 TabBar（设计稿: 350x62 rx=31 #f6f1e7bf，与其他页面保持一致） -->
		<view class="glass-tabbar">
			<view class="tabbar-item pressable" @tap="goIndex">
				<text class="tabbar-icon">🏠</text>
				<text class="tabbar-label">时间轴</text>
			</view>
			<view class="tabbar-item pressable" @tap="goAI">
				<text class="tabbar-icon">✨</text>
				<text class="tabbar-label">AI</text>
			</view>
			<view class="tabbar-fab pressable" @tap="goRecord">
				<text class="tabbar-fab-icon">+</text>
			</view>
			<view class="tabbar-item active pressable" @tap="goSearch">
				<text class="tabbar-icon">🔍</text>
				<text class="tabbar-label tabbar-label-active">搜索</text>
			</view>
			<view class="tabbar-item pressable" @tap="goProfile">
				<text class="tabbar-icon">👤</text>
				<text class="tabbar-label">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'

	// 响应式数据
	let keyword = ref('')
	let activeFilter = ref(0)
	let playingId = ref('')
	let filters = ['全部', '照片', '语音', '文字']

	class VoiceResult {
		id: string
		title: string
		meta: string
		waveHeights: Array<number>
		constructor(id: string, title: string, meta: string, waveHeights: Array<number>) {
			this.id = id
			this.title = title
			this.meta = meta
			this.waveHeights = waveHeights
		}
	}

	class TextResult {
		id: string
		text: string
		meta: string
		constructor(id: string, text: string, meta: string) {
			this.id = id
			this.text = text
			this.meta = meta
		}
	}

	// 全量 mock 数据（设计稿示例：2 条语音 + 2 条文字）
	let allVoice = [
		new VoiceResult('v1', '和妈妈的通话', '语音 · 1分23秒 · 周末回家', [8, 14, 22, 30, 36, 40, 36, 28, 18, 10, 16, 26, 34, 40, 38, 30, 20, 12, 18, 28, 36, 40, 34, 24, 14, 10, 16, 24]),
		new VoiceResult('v2', '会议录音', '语音 · 0分45秒 · 项目讨论', [24, 32, 40, 36, 26, 14, 20, 30, 38, 40, 34, 22, 12, 18, 28, 36, 40, 34, 24, 14, 20, 30, 38, 40, 32, 22, 12, 18]),
	]
	let allText = [
		new TextResult('t1', '今天的夕阳很美，像去年夏天的那个傍晚。', '文字 · 日记'),
		new TextResult('t2', '妈妈说，记得多穿点衣服，别着凉了。', '文字 · 妈妈'),
	]

	// 按「筛选类型 + 关键词」过滤（computed 响应 keyword / activeFilter 自动重算）
	let voiceResults = computed(() => {
		let showVoice = activeFilter.value === 0 || activeFilter.value === 2
		let kw = keyword.value.trim()
		return allVoice.filter((m: VoiceResult) => {
			if (!showVoice) {
				return false
			}
			if (kw == '') {
				return true
			}
			return m.title.indexOf(kw) >= 0 || m.meta.indexOf(kw) >= 0
		})
	})

	let textResults = computed(() => {
		let showText = activeFilter.value === 0 || activeFilter.value === 3
		let kw = keyword.value.trim()
		return allText.filter((m: TextResult) => {
			if (!showText) {
				return false
			}
			if (kw == '') {
				return true
			}
			return m.text.indexOf(kw) >= 0 || m.meta.indexOf(kw) >= 0
		})
	})

	function resultCountText(): string {
		let n = voiceResults.value.length + textResults.value.length
		return '共 ' + n.toString() + ' 条结果'
	}

	function emptyText(): string {
		if (activeFilter.value === 1) {
			return '暂无照片结果'
		}
		return '没有找到相关记忆，换个关键词试试'
	}

	function setFilter(idx: number): void {
		activeFilter.value = idx
	}

	function clearKeyword(): void {
		keyword.value = ''
	}

	function doSearch(): void {
		if (keyword.value != '') {
			uni.showToast({ title: '已搜索：' + keyword.value, icon: 'none' })
		}
	}

	function openResult(item: any): void {
		uni.showToast({ title: '记忆详情页开发中', icon: 'none' })
	}

	function playVoice(item: VoiceResult): void {
		if (playingId.value === item.id) {
			playingId.value = ''
			uni.showToast({ title: '已暂停', icon: 'none' })
		} else {
			playingId.value = item.id
			uni.showToast({ title: '正在播放：' + item.title, icon: 'none' })
		}
	}

	// TabBar 导航（与全库一致）
	function goIndex(): void {
		uni.reLaunch({ url: '/pages/index/index' })
	}
	function goAI(): void {
		uni.showToast({ title: 'AI 功能开发中', icon: 'none' })
	}
	function goRecord(): void {
		uni.reLaunch({ url: '/pages/record/record' })
	}
	function goSearch(): void {
		// 当前页面
	}
	function goProfile(): void {
		uni.reLaunch({ url: '/pages/profile/profile' })
	}
</script>

<style>
	/* 视觉规范 v3：像素级还原 SVG 设计稿（390x844 画布，rpx = 设计px × 2）
	   背景 #f8f7f4 / 搜索框 700x96 rx=48 白底+琥珀描边 / 筛选标签 84x66 rx=33
	   语音卡 700x266 rx=40 / 文字卡 700x218 rx=40 / 玻璃 TabBar #f6f1e7bf rx=62 */
	.page {
		width: 100%;
		height: 100%;
		background-color: #f8f7f4;
		display: flex;
		flex-direction: column;
	}

	/* ===== 搜索框（设计稿: x=20 y=120 350x48 rx=24，阴影 dy=6 blur=9 alpha 0.08） ===== */
	.search-box {
		position: relative;
		margin: 240rpx 40rpx 0 40rpx;
		width: 700rpx;
		height: 96rpx;
		background-color: #ffffff;
		border: 2rpx solid rgba(176, 89, 59, 0.6);
		border-radius: 48rpx;
		box-sizing: border-box;
		display: flex;
		flex-direction: row;
		align-items: center;
		box-shadow: 0 12rpx 18rpx rgba(58, 45, 38, 0.08);
	}
	/* 放大镜（设计稿: 圆形描边 #b05a3a + 斜柄，中心 48/46） */
	.search-magnifier {
		position: absolute;
		left: 38rpx;
		top: 36rpx;
		width: 24rpx;
		height: 24rpx;
	}
	.search-magnifier-ring {
		position: absolute;
		left: 0;
		top: 0;
		width: 15rpx;
		height: 15rpx;
		border: 3rpx solid #b05a3a;
		border-radius: 50%;
		box-sizing: border-box;
	}
	.search-magnifier-handle {
		position: absolute;
		right: 1rpx;
		bottom: 1rpx;
		width: 13rpx;
		height: 3rpx;
		background-color: #b05a3a;
		border-radius: 2rpx;
		transform: rotate(45deg);
	}
	.search-input {
		flex: 1;
		height: 96rpx;
		padding-left: 86rpx;
		padding-right: 12rpx;
		font-size: 32rpx;
		color: #3a2e25;
	}
	.search-placeholder {
		color: #b3a696;
	}
	/* 清除按钮（输入时出现） */
	.search-clear {
		width: 44rpx;

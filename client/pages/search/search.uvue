<template>
	<view class="page">
		<view class="header">
			<text class="header-title serif">搜索</text>
			<text class="header-sub">找回一段记忆</text>
		</view>

		<!-- 搜索框 + 提交（T-SR-1） -->
		<view class="search-bar">
			<input
				class="search-input"
				v-model="query"
				placeholder="试着描述：上周和妈妈吃饭…"
				confirm-type="search"
				@confirm="doSearch"
			/>
			<view class="search-btn" @tap="doSearch">
				<text class="search-btn-text">搜索</text>
			</view>
		</view>

		<!-- 以图搜图入口（T-SR-3） -->
		<view class="image-row">
			<text class="muted">以图搜图：</text>
			<view class="image-btn" @tap="pickImage">
				<text class="image-btn-text">选择照片</text>
			</view>
			<image v-if="queryImage != ''" class="query-thumb" :src="queryImage" mode="aspectFill" />
		</view>

		<!-- 降级提示（T-SR-4） -->
		<view v-if="degraded" class="degraded-bar">
			<text class="degraded-text">检索服务降级中，结果可能不完整</text>
		</view>

		<!-- 加载态 -->
		<view v-if="loading" class="center-box">
			<text class="muted">正在翻找…</text>
		</view>

		<!-- 空结果 -->
		<view v-else-if="searched && outcome != null && outcome.hits.length === 0" class="center-box">
			<text class="empty-title serif">没有找到</text>
			<text class="empty-desc">换个说法试试，或选一张照片搜索</text>
		</view>

		<!-- 结果列表（T-SR-2 混合卡片 + 溯源） -->
		<scroll-view scroll-y="true" v-else-if="outcome != null" class="result-list">
			<view v-if="outcome.rewrittenQuery != '' && outcome.rewrittenQuery != outcome.query" class="rewrite-line">
				<text class="muted">理解为你说的：{{ outcome.rewrittenQuery }}</text>
			</view>
			<view v-for="hit in outcome.hits" :key="hit.contentId" class="hit-card pressable" @tap="onHitTap(hit)">
				<view class="hit-head">
					<text class="hit-type">{{ contentTypeCn(hit.contentType) }}</text>
					<text v-if="hit.eventTitle != ''" class="hit-event">{{ hit.eventTitle }}</text>
					<text class="hit-score">{{ scorePct(hit.score) }}%</text>
				</view>
				<text v-if="hit.text != ''" class="hit-text">{{ hit.text }}</text>
				<view class="hit-meta">
					<text v-if="hit.place != ''" class="meta-item">{{ hit.place }}</text>
					<text v-if="hit.takenAt != ''" class="meta-item">{{ shortDate(hit.takenAt) }}</text>
				</view>
				<view v-if="hit.trace != ''" class="trace-box">
					<text class="trace-label">命中依据</text>
					<text class="trace-text">{{ hit.trace }}</text>
				</view>
			</view>
			<view class="result-foot">
				<text class="muted">共 {{ outcome.total }} 条 · {{ outcome.latencyMs }}ms</text>
			</view>
		</scroll-view>

		<!-- 玻璃 TabBar（半透明白 55% + 中央＋按钮） -->
		<view class="glass-tabbar">
			<view class="tabbar-item  pressable" @tap="goIndex">
				<text class="tabbar-icon">🏠</text>
				<text class="tabbar-label">时间轴</text>
			</view>
			<view class="tabbar-item active pressable" @tap="goSearch">
				<text class="tabbar-icon">🔍</text>
				<text class="tabbar-label">搜索</text>
			</view>
			<view class="tabbar-fab pressable" @tap="goRecord">
				<text class="tabbar-fab-icon">+</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goMessages">
				<text class="tabbar-icon">💬</text>
				<text class="tabbar-label">消息</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goProfile">
				<text class="tabbar-icon">👤</text>
				<text class="tabbar-label">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad } from '@dcloudio/uni-app'
	import { ensureLogin } from '@/utils/auth'
	import { searchText, searchByImage, SearchOutcome, contentTypeCn as formatContentTypeCn } from '@/utils/search_api'
	import { showErrorToast } from '@/utils/api'
	import { shortDate as formatShortDate } from '@/utils/time'

	// 响应式数据
	let query = ''
	let queryImage = ''
	let loading = false
	let searched = false
	let degraded = false
	let outcome: SearchOutcome | null = null

	// 搜索结果点击
function onHitTap(hit: any): void {
\tuni.showToast({ title: '查看: ' + (hit.text != '' ? hit.text.substring(0, 20) : hit.contentType), icon: 'none' })
}

// 生命周期
	onLoad(() => {
		ensureLogin().then((ok: boolean) => {
			if (!ok) {
				showErrorToast(new Error('登录失败，请重试'))
			}
		})
	})

	// 导航方法
	function goIndex(): void {
		uni.reLaunch({ url: '/pages/index/index' })
	}
	function goSearch(): void {
		uni.reLaunch({ url: '/pages/search/search' })
	}
	function goRecord(): void {
		uni.reLaunch({ url: '/pages/record/record' })
	}
	function goMessages(): void {
		uni.reLaunch({ url: '/pages/messages/messages' })
	}
	function goProfile(): void {
		uni.reLaunch({ url: '/pages/profile/profile' })
	}

	// 工具方法
	function scorePct(score: number): number {
		return Math.round(score * 100)
	}
	function contentTypeCn(t: string): string {
		return formatContentTypeCn(t)
	}
	function shortDate(iso: string): string {
		return formatShortDate(iso)
	}

	// 业务方法
	function doSearch(): void {
		const q = query.trim()
		if (q == '' && queryImage == '') {
			showErrorToast(new Error('输入想找的内容'))
			return
		}
		loading = true
		searched = false
		degraded = false
		searchText(q, 10).then((out: SearchOutcome | null) => {
			loading = false
			searched = true
			if (out != null) {
				outcome = out
				degraded = out.degraded
			} else {
				outcome = null
			}
		})
	}
	function pickImage(): void {
		uni.chooseMedia({
			count: 1,
			mediaType: ['image'],
			sourceType: ['album'],
			success: (res) => {
				const files = res.tempFiles
				if (files.length === 0) {
					return
				}
				const path = files.tempFilePath
				queryImage = path
				loading = true
				searched = false
				degraded = false
				searchByImage(path, 10).then((out: SearchOutcome | null) => {
					loading = false
					searched = true
					if (out != null) {
						outcome = out
						degraded = out.degraded
					} else {
						outcome = null
					}
				})
			},
			fail: () => {
				// 用户取消选择：静默
			}
		})
	}
</script>


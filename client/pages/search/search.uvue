		border-radius: 22rpx;
		background-color: rgba(138, 122, 106, 0.15);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 14rpx;
	}
	.search-clear-icon {
		font-size: 30rpx;
		color: #8a7a6a;
		line-height: 30rpx;
	}
	/* 语音（麦克风）图标 */
	.search-voice {
		position: relative;
		width: 32rpx;
		height: 40rpx;
		margin-right: 26rpx;
	}
	.search-mic-capsule {
		position: absolute;
		top: 0;
		left: 6rpx;
		width: 20rpx;
		height: 26rpx;
		border: 3rpx solid #8a7a6a;
		border-radius: 10rpx;
		box-sizing: border-box;
	}
	.search-mic-stem {
		position: absolute;
		top: 24rpx;
		left: 14rpx;
		width: 4rpx;
		height: 11rpx;
		background-color: #8a7a6a;
		border-radius: 2rpx;
	}
	.search-mic-base {
		position: absolute;
		top: 31rpx;
		left: 2rpx;
		width: 28rpx;
		height: 4rpx;
		background-color: #8a7a6a;
		border-radius: 3rpx;
	}

	/* ===== 筛选标签（设计稿: y=184 42x33 rx=16.5，无阴影） ===== */
	.filter-row {
		display: flex;
		flex-direction: row;
		margin: 32rpx 40rpx 0 40rpx;
	}
	.filter-tag {
		width: 84rpx;
		height: 66rpx;
		background-color: #ffffff;
		border-radius: 33rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 16rpx;
	}
	.filter-tag-active {
		background-color: rgba(176, 89, 59, 0.12);
	}
	.filter-text {
		font-size: 22rpx;
		color: #8a7a6a;
	}
	.filter-text-active {
		color: #b05a3a;
		font-weight: 600;
	}

	/* ===== 结果区 ===== */
	.result-list {
		flex: 1;
		padding: 0 40rpx 220rpx 40rpx;
	}
	/* 结果计数（设计稿: y=235.8 #8a7a6a） */
	.result-count {
		display: flex;
		margin: 38rpx 0 22rpx 0;
		font-size: 22rpx;
		color: #8a7a6a;
	}

	/* ===== 结果卡（设计稿: 语音 350x133 / 文字 350x109，rx=20，阴影 dy=4 blur=8 alpha 0.06） ===== */
	.result-card {
		width: 700rpx;
		background-color: #ffffff;
		border-radius: 40rpx;
		padding: 16rpx 16rpx 34rpx 16rpx;
		margin-bottom: 26rpx;
		box-sizing: border-box;
		box-shadow: 0 8rpx 16rpx rgba(58, 46, 37, 0.06);
		display: flex;
		flex-direction: column;
	}

	/* 语音区（设计稿: 28,266,334x64 rx=12，#c4913c 14%） */
	.voice-zone {
		position: relative;
		width: 668rpx;
		height: 128rpx;
		background-color: rgba(196, 145, 60, 0.14);
		border-radius: 24rpx;
	}
	/* 播放按钮：白底圆 + 琥珀三角（设计稿: 中心 58,298 r=16） */
	.voice-play-btn {
		position: absolute;
		left: 28rpx;
		top: 32rpx;
		width: 64rpx;
		height: 64rpx;
		border-radius: 32rpx;
		background-color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4rpx 8rpx rgba(58, 46, 37, 0.12);
	}
	.voice-play-triangle {
		width: 0;
		height: 0;
		border-left: 15rpx solid #b05a3a;
		border-top: 9rpx solid transparent;
		border-bottom: 9rpx solid transparent;
		margin-left: 4rpx;
	}
	.voice-pause {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.voice-pause-bar {
		width: 6rpx;
		height: 24rpx;
		background-color: #b05a3a;
		border-radius: 3rpx;
		margin: 0 4rpx;
	}
	/* 波形（设计稿: 100.8,286.8,182.4x22.4，#c4913c） */
	.voice-wave {
		position: absolute;
		left: 146rpx;
		top: 42rpx;
		width: 364rpx;
		height: 44rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.voice-wave-bar {
		width: 6rpx;
		background-color: #c4913c;
		border-radius: 3rpx;
	}
	/* 语音卡标题（设计稿: y=340.6 #3a2e25 约16px） */
	.voice-title {
		display: flex;
		margin: 21rpx 0 0 17rpx;
		font-size: 32rpx;
		line-height: 40rpx;
		color: #3a2e25;
		font-weight: 600;
	}

	/* 引用区（设计稿: 28,412,334x64 rx=12，#c4913c 10%） */
	.quote-zone {
		width: 668rpx;
		height: 128rpx;
		background-color: rgba(196, 145, 60, 0.10);
		border-radius: 24rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 24rpx;
		box-sizing: border-box;
	}
	/* 引用竖线（设计稿: 40,424,3x40 #c4913c rx=1.5） */
	.quote-line {
		width: 6rpx;
		height: 80rpx;
		background-color: #c4913c;
		border-radius: 3rpx;
		margin-right: 21rpx;
	}
	.quote-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	/* 引言体（设计稿: y=426 #5a4c40 约15px 两行） */
	.quote-text {
		font-size: 28rpx;
		line-height: 40rpx;
		color: #5a4c40;
		font-style: italic;
	}

	/* 卡底元信息（设计稿: #8a7a6a 约10px） */

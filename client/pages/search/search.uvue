<script setup lang="uts">
	import { onLoad } from '@dcloudio/uni-app'
	import { ensureLogin } from '@/utils/auth'
	import { searchText, searchByImage, SearchOutcome, contentTypeCn as formatContentTypeCn } from '@/utils/search_api'
	import { showErrorToast } from '@/utils/api'
	import { shortDate as formatShortDate } from '@/utils/time'

	// 响应式数据
	let query = ''
	let queryImage = ''
	let loading = false
	let searched = false
	let degraded = false
	let outcome: SearchOutcome | null = null

	// 搜索结果点击
function onHitTap(hit: any): void {
\tuni.showToast({ title: '查看: ' + (hit.text != '' ? hit.text.substring(0, 20) : hit.contentType), icon: 'none' })
}

// 生命周期
	onLoad(() => {
		ensureLogin().then((ok: boolean) => {
			if (!ok) {
				showErrorToast(new Error('登录失败，请重试'))
			}
		})
	})

	// 导航方法
	function goIndex(): void {
		uni.reLaunch({ url: '/pages/index/index' })
	}
	function goSearch(): void {
		uni.reLaunch({ url: '/pages/search/search' })
	}
	function goRecord(): void {
		uni.reLaunch({ url: '/pages/record/record' })
	}
	function goMessages(): void {
		uni.reLaunch({ url: '/pages/messages/messages' })
	}
	function goProfile(): void {
		uni.reLaunch({ url: '/pages/profile/profile' })
	}

	// 工具方法
	function scorePct(score: number): number {
		return Math.round(score * 100)
	}
	function contentTypeCn(t: string): string {
		return formatContentTypeCn(t)
	}
	function shortDate(iso: string): string {
		return formatShortDate(iso)
	}

	// 业务方法
	function doSearch(): void {
		const q = query.trim()
		if (q == '' && queryImage == '') {
			showErrorToast(new Error('输入想找的内容'))
			return
		}
		loading = true
		searched = false
		degraded = false
		searchText(q, 10).then((out: SearchOutcome | null) => {
			loading = false
			searched = true
			if (out != null) {
				outcome = out
				degraded = out.degraded
			} else {
				outcome = null
			}
		})
	}
	function pickImage(): void {
		uni.chooseMedia({
			count: 1,
			mediaType: ['image'],
			sourceType: ['album'],
			success: (res) => {
				const files = res.tempFiles
				if (files.length === 0) {
					return
				}
				const path = files.tempFilePath
				queryImage = path
				loading = true
				searched = false
				degraded = false
				searchByImage(path, 10).then((out: SearchOutcome | null) => {
					loading = false
					searched = true
					if (out != null) {
						outcome = out
						degraded = out.degraded
					} else {
						outcome = null
					}
				})
			},
			fail: () => {
				// 用户取消选择：静默
			}
		})
	}
</script>


<template>
	<view class="page">
		<!-- 页首大标题（设计稿: 21,61 ≈38px=73rpx 粗 #3a2e25 左对齐） -->
		<text class="page-title">搜索</text>

		<!-- 搜索框（设计稿: x=20 y=120 350x48 rx=24，琥珀描边#b0593b 60%） -->
		<view class="search-box">
			<view class="search-magnifier">
				<view class="search-magnifier-ring"></view>
				<view class="search-magnifier-handle"></view>
			</view>
			<input
				class="search-input"
				v-model="keyword"
				placeholder="搜索记忆、照片、主题…"
				placeholder-class="search-placeholder"
				confirm-type="search"
				@confirm="doSearch"
			/>
		</view>

		<!-- 筛选标签（设计稿: y=184 42x33 rx=16.5，激活态#b0593b 12%） -->
		<view class="filter-row">
			<view
				v-for="(f, idx) in filters"
				:key="idx"
				class="filter-tag pressable"
				:class="{ 'filter-tag-active': activeFilter === idx }"
				@tap="setFilter(idx)"
			>
				<text class="filter-text" :class="{ 'filter-text-active': activeFilter === idx }">{{ f }}</text>
			</view>
		</view>

		<!-- 结果区 -->
		<scroll-view class="result-list">
			<!-- 结果计数（设计稿: y=235.8 #8a7a6a） -->
			<text class="result-count">{{ resultCountText() }}</text>

			<!-- 语音卡（设计稿: y=258 350x133 rx=20，语音区#c4913c 14%） -->
			<view v-for="(item, idx) in voiceResults" :key="'v' + idx" class="result-card pressable" @tap="openResult(item)">
				<view class="voice-zone">
					<view class="voice-play-btn pressable" :class="{ 'is-playing': playingId === item.id }" @tap.stop="playVoice(item)">
						<view v-if="playingId !== item.id" class="voice-play-triangle"></view>
						<view v-else class="voice-pause">
							<view class="voice-pause-bar"></view>
							<view class="voice-pause-bar"></view>
						</view>
					</view>
					<view class="voice-wave">
						<view v-for="(h, i) in item.waveHeights" :key="i" class="voice-wave-bar" :style="{ height: h + 'rpx' }"></view>
					</view>
				</view>
				<text class="voice-title">{{ item.title }}</text>
				<view class="result-meta voice-card-meta">
					<text class="result-meta-text">{{ item.meta }}</text>
				</view>
			</view>

			<!-- 文字卡（设计稿: y=404 350x109 rx=20，引用区#c4913c 10%，引用竖线#c4913c） -->
			<view v-for="(item, idx) in textResults" :key="'t' + idx" class="result-card pressable" @tap="openResult(item)">
				<view class="quote-zone">
					<view class="quote-line"></view>
					<view class="quote-content">
						<text class="quote-text">{{ item.text }}</text>
					</view>
				</view>
				<view class="result-meta quote-card-meta">
					<text class="result-meta-text">{{ item.meta }}</text>
				</view>
			</view>

			<!-- 空状态 -->
			<view v-if="voiceResults.length === 0 && textResults.length === 0" class="empty-state">
				<text class="empty-icon">🔍</text>
				<text class="empty-text">{{ emptyText() }}</text>
			</view>
		</scroll-view>

		<!-- 统一 TabBar 组件 -->
		<TabBar active="search" />
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { searchText, SearchHitItem, contentTypeCn } from '@/utils/search_api'
	import { shortDate } from '@/utils/time'

	// ── 响应式状态 ──
	let keyword = ref('')
	let activeFilter = ref(0)
	let playingId = ref('')
	let loading = ref(false)
	let hasSearched = ref(false)
	let degraded = ref(false)
	let hits = ref<Array<SearchHitItem>>([])
	let filters = ['全部', '照片', '语音', '文字']

	// 从「我的」类型卡跳入：?type=photo/voice/text 预设对应筛选标签
	onLoad((options: OnLoadOptions) => {
		const t = options['type'] as string
		if (t == 'photo') {
			activeFilter.value = 1
		} else if (t == 'voice') {
			activeFilter.value = 2
		} else if (t == 'text') {
			activeFilter.value = 3
		}
	})

	// ── 卡片视图模型（兼容模板：语音卡 / 文字卡） ──
	class VoiceResult {
		id: string
		title: string
		meta: string
		waveHeights: Array<number>
		constructor(id: string, title: string, meta: string, waveHeights: Array<number>) {
			this.id = id
			this.title = title
			this.meta = meta
			this.waveHeights = waveHeights
		}
	}

	class TextResult {
		id: string
		text: string
		meta: string
		constructor(id: string, text: string, meta: string) {
			this.id = id
			this.text = text
			this.meta = meta
		}
	}

	/** 由 contentId 确定性生成装饰波形（28 根，8~40rpx；真实音频波形待语音流接入） */
	function genWave(id: string): Array<number> {
		let seed = 7
		for (let i = 0; i < id.length; i++) {
			seed = (seed * 31 + id.charCodeAt(i)) % 100000
		}
		const arr: Array<number> = []
		for (let i = 0; i < 28; i++) {
			seed = (seed * 1103515245 + 12345) % 100000
			arr.push(8 + (seed % 33))
		}
		return arr
	}

	/** 组装卡底元信息：类型 · 日期 · 所属事件 */
	function hitMeta(h: SearchHitItem): string {
		let s = contentTypeCn(h.contentType)
		if (h.takenAt != '') {
			s += ' · ' + shortDate(h.takenAt)
		}
		if (h.eventTitle != '') {
			s += ' · ' + h.eventTitle
		}
		return s
	}

	// 筛选标签 → 后端 content_types（全部=不过滤）
	function filterContentTypes(): Array<string> {
		if (activeFilter.value === 1) {
			return ['photo']
		}
		if (activeFilter.value === 2) {
			return ['voice']
		}
		if (activeFilter.value === 3) {
			return ['text']
		}
		return []
	}

	// 语音结果（content_type=voice → 语音卡）
	let voiceResults = computed((): Array<VoiceResult> => {
		const out: Array<VoiceResult> = []
		for (let i = 0; i < hits.value.length; i++) {
			const h = hits.value[i]
			if (h.contentType == 'voice') {
				const title = h.eventTitle != '' ? h.eventTitle : '语音记忆'
				out.push(new VoiceResult(h.contentId, title, hitMeta(h), genWave(h.contentId)))
			}
		}
		return out
	})

	// 文字 / 照片结果（photo 的 caption 与 text 同走引用文字卡）
	let textResults = computed((): Array<TextResult> => {
		const out: Array<TextResult> = []
		for (let i = 0; i < hits.value.length; i++) {
			const h = hits.value[i]
			if (h.contentType == 'voice') {
				continue
			}
			const txt = h.text != '' ? h.text : '（无文本描述）'
			out.push(new TextResult(h.contentId, txt, hitMeta(h)))
		}
		return out
	})

	function resultCountText(): string {
		if (loading.value) {
			return '搜索中…'
		}
		let n = voiceResults.value.length + textResults.value.length
		return hasSearched.value ? ('共 ' + n.toString() + ' 条结果') : '输入关键词，搜索你的记忆'
	}

	function emptyText(): string {
		if (!hasSearched.value) {
			return '输入关键词开始搜索'
		}
		if (activeFilter.value === 1) {
			return '暂无照片结果'
		}
		if (activeFilter.value === 2) {
			return '暂无语音结果'
		}
		if (activeFilter.value === 3) {
			return '暂无文字结果'
		}
		return '没有找到相关记忆，换个关键词试试'
	}

	function setFilter(idx: number): void {
		activeFilter.value = idx
		// 已搜过则按新类型重新请求
		if (hasSearched.value && keyword.value.trim() != '') {
			runSearch()
		}
	}

	function clearKeyword(): void {
		keyword.value = ''
		hits.value = []
		hasSearched.value = false
	}

	/** 发起描述性搜索（resolve-only，失败由封装 toast） */
	function runSearch(): void {
		const q = keyword.value.trim()
		if (q == '') {
			uni.showToast({ title: '请输入搜索关键词', icon: 'none' })
			return
		}
		loading.value = true
		searchText(q, 30, filterContentTypes()).then((out) => {
			loading.value = false
			hasSearched.value = true
			if (out == null) {
				hits.value = []
				return
			}
			hits.value = out.hits
			degraded.value = out.degraded
		})
	}

	function doSearch(): void {
		runSearch()
	}

	function openResult(item: any): void {
		const id = (item as VoiceResult).id
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + id })
	}

	function playVoice(item: VoiceResult): void {
		if (playingId.value === item.id) {
			playingId.value = ''
		} else {
			playingId.value = item.id
			uni.showToast({ title: '语音播放待接入音频流', icon: 'none' })
		}
	}
</script>

<style>
	/* 视觉规范 v3：像素级还原 SVG 设计稿（390x844 画布，rpx = 设计px × 2）
	   背景 #f8f7f4 / 搜索框 700x96 rx=48 白底+琥珀描边 / 筛选标签 84x66 rx=33
	   语音卡 700x266 rx=40 / 文字卡 700x218 rx=40 / 玻璃 TabBar #f6f1e7bf rx=62 */
	.page {
		width: 100%;
		height: 100%;
		background-color: #f8f7f4;
		display: flex;
		flex-direction: column;
		position: relative;
	}

	/* 页首大标题（设计稿: 21,61 ≈38px=73rpx 粗 #3a2e25 左对齐） */
	.page-title {
		position: absolute;
		top: 44rpx;
		left: 40rpx;
		font-size: 73rpx;
		font-weight: bold;
		color: #3a2e25;
		line-height: 88rpx;
	}

	/* ===== 搜索框（设计稿: x=20 y=120 350x48 rx=24，阴影 dy=6 blur=9 alpha 0.08） ===== */
	.search-box {
		position: relative;
		margin: 146rpx 40rpx 0 40rpx;
		width: 700rpx;
		height: 96rpx;
		background-color: #ffffff;
		border: 2rpx solid rgba(176, 89, 59, 0.6);
		border-radius: 48rpx;
		box-sizing: border-box;
		display: flex;
		flex-direction: row;
		align-items: center;
		box-shadow: 0 12rpx 18rpx rgba(58, 45, 38, 0.08);
	}
	/* 放大镜（设计稿: 圆形描边 #b05a3a + 斜柄，中心 48/46） */
	.search-magnifier {
		position: absolute;
		left: 46rpx;
		top: 36rpx;
		width: 24rpx;
		height: 24rpx;
	}
	.search-magnifier-ring {
		position: absolute;
		left: 0;
		top: 0;
		width: 15rpx;
		height: 15rpx;
		border: 3rpx solid #b05a3a;
		border-radius: 50%;
		box-sizing: border-box;
	}
	.search-magnifier-handle {
		position: absolute;
		right: 1rpx;
		bottom: 1rpx;
		width: 13rpx;
		height: 3rpx;
		background-color: #b05a3a;
		border-radius: 2rpx;
		transform: rotate(45deg);
	}
	.search-input {
		flex: 1;
		height: 96rpx;
		padding-left: 94rpx;
		padding-right: 12rpx;
		font-size: 35rpx;
		color: #3a2e25;
	}
	.search-placeholder {
		color: #b3a696;
	}

	/* ===== 筛选标签（设计稿: y=184 42x33 rx=16.5，无阴影） ===== */
	.filter-row {
		display: flex;
		flex-direction: row;
		margin: 32rpx 40rpx 0 40rpx;
	}
	.filter-tag {
		width: 84rpx;
		height: 66rpx;
		background-color: #ffffff;
		border-radius: 33rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 16rpx;
	}
	.filter-tag-active {
		background-color: rgba(176, 89, 59, 0.12);
	}
	.filter-text {
		font-size: 22rpx;
		color: #8a7a6a;
	}
	.filter-text-active {
		color: #b05a3a;
		font-weight: 600;
	}

	/* ===== 结果区 ===== */
	.result-list {
		flex: 1;
		padding: 0 40rpx 220rpx 40rpx;
	}
	/* 结果计数（设计稿: y=235.8 #8a7a6a） */
	.result-count {
		display: flex;
		margin: 38rpx 0 22rpx 0;
		font-size: 22rpx;
		color: #8a7a6a;
	}

	/* ===== 结果卡（设计稿: 语音 350x133 / 文字 350x109，rx=20，阴影 dy=4 blur=8 alpha 0.06） ===== */
	.result-card {
		width: 700rpx;
		background-color: #ffffff;
		border-radius: 40rpx;
		padding: 16rpx 16rpx 34rpx 16rpx;
		margin-bottom: 26rpx;
		box-sizing: border-box;
		box-shadow: 0 8rpx 16rpx rgba(58, 46, 37, 0.06);
		display: flex;
		flex-direction: column;
	}

	/* 语音区（设计稿: 28,266,334x64 rx=12，#c4913c 14%） */
	.voice-zone {
		position: relative;
		width: 668rpx;
		height: 128rpx;
		background-color: rgba(196, 145, 60, 0.14);
		border-radius: 24rpx;
	}
	/* 播放按钮：白底圆 + 琥珀三角（设计稿: 中心 58,298 r=16） */
	.voice-play-btn {
		position: absolute;
		left: 28rpx;
		top: 32rpx;
		width: 64rpx;
		height: 64rpx;
		border-radius: 32rpx;
		background-color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4rpx 8rpx rgba(58, 46, 37, 0.12);
	}
	.voice-play-triangle {
		width: 0;
		height: 0;
		border-left: 15rpx solid #b05a3a;
		border-top: 9rpx solid transparent;
		border-bottom: 9rpx solid transparent;
		margin-left: 4rpx;
	}
	.voice-pause {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.voice-pause-bar {
		width: 6rpx;
		height: 24rpx;
		background-color: #b05a3a;
		border-radius: 3rpx;
		margin: 0 4rpx;
	}
	/* 波形（设计稿: 100.8,286.8,182.4x22.4，#c4913c） */
	.voice-wave {
		position: absolute;
		left: 146rpx;
		top: 42rpx;
		width: 364rpx;
		height: 44rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.voice-wave-bar {
		width: 6rpx;
		background-color: #c4913c;
		border-radius: 3rpx;
	}
	/* 语音卡标题（设计稿: y=340.6 #3a2e25 约16px） */
	.voice-title {
		display: flex;
		margin: 21rpx 0 0 17rpx;
		font-size: 32rpx;
		line-height: 40rpx;
		color: #3a2e25;
		font-weight: 600;
	}

	/* 引用区（设计稿: 28,412,334x64 rx=12，#c4913c 10%） */
	.quote-zone {
		width: 668rpx;
		height: 128rpx;
		background-color: rgba(196, 145, 60, 0.10);
		border-radius: 24rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 24rpx;
		box-sizing: border-box;
	}
	/* 引用竖线（设计稿: 40,424,3x40 #c4913c rx=1.5） */
	.quote-line {
		width: 6rpx;
		height: 80rpx;
		background-color: #c4913c;
		border-radius: 3rpx;
		margin-right: 21rpx;
	}
	.quote-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	/* 引言体（设计稿: y=426 #5a4c40 约15px 两行） */
	.quote-text {
		font-size: 28rpx;
		line-height: 40rpx;
		color: #5a4c40;
		font-style: italic;
	}

	/* 卡底元信息（设计稿: #8a7a6a 约10px） */
	.result-meta {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-left: 17rpx;
	}
	.voice-card-meta {
		margin-top: 7rpx;
	}
	.quote-card-meta {
		margin-top: 20rpx;
	}
	.result-meta-text {
		font-size: 20rpx;
		color: #8a7a6a;
	}

	/* 空状态 */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 100rpx 0;
	}
	.empty-icon {
		font-size: 72rpx;
		margin-bottom: 24rpx;
	}
	.empty-text {
		font-size: 26rpx;
		color: #8a7a6a;
	}


	/* 按压态动画 */
	.pressable {
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
</style>

<template>
	<!-- ardot 直转 v2：搜索页（帧 2:386）· 审计化生成 -->
	<view class="page-root">
		<text class="n2_390">搜索</text> <!-- 大标题 -->
		<view class="n2_391"> <!-- 搜索胶囊 -->
			<image class="n2_392" src="/static/icons/i2_392.svg" /> <!-- icon: 搜索图标 -->
			<view class="n2_395"> <!-- 输入区（HEAD 交互接回：静态"湖边|"→受控 input） -->
				<input class="n2_396" v-model="keyword" placeholder="输入关键词，搜索你的记忆" placeholder-style="color:#B3A696;font-size:28.8rpx" confirm-type="search" @confirm="doSearch" />
			</view>
		</view>
		<view class="n2_397"> <!-- 筛选行（HEAD 交互接回：4 静态 chip→filters v-for + active 态） -->
			<view v-for="(f, idx) in filters" :key="idx" class="chip" :class="{ 'chip-active': idx === activeFilter, 'chip-ml': idx > 0 }" @tap="setFilter(idx)">
				<text class="chip-text" :class="{ 'chip-text-active': idx === activeFilter }">{{ f }}</text>
			</view>
		</view>
		<text class="n2_406">{{ resultCountText() }}</text> <!-- 结果提示（动态） -->
		<!-- 结果区（HEAD 交互接回：静态语音/文字卡→v-for 列表；绝对定位改滚动流） -->
		<scroll-view class="n2-results" :show-scrollbar="false">
			<view v-for="(item, idx) in voiceResults" :key="'v' + item.id" class="n2_588" @tap="openResult(item)">
				<view class="n2_589"> <!-- 语音媒体 -->
					<view class="n2_591" @tap.stop="playVoice(item)"> <!-- 玻璃播放钮 -->
						<!-- W0-2 播放态：播放 SVG ↔ 暂停双竖条（tick 局部更新：读卡字段，非全局函数） -->
						<view v-if="item.active && item.playing" class="search-pause-icon">
							<view class="search-pause-bar"></view>
							<view class="search-pause-bar"></view>
						</view>
						<image v-else class="n2_595" src="/static/icons/i2_595.svg" /> <!-- icon: 播放图标 -->
					</view>
					<!-- 波形：空闲=画布 SVG（对拍保真）；活动=VoiceWave 已播金/未播米 + 进度行（F5a 规范） -->
					<VoiceWave v-if="item.active" class="n2_592" :heights="item.waveHeights" :active="true" :progress="item.progress" />
					<view v-else class="n2_592">
						<image class="n2_596" src="/static/icons/i2_596.svg" />
					</view>
				</view>
				<view v-if="item.active" class="voice-progress-row">
					<text class="voice-progress-time">{{ item.curText }}</text>
					<view class="voice-track">
						<view class="voice-track-fill" :style="{ width: (item.progress * 100) + '%' }"></view>
					</view>
					<text class="voice-progress-time">{{ item.totalText }}</text>
				</view>
				<view class="n2_590"> <!-- 语音文字区 -->
					<text class="n2_593">{{ item.title }}</text>
					<text class="n2_594">{{ item.meta }}</text>
				</view>
			</view>
			<view v-for="(item, idx) in textResults" :key="'t' + item.id" class="n2_598" @tap="openResult(item)">
				<!-- 照片命中：服务端票据 URL 直连回显（<image> 无法带 header，预签名/票据 URL 是唯一通路） -->
				<image v-if="item.thumb != ''" class="n2-result-photo" :src="item.thumb" mode="aspectFill" />
				<view class="n2_599"> <!-- 摘要块 -->
					<view class="n2_601"></view> <!-- 引用竖线 -->
					<text class="n2_602">{{ item.text }}</text>
				</view>
				<view class="n2_600"> <!-- 文字元信息区 -->
					<text class="n2_603">{{ item.meta }}</text>
				</view>
			</view>
			<view v-if="hasSearched && voiceResults.length === 0 && textResults.length === 0" class="n2-empty">
				<text class="n2-empty-text">{{ emptyText() }}</text>
			</view>
		</scroll-view>
		<TabBar active="search" @plus="sheetOpen = true" />

		<!-- 记录面板浮层：点 TabBar 中央 + 就地拉起，不跳页（产品定义铁律） -->
		<RecordSheet v-if="sheetOpen" @close="sheetOpen = false" @saved="onRecordSaved" />
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, watch } from 'vue'
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { searchText, fetchRecentContents, SearchHitItem, contentTypeCn } from '@/utils/search_api'
	import { shortDate } from '@/utils/time'
	import {
		toggleVoice,
		stopVoice,
		fmtVoiceTime,
		genWaveHeights,
		voiceCurrentId,
		voicePlaying,
		voiceProgress,
		voiceCurSec,
		voiceTotalSec
	} from '@/utils/audio_player'

	// ── 响应式状态 ──
	// 记录面板浮层开关（TabBar 中央 + 触发，就地拉起不跳页）
	let sheetOpen = ref(false)
	let keyword = ref('')
	let activeFilter = ref(0)
	let loading = ref(false)
	let hasSearched = ref(false)
	let degraded = ref(false)
	let hits = ref<Array<SearchHitItem>>([])
	let filters = ['全部', '照片', '语音', '文字']

	// 返回键拦截：浮层开着时先关浮层，而不是退出页面（返回 true = 已自行处理）
	onBackPress((): boolean => {
		if (sheetOpen.value) {
			sheetOpen.value = false
			return true
		}
		return false
	})

	// 离页停播：防止语音跨页残留出声（redirectTo 切 Tab 会销毁本页）
	onUnload(() => {
		stopVoice()
	})

	// 本地 mock 数据注入路径已于 2026-08-31 移除（峰宝拍板：这是 MVP，不是 demo）：
	// 此前 onLoad 无条件灌 6 条假数据（v-mock-*/t-mock-*/p-mock-*）压住真实结果；
	// 现进入页面即拉「最近内容」兜底（见 onLoad），空结果走诚实空态文案。

	// 从「我的」类型卡跳入：?type=photo/voice/text 预设对应筛选标签
	onLoad((options: OnLoadOptions) => {
		const t = options['type'] as string
		if (t == 'photo') {
			activeFilter.value = 1
		} else if (t == 'voice') {
			activeFilter.value = 2
		} else if (t == 'text') {
			activeFilter.value = 3
		}
		// 进入即拉「最近内容」兜底（后端 /search 的 q 要求非空，
		// 空词场景只能用 contents 列表端点），否则结果区一片空白。
		loadRecent()
	})

	// ── 卡片视图模型（兼容模板：语音卡 / 文字卡） ──
	class VoiceResult {
		id: string
		title: string
		meta: string
		waveHeights: Array<number>
		// 播放态快照（tick 局部更新）：syncActiveCard 只写「正在播放那张卡」的这些属性，
		// 其余卡零写入零重渲染；默认值在 constructor 内赋（UTS 无字段默认初始化）
		active: boolean
		playing: boolean
		progress: number
		curText: string
		totalText: string
		constructor(id: string, title: string, meta: string, waveHeights: Array<number>) {
			this.id = id
			this.title = title
			this.meta = meta
			this.waveHeights = waveHeights
			this.active = false
			this.playing = false
			this.progress = 0
			this.curText = ''
			this.totalText = ''
		}
	}

	class TextResult {
		id: string
		text: string
		meta: string
		/** 照片缩略图票据 URL（仅 content_type=photo 有值；文字/语音为空串） */
		thumb: string
		constructor(id: string, text: string, meta: string, thumb: string) {
			this.id = id
			this.text = text
			this.meta = meta
			this.thumb = thumb
		}
	}

	/** 由 contentId 确定性生成装饰波形 → 统一走 audio_player.genWaveHeights（W0-2 三处一致） */
	function genWave(id: string): Array<number> {
		return genWaveHeights(id, 28)
	}

	/** 组装卡底元信息：类型 · 日期 · 所属事件 */
	function hitMeta(h: SearchHitItem): string {
		let s = contentTypeCn(h.contentType)
		if (h.takenAt != '') {
			s += ' · ' + shortDate(h.takenAt)
		}
		if (h.eventTitle != '') {
			s += ' · ' + h.eventTitle
		}
		return s
	}

	// 筛选标签 → 后端 content_types（全部=不过滤）
	function filterContentTypes(): Array<string> {
		if (activeFilter.value === 1) {
			return ['photo']
		}
		if (activeFilter.value === 2) {
			return ['voice']
		}
		if (activeFilter.value === 3) {
			return ['text']
		}
		return []
	}

	// 本地筛选（与 filterContentTypes() 同源，两处阈值必须一致）
	// D7 零冗余请求：切筛选不再重发搜索请求（setFilter 只改 activeFilter），
	// 结果全部在这里本地过滤；filterContentTypes() 仅在首搜路径（runSearch/loadRecent）
	// 作为 content_types 参数传服务端。诚实语义：首搜已按类型服务端过滤时，
	// 池子里没有其他类型 → 切过去显示「暂无xx结果」空态，不回退补发请求。
	function matchesFilter(ct: string): boolean {
		if (activeFilter.value === 1) {
			return ct == 'photo'
		}
		if (activeFilter.value === 2) {
			return ct == 'voice'
		}
		if (activeFilter.value === 3) {
			return ct == 'text'
		}
		return true
	}

	// 语音结果（content_type=voice → 语音卡）。
	// 性能重构：computed → ref + 手动重建。33ms 播放 tick 不再走整列表重算，
	// 只由 syncActiveCard 写单卡属性（见下）；列表仅在 hits / 筛选变化时重建。
	let voiceResults = ref<Array<VoiceResult>>([])

	/**
	 * 播放 tick 局部更新：把全局播放态写进「正在播放那张卡」的属性。
	 * 带相等性守卫——值没变不写 → 不触发响应式 → 其余卡零重渲染；
	 * 状态迁移（切换/暂停/停止/播完）由 voiceCurrentId 清旧卡 active。
	 */
	function syncActiveCard(): void {
		const cid = voiceCurrentId.value
		const playing = voicePlaying.value
		const prog = voiceProgress.value
		const cur = fmtVoiceTime(voiceCurSec.value)
		const total = fmtVoiceTime(voiceTotalSec.value)
		for (let i = 0; i < voiceResults.value.length; i++) {
			const c = voiceResults.value[i]
			if (c.id == cid) {
				if (c.active == false) {
					c.active = true
				}
				if (c.playing != playing) {
					c.playing = playing
				}
				if (c.progress != prog) {
					c.progress = prog
				}
				if (c.curText != cur) {
					c.curText = cur
				}
				if (c.totalText != total) {
					c.totalText = total
				}
			} else if (c.active) {
				c.active = false
				c.playing = false
				c.progress = 0
			}
		}
	}

	/** 重建语音卡列表（hits / 筛选变化时触发；tick 不走这里） */
	function rebuildVoice(): void {
		const out: Array<VoiceResult> = []
		for (let i = 0; i < hits.value.length; i++) {
			const h = hits.value[i]
			if (h.contentType == 'voice' && matchesFilter(h.contentType)) {
				const title = h.eventTitle != '' ? h.eventTitle : '语音记忆'
				out.push(new VoiceResult(h.contentId, title, hitMeta(h), genWave(h.contentId)))
			}
		}
		voiceResults.value = out
		syncActiveCard()
	}

	// 播放态源 ref（audio_player 全局单例）→ 单源 watch 逐个挂，tick 驱动面收敛到 syncActiveCard
	watch(hits, (): void => { rebuildVoice() })
	watch(activeFilter, (): void => { rebuildVoice() })
	watch(voiceCurrentId, (): void => { syncActiveCard() })
	watch(voicePlaying, (): void => { syncActiveCard() })
	watch(voiceProgress, (): void => { syncActiveCard() })
	watch(voiceCurSec, (): void => { syncActiveCard() })
	watch(voiceTotalSec, (): void => { syncActiveCard() })

	// 文字 / 照片结果（photo 的 caption 与 text 同走引用文字卡）
	let textResults = computed((): Array<TextResult> => {
		const out: Array<TextResult> = []
		for (let i = 0; i < hits.value.length; i++) {
			const h = hits.value[i]
			if (h.contentType == 'voice') {
				continue
			}
			if (!matchesFilter(h.contentType)) {
				continue
			}
			const txt = h.text != '' ? h.text : '（无文本描述）'
			// 照片命中带服务端下发的缩略图票据 URL，其余类型为空串
			out.push(new TextResult(h.contentId, txt, hitMeta(h), h.contentType == 'photo' ? h.thumbnailUrl : ''))
		}
		return out
	})

	function resultCountText(): string {
		if (loading.value) {
			return '搜索中…'
		}
		let n = voiceResults.value.length + textResults.value.length
		return hasSearched.value ? ('共 ' + n.toString() + ' 条结果') : '输入关键词，搜索你的记忆'
	}

	function emptyText(): string {
		if (!hasSearched.value) {
			return '输入关键词开始搜索'
		}
		if (activeFilter.value === 1) {
			return '暂无照片结果'
		}
		if (activeFilter.value === 2) {
			return '暂无语音结果'
		}
		if (activeFilter.value === 3) {
			return '暂无文字结果'
		}
		return '没有找到相关记忆，换个关键词试试'
	}

	function setFilter(idx: number): void {
		// D7 零冗余请求：切筛选纯本地过滤（matchesFilter 链响应 activeFilter），
		// 不再重发搜索请求；首搜时 filterContentTypes() 才传参服务端。
		activeFilter.value = idx
	}

	function clearKeyword(): void {
		keyword.value = ''
		hits.value = []
		hasSearched.value = false
	}

	/** 发起描述性搜索（resolve-only，失败由封装 toast） */
	function runSearch(): void {
		const q = keyword.value.trim()
		if (q == '') {
			uni.showToast({ title: '请输入搜索关键词', icon: 'none' })
			return
		}
		loading.value = true
		searchText(q, 30, filterContentTypes()).then((out) => {
			loading.value = false
			hasSearched.value = true
			if (out == null) {
				hits.value = []
				return
			}
			hits.value = out.hits
			degraded.value = out.degraded
		})
	}

	function doSearch(): void {
		runSearch()
	}

	/**
	 * 进入页面的默认数据源：GET /contents 拉最近内容。
	 * 后端 /search 的 q 要求非空（SearchRequest min_length=1），空词语义搜索发不出去，
	 * 所以「刚进页面还什么都没搜」时用最近内容兜底，结果区不再空白。
	 * score 恒为 0（按时间序非相关度）、无事件归属——搜索行为本身仍走 runSearch()。
	 */
	// RecordSheet 保存成功回调：刷新最近内容兜底列表
	function onRecordSaved(): void {
		loadRecent()
	}

	function loadRecent(): void {
		loading.value = true
		fetchRecentContents(30, filterContentTypes()).then((out) => {
			loading.value = false
			if (out == null || out.hits.length == 0) {
				return // 保持空态文案，不打 hasSearched（避免误显「共 0 条结果」）
			}
			hits.value = out.hits
		})
	}

	function openResult(item: any): void {
		const id = (item as VoiceResult).id
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + id })
	}

	// W0-2 就地播放：真音频流（downloadFile 带 header → InnerAudioContext），
	// 播放态视觉与 index/detail 统一（F5a 规范：钮变暂停 + 已播金/未播米 + 进度行）。
	// tick 局部更新后，播放态进卡由 syncActiveCard 负责（watch audio_player refs 驱动），
	// 原模板包装函数 voiceIsActive/voiceIsPlaying/voiceProgressOfCard/voiceCurSecText/voiceTotalSecText 已删。
	function playVoice(item: VoiceResult): void {
		toggleVoice(item.id)
	}

	// （转换器遗留 setFilterAll/Photo/Voice/Text 字符串调用与 setFilter(idx:number) 签名冲突，
	//   模板已改回 HEAD 的 v-for + setFilter(idx)，此处删除）
	</script>

<style>
	.page-root {
		flex: 1;
		font-family: "Sarasa Gothic SC", sans-serif;
		background-color: #F8F7F4;
	}
	.n2_390 {
		position: absolute;
		left: 38.5rpx;
		top: 107.7rpx;
		width: 153.8rpx;
		height: 92.3rpx;
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: bold;
		font-size: 76.9rpx;
		color: #3A2E25;
	}
	.n2_391 {
		position: absolute;
		left: 38.5rpx;
		top: 230.8rpx;
		width: 673.1rpx;
		height: 92.3rpx;
		flex-direction: row;
		/* ⚠️ 无垂直 padding：画布 2:391 paddingTop/Bottom 均为 null，
		   子元素靠 y 居中（搜索图标 y=15/h=18 → 上下各 15pt，容器 h=48pt）。
		   此前误补 padding-top/bottom=30.8rpx → 内容区只剩 92.3-30.8×2=30.7rpx，
		   装不下 34.6rpx 的搜索图标 → 被裁（全项目同类审计 2026-08-31 抓到）。
		   回归画布真值：删垂直 padding，由 align-items:center 居中。 */
		align-items: center;
		padding-left: 30.8rpx;
		padding-right: 30.8rpx;
		background-color: #FFFFFF;
		/* 画布 stroke 为居中描边；uvue 下 border-width 会内缩 content box 1px，
		   改用 box-shadow 外环 0 0 0 1.9rpx 等价还原（不内缩子元素） */
		box-shadow: 0rpx 0rpx 0rpx 1.9rpx rgba(176, 89, 59, 0.6), 0rpx 11.5rpx 34.6rpx rgba(59, 46, 38, 0.08);
		border-radius: 9999rpx;
		overflow: hidden;
	}
	.n2_392 {
		width: 34.6rpx;
		height: 34.6rpx;
	}
	.n2_395 {
		flex: 1;
		margin-left: 15.4rpx; /* 画布 2:391 gap=8pt：图标右缘 34 → 输入区 x42 */
		flex-direction: row;
		align-items: center;
		overflow: hidden;
	}
	.n2_396 {
		width: 100%;
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 28.8rpx;
		color: #3A2E25;
	}
	.n2_397 {
		position: absolute;
		left: 38.5rpx;
		top: 353.8rpx;
		width: 673.1rpx;
		flex-direction: row;
		align-items: center;
		overflow: hidden;
	}
	/* chip 动态化（HEAD 交互接回）：默认白底灰字，active 态锈红 tint */
	.chip {
		flex-direction: row;
		align-items: center;
		padding-left: 17.3rpx;
		padding-right: 17.3rpx;
		padding-top: 17.3rpx;
		padding-bottom: 17.3rpx;
		background-color: #FFFFFF;
		border-radius: 9999rpx;
		overflow: hidden;
	}
	.chip-active {
		background-color: rgba(176, 89, 59, 0.12);
	}
	/* 画布 2:397 gap=8pt（chip 间距）；uvue 丢弃 gap → 非首 chip 加 margin-left */
	.chip-ml {
		margin-left: 15.4rpx;
	}
	.chip-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 23.1rpx;
		color: #8A7A6A;
	}
	.chip-text-active {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 23.1rpx;
		font-weight: 600;
		color: #B05A3A;
	}
	.n2_406 {
		position: absolute;
		left: 38.5rpx;
		top: 450rpx;
		width: 305.8rpx;
		height: 28.8rpx;
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 23.1rpx;
		color: #8A7A6A;
	}
	.n2-results {
		position: absolute;
		left: 38.5rpx;
		top: 496.2rpx;
		bottom: 169.2rpx; /* TabBar 高度避让 */
		width: 673.1rpx;
		background-color: #F8F7F4;
	}
	.n2_588 {
		width: 673.1rpx;
		flex-direction: column;
		margin-bottom: 23.1rpx;
		padding-left: 15.4rpx;
		padding-right: 15.4rpx;
		padding-top: 15.4rpx;
		padding-bottom: 15.4rpx;
		background-color: #FFFFFF;
		box-shadow: 0rpx 7.7rpx 30.8rpx rgba(59, 46, 38, 0.06), 0rpx 1.9rpx 5.8rpx rgba(59, 46, 38, 0.04);
		border-radius: 38.5rpx;
		overflow: hidden;
	}

		padding: 100rpx 0;
	}
	.empty-icon {
		font-size: 72rpx;
		margin-bottom: 24rpx;
	}
	.empty-text {
		font-size: 26rpx;
		color: #8a7a6a;
	}

	/* ===== 玻璃 TabBar（设计稿: 350x62 rx=31 #f6f1e7bf，与全库一致） ===== */
	.glass-tabbar {
		position: fixed;
		bottom: 60rpx;
		left: 40rpx;
		right: 40rpx;
		height: 124rpx;
		background-color: rgba(246, 241, 231, 0.75);
		border-radius: 62rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-around;
		box-shadow: 0 8rpx 32rpx rgba(58, 46, 37, 0.12);
		padding: 0 24rpx;
		overflow: visible;
	}
	.tabbar-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 80rpx;
		height: 80rpx;
	}
	.tabbar-icon {
		width: 40rpx;
		height: 40rpx;
		margin-bottom: 4rpx;
	}
	.tabbar-label {
		font-size: 20rpx;
		color: #8a7a6a;
	}
	.tabbar-label-active {
		color: #3a2e25;
		font-weight: 600;

<script setup lang="uts">
	// 菜单行：用户协议 → 用户协议内容页（卡E04，文案草稿待峰宝审定稿）
	function onAgreement(): void {
		uni.navigateTo({ url: '/pages/about/agreement' })
	}

	// 菜单行：隐私政策 → F3a 隐私政策页
	function goPrivacy(): void {
		uni.navigateTo({ url: '/pages/privacy/privacy' })
	}

	// 菜单行：检查更新（无更新服务，画布真值「已是最新」）
	function onCheckUpdate(): void {
		uni.showToast({ title: '已是最新版本', icon: 'none' })
	}

	// 菜单行：开源许可（无清单页，诚实占位）
	function onLicense(): void {
		uni.showToast({ title: '开源许可清单即将上线', icon: 'none' })
	}

	function goBack(): void {
		// 铁律：reLaunch/redirectTo 直入时页面栈仅 1 页，navigateBack 静默失败 → 回落首页（settings.uvue 先例）
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/index/index' })
		}
	}
</script>


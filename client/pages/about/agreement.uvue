	}
	/* ── 内容卡（privacy.uvue 原值；本页无 chips 行，滚动区上移 300→192.3rpx，取 about 页品牌区起点同值） ── */
	.body-scroll {
		flex: 1;
		margin-top: 192.3rpx;
		padding-left: 38.5rpx;
		padding-right: 38.5rpx;
		padding-bottom: 60rpx;
	}
	.card {
		width: 100%;
		flex-direction: column;
		padding-left: 38.5rpx;
		padding-right: 38.5rpx;
		padding-top: 38.5rpx;
		padding-bottom: 38.5rpx;
		background-color: #FFFFFF;
		border-radius: 30.8rpx;
	}
	.sec-title {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 600;

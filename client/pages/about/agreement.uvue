	}
	.blk-h {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 600;
		font-size: 25rpx;
		color: #3A2E25;
		margin-top: 26.9rpx;
	}
	.blk-p {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 25rpx;
		line-height: 40.4rpx;
		color: #6B5D4F;
		margin-top: 26.9rpx;
	}
	.blk-b {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 600;
		font-size: 25rpx;
		line-height: 40.4rpx;
		color: #3A2E25;

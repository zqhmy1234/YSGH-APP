<template>
	<view class="page">
		<!-- 顶部：返回 + 标题（sub-page，navigationStyle=custom） -->
		<view class="header">
			<view class="nav-row">
				<view class="back-btn" @tap="goBack">
					<text class="back-arrow">‹</text>
					<text class="back-text">我的</text>
				</view>
				<text class="header-title serif">设置</text>
			</view>
			<text class="header-sub">偏好、数据与账号</text>
		</view>

		<!-- ═══════════ 数据与隐私 ═══════════ -->
		<text class="group-title">数据与隐私</text>

		<!-- ① 跨端可见开关（W0 拍板⑥ D6：仅客户端本地 uni storage，不做后端） -->
		<view class="card">
			<view class="row">
				<view class="row-main">
					<text class="row-title">跨端可见</text>
					<text class="row-desc">{{ crossVisible ? '允许本机记忆在设备间同步可见' : '仅本机可见（关闭跨端同步）' }}</text>
				</view>
				<view class="switch-track" :class="crossVisible ? 'switch-on' : ''" @tap="toggleCrossVisible">
					<view class="switch-thumb" :class="crossVisible ? 'thumb-on' : ''"></view>
				</view>
			</view>
		</view>

		<!-- ② 隐私政策入口（内置可滚动文本；内容源=C3 定稿版，MVP 先用占位 + 链接注释） -->
		<view class="card">
			<view class="row" @tap="privacyOpen = true">
				<view class="row-main">
					<text class="row-title">隐私政策</text>
					<text class="row-desc">了解数据如何被收集与保护</text>
				</view>
				<text class="row-arrow">›</text>
			</view>
		</view>

		<!-- ③ 数据导出（US-42，C2：GET /api/v1/export 全量 JSON 元数据） -->
		<view class="card">
			<view class="row" @tap="exportData">
				<view class="row-main">
					<text class="row-title">导出我的数据</text>
					<text class="row-desc">{{ exporting ? '导出中，请稍候…' : exportHint }}</text>
				</view>
				<view class="export-btn" :class="exporting ? 'exporting' : ''">
					<text class="export-btn-text">{{ exporting ? '导出中…' : '导出' }}</text>
				</view>
			</view>
			<text v-if="exportPath != ''" class="export-path">已保存：{{ exportPath }}</text>
		</view>

		<!-- ═══════════ 我的记忆 ═══════════ -->
		<text class="group-title">我的记忆</text>

		<!-- ④ 画像管理入口（A1 单写 pages/portrait/manage.uvue，契约 C4） -->
		<view class="card">
			<view class="row" @tap="goProfileManage">
				<view class="row-main">
					<text class="row-title">画像管理</text>
					<text class="row-desc">查看与维护记忆画像（含敏感项）</text>
				</view>
				<text class="row-arrow">›</text>
			</view>
		</view>

		<!-- ═══════════ 账号 ═══════════ -->
		<text class="group-title">账号</text>

		<!-- ⑤ 账号管理：当前登录态 + 退出登录（复用 auth.ts logout） -->
		<view class="card">
			<view class="row">
				<view class="row-main">
					<text class="row-title">登录状态</text>
					<text class="row-desc">{{ loggedIn ? '已登录 · ' + deviceId : '未登录（将自动重新登录）' }}</text>
				</view>
				<text class="login-dot" :class="loggedIn ? 'dot-on' : 'dot-off'">{{ loggedIn ? '在线' : '离线' }}</text>
			</view>
		</view>
		<view v-if="loggedIn" class="logout-btn" @tap="confirmLogout">
			<text class="logout-text">退出登录</text>
		</view>

		<!-- 隐私政策弹层（底部抽屉，可滚动） -->
		<view v-if="privacyOpen" class="privacy-mask" @tap="privacyOpen = false">
			<view class="privacy-sheet" @tap.stop>
				<text class="privacy-title serif">隐私政策</text>
				<scroll-view class="privacy-scroll" scroll-y="true">
					<text class="privacy-text">{{ privacyText }}</text>
				</scroll-view>
				<view class="privacy-close" @tap="privacyOpen = false">
					<text class="privacy-close-text">我知道了</text>
				</view>
			</view>
		</view>
		<!-- 玻璃 TabBar（半透明白 55% + 中央＋按钮） -->
<view class="glass-tabbar">
			<view class="tabbar-item  pressable" @tap="goIndex">
				<text class="tabbar-icon">🏠</text>
				<text class="tabbar-label">时间轴</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goSearch">
				<text class="tabbar-icon">🔍</text>
				<text class="tabbar-label">搜索</text>
			</view>
			<view class="tabbar-fab pressable" @tap="goRecord">
				<text class="tabbar-fab-icon">+</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goMessages">
				<text class="tabbar-icon">💬</text>
				<text class="tabbar-label">消息</text>
			</view>
			<view class="tabbar-item active pressable" @tap="goProfile">
				<text class="tabbar-icon">👤</text>
				<text class="tabbar-label">我的</text>
			</view>
		</view>
</view>

</template>

<script setup lang="uts">
	import { onLoad } from '@dcloudio/uni-app'
	import { ensureLogin, logout, getToken, DEVICE_ID } from '@/utils/auth'
	import { get, dataObj, showErrorToast } from '@/utils/api'
	import { PATH_PROFILE_MANAGE, PATH_EXPORT, FIELD_EXPORTED_AT } from '@/utils/contract'
	import { dayKey } from '@/utils/time'

	// 常量
	const KEY_CROSS_VISIBLE: string = 'yishu_visible_across_devices'
	const PRIVACY_PLACEHOLDER: string =
		'（占位文本 · 待 C3 隐私政策定稿版替换，源：docs/隐私政策_定稿_20260828.md）\n\n' +
		'忆述光华（以下简称"本应用"）重视你的个人信息与隐私安全。本政策概述我们如何收集、使用、存储与保护你的数据。\n\n' +
		'一、我们收集的信息\n' +
		'· 你主动记录的文字、语音与照片记忆；\n' +
		'· 记忆内容附带的拍摄时间、地点等元数据；\n' +
		'· 为提供"去年今日"回响所需的日期信息。\n\n' +
		'二、信息的使用\n' +
		'· 用于 AI 自动整理、分类、四层事件聚合与描述性搜索；\n' +
		'· 用于生成个人画像与个性化回响。\n\n' +
		'三、第三方与云服务知情\n' +
		'· 部分 AI 能力（语音识别、内容理解、安全审核）由第三方云服务提供，处理遵循其数据安全条款；\n' +
		'· 原图可能存储于云对象存储（如腾讯云 COS），通过安全通道传输。\n\n' +
		'四、本地存储与安全\n' +
		'· 端侧数据以加密数据库（SQLCipher）保存；\n' +
		'· 崩溃上报仅包含匿名技术信息，不含你的记忆内容。\n\n' +
		'五、数据保留与删除\n' +
		'· 软删除数据保留 30 天后物理清理；\n' +
		'· 你可在"设置-导出我的数据"随时导出全部记忆元数据；\n' +
		'· 你可通过账号管理申请注销账号并删除云端数据。\n\n' +
		'六、未成年人\n' +
		'· 本应用面向成年人；如你为未成年人，请在监护人指导下使用。\n\n' +
		'七、联系方式\n' +
		'· 如对隐私政策有任何疑问，可通过应用内反馈渠道联系我们。\n\n' +
		'（以上为占位概要，正式条款以 C3 定稿版为准）'

	// 响应式数据
	let crossVisible = true
	let loggedIn = false
	let deviceId = DEVICE_ID
	let exporting = false
	let exportHint = '导出全部记忆数据（JSON），用于个人备份'
	let exportPath = ''
	let exportSize = ''
	let privacyOpen = false
	let privacyText = PRIVACY_PLACEHOLDER

	// 生命周期
	onLoad(() => {
		const raw = uni.getStorageSync(KEY_CROSS_VISIBLE)
		crossVisible = raw === '' ? true : (raw as boolean)
		loggedIn = getToken() != ''
		ensureLogin().then((ok: boolean) => {
			loggedIn = ok
		})
	})

	// 导航方法
	function goIndex(): void {
		uni.reLaunch({ url: '/pages/index/index' })
	}
	function goSearch(): void {
		uni.reLaunch({ url: '/pages/search/search' })
	}
	function goRecord(): void {
		uni.reLaunch({ url: '/pages/record/record' })
	}
	function goMessages(): void {
		uni.reLaunch({ url: '/pages/messages/messages' })
	}
	function goProfile(): void {
		uni.reLaunch({ url: '/pages/profile/profile' })
	}
	function goBack(): void {
		uni.navigateBack({ delta: 1 })
	}
	function goProfileManage(): void {
		uni.navigateTo({ url: PATH_PROFILE_MANAGE })
	}

	// 业务方法
	function toggleCrossVisible(): void {
		crossVisible = !crossVisible
		uni.setStorageSync(KEY_CROSS_VISIBLE, crossVisible)
		uni.showToast({
			title: crossVisible ? '已开启跨端可见' : '已关闭跨端可见',
			icon: 'none',
			duration: 1500
		})
	}
	function confirmLogout(): void {
		uni.showModal({
			title: '退出登录',
			content: '退出后本机将清除登录凭据，云端数据保留。确定退出？',
			success: (res) => {
				if (res.confirm) {
					logout().then((ok: boolean) => {
						loggedIn = false
						uni.showToast({ title: '已退出登录', icon: 'success' })
					})
				}
			}
		})
	}
	function exportData(): void {
		if (exporting) {
			return
		}
		exporting = true
		exportPath = ''
		exportSize = ''
		doExport()
	}
	function doExport(): void {
		get(PATH_EXPORT).then((res: UTSJSONObject | null) => {
			if (res == null) {
				onExportFail('导出失败（网络或服务异常）')
				return
			}
			let payload: UTSJSONObject = res
			const code = res.getNumber('code')
			if (code != null) {
				const d = dataObj(res)
				if (d != null) {
					payload = d
				}
			}
			const exportedAt = payload.getString(FIELD_EXPORTED_AT)
			if (exportedAt == null || exportedAt == '') {
				console.log('[yishu] export payload missing exported_at, saving raw payload')
			}
			writeExportFile(payload.toJSONString())
		})
	}
	function writeExportFile(jsonStr: string): void {
		const fileName = 'yishu-export-' + dayKey(Date.now()) + '.json'
		const filePath = uni.env.USER_DATA_PATH + '/' + fileName
		const bytes = new TextEncoder().encode(jsonStr)
		const base64 = uni.arrayBufferToBase64(bytes.buffer!)
		console.log('[yishu] export writeFile path=' + filePath + ' len=' + jsonStr.length + ' b64len=' + base64.length)
		uni.getFileSystemManager().writeFile({
			filePath: filePath,
			data: base64,
			encoding: 'base64',
			success: () => {
				onExportSaved(filePath)
			},
			fail: (err) => {
				console.log('[yishu] export writeFile FAIL err=' + JSON.stringify(err))
				onExportFail('文件保存失败')
			}
		})
	}
	function onExportSaved(savedPath: string): void {
		exportPath = savedPath
		uni.getFileSystemManager().getFileInfo({
			filePath: savedPath,
			success: (info) => {
				const size = info.size
				exportSize = formatBytes(size)
				finishExport(true)
			},
			fail: () => {
				finishExport(true)
			}
		})
	}
	function finishExport(ok: boolean): void {
		exporting = false
		if (ok) {
			exportHint = '导出成功 · ' + (exportSize != '' ? exportSize : '已保存')
			uni.showToast({ title: '已导出', icon: 'success' })
		}
	}
	function onExportFail(msg: string): void {
		exporting = false
		exportHint = '导出失败，点击重试'
		showErrorToast(new Error(msg))
	}

	// 工具函数
	function formatBytes(bytes: number): string {
		if (bytes >= 1048576) {
			return (bytes / 1048576).toFixed(1) + ' MB'
		}
		return (bytes / 1024).toFixed(1) + ' KB'
	}
</script>

<style>

<template>
	<view class="page">
		<!-- 顶部导航：返回箭头 + 居中标题（设计稿: 返回 y=63.6 x=22.3，标题居中 34.4x16.5） -->
		<view class="nav-row">
			<view class="back-btn pressable" @tap="goBack">
				<text class="back-arrow">‹</text>
			</view>
			<text class="title serif">设置</text>
		</view>

		<!-- ═══════════ 卡片 1（设计稿: y=110 350x108 rx=20，两行）═══════════ -->
		<view class="card card-tall">
			<!-- 行 1：账号与安全（锁图标 + 右侧箭头） -->
			<view class="row pressable" @tap="goAccount">
				<view class="row-icon">
					<text class="row-emoji">🔒</text>
				</view>
				<text class="row-title">账号与安全</text>
				<text class="row-chevron">›</text>
			</view>

			<!-- 行 2：通知偏好（铃铛图标 + 自定义开关，激活态锈红） -->
			<view class="row">
				<view class="row-icon">
					<text class="row-emoji">🔔</text>
				</view>
				<text class="row-title">通知偏好</text>
				<view class="switch-track" :class="notifyOn ? 'switch-on' : ''" @tap="toggleNotify">
					<view class="switch-thumb" :class="notifyOn ? 'thumb-on' : ''"></view>
				</view>
			</view>
		</view>

		<!-- ═══════════ 卡片 2（设计稿: y=230 350x100 rx=20，两行）═══════════ -->
		<view class="card card-short">
			<!-- 行 1：深色模式（月亮图标 + 右侧状态文字） -->
			<view class="row pressable" @tap="cycleTheme">
				<view class="row-icon">
					<text class="row-emoji">🌙</text>
				</view>
				<text class="row-title">深色模式</text>
				<text class="row-value">{{ themeText }}</text>
			</view>

			<!-- 行 2：清理缓存（垃圾桶图标 + 右侧缓存大小） -->
			<view class="row pressable" @tap="clearCache">
				<view class="row-icon">
					<text class="row-emoji">🗑️</text>
				</view>
				<text class="row-title">清理缓存</text>
				<text class="row-value">{{ cacheText }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'

	// ── 响应式状态 ──
	let notifyOn = ref(true) // 通知偏好开关（设计稿为激活态锈红）
	let themeIndex = ref(0) // 0=跟随系统 1=浅色 2=深色
	let cacheCleared = ref(false)
	let themeOptions: Array<string> = ['跟随系统', '浅色', '深色']

	const themeText = computed((): string => themeOptions[themeIndex.value])
	const cacheText = computed((): string => cacheCleared.value ? '0 B' : '236 MB')

	// ── 交互 ──
	function goBack(): void {
		uni.navigateBack({ delta: 1 })
	}

	function goAccount(): void {
		uni.showToast({ title: '账号与安全开发中', icon: 'none' })
	}

	function toggleNotify(): void {
		notifyOn.value = !notifyOn.value
		uni.showToast({
			title: notifyOn.value ? '已开启通知' : '已关闭通知',
			icon: 'none',
			duration: 1500
		})
	}

	function cycleTheme(): void {
		themeIndex.value = (themeIndex.value + 1) % 3
	}

	function clearCache(): void {
		uni.showModal({
			title: '清理缓存',
			content: cacheCleared.value ? '缓存已清空' : '将清理 236 MB 缓存，确定？',
			showCancel: !cacheCleared.value,
			success: (res) => {
				if (res.confirm) {
					cacheCleared.value = true
					uni.showToast({ title: '已清理缓存', icon: 'success' })
				}
			}
		})
	}
</script>

<style>
	/* 视觉规范：像素级还原 SVG 设计稿（390x844 画布）
	   背景 #f8f7f4 / 卡片 #ffffff rx=20 / 图标琥珀 #C4913C / 开关激活态锈红 #B05A3A */
	.page {
		width: 100%;
		height: 100%;
		background-color: #f8f7f4;
		display: flex;
		flex-direction: column;
		padding: 0 40rpx;
	}
	.serif {
		font-family: "Noto Serif CJK SC", serif;
	}

	/* 顶部导航（返回箭头 + 居中标题）
	   设计稿：返回箭头 y=63.6 / 标题居中 y=63，二者同基线 */
	.nav-row {
		position: relative;
		height: 64rpx;
		display: flex;
		align-items: center;
		padding-top: 94rpx;
		margin-bottom: 62rpx;
	}
	.back-btn {
		position: absolute;
		left: 0;
		top: 94rpx;
		width: 80rpx;
		height: 64rpx;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		z-index: 2;
	}
	.back-arrow {
		font-size: 48rpx;
		line-height: 64rpx;
		color: #3a2e25;
		font-weight: 300;
	}
	.title {
		flex: 1;
		text-align: center;
		font-size: 34rpx;
		color: #3a2e25;
		font-weight: bold;
	}

	/* 分组卡片 */
	.card {
		width: 700rpx;
		background-color: #ffffff;
		border-radius: 40rpx;
		display: flex;
		flex-direction: column;
		margin-bottom: 24rpx;
		box-shadow: 0 4rpx 16rpx rgba(58, 46, 37, 0.06);
	}
	.card-tall {
		height: 216rpx;
		padding: 10rpx 36rpx 20rpx 36rpx;
	}
	.card-short {
		height: 200rpx;
		padding: 8rpx 36rpx 0 36rpx;
	}

	/* 设置行 */
	.row {
		flex: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.row-icon {
		width: 48rpx;
		height: 56rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 20rpx;
	}
	.row-emoji {
		font-size: 32rpx;
		line-height: 40rpx;
	}
	.row-title {
		flex: 1;
		font-size: 28rpx;
		color: #3a2e25;
		font-weight: 500;
	}
	.row-value {
		font-size: 22rpx;
		color: #b3a696;
	}
	.row-chevron {
		font-size: 34rpx;
		line-height: 40rpx;
		color: #b3a696;
		font-weight: 300;
	}

	/* 自定义开关（设计稿: 46x28 rx=14，激活态 #B05A3A，白色滑块） */
	.switch-track {
		width: 92rpx;
		height: 56rpx;
		border-radius: 28rpx;
		background-color: #EBE3D4;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 6rpx;
	}
	.switch-on {
		background-color: #b05a3a;
		justify-content: flex-end;
	}
	.switch-thumb {
		width: 44rpx;
		height: 44rpx;
		border-radius: 22rpx;
		background-color: #ffffff;
		box-shadow: 0 2rpx 8rpx rgba(58, 46, 37, 0.3);
	}
	.thumb-on {
		background-color: #ffffff;
	}

	/* 按压态动画 */
	.pressable {
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
</style>

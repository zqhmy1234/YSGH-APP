<template>
	<!-- ardot 直转 v2：设置页（帧 4:131）· 审计化生成 -->
	<view class="page-root">
		<!-- 铁律 11.5：同层 absolute 兄弟按 DOM 顺序绘制，返回图标必须排在标题容器**之后**，
		     否则被全宽 750rpx 的 .n4_137 盖住 → @tap 收不到事件（真机 2026-08-31：返回键完全点不动） -->
		<view class="n4_137"> <!-- 标题容器 -->
			<text class="n4_138">设置</text> <!-- 页标题 -->
		</view>
		<image class="n4_135" src="/static/icons/i4_135.svg" @tap="goBack" /> <!-- icon: 返回 -->
		<view class="list-flow"> <!-- 列表流式容器（组间 margin 自动下移） -->
			<view class="n4_139"> <!-- 组1 -->
			<view class="n4_140" @tap="goAccount"> <!-- 行-账号与安全 -->
				<image class="n4_141" src="/static/icons/i4_141.svg" /> <!-- icon: 图标 -->
				<text class="n4_144">账号与安全</text> <!-- 文字 -->
				<image class="n4_145" src="/static/icons/i4_145.svg" /> <!-- icon: 箭头 -->
			</view>
			<view class="n4_147" @tap="toggleNotify"> <!-- 行-通知偏好 -->
				<image class="n4_196" src="/static/icons/i4_196.svg" /> <!-- icon: 图标 -->
				<text class="n4_151">通知偏好</text> <!-- 文字 -->
				<view class="n4_152" :style="notifyOn ? 'justify-content: flex-end;' : 'justify-content: flex-start;'" @tap="toggleNotify"> <!-- 开关：滑块位置随状态 -->
					<view class="n4_153"> <!-- 滑块 -->
					</view>
				</view>
			</view>
		</view>
		<view class="n4_154"> <!-- 组2 -->
			<view class="n4_155" @tap="cycleTheme"> <!-- 行-深色模式 -->
				<image class="n4_156" src="/static/icons/i4_156.svg" /> <!-- icon: 图标 -->
				<text class="n4_158">深色模式</text> <!-- 文字 -->
				<text class="n4_159">{{ themeText }}</text> <!-- 值（修复：原静态"跟随系统"，computed 未绑 → 点了永远不变） -->
			</view>
			<view class="n4_160" @tap="clearCache"> <!-- 行-清理缓存 -->
				<image class="n4_161" src="/static/icons/i4_161.svg" /> <!-- icon: 图标 -->
				<text class="n4_163">清理缓存</text> <!-- 文字 -->
				<text class="n4_164">{{ cacheText }}</text> <!-- 值（修复：同上） -->
			</view>
		</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'

	// ── 响应式状态 ──
	let notifyOn = ref(true) // 通知偏好开关（设计稿为激活态锈红）
	let themeIndex = ref(0) // 0=跟随系统 1=浅色 2=深色
	let cacheCleared = ref(false)
	let themeOptions: Array<string> = ['跟随系统', '浅色', '深色']

	// 本地持久化（MVP：后端暂无偏好端点，uni storage 落地；接入后端后换端点同步）
	const KEY_NOTIFY = 'settings_notify_on'
	const KEY_THEME = 'settings_theme_index'
	const KEY_CACHE = 'settings_cache_cleared'
	onLoad(() => {
		notifyOn.value = uni.getStorageSync(KEY_NOTIFY) != '0'
		const t = uni.getStorageSync(KEY_THEME) as string
		if (t == '1' || t == '2') {
			themeIndex.value = parseInt(t)
		}
		cacheCleared.value = uni.getStorageSync(KEY_CACHE) == '1'
	})

	const themeText = computed((): string => themeOptions[themeIndex.value])
	const cacheText = computed((): string => cacheCleared.value ? '0 B' : '236 MB')

	// ── 交互 ──
	function goBack(): void {
		// 铁律：reLaunch/redirectTo 直入时页面栈仅 1 页，navigateBack 静默失败 → 回落首页
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/index/index' })
		}
	}

	function goAccount(): void {
		// W10：账号与安全页落地，toast 占位改真跳转（navigateTo 入栈，security 返回键可达）
		uni.navigateTo({ url: '/pages/account/security' })
	}

	function toggleNotify(): void {
		notifyOn.value = !notifyOn.value
		uni.setStorageSync(KEY_NOTIFY, notifyOn.value ? '1' : '0')
		uni.showToast({
			title: notifyOn.value ? '已开启通知' : '已关闭通知',
			icon: 'none',
			duration: 1500
		})
	}

	function cycleTheme(): void {
		themeIndex.value = (themeIndex.value + 1) % 3
		uni.setStorageSync(KEY_THEME, themeIndex.value.toString())
	}

	function clearCache(): void {
		uni.showModal({
			title: '清理缓存',
			content: cacheCleared.value ? '缓存已清空' : '将清理 236 MB 缓存，确定？',
			showCancel: !cacheCleared.value,
			success: (res) => {
				if (res.confirm) {
					cacheCleared.value = true
					uni.setStorageSync(KEY_CACHE, '1')
					uni.showToast({ title: '已清理缓存', icon: 'success' })
				}
			}
		})
	}
</script>

<style>
	.page-root {
		flex: 1;

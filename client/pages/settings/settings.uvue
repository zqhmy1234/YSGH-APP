		letter-spacing: 6rpx;
	}
	.header-sub {
		margin-top: 6rpx;
		font-size: 26rpx;
		color: #8a7a6a;
	}
	.group-title {
		margin-top: 8rpx;
		margin-bottom: 14rpx;
		font-size: 26rpx;
		color: #8a7a6a;
		font-weight: bold;
		letter-spacing: 2rpx;
	}

	/* 卡片行 */
	.card {
		background-color: #ffffff;
		border-radius: 40rpx;
		padding-left: 28rpx;
		padding-right: 28rpx;
		padding-top: 24rpx;
		padding-bottom: 24rpx;
		margin-bottom: 20rpx;
		box-shadow: 0 6rpx 16rpx rgba(58, 46, 37, 0.12);
	}
	.row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.row-main {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.row-title {
		font-size: 30rpx;
		color: #3a2e25;
		font-weight: bold;
	}
	.row-desc {
		margin-top: 8rpx;
		font-size: 24rpx;
		color: #8a7a6a;
		line-height: 32rpx;
	}
	.row-arrow {
		font-size: 40rpx;
		color: #b3a696;
		margin-left: 12rpx;
	}

	/* 自定义开关（同 record 分段控件风格，规避 UTS 事件类型风险） */
	.switch-track {
		width: 96rpx;
		height: 52rpx;
		border-radius: 26rpx;
		background-color: #EBE3D4;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 6rpx;
		padding-right: 6rpx;
	}
	.switch-on {
		background-color: #b05a3a;
		justify-content: flex-end;
	}
	.switch-thumb {
		width: 40rpx;
		height: 40rpx;
		border-radius: 20rpx;
		background-color: #ffffff;
		box-shadow: 0 2rpx 8rpx rgba(58, 46, 37, 0.3);
	}
	.thumb-on {
		background-color: #f8f7f4;
	}

	/* 导出 */
	.export-btn {
		margin-left: 12rpx;
		background-color: #b05a3a;
		border-radius: 8rpx;
		padding-left: 28rpx;
		padding-right: 28rpx;
		padding-top: 12rpx;
		padding-bottom: 12rpx;
	}
	.exporting {
		background-color: #b3a696;
	}
	.export-btn-text {
		color: #f8f7f4;
		font-size: 26rpx;
	}
	.export-path {
		margin-top: 14rpx;
		font-size: 22rpx;
		color: #b3a696;
	}

	/* 账号 */
	.login-dot {
		font-size: 22rpx;
		padding-left: 16rpx;
		padding-right: 16rpx;
		padding-top: 6rpx;
		padding-bottom: 6rpx;
		border-radius: 20rpx;
	}
	.dot-on {
		color: #2E7D32;
		background-color: #E4EFE3;
	}
	.dot-off {
		color: #b3a696;
		background-color: #EBE3D4;
	}
	.logout-btn {
		margin-top: 12rpx;
		margin-bottom: 24rpx;
		background-color: #ffffff;
		border-radius: 8rpx;
		padding-top: 20rpx;
		padding-bottom: 20rpx;
		align-items: center;
		display: flex;
		justify-content: center;
		box-shadow: 0 6rpx 16rpx rgba(58, 46, 37, 0.12);
	}
	.logout-text {
		color: #b05a3a;
		font-size: 30rpx;
		font-weight: bold;
	}

	/* 隐私政策底部抽屉 */
	.privacy-mask {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(58, 46, 37, 0.45);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}
	.privacy-sheet {
		background-color: #ffffff;
		border-top-left-radius: 20rpx;
		border-top-right-radius: 20rpx;
		padding-left: 40rpx;
		padding-right: 40rpx;
		padding-top: 32rpx;
		padding-bottom: 40rpx;
		display: flex;
		flex-direction: column;
		max-height: 1300rpx;
	}
	.privacy-title {
		font-size: 34rpx;
		color: #3a2e25;
		font-weight: bold;
		text-align: center;
		margin-bottom: 20rpx;
	}
	.privacy-scroll {
		flex: 1;
		max-height: 900rpx;
	}
	.privacy-text {
		font-size: 26rpx;
		color: #3a2e25;
		line-height: 42rpx;
	}
	.privacy-close {
		margin-top: 28rpx;
		background-color: #b05a3a;

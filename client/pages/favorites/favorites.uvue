<template>
	<!-- 卡16 F4a + 卡17 F4b · 我的收藏（列表态/空态同页双态）
	     真值：.wt/missing-pages/uvue_gen/favorites_canvas.json（60:766，51 节点）
	           .wt/missing-pages/uvue_gen/favorites_empty_canvas.json（60:841，33 节点）
	     SCALE=750/390=1.9231；坐标/颜色/字号/圆角/阴影全部取自 JSON 逐节点换算。
	     状态栏 9:41/电池（60:767/60:768）+ Home 指示条（60:775/60:848）=系统自绘不还原（全库先例）。
     FE1（W2-2）：列表走 GET /api/v1/favorites 真端点（play.uts favoritesList）、取消收藏走
     DELETE /api/v1/contents/{id}/favorite（play.uts favoriteRemove）；端点空/失败回落本地
     favorite_ids × timeline 契约；USE_MOCK_FAVORITES 演示条目注入路径已移除（B8 清理项兑现）。 -->
	<view class="page-root">
		<!-- 60:769 大标题「我的收藏」18pt SemiBold #3A2E25 @y62（trash/settings 二级页先例） -->
		<view class="nav-title">
			<text class="nav-title-text">我的收藏</text>
		</view>
		<!-- 60:827 返回 22pt @(16,60)（复用 i4_135：同几何同色 #3A2E25） -->
		<image class="nav-back" src="/static/icons/i4_135.svg" @tap="goBack" />

		<!-- 60:770 搜索胶囊 350×48 @(20,120) r9999 白底 + 锈红描边环（居中描边→box-shadow 外环，search n2_391 先例） -->
		<view class="search-capsule">
			<!-- 60:778 搜索图标 18pt（复用 i2_392：同几何 圆9.75+柄4.125 #B05A3A） -->
			<image class="capsule-icon" src="/static/icons/i2_392.svg" />
			<view class="capsule-input-area">
				<input class="capsule-input" v-model="keyword" placeholder="在收藏中搜索" placeholder-style="color:#B2A696;font-size:28.8rpx" />
			</view>
		</view>

		<!-- 60:771 筛选行 @(20,184) gap8pt（gap→margin 铁律） -->
		<view class="chip-row">
			<view v-for="(f, idx) in filters" :key="idx" class="chip" :class="{ 'chip-active': idx === activeFilter, 'chip-ml': idx > 0 }" @tap="setFilter(idx)">
				<text class="chip-text" :class="{ 'chip-text-active': idx === activeFilter }">{{ f }}</text>
			</view>
		</view>

		<!-- 60:772 结果提示「12 条收藏」12pt #8A7A6A @(20,234)（动态条数） -->
		<text v-if="loaded && allCards.length > 0" class="count-text">{{ countText() }}</text>

		<!-- ═══ F4a 列表态（卡流，search 结果区先例：绝对定位滚动区） ═══ -->
		<scroll-view v-if="loaded && allCards.length > 0" class="card-scroll" :show-scrollbar="false">
			<!-- §P9：类型筛选 0 结果时给提示（原纯空白被误读为渲染缺陷；countText=总数为画布真值不动） -->
			<view v-if="displayCards.length == 0" class="filter-empty">
				<text class="filter-empty-text">该类型下暂无收藏</text>
				<text class="filter-empty-text filter-empty-sub">换个类型看看，或去记忆详情页点亮星星</text>
			</view>
			<view v-for="item in displayCards" :key="item.id" class="fav-card" :class="item.kind == 'text' ? 'fav-card-text' : ''" @tap="openCard(item)">
				<!-- ── 语音卡（60:776）── -->
				<view v-if="item.kind == 'voice'">
					<!-- 60:790 语音媒体 fill×64pt pad14 gap12 r12 金底14% -->
					<view class="voice-media">
						<!-- 60:810 玻璃播放钮 32pt r16 白50%+inset白40%+border白80% -->
						<view class="glass-btn" @tap.stop="playVoice(item)">
							<view v-if="voiceIsActive(item.contentId) && voiceIsPlaying()" class="fav-pause-icon">
								<view class="fav-pause-bar"></view>
								<view class="fav-pause-bar"></view>
							</view>
							<!-- 60:824/60:826 播放图标 12pt（复用 i2_595：同三角 5.5×6.5 #B05A3A） -->
							<image v-else class="play-icon" src="/static/icons/i2_595.svg" />
						</view>
						<!-- 60:811 波形 200×26pt @(58,19)：空闲=画布 SVG（60:825 与 i2_596 同源实证）；活动=VoiceWave+进度行（search F5a 先例） -->
						<VoiceWave v-if="voiceIsActive(item.contentId)" class="wave-box" :heights="item.waveHeights" :active="true" :progress="voiceProgressOfCard(item.contentId)" />
						<view v-else class="wave-box">
							<image class="wave-img" src="/static/icons/i2_596.svg" />
						</view>
					</view>
					<view v-if="voiceIsActive(item.contentId)" class="voice-progress-row">
						<text class="voice-progress-time">{{ voiceCurSecText() }}</text>
						<view class="voice-track">
							<view class="voice-track-fill" :style="{ width: (voiceProgressOfCard(item.contentId) * 100) + '%' }"></view>
						</view>
						<text class="voice-progress-time">{{ voiceTotalSecText() }}</text>
					</view>
					<!-- 60:791 语音文字区 pad8 gap3 -->
					<view class="voice-text-area">
						<text class="card-title">{{ item.title }}</text>
						<text class="card-meta">{{ item.meta }}</text>
					</view>
				</view>
				<!-- ── 文字卡（60:777）── -->
				<view v-else-if="item.kind == 'text'">
					<!-- 60:792 摘要块 pad12 gap10 r12 金底10% -->
					<view class="quote-block">
						<!-- 60:814 引用竖线 3×40pt r2 #C4913C -->
						<view class="quote-bar"></view>
						<!-- 60:815 摘要文本 14pt #5A4C40 -->
						<text class="quote-text">{{ item.body }}</text>
					</view>
					<!-- 60:793 文字元信息区 pad8（meta 为区首子节点：画布 60:816 y8=纯 padding，gap 不作用于首子） -->
					<view class="text-meta-area">
						<text class="card-meta card-meta-first">{{ item.meta }}</text>
					</view>
				</view>
				<!-- ── 照片卡（60:829）── -->
				<view v-else>
					<!-- 60:830 照片网格 gap4：双列 fill×110pt r8（占位色 60:831 #E9DFCB / 60:832 #E1D3B8）
					     空 URL（无缩略图/mock 演示）→ 纯占位色块（theme-detail photo-cell 先例：外格底色+内 image，零先例 template v-for 禁用） -->
					<view class="photo-grid">
						<view v-for="(p, pi) in item.photos" :key="pi" class="photo-cell" :class="pi == 0 ? 'photo-a' : 'photo-b'">
							<image v-if="p != ''" class="photo-img" :src="p" mode="aspectFill" />
						</view>
					</view>
					<text class="card-title card-title-photo">{{ item.title }}</text>
					<text class="card-meta card-meta-photo">{{ item.meta }}</text>
				</view>
				<!-- 60:835/837/839 星标 20pt 卡内 @(318,16)→right12pt top16pt（收藏态角标，点按取消收藏） -->
				<image class="fav-star" src="/static/icons/favorites-star.svg" @tap.stop="onUnfav(item)" />
			</view>
		</scroll-view>

		<!-- ═══ F4b 空态（判据=收藏 key 为空；绝对定位同画布） ═══ -->
		<view v-if="loaded && allCards.length == 0" class="empty-wrap">
			<!-- 60:892 插画-太阳 60pt @(191,258) + 60:894 插画-山湖 120×90pt @(135,294)
			     （复用 i2_302/i2_304：与 empty 页插画同几何同色 #C4913C/#8A7A6A，empty.uvue 布局先例） -->
			<view class="empty-illus">
				<image class="empty-sun" src="/static/icons/i2_302.svg" mode="aspectFit" />
				<view class="empty-lake"><image class="empty-lake-img" src="/static/icons/i2_304.svg" mode="aspectFit" /></view>
			</view>
			<!-- 60:896/897 标题容器 全宽居中 @y418：「还没有收藏」22pt SemiBold -->
			<view class="empty-title-row">
				<text class="empty-title">还没有收藏</text>
			</view>
			<!-- 60:898 引导容器 gap4 @y460：两行 14pt #8A7A6A -->
			<view class="empty-guide">
				<text class="guide-text">在时间轴长按卡片即可收藏</text>
				<text class="guide-text guide-text-2">收藏的好内容都会住在这里</text>
			</view>
			<!-- 60:901 主按钮 250×56pt @(70,538) r28 #B05A3A 阴影锈红30% -->
			<view class="empty-cta" @tap="goTimeline">
				<text class="empty-cta-text">去时间轴逛逛</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
	import { fetchTimeline, TimelineEvent } from '@/utils/timeline'
	// FE1（W2-2）：收藏列表/取消收藏统一走 play.uts 封装（resolve-only，失败空数组/false + api 层全局 toast）
	import { favoritesList, favoriteRemove } from '@/utils/play'
	import {
		toggleVoice,
		stopVoice,
		isVoiceActive,
		isVoicePlaying,
		voiceProgressOf,
		voiceCurSecValue,
		voiceTotalSecValue,
		fmtVoiceTime
	} from '@/utils/audio_player'

	// ── FE1（W2-2）：真端点已接（favoritesList/favoriteRemove），USE_MOCK_FAVORITES 及
	//    演示条目注入路径已整体移除；空收藏=诚实空态 ──

	/** 收藏卡模型（UTS 零先例禁令：class + constructor + new，对齐 TrashItem/MessageItem 先例；全参显式） */
	class FavCard {
		id: string
		kind: string // voice / text / photo
		title: string
		meta: string
		body: string // 文字卡摘要（其余卡空串）
		contentId: string // 跳详情 + 播放引擎键
		waveHeights: Array<number>
		photos: Array<string> // 照片卡缩略 URL（空串=画布占位色块）

		constructor(
			id: string,
			kind: string,
			title: string,
			meta: string,
			body: string,
			contentId: string,
			waveHeights: Array<number>,
			photos: Array<string>
		) {
			this.id = id
			this.kind = kind
			this.title = title
			this.meta = meta
			this.body = body
			this.contentId = contentId
			this.waveHeights = waveHeights
			this.photos = photos
		}
	}

	function pad2(n: number): string {
		return n < 10 ? '0' + n : '' + n
	}

	/** epoch ms → 「8月28日 07:42」（画布 meta 日期形态；time.uts 无现成同型，页内私有函数） */
	function fmtFavTime(ms: number): string {
		const d = new Date(ms)
		return (d.getMonth() + 1) + '月' + d.getDate() + '日 ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes())
	}

	// ── 响应式状态 ──
	let keyword = ref('')
	let activeFilter = ref(0)
	let filters = ['全部', '照片', '语音', '文字'] // 60:797/798/799/800
	let allCards = ref<Array<FavCard>>([])
	let favTotal = ref(0) // 「N 条收藏」计数（画布 60:772 文案真值）
	let loaded = ref(false)
	let favIds = ref<Array<string>>([])

	/** 收藏数据契约（卡16）：uni.getStorageSync('favorite_ids') Array<string> content_id
	 *  诚实化：detail 页收藏端点未建（W0-4），favorite_ids 由本地写入；try/catch 兜底（empty/index 先例） */
	function readFavoriteIds(): Array<string> {
		const out: Array<string> = []
		try {
			const raw = uni.getStorageSync('favorite_ids')
			if (raw == null) {
				return out
			}
			if (typeof raw == 'string') {
				// 兼容逗号分隔串存储形态（typeof 判型 api.uts/sync_client 先例；uploader 分隔串先例）
				const s = raw as string
				if (s == '' || s == '[]') {
					return out
				}
				const parts = s.split(',')
				for (let i = 0; i < parts.length; i++) {
					const p = parts[i].replace('[', '').replace(']', '').replace(' ', '')
					if (p != '') {
						out.push(p)
					}
				}
				return out
			}
			const arr = raw as Array<string>
			for (let i = 0; i < arr.length; i++) {
				if (arr[i] != '') {
					out.push(arr[i])
				}
			}
		} catch (e) {
			console.log('[favorites] readFavoriteIds 异常: ' + e)
		}
		return out
	}

	function persistFavoriteIds(ids: Array<string>): void {
		// 格式统一（峰宝复验批）：与 detail 写侧同款逗号串——detail 读侧 favRaw.split(',') 不做数组兼容
		uni.setStorageSync('favorite_ids', ids.join(','))
	}

	/** 真数据：fetchTimeline 过滤（卡16 契约）——事件含被收藏成员即成卡 */
	function buildRealCards(events: Array<TimelineEvent>, ids: Array<string>): Array<FavCard> {
		const cards: Array<FavCard> = []
		for (let i = 0; i < events.length; i++) {
			const ev = events[i]
			// ① 语音成员命中 → 语音卡（严格贴 theme-detail metaOf 先例：if != null 块内直接 ev.voice.xxx，无 ! 断言）
			if (ev.voice != null) {
				if (ids.indexOf(ev.voice.contentId) >= 0) {
					const meta = fmtFavTime(ev.startTime) + ' · 语音' // 时长/转写态 EventVoice 无字段→省略（台账降级②）
					cards.push(new FavCard(ev.id, 'voice', ev.title, meta, '', ev.voice.contentId, ev.voice.waveHeights, []))
					continue
				}
			}
			// ② 照片成员命中 → 照片卡（缩略 URL 直喂 :src，EventPhoto 先例）
			let hitPhoto = false
			for (let k = 0; k < ev.photoIds.length; k++) {
				if (ids.indexOf(ev.photoIds[k]) >= 0) {
					hitPhoto = true
					break
				}
			}
			if (hitPhoto) {
				const urls: Array<string> = []
				for (let k = 0; k < ev.photos.length && k < 2; k++) {
					urls.push(ev.photos[k].thumbnailUrl)
				}
				const meta = fmtFavTime(ev.startTime) + ' · 照片 ' + ev.photoCount + '张'
				cards.push(new FavCard(ev.id, 'photo', ev.title, meta, '', ev.coverContentId, [], urls))
				continue
			}
			// ③ 封面/文字命中 → 文字卡（TimelineEvent 无 body → 标题即一句话主题，theme-detail 降级先例）
			if (ids.indexOf(ev.coverContentId) >= 0) {
				const meta = fmtFavTime(ev.startTime) + ' · 文字记录'
				cards.push(new FavCard(ev.id, 'text', ev.title, meta, ev.title, ev.coverContentId, [], []))
			}
		}
		return cards
	}

	/** W2-2 真端点：GET /api/v1/favorites（ContentOut 列表）→ FavCard；
	 *  端点空/失败 → resolve false，回落本地 favorite_ids × timeline 契约 */
	function tryLoadFromEndpoint(): Promise<boolean> {
		return new Promise<boolean>((resolve) => {
			favoritesList().then((arr: Array<UTSJSONObject>) => {
				const cards: Array<FavCard> = []
				for (let i = 0; i < arr.length; i++) {
					const o = arr[i]
					const id = o.getString('id') ?? ''
					const ct = o.getString('content_type') ?? 'text'
					const txt = o.getString('text') ?? ''
					const place = o.getString('place') ?? ''
					const takenAt = o.getString('taken_at') ?? ''
					const thumb = o.getString('thumbnail_url') ?? ''
					// meta：taken_at 前 10 位 →「M月D日 · 类型 · 已收藏」（fmtFavTime 面向 Event.startTime，此处直接截 ISO）
					let day = ''
					if (takenAt.length >= 10) {
						const mm = parseInt(takenAt.substring(5, 7))
						const dd = parseInt(takenAt.substring(8, 10))
						day = mm + '月' + dd + '日'
					}
					const kindWord = ct == 'photo' ? '照片' : (ct == 'voice' ? '语音' : '文字记录')
					const meta = day + ' · ' + kindWord + ' · 已收藏'
					let title = txt != '' ? txt : place
					if (ct == 'photo' && title == '') { title = '照片' }
					if (ct == 'photo') {
						const ps: Array<string> = []
						if (thumb != '') { ps.push(thumb) }
						cards.push(new FavCard(id, 'photo', title, meta, '', id, [], ps))
					} else if (ct == 'voice') {
						cards.push(new FavCard(id, 'voice', title, meta, '', id, [], []))
					} else {
						cards.push(new FavCard(id, 'text', '', meta, txt, id, [], []))
					}
				}
				if (cards.length == 0) {
					resolve(false)
					return
				}
				allCards.value = cards
				favTotal.value = cards.length
				loaded.value = true
				resolve(true)
			})
		})
	}

	function loadCards(): void {
		const ids = readFavoriteIds()
		favIds.value = ids
		// W2-2：端点真数据优先（有真收藏即渲染，不依赖 timeline 事件挂载）
		tryLoadFromEndpoint().then((hit: boolean) => {
			if (hit) {
				return
			}
			if (ids.length > 0) {
				// 回落真链路：fetchTimeline 过滤（失败 resolve 空数组 → 空态，诚实不造假数据）
				fetchTimeline(null).then((events: Array<TimelineEvent>) => {
					const cards = buildRealCards(events, ids)
					allCards.value = cards
					favTotal.value = cards.length
					loaded.value = true
				})
			} else {
				allCards.value = []
				favTotal.value = 0
				loaded.value = true
			}
		})
	}

	onLoad(() => {
		loadCards()
	})

	// 栈回刷新（峰宝 2026-09-03 复验实锤：detail 取消收藏后 navigateBack，onLoad-only 列表不更新）
	// onShow 在 onLoad 后必然跟发一次 → firstShow 防首次双拉；此后每次栈回重读 favorite_ids 重建列表
	let firstShow = true
	onShow(() => {
		if (firstShow) {
			firstShow = false
			return
		}
		loadCards()
	})

	// 离页停播：防止语音跨页残留出声（search/detail 同规）
	onUnload(() => {
		stopVoice()
	})

	// ── 筛选（chip 类型 + 关键词，端上过滤）──
	const displayCards = computed((): Array<FavCard> => {
		const out: Array<FavCard> = []
		const kw = keyword.value.trim()
		for (let i = 0; i < allCards.value.length; i++) {
			const c = allCards.value[i]
			if (activeFilter.value == 1 && c.kind != 'photo') {
				continue
			}
			if (activeFilter.value == 2 && c.kind != 'voice') {
				continue
			}
			if (activeFilter.value == 3 && c.kind != 'text') {
				continue
			}
			if (kw != '' && c.title.indexOf(kw) < 0 && c.meta.indexOf(kw) < 0 && c.body.indexOf(kw) < 0) {
				continue
			}
			out.push(c)
		}
		return out
	})

	function setFilter(idx: number): void {
		activeFilter.value = idx
	}

	function countText(): string {
		// §P9：筛选激活时显示筛选后条数（总数配 0 张卡=误导；全部档维持画布真值 favTotal）
		if (activeFilter.value != 0) {
			return displayCards.value.length + ' 条收藏'
		}
		return favTotal.value + ' 条收藏'
	}

	// ── 播放引擎接线（search 先例三处一致）──
	function voiceIsActive(id: string): boolean {
		return isVoiceActive(id)
	}
	function voiceIsPlaying(): boolean {
		return isVoicePlaying()
	}
	function voiceProgressOfCard(id: string): number {
		return voiceProgressOf(id)
	}
	function voiceCurSecText(): string {
		return fmtVoiceTime(voiceCurSecValue())
	}
	function voiceTotalSecText(): string {
		return fmtVoiceTime(voiceTotalSecValue())
	}
	function playVoice(item: FavCard): void {
		// 无关联记忆的条目（端点数据缺 content_id）不进播放引擎——显式提示（mock 演示条目路径已亡，措辞接真）
		if (item.contentId == '') {
			uni.showToast({ title: '该条目未关联记忆，暂不可播放', icon: 'none' })
			return
		}
		toggleVoice(item.contentId)
	}

	// ── 卡片跳转（search openResult 先例：contentId 进详情）──
	function openCard(item: FavCard): void {
		if (item.contentId == '') {
			uni.showToast({ title: '该条目未关联记忆，无法打开', icon: 'none' })
			return
		}
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + item.contentId })
	}

	/** 取消收藏（FE1 · W2-2 真端点）：DELETE /api/v1/contents/{id}/favorite；
	 *  成功才同步本地 favorite_ids 契约 + 列表重建引用（slice 语义：重建数组赋值）；
	 *  失败不动本地态，显式 toast（api 层已报具体原因，此处补充结果语义） */
	function onUnfav(item: FavCard): void {
		if (item.contentId == '') {
			uni.showToast({ title: '该条目未关联记忆，无法取消收藏', icon: 'none' })
			return
		}
		favoriteRemove(item.contentId).then((ok: boolean) => {
			if (!ok) {
				uni.showToast({ title: '取消收藏失败 · 请稍后重试', icon: 'none' })
				return
			}
			const next: Array<string> = []
			for (let i = 0; i < favIds.value.length; i++) {
				if (favIds.value[i] != item.contentId) {
					next.push(favIds.value[i])
				}
			}
			persistFavoriteIds(next)
			favIds.value = next
			const cards: Array<FavCard> = []
			for (let i = 0; i < allCards.value.length; i++) {
				if (allCards.value[i].id != item.id) {
					cards.push(allCards.value[i])
				}
			}
			allCards.value = cards
			favTotal.value = cards.length
			uni.showToast({ title: '已取消收藏', icon: 'none', duration: 1500 })
		})
	}

	function goTimeline(): void {
		// F4b 主按钮「去时间轴逛逛」→ 时间轴首页（index 非 navigateTo 可达的普通栈页，reLaunch 复位）
		uni.reLaunch({ url: '/pages/index/index' })
	}

	function goBack(): void {
		// 铁律：reLaunch/redirectTo 直入时页面栈仅 1 页，navigateBack 静默失败 → 回落首页
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/index/index' })
		}
	}
</script>


	]

	// 生命周期
	onLoad(() => {
		console.log('[portrait-manage] page loaded')
	})

	// 导航方法
	function goBack() {
		uni.navigateBack()
	}
	function goIndex() {
		uni.navigateTo({ url: '/pages/index/index' })
	}
	function goSearch() {
		uni.navigateTo({ url: '/pages/search/search' })
	}
	function goRecord() {
		uni.navigateTo({ url: '/pages/record/record' })
	}
	function goMessages() {
		uni.navigateTo({ url: '/pages/messages/messages' })
	}
	function goProfile() {
		uni.navigateTo({ url: '/pages/profile/profile' })
	}

	// 业务方法
	function onThemeTap(theme: any) {
		uni.showToast({ title: '查看主题：' + theme.name, icon: 'none' })
	}
	function onRefreshProfile() {
		uni.showToast({ title: '正在重新生成画像...', icon: 'none' })
	}
	function onEditTags() {
		uni.showToast({ title: '编辑性格标签', icon: 'none' })
	}
	function onPrivacySettings() {
		uni.showToast({ title: '画像隐私设置', icon: 'none' })
	}
</script>


					<view class="stat-item">
						<text class="stat-number">{{ totalPhotos }}</text>
						<text class="stat-label">照片</text>
					</view>
					<view class="stat-item">
						<text class="stat-number">{{ totalThemes }}</text>
						<text class="stat-label">主题</text>
					</view>
				</view>
			</view>

			<!-- 性格标签卡片 -->
			<view class="menu-card">
				<text class="menu-title serif">性格标签</text>
				<text class="menu-sub">AI 根据记忆内容自动生成的性格特征</text>
				<view class="tag-list">
					<view v-for="tag in personalityTags" :key="tag.name" class="tag-item" :class="{ 'tag-active': tag.active }">

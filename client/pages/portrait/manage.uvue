						<text class="tag-confidence">{{ tag.confidence }}%</text>
					</view>
				</view>
			</view>

			<!-- 记忆主题卡片 -->
			<view class="menu-card">
				<text class="menu-title serif">记忆主题</text>
				<text class="menu-sub">高频出现的记忆主题分类</text>
				<view class="theme-list">
					<view v-for="theme in themes" :key="theme.name" class="theme-item pressable" @tap="onThemeTap(theme)">

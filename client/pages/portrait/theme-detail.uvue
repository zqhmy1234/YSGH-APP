		height: 42.3rpx;
		z-index: 1;
	}
	/* ── 内容流：画布卡 x20 → 左右 inset 38.5rpx ── */
	.flow {
		position: absolute;
		/* absolute-ok: 滚动容器（锁视口） */
		left: 0rpx;
		right: 0rpx;
		top: 211.5rpx;
		bottom: 0rpx;
		padding-left: 38.5rpx;
		padding-right: 38.5rpx;
		flex-direction: column;
	}
	/* 64:196 结果提示：12px Regular #8A7A6A，y126（flow 顶 y110 → mt 30.8rpx） */
	.meta-count {
		margin-top: 30.8rpx;
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 400;
		font-size: 23.1rpx;
		color: #8A7A6A;
	}
	/* 64:241 主题说明：11px Regular #B3A696，y148（上邻底 141 → gap7 = 13.5rpx） */
	.meta-sub {
		margin-top: 13.5rpx;
		font-family: "Sarasa Gothic SC", sans-serif;

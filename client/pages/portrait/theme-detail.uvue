<template>
	<!-- ═══ 卡23 · F9a 主题详情页（canvas JSON 真值整体重写，2026-09-02 14:33 导出） ═══
	     真值：uvue_gen/theme_detail_canvas.json（390x844 · 31 节点 · 帧 F9a）
	     结构（逻辑 px ×1.9231→rpx）：底 #F8F7F4 / 标题 18·600 居中 y62 / 返回 22×22 @16,60 /
	     结果提示 12·400 #8A7A6A y126 / 主题说明 11·400 #B3A696 y148 /
	     三形态卡流 x20 w350 r20 p8（白卡 + 双层投影，多层阴影零先例→单层登记台账）：
	     语音卡=音频条 h64 r12 #C4913C a0.14（玻璃播放钮 32 白a0.5+描边白a0.8+blur8+内阴影白a0.4
	     + 锈红播放图标 5.5×6.5 + 金波形）+ 文字区 p8 gap3（标题 17·600 + 元信息 11）/
	     文字卡=摘要块 r12 #C4913C a0.1 p12（金竖线 3×40 + 引文 14 #5A4C40）+ 元信息区 p8 /
	     照片卡=双拼网格 h110 r8 gap4（占位 #E9DFCB/#E1D3B8）+ 标题 17·600 + 元信息 11 -->
	<view class="page-root tk-root">
		<!-- 导航（settings.uvue 二级页先例原值；标题 = 主题名） -->
		<view class="nav-title">
			<text class="nav-title-text">{{ themeName }}</text>
		</view>
		<image class="nav-back" src="/static/icons/i4_135.svg" @tap="goBack" />

		<!-- 2026-09-23 编译门修复：`scroll-y` 不是 uni-app x <scroll-view> 的支持属性（同 TabAi.uvue），
			     正确写法 direction="vertical"（显式化优于依赖默认值） -->
		<scroll-view class="flow" direction="vertical">
			<!-- 结果提示（画布 y126「8 条记忆 · 6月2日至今」） -->
			<text class="meta-count">{{ cards.length }} 条记忆{{ rangeText != '' ? ' · ' + rangeText : '' }}</text>
			<!-- 主题说明（画布 y148；「· 更新于昨天」无数据源省略，台账 卡23 F9a） -->
			<text class="meta-sub">AI 从你的记忆里聚出来的主题流</text>

			<!-- 记忆卡流（三形态：语音 / 照片 / 文字）
			     2026-10-16（RC-F）：数据源由 `TimelineEvent` 改为本页视图模型 `ThemeCard`——
			     kind/标题/元信息/波形高度/前 2 张照片在**组装期**预计算，播放态 active/progress 由
			     syncActiveCard 相等守卫写入 ⇒ 模板**零函数调用**（原每卡调 metaOf/topPhotos/
			     voiceIsActive/voiceProgressOfCard 四个函数）。 -->
			<view v-for="(ev, idx) in cards" :key="ev.id" :class="idx == cards.length - 1 ? 'card no-margin' : 'card'">
				<!-- ① 语音卡：音频条（玻璃播放钮 + VoiceWave 金波形，detail 先例接线全局播放引擎） -->
				<view v-if="ev.kind == 'voice'" class="voice-strip">
					<view class="vplay-btn" @tap="onPlayTap(ev)">
						<image v-if="!ev.active" class="vplay-icon" src="/static/icons/record-play.svg" />
						<view v-else class="vpause-bars">
							<view class="vpause-bar"></view>
							<view class="vpause-bar"></view>
						</view>
					</view>
					<view class="vwave">
						<VoiceWave :heights="ev.voiceHeights" :waveform="wf.waveformOf(ev.voiceCid)" :active="ev.active" :progress="ev.progress" idle-color="#C4913C" />
					</view>
				</view>
				<view v-if="ev.kind == 'voice'" class="voice-text-block">
					<text class="card-title">{{ ev.title }}</text>
					<text class="card-meta">{{ ev.meta }}</text>
				</view>
				<!-- ② 照片卡：双图拼块（thumbnailUrl 直喂 :src，EventPhoto 先例；空 URL 占位暖块双色） -->
				<view v-if="ev.kind == 'photo'" class="photo-grid">
					<view v-for="(ph, pIdx) in ev.photos" :key="ph.contentId" :class="pIdx == 0 ? 'photo-cell cell-a' : 'photo-cell'">
						<image v-if="ph.thumbnailUrl != ''" class="photo-img" :src="ph.thumbnailUrl" mode="aspectFill" />
						<view v-else :class="pIdx == 0 ? 'photo-ph ph-a' : 'photo-ph ph-b'"></view>
					</view>
				</view>
				<text v-if="ev.kind == 'photo'" class="card-title title-flush">{{ ev.title }}</text>
				<text v-if="ev.kind == 'photo'" class="card-meta meta-flush">{{ ev.meta }}</text>
				<!-- ③ 文字卡：引用块（左金竖条；L2 事件无 body 字段，引用文字 = 主题事件标题，台账 卡23 F9a） -->
				<view v-if="ev.kind == 'text'" class="quote-block">
					<view class="quote-bar"></view>
					<text class="quote-text">{{ ev.title }}</text>
				</view>
				<view v-if="ev.kind == 'text'" class="text-meta-block">
					<text class="card-meta">{{ ev.meta }}</text>
				</view>
			</view>

			<!-- 空态（主题下暂无 L2 事件；画布无空态帧，沿用既有交互必需形态） -->
			<view v-if="cards.length == 0 && !loading" class="empty-card">
				<text class="empty-text">这个主题下还没有记忆</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 2026-10-16（RC-F）：显式引入 watch 驱动播放态同步（本文件其余 Vue API 沿用 uni-app x 自动引入）
	import { watch } from 'vue'
	import { fetchTimeline, getCachedTimeline, TimelineEvent } from '@/utils/timeline'
	import {
		toggleVoice,
		stopVoice,
		voiceCurrentId,
		voiceProgress
	} from '@/utils/audio_player'
	import { EventPhoto } from '@/utils/timeline'
	import { WaveformCache } from '@/composables/useWaveform'

	// ── 页面参数 ──
	let themeName = ref('')
	// ── 响应式状态 ──
	// 2026-10-16（RC-F）：卡数据源由 TimelineEvent 改为本页视图模型 ThemeCard（组装期预计算 +
	// 播放态字段），模板零函数调用。TimelineEvent 仍是取数入参类型，故 import 保留。
	let cards = ref<Array<ThemeCard>>([])
	let loading = ref(true)
	let rangeText = ref('')

	/** 主题卡视图模型（2026-10-16 · RC-F）：组装期预计算 kind/标题/元信息/波形高度/前 2 张照片；
	 *  播放态 active/progress 由 syncActiveCard 相等守卫写入。类声明先例：TabSearch.VoiceResult。 */
	class ThemeCard {
		id: string
		startTime: number
		kind: string // voice | photo | text
		title: string
		meta: string
		photos: Array<EventPhoto>
		voiceCid: string
		voiceHeights: Array<number>
		active: boolean
		progress: number
		constructor(id: string, startTime: number, kind: string, title: string, meta: string, photos: Array<EventPhoto>, voiceCid: string, voiceHeights: Array<number>) {
			this.id = id
			this.startTime = startTime
			this.kind = kind
			this.title = title
			this.meta = meta
			this.photos = photos
			this.voiceCid = voiceCid
			this.voiceHeights = voiceHeights
			this.active = false
			this.progress = 0
		}
	}

	// B5.2f：波形缓存收敛为共享组合式函数（唯一实现 client/composables/useWaveform.uts）
	const wf = new WaveformCache()

	onLoad((options: OnLoadOptions) => {
		const t = options['theme'] as string
		if (t != '') {
			themeName.value = decodeURIComponent(t)
		}
	})

	onShow(() => {
		loadItems()
	})

	onUnload(() => {
		// W0-2 同规：离页停播，防语音跨页残留出声
		stopVoice()
	})

	/** 按主题筛出 L2 子集（P-5 收口 2026-09-04：server level=2 过滤窄化，替代全量 timeline 拉取）→ startTime 倒序 */
	function applyPicked(events: Array<TimelineEvent>): void {
		const picked: Array<ThemeCard> = []
		let minMs = 0 as number
		for (let i = 0; i < events.length; i++) {
			const ev = events[i]
			if (ev.level === 2 && ev.title == themeName.value) {
				picked.push(toCard(ev))
				if (minMs == 0 || ev.startTime < minMs) {
					minMs = ev.startTime
				}
			}
		}
		picked.sort((a: ThemeCard, b: ThemeCard): number => {
			return b.startTime - a.startTime
		})
		cards.value = picked
		if (minMs > 0) {
			rangeText.value = fmtMonthDay(minMs) + '至今'
		} else {
			rangeText.value = ''
		}
		// BB3：数据就绪即批量拉真实波形（本页 L2 子集卡量小，对齐 detail 进页即拉；
		// 同 contentId 由 useWaveform 的 WaveformCache 去重，onPlayTap 再调零成本）
		for (let i = 0; i < picked.length; i++) {
			if (picked[i].voiceCid != '') {
				wf.loadWaveform(picked[i].voiceCid)
			}
		}
		// RC-F：卡重建后补一次播放态同步（切页返回时正在播的卡要立即显示播放态）
		syncActiveCard()
	}

	/** TimelineEvent → ThemeCard：kind/元信息/波形高度/前 2 张照片在**组装期**算好（模板零函数调用）。
	 *  三形态判定与画布一致：语音（有 voice）→ 照片（有 photos）→ 文字（其余，引用文字=事件标题）。 */
	function toCard(ev: TimelineEvent): ThemeCard {
		if (ev.voice != null) {
			return new ThemeCard(ev.id, ev.startTime, 'voice', ev.title, metaOf(ev), [], ev.voice.contentId, ev.voice.waveHeights)
		}
		if (ev.photos.length > 0) {
			const ps: Array<EventPhoto> = []
			for (let i = 0; i < ev.photos.length && i < 2; i++) {
				ps.push(ev.photos[i])
			}
			return new ThemeCard(ev.id, ev.startTime, 'photo', ev.title, metaOf(ev), ps, '', [])
		}
		return new ThemeCard(ev.id, ev.startTime, 'text', ev.title, metaOf(ev), [], '', [])
	}

	/**
	 * 进入本页取数（P-5 收口起：只拉 L2 子集）。
	 *
	 * 2026-10-14（台账 §4.20 ⑭ · 用户反馈「每次跳转都要等一会数据才出现」）：本页 `onShow`
	 * **每次**都会调用它（含从内容详情栈返回），而原实现无条件 `loading=true` +
	 * `fetchTimeline(2)` ⇒ ①列表先被清空转圈再重画；②每次进入都等一次网络。
	 * 现先复用**时间轴模块已有的缓存**（`getCachedTimeline`，60s 内有效——用户几乎总是刚从
	 * 时间轴/我的页过来，缓存基本必命中）：**零请求、零等待**地本地筛出本主题子集，再后台
	 * 静默刷新（不置 loading、不清空列表）；未命中才走网络并显示加载态。
	 * 两条路径互相增益：`fetchTimeline(2)` 的结果本身就回写同一缓存。
	 */
	function loadItems(): void {
		const hit = getCachedTimeline()
		if (hit != null) {
			applyPicked(hit.events)
			refreshQuietly()
			return
		}
		loading.value = true
		fetchTimeline(2).then((events: Array<TimelineEvent>) => {
			applyPicked(events)
			loading.value = false
		})
	}

	/** 后台静默刷新：不置 loading、不清空已显示列表（失败保持原样） */
	function refreshQuietly(): void {
		fetchTimeline(2).then((events: Array<TimelineEvent>) => {
			applyPicked(events)
		})
	}

	/** meta「8月28日 07:42」（friendlyDay 同款拼接写法，月日不补零对齐画布） */
	function fmtMonthDay(ms: number): string {
		const d = new Date(ms)
		return (d.getMonth() + 1) + '月' + d.getDate() + '日'
	}
	function metaOf(ev: TimelineEvent): string {
		const d = new Date(ev.startTime)
		const hh = d.getHours() < 10 ? '0' + d.getHours() : '' + d.getHours()
		const mi = d.getMinutes() < 10 ? '0' + d.getMinutes() : '' + d.getMinutes()
		let s = fmtMonthDay(ev.startTime) + ' ' + hh + ':' + mi
		if (ev.voice != null) {
			// 诚实化：EventVoice 无转写状态字段，画布「已转写」省略（台账 卡23 F9a）
			s += ' · 语音 ' + ev.voice.duration
		} else if (ev.photos.length > 0) {
			s += ' · 照片 ' + ev.photos.length + '张'
		} else {
			s += ' · 文字记录'
		}
		return s
	}
	// ── 语音播放（detail 先例：复用全局播放引擎，播放态三处一致） ──
	function onPlayTap(ev: ThemeCard): void {
		if (ev.voiceCid == '') {
			return
		}
		wf.loadWaveform(ev.voiceCid) // BB3：兜底拉取（就绪批量已覆盖，Map 命中零成本）
		toggleVoice(ev.voiceCid)
	}

	// ── 播放态预计算（2026-10-16 · RC-F）──────────────────────────────────────────
	// 范式照 `TabSearch.syncActiveCard` / `TabIndex.syncVoiceCards`：数据写入时把全局播放态写进
	// 「正在播放那张卡」，模板只读（零函数调用）；相等守卫 ⇒ 未变的卡零写入零重渲染。
	function applyCardState(c: ThemeCard, cid: string, prog: number): boolean {
		const isActive = c.voiceCid != '' && c.voiceCid == cid
		let changed = false
		if (c.active != isActive) {
			c.active = isActive
			changed = true
		}
		if (isActive) {
			if (c.progress != prog) {
				c.progress = prog
				changed = true
			}
		} else if (c.progress != 0) {
			c.progress = 0 // 退出活动态：清干净（否则旧卡残留进度染色）
			changed = true
		}
		return changed
	}

	function syncActiveCard(): void {
		const cid = voiceCurrentId.value
		const prog = voiceProgress.value
		const arr = cards.value
		let changed = false
		for (let i = 0; i < arr.length; i++) {
			if (applyCardState(arr[i], cid, prog)) {
				changed = true
			}
		}
		if (changed) {
			cards.value = arr.slice() // 整组浅替换（同 TabIndex 口径，确定性重渲染）
		}
	}

	// 播放态源 ref（audio_player 全局单例）→ 单源 watch，tick 驱动面收敛到 syncActiveCard
	watch(voiceCurrentId, (): void => { syncActiveCard() })
	watch(voiceProgress, (): void => { syncActiveCard() })

	function goBack(): void {
		// 铁律：reLaunch/redirectTo 直入时页面栈仅 1 页，navigateBack 静默失败 → 回落首页
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/shell/shell' })
		}
	}
</script>

<style>
	.page-root {
		flex: 1;
		flex-direction: column;
		background-color: var(--c-paper-100, #F8F7F4);
	}
	/* ── 导航：画布 标题 18px SemiBold y62 / 返回 22×22 @16,60 ── */
	.nav-title {
		position: absolute;
		/* absolute-ok: 固定页头·标题容器（全宽居中） */
		left: var(--d-lattice-p0, 0rpx);
		top: var(--d-lattice-p60, 115.4rpx);
		width: var(--d-lattice-p390, 750rpx);
		flex-direction: row;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}
	.nav-title-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 600;
		font-size: var(--d-lattice-p18, 34.6rpx);
		color: var(--c-ink-900, #3A2E25);
	}
	.nav-back {
		position: absolute;
		/* absolute-ok: 固定页头·返回钮 */
		left: var(--d-lattice-p16, 30.8rpx);
		top: var(--d-lattice-p60, 115.4rpx);
		width: var(--d-lattice-p22, 42.3rpx);
		height: var(--d-lattice-p22, 42.3rpx);
		z-index: 1;
	}
	/* ── 内容流：画布卡 x20 → 左右 inset 38.5rpx ── */
	.flow {
		position: absolute;
		/* absolute-ok: 滚动容器（锁视口） */
		left: var(--d-lattice-p0, 0rpx);
		right: var(--d-lattice-p0, 0rpx);
		top: var(--d-lattice-p110, 211.5rpx);
		bottom: var(--d-lattice-p0, 0rpx);
		padding-left: var(--d-card_margin_x, 38.5rpx);
		padding-right: var(--d-card_margin_x, 38.5rpx);
		flex-direction: column;
	}
	/* 64:196 结果提示：12px Regular #8A7A6A，y126（flow 顶 y110 → mt 30.8rpx） */
	.meta-count {
		margin-top: var(--d-lattice-p16, 30.8rpx);
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 400;
		font-size: var(--d-card_radius_small, 23.1rpx);
		color: var(--c-ink-500, #8A7A6A);
	}
	/* 64:241 主题说明：11px Regular #B3A696，y148（上邻底 141 → gap7 = 13.5rpx） */
	.meta-sub {
		margin-top: var(--d-lattice-p7, 13.5rpx);
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 400;
		font-size: var(--d-lattice-p11, 21.2rpx);
		color: var(--c-ink-300, #B3A696);
	}
	/* ── 记忆卡：画布 w350 r20 p8 白卡；投影双层 (0,4,16,.06)+(0,1,3,.04) →
	   多层 box-shadow 全项目零先例 → 取主层单影，次层降级（台账 卡23 F9a）；
	   首卡上隙画布 9pt(17.3rpx) 与卡间 10pt(19.2rpx) 差 1pt → 统一 19.2rpx（台账） ── */
	.card {
		margin-top: var(--d-lattice-p10, 19.2rpx);
		background-color: var(--c-white, #FFFFFF);
		border-radius: var(--d-card_margin_x, 38.5rpx);
		padding: var(--d-lattice-p8, 15.4rpx);
		box-shadow: 0 var(--d-lattice-p4, 7.7rpx) var(--d-lattice-p16, 30.8rpx) var(--a-ink-06, rgba(59, 46, 38, 0.06));
		flex-direction: column;
	}
	.no-margin {
		margin-bottom: var(--d-lattice-p0, 0rpx);
	}
	/* 首卡贴 meta-sub（y148+13 → 170：gap9 = 17.3rpx） */
	/* ── 语音卡 64:211 语音媒体：h64 r12 #C4913C a0.14 p14 gap12 ── */
	.voice-strip {
		height: var(--d-lattice-p64, 123.1rpx);
		background-color: var(--a-amber-14, #C4913C24);
		border-radius: var(--d-card_radius_small, 23.1rpx);
		flex-direction: row;
		align-items: center;
		padding-left: var(--d-lattice-p14, 26.9rpx);
		padding-right: var(--d-lattice-p14, 26.9rpx);
	}
	/* 64:229 玻璃播放钮：32×32 白a0.5 + 描边白a0.8 + BACKGROUND_BLUR 8 + 内阴影白a0.4
	   （backdrop-filter 有 TabBar 先例；inset box-shadow 按 CSS 支持清单纳入） */
	.vplay-btn {
		width: var(--d-lattice-p32, 61.5rpx);
		height: var(--d-lattice-p32, 61.5rpx);
		border-radius: var(--d-lattice-p16, 30.8rpx);
		background-color: var(--a-white-50, rgba(255, 255, 255, 0.5));
		border-width: var(--d-lattice-p1, 1.9rpx);
		border-style: solid;
		border-color: var(--a-white-80, rgba(255, 255, 255, 0.8));
		backdrop-filter: blur(8px);
		box-shadow: inset 0 var(--d-lattice-p1, 1.9rpx) 3.9rpx var(--a-white-40, rgba(255, 255, 255, 0.4));
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}
	/* 64:238/64:240 播放图标：5.5×6.5 锈红（库存 record-play.svg #B05A3A 同色同形） */
	.vplay-icon {
		width: 10.6rpx;
		height: 12.5rpx;
	}
	/* 暂停态（画布无此形态，沿用既有两竖条交互形态，色随播放图标锈红） */
	.vpause-bars {
		flex-direction: row;
	}
	.vpause-bar {
		width: var(--d-lattice-p4, 7.7rpx);
		height: var(--d-card_radius_small, 23.1rpx);
		border-radius: 3.9rpx;
		background-color: var(--c-rust-500, #B05A3A);
		margin-left: var(--d-lattice-p3, 5.8rpx);
	}

	}
	/* ── 记忆卡：画布 w350 r20 p8 白卡；投影双层 (0,4,16,.06)+(0,1,3,.04) →
	   多层 box-shadow 全项目零先例 → 取主层单影，次层降级（台账 卡23 F9a）；
	   首卡上隙画布 9pt(17.3rpx) 与卡间 10pt(19.2rpx) 差 1pt → 统一 19.2rpx（台账） ── */
	.card {
		margin-top: 19.2rpx;
		background-color: #FFFFFF;
		border-radius: 38.5rpx;
		padding: 15.4rpx;
		box-shadow: 0 7.7rpx 30.8rpx rgba(59, 46, 38, 0.06);
		flex-direction: column;
	}
	.no-margin {
		margin-bottom: 0rpx;
	}
	/* 首卡贴 meta-sub（y148+13 → 170：gap9 = 17.3rpx） */
	/* ── 语音卡 64:211 语音媒体：h64 r12 #C4913C a0.14 p14 gap12 ── */
	.voice-strip {
		height: 123.1rpx;
		background-color: #C4913C24;
		border-radius: 23.1rpx;
		flex-direction: row;
		align-items: center;
		padding-left: 26.9rpx;
		padding-right: 26.9rpx;
	}
	/* 64:229 玻璃播放钮：32×32 白a0.5 + 描边白a0.8 + BACKGROUND_BLUR 8 + 内阴影白a0.4
	   （backdrop-filter 有 TabBar 先例；inset box-shadow 按 CSS 支持清单纳入） */
	.vplay-btn {
		width: 61.5rpx;
		height: 61.5rpx;
		border-radius: 30.8rpx;
		background-color: rgba(255, 255, 255, 0.5);
		border-width: 1.9rpx;
		border-style: solid;
		border-color: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(8px);
		box-shadow: inset 0 1.9rpx 3.9rpx rgba(255, 255, 255, 0.4);
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}
	/* 64:238/64:240 播放图标：5.5×6.5 锈红（库存 record-play.svg #B05A3A 同色同形） */
	.vplay-icon {
		width: 10.6rpx;
		height: 12.5rpx;
	}
	/* 暂停态（画布无此形态，沿用既有两竖条交互形态，色随播放图标锈红） */
	.vpause-bars {
		flex-direction: row;
	}
	.vpause-bar {
		width: 7.7rpx;
		height: 23.1rpx;
		border-radius: 3.9rpx;
		background-color: #B05A3A;
		margin-left: 5.8rpx;
	}
	/* 64:230 波形：x58（钮右 gap12=23.1rpx）h26→50rpx，VoiceWave 复用（detail 先例） */
	.vwave {
		flex: 1;
		margin-left: 23.1rpx;
		height: 50rpx;
	}
	/* 64:212 语音文字区：p8 gap3 → 元信息 mt 5.8rpx */
	.voice-text-block {
		padding: 15.4rpx;
		flex-direction: column;
	}
	/* ── 照片卡 64:216 照片网格：gap4 → 首格 mr 7.7rpx；双格 flex 均分 h110 ── */
	.photo-grid {
		flex-direction: row;
	}
	.photo-cell {
		flex: 1;
		height: 211.5rpx;
		border-radius: 15.4rpx;
		overflow: hidden;
	}
	.cell-a {
		margin-right: 7.7rpx;
	}
	.photo-img {
		width: 317.3rpx;
		height: 211.5rpx;
	}
	/* 64:236/64:237 画布照片占位双色 #E9DFCB / #E1D3B8 */
	.photo-ph {
		width: 317.3rpx;
		height: 211.5rpx;
	}
	.ph-a {
		background-color: #E9DFCB;
	}
	.ph-b {
		background-color: #E1D3B8;
	}
	/* 64:217/218 照片卡标题/元信息：画布原值 y118/y139 = 网格后零间隙（真值），
	   但峰宝拍板（2026-09-02 主窗口收口）：三节点零间距太拥挤，属画布生成缺陷，
	   覆盖真值加呼吸间距（网格→标题 12pt / 标题→元信息 4pt），已登记 _diff_ledger.md */
	.title-flush {
		margin-top: 23.1rpx;
	}
	.meta-flush {
		margin-top: 7.7rpx;
	}
	/* ── 文字卡 64:213 摘要块：r12 #C4913C a0.1 p12 gap10 ── */

<template>
	<!-- ═══ 卡23 · F9a 主题详情页（canvas JSON 真值整体重写，2026-09-02 14:33 导出） ═══
	     真值：uvue_gen/theme_detail_canvas.json（390x844 · 31 节点 · 帧 F9a）
	     结构（逻辑 px ×1.9231→rpx）：底 #F8F7F4 / 标题 18·600 居中 y62 / 返回 22×22 @16,60 /
	     结果提示 12·400 #8A7A6A y126 / 主题说明 11·400 #B3A696 y148 /
	     三形态卡流 x20 w350 r20 p8（白卡 + 双层投影，多层阴影零先例→单层登记台账）：
	     语音卡=音频条 h64 r12 #C4913C a0.14（玻璃播放钮 32 白a0.5+描边白a0.8+blur8+内阴影白a0.4
	     + 锈红播放图标 5.5×6.5 + 金波形）+ 文字区 p8 gap3（标题 17·600 + 元信息 11）/
	     文字卡=摘要块 r12 #C4913C a0.1 p12（金竖线 3×40 + 引文 14 #5A4C40）+ 元信息区 p8 /
	     照片卡=双拼网格 h110 r8 gap4（占位 #E9DFCB/#E1D3B8）+ 标题 17·600 + 元信息 11 -->
	<view class="page-root">
		<!-- 导航（settings.uvue 二级页先例原值；标题 = 主题名） -->
		<view class="nav-title">
			<text class="nav-title-text">{{ themeName }}</text>
		</view>
		<image class="nav-back" src="/static/icons/i4_135.svg" @tap="goBack" />

		<scroll-view class="flow" scroll-y>
			<!-- 结果提示（画布 y126「8 条记忆 · 6月2日至今」） -->
			<text class="meta-count">{{ items.length }} 条记忆{{ rangeText != '' ? ' · ' + rangeText : '' }}</text>
			<!-- 主题说明（画布 y148；「· 更新于昨天」无数据源省略，台账 卡23 F9a） -->
			<text class="meta-sub">AI 从你的记忆里聚出来的主题流</text>

			<!-- 记忆卡流（三形态：语音 / 照片 / 文字） -->
			<view v-for="(ev, idx) in items" :key="ev.id" :class="idx == items.length - 1 ? 'card no-margin' : 'card'">
				<!-- ① 语音卡：音频条（玻璃播放钮 + VoiceWave 金波形，detail 先例接线全局播放引擎） -->
				<view v-if="ev.voice != null" class="voice-strip">
					<view class="vplay-btn" @tap="onPlayTap(ev)">
						<image v-if="!voiceIsActive(ev.voice.contentId)" class="vplay-icon" src="/static/icons/record-play.svg" />
						<view v-else class="vpause-bars">
							<view class="vpause-bar"></view>
							<view class="vpause-bar"></view>
						</view>
					</view>
					<view class="vwave">
						<VoiceWave :heights="ev.voice.waveHeights" :active="voiceIsActive(ev.voice.contentId)" :progress="voiceProgressOfCard(ev.voice.contentId)" idle-color="#C4913C" />
					</view>
				</view>
				<view v-if="ev.voice != null" class="voice-text-block">
					<text class="card-title">{{ ev.title }}</text>
					<text class="card-meta">{{ metaOf(ev) }}</text>
				</view>
				<!-- ② 照片卡：双图拼块（thumbnailUrl 直喂 :src，EventPhoto 先例；空 URL 占位暖块双色） -->
				<view v-if="ev.voice == null && ev.photos.length > 0" class="photo-grid">
					<view v-for="(ph, pIdx) in topPhotos(ev)" :key="ph.contentId" :class="pIdx == 0 ? 'photo-cell cell-a' : 'photo-cell'">
						<image v-if="ph.thumbnailUrl != ''" class="photo-img" :src="ph.thumbnailUrl" mode="aspectFill" />
						<view v-else :class="pIdx == 0 ? 'photo-ph ph-a' : 'photo-ph ph-b'"></view>
					</view>
				</view>
				<text v-if="ev.voice == null && ev.photos.length > 0" class="card-title title-flush">{{ ev.title }}</text>
				<text v-if="ev.voice == null && ev.photos.length > 0" class="card-meta meta-flush">{{ metaOf(ev) }}</text>
				<!-- ③ 文字卡：引用块（左金竖条；L2 事件无 body 字段，引用文字 = 主题事件标题，台账 卡23 F9a） -->
				<view v-if="ev.voice == null && ev.photos.length == 0" class="quote-block">
					<view class="quote-bar"></view>
					<text class="quote-text">{{ ev.title }}</text>
				</view>
				<view v-if="ev.voice == null && ev.photos.length == 0" class="text-meta-block">
					<text class="card-meta">{{ metaOf(ev) }}</text>
				</view>
			</view>

			<!-- 空态（主题下暂无 L2 事件；画布无空态帧，沿用既有交互必需形态） -->
			<view v-if="items.length == 0 && !loading" class="empty-card">
				<text class="empty-text">这个主题下还没有记忆</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { fetchTimeline, TimelineEvent } from '@/utils/timeline'
	import {
		toggleVoice,
		stopVoice,
		isVoiceActive,
		voiceProgressOf
	} from '@/utils/audio_player'
	import { EventPhoto } from '@/utils/timeline'

	// ── 页面参数 ──
	let themeName = ref('')
	// ── 响应式状态 ──
	let items = ref<Array<TimelineEvent>>([])
	let loading = ref(true)
	let rangeText = ref('')

	onLoad((options: OnLoadOptions) => {
		const t = options['theme'] as string
		if (t != '') {
			themeName.value = decodeURIComponent(t)
		}
	})

	onShow(() => {
		loadItems()
	})

	onUnload(() => {
		// W0-2 同规：离页停播，防语音跨页残留出声
		stopVoice()
	})

	/** 拉回 L2 子集（P-5 收口 2026-09-04：server level=2 过滤窄化，替代全量 timeline 拉取）→ 前端按标题匹配，startTime 倒序 */
	function loadItems(): void {
		loading.value = true
		fetchTimeline(2).then((events: Array<TimelineEvent>) => {
			const picked: Array<TimelineEvent> = []
			let minMs = 0 as number
			for (let i = 0; i < events.length; i++) {
				const ev = events[i]
				if (ev.level === 2 && ev.title == themeName.value) {
					picked.push(ev)
					if (minMs == 0 || ev.startTime < minMs) {
						minMs = ev.startTime
					}
				}
			}
			picked.sort((a: TimelineEvent, b: TimelineEvent): number => {
				return b.startTime - a.startTime
			})
			items.value = picked
			if (minMs > 0) {
				rangeText.value = fmtMonthDay(minMs) + '至今'
			} else {
				rangeText.value = ''
			}
			loading.value = false
		})
	}

	/** meta「8月28日 07:42」（friendlyDay 同款拼接写法，月日不补零对齐画布） */
	function fmtMonthDay(ms: number): string {
		const d = new Date(ms)
		return (d.getMonth() + 1) + '月' + d.getDate() + '日'
	}
	function metaOf(ev: TimelineEvent): string {
		const d = new Date(ev.startTime)
		const hh = d.getHours() < 10 ? '0' + d.getHours() : '' + d.getHours()
		const mi = d.getMinutes() < 10 ? '0' + d.getMinutes() : '' + d.getMinutes()
		let s = fmtMonthDay(ev.startTime) + ' ' + hh + ':' + mi
		if (ev.voice != null) {
			// 诚实化：EventVoice 无转写状态字段，画布「已转写」省略（台账 卡23 F9a）
			s += ' · 语音 ' + ev.voice.duration
		} else if (ev.photos.length > 0) {
			s += ' · 照片 ' + ev.photos.length + '张'
		} else {
			s += ' · 文字记录'
		}
		return s
	}
	/** 照片卡前 2 张（画布双拼网格） */
	function topPhotos(ev: TimelineEvent): Array<EventPhoto> {
		const out: Array<EventPhoto> = []
		for (let i = 0; i < ev.photos.length && i < 2; i++) {
			out.push(ev.photos[i])
		}
		return out
	}

	// ── 语音播放（detail 先例：复用全局播放引擎，播放态三处一致） ──
	function onPlayTap(ev: TimelineEvent): void {
		if (ev.voice == null) {
			return
		}
		toggleVoice(ev.voice.contentId)
	}
	function voiceIsActive(cid: string): boolean {
		return isVoiceActive(cid)
	}
	function voiceProgressOfCard(cid: string): number {
		return voiceProgressOf(cid)
	}

	function goBack(): void {
		// 铁律：reLaunch/redirectTo 直入时页面栈仅 1 页，navigateBack 静默失败 → 回落首页
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/index/index' })
		}
	}
</script>

<style>
	.page-root {
		flex: 1;
		flex-direction: column;
		background-color: #F8F7F4;
	}
	/* ── 导航：画布 标题 18px SemiBold y62 / 返回 22×22 @16,60 ── */
	.nav-title {
		position: absolute;
		/* absolute-ok: 固定页头·标题容器（全宽居中） */
		left: 0rpx;
		top: 115.4rpx;
		width: 750rpx;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}

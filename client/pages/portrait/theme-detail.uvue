		align-items: center;
	}
	/* 64:233 引用竖线：3×40 r2 */
	.quote-bar {
		width: 5.8rpx;
		height: 76.9rpx;
		border-radius: 3.9rpx;
		background-color: #C4913C;
	}
	/* 64:234 摘要文本：14px Regular #5A4C40，竖线右 gap10=19.2rpx */
	.quote-text {
		flex: 1;
		margin-left: 19.2rpx;
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 400;

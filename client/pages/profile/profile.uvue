<script setup lang="uts">
	// ===== 设计稿图标（已落成 /static/icons/*.svg 静态资源） =====

	// TabBar 图标（我的=激活态锈红；其余=常态灰）

	// ===== 交互 =====
	// 类型入口（照片/语音/文字）
	function goType(type: string): void {
		uni.navigateTo({ url: '/pages/search/search?type=' + type })
	}

	// 菜单：我的画像
	function goPortraitManage(): void {
		uni.navigateTo({ url: '/pages/portrait/manage' })
	}

	// 菜单：我的收藏（页面未建成，占位）
	function goFavorites(): void {

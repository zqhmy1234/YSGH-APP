<template>
	<view class="page">
		<view class="header">
			<text class="header-title serif">我的</text>
			<text class="header-sub">记忆与偏好</text>
		</view>

		<!-- 同步状态横幅（B4 §7 · Wave3 H）：待上传/失败标红/暂停/继续上传；自包含组件 -->
		<UploadStatusBanner />

		<!-- 画像卡（冷启动状态 T-PL-2） -->
		<view class="profile-card">
			<view class="profile-head">
				<text class="profile-title serif">我的画像</text>
				<text v-if="profileReady" class="profile-badge">已建立</text>
				<text v-else class="profile-badge">待完善</text>
			</view>
			<text v-if="profileReady" class="profile-desc">已完成冷启动访谈，画像维度已激活</text>
			<text v-else class="profile-desc">回答三个问题，让记忆整理更懂你</text>
			<view class="profile-btn" @tap="goInterview">
				<text class="profile-btn-text">{{ profileReady ? '查看/完善画像' : '开始冷启动访谈' }}</text>
			</view>
		</view>

		<!-- 消息中心入口（T-PL-3） -->
		<view class="menu-card" @tap="goMessages">
			<view class="menu-row">
				<text class="menu-icon">✉️</text>
				<text class="menu-title">消息中心</text>
				<text v-if="unreadCount > 0" class="menu-badge">{{ unreadCount }} 未读</text>
				<text class="menu-arrow">›</text>
			</view>
		</view>

		<!-- 关于 -->
		<view class="about-card">
			<text class="about-text">忆述光华 · v0.1.0</text>
			<text class="about-sub">翻看记忆，去年今日</text>
		</view>

		<!-- 底部 Tab -->
		<yishu-tabbar current="profile" />
	</view>
</template>

<script lang="uts">
	import { ensureLogin } from '@/utils/auth'
	import { fetchInterviewProfile } from '@/utils/play'
	import { fetchMessages } from '@/utils/play'
	import { showErrorToast } from '@/utils/api'

	export default {
		data() {
			return {
				profileReady: false,
				unreadCount: 0
			}
		},
		onLoad() {
			ensureLogin().then((ok: boolean) => {
				if (!ok) {
					showErrorToast(new Error('登录失败，请重试'))
					return
				}
				this.loadProfile()
				this.loadUnread()
			})
		},
		onShow() {
			// 切前台刷新未读数（消息/访谈状态可能变化）
			if (this.profileReady || this.unreadCount >= 0) {
				this.loadUnread()
			}
		},
		methods: {
			loadProfile(): void {
				fetchInterviewProfile().then((d: UTSJSONObject | null) => {
					if (d == null) {
						return
					}
					// 后端画像：{dimensions: {}, version, cold_start_done}——dimensions 是 dict
					const done = d.getBoolean('cold_start_done') ?? false
					if (done) {
						this.profileReady = true
						return
					}
					const dims = d.getJSON('dimensions')
					if (dims != null && dims.toJSONString().length > 2) {
						this.profileReady = true
					}
				})
			},
			loadUnread(): void {
				fetchMessages('unread').then((list) => {
					this.unreadCount = list.length
				})
			},
			goInterview(): void {
				uni.navigateTo({ url: '/pages/interview/interview' })
			},
			goMessages(): void {
				uni.navigateTo({ url: '/pages/messages/messages' })
			}
		}
	}
</script>


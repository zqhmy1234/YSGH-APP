<template>
	<view class="page">
		<!-- 顶部品牌区（设计稿: logo @24,16 / Beta徽标 @344,19） -->
		<view class="header-row">
			<view class="brand-logo pressable" @tap="goIndex">
				<hens-svg :src="iconLogo" :width="28" :height="11" />
			</view>
			<view class="brand-badge">
				<text class="brand-badge-text">Beta</text>
			</view>
		</view>

		<!-- 用户信息区（设计稿: 头像圆 @52,96 r=32 / 名称 @98,72 / 标语 @98,104） -->
		<view class="user-row">
			<view class="user-avatar">
				<hens-svg :src="iconAvatar" :width="22" :height="22" />
			</view>
			<view class="user-text">
				<text class="user-name">忆述</text>
				<text class="user-tagline">记录生活的美好瞬间，翻看去年今日</text>
			</view>
		</view>

		<!-- 类型入口卡（设计稿: x=20 y=152 350x78 rx=20，三列图标+文案） -->
		<view class="card card-types">
			<view class="type-col type-col-1 pressable" @tap="goType('photo')">
				<hens-svg :src="iconPhoto" :width="40" :height="22" />
				<text class="type-label">照片</text>
			</view>
			<view class="type-col type-col-2 pressable" @tap="goType('voice')">
				<hens-svg :src="iconVoice" :width="28" :height="22" />
				<text class="type-label">语音</text>
			</view>
			<view class="type-col type-col-3 pressable" @tap="goType('text')">
				<hens-svg :src="iconText" :width="28" :height="22" />
				<text class="type-label">文字</text>
			</view>
		</view>

		<!-- 菜单卡1（设计稿: x=20 y=250 350x100 rx=20，两行） -->
		<view class="card card-menu">
			<view class="menu-row pressable" @tap="goPortraitManage">
				<hens-svg :src="iconPerson" :width="16" :height="16" />
				<text class="menu-label">我的画像</text>
				<hens-svg :src="iconChevron" :width="6" :height="10" />
			</view>
			<view class="menu-row pressable" @tap="goFavorites">
				<hens-svg :src="iconBubble" :width="16" :height="16" />
				<text class="menu-label">我的收藏</text>
				<hens-svg :src="iconChevron" :width="6" :height="10" />
			</view>
		</view>

		<!-- 菜单卡2（设计稿: x=20 y=388 350x144 rx=20，三行） -->
		<view class="card card-menu card-menu-2">
			<view class="menu-row pressable" @tap="goSettings">
				<hens-svg :src="iconGear" :width="18" :height="18" />
				<text class="menu-label">设置</text>
				<hens-svg :src="iconChevron" :width="6" :height="10" />
			</view>
			<view class="menu-row pressable" @tap="goPrivacy">
				<hens-svg :src="iconDoc" :width="16" :height="16" />
				<text class="menu-label">隐私政策</text>
				<hens-svg :src="iconChevron" :width="6" :height="10" />
			</view>
			<view class="menu-row pressable" @tap="goAbout">
				<hens-svg :src="iconInfo" :width="20" :height="18" />
				<text class="menu-label">关于我们</text>
				<hens-svg :src="iconChevron" :width="6" :height="10" />
			</view>
		</view>

		<!-- 统一 TabBar 组件 -->
		<TabBar active="profile" />
	</view>
</template>


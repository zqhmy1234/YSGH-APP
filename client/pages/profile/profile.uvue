<template>
	<!-- ardot 直转 v2：我的页（帧 2:448）· 审计化生成 -->
	<view class="page-root">
		<view class="n2_452"> <!-- 头像 -->
			<text class="n2_453">峰</text> <!-- 头像字 -->
		</view>
		<text class="n2_454">峰宝</text> <!-- 昵称 -->
		<text class="n2_455">已记录 {{ statMemories }} 段回忆</text> <!-- 签名行（修复：原硬编码"128 段 · 连续 6 天"，改真数据） -->
		<view class="n2_456"> <!-- 统计卡（修复：三个数字原硬编码 128/42/23，接 GET /contents 真数据） -->
			<view class="n2_457"> <!-- 统计-回忆 -->
				<text class="n2_458">{{ statMemories }}</text> <!-- 数 -->
				<text class="n2_459">回忆</text> <!-- 名 -->
			</view>
			<view class="n2_460"> <!-- 统计-照片 -->

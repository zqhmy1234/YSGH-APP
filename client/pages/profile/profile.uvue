	// TabBar 图标（我的=激活态锈红；其余=常态灰）

	// ===== 交互 =====
	// 类型入口（照片/语音/文字）
	function goType(type: string): void {
		uni.navigateTo({ url: '/pages/search/search?type=' + type })
	}

	// 菜单：我的画像
	function goPortraitManage(): void {
		uni.navigateTo({ url: '/pages/portrait/manage' })
	}

	// 菜单：我的收藏（页面未建成，占位）
	function goFavorites(): void {
		uni.showToast({ title: '收藏功能开发中', icon: 'none' })
	}

	// 菜单：设置（settings.uvue 已存在但 pages.json 未注册该路由，暂以 toast 占位，
	// 待主 Agent 在 pages.json 注册后再恢复 uni.navigateTo）
	function goSettings(): void {
		uni.showToast({ title: '设置页待接入', icon: 'none' })
	}

	// 菜单：隐私政策
	function goPrivacy(): void {
		uni.showToast({ title: '隐私政策开发中', icon: 'none' })
	}

	// 菜单：关于我们
	function goAbout(): void {
		uni.showToast({ title: '关于页面开发中', icon: 'none' })
	}

</script>

<style>
	/* 视觉规范 v3：像素级还原 SVG 设计稿（390x844 画布）
	   背景 #f8f7f4 / 卡片 #ffffff rx=20 / 文字主 #3a2e25 次 #8a7a6a
	   图标主色（菜单） #c4913c / TabBar 图标常态 #8a7a6a 激活 #b05a3a
	   文字常态 #b3a696 激活 #b05a3a / 玻璃 TabBar rgba(246,241,231,0.75) rx=31 */
	.page {
		width: 100%;
		height: 100%;
		background-color: #f8f7f4;
		display: flex;
		flex-direction: column;
		padding: 32rpx 40rpx 0 40rpx;
		box-sizing: border-box;
		position: relative;
	}

	/* ===== 顶部品牌区 ===== */
	.header-row {
		width: 100%;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.brand-logo {
		width: 56rpx;
		height: 22rpx;
		margin-left: 10rpx;
	}
	.brand-badge {
		position: absolute;
		right: 48rpx;
		top: 38rpx;
		width: 44rpx;
		height: 22rpx;
		border-radius: 6rpx;
		background-color: #3a2e25;
		opacity: 0.8;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.brand-badge-text {
		font-size: 16rpx;
		color: #f8f7f4;
		line-height: 22rpx;
	}

	/* ===== 用户信息区 ===== */
	.user-row {
		margin-top: 74rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.user-avatar {
		width: 128rpx;
		height: 128rpx;
		border-radius: 64rpx;
		background-color: #c4913c;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.user-text {
		margin-left: 28rpx;
		display: flex;
		flex-direction: column;
	}
	.user-name {
		font-size: 42rpx;
		color: #3a2e25;
		font-weight: 600;
		line-height: 42rpx;
	}
	.user-tagline {
		margin-top: 22rpx;
		font-size: 22rpx;
		color: #8a7a6a;
		line-height: 30rpx;
		letter-spacing: 4rpx;
	}

	/* ===== 卡片通用 ===== */
	.card {
		width: 700rpx;
		background-color: #ffffff;
		border-radius: 40rpx;
		box-shadow: 0 4rpx 16rpx rgba(58, 46, 37, 0.06);
	}

	/* ===== 类型入口卡（y=152 350x78） ===== */
	.card-types {
		margin-top: 48rpx;
		height: 156rpx;
		position: relative;
	}
	.type-col {
		position: absolute;
		top: 36rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.type-col-1 {
		left: 36rpx;
		width: 80rpx;
	}
	.type-col-2 {
		left: 330rpx;
		width: 56rpx;
	}
	.type-col-3 {
		left: 606rpx;
		width: 56rpx;
	}
	.type-label {
		margin-top: 17rpx;
		font-size: 20rpx;
		color: #8a7a6a;
		line-height: 24rpx;
	}

	/* ===== 菜单卡（y=250 350x100 / y=388 350x144） ===== */
	.card-menu {
		margin-top: 40rpx;
		display: flex;
		flex-direction: column;
		padding: 12rpx 0;
	}
	.card-menu-2 {
		margin-top: 76rpx;
	}
	.menu-row {
		height: 88rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 40rpx;
		padding-right: 42rpx;
	}
	.menu-label {
		flex: 1;
		margin-left: 28rpx;
		margin-top: -6rpx;
		font-size: 28rpx;
		color: #3a2e25;
		line-height: 40rpx;
	}


	/* 按压态动画 */
	.pressable {
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
</style>

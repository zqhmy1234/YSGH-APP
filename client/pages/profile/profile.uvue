			<view class="n2_466"> <!-- 列表组1 -->
				<view class="n2_467" @tap="goInterview"> <!-- 行-记忆访谈（旧版入口在还原中丢失，对齐旧版 profile goInterview() 补回；样式复用 467 行） -->
					<image class="n2_468" src="/static/icons/i2_468.svg" /> <!-- icon: 图标（暂用画像图标） -->
					<text class="n2_472">记忆访谈</text> <!-- 文字 -->

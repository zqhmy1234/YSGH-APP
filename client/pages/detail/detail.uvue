<template>
	<view class="page">
		<!-- 滚动内容（照片区 + 标题 + 卡片 + 相关记忆一体滚动） -->
		<scroll-view class="scroll">
			<!-- ═══════════ 顶部照片区（设计稿: 390x360 照片出血，底部溶解入背景）═══════════ -->
			<view class="hero-section">
				<image class="hero-image" src="/static/hero-detail.jpg" mode="aspectFill" />
				<view class="hero-overlay-top"></view>
				<view class="hero-overlay-bottom"></view>

				<!-- 顶栏圆钮：返回 / 收藏 / 更多（设计稿: 44px 圆，中心 y=86） -->
				<view class="hero-btn btn-back pressable" @tap="goBack">
					<image src="/static/icons/detail-back.svg" :width="7" :height="12" />
				</view>
				<view class="hero-btn btn-fav pressable" @tap="toggleFav">
					<image src="/static/icons/detail-star.svg" :width="14" :height="14" />
				</view>
				<view class="hero-btn btn-more pressable" @tap="onMore">
					<view class="more-dots">
						<view class="more-dot"></view>
						<view class="more-dot"></view>
						<view class="more-dot last"></view>
					</view>
				</view>
			</view>

			<!-- 内容区 -->
			<view class="content">
				<!-- 标题 + 元信息 -->
				<text class="mem-title serif">{{ memTitle }}</text>
				<text class="mem-meta">{{ memMeta }}</text>

				<!-- 卡片 1：AI 的观察（✦ 图标 + 锈红标题；有内容才显示） -->
				<view v-if="aiNote != ''" class="card card-ai">
					<view class="ai-row">
						<image src="/static/icons/detail-sparkle.svg" :width="10" :height="10" />
						<text class="ai-label">AI 的观察</text>
					</view>
					<text class="card-body">{{ aiNote }}</text>
				</view>

				<!-- 卡片 2：照片描述（正文 + 灰色引导） -->
				<view class="card card-desc">
					<text class="card-body">{{ memBody }}</text>
					<text class="card-footer">来自照片的 AI 描述 · 你也可以补充一句</text>
				</view>

				<!-- 相关记忆（所属事件，横向滚动；无归属则隐藏） -->
				<template v-if="relatedList.length > 0">
					<text class="section-title serif">相关记忆</text>
					<scroll-view class="related-scroll" direction="horizontal">
						<view class="related-row">
							<view
								v-for="(ev, idx) in relatedList"
								:key="idx"
								class="related-card pressable"
								@tap="onRelatedEvent(ev)"
							>
								<view class="related-photo ph-a"></view>
								<text class="related-title">{{ ev.title }}</text>
								<text class="related-sub">{{ ev.photoCount }} 条记忆</text>
							</view>
						</view>
					</scroll-view>
				</template>
			</view>
		</scroll-view>

		<!-- ═══════════ 底部悬浮操作栏（设计稿: 350x60 rx=30，距底 40px，玻璃质感）═══════════ -->
		<view class="action-bar">
			<view class="action-item action-1 pressable" @tap="askAI">
				<image src="/static/icons/detail-bubble.svg" :width="30" :height="30" />
				<text class="action-label">问 AI</text>
			</view>
			<view class="action-item action-2 pressable" @tap="addCapsule">
				<image src="/static/icons/detail-capsule.svg" :width="30" :height="30" />
				<text class="action-label">加入胶囊</text>
			</view>
			<view class="action-item action-3 pressable" @tap="share">
				<image src="/static/icons/detail-share.svg" :width="26" :height="28" />
				<text class="action-label">分享</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { fetchContentDetail, fetchContentEvents, ContentEventRef } from '@/utils/event_ops'
	import { formatIsoShortTime } from '@/utils/time'

	// ═══════════ 响应式状态 ═══════════
	let fav = ref(false) // 收藏状态
	let contentId = ref('')
	let memTitle = ref('记忆详情')
	let memMeta = ref('')
	let memBody = ref('')
	let aiNote = ref('') // AI 观察（后端暂无来源，默认空→隐藏）
	let relatedList = ref<Array<ContentEventRef>>([])

	/** 取正文首句/前 14 字作标题 */
	function makeTitle(text: string): string {
		const t = text.trim()
		if (t == '') {
			return '记忆详情'
		}
		let end = t.length
		const marks = ['。', '！', '？', '，', '.', '!', '?', ',']
		for (let i = 0; i < marks.length; i++) {
			const k = t.indexOf(marks[i])
			if (k >= 0 && k < end) {
				end = k
			}
		}
		let head = end > 0 ? t.substring(0, end) : t
		if (head.length > 14) {
			head = head.substring(0, 14) + '…'
		}
		return head == '' ? '记忆详情' : head
	}

	onLoad((options: OnLoadOptions) => {
		const id = options['contentId'] as string
		if (id == null || id == '') {
			return
		}
		contentId.value = id
		fetchContentDetail(id).then((d) => {
			if (d == null) {
				return
			}
			memBody.value = d.text
			memTitle.value = makeTitle(d.text)
			let meta = ''
			if (d.takenAt != '') {
				meta = formatIsoShortTime(d.takenAt)
			}
			if (d.place != '') {
				meta = meta + (meta != '' ? ' · ' : '') + d.place
			}
			memMeta.value = meta
		})
		fetchContentEvents(id).then((evs: Array<ContentEventRef>) => {
			relatedList.value = evs
		})
	})

	// ═══════════ 交互 ═══════════
	function goBack(): void {
		uni.navigateBack({ delta: 1 })
	}

	function toggleFav(): void {
		fav.value = !fav.value
		uni.showToast({ title: fav.value ? '已收藏' : '已取消收藏', icon: 'none', duration: 1500 })
	}

	// 更多：编辑 / 删除 / 分享
	function onMore(): void {
		uni.showActionSheet({
			itemList: ['编辑记忆', '删除记忆', '分享'],
			success: (res) => {
				const idx = res.tapIndex
				if (idx === 0) {
					uni.showToast({ title: '编辑功能待接入', icon: 'none' })
				} else if (idx === 1) {
					uni.showModal({
						title: '删除记忆',
						content: '删除后不可恢复，确定删除这条记忆吗？',
						success: (r) => {
							if (r.confirm) {
								uni.showToast({ title: '已删除', icon: 'success' })
							}
						}
					})
				} else {
					share()
				}
			}
		})
	}

	// 底部操作栏
	function askAI(): void {
		uni.showToast({ title: 'AI 对话待接入', icon: 'none' })
	}
	function addCapsule(): void {
		uni.showToast({ title: '已加入胶囊', icon: 'none' })
	}
	function share(): void {
		uni.showToast({ title: '分享功能待接入', icon: 'none' })
	}

	// 相关记忆卡片：点击所属事件（事件详情页未建，暂提示）
	function onRelatedEvent(ev: ContentEventRef): void {
		uni.showToast({ title: ev.title, icon: 'none' })
	}
</script>

<style>
	/* 视觉规范 v3：像素级还原 SVG 设计稿（390x1100 画布）
	   背景 #f8f7f4 / 卡片 #ffffff rx=20 / 文字主 #3a2e25 次 #8a7a6a / 正文 #5a4c40
	   标题/区块 serif / 图标主色（锈红） #b05a3a / 引导文字 #b3a696
	   顶部出血图 /static/hero-detail.jpg（设计稿原图压缩） */
	.page {
		width: 100%;
		height: 100%;
		background-color: #f8f7f4;
		display: flex;
		flex-direction: column;

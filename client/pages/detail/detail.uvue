<template>
	<!-- ardot 直转 v2：记忆详情页（帧 4:404）· 审计化生成 -->
	<view class="page-root tk-root">
		<!-- W9 流式重构：一页一个滚动根 —— page-root 锁视口，内容区进 scroll-view，
		     玻璃操作条在滚动区外 absolute bottom 钉死视口底部（峰宝拍板：操作条固定不滑动） -->
		<!-- §O P5（峰宝拍板）：玻璃顶栏移出滚动区钉死视口顶——page-root 锁视口，absolute 相对其定位
		     不随内容滚动；原先写在 scroll-view 内随下滑移动。同层绘制顺序在 scroll-view 之前，
		     故补 z-index 保险浮于 hero 之上 -->
		<view class="n4_409"> <!-- 玻璃顶栏 -->
			<view class="n4_410" @tap="goBack"> <!-- 返回钮 -->
				<image class="n4_411" src="/static/icons/i4_411.svg" /> <!-- icon: 返回图标 -->
			</view>
			<view class="n4_413"> <!-- 右侧钮组 -->
				<view class="n4_414" @tap="toggleFav"> <!-- 收藏钮（§O P3：星标绑定收藏态，收藏→琥珀亮星） -->
					<image class="n4_415" :src="fav ? '/static/icons/i4_415-active.svg' : '/static/icons/i4_415.svg'" />
				</view>
				<view class="n4_417" @tap="onMore"> <!-- 更多钮 -->
					<image class="n4_418" src="/static/icons/i4_418.svg" /> <!-- icon: 更多图标 -->
				</view>
			</view>
		</view>
		<scroll-view class="detail-scroll" direction="vertical" :show-scrollbar="false">
		<view class="detail-body">
		<!-- ═══ D-1（2026-10-25 · task-20）**假图修复** ═══
		     原来这里无条件渲染 `<image :src="heroSrc" @tap="onToggleHero">`，而 `heroSrc` 初值是
		     `/static/images/img4_406.png`（一张真实的芦苇湖景照 780×720）。但 `loadDetail` 里只有
		     `contentType == 'photo'` 才换成真图（见该函数）⇒ **文字 / 语音记忆永远显示这张风景照**：
		       · 用户会以为"这是我自己拍的照片"（它长得像真照片，不像占位图）；
		       · 且 `<image>` 上挂着 `@tap="onToggleHero"`，而该函数在 `heroOrigUrl==''` 时直接
		         return ⇒ **点这块 692rpx 大图毫无反应**（假内容 + 死点击区双重问题）。
		     修法：`v-if="heroHasImage"` —— 只有真的拿到照片 URL 才渲染 hero。
		     ⚠️ 关键连带（**踩过就难查**）：hero / 两道渐变遮罩 / 标题 / 元信息**全部是绝对定位**，
		     而 `.n4_flow` 用 `margin-top: 861.5rpx` 给它们预留空间。所以 hero 不渲染时**必须同时**
		     ① 不渲染 4 个渐变层（它们是 hero 的装饰），② 把标题/元信息改回普通流、③ `n4_flow`
		     的 margin-top 归零 —— 否则会留下 861rpx 的**空白洞**（比假图更难看）。
		     故下面标题/元信息与 `n4_flow` 都按 `heroHasImage` 二分：有图=画布原样（绝对定位 + 861.5
		     预留）；无图=普通流（紧凑排版，语音态即设计稿 F5a 的"无 hero"形态）。 -->
		<image v-if="heroHasImage" class="n4_406" :src="heroSrc" mode="aspectFill" @tap="onToggleHero" @error="onHeroError" />
		<!-- 画布 4:407 顶部暗化（#1A140F 0.45→0.15→0 三停靠）+ 4:408 底部溶解（#F8F7F4 0→0.6→1）：
		     此前被转换器整层删除（审查报告点名）。uvue 渐变仅 2 色标，按中点拆两段精确还原（非降级）。
		     ⚠️ 这四层是 **hero 的装饰**（给文字压暗底/与纸色衔接）⇒ 无 hero 时必须一起消失。 -->
		<view v-if="heroHasImage" class="n4_407a"></view>
		<view v-if="heroHasImage" class="n4_407b"></view>
		<view v-if="heroHasImage" class="n4_408a"></view>
		<view v-if="heroHasImage" class="n4_408b"></view>
		<text class="n4_422" :class="heroHasImage ? '' : 'n4_422-flow'">{{ memTitle }}</text> <!-- 详情标题（动态） -->
		<text class="n4_423" :class="heroHasImage ? '' : 'n4_423-flow'">{{ memMeta }}</text> <!-- 详情元信息（动态） -->
		<!-- D-2（2026-10-25 · task-20）：**loading 态**。
		     此前全文搜 `skeleton|loading` = 0 命中 ⇒ 慢网下用户先看到"记忆详情 / 空正文 /
		     一颗未收藏的星"，以为内容丢了。现在 loading 期间用三行骨架占位（不显示任何
		     假标题/假正文），数据回来再整体换成真内容。
		     ⚠️ 失败态**不动**：`loadDetail` 里 `d == null` 已走 showModal + 重试（那条是对的）。 -->
		<view v-if="loading" class="n4-skel">
			<view class="n4-skel-line n4-skel-title"></view>
			<view class="n4-skel-line n4-skel-meta"></view>
			<view class="n4-skel-card">
				<view class="n4-skel-line n4-skel-body"></view>
				<view class="n4-skel-line n4-skel-body n4-skel-body2"></view>
			</view>
		</view>
		<!-- D4 流式重构（2026-09-09 峰宝拍板「改流式布局」）：元信息以下全部进普通流容器。
		     病根=全页绝对定位硬编码 top：画布卡片 top-to-top 间距（273.1/292.3）含 mock 文案撑出的
		     卡高，真实文案变短/区块 v-if 隐藏 → 空洞（峰宝实证：AI 描述离元信息太远）。
		     画布真值换算：卡间距统一 23.1rpx(12pt)（vcard→AI=211.6-188.5✓ AI→正文=273.1-250✓），
		     节标签前 46.2rpx(24pt) 大节距。附带根治：语音播放态进度行 v-if 出现时不再与下方钉死元素重叠。
		     ⚠️ D-1 连带：`n4_flow` 的 `margin-top: 861.5rpx` 是**为绝对定位的 hero+标题+元信息预留**的。
		     无 hero 时（文字/语音记忆）这些兄弟都已回到普通流 ⇒ margin-top 必须归零，
		     否则标题下方凭空出现 861rpx 空白。故按 `heroHasImage` 二分加 `n4_flow-nohero`。 -->
		<view class="n4_flow" :class="heroHasImage ? '' : 'n4_flow-nohero'">
			<view v-if="isVoice" class="n4_vcard" @tap="onPlayVoice">
			<view class="n4_vbtn" :class="{ 'n4_vbtn-disabled': !voicePlayable }">
				<!-- 2026-10-16（RC-F）：播放钮暂停态改读预计算属性（mainActive && mainPlaying），零函数调用 -->
				<view v-if="mainActive && mainPlaying" class="n4_vbtn-pause">
					<view class="n4_vbtn-pause-bar"></view>
					<view class="n4_vbtn-pause-bar"></view>
				</view>
				<view v-else class="n4_vbtn-play"></view>
			</view>
			<view class="n4_vcol">
				<text v-if="voiceNote != ''" class="n4_vnote">{{ voiceNote }}</text>
				<view class="n4_vwave">
					<!-- 2026-10-16（RC-F）：播放态改读**预计算属性**（mainActive/mainProgress/mainCurText/
					     mainTotalText），模板零函数调用（原 voiceIsActive()/voiceProgressOfCard()/
					     voiceCurSecText()/voiceTotalSecText() 每次 tick 全页重算）。waveform 仍走
					     `wf.waveformOf`——与 TabSearch 先例一致，只在波形落表时 version++，非 tick 热点。 -->
					<VoiceWave :heights="detailWave" :waveform="wf.waveformOf(contentId)" :active="mainActive" :progress="mainProgress" idle-color="#E5DCC8" played-color="#C4913C" />
				</view>
				<view v-if="mainActive" class="n4_vprog">
					<text class="n4_vprog-cur">{{ mainCurText }}</text>
					<view class="n4_vtrack">
						<!-- 2026-10-16（RC-F）：进度填充 `width:%`→`transform:scaleX()`（合成层，免每 tick 重排） -->
						<view class="n4_vtrack-fill" :style="'transform:scaleX(' + mainProgress + ');transform-origin:left;'"></view>
					</view>
					<text class="n4_vprog-total">{{ mainTotalText }}</text>
				</view>
				<text v-if="mainActive && mainPlaying" class="n4_vtitle-playing">正在播放 · {{ memTitle }}</text>
				<text v-else class="n4_vtitle">{{ memTitle }}</text>
			</view>
		</view>
		<view v-if="aiNote != '' || tagList.length > 0" class="n4_424"> <!-- AI注释卡（描述或标签任一存在才显示；FE1 数据源 tags_json/ai_description，null=不显示区块）；D4 流式：语音态被 vcard 自然推下（画布同位 1073.1=vcard 底，margin 0 即还原） -->
			<view class="n4_425"> <!-- 注释头 -->
				<image class="n4_426" src="/static/icons/i4_426.svg" /> <!-- icon: 星芒 -->
				<text class="n4_428">AI 的观察</text> <!-- AI观察 -->
			</view>
			<text v-if="aiNote != ''" class="n4_429">{{ aiNote }}</text> <!-- 注释文字（动态；照片 AI 描述，null 不显示） -->
			<!-- FE1：AI 打标 chips（tags_json，异步打标可能 null → 空数组整行隐藏） -->
			<view v-if="tagList.length > 0" class="n4-tag-row">
				<view v-for="(tg, ti) in tagList" :key="ti" class="n4-tag">
					<text class="n4-tag-text">{{ tg }}</text>
				</view>
			</view>
		</view>
		<view class="n4_430"> <!-- 正文卡（D4 流式：margin 23.1 接力 AI 卡，语音态被上方区块自然推下） -->
			<text class="n4_431">{{ memBody }}</text> <!-- 正文（动态） -->
			<!-- 卡19 接线：来源行「你也可以补充一句」可点 → 弹输入补一句（本地暂存，见 onEditSup） -->
			<text v-if="bodySup != ''" class="n4_431-sup">{{ bodySup }}</text>
			<!-- D-4（2026-10-25 · task-20）：**「补充一句」要有可点线索**。
			     原来它是一个裸 `<text class="n4_432" @tap="onEditSup">`，文案「来自照片的 AI 描述 ·
			     你也可以补充一句」，长得和普通说明文字完全一样（无下划线/箭头/按钮底）
			     ⇒ 用户不知道这行能点，"补充一句"这个能力等于藏着。
			     ⚠️ 首选方案 `text-decoration: underline` **实测在 uni-app x 不支持**：
			        编译器报 `WARNING: text-decoration is not a standard property name
			        (may not be supported)`（本机 5.26，两条）。故改用**容器级**方案 ——
			        外套一个带浅底 + 圆角的 pill，视觉上明确"这是可点的条"，
			        且这种写法与页内 `.n4_435`（相关记忆卡）同族，不新造视觉语言。 -->
			<view class="n4-sup-pill pressable" @tap="onEditSup">
				<text class="n4_432">{{ bodySource }}</text>
				<text class="n4-sup-arrow">›</text>
			</view>
		</view>
		<!-- 相关记忆（HEAD 版交互接回：无归属事件整区隐藏；画布静态2卡→数据驱动横滑，画布4:434本即横滑容器） -->
		<template v-if="relatedList.length > 0">
			<text class="n4_433">相关记忆</text> <!-- 相关记忆节标（D4 流式：margin 46.2 大节距） -->
			<scroll-view class="n4_434" direction="horizontal" :show-scrollbar="false">
				<view class="n4_434-row">
					<view v-for="(ev, idx) in relatedList" :key="idx" class="n4_435" @tap="onRelatedEvent(ev)">
						<!-- 缩略占位：画布两卡分别苔琥珀/青蓝渐变，按 idx 交替 -->
						<view class="n4_442" :class="{ 'n4_442-b': idx % 2 === 1 }"></view>
						<text class="n4_436">{{ ev.title }}</text>
						<text class="n4_437">{{ ev.photoCount }} 条记忆</text>
					</view>
				</view>
			</scroll-view>
		</template>
		<!-- R9 批次4（Q3 拍板）：事件级语音卡「这条记忆里的声音」——当前内容所属第一个事件内的
		     其他 voice 成员（排除自身）。播放复用全局引擎；processing/failed 禁播+小字（Q2 拍板）。
		     生日歌案例：photo 详情无语音大卡，但 ST-DBSCAN 把跑步语音聚进了同事件 → 在此回放 -->
		<template v-if="eventVoices.length > 0">
			<text class="n4_evt-title">这条记忆里的声音</text>
			<view v-for="(v, vi) in eventVoices" :key="vi" class="n4_evt-card"
				@tap="onPlayEventVoice(v)">
				<view class="n4_vbtn" :class="{ 'n4_vbtn-disabled': v.status != 'done' }">
					<view v-if="v.active && v.playing" class="n4_vbtn-pause">
						<view class="n4_vbtn-pause-bar"></view>
						<view class="n4_vbtn-pause-bar"></view>
					</view>
					<view v-else class="n4_vbtn-play"></view>
				</view>
				<view class="n4_evt-col">
					<text v-if="v.status != 'done'" class="n4_vnote">{{ v.status == 'failed' ? '这段语音转写失败，暂不可播放' : '转写处理中，稍后可播放' }}</text>
					<view class="n4_evt-wave">
						<!-- 2026-10-16（RC-F）：波形高度/标题在组装期预计算进 `v.wave`/`v.title`；播放态读
						     `v.active`/`v.playing`/`v.progress`（syncVoiceState 相等守卫写入）——模板零函数调用 -->
						<VoiceWave :heights="v.wave" :waveform="wf.waveformOf(v.contentId)" :active="v.active" :progress="v.progress" idle-color="#E5DCC8" played-color="#C4913C" />
					</view>
					<text class="n4_evt-name">{{ v.title }}</text>
				</view>
			</view>
		</template>
		</view> <!-- /n4_flow（D4 流式容器闭合） -->
		</view>
		</scroll-view>
		<view class="n4_441"> <!-- 玻璃操作条（滚动区外，钉死视口底部） -->
			<view class="n4_444" @tap="askAI"> <!-- 操作-问AI -->
				<image class="n4_445" src="/static/icons/i4_445.svg" /> <!-- icon: 图标 -->
				<text class="n4_447">问 AI</text> <!-- 文字 -->
			</view>
			<view class="n4_448" @tap="addCapsule"> <!-- 操作-胶囊 -->
				<image class="n4_449" src="/static/icons/i4_449.svg" /> <!-- icon: 图标 -->
				<text class="n4_452">加入胶囊</text> <!-- 文字 -->
			</view>
			<view class="n4_453" @tap="share"> <!-- 操作-分享 -->
				<image class="n4_454" src="/static/icons/i4_454.svg" /> <!-- icon: 图标 -->
				<text class="n4_457">分享</text> <!-- 文字 -->
			</view>
		</view>
		<!-- 画布 4:458/4:459（假状态栏时间+电池）已移除：navigationStyle:custom 沉浸式，
		     系统状态栏渲染真实时间与电量；该文本为白色，叠在 4:406 全幅媒体上会形成双时钟 -->
		<!-- 卡21/卡22 F7 弹层（浮层铁律 1 同族：唤起不跳页，v-if 卸载复位） -->
		<ShareSheet v-if="shareOpen" :title="memTitle" :hero="heroSrc" @close="shareOpen = false" />
		<CapsuleSheet v-if="capsuleOpen" :summary="memTitle" :contentId="contentId" @close="capsuleOpen = false" />
	</view>
</template>

<script setup lang="uts">
	import { ref, watch } from 'vue'

	import { WaveformCache } from '@/composables/useWaveform'
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { fetchContentDetail, fetchContentEvents, fetchEventItems, ContentEventRef, SplitItem } from '@/utils/event_ops'
	import { favoriteGet, favoriteAdd, favoriteRemove } from '@/utils/play_favorite'
import { deleteContent } from '@/utils/play_trash'
import { fetchContentAiMeta, ContentAiMeta, updateContentRemark } from '@/utils/play_content'
	// B12：离线判定（play_* 侧离线失败已入队，此处据同一判据改口，避免报"失败"而其实已排队）
	// 🚨 2026-10-11 静态审查修复：原用 `getNetKind()`（回调式、返回 void）做同步判断 ⇒
	// `void == 'none'` 恒假，改口分支永不进入（用户仍看到"失败"而操作其实已排队）。
	// 改用同步缓存读 `currentNetKind()`（见 uploader_net 注释）。
	import { currentNetKind } from '@/utils/uploader_net'
	import { formatIsoShortTime } from '@/utils/time'
	import { backToShell } from '@/utils/shell_state'
	import {
		toggleVoice,
		stopVoice,
		voiceCurrentId,
		voicePlaying,
		voiceProgress,
		voiceCurSec,
		voiceTotalSec,
		fmtVoiceTime,
		genWaveHeights
	} from '@/utils/audio_player'

	// ═══════════ 响应式状态 ═══════════
	let fav = ref(false) // 收藏状态
	// 卡21/卡22 F7 弹层开关（浮层铁律：唤起不跳页）
	let shareOpen = ref(false)
	let capsuleOpen = ref(false)
	let contentId = ref('')
	let memTitle = ref('记忆详情')
	let memMeta = ref('')
	let memBody = ref('')
	let aiNote = ref('') // AI 的观察（照片记忆 = 后端 ai_description；空→整卡隐藏）
	// D-2（2026-10-25 · task-20）：**加载态**。此前本页没有任何 loading 表达 ⇒ 慢网下用户先看到
	// "记忆详情 / 空正文 / 未收藏星标"，以为内容丢了。初值 true，`loadDetail` 两条出口都置 false
	// （成功 / 失败弹窗后），保证不会永久挂在骨架屏上。
	let loading = ref(true)
	// D-1（2026-10-25 · task-20）：**hero 是否有真图**。`false` ⇒ 不渲染 hero（文字/语音记忆）。
	// 旧实现用 `heroSrc` 初值兜底到 `/static/images/img4_406.png`（真实风景照）⇒ 文字/语音记忆
	// 永远显示一张"别人的照片"，且那层 `<image>` 挂了 `@tap` 但函数空返回 = 死点击区。
	// 现在只有 `contentType == 'photo'` 且真拿到 URL 才置 true。
	let heroHasImage = ref(false)
	// 全幅媒体源：photo 记忆详情加载成功后换成服务端票据 URL（缩略图优先，无则原图）
	// ⚠️ D-1：**初值置空串**（不再兜底到 img4_406.png）——那是假图的数据源，兜底等于没修。
	// 空串时模板不会渲染（被 `v-if="heroHasImage"` 挡在外面），故不会出现裂图。
	let heroSrc = ref('')
	// 2026-10-16：hero 原图↔缩略图切换态（仅 photo 有值；originalUrl 由 ContentDetail 取回在手，零契约改动）
	let heroThumbUrl = ref('') // 缩略图源（本地临时文件或票据 URL）
	let heroOrigUrl = ref('') // 原图票据 URL（15m 短时效——久看后切换有裂图风险，@error 已兜底回落）
	let heroShowOrig = ref(false)
	let relatedList = ref<Array<ContentEventRef>>([])

	/** 事件级语音卡视图模型（2026-10-16 · RC-F）：组装期预计算波形/标题，播放态由 syncVoiceState
	 *  相等守卫写入——模板只读字段、零函数调用（类声明先例：TabSearch.VoiceResult）。 */
	class EvtVoice {
		contentId: string
		status: string
		wave: Array<number>
		title: string
		active: boolean
		playing: boolean
		progress: number
		constructor(contentId: string, status: string, wave: Array<number>, title: string) {
			this.contentId = contentId
			this.status = status
			this.wave = wave
			this.title = title
			this.active = false
			this.playing = false
			this.progress = 0
		}
	}

	// R9 批次4（Q3 拍板）：事件级语音成员——「这条记忆里的声音」区块数据源
	// （当前内容所属第一个事件内的 voice 成员，排除自身）；空数组=区块隐藏
	// 2026-10-16（RC-F）：由 `SplitItem` 裸数组改为本页私有视图模型 `EvtVoice`——SplitItem 是
	// utils 契约（不在本批改动边界内），用本页私有类承载波形/标题/播放态视图字段。
	let eventVoices = ref<Array<EvtVoice>>([])
	// W0-2 · F5b：语音记忆才显示语音卡；波形由 contentId 确定性生成（与 index/search 同源 genWaveHeights）
	let isVoice = ref(false)
	let detailWave = ref<Array<number>>([])
	// 2026-10-16（RC-F）：主语音卡播放态——写入时预计算（见 syncVoiceState），模板只读（零函数调用）
	let mainActive = ref(false)
	let mainPlaying = ref(false)
	let mainProgress = ref(0)
	let mainCurText = ref('')
	let mainTotalText = ref('')

	// B5.2f：波形缓存收敛为共享组合式函数（唯一实现 client/composables/useWaveform.uts）
	const wf = new WaveformCache()
	// 语音可播性状态（修 R9 崩溃单：模板/脚本曾引用未定义的 voicePlayable/voiceNote → 详情页开语音记忆即 C++ abort）
	// 语义对齐事件级语音卡文案：done=可播；failed=转写失败；其余=处理中。默认 false，详情加载成功后按 status 置位
	let voicePlayable = ref(false)
	let voiceNote = ref('')
	// 正文来源行：画布静态「来自照片的 AI 描述」对语音记忆失真，按类型切换（照片默认保持画布原文）
	let bodySource = ref('来自照片的 AI 描述 · 你也可以补充一句')
	// 卡19：来源行「你也可以补充一句」的用户补句（本地暂存，后端无 PATCH 补充端点 → 冷启动即失）
	let bodySup = ref('')
	// FE1：AI 打标 chips（tags_json，打标异步可能 null → 空数组=不显示区块）
	let tagList = ref<Array<string>>([])

	/** 取正文首句/前 14 字作标题 */
	function makeTitle(text: string): string {
		const t = text.trim()
		if (t == '') {
			return '记忆详情'
		}
		let end = t.length
		const marks = ['。', '！', '？', '，', '.', '!', '?', ',']
		for (let i = 0; i < marks.length; i++) {
			const k = t.indexOf(marks[i])
			if (k >= 0 && k < end) {
				end = k
			}
		}
		let head = end > 0 ? t.substring(0, end) : t
		if (head.length > 14) {
			head = head.substring(0, 14) + '…'
		}
		return head == '' ? '记忆详情' : head
	}

	onLoad((options: OnLoadOptions) => {
		const id = options['contentId'] as string
		if (id == null || id == '') {
			return
		}
		contentId.value = id
		// RC-F：contentId 落地后补一次播放态同步（进页时若全局正好在播本内容，主卡立即显示播放态）
		syncVoiceState()
		// FE1 真端点（W2-2）：GET /contents/{id}/favorite 查单条收藏态初始化星标；
		// 失败 false（api 层已全局 toast），不再读本地 favorite_ids（列表页回落契约不受影响）
		favoriteGet(id).then((favd: boolean) => {
			fav.value = favd
		})
		loadDetail()
		fetchContentEvents(id).then((evs: Array<ContentEventRef>) => {
			relatedList.value = evs
			// R9 批次4（Q3 拍板）：拉第一个所属事件成员，过滤 voice（排除自身）→「这条记忆里的声音」
			// 生日前歌案例：photo 详情无语音卡，但事件里聚了跑步语音——事件级声音在这里补齐
			if (evs.length > 0 && evs[0].id != '') {
				fetchEventItems(evs[0].id).then((items: Array<SplitItem>) => {
					const voices: Array<EvtVoice> = []
					for (let i = 0; i < items.length; i++) {
						if (items[i].contentType == 'voice' && items[i].contentId != id) {
							voices.push(toEvtVoice(items[i]))
						}
					}
					eventVoices.value = voices
					// BB3：事件卡区块渲染即拉各成员真实波形（区块 ≤3 卡，非列表预拉场景）
					for (let i = 0; i < voices.length; i++) {
						wf.loadWaveform(voices[i].contentId)
					}
					// RC-F：区块数据落地后补一次播放态同步（否则"进页时正在播的成员卡"不显示播放态）
					syncVoiceState()
				})
			}
		})
	})

	// ═══════════ 交互 ═══════════
	onUnload(() => {
		// W0-2：离页停播，防止语音跨页残留出声（与 index/search 同规）
		stopVoice()
	})

	// 语音播放（W0-2 · F5b：详情页语音卡复用全局播放引擎，播放态三处一致）
	function onPlayVoice(): void {
		if (!isVoice.value || contentId.value == '') {
			return
		}
		// 禁播守卫：显式 toast，绝不静默（峰宝拍板 2026-09-06）
		if (!voicePlayable.value) {
			uni.showToast({ title: voiceNote.value != '' ? voiceNote.value : '音频暂不可播放', icon: 'none' })
			return
		}
		toggleVoice(contentId.value)
	}
	// ── 播放态预计算（2026-10-16 · RC-F）──────────────────────────────────────────
	// 范式照 `TabSearch.syncActiveCard` / `TabIndex.syncVoiceCards`：**数据写入时**把全局播放态写进
	// 「正在播放那张卡」的预计算属性，模板只读字段 ⇒ 零函数调用；且**相等守卫**保证值没变不写
	// ⇒ 未变的卡零响应式通知、零重渲染。
	// 此前详情页模板每 tick 调 6 个取值函数（voiceIsActive/voiceIsPlaying/voiceProgressOfCard/
	// voiceCurSecText/voiceTotalSecText/evtWaveOf…），而 audio_player 的 33ms 时钟会写全局 ref
	// ⇒ 每次写都整页重算。现收敛为单源 watch（见文件末），tick 驱动面只剩「活动卡」。
	function applyMainVoiceState(cid: string, playing: boolean, prog: number, cur: string, total: string): void {
		const isActive = cid != '' && cid == contentId.value
		if (mainActive.value != isActive) {
			mainActive.value = isActive
		}
		if (isActive) {
			if (mainPlaying.value != playing) { mainPlaying.value = playing }
			if (mainProgress.value != prog) { mainProgress.value = prog }
			if (mainCurText.value != cur) { mainCurText.value = cur }
			if (mainTotalText.value != total) { mainTotalText.value = total }
		} else if (mainPlaying.value || mainProgress.value != 0 || mainCurText.value != '' || mainTotalText.value != '') {
			// 退出活动态：清干净（否则旧卡残留进度行/时长）
			mainPlaying.value = false
			mainProgress.value = 0
			mainCurText.value = ''
			mainTotalText.value = ''
		}
	}

	/** 事件级卡：写 active/playing/progress；返回"是否变化"（相等守卫，无变化零写入） */
	function applyEventVoiceState(v: EvtVoice, cid: string, playing: boolean, prog: number): boolean {
		const isActive = v.contentId != '' && v.contentId == cid
		let changed = false
		if (v.active != isActive) {
			v.active = isActive
			changed = true
		}
		if (isActive) {
			if (v.playing != playing) {
				v.playing = playing
				changed = true
			}
			if (v.progress != prog) {
				v.progress = prog
				changed = true
			}
		} else if (v.playing || v.progress != 0) {
			v.playing = false
			v.progress = 0
			changed = true
		}
		return changed
	}

	/** 汇总入口：主语音卡 + 事件级语音卡逐张套用；有变才 slice 重建数组引用（确定性重渲染） */
	function syncVoiceState(): void {
		const cid = voiceCurrentId.value
		const playing = voicePlaying.value
		const prog = voiceProgress.value
		const cur = fmtVoiceTime(voiceCurSec.value)
		const total = fmtVoiceTime(voiceTotalSec.value)
		applyMainVoiceState(cid, playing, prog, cur, total)
		const arr = eventVoices.value
		let changed = false
		for (let i = 0; i < arr.length; i++) {
			if (applyEventVoiceState(arr[i], cid, playing, prog)) {
				changed = true
			}
		}
		if (changed) {
			eventVoices.value = arr.slice()
		}
	}

	// 播放态源 ref（audio_player 全局单例）→ 单源 watch 逐个挂，tick 驱动面收敛到 syncVoiceState
	watch(voiceCurrentId, (): void => { syncVoiceState() })
	watch(voicePlaying, (): void => { syncVoiceState() })
	watch(voiceProgress, (): void => { syncVoiceState() })
	watch(voiceCurSec, (): void => { syncVoiceState() })
	watch(voiceTotalSec, (): void => { syncVoiceState() })

	// ═══ R9 批次4：事件级语音卡（「这条记忆里的声音」）═══
	// D4 流式重构（2026-09-09）：区块随 n4_flow 普通流排布，evtSectionTop/evtCardTop 绝对定位函数已删
	/** 成员卡播放：processing/failed 显式 toast（Q2 拍板），绝不静默；done → 全局引擎 */
	function onPlayEventVoice(v: EvtVoice): void {
		if (v.status != 'done') {
			uni.showToast({
				title: v.status == 'failed' ? '这段语音转写失败，暂不可播放' : '转写处理中，稍后可播放',
				icon: 'none'
			})
			return
		}
		toggleVoice(v.contentId)
	}
	/** SplitItem(voice) → EvtVoice：波形确定性生成（与 index/search/detail 大卡同源 genWaveHeights）、
	 *  标题转写文本截断（空文本给中性占位）——两者原是**模板函数调用**，现移到组装期预计算。 */
	function toEvtVoice(it: SplitItem): EvtVoice {
		const t = (it.title ?? '').trim()
		const title = t == '' ? '一段声音' : (t.length > 18 ? t.substring(0, 18) + '…' : t)
		return new EvtVoice(it.contentId, it.status, genWaveHeights(it.contentId, 20), title)
	}

	/** 拉取内容详情（onLoad 与失败弹层【重试】共用入口；GET 幂等，重试=重跑本函数） */
	function loadDetail(): void {
		const id = contentId.value
		if (id == '') {
			return
		}
		fetchContentDetail(id).then((d) => {
			if (d == null) {
				// D-2（task-20）：失败也必须收 loading，否则骨架屏永久挂在页面上（比"空正文"更糟）
				loading.value = false
				// 静默失败显式化（峰宝拍板 2026-09-06：任何结果不允许静默）
				// fetchContentDetail 失败可能=网络断/404 已删除/服务不可达
				// 2026-10-16：toast → showModal 带【重试】（toast 一闪而过无补救动作，用户只能干等）
				uni.showModal({
					title: '详情加载失败',
					content: '网络断开、内容已删除或服务暂不可达。可检查网络后重试。',
					confirmText: '重试',
					cancelText: '取消',
					success: (r) => {
						if (r.confirm) {
							// 重试期间重新进 loading 态（否则用户点了"重试"毫无视觉反馈）
							loading.value = true
							loadDetail()
						}
					}
				})
				return
			}
			memBody.value = d.text
			memTitle.value = makeTitle(d.text)
			// W0-2：语音记忆 → F5b 语音卡显示 + 播放引擎按 contentId 接线（audio 端点，W0-1）
			if (d.contentType == 'voice') {
				isVoice.value = true
				detailWave.value = genWaveHeights(id, 28)
				// BB3：进页即拉真实波形（详情页单条语音，非列表懒加载场景）
				wf.loadWaveform(id)
				bodySource.value = '来自语音转写的 AI 描述 · 你也可以补充一句'
				// 可播性按转写状态显式判定（禁止静默）：与事件级语音卡（v.status）同词表
				if (d.status == 'done') {
					voicePlayable.value = true
					voiceNote.value = ''
				} else if (d.status == 'failed') {
					voicePlayable.value = false
					voiceNote.value = '这段语音转写失败，暂不可播放'
				} else {
					voicePlayable.value = false
					voiceNote.value = '转写处理中，稍后可播放'
				}
			}
			// 照片记忆 → 头图换真图（缩略图 24h 时效，够详情页展示；原图 15m 太短不用于头图）
			// 原图 URL 一并留存：hero @tap 原图↔缩略图切换用（originalUrl 已在 ContentDetail 在手，零契约改动）
			// D-1（task-20）：**只有真的拿到 URL 才置 heroHasImage=true** ⇒ 文字/语音记忆不会再有 hero；
			// 连照片但两条 URL 都空（极端：票据生成失败）也走无 hero 形态，比显示假风景图诚实。
			if (d.contentType == 'photo') {
				heroThumbUrl.value = d.thumbnailUrl
				heroOrigUrl.value = d.originalUrl
				if (d.thumbnailUrl != '') {
					heroShowOrig.value = false
					heroSrc.value = d.thumbnailUrl
					heroHasImage.value = true
				} else if (d.originalUrl != '') {
					heroShowOrig.value = true
					heroSrc.value = d.originalUrl
					heroHasImage.value = true
				}
			}
			let meta = ''
			if (d.takenAt != '') {
				meta = formatIsoShortTime(d.takenAt)
			}
			if (d.place != '') {
				meta = meta + (meta != '' ? ' · ' : '') + d.place
			}
			memMeta.value = meta
			// D-2（task-20）：主体数据已落地 ⇒ 收骨架屏。放在这里（而不是 fetchContentAiMeta 之后）
			// 是因为 AI 增量字段是**次要增强**（tags/ai_description），不该拖住主内容展示。
			loading.value = false
			// FE1：AI 增量字段（tags_json/ai_description 打标异步，可能 null → 空=不显示对应区块，不造假占位）
			fetchContentAiMeta(id).then((ai: ContentAiMeta | null) => {
				if (ai == null) {
					return
				}
				tagList.value = ai.tags
				if (d.contentType == 'photo' && ai.aiDescription != '') {
					aiNote.value = ai.aiDescription
				}
			})
		})
	}

	/** hero @tap：photo 记忆原图↔缩略图切换（其余类型 originalUrl 恒空，切换不生效） */
	function onToggleHero(): void {
		if (heroOrigUrl.value == '' || heroThumbUrl.value == '') {
			return
		}
		heroShowOrig.value = !heroShowOrig.value
		heroSrc.value = heroShowOrig.value ? heroOrigUrl.value : heroThumbUrl.value
	}

	/** 原图 15m 票据过期裂图（<image> @error）→ 自动回落缩略图（24h 票据/本地临时文件，稳定） */
	function onHeroError(): void {
		if (heroShowOrig.value && heroThumbUrl.value != '') {
			heroShowOrig.value = false
			heroSrc.value = heroThumbUrl.value
		}
	}

	function goBack(): void {
		// 铁律：reLaunch/redirectTo 直入时页面栈仅 1 页，navigateBack 静默失败 → 回落首页
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/shell/shell' })
		}
	}

	function toggleFav(): void {
		// FE1（W2-2）：真端点 toggle（幂等）+ 本地 favorite_ids 双写保留（favorites 页回落契约 +
		// 离线星标即时反馈）；失败不回滚本地态，toast 显式原因（api 层全局 toast + 页内补充提示）
		fav.value = !fav.value
		const raw = uni.getStorageSync('favorite_ids') as string
		let ids: Array<string> = []
		if (raw != null && raw != '' && raw != '[]') {
			const parts = raw.split(',')
			for (let i = 0; i < parts.length; i++) {
				if (parts[i] != '') {
					ids.push(parts[i])
				}
			}
		}
		if (fav.value) {
			let exists = false
			for (let i = 0; i < ids.length; i++) {
				if (ids[i] == contentId.value) {
					exists = true
					break
				}
			}
			if (!exists) {
				ids.push(contentId.value)
			}
		} else {
			const next: Array<string> = []
			for (let i = 0; i < ids.length; i++) {
				if (ids[i] != contentId.value) {
					next.push(ids[i])
				}
			}
			ids = next
		}
		uni.setStorageSync('favorite_ids', ids.join(','))
		if (contentId.value != '') {
			if (fav.value) {
				favoriteAdd(contentId.value).then((ok: boolean) => {
					if (!ok) {
						uni.showToast({ title: '云端收藏失败 · 稍后重试', icon: 'none' })
					}
				})
			} else {
				favoriteRemove(contentId.value).then((ok: boolean) => {
					if (!ok) {
						uni.showToast({ title: '云端取消失败 · 稍后重试', icon: 'none' })
					}
				})
			}
		}
		uni.showToast({ title: fav.value ? '已收藏' : '已取消收藏', icon: 'none', duration: 1500 })
	}

	// 更多：编辑 / 删除 / 分享
	function onMore(): void {
		uni.showActionSheet({
			itemList: ['编辑记忆', '删除记忆', '分享'],
			success: (res) => {
				const idx = res.tapIndex
				if (idx === 0) {
					// B12（BB1）：「编辑记忆」语义=改正文碎片文字，后端当前仅开放 remark 单字段
					// （PATCH /contents/{id}）→ 编辑降级走备注编辑通道（与补充说明同款真保存）；
					// 正文文字修改需专用端点，不造假编辑器
					onEditSup()
				} else if (idx === 1) {
					uni.showModal({
						title: '删除记忆',
						content: '删除后将移入回收站，保留 30 天。确定删除吗？',
						success: (r) => {
							if (r.confirm) {
								// FE1（W2-1）：DELETE /api/v1/contents/{id} 软删 → 回收站 30 天保留，可恢复
								deleteContent(contentId.value).then((ok: boolean) => {
									if (!ok) {
										// B12：离线时**删除已入队**（play.ts 侧 enqueueDeleteOp），故不能报"失败"。
										// 本地墓碑 = 立即按已删处理并返回上一页（避免用户以为没删掉又点一次）；
										// 队列条数在「存储与同步」页的同步卡可见（pendingSyncCount 已上屏）。
										if (currentNetKind() == 'none') {
											uni.showToast({ title: '已离线：删除将在联网后自动完成', icon: 'none', duration: 2500 })
											setTimeout(() => {
												goBack()
											}, 900)
											return
										}
										uni.showToast({ title: '删除失败 · 请稍后重试', icon: 'none' })
										return
									}
									uni.showToast({ title: '已移入回收站', icon: 'none' })
									// 软删成功 → 详情页内容已不存在，返回上一页
									setTimeout(() => {
										goBack()
									}, 600)
								})
							}
						}
					})
				} else {
					share()
				}
			}
		})
	}

	// 底部操作栏
	function askAI(): void {
		// B1（BB1）上下文预填：当前记忆标题/正文/内容 id 以 storage 暂存（跳转传参最稳形态，
		// 对齐 favorite_ids 等字符串 storage 先例；标题可能含特殊字符不宜 url query）。
		// 参数契约（供 TabAi 消费，**读后即清**，见 TabAi.prefillDraftFrom）：
		//   yishu_ai_context_title     string  记忆标题（正文首句截断 ≤14 字，空=''）
		//   yishu_ai_context_body      string  记忆正文全文（空=''）
		//   yishu_ai_context_content_id string 内容 id（可回查详情，空=''）
		uni.setStorageSync('yishu_ai_context_title', memTitle.value)
		uni.setStorageSync('yishu_ai_context_body', memBody.value)
		uni.setStorageSync('yishu_ai_context_content_id', contentId.value)
		// 2026-10-14（台账 §4.20 批次 5 · RC-10）：原为 `uni.redirectTo('/pages/shell/shell?tab=ai')`
		// —— 那会**销毁本页并重建整个壳**（白屏 1~2s + 四个 tab 全部重挂 + TabIndex 的 60s TTL 失效）。
		// 壳本来就在栈里 ⇒ 改走**栈内回退**：先经桥请求切到 ai（壳 watch → 零销毁切 tab），再 navigateBack。
		// 预填不丢：存储三键照写，由 TabAi 在"切到本 tab"广播（shell 的 aiShownSeq）时重读。
		backToShell('ai', '')
	}
	function addCapsule(): void {
		// 卡22 接线：拉起时间胶囊弹层（浮层不跳页）；FE1 起入口为真实面板（封存端点 POST /api/v1/capsules
		// 由 CapsuleSheet 组件内部接线，非本页职责）
		capsuleOpen.value = true
	}
	function share(): void {
		// 卡21 接线：拉起分享弹层（浮层不跳页）；社交项灰显诚实化见 ShareSheet
		shareOpen.value = true
	}

	// 相关记忆卡片：卡19 接线 —— 跳该事件封面内容的详情页（事件详情页未建，不假跳不存在的页）
	function onRelatedEvent(ev: ContentEventRef): void {
		if (ev.coverContentId == '') {
			uni.showToast({ title: ev.title + ' · 暂无可打开的记忆', icon: 'none' })
			return
		}
		// detail → detail 用 redirectTo 同页替换：避免层层压栈，返回仍回来源页
		uni.redirectTo({ url: '/pages/detail/detail?contentId=' + ev.coverContentId })
	}

	// 正文来源行「你也可以补充一句」：弹输入补一句
	// B12（BB1）：接真 PATCH /contents/{id} remark——成功后才本地同步显示（response-first），
	// 失败显式 toast 不改本地态（不静默原则）
	function onEditSup(): void {
		uni.showModal({
			title: '补充一句',
			content: bodySup.value,
			editable: true,
			placeholderText: '这一刻，你还想记下什么…',
			confirmText: '记下',
			cancelText: '取消',
			success: (res: any) => {
				if (res.confirm != true) {
					return
				}
				if (res.content == null) {
					return
				}
				const v = res.content as string
				if (v == '') {
					return
				}
				if (contentId.value == '') {
					uni.showToast({ title: '内容未加载，无法保存', icon: 'none' })
					return
				}
				updateContentRemark(contentId.value, v).then((ok: boolean) => {
					if (!ok) {
						// B12：离线时**备注已入队**（play.ts 侧 enqueueFieldOp），故不报"保存失败"；
						// 本地态保持旧值不变（本函数一贯 response-first：成功才改本地显示），
						// 联网后由同步链补发，队列条数在同步卡可见。
						if (currentNetKind() == 'none') {
							uni.showToast({ title: '已离线：备注将在联网后同步', icon: 'none', duration: 2500 })
							return
						}
						uni.showToast({ title: '云端保存失败 · 请稍后重试', icon: 'none' })
						return
					}
					bodySup.value = v
					uni.showToast({ title: '已记在这条记忆里', icon: 'success' })
				})
			}
		})
	}
</script>

<style>
	@import '@/styles/detail.css';
</style>

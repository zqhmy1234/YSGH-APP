	}
	.related-sub {
		display: flex;
		margin-top: 6rpx;
		font-size: 20rpx;
		line-height: 28rpx;
		color: #8a7a6a;
	}

	/* ═══════════ 底部悬浮操作栏（设计稿: 350x60 rx=30 玻璃，阴影 dy=10 blur=14 @10%）═══════════ */
	.action-bar {
		position: fixed;
		left: 40rpx;
		right: 40rpx;
		bottom: 80rpx;
		height: 120rpx;
		border-radius: 60rpx;
		background-color: rgba(255, 255, 255, 0.72);
		border: 2rpx solid rgba(255, 255, 255, 0.60);
		box-shadow: 0 20rpx 28rpx rgba(58, 45, 38, 0.10);

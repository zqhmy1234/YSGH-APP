		line-height: 44rpx;
		font-weight: bold;
		color: #3a2e25;
	}

	/* 相关记忆横向滚动 */
	.related-scroll {
		width: 100%;
		margin-top: 28rpx;
	}
	.related-row {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
	}
	.related-card {
		width: 300rpx;
		height: 244rpx;
		flex-shrink: 0;
		background-color: #ffffff;
		border-radius: 32rpx;
		padding: 16rpx;
		box-sizing: border-box;
		box-shadow: 0 6rpx 10rpx rgba(58, 45, 38, 0.06);
		margin-right: 24rpx;
	}
	.related-photo {
		width: 100%;
		height: 160rpx;
		border-radius: 20rpx;
	}
	/* 卡片 A 渐变占位（设计稿 gradient_2: #798B5A 30%→#C4913B 20%） */
	.ph-a {
		background: linear-gradient(to right, rgba(121, 139, 90, 0.30), rgba(196, 145, 59, 0.20));
	}
	/* 卡片 B 渐变占位（设计稿 gradient_4: #4E7C8B 28%→#798B5A 15%） */

		justify-content: center;
		box-shadow: 0 4rpx 12rpx rgba(25, 20, 15, 0.12);
		z-index: 5;
	}
	.btn-back { left: 32rpx; }
	.btn-fav { left: 531rpx; }
	.btn-more { left: 635rpx; }

	/* 更多按钮三点（设计稿: 3 个 r=1.2 白点，间距 5.25px） */
	.more-dots {
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.more-dot {
		width: 4.6rpx;
		height: 4.6rpx;
		border-radius: 2.3rpx;
		background-color: #ffffff;
		margin-right: 10rpx;
	}
	.more-dot.last {
		margin-right: 0;
	}

	/* ═══════════ 内容区 ═══════════ */
	.content {
		width: 100%;
		padding: 34rpx 40rpx 240rpx 40rpx;
		box-sizing: border-box;
	}

	/* 主标题（设计稿: 28px serif 加粗 #3A2E25，y=376.7） */
	.mem-title {

		background: linear-gradient(to right, rgba(248, 247, 244, 0) 0%, rgba(248, 247, 244, 0.6) 50%, #f8f7f4 100%);
	}

	/* 顶栏圆钮（设计稿: 44px 半透明白玻璃圆，中心 y=86 距顶 64px） */
	.hero-btn {
		position: absolute;
		top: 128rpx;
		width: 88rpx;
		height: 88rpx;
		border-radius: 44rpx;
		background-color: rgba(59, 46, 38, 0.30);
		border: 2rpx solid rgba(255, 255, 255, 0.40);

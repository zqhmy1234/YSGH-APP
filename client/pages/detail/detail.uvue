	}

	/* 通用卡片（设计稿: 350 宽 rx=20 白底，阴影 dy=4 blur=8 @6%） */
	.card {
		width: 100%;
		min-height: 200rpx;
		background-color: #ffffff;
		border-radius: 40rpx;
		padding: 34rpx 40rpx 36rpx 40rpx;

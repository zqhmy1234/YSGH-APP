	}

	/* 回响卡片（T-PL-1：去年今日 · 角贴 + 泛黄） */
	.echo-card {
		margin-top: 24rpx;
		background-color: #F1E8D8;
		border-radius: 8rpx;
		padding: 28rpx;
		box-shadow: 0 6rpx 16rpx rgba(58, 46, 37, 0.12);

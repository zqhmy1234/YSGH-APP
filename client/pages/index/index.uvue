		font-size: 36rpx;
		color: #8a7a6a;
		font-weight: bold;
	}

	/* 回响卡片（去年今日 · 角贴 + 泛黄） */
	.echo-card {
		background-color: #faf6ee;
		border-radius: 24rpx;
		padding: 32rpx;
		margin: 24rpx 40rpx;
		position: relative;
		box-shadow: 0 4rpx 16rpx rgba(58,46,37,0.08);
	}
	.echo-corner {
		position: absolute;
		/* absolute-ok: echo 卡右上角标（卡内锚点） */
		top: -4rpx;
		right: 32rpx;
		background-color: #c4913c;
		padding: 8rpx 20rpx;
		border-radius: 0 0 12rpx 12rpx;
	}
	.echo-corner-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 20rpx;
		color: #ffffff;
		font-weight: 500;
	}
	.echo-date {

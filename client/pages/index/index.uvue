	/* 按压态动画（scale 0.98 + 阴影收缩 200ms） */
	.pressable {
		font-family: "Sarasa Gothic SC", sans-serif;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	

	/* 拆分面板 */
	.split-panel {
		position: fixed;

		padding-left: 28rpx;
		padding-right: 28rpx;
		padding-top: 8rpx;
		padding-bottom: 8rpx;
		border-bottom-left-radius: 12rpx;
	}
	.echo-corner-text {
		color: #F6F1E7;
		font-size: 22rpx;
		font-weight: bold;
	}
	.echo-date {
		font-size: 22rpx;
		color: #b3a696;
	}
	.echo-text {
		margin-top: 12rpx;
		font-size: 30rpx;
		color: #3A2E25;
		line-height: 44rpx;
	}
	.echo-meta {
		margin-top: 12rpx;
		display: flex;
		flex-direction: row;
	}
	.echo-actions {
		margin-top: 20rpx;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
	}
	.echo-dismiss {
		padding-left: 32rpx;
		padding-right: 32rpx;
		padding-top: 10rpx;
		padding-bottom: 10rpx;
		border-width: 1rpx;
		border-color: rgba(176, 90, 58, 0.6);
		border-radius: 24rpx;
	}

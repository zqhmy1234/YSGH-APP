		position: absolute;
		/* absolute-ok: hero 照片说明（画布锚点，静态） */
		left: 38.5rpx;
		top: 238.5rpx;
		width: 434.6rpx;
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 25rpx;

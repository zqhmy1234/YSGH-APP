<template>
	<view class="page">
		<!-- 顶栏：干净，不做旧（视觉规范：导航/按钮保持干净） -->
		<view class="header">
			<text class="header-title serif">忆述光华</text>
			<text class="header-sub">翻看记忆，去年今日</text>
		</view>

		<!-- 同步状态横幅（B4 客户端：Wave3 AgentH 组件，集成 Agent 接线一行） -->
		<UploadStatusBanner />

		<scroll-view class="scroll" scroll-y refresher-enabled :refresher-triggered="refreshing" @refresherrefresh="onRefresh">
			<!-- 回响卡片（T-PL-1：去年今日 · 角贴 + 泛黄；划掉 dismiss） -->
			<view v-if="echo != null" class="echo-card">
				<view class="echo-corner">
					<text class="echo-corner-text">去年今日</text>
				</view>
				<text class="echo-date muted">{{ echo.echoDate }}</text>
				<text class="echo-text serif">{{ echo.text }}</text>
				<view v-if="echo.place != ''" class="echo-meta">
					<text class="meta-item">{{ echo.place }}</text>
				</view>
				<view class="echo-actions">
					<view class="echo-dismiss" @tap="dismissEchoCard">
						<text class="echo-dismiss-text">划掉</text>
					</view>
				</view>
			</view>

			<!-- 加载中 -->
			<view v-if="!loaded" class="center-box">
				<text class="muted">正在翻找相纸…</text>
			</view>

			<!-- 空状态：空白相纸插画 + 文案 + 引导（B-F8-3） -->
			<view v-else-if="days.length === 0 && pendingEvents.length === 0" class="center-box">
				<image class="empty-img" src="/static/empty-photo.svg" mode="aspectFit" />
				<text class="empty-title serif">相册还空着</text>
				<text class="empty-desc">授权相册后，照片会自动整理成一天的记忆卡片</text>
				<view class="cta" @tap="onGrantAndStart">
					<text class="cta-text">授权相册 · 开始整理</text>
				</view>
			</view>

			<!-- 时间轴：L1 日卡片 + L2 主题两级 + L2 待确认区（B-F8-1 · B3-5） -->
			<view v-else class="feed">
				<!-- L2 待确认区（B3-5：confidence<0.7 的 draft 独立分组；确认/忽略） -->
				<view v-if="pendingEvents.length > 0" class="pending-block">
					<text class="day-title serif">待确认</text>
					<text class="pending-sub muted">这些主题还不确定，确认后不会再被算法改动</text>
					<view v-for="ev in pendingEvents" :key="ev.id" class="card card-l2">
						<view v-if="ev.coverPath != ''" class="cover-wrap">
							<image class="cover-img" :src="ev.coverPath" mode="aspectFill" />
						</view>
						<text class="card-title serif title-l2">{{ ev.title }}</text>
						<view class="card-meta">
							<text class="meta-item">{{ levelText(ev.level) }}</text>
							<text class="meta-item rust">{{ ev.photoCount }} 张照片</text>
						</view>
						<view v-if="ev.photoIds.length > 0" class="photo-strip">
							<image v-for="cid in ev.photoIds" :key="cid" class="strip-img" :src="photoPathOf(cid)" mode="aspectFill" @tap="onPhotoTap(cid)" />
						</view>
						<view class="pending-actions">
							<view class="pending-btn pending-btn-ghost" @tap="ignorePending(ev)">
								<text class="pending-btn-text">忽略</text>
							</view>
							<view class="pending-btn pending-btn-solid" @tap="confirmPending(ev)">
								<text class="pending-btn-text">确认</text>
							</view>
						</view>
					</view>
				</view>

				<view v-for="(day, dayIdx) in days" :key="day.key" class="day-block">
					<text class="day-title serif">{{ day.label }}</text>
					<view v-for="ev in day.events" :key="ev.id" class="card" :class="ev.level === 1 ? 'card-l1' : 'card-l2'">
						<!-- S-MO-1 操作入口（确认/合并；用户操作优先，算法不再覆盖） -->
						<view class="card-ops" @tap="onCardOps(ev, dayIdx)">
							<text class="card-ops-text">⋯</text>
						</view>
						<!-- 封面展示（B3-4：cover_content_id 有值显示，无则首图回退） -->
						<view v-if="ev.coverPath != ''" class="cover-wrap">
							<image class="cover-img" :src="ev.coverPath" mode="aspectFill" />
						</view>
						<text class="card-title serif" :class="ev.level === 1 ? 'title-l1' : 'title-l2'">{{ ev.title }}</text>
						<view class="card-meta">
							<text v-if="ev.place != ''" class="meta-item">{{ ev.place }}</text>
							<text class="meta-item rust">{{ ev.photoCount }} 张照片</text>
						</view>
						<!-- 照片条（会话照片；点开 → 反向入口"属于"列表） -->
						<view v-if="ev.photoIds.length > 0" class="photo-strip">
							<image v-for="cid in ev.photoIds" :key="cid" class="strip-img" :src="photoPathOf(cid)" mode="aspectFill" @tap="onPhotoTap(cid)" />
						</view>
						<view v-if="ev.level === 1 && ev.children.length > 0" class="l2-list">
							<view v-for="child in ev.children" :key="child.id" class="l2-chip">
								<text class="l2-chip-title">{{ child.title }}</text>
								<text class="l2-chip-count rust">{{ child.photoCount }}张</text>
							</view>
						</view>
					</view>
				</view>
				<view class="feed-foot">
					<text class="muted">—— 记忆在此 ——</text>
				</view>
			</view>
		</scroll-view>

		<!-- 拆分选片面板（S-MO-1 split UI · 2026-08-25） -->
		<view v-if="showSplitPanel" class="split-mask" @tap="cancelSplit">
			<view class="split-panel" @tap.stop>
				<text class="split-title serif">拆分这张卡</text>
				<text class="split-sub muted">勾选要拆出的内容，剩余留在原卡</text>
				<scroll-view class="split-list" scroll-y>
					<view v-if="splitLoading" class="split-empty">
						<text class="muted">正在加载成员…</text>
					</view>
					<view v-else-if="splitItems.length === 0" class="split-empty">
						<text class="muted">没有可拆分的成员</text>
					</view>
					<view v-for="(item, idx) in splitItems" :key="item.contentId" class="split-row" @tap="toggleSplitItem(idx)">
						<view class="split-check" :class="item.selected ? 'split-check-on' : ''">
							<text v-if="item.selected" class="split-check-mark">✓</text>
						</view>
						<view class="split-row-main">
							<text class="split-row-title">{{ item.title == '' ? '（无文字）' : item.title }}</text>
							<text class="split-row-meta muted">{{ item.contentType }} · {{ splitTimeText(item.takenAt) }}</text>
						</view>
					</view>
				</scroll-view>
				<view class="split-actions">
					<view class="split-btn split-btn-ghost" @tap="cancelSplit">
						<text class="split-btn-text">取消</text>
					</view>
					<view class="split-btn split-btn-solid" @tap="confirmSplit">
						<text class="split-btn-text">确认拆分</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 照片详情：反向入口"属于：事件列表"（B3-4 · 2026-08-26 Wave2 E） -->
		<view v-if="showPhotoDetail" class="split-mask" @tap="closePhotoDetail">
			<view class="split-panel" @tap.stop>
				<text class="split-title serif">照片属于</text>
				<text class="split-sub muted">这张照片属于 {{ photoDetailEvents.length }} 个事件（多对多）</text>
				<view v-if="photoDetailPath != ''" class="photo-detail-img-wrap">
					<image class="photo-detail-img" :src="photoDetailPath" mode="aspectFit" />
				</view>
				<scroll-view class="split-list" scroll-y>
					<view v-if="photoDetailLoading" class="split-empty">
						<text class="muted">正在查询…</text>
					</view>
					<view v-else-if="photoDetailEvents.length === 0" class="split-empty">
						<text class="muted">尚未归属任何事件</text>
					</view>
					<view v-for="(ref, idx) in photoDetailEvents" :key="ref.id" class="belongs-row" @tap="jumpFromPhoto(idx)">
						<view class="belongs-badge" :class="ref.level === 1 ? 'belongs-badge-l1' : 'belongs-badge-l2'">
							<text class="belongs-badge-text">{{ levelTag(ref.level) }}</text>
						</view>
						<view class="belongs-main">
							<text class="belongs-title">{{ ref.title }}</text>
							<text class="belongs-meta muted">{{ belongsMeta(ref) }}</text>
						</view>
					</view>
				</scroll-view>
				<view class="split-actions">
					<view class="split-btn split-btn-ghost" @tap="closePhotoDetail">
						<text class="split-btn-text">关闭</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 上传进度浮层（B-UP-1 进度回调） -->
		<view v-if="uploading" class="upload-bar">
			<text class="upload-text">上传中 {{ uploadDone }}/{{ uploadTotal }}{{ uploadFailed > 0 ? '（失败' + uploadFailed + '）' : '' }}</text>
		</view>

		<!-- 底部 Tab（T-NA-1） -->
		<yishu-tabbar current="home" />
	</view>
</template>

<script lang="uts">
	import { ensureLogin } from '@/utils/auth'
	import { fetchTimeline, dayKey, friendlyDay, TimelineEvent } from '@/utils/timeline'
	import { uploadBatch, UploadProgress, UploadedPhoto, isoString } from '@/utils/uploader'
	import { createPhotoWatch, PhotoItem } from '@/uni_modules/yishu-photo-watch/utssdk/app-android/index.uts'
	import { showErrorToast } from '@/utils/api'
	import { aggregateToEvents, ClientL1Event } from '@/utils/agg_runner.uts'
	import { syncClientEvents, SyncOutcome } from '@/utils/event_sync'
	import { fetchTodayEcho, dismissEcho, EchoCard } from '@/utils/play'
	import {
		confirmEvent,
		mergeEvent,
		fetchEventItems,
		splitEvent,
		SplitItem,
		flushOpQueue,
		fetchContentEvents,
		ContentEventRef,
		ignoreEventLocally,
		isIgnoredEvent
	} from '@/utils/event_ops'
	import { recordGrantTime, recordFirstDayRender } from '@/utils/agg/perf_timing.uts'

	class DayGroup {
		key: string
		label: string
		events: Array<TimelineEvent>

		constructor(key: string, label: string, events: Array<TimelineEvent>) {
			this.key = key
			this.label = label
			this.events = events
		}
	}

	/** 会话照片映射项：content_id → 本地路径（封面/照片条/反向入口显示用） */
	class PhotoPathEntry {
		contentId: string
		path: string

		constructor(contentId: string, path: string) {
			this.contentId = contentId
			this.path = path
		}
	}

	/** 事件成员照片映射项：event_id → content_id[]（端侧聚合成员） */
	class EventPhotoEntry {
		eventId: string
		contentIds: Array<string>

		constructor(eventId: string, contentIds: Array<string>) {
			this.eventId = eventId
			this.contentIds = contentIds
		}
	}

	export default {
		data() {
			return {
				loaded: false,
				refreshing: false,
				days: [] as Array<DayGroup>,
				pendingEvents: [] as Array<TimelineEvent>,
				uploading: false,
				uploadDone: 0,
				uploadTotal: 0,
				uploadFailed: 0,
				echo: null as EchoCard | null,
				showSplitPanel: false,
				splitEventId: '',
				splitItems: [] as Array<SplitItem>,
				splitLoading: false,
				// 照片→事件反向入口（B3-4）
				showPhotoDetail: false,
				photoDetailPath: '',
				photoDetailEvents: [] as Array<ContentEventRef>,
				photoDetailLoading: false,
				// 会话照片/事件映射（封面、照片条）
				localPhotoPath: [] as Array<PhotoPathEntry>,
				eventPhotoIds: [] as Array<EventPhotoEntry>
			}
		},
		onLoad() {
			ensureLogin().then((ok: boolean) => {
				this.reload()
			})
			// S-SY-5 三路触发 · 前台启动：已授权过则自动恢复监听（App 重启后 ContentObserver 丢失）
			const watch = createPhotoWatch()
			if (watch.isReadPermissionGranted()) {
				this.startWatch()
			}
		},
		onShow() {
			// 切前台刷新（第一波数据新鲜度最低要求）
			if (this.loaded) {
				this.reload()
			}
		},
		methods: {
			/** 拉取全量（L1+L2）→ 按日分组（L2 挂到同日 L1 之下；draft<0.7 进待确认） */
			reload(): void {
				// 2026-08-25 离线 op_log：联网后先补发离线操作，再刷新（顺序执行）
				flushOpQueue().then((_remain: number) => {
					this.fetchAll()
				})
			},
			fetchAll(): void {
				fetchTimeline(null).then((events: Array<TimelineEvent>) => {
					this.days = this.groupDays(events)
					this.attachPhotos()
					this.loaded = true
					this.refreshing = false
					// 30s 验收（B3-6）：首批日卡片渲染完成埋点（幂等）
					if (this.days.length > 0 || this.pendingEvents.length > 0) {
						recordFirstDayRender()
					}
				})
				// T-PL-1：同时拉今日回响（每天≤1 条，无则不显示）
				fetchTodayEcho().then((card: EchoCard | null) => {
					this.echo = card
				})
			},
			/** S-MO-1：卡片操作菜单（L1：确认/合并到上一张/拆分；L2：确认主题）
			 * 2026-08-25 修复：itemList 不再手动加"取消"——showActionSheet 原生自带底部取消按钮，
			 * 手动加会重复（nova11 实测出现两个"取消"）。取消由原生按钮/fail 回调处理。 */
			onCardOps(ev: TimelineEvent, dayIdx: number): void {
				if (ev.level === 1) {
					const items: Array<string> = ['确认这张卡', '合并到上一张', '拆分这张卡']
					uni.showActionSheet({
						itemList: items,
						success: (res) => {
							if (res.tapIndex === 0) {
								this.doConfirm(ev)
							} else if (res.tapIndex === 1) {
								this.doMerge(ev, dayIdx)
							} else if (res.tapIndex === 2) {
								this.doSplit(ev)
							}
						},
						fail: () => {}
					})
				} else {
					const items2: Array<string> = ['确认这个主题']
					uni.showActionSheet({
						itemList: items2,
						success: (res) => {
							if (res.tapIndex === 0) {
								this.doConfirm(ev)
							}
						},
						fail: () => {}
					})
				}
			},
			/** 确认转正（用户背书后算法不再改动） */
			doConfirm(ev: TimelineEvent): void {
				confirmEvent(ev.id).then((ok: boolean) => {
					if (ok) {
						uni.showToast({ title: '已确认', icon: 'none' })
					} else {
						uni.showToast({ title: '确认失败', icon: 'none' })
					}
					this.reload()
				})
			},
			/** 找当前卡片之前的最近一张 L1（合并目标；跳过 L2 组） */
			getPrevL1Id(dayIdx: number): string {
				for (let i = dayIdx - 1; i >= 0; i--) {
					if (this.days[i].events.length > 0 && this.days[i].events[0].level === 1) {
						return this.days[i].events[0].id
					}
				}
				return ''
			},
			/** 合并到上一张 L1（source=当前，target=上一张；target 置 confirmed） */
			doMerge(ev: TimelineEvent, dayIdx: number): void {
				const targetId = this.getPrevL1Id(dayIdx)
				if (targetId == '') {
					uni.showToast({ title: '没有可合并的上一张', icon: 'none' })
					return
				}
				mergeEvent(ev.id, targetId).then((ok: boolean) => {
					if (ok) {
						uni.showToast({ title: '已合并', icon: 'none' })
					} else {
						uni.showToast({ title: '合并失败', icon: 'none' })
					}
					this.reload()
				})
			},
			/** 拆分：拉成员列表 → 选片面板（2026-08-25 S-MO-1 split UI） */
			doSplit(ev: TimelineEvent): void {
				this.splitLoading = true
				this.showSplitPanel = true
				this.splitEventId = ev.id
				this.splitItems = []
				fetchEventItems(ev.id).then((items: Array<SplitItem>) => {
					this.splitLoading = false
					this.splitItems = items
					if (items.length < 2) {
						uni.showToast({ title: '成员不足，无法拆分', icon: 'none' })
					}
				})
			},
			toggleSplitItem(idx: number): void {
				const items = this.splitItems
				if (idx < 0 || idx >= items.length) {
					return
				}
				const it = items[idx]
				it.selected = !it.selected
				items[idx] = it
				this.splitItems = items
			},
			/** 确认拆分：至少选 1 条且不全选（拆出建新事件） */
			confirmSplit(): void {
				const items = this.splitItems
				const ids: Array<string> = []
				for (let i = 0; i < items.length; i++) {
					if (items[i].selected) {
						ids.push(items[i].contentId)
					}
				}
				if (ids.length == 0) {
					uni.showToast({ title: '至少选择一条', icon: 'none' })
					return
				}
				if (ids.length >= items.length) {
					uni.showToast({ title: '需至少留一条在原卡', icon: 'none' })
					return
				}
				splitEvent(this.splitEventId, ids).then((ok: boolean) => {
					this.showSplitPanel = false
					if (ok) {
						uni.showToast({ title: '已拆分', icon: 'none' })
					} else {
						uni.showToast({ title: '拆分失败', icon: 'none' })
					}
					this.reload()
				})
			},
			cancelSplit(): void {
				this.showSplitPanel = false
				this.splitItems = []
			},
			/** 拆分面板时间文案（epoch ms → MM-DD HH:mm；0=未知） */
			splitTimeText(ts: number): string {
				if (ts <= 0) {
					return '时间未知'
				}
				const d = new Date(ts)
				const mm = (d.getMonth() + 1).toString()
				const dd = d.getDate().toString()
				const hh = d.getHours().toString()
				const mi = d.getMinutes().toString()
				return (mm.length < 2 ? '0' + mm : mm) + '-' + (dd.length < 2 ? '0' + dd : dd) + ' ' + (hh.length < 2 ? '0' + hh : hh) + ':' + (mi.length < 2 ? '0' + mi : mi)
			},
			/** T-PL-1：划掉回响（dismiss 不再出现） */
			dismissEchoCard(): void {
				const card = this.echo
				if (card == null) {
					return
				}
				dismissEcho(card.contentId).then((ok: boolean) => {
					this.echo = null
					if (ok) {
						uni.showToast({ title: '已划掉', icon: 'none' })
					}
				})
			},
			/** 按日分组：draft & confidence<0.7 → 待确认区；忽略的事件过滤；L2 挂同日 L1 */
			groupDays(events: Array<TimelineEvent>): Array<DayGroup> {
				const pending: Array<TimelineEvent> = []
				const l1: Array<TimelineEvent> = []
				const l2: Array<TimelineEvent> = []
				for (let i = 0; i < events.length; i++) {
					const ev = events[i]
					if (isIgnoredEvent(ev.id)) {
						continue // B3-5 忽略（本地隐藏）
					}
					const isPending = ev.status == 'draft' && ev.confidence > 0 && ev.confidence < 0.7
					if (isPending) {
						pending.push(ev)
						continue
					}
					if (ev.level === 1) {
						l1.push(ev)
					} else if (ev.level === 2) {
						l2.push(ev)
					}
				}
				pending.sort((a: TimelineEvent, b: TimelineEvent): number => b.startTime - a.startTime)
				this.pendingEvents = pending
				l1.sort((a: TimelineEvent, b: TimelineEvent): number => b.startTime - a.startTime)
				l2.sort((a: TimelineEvent, b: TimelineEvent): number => b.startTime - a.startTime)

				const groups: Array<DayGroup> = []
				const l1ByDay: Map<string, number> = new Map<string, number>()
				for (let i = 0; i < l1.length; i++) {
					const ev = l1[i]
					const k = dayKey(ev.startTime)
					const copy = new TimelineEvent(
						ev.id,
						ev.level,
						ev.title,
						ev.titleSource,
						ev.startTime,
						ev.endTime,
						ev.place,
						ev.emotion,
						ev.photoCount,
						ev.contentCount,
						ev.status,
						ev.confidence,
						ev.coverContentId
					)
					groups.push(new DayGroup(k, friendlyDay(ev.startTime), [copy]))
					l1ByDay.set(k, groups.length - 1)
				}
				for (let j = 0; j < l2.length; j++) {
					const ev = l2[j]
					const k = dayKey(ev.startTime)
					const idx = l1ByDay.get(k)
					if (idx != null && groups[idx].events.length > 0) {
						groups[idx].events[0].children.push(ev)
					} else {
						groups.push(new DayGroup(k, friendlyDay(ev.startTime), [ev]))
						l1ByDay.set(k, groups.length - 1)
					}
				}
				return groups
			},
			/** content_id → 本地路径（会话映射；空=无） */
			photoPathOf(contentId: string): string {
				for (let i = 0; i < this.localPhotoPath.length; i++) {
					if (this.localPhotoPath[i].contentId == contentId) {
						return this.localPhotoPath[i].path
					}
				}
				return ''
			},
			/** event_id → 成员照片 content_id 列表（端侧聚合成员；无=空） */
			lookupEventPhotos(eventId: string): Array<string> {
				for (let i = 0; i < this.eventPhotoIds.length; i++) {
					if (this.eventPhotoIds[i].eventId == eventId) {
						return this.eventPhotoIds[i].contentIds
					}
				}
				return []
			},
			/** 逐卡填充 photoIds + coverPath（封面：cover_content_id 优先，无则首图回退） */
			attachPhotos(): void {
				let strips = 0
				let covers = 0
				for (let i = 0; i < this.days.length; i++) {
					const g = this.days[i]
					for (let j = 0; j < g.events.length; j++) {
						const ev = g.events[j]
						ev.photoIds = this.lookupEventPhotos(ev.id)
						let cover = this.photoPathOf(ev.coverContentId)
						if (cover == '' && ev.photoIds.length > 0) {
							cover = this.photoPathOf(ev.photoIds[0])
						}
						ev.coverPath = cover
						if (ev.photoIds.length > 0) {
							strips++
						}
						if (ev.coverPath != '') {
							covers++
						}
					}
				}
				for (let j = 0; j < this.pendingEvents.length; j++) {
					const ev = this.pendingEvents[j]
					ev.photoIds = this.lookupEventPhotos(ev.id)
					let cover = this.photoPathOf(ev.coverContentId)
					if (cover == '' && ev.photoIds.length > 0) {
						cover = this.photoPathOf(ev.photoIds[0])
					}
					ev.coverPath = cover
					if (ev.photoIds.length > 0) {
						strips++
					}
					if (ev.coverPath != '') {
						covers++
					}
				}
				console.log('[yishu] attachPhotos: days=' + this.days.length + ' pending=' + this.pendingEvents.length + ' localPaths=' + this.localPhotoPath.length + ' eventPhotoIds=' + this.eventPhotoIds.length + ' strips=' + strips + ' covers=' + covers)
			},
			/** 照片点开 → 反向入口"属于：事件列表"（B3-4） */
			onPhotoTap(contentId: string): void {
				this.showPhotoDetail = true
				this.photoDetailLoading = true
				this.photoDetailPath = this.photoPathOf(contentId)
				this.photoDetailEvents = []
				fetchContentEvents(contentId).then((evs: Array<ContentEventRef>) => {
					this.photoDetailLoading = false
					this.photoDetailEvents = evs
				})
			},
			closePhotoDetail(): void {
				this.showPhotoDetail = false
				this.photoDetailEvents = []
			},
			/** "跳转"：MVP 无独立事件详情页，时间轴即跳转目标 → 关闭浮层即可看到该事件 */
			jumpFromPhoto(_idx: number): void {
				this.closePhotoDetail()
			},
			/** 待确认区：确认转正（调 confirm API） */
			confirmPending(ev: TimelineEvent): void {
				confirmEvent(ev.id).then((ok: boolean) => {
					if (ok) {
						uni.showToast({ title: '已确认', icon: 'none' })
					} else {
						uni.showToast({ title: '确认失败', icon: 'none' })
					}
					this.reload()
				})
			},
			/** 待确认区：忽略（MVP 本地隐藏；后端 reject 端点由 Agent D 域） */
			ignorePending(ev: TimelineEvent): void {
				ignoreEventLocally(ev.id)
				uni.showToast({ title: '已忽略（本机隐藏）', icon: 'none' })
				this.reload()
			},
			/** 事件层级标签（待确认区/反向入口） */
			levelText(level: number): string {
				if (level === 1) {
					return '日卡片'
				} else if (level === 2) {
					return '主题'
				} else if (level === 3) {
					return '主题流'
				}
				return '瞬间'
			},
			levelTag(level: number): string {
				if (level === 1) {
					return '日卡'
				} else if (level === 2) {
					return '主题'
				} else if (level === 3) {
					return '主题流'
				}
				return '瞬间'
			},
			belongsMeta(ref: ContentEventRef): string {
				const st = ref.status == 'confirmed' ? '已确认' : (ref.status == 'rejected' ? '已忽略' : '待确认')
				return ref.photoCount.toFixed(0) + '张 · ' + st
			},
			onRefresh(): void {
				this.refreshing = true
				this.reload()
			},
			/** 授权相册 → 启动监听（B-UT-5 前置；权限请求由插件原生实现） */
			onGrantAndStart(): void {
				console.log('[yishu] CTA tapped')
				const watch = createPhotoWatch()
				console.log('[yishu] permission granted? ' + watch.isReadPermissionGranted())
				watch.requestReadPermission()
				this.startWatch()
			},
			/** 启动 PhotoObserver 监听（幂等） */
			startWatch(): void {
				console.log('[yishu] startWatch begin')
				// 30s 验收（B3-6）：授权/监听启动 = 计时起点（幂等）
				recordGrantTime()
				const watch = createPhotoWatch()
				watch.start((items: Array<PhotoItem>) => {
					console.log('[yishu] batch received: ' + items.length)
					if (items.length === 0) {
						return
					}
					this.handleBatch(items)
				})
				console.log('[yishu] startWatch done, lastSeen=' + watch.getLastSeenId())
				uni.showToast({ title: '已开始监听相册', icon: 'none' })
			},
			/** 攒批 → 上传（并发≤3）→ 端侧聚合 L1 → 事件上云 → 拉 timeline 刷新（B-UP-2 + S-AG-3/4） */
			handleBatch(items: Array<PhotoItem>): void {
				this.uploading = true
				this.uploadDone = 0
				this.uploadTotal = items.length
				this.uploadFailed = 0
				uploadBatch(items, (p: UploadProgress) => {
					this.uploadDone = p.done
					this.uploadTotal = p.total
					this.uploadFailed = p.failed
				}).then((uploaded: Array<UploadedPhoto>) => {
					this.uploading = false
					if (this.uploadFailed > 0) {
						uni.showToast({ title: '有 ' + this.uploadFailed + ' 张上传失败', icon: 'none' })
					}
					// 端侧聚合：上传成功照片 → L1 日卡片事件（B3-6 端侧 L0/L1 真值）
					if (uploaded.length > 0) {
						// 会话照片映射：content_id → 本地路径（封面/照片条显示）
						for (let i = 0; i < uploaded.length; i++) {
							this.localPhotoPath.push(new PhotoPathEntry(uploaded[i].contentId, uploaded[i].item.path))
						}
						const tz = -new Date().getTimezoneOffset()
						const agg = aggregateToEvents(uploaded, tz)
						const events: Array<UTSJSONObject> = []
						for (let i = 0; i < agg.events.length; i++) {
							const ev = agg.events[i]
							const obj: UTSJSONObject = {
								client_event_id: ev.clientEventId,
								title: ev.title,
								start_time: isoString(ev.startTime),
								end_time: isoString(ev.endTime),
								photo_ids: ev.photoIds
							}
							events.push(obj)
						}
						if (events.length > 0) {
							syncClientEvents(events).then((out: SyncOutcome | null) => {
								if (out != null) {
									console.log('[yishu] 事件上云: accepted=' + out.accepted + ' dup=' + out.duplicates + ' rejected=' + out.rejected)
									// 服务端 event_id → 成员照片映射（照片条/封面按云端 id 关联）
									this.buildEventPhotoIds(events, out.acceptedEvents)
								} else {
									console.error('[yishu] 事件上云失败（重试耗尽）')
									uni.showToast({ title: '事件同步失败，稍后重试', icon: 'none' })
								}
								this.reload()
							})
							return
						}
					}
					this.reload()
				})
			},
			/** 通过 sync accepted 明细建立 服务端事件 id → 成员照片 映射（端侧聚合的 client_event_id 与云端 id 不同） */
			buildEventPhotoIds(clientEvents: Array<UTSJSONObject>, accepted: Array<UTSJSONObject>): void {
				const clientMap: Array<EventPhotoEntry> = []
				for (let k = 0; k < clientEvents.length; k++) {
					const cid = clientEvents[k].getString('client_event_id') ?? ''
					const pids = clientEvents[k].getArray('photo_ids') as Array<string> | null
					if (cid != '' && pids != null) {
						clientMap.push(new EventPhotoEntry(cid, pids))
					}
				}
				for (let a = 0; a < accepted.length; a++) {
					const it = accepted[a]
					const serverId = it.getString('event_id') ?? ''
					const clientId = it.getString('client_event_id') ?? ''
					if (serverId == '' || clientId == '') {
						continue
					}
					for (let k = 0; k < clientMap.length; k++) {
						if (clientMap[k].eventId == clientId) {
							this.eventPhotoIds.push(new EventPhotoEntry(serverId, clientMap[k].contentIds))
							break
						}
					}
				}
				console.log('[yishu] photoMap: clientEvents=' + clientEvents.length + ' accepted=' + accepted.length + ' mappedServerEvents=' + this.eventPhotoIds.length)
			}
		}
	}
</script>


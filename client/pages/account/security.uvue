	     2026-09-01：统一归未来「存储与备份」页，画布同步删） -->
	<view class="page-root">
		<!-- 铁律 11.5：同层 absolute 兄弟按 DOM 顺序绘制，返回图标必须排在标题容器**之后**，
		     否则被全宽 750rpx 的标题容器盖住 → @tap 收不到事件（settings 页真机实锤先例） -->
		<view class="n41_166"> <!-- 画布 41:166 标题容器 -->
			<text class="n41_167">账号与安全</text> <!-- 画布 41:167 页标题 -->
		</view>
		<image class="n41_164" src="/static/icons/i4_135.svg" @tap="goBack" /> <!-- 画布 41:164 返回（复用 settings 同款箭头 SVG） -->
		<view class="list-flow"> <!-- 列表流式容器（组间 margin 自动下移） -->
			<view class="sec-group"> <!-- 画布 41:169 组·账号信息 -->
				<view class="sec-row" @tap="onPhone"> <!-- 画布 41:170 行·手机号 -->
					<view class="sec-icon">
						<image class="sec-icon-img" src="/static/icons/icon-phone.svg" />
					</view>
					<text class="sec-label">手机号</text>
					<text class="sec-value">138****5678</text>
					<text class="sec-arrow">›</text>
				</view>
				<view class="sec-row" @tap="onWechat"> <!-- 画布 41:176 行·微信 -->
					<view class="sec-icon">
						<image class="sec-icon-img" src="/static/icons/icon-chat.svg" />
					</view>
					<text class="sec-label">微信</text>
					<view class="sec-badge"> <!-- 画布 41:180 绑定徽章 -->
						<text class="sec-badge-text">已绑定</text>
					</view>
					<text class="sec-arrow">›</text>
				</view>
			</view>
			<view class="sec-group group-gap"> <!-- 画布 41:183 组·数据与隐私（组间距 38pt=73.1rpx；导出/存储两行已移出 → 存储与备份页） -->
				<view class="sec-row" @tap="onPrivacy"> <!-- 画布 41:189 行·隐私权限 -->
					<view class="sec-icon">
						<image class="sec-icon-img" src="/static/icons/icon-shield.svg" />
					</view>
					<text class="sec-label">隐私权限</text>
					<text class="sec-arrow">›</text>
				</view>
			</view>
			<view class="sec-group group-gap" @tap="onLogout"> <!-- 画布 41:200 组·退出登录 -->
				<view class="sec-row-center">

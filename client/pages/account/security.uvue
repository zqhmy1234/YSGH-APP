<template>
	<!-- W10 新页：账号与安全（画布板 41:161）· 手工还原
	     无 TabBar（画布真值）；W10.4：emoji 图标全部换同风格线性 SVG（icon-phone/chat/shield）；
	     「数据导出」「存储空间」两行移出（与「我的」页「存储与备份」功能冲突，峰宝拍板
	     2026-09-01：统一归未来「存储与备份」页，画布同步删） -->
	<view class="page-root tk-root">
		<!-- 铁律 11.5：同层 absolute 兄弟按 DOM 顺序绘制，返回图标必须排在标题容器**之后**，
		     否则被全宽 750rpx 的标题容器盖住 → @tap 收不到事件（settings 页真机实锤先例） -->
		<view class="n41_166"> <!-- 画布 41:166 标题容器 -->
			<text class="n41_167">账号与安全</text> <!-- 画布 41:167 页标题 -->
		</view>
		<image class="n41_164" src="/static/icons/i4_135.svg" @tap="goBack" /> <!-- 画布 41:164 返回（复用 settings 同款箭头 SVG） -->
		<view class="list-flow"> <!-- 列表流式容器（组间 margin 自动下移） -->
			<view class="sec-group"> <!-- 画布 41:169 组·账号信息 -->
				<!-- 2026-10-16（清假入口批次 · 裁决后改回保留）：本行**保留**——它渲染的是 `GET /users/me`
				     服务端掩码真号（真实信息，非假号）⇒ 隐藏＝少给用户一个事实，与本批"诚实化"立意相反。
				     只改写「点击」文案：原「手机号绑定即将上线」占位 toast＝空承诺 ✗ ⇒ 现改「如需变更请联系客服」
				     （诚实：后端无自助改绑端点，手机号绑定属 B5 远期）。 -->
				<view class="sec-row" @tap="onPhone"> <!-- 画布 41:170 行·手机号 -->
					<view class="sec-icon">
						<image class="sec-icon-img" src="/static/icons/icon-phone.svg" />
					</view>
					<text class="sec-label">手机号</text>
					<!-- B4（BB1）：GET /users/me 真值（服务端掩码 138****XXXX）；失败/未绑定保持「未绑定」不显假号 -->
					<text class="sec-value">{{ phoneText }}</text>
					<text class="sec-arrow">›</text>
				</view>
				<view class="sec-row" @tap="onWechat"> <!-- 画布 41:176 行·微信 -->
					<view class="sec-icon">
						<image class="sec-icon-img" src="/static/icons/icon-chat.svg" />
					</view>
					<text class="sec-label">微信</text>
					<!-- 2026-10-15（台账 §7.29）：**接真实绑定态**。原为硬编码「未绑定」+ 点击 toast
					     "微信绑定暂未开放"——而绑定管理**已落地**（设置页：微信授权优先、绑定码兜底），
					     两页口径矛盾。现本行改为 `GET /wechat/bindings` 真值渲染，点击跳设置页去绑定/解绑。
					     徽章样式（画布 41:180）按 2026-09-21 的决定**暂不恢复**：纯文本与手机号行一致。 -->
					<text class="sec-value">{{ wechatText }}</text>
					<text class="sec-arrow">›</text>
				</view>
				<!-- 2026-10-16：消息通知**状态占位行**——调研已证后端无偏好字段，**绝不造假开关** ✗。
				     口径对齐本日「清假入口」批次：不可点、无箭头 = 纯状态展示，非假入口（假入口的定义是
				     「有点击行为却无真实目标」，本行无 @tap）；值如实写「暂未开放」，等后端偏好字段立项后
				     再改为真开关。图标复用 storage-bell.svg（全仓唯一既有铃铛线性 SVG，零新增视觉资产）。 -->
				<view class="sec-row">
					<view class="sec-icon">
						<image class="sec-icon-img" src="/static/icons/storage-bell.svg" />
					</view>
					<text class="sec-label">消息通知</text>
					<text class="sec-value">暂未开放</text>
				</view>
			</view>
			<!-- 2026-10-16（清假入口批次 · 裁决后隐藏）：原 41:183 组·数据与隐私（唯一行＝「隐私权限」）**整组移除**——
			     该行点击仅弹「隐私权限设置即将上线」占位 toast、无目标页，属同类占位入口。
			     ⚠️ 恢复条件：接入**系统权限设置页**（如跳 App 系统权限/通知设置）后，按画布 41:183/41:189 恢复本组。 -->
			<view class="sec-group group-gap" @tap="onLogout"> <!-- 画布 41:200 组·退出登录 -->
				<view class="sec-row-center">
					<text class="sec-logout-text">退出登录</text>
				</view>
			</view>
			<text class="sec-danger-label">危险区</text> <!-- 画布 41:203 危险区标签（组3底 486 → y538，间距 52pt） -->
			<view class="sec-group group-delete" @tap="onDeleteAccount"> <!-- 画布 41:204 组·注销账号 -->
				<view class="sec-row-center">
					<text class="sec-delete-text">注销账号</text>
				</view>
			</view>
			<text class="sec-danger-note">注销后所有记忆数据将被永久删除，且无法恢复</text> <!-- 画布 41:207 危险说明 -->
		</view>
	</view>
</template>

<script setup lang="uts">
// W10 新页：账号与安全（画布板 41:161）
// 接线：退出登录 = utils/auth.logout()（G1/R6#7 封装此前「有封装无触发」，本单修复）；
// 注销账号 = 后端暂无端点（W10 台账登记），诚实降级不假删；
// W0-4 状态化（2026-09-02 峰宝拍板「真实状态化」/ 2026-10-16 更新）：原「手机号」行（曾接
// `GET /users/me` 掩码真值，但绑定端点属 B5 远期、点击仅占位 toast）已整行移除，见模板注释；
// 微信行（2026-10-15 · 台账 §7.29）：**接真实绑定态**（`GET /wechat/bindings`）并**就地绑定/解绑** ——
// 未绑定 ⇒ `wechatLogin()` 拉起微信授权（失败自动回落绑定码通道）；已绑定 ⇒ 二次确认解绑；
// ⚠️ 本注释取代两处已过期表述：① 「微信行不再显示『已绑定』」（2026-09-21 当时正确，但 10-15 起绑定
// 能力已落地、改为真值渲染 ✓）；② 「绑定管理 toast 措辞『即将上线』」（现已有真入口 ✓）。
// 另修一处回环：原先点本行跳 settings 中间页，与 settings 的「账号与安全」行互跳成死循环（用户实测 ✗）⇒ 已改为就地处理。
// W10.4：onExport/onStorage 已随两行移出（归未来「存储与备份」页）
	import { ref } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import { logout } from '@/utils/auth'
	import { fetchUsersMe } from '@/utils/play_content'
	import { listWechatBindings, issueBindCode, unbindWechat } from '@/utils/wechat_api'
	import { wechatLogin } from '@/utils/auth'

	// B4（BB1）：手机号接真 GET /users/me（服务端掩码下发）；默认降级「未绑定」（2026-10-16 裁决后随本行保留而恢复）
	let phoneText = ref('未绑定')
	// 2026-10-15（台账 §7.29）：微信**绑定态**接真值（`GET /wechat/bindings`）；默认「未绑定」，
	// 拉取失败保持默认（不显假状态）。
	let wechatText = ref('未绑定')
	// 2026-10-15（真机反馈后复修）：本页**就地绑定/解绑**。原先点这一行会跳 settings 中间页，
	// 与 settings 的「账号与安全」行互跳 ⇒ 我的→设置→账号与安全→设置 死循环 ✗（用户实测）。
	let wechatBound = ref(false)
	let wechatOpenid = ref('')

	/** 拉真绑定态（进页调用；绑定动作由服务端回调侧完成，客户端只做"领码/授权/解绑"） */
	function refreshWechat(): void {
		listWechatBindings().then((rows: Array<UTSJSONObject>) => {
			if (rows.length == 0) {
				wechatBound.value = false
				wechatText.value = '未绑定'
				wechatOpenid.value = ''
				return
			}
			wechatBound.value = true
			wechatText.value = '已绑定'
			wechatOpenid.value = rows[0].getString('openid') ?? ''
		})
	}

	/**
	 * 绑定码通道（资质未到位时的兜底）：领 6 位码 → 系统弹窗展示（不新增视觉元素；
	 * 数字手打到微信即可）→ 用户发完点「我已发送」复查一次。
	 */
	function showBindCodeFlow(): void {
		issueBindCode().then((d: UTSJSONObject | null) => {
			if (d == null) {
				return // 失败原因已由 api 层全局 toast 显式给出
			}
			const code = d.getString('code') ?? ''
			const mins = Math.round((d.getNumber('expires_in') ?? 600) / 60)
			uni.showModal({
				title: '微信绑定',
				content: '请在微信里给「忆述」发送：绑定 ' + code + '（' + mins + ' 分钟内有效）。发完点「我已发送」。',
				confirmText: '我已发送',
				showCancel: false,
				success: (): void => {
					refreshWechat()
				}
			})
		})
	}

	onLoad(() => {
		// 2026-10-15（台账 §7.29）：微信绑定态真值（失败保持「未绑定」，不 toast 打扰）
		// 2026-10-16：手机号行保留 ⇒ 恢复拉取服务端掩码真号（失败显式 toast，保持「未绑定」降级不显假号）
		refreshWechat()
		fetchUsersMe().then((d: UTSJSONObject | null) => {
			if (d == null) {
				uni.showToast({ title: '账号信息加载失败', icon: 'none' })
				return
			}
			const masked = d.getString('phone')
			if (masked != null && masked != '') {
				phoneText.value = masked
			}
		})
	})

	function goBack(): void {
		// 铁律：reLaunch/redirectTo 直入时页面栈仅 1 页，navigateBack 静默失败 → 回落首页
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/shell/shell' })
		}
	}

	/**
	 * 手机号行（2026-10-16 · 裁决后改回）：**保留本行**（展示服务端掩码真号），点击给**诚实文案**——
	 * 后端无自助改绑端点（手机号绑定属 B5 远期），不再弹「即将上线」空承诺，改为引导联系客服。
	 */
	function onPhone(): void {
		uni.showToast({ title: '如需变更手机号请联系客服', icon: 'none' })
	}

	/**
	 * 微信行：**就地**完成绑定/解绑（2026-10-15 · 真机反馈「又跳到那个中间页」后复修）。
	 *
	 * - 已绑定 ⇒ 二次确认后解绑（只断开关联，已入库记忆零侵入 ✓）；
	 * - 未绑定 ⇒ **授权优先**：`wechatLogin()` 拉起微信授权（`uni.login` → `/auth/wechat`，
	 *   服务端 code2session 换 unionid+openid 并**同时建立渠道绑定**）⇒ 授权即完成；
	 *   授权不可用（未配开放平台 AppID / manifest 未开微信模块，**属外部资质前置**）⇒
	 *   **自动回落绑定码通道**，不把用户卡在死路上（与设置页同一口径）。
	 * ⚠️ 不再跳 settings 中间页（那会形成 我的→设置→本页→设置 的回环 ✗）。
	 */
	function onWechat(): void {
		if (wechatBound.value) {
			uni.showModal({
				title: '微信绑定',
				content: '解绑后，微信里再发的照片/语音不再进入你的忆述（已入库的记忆不受影响）。',
				confirmText: '解绑',
				confirmColor: '#B05A3A',
				success: (res) => {
					if (!res.confirm || wechatOpenid.value == '') {
						return
					}
					unbindWechat(wechatOpenid.value).then((ok: boolean) => {
						if (ok) {
							uni.showToast({ title: '已解绑', icon: 'success' })
							refreshWechat()
						}
					})
				}
			})
			return
		}
		wechatLogin().then((ok: boolean) => {
			if (ok) {
				uni.showToast({ title: '微信授权成功 · 已绑定', icon: 'success' })
				refreshWechat()
				return
			}
			// 授权不可用（资质未到位/未装微信）⇒ 回落绑定码通道
			console.log('[yishu] 微信授权不可用 ⇒ 回落绑定码通道')
			showBindCodeFlow()
		})
	}

	// 2026-10-16（清假入口批次 · 裁决后隐藏）：原 onPrivacy（隐私权限占位 toast，无目标页）已随
	// 「隐私权限」行整组移除；恢复条件见模板内注释（接入系统权限设置页）。

	function onLogout(): void {
		uni.showModal({
			title: '退出登录',
			content: '退出后需重新登录才能查看你的记忆',
			success: (res) => {
				if (res.confirm) {
					// logout() 幂等：后端吊销失败也清本地凭据并 resolve(true)（auth.uts G1/R6#7）
					logout().then((_ok: boolean) => {
						uni.reLaunch({ url: '/pages/shell/shell' })
					})
				}
			}
		})
	}

	function onDeleteAccount(): void {
		uni.showModal({
			title: '注销账号',
			content: '注销后所有记忆数据将被永久删除且无法恢复，确定继续？',
			success: (res) => {
				if (res.confirm) {
					// 后端暂无注销端点（backend/api 无 users/me DELETE）——诚实降级，不做假删除
					uni.showToast({ title: '内测期暂不支持自助注销，请联系团队', icon: 'none', duration: 2500 })
				}
			}
		})
	}
</script>

<style>
	.page-root {
		flex: 1;
		flex-direction: column;
		font-family: "Sarasa Gothic SC", sans-serif;
		background-color: var(--c-paper-100, #F8F7F4);
	}
	.n41_164 {
		position: absolute;
		/* absolute-ok: 固定页头·返回钮（铁律 11.5 DOM 顺序约束，settings 同款位置） */
		left: var(--d-lattice-p16, 30.8rpx);
		top: var(--d-lattice-p60, 115.4rpx);
		width: var(--d-lattice-p22, 42.3rpx);
		height: var(--d-lattice-p22, 42.3rpx);
		z-index: 1;
	}
	.n41_166 {
		position: absolute;
		/* absolute-ok: 固定页头·标题容器（全宽居中，画布 41:166 y60pt） */
		left: var(--d-lattice-p0, 0rpx);
		top: var(--d-lattice-p60, 115.4rpx);
		width: var(--d-lattice-p390, 750rpx);
		flex-direction: row;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}
	.n41_167 {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 600;
		font-size: var(--d-lattice-p18, 34.6rpx);
		color: var(--c-ink-900, #3A2E25);
	}
	/* 列表流式容器：画布组1 y110pt=211.5rpx；左右页边距 20pt=38.5rpx（组宽 350pt ✓） */
	.list-flow {
		margin-top: var(--d-lattice-p110, 211.5rpx);
		padding-left: var(--d-card_margin_x, 38.5rpx);
		padding-right: var(--d-card_margin_x, 38.5rpx);
		flex-direction: column;
	}
	/* 组卡同构：白底圆角 20pt=38.5rpx，内衬 6pt=11.5rpx（画布 41:169/183/200/204） */
	.sec-group {
		width: 100%;
		flex-direction: column;
		padding-left: var(--d-lattice-p6, 11.5rpx);
		padding-right: var(--d-lattice-p6, 11.5rpx);
		padding-top: var(--d-lattice-p6, 11.5rpx);
		padding-bottom: var(--d-lattice-p6, 11.5rpx);
		background-color: var(--c-white, #FFFFFF);
		border-radius: var(--d-card_margin_x, 38.5rpx);
		overflow: hidden;
	}
	/* 画布组间距 38pt=73.1rpx（组1底 210 → 组2 y248；组2底 392 → 组3 y430，两处一致） */
	.group-gap {
		margin-top: var(--d-lattice-p38, 73.1rpx);
	}
	/* 行基类：图标 x12pt（相对行）→ 左右衬 23.1rpx，行高 44pt 节奏 = 23.1×2 + 内容 38.5 */
	.sec-row {
		width: 100%;
		flex-direction: row;
		align-items: center;
		padding-left: var(--d-card_radius_small, 23.1rpx);
		padding-right: var(--d-card_radius_small, 23.1rpx);
		padding-top: var(--d-card_radius_small, 23.1rpx);
		padding-bottom: var(--d-card_radius_small, 23.1rpx);
		overflow: hidden;
	}
	/* 画布 41:171 图标圈 20×20 无底色 → 纯定位容器 */
	.sec-icon {
		width: var(--d-card_margin_x, 38.5rpx);
		height: var(--d-card_margin_x, 38.5rpx);
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	/* W10.4：emoji → 同风格线性 SVG（画布 icon 容器 20×20pt=38.5rpx，SVG 20×20 内含留白） */
	.sec-icon-img {
		width: var(--d-card_margin_x, 38.5rpx);
		height: var(--d-card_margin_x, 38.5rpx);
	}
	.sec-label {
		flex: 1;
		margin-left: var(--d-card_radius_small, 23.1rpx); /* 画布文字 x44 - 图标底 32 = 12pt */
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: var(--d-lattice-p15, 28.8rpx); /* 画布 fs15pt */
		color: var(--c-ink-900, #3A2E25);
	}
	.sec-value {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: var(--d-lattice-p13, 25rpx); /* 画布 fs13pt */
		color: var(--c-ink-300, #B3A696);
	}
	.sec-arrow {
		margin-left: var(--d-card_radius_small, 23.1rpx);
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: var(--d-lattice-p14, 26.9rpx); /* 画布 fs14pt */
		color: var(--c-ink-300, #B3A696);
	}
	/* 画布 41:180 绑定徽章样式（.sec-badge / .sec-badge-text）已随「已绑定」失实表述一并移除
	   （2026-09-21，理由见模板内注释）。B5 微信绑定管理落地后按真实绑定态恢复：
	   规格为锈金 a0.10 底 + #C4913C 字 + 圆角 15.4rpx（画布真值 41:180）。 */
	/* 退出/注销行：画布 h44pt=84.6rpx 文字居中 */
	.sec-row-center {
		width: 100%;
		height: var(--d-status_bar_height, 84.6rpx);
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.sec-logout-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: var(--d-lattice-p15, 28.8rpx);
		color: var(--c-ink-900, #3A2E25);
	}
	.sec-delete-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: var(--d-lattice-p15, 28.8rpx);
		color: var(--c-rust-500, #B05A3A);
	}
	/* 画布 41:203 危险区标签：x26pt（页边距 20 + 组衬 6）→ 组卡左缘内 11.5rpx */
	.sec-danger-label {
		margin-top: var(--d-lattice-p52, 100rpx); /* 组3底 486 → y538，间距 52pt=100rpx */
		margin-left: var(--d-lattice-p6, 11.5rpx);
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: var(--d-card_radius_small, 23.1rpx); /* 画布 fs12pt */

<template>
	<view class="page tk-root">
		<view class="header">
			<text class="title">AGG-016 一致性自检</text>
			<text class="sub">UTS ST-DBSCAN vs Python 同参双跑（{{summaryText}}）</text>
			<text class="sub">30s 验收：{{ timing }}</text>
		</view>
		<scroll-view class="list" direction="vertical">
			<view v-for="(r, i) in results" :key="i" class="row" :class="r.pass ? 'row-pass' : 'row-fail'">
				<text :class="r.pass ? 'badge badge-pass' : 'badge badge-fail'">{{ r.pass ? 'PASS' : 'FAIL' }}</text>
				<view class="cell">
					<text class="name">{{ r.name }}</text>
					<text v-if="!r.pass" class="detail">{{ r.detail }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad } from '@dcloudio/uni-app'
	import { AGG_FIXTURES } from '@/utils/agg/fixtures.uts'
	import { CaseResult, runAllCases } from '@/utils/agg/agg_check.uts'
	import { timingText } from '@/utils/agg/perf_timing.uts'
	import { DEV_PAGE_ENABLED } from '@/utils/config'

	let summaryText = '运行中…'
	let timing = ''
	let results: Array<CaseResult> = []

	onLoad(() => {
		if (!DEV_PAGE_ENABLED) {
			uni.reLaunch({ url: '/pages/shell/shell' })
			return
		}
		const summary = runAllCases(AGG_FIXTURES)
		summaryText = summary.passed + '/' + summary.total + ' 通过'
		timing = timingText()
		results = summary.results
		for (let i = 0; i < summary.results.length; i++) {
			const r = summary.results[i]
			console.log('[yishu-agg] ' + r.name + ': ' + (r.pass ? 'PASS' : 'FAIL') + ' ' + r.detail)
		}
	})
</script>

<style>

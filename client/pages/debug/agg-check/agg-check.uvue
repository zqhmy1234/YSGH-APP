	margin-top: var(--d-raw-r8, 8rpx);
	font-size: var(--d-raw-r24, 24rpx);
	color: var(--c-ink-500, #8a7a6a);
}
.list {
	flex: 1;
}
.row {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	padding: var(--d-raw-r20, 20rpx);
	margin-bottom: var(--d-raw-r16, 16rpx);
	border-radius: var(--d-raw-r12, 12rpx);
}
.row-pass {
	background-color: var(--c-olive-100, #EAF3E3);
}
.row-fail {
	background-color: var(--c-surface-blush, #F7E3DF);
}
.badge {
	font-size: var(--d-raw-r22, 22rpx);
	font-weight: bold;
	padding: var(--d-raw-r4, 4rpx) var(--d-raw-r12, 12rpx);
	border-radius: var(--d-raw-r8, 8rpx);
	margin-right: var(--d-raw-r16, 16rpx);
	color: var(--c-white, #FFFFFF);
	background-color: var(--c-olive-400, #7C9A6D);
}
.badge-fail {
	background-color: var(--c-rust-500, #B05A3A);
}
.cell {
	display: flex;
	flex-direction: column;
	flex: 1;
}
.name {
	font-size: var(--d-raw-r28, 28rpx);
	color: var(--c-ink-900, #3A2E25);
}
.detail {
	margin-top: var(--d-raw-r6, 6rpx);
	font-size: var(--d-raw-r22, 22rpx);
	color: var(--c-rust-500, #B05A3A);
}
</style>

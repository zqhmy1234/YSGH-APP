		flex: 1;
		background-color: #F6F1E7;
		padding-left: 32rpx;
		padding-right: 32rpx;
		padding-top: 88rpx;
	}
	.serif {
		font-family: "Noto Serif CJK SC", serif;
	}
	.header {
		padding-top: 24rpx;
		padding-bottom: 24rpx;
	}
	.header-title {
		font-size: 52rpx;
		color: #3A2E25;
		font-weight: bold;
		letter-spacing: 6rpx;
	}
	.header-sub {
		margin-top: 8rpx;
		font-size: 26rpx;
		color: #8a7a6a;
	}

	/* 披露 */
	.disclose-card {
		background-color: #FBF7EF;
		border-radius: 8rpx;
		padding: 32rpx;
		box-shadow: 0 6rpx 16rpx rgba(58, 46, 37, 0.12);
	}
	.disclose-title {
		font-size: 34rpx;
		color: #3A2E25;
		font-weight: bold;
		margin-bottom: 20rpx;
	}
	.disclose-item {
		font-size: 26rpx;
		color: #5a4c40;
		line-height: 44rpx;
	}
	.disclose-actions {
		margin-top: 36rpx;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
	}

	/* 三问 */
	.ask-card {
		display: flex;
		flex-direction: column;
	}
	.q-block {
		margin-bottom: 28rpx;
	}
	.q-title {
		font-size: 30rpx;
		color: #3A2E25;
		font-weight: bold;
		margin-bottom: 12rpx;
	}
	.q-input {
		background-color: #FBF7EF;
		border-radius: 8rpx;
		padding: 20rpx;
		min-height: 140rpx;
		font-size: 28rpx;
		color: #3A2E25;
		box-shadow: 0 4rpx 12rpx rgba(58, 46, 37, 0.1);
	}
	.ask-actions {
		margin-top: 20rpx;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
	}

	/* 复述确认 */
	.done-card {
		background-color: #FBF7EF;
		border-radius: 8rpx;
		padding: 32rpx;
		box-shadow: 0 6rpx 16rpx rgba(58, 46, 37, 0.12);
	}
	.done-title {
		font-size: 36rpx;
		color: #3A2E25;
		font-weight: bold;
	}
	.done-confirm {
		margin-top: 16rpx;
		font-size: 28rpx;
		color: #5a4c40;
		line-height: 44rpx;
	}

	/* 按钮 */
	.btn {
		margin-left: 20rpx;
		padding-left: 44rpx;
		padding-right: 44rpx;
		padding-top: 16rpx;
		padding-bottom: 16rpx;
		background-color: #B05A3A;
		border-radius: 8rpx;
	}
	.btn-text {
		color: #F6F1E7;
		font-size: 28rpx;
	}
	.ghost {
		background-color: transparent;
		border-width: 1rpx;
		border-color: #B05A3A;
	}
	.ghost-text {
		color: #B05A3A;
	}
</style>

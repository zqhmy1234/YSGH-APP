<template>
	<!-- ardot 直转 v2：冷启动访谈（帧 4:167）· 审计化生成 -->
	<view class="page-root">
		<!-- 光斑：画布为 GRADIENT_RADIAL，uvue App 端不支持 radial-gradient，
		     改用预混 SVG 圆盘（_genspot.py 生成，纯 <circle fill> 零透明度属性；
		     三光斑经程序验证两两零重叠，且正下方是纯色底 #F8F7F4，可安全预混） -->
		<image class="n4_198" src="/static/icons/i4_198.svg" /> <!-- 光斑-琥珀 画布4:198 -->
		<image class="n4_199" src="/static/icons/i4_199.svg" /> <!-- 光斑-苔绿 画布4:199 -->
		<image class="n4_200" src="/static/icons/i4_200.svg" /> <!-- 光斑-青蓝 画布4:200 -->
		<view class="n4_171"> <!-- 进度点（画布4:171；三问流转：当前问亮锈红） -->
			<view v-for="(i) in 3" :key="i" class="dot" :class="{ 'dot-active': (i - 1) === step, 'dot-first': i === 1 }"></view>
		</view>
		<image class="n4_175" src="/static/icons/i4_175.svg" /> <!-- icon: 品牌星芒 -->
		<view class="n4_177"> <!-- 品牌名容器 -->
			<text class="n4_178">忆述光华</text> <!-- 忆述光华 -->
		</view>
		<view class="n4_179"> <!-- tagline容器 -->
			<text class="n4_180">把日子过成可以回访的故事</text> <!-- tagline -->
		</view>
		<view v-if="!done" class="n4_181"> <!-- 问题卡（三问动态） -->
			<text class="n4_182">访谈 · 第 {{ step + 1 }} 问</text> <!-- 问题编号 -->
			<text class="n4_183">{{ currentQuestion }}</text> <!-- 问题 -->
			<text class="n4_184">随便聊聊，一两句话就够</text> <!-- 问题引导 -->
		</view>
		<view v-else class="n4_181"> <!-- 完成卡（三问答毕） -->
			<text class="n4_182">访谈完成</text>
			<text class="n4_183">谢谢你的分享，已经开始了解你了</text>
			<view class="start-btn" @tap="goHome">
				<text class="start-btn-text">开始使用</text>
			</view>
		</view>
		<view v-if="!done" class="n4_185"> <!-- 语音环 -->
			<view class="n4_186" @tap="onMicTap"> <!-- 麦克风钮 -->
				<image class="n4_187" src="/static/icons/i4_187.svg" /> <!-- icon: 麦克风 -->
			</view>
		</view>
		<view v-if="!done" class="n4_189"> <!-- 说话提示容器 -->
			<text class="n4_190" :class="{ 'hint-recording': recording }" @tap="onMicTap">{{ recording ? '正在录音 ' + recSeconds + '″' : '点按说话' }}</text>
		</view>
		<view v-if="!done" class="n4_191"> <!-- 文字回答容器 -->
			<text class="n4_192" @tap="openTextModal">用文字回答</text> <!-- 用文字回答 -->
		</view>
		<view v-if="!done" class="n4_193"> <!-- 跳过容器 -->
			<text class="n4_194" @tap="skipInterview">跳过访谈</text> <!-- 跳过访谈 -->
		</view>
		<view class="n4_201"> <!-- 呼吸光环外圈 -->
		</view>
		<!-- 文字回答弹层（画布未画此态，沿用 HEAD 版已验证结构；uvue 样式不继承，text 类逐个补 font-family） -->
		<view v-if="showTextModal" class="text-modal">
			<view class="modal-mask" @tap="closeTextModal"></view>
			<view class="modal-card">
				<text class="modal-title">用文字回答</text>
				<textarea class="modal-input" v-model="textAnswer" placeholder="随便聊聊，一两句话就够" placeholder-class="modal-placeholder" :maxlength="200" />
				<view class="modal-actions">
					<view class="modal-btn modal-btn-ghost" @tap="closeTextModal">
						<text class="modal-btn-text ghost-text">取消</text>
					</view>
					<view class="modal-btn" @tap="submitTextAnswer">
						<text class="modal-btn-text">提交</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import {
		fetchInterviewQuestions,
		submitInterviewAnswers,
		InterviewQuestion,
		InterviewResult
	} from '@/utils/play'

	// 兜底三问（API 未就绪时使用，与设计稿冷启动访谈一致）
	const fallbackQuestions: Array<InterviewQuestion> = [
		new InterviewQuestion('important_person', '最近有什么小事，让你印象很深？'),
		new InterviewQuestion('life_turn', '今天有什么瞬间，值得被记住？'),
		new InterviewQuestion('proud_thing', '此刻，最想对谁说一句话？')
	]
	let questions = ref<Array<InterviewQuestion>>(fallbackQuestions)
	const currentQuestion = computed((): string => {
		if (step.value >= 0 && step.value < questions.value.length) {
			return questions.value[step.value].question
		}
		return ''
	})

	// 状态
	let step = ref(0)
	let done = ref(false)
	let recording = ref(false)
	let recSeconds = ref(0)
	let showTextModal = ref(false)
	let textAnswer = ref('')
	let confirmation = ref('')
	let submitting = ref(false)
	let timerId: number = -1
	// 按问题 key 收集答案（后端 answers dict 白名单 key）
	const answers: UTSJSONObject = {}

	onLoad(() => {
		fetchInterviewQuestions().then((list: Array<InterviewQuestion>) => {
			if (list.length > 0) {
				questions.value = list
			}
		})
	})

	// 当前问题 key
	function currentKey(): string {
		if (step.value >= 0 && step.value < questions.value.length) {
			return questions.value[step.value].key
		}
		return ''
	}

	// 麦克风点按：录音 / 停止
	function onMicTap(): void {
		if (!recording.value) {
			startRecording()
		} else {
			stopRecording(true)
		}
	}

	function startRecording(): void {
		recording.value = true
		recSeconds.value = 0
		timerId = setInterval(() => {
			recSeconds.value = recSeconds.value + 1
		}, 1000)
	}

	function stopRecording(advance: boolean): void {
		if (timerId >= 0) {
			clearInterval(timerId)
			timerId = -1
		}
		recording.value = false
		if (advance) {
			// 冷启动语音回答：完整 ASR 链路在记录页；此处先占位，保证三问答案非空闭环
			const k = currentKey()
			if (k != '') {
				answers[k] = '（语音回答 ' + recSeconds.value + ' 秒）'
			}
			uni.showToast({ title: '已记录语音回答', icon: 'none' })
			nextStep()
		}
	}

	// 前进：进入下一问或提交完成
	function nextStep(): void {
		if (step.value < questions.value.length - 1) {
			step.value = step.value + 1
			textAnswer.value = ''
		} else {
			submitAll()
		}
	}

	// 提交三问答案到后端，拿复述确认
	function submitAll(): void {
		if (submitting.value) {
			return
		}
		submitting.value = true
		uni.showLoading({ title: '正在生成画像…' })
		submitInterviewAnswers(answers).then((res: InterviewResult | null) => {
			uni.hideLoading()
			submitting.value = false
			if (res != null && res.confirmation != '') {
				confirmation.value = res.confirmation
			}
			done.value = true
		})
	}

	// 文字回答弹层
	function openTextModal(): void {
		showTextModal.value = true
	}
	function closeTextModal(): void {
		showTextModal.value = false
	}
	function submitTextAnswer(): void {
		if (textAnswer.value.trim() == '') {
			uni.showToast({ title: '写一句话再提交吧', icon: 'none' })
			return
		}
		showTextModal.value = false
		const k = currentKey()
		if (k != '') {
			answers[k] = textAnswer.value.trim()
		}
		uni.showToast({ title: '已记录文字回答', icon: 'none' })
		nextStep()
	}

	// 跳过访谈
	function skipInterview(): void {
		uni.showToast({ title: '已跳过，随时可回来', icon: 'none' })
		setTimeout(() => {
			uni.reLaunch({ url: '/pages/index/index' })
		}, 600)
	}

	// 完成 → 进入时间轴
	function goHome(): void {
		uni.reLaunch({ url: '/pages/index/index' })
	}
</script>

<style>

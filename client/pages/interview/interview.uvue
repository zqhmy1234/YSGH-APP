		display: flex;
		flex-direction: row;
		justify-content: center;
	}
	.dot {
		width: 16rpx;
		height: 16rpx;
		border-radius: 8rpx;
		background-color: #e5ded2;
		margin-left: 7rpx;
		margin-right: 7rpx;
	}
	.dot-active {
		background-color: #b05a3a;
	}

	/* 金色四角星 */
	.sparkle {

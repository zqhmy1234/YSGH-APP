		color: #b05a3a;
	}

	/* 跳过访谈 */
	.skip {
		position: absolute;
		left: 0;
		right: 0;
		top: 1422rpx;
		text-align: center;
		font-size: 26rpx;
		color: #b3a696;
	}

	/* 主页指示条 */
	.home-bar {
		position: absolute;
		left: 250rpx;

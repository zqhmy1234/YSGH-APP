		margin-top: 26rpx;
		font-size: 40rpx;
		font-weight: bold;
		color: #3a2e25;
		line-height: 40rpx;
	}
	.card-hint {
		margin-top: 28rpx;
		font-size: 26rpx;
		line-height: 26rpx;
		color: #8a7a6a;
	}

	/* 完成卡「开始使用」按钮 */
	.start-btn {
		margin-top: 32rpx;
		height: 76rpx;
		border-radius: 38rpx;
		background-color: #b05a3a;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.start-btn-text {
		font-size: 30rpx;

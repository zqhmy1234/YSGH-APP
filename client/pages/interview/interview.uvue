<template>
	<view class="page">
		<view class="header">
			<text class="header-title serif">冷启动访谈</text>
			<text class="header-sub">回答三个问题，让记忆整理更懂你</text>
		</view>

		<!-- 三层披露（T-PL-2）：先披露再作答 -->
		<view v-if="step === 'disclose'" class="disclose-card">
			<text class="disclose-title serif">关于你的回答</text>
			<text class="disclose-item">1. 仅用于记忆整理与个性化回顾，不会对外分享</text>
			<text class="disclose-item">2. 可以随时修改或清空你的画像</text>
			<text class="disclose-item">3. 未命中的回答不会写入画像（闭集约束）</text>
			<view class="disclose-actions">
				<view class="btn ghost" @tap="skipInterview">
					<text class="btn-text ghost-text">跳过</text>
				</view>
				<view class="btn" @tap="beginInterview">
					<text class="btn-text">知道了，开始</text>
				</view>
			</view>
		</view>

		<!-- 三问作答 -->
		<view v-else-if="step === 'ask'" class="ask-card">
			<view v-for="(q, qi) in questions" :key="q.key" class="q-block">
				<text class="q-title serif">{{ qi + 1 }}. {{ q.question }}</text>
				<textarea class="q-input serif" v-model="answers[q.key]" :maxlength="500" placeholder="说点什么…" />
			</view>
			<view class="ask-actions">
				<view class="btn ghost" @tap="skipInterview">
					<text class="btn-text ghost-text">跳过</text>
				</view>
				<view class="btn" @tap="submitAnswers">
					<text class="btn-text">{{ submitting ? '提交中…' : '提交' }}</text>
				</view>
			</view>
		</view>

		<!-- 复述确认（B1-6 档案确认闭环） -->
		<view v-else-if="step === 'done'" class="done-card">
			<text class="done-title serif">谢谢你的分享</text>
			<text class="done-confirm">{{ confirmation }}</text>
			<view class="btn" @tap="finishInterview">
				<text class="btn-text">完成</text>
			</view>
		</view>
	</view>
		<!-- 玻璃 TabBar（半透明白 55% + 中央＋按钮） -->
		<view class="glass-tabbar">
			<view class="tabbar-item  pressable" @tap="goIndex">
				<text class="tabbar-icon">🏠</text>
				<text class="tabbar-label">时间轴</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goSearch">
				<text class="tabbar-icon">🔍</text>
				<text class="tabbar-label">搜索</text>
			</view>
			<view class="tabbar-fab pressable" @tap="goRecord">
				<text class="tabbar-fab-icon">+</text>
			</view>
			<view class="tabbar-item  pressable" @tap="goMessages">
				<text class="tabbar-icon">💬</text>
				<text class="tabbar-label">消息</text>
			</view>
			<view class="tabbar-item active pressable" @tap="goProfile">
				<text class="tabbar-icon">👤</text>
				<text class="tabbar-label">我的</text>
			</view>
		</view>

</template>

<script setup lang="uts">
	import { onLoad } from '@dcloudio/uni-app'
	import { ensureLogin } from '@/utils/auth'
	import { fetchInterviewQuestions, submitInterviewAnswers, InterviewQuestion, InterviewResult } from '@/utils/play'
	import { showErrorToast } from '@/utils/api'

	// 响应式数据
	let step = 'disclose'
	let questions: Array<InterviewQuestion> = []
	let answers = UTSJSONObject()
	let submitting = false
	let confirmation = ''

	// 生命周期
	onLoad(() => {
		ensureLogin().then((ok: boolean) => {
			if (!ok) {
				showErrorToast(new Error('登录失败，请重试'))
				return
			}
			fetchInterviewQuestions().then((qs: Array<InterviewQuestion>) => {
				if (qs.length > 0) {
					questions = qs
					for (let i = 0; i < qs.length; i++) {
						answers.set(qs[i].key, '')
					}
					step = 'disclose'
				} else {
					showErrorToast(new Error('访谈问题加载失败'))
				}
			})
		})
	})

	// 导航方法
	function goIndex(): void {
		uni.navigateTo({ url: '/pages/index/index' })
	}
	function goSearch(): void {
		uni.navigateTo({ url: '/pages/search/search' })
	}
	function goRecord(): void {
		uni.navigateTo({ url: '/pages/record/record' })
	}
	function goMessages(): void {
		uni.navigateTo({ url: '/pages/messages/messages' })
	}
	function goProfile(): void {
		uni.navigateTo({ url: '/pages/profile/profile' })
	}

	// 业务方法
	function beginInterview(): void {
		step = 'ask'
	}
	function submitAnswers(): void {
		let filled = 0
		for (let i = 0; i < questions.length; i++) {
			const v = answers.getString(questions[i].key) ?? ''
			if (v.trim() != '') {
				filled++
			}
		}
		if (filled === 0) {
			showErrorToast(new Error('至少回答一个问题'))
			return
		}
		submitting = true
		submitInterviewAnswers(answers).then((res: InterviewResult | null) => {
			submitting = false
			if (res != null) {
				confirmation = res.confirmation
				step = 'done'
			} else {
				showErrorToast(new Error('提交失败，请重试'))
			}
		})
	}
	function skipInterview(): void {
		uni.showToast({ title: '已跳过，随时可回来', icon: 'none' })
		setTimeout(() => {
			uni.navigateBack({})
		}, 800)
	}
	function finishInterview(): void {
		uni.navigateBack({})
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #f8f7f4;
		padding-left: 0;
		padding-right: 0;
		padding-top: 88rpx;
	}
	.serif {
		font-family: "Noto Serif CJK SC", serif;
	}
	.header {
		padding-top: 24rpx;
		padding-bottom: 24rpx;
	}
	.header-title {
		font-size: 52rpx;
		color: #3a2e25;
		font-weight: bold;
		letter-spacing: 6rpx;
	}
	.header-sub {
		margin-top: 8rpx;
		font-size: 26rpx;
		color: #8a7a6a;
	}

	/* 披露 */
	.disclose-card {
		background-color: #ffffff;
		border-radius: 40rpx;
		padding: 32rpx;
		box-shadow: 0 6rpx 16rpx rgba(58, 46, 37, 0.12);
	}
	.disclose-title {
		font-size: 34rpx;
		color: #3a2e25;
		font-weight: bold;
		margin-bottom: 20rpx;
	}
	.disclose-item {
		font-size: 26rpx;
		color: #5a4c40;
		line-height: 44rpx;
	}
	.disclose-actions {
		margin-top: 36rpx;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
	}

	/* 三问 */
	.ask-card {
		display: flex;
		flex-direction: column;
	}
	.q-block {
		margin-bottom: 28rpx;
	}
	.q-title {
		font-size: 30rpx;
		color: #3a2e25;
		font-weight: bold;
		margin-bottom: 12rpx;
	}
	.q-input {
		background-color: #ffffff;
		border-radius: 8rpx;
		padding: 20rpx;
		min-height: 140rpx;
		font-size: 28rpx;
		color: #3a2e25;
		box-shadow: 0 4rpx 12rpx rgba(58, 46, 37, 0.1);
	}
	.ask-actions {
		margin-top: 20rpx;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
	}

	/* 复述确认 */
	.done-card {
		background-color: #ffffff;
		border-radius: 40rpx;
		padding: 32rpx;
		box-shadow: 0 6rpx 16rpx rgba(58, 46, 37, 0.12);
	}
	.done-title {
		font-size: 36rpx;
		color: #3a2e25;
		font-weight: bold;
	}
	.done-confirm {
		margin-top: 16rpx;
		font-size: 28rpx;
		color: #5a4c40;
		line-height: 44rpx;
	}

	/* 按钮 */
	.btn {
		margin-left: 20rpx;
		padding-left: 44rpx;
		padding-right: 44rpx;
		padding-top: 16rpx;
		padding-bottom: 16rpx;
		background-color: #b05a3a;
		border-radius: 8rpx;
	}
	.btn-text {
		color: #f8f7f4;
		font-size: 28rpx;
	}
	.ghost {
		background-color: transparent;
		border-width: 1rpx;
		border-color: #b05a3a;
	}
	.ghost-text {
		color: #b05a3a;
	}
</style>

<template>
	<view class="page">
		<!-- 氛围渐变圆（设计稿 3 处径向光斑：琥珀上左 / 青绿上右 / 蓝灰中左） -->
		<view class="glow glow-amber"></view>
		<view class="glow glow-green"></view>
		<view class="glow glow-blue"></view>

		<!-- 进度指示点（3 问，设计稿 dots y=68 · 激活 #B05A3A / 未激活 #E5DED2） -->
		<view class="dots-row">
			<view v-for="(i) in 3" :key="i" class="dot" :class="{ 'dot-active': (i - 1) === step }"></view>
		</view>

		<!-- 金色四角星装饰（设计稿 30x30 @180,99，中心 ~195,114） -->
		<view class="sparkle">
			<hens-svg :src="sparkleSvg" :width="30" :height="30" color="#C4913C" />
		</view>

		<!-- 品牌名 + 标语（设计稿 y=142 / y=172 居中） -->
		<text class="brand-title serif">忆述光华</text>
		<text class="brand-slogan">把日子过成可以回访的故事</text>

		<!-- 问题卡片（设计稿 350x113 @20,220 rx=20 · 三行：琥珀序号/深褐问题/灰提示） -->
		<view v-if="!done" class="interview-card">
			<text class="card-index">访谈 · 第 {{ step + 1 }}问</text>
			<text class="card-question serif">{{ currentQuestion }}</text>
			<text class="card-hint">随便聊聊，一两句话就够</text>
		</view>

		<!-- 完成卡片（三问答毕） -->
		<view v-else class="interview-card">
			<text class="card-index">访谈完成</text>
			<text class="card-question serif">谢谢你的分享，已经开始了解你了</text>
			<view class="start-btn pressable" @tap="goHome">
				<text class="start-btn-text">开始使用</text>
			</view>
		</view>

		<!-- 录音区：同心环 + 麦克风按钮（设计稿中心 ~195,490） -->
		<view v-if="!done" class="record-orbit">
			<view class="ring ring-outer"></view>
			<view class="ring ring-inner"></view>
			<view class="mic-btn pressable" @tap="onMicTap">
				<hens-svg :src="micSvg" :width="17" :height="22" color="#FFFFFF" />
			</view>
		</view>
		<view v-if="!done" class="record-hint" :class="{ 'hint-recording': recording }">{{ recording ? '正在录音 ' + recSeconds + '″' : '点按说话' }}</view>
		<view v-if="!done" class="text-answer pressable" @tap="openTextModal">用文字回答</view>

		<!-- 跳过访谈 -->
		<text v-if="!done" class="skip pressable" @tap="skipInterview">跳过访谈</text>

		<!-- 主页指示条（设计稿 y=828） -->
		<view class="home-bar"></view>

		<!-- 文字回答弹层 -->
		<view v-if="showTextModal" class="text-modal">
			<view class="modal-mask" @tap="closeTextModal"></view>
			<view class="modal-card">
				<text class="modal-title serif">用文字回答</text>
				<textarea class="modal-input" v-model="textAnswer" placeholder="随便聊聊，一两句话就够" placeholder-class="modal-placeholder" :maxlength="200" />
				<view class="modal-actions">
					<view class="modal-btn modal-btn-ghost pressable" @tap="closeTextModal">
						<text class="modal-btn-text ghost-text">取消</text>
					</view>
					<view class="modal-btn pressable" @tap="submitTextAnswer">
						<text class="modal-btn-text">提交</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import {
		fetchInterviewQuestions,
		submitInterviewAnswers,
		InterviewQuestion,
		InterviewResult
	} from '@/utils/play'

	// 兜底三问（API 未就绪时使用，与设计稿冷启动访谈一致）
	const fallbackQuestions: Array<InterviewQuestion> = [
		new InterviewQuestion('important_person', '最近有什么小事，让你印象很深？'),
		new InterviewQuestion('life_turn', '今天有什么瞬间，值得被记住？'),
		new InterviewQuestion('proud_thing', '此刻，最想对谁说一句话？')
	]
	let questions = ref<Array<InterviewQuestion>>(fallbackQuestions)
	const currentQuestion = computed((): string => {
		if (step.value >= 0 && step.value < questions.value.length) {
			return questions.value[step.value].question
		}
		return ''
	})

	// 麦克风图标（设计稿 path，viewBox 对齐 -2..16 / -2..22）
	const micSvg: string = '<svg viewBox="-2 -2 18 24" xmlns="http://www.w3.org/2000/svg"><path d="M10.1058 0.1859Q11.375 1.4551 11.375 3.25L11.375 8.6667Q11.375 10.4616 10.1058 11.7308Q8.8366 13 7.0417 13Q5.2467 13 3.9775 11.7308Q2.7083 10.4616 2.7083 8.6667L2.7083 3.25Q2.7083 1.4551 3.9775 0.1859Q5.2467 -1.0833 7.0417 -1.0833Q8.8366 -1.0833 10.1058 0.1859ZM8.5737 1.7179Q7.9391 1.0833 7.0417 1.0833Q6.1442 1.0833 5.5096 1.7179Q4.875 2.3525 4.875 3.25L4.875 8.6667Q4.875 9.5641 5.5096 10.1987Q6.1442 10.8333 7.0417 10.8333Q7.9391 10.8333 8.5737 10.1987Q9.2083 9.5641 9.2083 8.6667L9.2083 3.25Q9.2083 2.3525 8.5737 1.7179ZM2.8285 12.8799Q1.0833 11.1347 1.0833 8.6667Q1.0964 8.2125 0.766 7.9006Q0.4541 7.5703 0 7.5833Q-0.4541 7.5703 -0.766 7.9006Q-1.0964 8.2125 -1.0833 8.6667Q-1.0833 12.0322 1.2964 14.4119Q3.2837 16.3992 5.9583 16.7269L5.9583 19.5Q5.9453 19.9541 6.2756 20.266Q6.5875 20.5964 7.0417 20.5833Q7.4958 20.5964 7.8077 20.266Q8.1381 19.9541 8.125 19.5L8.125 16.7269Q10.7997 16.3992 12.7869 14.4119Q15.1667 12.0322 15.1667 8.6667Q15.1797 8.2125 14.8494 7.9006Q14.5375 7.5703 14.0833 7.5833Q13.6292 7.5703 13.3173 7.9006Q12.9869 8.2125 13 8.6667Q13 11.1347 11.2549 12.8799Q9.5097 14.625 7.0417 14.625Q4.5736 14.625 2.8285 12.8799Z"/></svg>'

	// 状态
	let step = ref(0)
	let done = ref(false)
	let recording = ref(false)
	let recSeconds = ref(0)
	let showTextModal = ref(false)
	let textAnswer = ref('')
	let confirmation = ref('')
	let submitting = ref(false)
	let timerId: number = -1
	// 按问题 key 收集答案（后端 answers dict 白名单 key）
	const answers: UTSJSONObject = {}

	onLoad(() => {
		fetchInterviewQuestions().then((list: Array<InterviewQuestion>) => {
			if (list.length > 0) {
				questions.value = list
			}
		})
	})

	// 当前问题 key
	function currentKey(): string {
		if (step.value >= 0 && step.value < questions.value.length) {
			return questions.value[step.value].key
		}
		return ''
	}

	// 麦克风点按：录音 / 停止
	function onMicTap(): void {
		if (!recording.value) {
			startRecording()
		} else {
			stopRecording(true)
		}
	}

	function startRecording(): void {
		recording.value = true
		recSeconds.value = 0
		timerId = setInterval(() => {
			recSeconds.value = recSeconds.value + 1
		}, 1000)
	}

	function stopRecording(advance: boolean): void {
		if (timerId >= 0) {
			clearInterval(timerId)
			timerId = -1
		}
		recording.value = false
		if (advance) {
			// 冷启动语音回答：完整 ASR 链路在记录页；此处先占位，保证三问答案非空闭环
			const k = currentKey()
			if (k != '') {
				answers[k] = '（语音回答 ' + recSeconds.value + ' 秒）'
			}
			uni.showToast({ title: '已记录语音回答', icon: 'none' })
			nextStep()
		}
	}

	// 前进：进入下一问或提交完成
	function nextStep(): void {
		if (step.value < questions.value.length - 1) {
			step.value = step.value + 1
			textAnswer.value = ''
		} else {
			submitAll()
		}
	}

	// 提交三问答案到后端，拿复述确认
	function submitAll(): void {
		if (submitting.value) {
			return
		}
		submitting.value = true
		uni.showLoading({ title: '正在生成画像…' })
		submitInterviewAnswers(answers).then((res: InterviewResult | null) => {
			uni.hideLoading()
			submitting.value = false
			if (res != null && res.confirmation != '') {
				confirmation.value = res.confirmation
			}
			done.value = true
		})
	}

	// 文字回答弹层
	function openTextModal(): void {
		showTextModal.value = true
	}
	function closeTextModal(): void {
		showTextModal.value = false
	}
	function submitTextAnswer(): void {
		if (textAnswer.value.trim() == '') {
			uni.showToast({ title: '写一句话再提交吧', icon: 'none' })
			return
		}
		showTextModal.value = false
		const k = currentKey()
		if (k != '') {
			answers[k] = textAnswer.value.trim()
		}
		uni.showToast({ title: '已记录文字回答', icon: 'none' })
		nextStep()
	}

	// 跳过访谈
	function skipInterview(): void {
		uni.showToast({ title: '已跳过，随时可回来', icon: 'none' })
		setTimeout(() => {
			uni.reLaunch({ url: '/pages/index/index' })
		}, 600)
	}

	// 完成 → 进入时间轴
	function goHome(): void {
		uni.reLaunch({ url: '/pages/index/index' })
	}
</script>

<style>
	/* 冷启动访谈页 · 像素级还原 design_data_for_agents/06_冷启动访谈（390x844 画布，px×2=rpx）
	   背景 #F8F7F4 / 主文字 #3A2E25 / 次文字 #8A7A6A / 琥珀 #C4913C / 锈红 #B05A3A */
	.page {
		position: relative;
		width: 100%;
		height: 100%;
		background-color: #f8f7f4;
		overflow: hidden;
	}
	.serif {
		font-family: "Sarasa Gothic SC", serif;
	}

	/* 氛围渐变圆 */
	.glow {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}
	.glow-amber {
		left: -120rpx;
		top: 80rpx;
		width: 560rpx;
		height: 560rpx;
		background-color: rgba(196, 145, 59, 0.08);
	}
	.glow-green {
		left: 440rpx;
		top: 340rpx;
		width: 520rpx;
		height: 520rpx;
		background-color: rgba(121, 139, 90, 0.065);
	}
	.glow-blue {
		left: 60rpx;
		top: 660rpx;
		width: 480rpx;
		height: 480rpx;
		background-color: rgba(78, 124, 139, 0.055);
	}

	/* 进度指示点（3 个，8px 直径，间距 14px） */
	.dots-row {
		position: absolute;
		left: 0;
		right: 0;
		top: 128rpx;
		display: flex;
		flex-direction: row;
		justify-content: center;
	}
	.dot {
		width: 16rpx;
		height: 16rpx;
		border-radius: 8rpx;
		background-color: #e5ded2;
		margin-left: 7rpx;
		margin-right: 7rpx;
	}
	.dot-active {
		background-color: #b05a3a;
	}

	/* 金色四角星 */
	.sparkle {
		position: absolute;
		left: 360rpx;
		top: 198rpx;
		width: 60rpx;
		height: 60rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* 品牌名 + 标语 */
	.brand-title {
		position: absolute;
		left: 0;
		right: 0;
		top: 284rpx;
		text-align: center;
		font-size: 40rpx;
		font-weight: bold;
		color: #3a2e25;
	}
	.brand-slogan {
		position: absolute;
		left: 0;
		right: 0;
		top: 344rpx;
		text-align: center;
		font-size: 26rpx;
		color: #8a7a6a;
	}

	/* 问题卡片 */
	.interview-card {
		position: absolute;
		left: 40rpx;
		top: 440rpx;
		width: 700rpx;
		min-height: 226rpx;
		background-color: #ffffff;
		border-radius: 40rpx;
		padding-left: 40rpx;
		padding-right: 40rpx;
		padding-top: 40rpx;
		padding-bottom: 46rpx;
		box-shadow: 0 8rpx 24rpx rgba(58, 46, 37, 0.08);
	}
	.card-index {
		font-size: 20rpx;
		line-height: 20rpx;
		color: #c4913c;
	}
	.card-question {
		margin-top: 26rpx;
		font-size: 40rpx;
		font-weight: bold;
		color: #3a2e25;
		line-height: 40rpx;
	}
	.card-hint {
		margin-top: 28rpx;
		font-size: 26rpx;
		line-height: 26rpx;
		color: #8a7a6a;
	}

	/* 完成卡「开始使用」按钮 */
	.start-btn {
		margin-top: 32rpx;
		height: 76rpx;
		border-radius: 38rpx;
		background-color: #b05a3a;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.start-btn-text {
		font-size: 30rpx;
		color: #f8f7f4;
		font-weight: 600;
	}

	/* 录音区：同心环 + 麦克风 */
	.record-orbit {
		position: absolute;
		left: 250rpx;
		top: 840rpx;
		width: 280rpx;
		height: 280rpx;
	}
	.ring {
		position: absolute;
		border-radius: 50%;
	}
	.ring-outer {
		left: 0;
		top: 0;
		width: 280rpx;
		height: 280rpx;
		background-color: rgba(176, 89, 59, 0.2);
	}
	.ring-inner {
		left: 32rpx;
		top: 32rpx;
		width: 216rpx;
		height: 216rpx;
		background-color: rgba(176, 89, 59, 0.4);
	}
	.mic-btn {
		position: absolute;
		left: 76rpx;
		top: 76rpx;
		width: 128rpx;
		height: 128rpx;
		border-radius: 64rpx;
		background-color: #b05a3a;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 8rpx 24rpx rgba(176, 90, 58, 0.35);
	}
	.record-hint {
		position: absolute;
		left: 0;
		right: 0;
		top: 1124rpx;
		text-align: center;
		font-size: 26rpx;
		color: #5a4c40;
	}
	.hint-recording {
		color: #b05a3a;
	}
	.text-answer {
		position: absolute;
		left: 0;
		right: 0;
		top: 1188rpx;
		text-align: center;
		font-size: 26rpx;
		color: #b05a3a;
	}

	/* 跳过访谈 */
	.skip {
		position: absolute;
		left: 0;
		right: 0;
		top: 1482rpx;
		text-align: center;
		font-size: 26rpx;
		color: #b3a696;
	}

	/* 主页指示条 */
	.home-bar {
		position: absolute;
		left: 250rpx;
		top: 1656rpx;
		width: 280rpx;
		height: 10rpx;
		border-radius: 5rpx;
		background-color: #3a2e25;
		opacity: 0.18;
	}

	/* 文字回答弹层 */
	.text-modal {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 99;
	}
	.modal-mask {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(58, 46, 37, 0.35);
	}
	.modal-card {
		width: 620rpx;
		background-color: #ffffff;
		border-radius: 32rpx;
		padding: 40rpx;
		z-index: 1;
		box-shadow: 0 16rpx 48rpx rgba(58, 46, 37, 0.18);
	}
	.modal-title {
		font-size: 34rpx;
		font-weight: bold;
		color: #3a2e25;
	}
	.modal-input {
		margin-top: 24rpx;
		width: 540rpx;
		min-height: 180rpx;
		background-color: #f8f7f4;
		border-radius: 20rpx;
		padding: 24rpx;
		font-size: 28rpx;
		color: #3a2e25;
	}
	.modal-placeholder {
		color: #b3a696;
	}
	.modal-actions {
		margin-top: 28rpx;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
	}
	.modal-btn {
		margin-left: 20rpx;
		padding-left: 44rpx;
		padding-right: 44rpx;
		height: 72rpx;
		border-radius: 36rpx;
		background-color: #b05a3a;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.modal-btn-ghost {
		background-color: transparent;
		border-width: 2rpx;
		border-color: #b05a3a;
	}
	.modal-btn-text {
		font-size: 28rpx;
		color: #f8f7f4;
	}
	.ghost-text {
		color: #b05a3a;
	}

	/* 按压态 */
	.pressable {
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
</style>

		text-align: center;
		font-size: 40rpx;
		font-weight: bold;
		color: #3a2e25;
	}
	.brand-slogan {
		position: absolute;
		left: 0;
		right: 0;
		top: 344rpx;
		text-align: center;
		font-size: 26rpx;
		color: #8a7a6a;
	}

	/* 问题卡片 */
	.interview-card {
		position: absolute;
		left: 40rpx;
		top: 440rpx;
		width: 700rpx;
		min-height: 226rpx;
		background-color: rgba(255, 255, 255, 0.55);
		border: 2rpx solid rgba(255, 255, 255, 0.6);
		border-radius: 40rpx;
		padding-left: 40rpx;
		padding-right: 40rpx;
		padding-top: 40rpx;
		padding-bottom: 46rpx;
		box-shadow: 0 8rpx 24rpx rgba(58, 46, 37, 0.08);
	}

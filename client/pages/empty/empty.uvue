<template>
	<view class="page tk-root">
		<!-- 空状态独立页：画布 2:284~2:311「补充态·空状态」帧 390×600（×2rpx 直换，独立页面非时间轴内嵌态） -->
		<view class="center-empty">
			<!-- 插画组合：组合框 (135,90) 120×126pt，太阳 (56,0) 60×60pt（SVG 已烘焙整帧含留白），山湖 (0,36) 120×90pt -->
			<view class="empty-illus">
				<image class="empty-sun" src="/static/icons/i2_302.svg" mode="aspectFit" />
				<view class="empty-lake"><image class="empty-lake-img" src="/static/icons/i2_304.svg" mode="aspectFit" /></view>
			</view>
			<text class="empty-title">还没有回忆</text>
			<text class="empty-desc">拍一张照片，或说几句话</text>
			<text class="empty-desc empty-desc2">你的回忆会住在这里</text>
			<view class="empty-cta pressable" @tap="onTakeFirst">
				<text class="empty-cta-text">拍下第一张</text>
			</view>
			<view class="empty-voice pressable" @tap="goVoice">
				<text class="empty-voice-text">或者，录一段语音</text>
			</view>
		</view>

		<!-- 玻璃 TabBar（画布空态帧未画，产品上首启页必须保留主导航） -->
		<TabBar active="index" @plus="sheetOpen = true" />

		<!-- 记录面板浮层：点 TabBar 中央 + 或「录一段语音」就地拉起，不跳页（产品定义铁律）；
		     firstPhoto=true 时带 initialMode='photo' 直达拍照流（直弹相机） -->
		<RecordSheet v-if="sheetOpen" :initial-mode="firstPhoto ? 'photo' : ''" @close="onSheetClose" @saved="onRecordSaved" />
	</view>
</template>

<script setup>
	// CTA「拍下第一张」：走记录面板拍照流（直弹相机→拍照表单），与面板「拍照」入口完全同通路。
	// 旧实现 photoWatch 原生监听已废弃（标准基座必炸 + 语义不符，§N 台账）

	// 记录面板浮层开关（TabBar 中央 + / 录一段语音 / 拍下第一张 触发，就地拉起不跳页）
	let sheetOpen = ref(false)
	// 「拍下第一张」直达拍照流标记（带 initialMode='photo'，浮层关闭时复位）
	let firstPhoto = ref(false)

	// 返回键拦截：浮层开着时先关浮层，而不是退出页面（返回 true = 已自行处理）
	onBackPress((): boolean => {
		if (sheetOpen.value) {
			sheetOpen.value = false
			return true
		}
		return false
	})

	// RecordSheet 保存成功回调（empty 页无可刷新数据，占位收口）
	function onRecordSaved(): void {
	}

	function onTakeFirst(): void {
		// 峰宝 09-02 拍板（P6）：拍下第一张 = 走记录面板拍照流（直弹相机）。
		// 旧实现 createPhotoWatch 原生监听：标准基座必炸（实机 toast「不支持相册接入」），
		// 且「监听相册」≠「拍照」，语义本就不对——入口与 RecordSheet 拍照入口完全同通路
		firstPhoto.value = true
		sheetOpen.value = true
	}

	// 浮层关闭统一出口（复位 firstPhoto，防止下次从 TabBar + 打开还带拍照直达）
	function onSheetClose(): void {
		sheetOpen.value = false
		firstPhoto.value = false
	}

	// 「或者，录一段语音」：就地拉起记录面板浮层
	function goVoice(): void {
		sheetOpen.value = true
	}
</script>

<style>
	/* 画布帧仅 600pt 高、真机约 844pt——绝对定位会整体偏顶，改为 flex 垂直居中（峰宝定稿：画面正中央） */
	.page {
		flex: 1;
		font-family: "Sarasa Gothic SC", sans-serif;
		background-color: var(--c-paper-100, #f8f7f4);
		justify-content: center;
	}
	.center-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	/* 画布 2:301/2:303 插画组合：组合框 120×126pt，太阳 60pt，山湖 120×90pt */
	.empty-illus {
		position: relative;
		width: var(--d-raw-r240, 240rpx);
		height: var(--d-lattice-p131, 252rpx);
	}
	/* 画布 2:301 太阳帧 60×60pt=120rpx；SVG 原生 60×60px 已含 16px 环心留白，直接铺满 */
	.empty-sun {
		position: absolute;
		left: var(--d-raw-r112, 112rpx);
		top: 0;
		width: var(--d-raw-r120, 120rpx);
		height: var(--d-raw-r120, 120rpx);
	}
	.empty-lake {
		position: absolute;
		left: 0;
		top: var(--d-raw-r72, 72rpx);
		width: var(--d-raw-r240, 240rpx);
		height: var(--d-raw-r180, 180rpx);
	}
	.empty-lake-img {
		position: absolute;
		left: var(--d-raw-r24, 24rpx);
		top: var(--d-raw-r24, 24rpx);
		width: var(--d-raw-r192, 192rpx);
		height: var(--d-raw-r112, 112rpx);
	}
	/* 画布 2:306 标题 22 SemiBold #3A2E25 @y250，间隔 34pt */
	.empty-title {
		font-family: "Sarasa Gothic SC", sans-serif;
		margin-top: 68rpx;
		font-size: var(--d-raw-r44, 44rpx);
		line-height: var(--d-raw-r62, 62rpx);
		color: var(--c-ink-900, #3a2e25);
		font-weight: 600;
	}
	/* 画布 2:308/2:309 引导 14pt #8A7A6A @y292/y313（行距 21pt） */
	.empty-desc {
		font-family: "Sarasa Gothic SC", sans-serif;
		margin-top: var(--d-raw-r22, 22rpx);
		font-size: var(--d-raw-r28, 28rpx);
		color: var(--c-ink-500, #8a7a6a);
		text-align: center;
		line-height: var(--d-raw-r42, 42rpx);
	}
	.empty-desc2 {
		margin-top: 0;
	}
	/* 画布 2:284 主按钮 250×56 圆角28 阴影(0,6,16,a0.3) @y370，距引导底 36pt */
	.empty-cta {
		margin-top: var(--d-raw-r72, 72rpx);
		width: var(--d-lattice-p260, 500rpx);
		height: var(--d-raw-r112, 112rpx);
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: var(--c-rust-500, #b05a3a);
		border-radius: var(--d-raw-r56, 56rpx);
		box-shadow: 0 var(--d-raw-r12, 12rpx) var(--d-raw-r32, 32rpx) var(--a-rust-30, rgba(176, 89, 58, 0.3));
	}
	.empty-cta-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		color: var(--c-white, #ffffff);
		font-size: var(--d-raw-r32, 32rpx);
		font-weight: 600;
	}
	/* 画布 2:311 备选 14 SemiBold #B05A3A @y452，距按钮 26pt */
.empty-voice {
	/* text@tap 清零军规（2026-09-06）：view 承载热区 */
	font-family: "Sarasa Gothic SC", sans-serif;
	margin-top: var(--d-lattice-p27, 52rpx);
	padding: var(--d-lattice-p6, 11.5rpx) var(--d-lattice-p0, 0rpx);
	align-items: center;
}
.empty-voice-text {
	font-family: "Sarasa Gothic SC", sans-serif;
	font-size: var(--d-raw-r28, 28rpx);
	font-weight: 600;
	color: var(--c-rust-500, #b05a3a);
}
	.pressable {
		font-family: "Sarasa Gothic SC", sans-serif;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
</style>

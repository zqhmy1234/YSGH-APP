		margin-right: 15.4rpx;
	}
	.summary-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 500;
		font-size: 25rpx;
		color: #3A2E25;
	}
	.section-label {
		margin-top: 30.8rpx;
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 500;
		font-size: 23.1rpx;
		color: #8A7A6A;
	}
	.opt-list {
		width: 100%;
		margin-top: 30.8rpx;
		flex-direction: column;
	}
	.opt {
		width: 100%;
		height: 100rpx;
		background-color: #FFFFFF;
		border-width: 1.9rpx;
		border-color: #EDE5D5;
		border-radius: 23.1rpx;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-left: 26.9rpx;
		padding-right: 26.9rpx;
		overflow: hidden;
	}
	/* 选中态叠加类（只覆盖描边色 = chip 系合法先例；须写在 .opt 之后；§W 补刀锈红） */
	.opt-on {
		border-color: #B05A3A;
	}
	.opt-texts {
		flex-direction: column;
	}
	.opt-main {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 500;
		font-size: 26.9rpx;
		color: #3A2E25;
	}
	.opt-sub {
		/* 画布选项内 gap=2px → margin（gap 引擎丢弃） */
		margin-top: 3.8rpx;
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 21.2rpx;
		color: #8A7A6A;
	}
	.opt-check {

<template>
	<!-- 底部四宫格 Tab（T-NA-1）：时间轴/记录/搜索/我的；选中态锈红，视觉规范（相纸白底/墨褐/锈红） -->
	<view class="tabbar">
		<view v-for="item in tabs" :key="item.key" class="tab-item" @tap="onTap(item.key)">
			<text class="tab-icon" :class="item.key === current ? 'icon-active' : ''">{{ item.icon }}</text>
			<text class="tab-label" :class="item.key === current ? 'label-active' : ''">{{ item.label }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	defineProps({
		current: {
			type: String,
			default: 'home'
		}
	})

	class TabItem {
		key: string
		label: string
		icon: string
		constructor(key: string, label: string, icon: string) {
			this.key = key
			this.label = label
			this.icon = icon
		}
	}

	let tabs: Array<TabItem> = [
		new TabItem('home', '时间轴', '🖼️'),
		new TabItem('record', '记录', '✍️'),
		new TabItem('search', '搜索', '🔍'),
		new TabItem('profile', '我的', '🕮')
	]

	function onTap(key: string): void {
		const routes: Map<string, string> = new Map<string, string>()
		routes.set('home', '/pages/index/index')
		routes.set('record', '/pages/record/record')
		routes.set('search', '/pages/search/search')
		routes.set('profile', '/pages/profile/profile')
		const url = routes.get(key)
		if (url != null) {
			uni.reLaunch({ url: url })
		}
	}
</script>

<style>
	.tabbar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		height: 108rpx;
		padding-bottom: env(safe-area-inset-bottom);
		background-color: #FBF7EF;
		border-top-width: 1rpx;
		border-top-color: rgba(58, 46, 37, 0.12);
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.tab-item {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	.tab-icon {
		font-size: 40rpx;
		line-height: 48rpx;
		opacity: 0.45;
	}
	.icon-active {
		opacity: 1;
	}
	.tab-label {
		margin-top: 4rpx;
		font-size: 20rpx;
		color: #8a7a6a;
	}
	.label-active {
		color: #B05A3A;
		font-weight: bold;
	}
</style>

<template>
	<!-- B10 方案A P2：自 pages/index/index.uvue 整体搬迁；TabBar/RecordSheet 挂载与
	     页级生命周期/ensureLogin 上收 shell（契约见 script），处置记录台账 §EE -->
<view class="page tk-root">
		<!-- 照片出血氛围层（390x300 湖面图 + 顶部横向暗化 + 底部横向米色溶解） -->
		<view class="hero-section">
			<image class="hero-image" src="/static/hero-lake.jpg" mode="aspectFill" lazy-load="true" />
			<view class="hero-overlay-top"></view>
			<view class="hero-overlay-bottom"></view>
			<view class="hero-avatar"><text class="hero-avatar-char serif">峰</text></view>
			<view class="hero-content">
				<text class="hero-title serif">回忆</text>
				<!-- R8：数据驱动化（此前硬编码画布示意文案「八月 · 28 条新记忆/清晨的湖边」= 峰宝 09-06 投诉的模板 UI 之一） -->
				<!-- ⚠️ 2026-10-11（视觉审查）：空态时隐藏副标题——hero 的「暂无新记忆」与壳内空态
				     的「还没有回忆」会同屏出现两条空文案（两处都在说"这里没东西"）。空态块自己
				     已带完整引导语义，hero 副标题此时是冗余噪音。走 ui-hidden（class 属性更新
				     路径，非 v-if——同 R9-D 约束）。 -->
				<text class="hero-sub1" :class="emptyState ? 'ui-hidden' : ''">{{ heroSub1 }}</text>
				<text class="hero-sub2" :class="emptyState ? 'ui-hidden' : ''">{{ heroSub2 }}</text>
			</view>
		</view>

		<!-- 玻璃搜索胶囊（backdrop-blur + 白色内高光） -->
		<view class="search-capsule pressable" @tap="goSearch">
			<!-- uvue App 端 <image> 不支持 width/height 属性绑定，尺寸走 CSS（.search-icon 36rpx≈18px） -->
			<image class="search-icon" src="/static/icons/index-search.svg" lazy-load="true" />
			<text class="search-placeholder">描述一段回忆，帮你找</text>
		</view>

		<!-- 同步状态横幅 -->
		<UploadStatusBanner />

		<!-- 2026-09-23：显式声明滚动方向（uni-app x 只认 direction；原先依赖默认值，属隐式行为） -->
		<scroll-view class="scroll" direction="vertical" refresher-enabled :refresher-triggered="refreshing" @refresherrefresh="onRefresh">
			<!-- 回响卡片（去年今日 · 角贴 + 泛黄）；W6 拍板：整卡 → 该记忆详情页 -->
			<view v-if="echo != null" class="echo-card pressable" @tap="openEchoDetail">
				<view class="echo-corner">
					<text class="echo-corner-text">去年今日</text>
				</view>
				<text class="echo-date muted">{{ echo.echoDate }}</text>
				<text class="echo-text serif">{{ echo.text }}</text>
				<view v-if="echo.place != ''" class="echo-meta">
					<text class="meta-item">{{ echo.place }}</text>
				</view>
				<view class="echo-actions">
					<view class="echo-dismiss pressable" @tap="dismissEchoCard">
						<text class="echo-dismiss-text">划掉</text>
					</view>
				</view>
			</view>

			<!-- P-4 骨架屏：R9-D 修复——vapor 渲染器对「一次性 v-if 卸载」失效（09-07 真机 uiautomator+像素扫描
			     实锤骨架整树残留、米黄 sk-line 从待确认区露出）。改为恒渲染 + 动态 class display:none 收起，
			     走属性更新路径，不依赖节点卸载 -->
			<!-- 2026-09-23 编译门清理：原 `aria-label="加载中"` 在 uni-app x 的 <view> 上**不受支持**
			 （编译器原话：Property 'aria-label' is not supported）→ 属死属性（写了不生效）。
			 骨架屏是纯装饰占位、无文本内容，暂无需无障碍标注；日后若需读屏支持，
			 须走 uni-app x 实际支持的机制（不能沿用 HTML 的 aria-*）。 -->
		<view class="skeleton" :class="loaded ? 'sk-hidden' : ''">
				<view class="sk-card">
					<view class="sk-line sk-day"></view>
					<view class="sk-card-body">
						<view class="sk-line sk-title"></view>
						<view class="sk-strip">
							<view class="sk-img"></view>
							<view class="sk-img"></view>
							<view class="sk-img"></view>
						</view>
						<view class="sk-line sk-meta"></view>
					</view>
				</view>
				<view class="sk-card">
					<view class="sk-line sk-day"></view>
					<view class="sk-card-body">
						<view class="sk-line sk-title"></view>
						<view class="sk-line sk-meta"></view>
					</view>
				</view>
			</view>

			<!-- 壳内空态（2026-10-09 真机首测定案）：时间轴空时**就地渲染拍照首页内容**，
			     不再 redirectTo('/pages/empty/empty')——那会销毁整个壳（AI 对话状态丢失、
			     切 tab 闪屏、二段式跳转三宗罪同根）。视觉与 empty 页一致（画布 2:284 空状态帧）。
			     CTA 经 shell_state 桥拉起全壳唯一 RecordSheet（铁律：中央 + 是全壳唯一挂载）。
			     ⚠️ 2026-10-09 修复：不得用 v-if 控制——vapor 对「v-if 整树卸载」失效（R9-D 同坑，
			     09-07 骨架屏实锤），且下方 feed 因 R9-D 是无条件渲染 ⇒ v-if 空态块与 feed 必然
			     叠渲染（真机实拍：空态引导和日卡片挤在一页）。改走骨架屏同款「恒渲染 + class
			     display:none」互斥，走属性更新路径，不依赖节点卸载。 -->
			<view class="empty-home" :class="emptyState ? '' : 'ui-hidden'">
				<view class="empty-illus">
					<image class="empty-sun" src="/static/icons/i2_302.svg" mode="aspectFit" />
					<view class="empty-lake"><image class="empty-lake-img" src="/static/icons/i2_304.svg" mode="aspectFit" /></view>
				</view>
				<text class="empty-title">还没有回忆</text>
				<text class="empty-desc">拍一张照片，或说几句话</text>
				<text class="empty-desc empty-desc2">你的回忆会住在这里</text>
				<view class="empty-cta pressable" @tap="emptyTakeFirst">
					<text class="empty-cta-text">拍下第一张</text>
				</view>
				<view class="empty-voice pressable" @tap="emptyVoice">
					<text class="empty-voice-text">或者，录一段语音</text>
				</view>
			</view>

			<!-- 时间轴：L1 日卡片 + L2 主题两级（R9-D：去 v-else 配对恒渲染；空态互斥经
			     ui-hidden class 走属性更新，见上方空态块注释） -->
			<view class="feed" :class="emptyState ? 'ui-hidden' : ''">
				<!-- L2 待确认区 -->
				<view v-if="pendingEvents.length > 0" class="pending-block">
					<text class="day-title serif">待确认</text>
					<text class="pending-sub muted">这些主题还不确定，确认后不会再被算法改动</text>
					<view v-for="ev in pendingEvents" :key="ev.id" class="card card-l2 pressable" @tap="openDetail(ev)">
						<view v-if="ev.coverPath != ''" class="cover-wrap">
							<image class="cover-img" :src="ev.coverPath" mode="aspectFill" lazy-load="true" />
						</view>
						<text class="card-title serif title-l2">{{ ev.title }}</text>
						<view class="card-meta">
							<text class="meta-item">{{ levelText(ev.level) }}</text>
							<!-- 卡PA R4：视图字段组装期预计算（卡E01 计数口径不变），模板零函数调用 -->
							<text v-if="ev.hasRenderablePhotos" class="meta-item rust">{{ ev.photoCountText }}</text>
						</view>
						<view v-if="ev.hasRenderablePhotos" class="photo-strip">
							<image v-for="(p, pi) in ev.renderPhotoPaths" :key="pi" class="strip-img pressable" :src="p" mode="aspectFill" lazy-load="true" @tap="onPhotoTap(ev.renderPhotoIds[pi])" />
						</view>
						<!-- 语音卡：琥珀播放钮 + 波形竖条阵列（W0-2 播放态：钮变暂停 + 已播金/未播米 + 进度行） -->
						<view v-if="ev.voice != null" class="voice-card pressable" @tap="playVoice(ev.voice)">
							<view class="voice-play-btn">
								<view v-if="voiceIsActive(ev.voice.contentId) && voiceIsPlaying()" class="voice-pause-icon">
									<view class="voice-pause-bar"></view>
									<view class="voice-pause-bar"></view>
								</view>
								<view v-else class="voice-play-icon"></view>
							</view>
							<view style="flex:1;">
								<view class="voice-wave">
									<VoiceWave :heights="ev.voice.waveHeights" :waveform="wf.waveformOf(ev.voice.contentId)" :active="voiceIsActive(ev.voice.contentId)" :progress="voiceProgressOfCard(ev.voice.contentId)" idle-color="#C4913C" />
								</view>
								<view v-if="voiceIsActive(ev.voice.contentId)" class="voice-progress-row">
									<text class="voice-progress-time">{{ voiceCurSecText() }}</text>
									<view class="voice-track">
										<view class="voice-track-fill" :style="{ width: (voiceProgressOfCard(ev.voice.contentId) * 100) + '%' }"></view>
									</view>
									<text class="voice-progress-time">{{ voiceTotalSecText() }}</text>
								</view>
								<view style="display:flex; flex-direction:row; align-items:center; margin-top:8rpx;">
									<text class="voice-title">{{ ev.voice.title }}</text>
									<text class="voice-duration">{{ voiceIsActive(ev.voice.contentId) ? voiceTotalSecText() : ev.voice.duration }}</text>
								</view>
							</view>
						</view>
						<!-- 文字卡：左侧琥珀引用竖线 + 引言体 -->
						<view v-if="ev.quote != null && ev.quote != ''" class="quote-card">
							<view class="quote-line"></view>
							<view class="quote-content">
								<text class="quote-text serif">{{ ev.quote }}</text>
								<text v-if="ev.quoteSource != null && ev.quoteSource != ''" class="quote-source">—— {{ ev.quoteSource }}</text>
							</view>
						</view>
						<view class="pending-actions">
							<view class="pending-btn pending-btn-ghost pressable" @tap="ignorePending(ev)">
								<text class="pending-btn-text">忽略</text>
							</view>
							<view class="pending-btn pending-btn-solid pressable" @tap="confirmPending(ev)">
								<!-- 2026-10-11 静态审查 #11：主按钮需白字类（`.pending-btn-text` 是深棕
								     #3a2e25，配 rust 实底后对比度极低、视觉像禁用态；而白字类
								     `.pending-btn-text-solid` 此前零使用者 = 规则写了没人用） -->
								<text class="pending-btn-text pending-btn-text-solid">确认</text>
							</view>
						</view>
					</view>
				</view>

				<view v-for="(day, dayIdx) in visibleDays" :key="day.key" class="day-block">
					<view class="day-head">
						<text class="day-title serif">{{ day.label }}</text>
						<view class="day-line"></view>
					</view>
					<!-- 整卡可点进详情（真机实锤：此前卡片**没绑任何 @tap**，详情页从时间轴无入口）。
					     内部已有 @tap 的子元素必须加 .stop，否则点操作/照片/播放也会冒泡进详情 -->
					<view v-for="ev in day.events" :key="ev.id" class="card" :class="ev.level === 1 ? 'card-l1' : 'card-l2'" @tap="openDetail(ev)">
						<!-- 操作入口 -->
						<view class="card-ops pressable" @tap.stop="onCardOps(ev, dayIdx)">
							<text class="card-ops-text">⋯</text>
						</view>
						<view v-if="ev.coverPath != ''" class="cover-wrap">
							<image class="cover-img" :src="ev.coverPath" mode="aspectFill" lazy-load="true" />
						</view>
						<text class="card-title serif">{{ ev.title }}</text>
						<view class="card-meta">
							<text class="meta-item">{{ levelText(ev.level) }}</text>
							<!-- 卡PA R4：视图字段组装期预计算（卡E01 计数口径不变），模板零函数调用 -->
							<text v-if="ev.hasRenderablePhotos" class="meta-item rust">{{ ev.photoCountText }}</text>
						</view>
						<view v-if="ev.hasRenderablePhotos" class="photo-strip">
							<image v-for="(p, pi) in ev.renderPhotoPaths" :key="pi" class="strip-img pressable" :src="p" mode="aspectFill" lazy-load="true" @tap.stop="onPhotoTap(ev.renderPhotoIds[pi])" />
						</view>
						<!-- 语音卡（W0-2 播放态，同待确认区卡） -->
						<view v-if="ev.voice != null" class="voice-card pressable" @tap.stop="playVoice(ev.voice)">
							<view class="voice-play-btn">
								<view v-if="voiceIsActive(ev.voice.contentId) && voiceIsPlaying()" class="voice-pause-icon">
									<view class="voice-pause-bar"></view>
									<view class="voice-pause-bar"></view>
								</view>
								<view v-else class="voice-play-icon"></view>
							</view>
							<view style="flex:1;">
								<view class="voice-wave">
									<VoiceWave :heights="ev.voice.waveHeights" :waveform="wf.waveformOf(ev.voice.contentId)" :active="voiceIsActive(ev.voice.contentId)" :progress="voiceProgressOfCard(ev.voice.contentId)" idle-color="#C4913C" />
								</view>
								<view v-if="voiceIsActive(ev.voice.contentId)" class="voice-progress-row">
									<text class="voice-progress-time">{{ voiceCurSecText() }}</text>
									<view class="voice-track">
										<view class="voice-track-fill" :style="{ width: (voiceProgressOfCard(ev.voice.contentId) * 100) + '%' }"></view>
									</view>
									<text class="voice-progress-time">{{ voiceTotalSecText() }}</text>
								</view>
								<view style="display:flex; flex-direction:row; align-items:center; margin-top:8rpx;">
									<text class="voice-title">{{ ev.voice.title }}</text>
									<text class="voice-duration">{{ voiceIsActive(ev.voice.contentId) ? voiceTotalSecText() : ev.voice.duration }}</text>
								</view>
							</view>
						</view>
						<!-- 文字卡 -->
						<view v-if="ev.quote != null && ev.quote != ''" class="quote-card">
							<view class="quote-line"></view>
							<view class="quote-content">
								<text class="quote-text serif">{{ ev.quote }}</text>
								<text v-if="ev.quoteSource != null && ev.quoteSource != ''" class="quote-source">—— {{ ev.quoteSource }}</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 卡PB R1：尾部加载更多（点一次多 20 组；触底自动加载按卡面不做） -->
				<view v-if="visibleDayCount < days.length" class="load-more pressable" @tap="loadMoreDays">
					<text class="load-more-text">加载更多 · 还有 {{ days.length - visibleDayCount }} 组</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 卡PB R1：computed 显式引入（ref 沿页面现状未显式引入，避免重复声明）
	import { computed, onMounted, watch } from 'vue'
	import { WaveformCache } from '@/composables/useWaveform'
	import { PhotoAttach } from '@/composables/usePhotoAttach'
	import { EventOps } from '@/composables/useEventOps'
	import { requestShellTab, shellSheetSeq, shellSheetMode } from '@/utils/shell_state'
	import { fetchTimelineAsync, getCachedTimeline, wasLastFetchFailed, TimelineEvent, EventVoice, buildDayGroups, DayGroup } from '@/utils/timeline'
	import {
		toggleVoice,
		isVoiceActive,
		isVoicePlaying,
		voiceProgressOf,
		voiceCurSecValue,
		voiceTotalSecValue,
		fmtVoiceTime
	} from '@/utils/audio_player'
	import { parseIsoMs } from '@/utils/time'
	import { UploadProgress, UploadedPhoto, isoString } from '@/utils/uploader_types'
	import { uploadBatch } from '@/utils/uploader_batch'
	// 2026-09-11 D-19 修复：**行为入口** createPhotoWatch 走插件根（recorder 同款已验证路径，
	// 原生 dex 纳入靠这一条）；纯数据类 PhotoItem 的声明家在 utssdk/interface.uts——
	// 插件根代理不转发 interface 的再导出符号（实测：root 导入 PhotoItem 报
	// "is not exported by ...?uts-proxy"），故二者分开 import。
	import { createPhotoWatch } from '@/uni_modules/yishu-photo-watch'
	import { PhotoItem } from '@/uni_modules/yishu-photo-watch/utssdk/interface.uts'
	import { showErrorToast, ApiError, fetchDailySummary, DailySummary } from '@/utils/api'
	import { aggregateToEvents, ClientL1Event } from '@/utils/agg_runner.uts'
	import { syncClientEvents, SyncOutcome } from '@/utils/event_sync'
	import { fetchTodayEcho, dismissEcho, EchoCard, wasLastEchoFailed } from '@/utils/play_echo'
	import {
		flushOpQueue,
		pendingOpCount,
		ContentEventRef,
		EventPhotoEntry,
		mapAcceptedToClientIds
	} from '@/utils/event_ops'
	import { recordGrantTime, recordFirstDayRender } from '@/utils/agg/perf_timing.uts'

	// 响应式数据（uvue script setup 裸 let 非响应式，必须 ref —— 真机实锤：数据到位但界面停在加载态）
	let loaded = ref(false)
	let refreshing = ref(false)
	let days = ref<Array<DayGroup>>([])
	let pendingEvents = ref<Array<TimelineEvent>>([])
	// 壳内空态（2026-10-09）：时间轴空时渲染拍照首页引导（替代原 redirectTo empty 整页跳转）
	let emptyState = ref(false)

	// 空态 CTA（经 shell_state 桥拉起全壳唯一 RecordSheet；'photo'=直达拍照流，同 empty 页口径）
	function emptyTakeFirst(): void {
		shellSheetMode.value = 'photo'
		shellSheetSeq.value = shellSheetSeq.value + 1
	}

	function emptyVoice(): void {
		shellSheetMode.value = ''
		shellSheetSeq.value = shellSheetSeq.value + 1
	}
	let uploading = ref(false)
	let uploadDone = ref(0)
	let uploadTotal = ref(0)
	let uploadFailed = ref(0)
	let echo = ref<EchoCard | null>(null)
	// R8：hero 副标题数据驱动（画布口径：sub1=「N月 · X 条新记忆」sub2=最新记忆摘要 · M月dd日 HH:mm）
	let heroSub1 = ref('')
	let heroSub2 = ref('')
	// L-02a（方案 A · 2026-09-25）：照片挂载/照片详情（状态 + 索引表 + 7 方法）整块进
	// `usePhotoAttach`；组件经 `pa` 访问同一 ref 对象，模板绑 `onPhotoTap` 由下方薄包装转发。
	const pa = new PhotoAttach()
	// 卡PA D2/R2：当前渲染数据源（与 timeline.uts 缓存同数组引用，本地补丁直接同步缓存）
	let currentEvents: Array<TimelineEvent> = []
	// L-02b（方案 A · 2026-09-25）：卡片操作/确认/合并/拆分整块进 `useEventOps`；注入
	// 「取值函数」（currentEvents 是 let、会被整组浅替换，不能传快照）+ 渲染/刷新出口 + 日组读取。
	const eo = new EventOps(
		() => currentEvents,
		(evs: Array<TimelineEvent>) => { renderFromEvents(evs) },
		() => { refreshSilently() },
		() => days.value
	)
	// 卡PA R2：上次成功拉取时间（onShow TTL 内不重拉）
	let lastFetchAt = 0
	// 卡PA R2：页面存活守卫（缩略图后台批次回调在 onUnload 后不再触发渲染）
	let pageAlive = ref(true)
	// 卡PA R2：onShow 静默刷新 TTL（与 timeline.uts TIMELINE_CACHE_TTL 同值口径）
	const SHOW_REFRESH_TTL: number = 60000
	// 卡PB R1：按日分批渲染——首屏 20 组，尾部按钮每点一次 +LOAD_MORE_STEP 组。
	// 协同铁律：缓存命中/refreshSilently/patchEventById 都是 days.value 整组浅替换，
	// visibleDayCount 不参与替换保持原值，visibleDays 每次渲染从 days 现切（不缓存 slice 结果），
	// 因此分批对闪屏缓存刷新路径零改动。
	let visibleDayCount = ref(20)
	const LOAD_MORE_STEP: number = 20
	// 卡PB R1：可见日组窗口（computed 先例：favorites/search 页同款写法）
	let visibleDays = computed((): Array<DayGroup> => {
		return days.value.slice(0, visibleDayCount.value)
	})

	// 生命周期
	// B10 方案A 组件契约（2026-09-09 P2）：token 就绪由 shell ready 闸门保证（原 onLoad 内
	// ensureLogin().then 串行语义上收 shell）；shownSeq 每次切到本 tab ++（原页级 onShow TTL 刷新）；
	// savedSeq 记录保存成功 ++（原 RecordSheet @saved）。数据常驻=拍板项3；离页停播=拍板项2 退役
	// （原 onUnload stopVoice 删除，跨 tab 连播为正式行为；pageAlive 保 true——壳不销毁本页）。
	const props = defineProps({
		shownSeq: { type: Number, default: 0 },
		savedSeq: { type: Number, default: 0 }
	})
	// 原 onLoad 体（[perf] 埋点/卡PA D2 缓存先渲/photoWatch 初始化，逐字保留）
	onMounted((): void => {
		// P-4 内容出现时间埋点（新验收口径）：logcat 抓 [perf] 行，
		// content-visible(onLoad 起算) = 真实可感知指标；TotalTime 受 debug 基座固定成本支配基本不动
		console.log('[perf] index onLoad at ' + Date.now())
		console.log('[dbg-index] onLoad')
		// 卡PA D2：命中缓存先渲染（消除切页闪屏），再后台静默刷新、刷新完浅替换
		// （token 就绪由 shell ready 闸门保证——原 ensureLogin().then 包装解包直调）
		loadHeroSubs()  // R9-7：hero 副标题 API 拉取（与 timeline 刷新解耦）
		const hit = getCachedTimeline()
		if (hit != null) {
			console.log('[dbg-index] timeline cache hit, age=' + ((Date.now() - hit.fetchedAt) / 1000).toFixed(0) + 's -> instant render')
			applyFetchedEvents(hit.events)
			refreshSilently()
		} else {
			reload()
		}
		try {
			const photoWatch = createPhotoWatch()
			if (photoWatch.isReadPermissionGranted()) {
				watchStarted = true
				startWatch()
			} else {
				// 2026-09-11 D-24 修复：原实现此处**没有 else** —— 未授权时静默跳过，
				// 且 requestReadPermission() 全项目零调用 = 永远拿不到授权（死锁），
				// 全程零日志 ⇒ 真机表现成"什么都没发生"（无通知、无提示、无日志），
				// 掩盖了 D-23（SDK 硬编码致权限名错误）整整一轮。
				// 现在：显式打点（含真实 SDK 与权限名，用于区分"用户拒绝"与"本机无此权限"）
				//      + 拉起真实系统授权框，并**保证回调**驱动后续决策。
				console.log('[dbg-index] 相册读权限未授予，准备申请: perm=' + photoWatch.getReadPermissionName())
				photoWatch.requestReadPermission((granted: boolean, doNotAskAgain: boolean): void => {
					console.log('[dbg-index] 相册权限申请回调 granted=' + granted + ' doNotAskAgain=' + doNotAskAgain)
					if (granted) {
						watchStarted = true
						startWatch()
					} else if (doNotAskAgain) {
						// 用户已勾选"不再询问"：不再重复弹窗/打扰，仅留日志（须去系统设置手动开）
						console.log('[dbg-index] 相册权限被永久拒绝（不再询问），监听未启动；需到系统设置手动开启')
					} else {
						console.log('[dbg-index] 相册权限被拒，页面级监听未启动（下次进入会再次申请）')
						uni.showToast({ title: '未获得相册权限，暂不自动监听新照片', icon: 'none' })
					}
				})
			}
		} catch (e) {
			console.log('[dbg-index] photoWatch init failed (标准基座无原生插件，忽略): ' + e)
		}
	})
	watch((): number => props.shownSeq, (n: number): void => {
		// 2026-10-11 静态审查 #7：切回首页时**幂等复查**相册监听（用户去系统设置开权限后
		// 不杀进程也能生效）。成本 = 一次 checkSelfPermission + 日志，无权限框打扰。
		recheckWatchQuiet()
		// 原 onShow 体逐字（TTL 内不重拉，过期后台静默刷新）
		if (!loaded.value) {
			return
		}
		if (Date.now() - lastFetchAt < SHOW_REFRESH_TTL) {
			return
		}
		refreshSilently()
	})
	watch((): number => props.savedSeq, (n: number): void => {
		if (n > 0) {
			onRecordSaved()
		}
	})

	// 导航方法
	function goSearch(): void {
		requestShellTab('search', '') // B10 方案A：壳内零销毁切 tab（原 reLaunch 老页）
	}

	// 语音播放（W0-2 就地播放：播放钮变暂停 + 波形金色跳动 + 进度行，F5a 规范）
	function playVoice(voice: EventVoice | null): void {
		if (voice == null) {
			uni.showToast({ title: '语音文件不存在', icon: 'none' })
			return
		}
		// BB3：播放入口懒拉真实波形（列表不为每卡预拉；组件内 waveform prop 真值优先）
		wf.loadWaveform(voice.contentId)
		toggleVoice(voice.contentId)
	}

	// B5.2f：波形缓存收敛为共享组合式函数（唯一实现 client/composables/useWaveform.uts）
	const wf = new WaveformCache()
	// 模板取值封装（uvue 模板不直接绑跨模块 ref）
	function voiceIsActive(cid: string): boolean {
		return isVoiceActive(cid)
	}
	function voiceIsPlaying(): boolean {
		return isVoicePlaying()
	}
	function voiceProgressOfCard(cid: string): number {
		return voiceProgressOf(cid)
	}
	function voiceCurSecText(): string {
		return fmtVoiceTime(voiceCurSecValue())
	}
	function voiceTotalSecText(): string {
		return fmtVoiceTime(voiceTotalSecValue())
	}

	// 数据加载
	// P-4（2026-09-04 峰宝拍板）：首拉不被离线队列阻塞——fetchAll 立即走；
	// flushOpQueue 并行冲刷，确有离线操作时冲刷完补一次静默刷新保最终一致
	// （此前串行：登录→冲刷→拉取，队列非空时内容出现晚 1~2 个 RTT）
	function reload(): void {
		console.log('[perf] index reload: fetchAll 与 flushOpQueue 并行')
		fetchAll()
		const hadOps = pendingOpCount() > 0
		flushOpQueue().then((_remain: number) => {
			console.log('[dbg-index] flushOpQueue done, remain=' + _remain + ', hadOps=' + hadOps)
			if (hadOps && pageAlive.value) {
				refreshSilently()
			}
		})
	}
	// 本地 mock 时间轴注入路径已于 2026-08-31 移除（峰宝拍板：这是 MVP，不是 demo）：
	// events==0 直接走诚实空态（fetch 失败重试一次后仍空 ⇒ 壳内 emptyState 渲染，
	// **不再跳 /pages/empty/empty**——整页跳转会销毁壳，见本文件空态块注释），
	// 不再注入 ev-m1~m4 假 id 数据。

	// 空状态重试去重：瞬态失败重试一次的守门位（成功后复位）
	let emptyRetryDone = false

	function fetchAll(): void {
		console.log('[dbg-index] fetchAll -> fetchTimelineAsync')
		fetchTimelineAsync(null, onThumbBatch).then((events: Array<TimelineEvent>) => {
			console.log('[dbg-index] fetchTimeline resolved: ' + events.length + ' events')
			// 🚨 2026-10-11 静态审查 #1 修复：**失败结果不得覆盖已渲染数据**。
			// `fetchTimelineAsync` 用「空数组」表达失败（resolve([])），原实现无条件
			// `applyFetchedEvents(events)` ⇒ 下拉刷新遇断网/502/401 时：①时间轴卡片整片消失
			// （且 emptyState 仍 false ⇒ 连"还没有回忆"引导都没有 = 一片空白）②回响卡被抹掉
			// ③2.5s 重试再失败 ⇒ 显示假空态「还没有回忆」（用户以为云端记忆丢了）。
			// `refreshSilently` 一直有同款守卫（同语义两条路径必须同守卫），唯独此处漏了。
			if (wasLastFetchFailed()) {
				console.log('[dbg-index] fetchTimeline failed -> keep current UI')
				// 首拉失败也要收起骨架屏与下拉转圈（否则骨架永驻/转圈不停）：
				// 失败态下"骨架收起 + 保持现状"与 refreshSilently 的语义一致。
				loaded.value = true
				refreshing.value = false
				return
			}
			applyFetchedEvents(events)
		})
		fetchTodayEcho().then((card: EchoCard | null) => {
			// 🚨 2026-10-11 静态审查 #1 配套：区分"请求失败"与"真无回响"（二者都是 null）。
			// 失败 ⇒ **保持现状**（断网下拉刷新不该把用户正在看的回响卡抹掉）；
			// 真无回响（跨天/名额耗尽）⇒ 清空（R7 口径：防旧卡残留指向已删内容，见 messages.uvue）。
			if (card == null && wasLastEchoFailed()) {
				console.log('[dbg-index] echo fetch failed -> keep current card')
				return
			}
			echo.value = card
		})
	}

	// 卡PA D1：缩略图后台批次落地回调 → 整组 days.value 浅替换（改数据+一次性赋值，禁逐条 push）
	function onThumbBatch(): void {
		if (!pageAlive.value || !loaded.value) {
			return
		}
		renderFromEvents(currentEvents)
	}

	// 卡PA D2：渲染出口（days/pending 整组浅替换；不清空、不回退加载态防闪屏）
	function renderFromEvents(events: Array<TimelineEvent>): void {
		const firstRender = !loaded.value
		days.value = groupDays(events)
		pa.attachAll(days.value, pendingEvents.value)
		loaded.value = true
		refreshing.value = false
		// 🚨 2026-10-11 静态审查 #2 修复：`emptyState` 是**派生状态**，必须收敛在渲染出口。
		// 原实现只在 applyFetchedEvents 内重算，而 days/pending 还能被其它路径改变
		// （useEventOps 经 render 出口的 ignorePending / patchEventById / removeEventById）
		// ⇒ 已确证复现：新用户唯一一条事件是待确认态 → 点「忽略」→ days 与 pending 同时为空，
		// 但 emptyState 仍为 false ⇒ feed 无内容 + 空态块被 ui-hidden 藏住 = **整页白屏**
		// （无引导、无 CTA，只能靠下拉刷新自愈）。
		// ⚠️ 本收敛与 #1「失败结果不进入本函数」是**配套**的：先有 #1 才有无条件收敛
		// （否则失败时的空数组会立刻显示假空态）。
		emptyState.value = days.value.length === 0 && pendingEvents.value.length === 0
		// P-4 内容出现时间埋点：onLoad → 首帧内容上屏（logcat [perf] 行）
		if (firstRender) {
			console.log('[perf] index content-visible at ' + Date.now())
		}
	}

	// R9-7（Q5 拍板）：hero 副标题 API 化——GET /stats/daily-summary 拉取，
	// 替代 R8 本地 timeline 全量计算。失败/空数据清空文案（诚实，不造假不残留——
	// 峰宝 09-06「模板 UI」投诉口径延续）。count=0 时 sub1 退化用「暂无新记忆」。
	function loadHeroSubs(): void {
		fetchDailySummary().then((s: DailySummary | null) => {
			if (s == null) {
				heroSub1.value = ''
				heroSub2.value = ''
				return
			}
			if (s.count == 0 || s.latestEventText == '' || s.latestEventTime == '') {
				heroSub1.value = '暂无新记忆'
				heroSub2.value = ''
				return
			}
			const d = new Date(parseIsoMs(s.latestEventTime))
			let hh = d.getHours().toString()
			if (hh.length < 2) {
				hh = '0' + hh
			}
			let mi = d.getMinutes().toString()
			if (mi.length < 2) {
				mi = '0' + mi
			}
			heroSub1.value = (d.getMonth() + 1).toString() + '月 · ' + s.count.toString() + ' 条新记忆'
			heroSub2.value = s.latestEventText + ' · ' + (d.getMonth() + 1).toString() + '月' + d.getDate().toString() + '日 ' + hh + ':' + mi
		})
	}

	// 卡PA D2/R2：拉取结果统一渲染入口（更新数据源引用 + lastFetchAt + 空状态守门）
	// 注（2026-10-11）：本函数现在**只被成功路径调用**（fetchAll / refreshSilently 都有
	// wasLastFetchFailed 守卫）⇒ lastFetchAt 天然只在成功时写（原"失败也写"使失败后
	// 60s TTL 内切 tab 不再补刷，属 #13）。
	function applyFetchedEvents(events: Array<TimelineEvent>): void {
		currentEvents = events
		lastFetchAt = Date.now()
		renderFromEvents(events)   // emptyState 已在渲染出口收敛（#2）
		// 空状态防误伤（2026-09-02 冷启动实锤）：请求失败（连接/鉴权瞬态）同样返回 0 条，
		// 不能当「真·空状态」——失败标记位成立时延迟重试一次，仍空才认空态。
		if (days.value.length === 0 && pendingEvents.value.length === 0) {
			if (wasLastFetchFailed() && !emptyRetryDone) {
				// 失败未确认：先收回刚收敛出来的空态，重试一次再定性（否则"还没有回忆"
				// 会先闪一下，再被 2.5s 后的重试结果改写）
				emptyState.value = false
				emptyRetryDone = true
				console.log('[dbg-index] timeline fetch failed -> retry in 2.5s')
				setTimeout(() => { fetchAll() }, 2500)
				return
			}
			emptyRetryDone = false
			// ⚠️ 2026-10-09 真机首测定案：空态为**壳内渲染**（emptyState 视图，视觉=empty 页），
			// 不 redirectTo('/pages/empty/empty')（B10 铁律「壳内零 redirectTo」）。
			// 空态置位已由 renderFromEvents 收敛，此处直接返回。
			return
		}
		emptyRetryDone = false
		if (days.value.length > 0 || pendingEvents.value.length > 0) {
			recordFirstDayRender()
		}
	}

	// 卡PA D2/R2：后台静默刷新（flushOpQueue → 拉取 → 成功才浅替换；失败保持现状不动）
	function refreshSilently(): void {
		if (!pageAlive.value) {
			return
		}
		console.log('[dbg-index] refreshSilently begin')
		flushOpQueue().then((_remain: number) => {
			if (!pageAlive.value) {
				return
			}
			fetchTimelineAsync(null, onThumbBatch).then((events: Array<TimelineEvent>) => {
				if (!pageAlive.value) {
					return
				}
				console.log('[dbg-index] refreshSilently resolved: ' + events.length + ' events')
				if (wasLastFetchFailed()) {
					console.log('[dbg-index] refreshSilently fetch failed -> keep current UI')
					return
				}
				applyFetchedEvents(events)
			})
		})
	}

	// 整卡进详情：detail 页要的是 **contentId**，而 TimelineEvent.id 是 event id，不能直接用。
	// 取数优先级：封面 content_id → 照片条第一张 → 都没有则提示（避免跳进空白详情页）
	function openDetail(ev: TimelineEvent): void {
		let cid = ev.coverContentId
		if (cid == '' && ev.photoIds.length > 0) {
			cid = ev.photoIds[0]
		}
		if (cid == '') {
			uni.showToast({ title: '这条记忆暂无可查看的内容', icon: 'none' })
			return
		}
		console.log('[dbg-index] openDetail contentId=' + cid)
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + cid })
	}

	// W6（峰宝拍板 2026-09-04）：回响卡整卡 → 该记忆详情页（「去年今日」回响详情落点）
	function openEchoDetail(): void {
		const card = echo.value
		if (card == null || card.contentId == '') {
			uni.showToast({ title: '这条回响暂无可查看的内容', icon: 'none' })
			return
		}
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + card.contentId })
	}

	// L-02b：卡片操作 / 确认 / 合并 / 拆分已整块进 `useEventOps`（见 composable 头注）；
	// 组件只留模板入口的薄包装（转发到同一实例，行为等价）。
	function onCardOps(ev: TimelineEvent, dayIdx: number): void {
		eo.onCardOps(ev, dayIdx)
	}

	// 回响
	function dismissEchoCard(): void {
		const card = echo.value
		if (card == null) {
			return
		}
		dismissEcho(card.contentId).then((ok: boolean) => {
			// 🚨 2026-10-11 静态审查 #6 修复：失败**不得**乐观隐藏。
			// 原实现无论成败都 `echo.value = null` ⇒ 断网点"划掉"：卡片消失（像成功了），
			// 但服务端没记录 ⇒ 下次 fetchAll（下拉刷新/切 tab）卡片**复活**——
			// "划掉了又回来"比"划不掉"更像灵异事件，且无任何提示。
			if (!ok) {
				showErrorToast(new ApiError('ECHO_DISMISS', '划掉失败，请稍后重试', 0))
				return
			}
			echo.value = null
			uni.showToast({ title: '已划掉', icon: 'none' })
		})
	}

	// 照片映射
	// 卡PA D9：忽略表读一次进 Set 传入 buildDayGroups（key 镜像 event_ops.uts:35
	// IGNORE_KEY='yishu_ignored_events'——event_ops 不在本卡文件域，故此处镜像读；
	// buildDayGroups 循环内零 getStorageSync）
	function loadIgnoredIds(): Set<string> {
		const ids: Set<string> = new Set<string>()
		const raw = uni.getStorageSync('yishu_ignored_events') as string
		if (raw != '') {
			const parts = raw.split('\n')
			for (let i = 0; i < parts.length; i++) {
				if (parts[i] != '') {
					ids.add(parts[i])
				}
			}
		}
		return ids
	}
	function groupDays(events: Array<TimelineEvent>): Array<DayGroup> {
		const result = buildDayGroups(events, loadIgnoredIds())
		pendingEvents.value = result.pending
		return result.groups
	}
	// RecordSheet 保存成功回调：后台静默刷新（卡PA R2：新录入产生服务端新事件 id，
	// 本地无法合成 → 无闪屏 refreshSilently，刷新完浅替换让刚录入的记忆上屏）
	// R8 补刷：后端 AI 管线为异步（转写后分类/聚合秒~分钟级，2026-09-06 实测曾因
	// RQ worker 未启动积压 296 条致新录音永不进时间轴），保存瞬间刷新必然拉不到
	// 新事件 → 延迟补刷两次兜底；refreshSilently 自带 pageAlive 守卫，离页自动失效
	function onRecordSaved(): void {
		refreshSilently()
		setTimeout(() => {
			refreshSilently()
		}, 4000)
		setTimeout(() => {
			refreshSilently()
		}, 12000)
	}

	// L-02a：照片路径 / 挂载 已整块进 `usePhotoAttach`（见 composable 头注）。
	// 🚨 2026-10-11 静态审查 #3 修复：照片点按改为**直达内容详情页**。
	// 原实现转发到 `pa.onPhotoTap`——它只设置 `showPhotoDetail` 等四态，而**模板中根本没有
	// 消费它们的照片详情面板**（`photo-detail-panel` 在全仓 0 命中，`tab-index.css:631-659`
	// 的 `.photo-detail-*` 规则零使用者）⇒ 用户点照片**零反馈**，且照片条带 `.stop`
	// （连整卡进详情都不触发）——"点得动但没反应"的最差形态。
	// 保守修法：收口到**既有可用路径**（详情页），不新造 UI；面板若后续要做，
	// `pa.onPhotoTap` 四态仍在（届时把本函数换回转发即可）。
	function onPhotoTap(contentId: string): void {
		if (contentId == '') {
			uni.showToast({ title: '这张照片暂无可查看的内容', icon: 'none' })
			return
		}
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + contentId })
	}

	// 待确认（L-02b：逻辑进 `useEventOps`，此处仅模板入口薄包装）
	function confirmPending(ev: TimelineEvent): void {
		eo.confirmPending(ev)
	}
	function ignorePending(ev: TimelineEvent): void {
		eo.ignorePending(ev)
	}

	// 工具方法
	function levelText(level: number): string {
		if (level === 1) {
			return '日卡片'
		} else if (level === 2) {
			return '主题'
		} else if (level === 3) {
			return '主题流'
		}
		return '瞬间'
	}
	function levelTag(level: number): string {
		if (level === 1) {
			return '日卡'
		} else if (level === 2) {
			return '主题'
		} else if (level === 3) {
			return '主题流'
		}
		return '瞬间'
	}
	function belongsMeta(ref: ContentEventRef): string {
		const st = ref.status == 'confirmed' ? '已确认' : (ref.status == 'rejected' ? '已忽略' : '待确认')
		return ref.photoCount.toFixed(0) + '张 · ' + st
	}
	function onRefresh(): void {
		refreshing.value = true
		reload()
	}

	// 卡PB R1：加载更多（每点一次多 LOAD_MORE_STEP 组）
	function loadMoreDays(): void {
		visibleDayCount.value = visibleDayCount.value + LOAD_MORE_STEP
		console.log('[dbg-index] loadMoreDays -> visibleDayCount=' + visibleDayCount.value)
	}

	// 相册监听
	// 2026-10-11 静态审查 #7/#12：两个进程级标志（组件在壳内常驻、不销毁 ⇒ 等价会话级）
	//  · watchStarted：监听是否已启动 —— 供"切回首页时幂等复查"用（#7）
	//  · watchNotified：启动 toast 是否已提示过（#12：原实现每次冷启动都弹一次无意义提示）
	let watchStarted = false
	let watchNotified = false

	/** 幂等复查：**已授权但监听未启动**时补启动（不弹权限框、不打扰）。
	 *
	 * #7 背景：壳架构下 TabIndex 只挂载一次（everIndex 恒 true + v-show），原实现只在
	 * onMounted 初始化一次监听 ⇒「首次拒绝权限 → 去系统设置打开 → 回 App」时监听永不启动
	 * （旧注释"下次进入会再次申请"在壳架构下不成立）。挂在切回首页的 watch 上做廉价复查。 */
	function recheckWatchQuiet(): void {
		if (watchStarted) {
			return
		}
		try {
			const pw = createPhotoWatch()
			if (pw.isReadPermissionGranted()) {
				console.log('[dbg-index] recheck: 权限已就绪，补启动相册监听')
				watchStarted = true
				startWatch()
			}
		} catch (e) {
			// 标准基座无原生插件：忽略（onMounted 已打点）
		}
	}

	function startWatch(): void {
		console.log('[yishu] startWatch begin')
		recordGrantTime()
		const watch = createPhotoWatch()
		watch.start((items: Array<PhotoItem>) => {
			console.log('[yishu] batch received: ' + items.length)
			if (items.length === 0) {
				return
			}
			handleBatch(items)
		})
		console.log('[yishu] startWatch done, lastSeen=' + watch.getLastSeenId())
		// #12：只提示一次——老用户每次冷启动都吃一次「已开始监听相册」是纯噪音
		if (!watchNotified) {
			watchNotified = true
			uni.showToast({ title: '已开始监听相册', icon: 'none' })
		}
	}
	function handleBatch(items: Array<PhotoItem>): void {
		uploading.value = true
		uploadDone.value = 0
		uploadTotal.value = items.length
		uploadFailed.value = 0
		uploadBatch(items, (p: UploadProgress) => {
			uploadDone.value = p.done
			uploadTotal.value = p.total
			uploadFailed.value = p.failed
		}).then((uploaded: Array<UploadedPhoto>) => {
			uploading.value = false
			if (uploadFailed.value > 0) {
				uni.showToast({ title: '有 ' + uploadFailed.value + ' 张上传失败', icon: 'none' })
			}
			if (uploaded.length > 0) {
				for (let i = 0; i < uploaded.length; i++) {
					// L-02a：本地路径入列（数组 push + O(1) 查表 set 同进同出）已收敛进 composable
					pa.addLocalPath(uploaded[i].contentId, uploaded[i].item.path)
				}
				const tz = -new Date().getTimezoneOffset()
				const agg = aggregateToEvents(uploaded, tz)
				const events: Array<UTSJSONObject> = []
				for (let i = 0; i < agg.events.length; i++) {
					const ev = agg.events[i]
					const obj: UTSJSONObject = {
						client_event_id: ev.clientEventId,
						title: ev.title,
						start_time: isoString(ev.startTime),
						end_time: isoString(ev.endTime),
						photo_ids: ev.photoIds
					}
					events.push(obj)
				}
				if (events.length > 0) {
					syncClientEvents(events).then((out: SyncOutcome | null) => {
						if (out != null) {
							console.log('[yishu] 事件上云: accepted=' + out.accepted + ' dup=' + out.duplicates + ' rejected=' + out.rejected)
							const mapped: Array<EventPhotoEntry> = mapAcceptedToClientIds(events, out.acceptedEvents)
							for (let m = 0; m < mapped.length; m++) {
								pa.addEventPhoto(mapped[m])
							}
							console.log('[yishu] photoMap: clientEvents=' + events.length + ' accepted=' + out.acceptedEvents.length + ' mappedServerEvents=' + pa.eventPhotoIds.value.length)
						} else {
							console.error('[yishu] 事件上云失败（重试耗尽）')
							uni.showToast({ title: '事件同步失败，稍后重试', icon: 'none' })
						}
						// 卡PA R2（拍板采纳的偏差方案）：上传产生服务端新事件，本地无法合成 →
						// 无闪屏后台静默刷新
						refreshSilently()
					})
					return
				}
			}
			// 卡PA R2：同上，上传完成走无闪屏静默刷新
			refreshSilently()
		})
	}
</script>

<style>
	@import '@/styles/tab-index.css';
</style>

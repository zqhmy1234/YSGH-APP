<template>
	<!-- B10 方案A P2：自 pages/index/index.uvue 整体搬迁；TabBar/RecordSheet 挂载与
	     页级生命周期/ensureLogin 上收 shell（契约见 script），处置记录台账 §EE -->
<view class="page tk-root">
		<!-- 照片出血氛围层（390x300 湖面图 + 顶部横向暗化 + 底部横向米色溶解） -->
		<view class="hero-section">
			<image class="hero-image" src="/static/hero-lake.jpg" mode="aspectFill" lazy-load="true" />
			<view class="hero-overlay-top"></view>
			<view class="hero-overlay-bottom"></view>
			<view class="hero-avatar"><text class="hero-avatar-char serif">峰</text></view>
			<view class="hero-content">
				<text class="hero-title serif">回忆</text>
				<!-- R8：数据驱动化（此前硬编码画布示意文案「八月 · 28 条新记忆/清晨的湖边」= 峰宝 09-06 投诉的模板 UI 之一） -->
				<!-- ⚠️ 2026-10-11（视觉审查）/ 2026-10-16 更新：空态时隐藏副标题——hero 的「暂无新记忆」
				     与壳内空态的「还没有回忆」会同屏出现两条空文案（两处都在说"这里没东西"）。空态块
				     自己已带完整引导语义，hero 副标题此时是冗余噪音。判定由 `emptyState` 换成
				     `showEmpty`（= 真·空 **或** 失败态，且今天也无 entry），与本页三态口径同源 ✓。
				     走 ui-hidden（class 属性更新路径，非 v-if——同 R9-D 约束）。 -->
				<text class="hero-sub1" :class="showEmpty ? 'ui-hidden' : ''">{{ heroSub1 }}</text>
				<text class="hero-sub2" :class="showEmpty ? 'ui-hidden' : ''">{{ heroSub2 }}</text>
			</view>
		</view>

		<!-- 玻璃搜索胶囊（backdrop-blur + 白色内高光） -->
		<view class="search-capsule pressable" @tap="goSearch">
			<!-- uvue App 端 <image> 不支持 width/height 属性绑定，尺寸走 CSS（.search-icon 36rpx≈18px） -->
			<image class="search-icon" src="/static/icons/index-search.svg" lazy-load="true" />
			<text class="search-placeholder">描述一段回忆，帮你找</text>
		</view>

		<!-- 同步状态横幅 -->
		<UploadStatusBanner />

		<!-- B-17（2026-10-25）：端侧聚合降级提示（照片数超 400 硬顶时本次不出 L1 ⇒ 时间轴空白）。
		     组件内部 `v-if` 判空串，未降级时**零渲染**、不占位。 -->
		<AggDegradeNotice />

		<!-- 2026-09-23：显式声明滚动方向（uni-app x 只认 direction；原先依赖默认值，属隐式行为） -->
		<scroll-view class="scroll" direction="vertical" refresher-enabled :refresher-triggered="refreshing" @refresherrefresh="onRefresh">
			<!-- 回响卡片（去年今日 · 角贴 + 泛黄）；W6 拍板：整卡 → 该记忆详情页 -->
			<view v-if="echo != null" class="echo-card pressable" @tap="openEchoDetail">
				<view class="echo-corner">
					<text class="echo-corner-text">去年今日</text>
				</view>
				<text class="echo-date muted">{{ echo.echoDate }}</text>
				<text class="echo-text serif">{{ echo.text }}</text>
				<view v-if="echo.place != ''" class="echo-meta">
					<text class="meta-item">{{ echo.place }}</text>
				</view>
				<view class="echo-actions">
					<view class="echo-dismiss pressable" @tap="dismissEchoCard">
						<text class="echo-dismiss-text">划掉</text>
					</view>
				</view>
			</view>

			<!-- P-4 骨架屏：R9-D 修复——vapor 渲染器对「一次性 v-if 卸载」失效（09-07 真机 uiautomator+像素扫描
			     实锤骨架整树残留、米黄 sk-line 从待确认区露出）。改为恒渲染 + 动态 class display:none 收起，
			     走属性更新路径，不依赖节点卸载 -->
			<!-- 2026-09-23 编译门清理：原 `aria-label="加载中"` 在 uni-app x 的 <view> 上**不受支持**
			 （编译器原话：Property 'aria-label' is not supported）→ 属死属性（写了不生效）。
			 骨架屏是纯装饰占位、无文本内容，暂无需无障碍标注；日后若需读屏支持，
			 须走 uni-app x 实际支持的机制（不能沿用 HTML 的 aria-*）。 -->
		<view class="skeleton" :class="loading ? '' : 'sk-hidden'">
				<view class="sk-card">
					<view class="sk-line sk-day"></view>
					<view class="sk-card-body">
						<view class="sk-line sk-title"></view>
						<view class="sk-strip">
							<view class="sk-img"></view>
							<view class="sk-img"></view>
							<view class="sk-img"></view>
						</view>
						<view class="sk-line sk-meta"></view>
					</view>
				</view>
				<view class="sk-card">
					<view class="sk-line sk-day"></view>
					<view class="sk-card-body">
						<view class="sk-line sk-title"></view>
						<view class="sk-line sk-meta"></view>
					</view>
				</view>
			</view>

			<!-- 壳内空态（2026-10-09 真机首测定案）：时间轴空时**就地渲染拍照首页内容**，
			     不再 redirectTo('/pages/empty/empty')——那会销毁整个壳（AI 对话状态丢失、
			     切 tab 闪屏、二段式跳转三宗罪同根）。视觉与 empty 页一致（画布 2:284 空状态帧）。
			     CTA 经 shell_state 桥拉起全壳唯一 RecordSheet（铁律：中央 + 是全壳唯一挂载）。
			     ⚠️ 2026-10-09 修复：不得用 v-if 控制——vapor 对「v-if 整树卸载」失效（R9-D 同坑，
			     09-07 骨架屏实锤），且下方 feed 因 R9-D 是无条件渲染 ⇒ v-if 空态块与 feed 必然
			     叠渲染（真机实拍：空态引导和日卡片挤在一页）。改走骨架屏同款「恒渲染 + class
			     display:none」互斥，走属性更新路径，不依赖节点卸载。 -->
			<!-- 2026-10-15：空态与 feed 的显示条件补上「今天没有 entry」——
			     只看 events 判空会把"今天记了文字（还没聚合成事件）"误判成空 ✗
			     （真机反馈原话：明明有数据却显示空态）。
			     2026-10-16（三态显式化）：本块可见条件收敛成**单一 computed `showEmpty`**
			     （=`loaded && todayLoaded && (emptyState || loadFailed) && todayEntries.length===0`），
			     与骨架屏（`loading = !loaded || !todayLoaded`）、feed /「今天」块（`!showEmpty && !loading`）
			     三者**互斥**——此前三者各用不同表达式判显隐，加载期骨架与 feed 会同时可见 = 用户看到的
			     "页面在闪" ✗；`todayLoaded` 的置位分支清单见 `showEmpty` 定义处注释（B1~B6）✓。 -->
			<view class="ti-empty-home" :class="showEmpty ? '' : 'ui-hidden'">
				<view class="ti-empty-illus">
					<image class="ti-empty-sun" src="/static/icons/i2_302.svg" mode="aspectFit" />
					<view class="ti-empty-lake"><image class="ti-empty-lake-img" src="/static/icons/i2_304.svg" mode="aspectFit" /></view>
				</view>
				<!-- 2026-10-15（真机反馈后修）：**失败与真·空分开**（见 script 内 loadFailed 注释）。
				     失败时不再说「还没有回忆」（那是假空态 ✗，会让人以为云端记忆丢了），
				     也不再露出"拍下第一张"的 CTA（数据可能在云端，不该引导用户重新记 ✗）。
				     用 v-if 会踩本文件既有的 R9-D 坑（整树卸载失效）⇒ 仍走 ui-hidden class 互斥。 -->
				<text class="ti-empty-title">{{ loadFailed ? '加载失败' : '还没有回忆' }}</text>
				<text class="ti-empty-desc">{{ loadFailed ? '网络或服务暂时不可用' : '拍一张照片，或说几句话' }}</text>
				<text class="ti-empty-desc ti-empty-desc2">{{ loadFailed ? '下拉可重试' : '你的回忆会住在这里' }}</text>
				<view class="ti-empty-cta pressable" :class="loadFailed ? 'ui-hidden' : ''" @tap="emptyTakeFirst">
					<text class="ti-empty-cta-text">拍下第一张</text>
				</view>
				<view class="ti-empty-voice pressable" :class="loadFailed ? 'ui-hidden' : ''" @tap="emptyVoice">
					<text class="ti-empty-voice-text">或者，录一段语音</text>
				</view>
			</view>

			<!-- 2026-10-15（台账 §4.20 ㉘ · 「今天」块 / entry 流第一刀）/ 2026-10-16 扩面到照片：
			     ① **收文字 + 照片**（2026-10-16）：今天**刚拍、还没聚合成事件**的照片此前在「今天」
			        块里是**缺席**的（用户要的是"今天完整的记录流"），现补上——照片 entry 与文字卡
			        **同构**；语音留待下一批（要接播放管道/波形，属独立工作面 ✗）；
			     ② **今天没有记录也渲染本块**（一行静默引导替代"整页空态"，治真机反馈
			        「冷启动时 App 时间轴没有任何内容」✗）——但**真·空/失败**时整块让位给上方空态块；
			     ③ **零新增视觉元素**：日头复用 `.day-block/.day-head/.day-title/.day-line`；
			        文字卡复用**为文字卡预留的** `.quote-card`（左侧琥珀引用竖线 + 引言体）；
			        照片封面复用 `.cover-wrap/.cover-img`（与「那年今日」行/事件卡同款）；
			        照片元信息复用 `.card-meta/.meta-item`；文字元信息复用 `.quote-source`/`.muted` ✓；
			     ④ **去重口径（用户明确要求）**：今天的照片**只出现在本块**；下方按天的历史区
			        只显示**今天之前**（见 `historyDays` 过滤 + `fetchTodayEntries` 的 taken_at 注释）
			        ⇒ 同一张照片天然不会出现两次 ✓；
			     ⑤ **排列＝日记式正序（早上 → 现在）**：正序才像"回看今天"从头读到尾（Day One/flomo
			        同款）；排序在 `fetchTodayEntries` 组装期完成（模板零函数调用 ✓）；
			     ⑥ 本块放在 `.feed` **之外**：`.feed` 只在有事件时可见，只记了文字/照片（还没聚合）
			        的用户否则会连它一起看不到 ✗；
			     ⑦ 显隐走 `loading`/`showEmpty` 两派生量（2026-10-16 用户裁决）：`loading`（含
			        `!todayLoaded`）期间本块隐藏 ⇒ 不再出现"空态先闪一下再被今天记录顶掉"✗。 -->
			<view class="day-block" :class="(showEmpty || loading) ? 'ui-hidden' : ''">
				<view class="day-head">
					<text class="day-title serif">今天</text>
					<view class="day-line"></view>
				</view>
				<text v-if="todayEntries.length === 0" class="pending-sub muted">今天还没有记录 · 点下方的 + 记一笔</text>
				<view v-for="e in todayEntries" :key="'te-' + e.id" class="card pressable" @tap="openEntry(e)">
					<!-- 文字 entry：复用为文字预留的引用卡（左侧琥珀竖线 + 引言体） -->
					<view v-if="e.kind === 'text'" class="quote-card">
						<view class="quote-line"></view>
						<view class="quote-content">
							<text class="quote-text serif">{{ e.text }}</text>
							<text class="quote-source">{{ e.timeLabel }}{{ e.place != '' ? ' · ' + e.place : '' }}</text>
						</view>
					</view>
					<!-- 照片 entry：封面复用 `.cover-wrap/.cover-img`（同「那年今日」行/事件卡），
					     图片走服务端 thumbnail_url 票据（在 entries_api 内 resolveMediaUrl 拼直连） -->
					<view v-if="e.kind === 'photo'" class="cover-wrap">
						<image class="cover-img" :src="e.photoUrl" mode="aspectFill" lazy-load="true" />
					</view>
					<view v-if="e.kind === 'photo'" class="card-meta">
						<text class="meta-item">{{ e.timeLabel }}</text>
						<text v-if="e.place != ''" class="meta-item">{{ e.place }}</text>
					</view>
				</view>
			</view>

			<!-- 回顾位「那年今日」（2026-10-15 · 台账 §4.20 ㉘ · 批次 C 第一刀）：
			     ① **有才出现**（`v-if` 在整块上：无匹配就不渲染 —— 这是"不占位"的口径 ✓；
			        注意与本文件 R9-D 的"空态/feed 互斥"不同：那里是**常驻两态**，这里是**可缺席块**，
			        块内没有别的兄弟需要互斥，v-if 不会造成叠渲染 ✗✓）；
			     ② 视觉零新增：日头复用 `.day-block/.day-head/.day-title/.day-line`，行复用
			        `.card` + `.cover-wrap/.cover-img` + `.card-title` + `.card-meta/.meta-item`
			        （与时间轴事件卡**同款原子** ⇒ 一眼看出是"同一种东西的不同时间" ✓）；
			     ③ 封面用 `coverUrl`（服务端票据）而**不是本地路径**：往年的原件/缩略图可能已被
			        清理，本地路径会裂图 ✗。 -->
			<view v-if="lookbackRows.length > 0" class="day-block">
				<view class="day-head">
					<text class="day-title serif">那年今日</text>
					<view class="day-line"></view>
				</view>
				<view v-for="r in lookbackRows" :key="'lb-' + r.contentId + r.yearLabel" class="card pressable" @tap="openLookback(r)">
					<view v-if="r.coverUrl != ''" class="cover-wrap">
						<image class="cover-img" :src="r.coverUrl" mode="aspectFill" lazy-load="true" />
					</view>
					<text class="card-title serif title-l2">{{ r.title }}</text>
					<view class="card-meta">
						<text class="meta-item">{{ r.yearLabel }}</text>
						<text v-if="r.metaText != ''" class="meta-item rust">{{ r.metaText }}</text>
					</view>
				</view>
			</view>

			<!-- 时间轴：L1 日卡片 + L2 主题两级（R9-D：去 v-else 配对恒渲染；空态互斥经
			     ui-hidden class 走属性更新，见上方空态块注释）。2026-10-15：显示条件补
			     `todayEntries.length === 0`（理由见上方「今天」块注释）；2026-10-16：与骨架屏、
			     「今天」块统一用 `loading`/`showEmpty` 判显隐（`loading = !loaded || !todayLoaded`）
			     ⇒ 三态互斥不叠渲染 ✓。
			     ⚠️ 日卡列表数据源 `visibleDays` 已排除「今天」的日组（去重口径，见其定义处）。 -->
			<view class="feed" :class="(showEmpty || loading) ? 'ui-hidden' : ''">
				<view v-for="(day, dayIdx) in visibleDays" :key="day.key" class="day-block">
					<view class="day-head">
						<text class="day-title serif">{{ day.label }}</text>
						<!-- 2026-10-17：日头"N 张照片"概括——组内 photoCount 总和在 buildDayGroups 出口
						     预计算（DayGroup.photoCountTotal），无照片日组不显示；复用既有 .meta-item -->
						<text v-if="day.photoCountTotal > 0" class="meta-item">{{ day.photoCountTotal }} 张照片</text>
						<view class="day-line"></view>
					</view>
					<!-- 整卡可点进详情（真机实锤：此前卡片**没绑任何 @tap**，详情页从时间轴无入口）。
					     内部已有 @tap 的子元素必须加 .stop，否则点操作/照片/播放也会冒泡进详情 -->
					<view v-for="ev in day.events" :key="ev.id" class="card" :class="ev.level === 1 ? 'card-l1' : 'card-l2'" @tap="openDetail(ev)">
						<!-- 操作入口 -->
						<view class="card-ops pressable" @tap.stop="onCardOps(ev, dayIdx)">
							<text class="card-ops-text">⋯</text>
						</view>
						<view v-if="ev.coverPath != ''" class="cover-wrap">
							<image class="cover-img" :src="ev.coverPath" mode="aspectFill" lazy-load="true" />
						</view>
						<text class="card-title serif">{{ ev.title }}</text>
						<view class="card-meta">
							<!-- 2026-10-16（RC-F 性能）：层级文案改查表（`levelLabels[ev.level]`），去掉模板函数调用
						     ——列表每次整树重渲染时不再逐卡调 `levelText()`（原实现每 tick 全列表重算） -->
						<text class="meta-item">{{ levelLabels[ev.level] }}</text>
							<!-- 卡PA R4：视图字段组装期预计算（卡E01 计数口径不变），模板零函数调用 -->
							<text v-if="ev.hasRenderablePhotos" class="meta-item rust">{{ ev.photoCountText }}</text>
							<!-- 2026-10-17：跨零点标记——组装期判定（endTime>0 且日键与 startTime 不同，见
							     buildDayGroups），模板只读字段零函数调用；复用既有 .meta-item -->
							<text v-if="ev.crossDay" class="meta-item">跨零点</text>
							</view>
							<view v-if="ev.hasRenderablePhotos" class="photo-strip">
							<image v-for="(p, pi) in ev.renderPhotoPaths" :key="pi" class="strip-img pressable" :src="p" mode="aspectFill" lazy-load="true" @tap.stop="onPhotoTap(ev.renderPhotoIds[pi])" />
						</view>
						<!-- 语音卡（W0-2 播放态，同待确认区卡） -->
						<view v-if="ev.voice != null" class="voice-card pressable" @tap.stop="playVoice(ev.voice)">
							<view class="voice-play-btn">
								<view v-if="ev.voiceActive && ev.voicePlaying" class="voice-pause-icon">
									<view class="voice-pause-bar"></view>
									<view class="voice-pause-bar"></view>
								</view>
								<view v-else class="voice-play-icon"></view>
							</view>
							<view style="flex:1;">
								<view class="voice-wave">
									<VoiceWave :heights="ev.voice.waveHeights" :waveform="wf.waveformOf(ev.voice.contentId)" :active="ev.voiceActive" :progress="ev.voiceProgress" idle-color="#C4913C" />
								</view>
								<view v-if="ev.voiceActive" class="voice-progress-row">
									<text class="voice-progress-time">{{ ev.voiceCurText }}</text>
									<view class="voice-track">
										<!-- 2026-10-16（RC-F 播放态性能）：进度填充由 `width:%` 改 `transform:scaleX()`。
										     `width` 是**布局属性**，每 tick 改动都会触发布局重排；`transform` 走**合成层**，
										     只重绘不重排。值取自卡属性 `voiceProgress`（组装期/tick 预计算进卡片，
										     模板零函数调用——见 `syncVoiceCards`）。类仍是既有 `.voice-track-fill`
										     （零新增视觉元素），`transform-origin:left` 走内联样式（不动共享 CSS）。 -->
										<view class="voice-track-fill" :style="'transform:scaleX(' + ev.voiceProgress + ');transform-origin:left;'"></view>
									</view>
									<text class="voice-progress-time">{{ ev.voiceTotalText }}</text>
								</view>
								<view style="display:flex; flex-direction:row; align-items:center; margin-top:8rpx;">
									<text class="voice-title">{{ ev.voice.title }}</text>
									<text class="voice-duration">{{ ev.voiceActive ? ev.voiceTotalText : ev.voice.duration }}</text>
								</view>
							</view>
						</view>
						<!-- 文字卡 -->
						<view v-if="ev.quote != null && ev.quote != ''" class="quote-card">
							<view class="quote-line"></view>
							<view class="quote-content">
								<text class="quote-text serif">{{ ev.quote }}</text>
								<text v-if="ev.quoteSource != null && ev.quoteSource != ''" class="quote-source">—— {{ ev.quoteSource }}</text>
							</view>
						</view>
					</view>
				</view>

				<!-- L2 待确认区（2026-10-17 起移入历史区底部，仍在 .feed 内） -->
				<!-- 2026-10-16（用户裁决 · 采纳"待确认区不做日期过滤"）：本区是"**待用户确认**"的
				     **动作队列**，不是按天的历史区 ⇒ 过滤会把**今天的确认入口一起藏掉** ✗；
				     代价（今天的 pending 卡与上方「今天」块的 entry 可能同图）用户已判定**可接受** ✓。
				     2026-10-17：**移出主视区**——本块是可缺席块（v-if 在整块上，移位不新增 v-if ⇒
				     不踩 R9-D），整段移到 `visibleDays` 历史循环之后 = 历史区底部；
				     确认/忽略入口与逻辑零改动（eo.confirmPending / eo.ignorePending 不变）。 -->
				<view v-if="pendingEvents.length > 0" class="pending-block">
					<text class="day-title serif">待确认</text>
					<text class="pending-sub muted">这些主题还不确定，确认后不会再被算法改动</text>
					<view v-for="ev in pendingEvents" :key="ev.id" class="card card-l2 pressable" @tap="openDetail(ev)">
						<view v-if="ev.coverPath != ''" class="cover-wrap">
							<image class="cover-img" :src="ev.coverPath" mode="aspectFill" lazy-load="true" />
						</view>
						<text class="card-title serif title-l2">{{ ev.title }}</text>
						<view class="card-meta">
							<!-- 2026-10-16（RC-F 性能）：层级文案改查表（`levelLabels[ev.level]`），去掉模板函数调用
						     ——列表每次整树重渲染时不再逐卡调 `levelText()`（原实现每 tick 全列表重算） -->
						<text class="meta-item">{{ levelLabels[ev.level] }}</text>
							<!-- 卡PA R4：视图字段组装期预计算（卡E01 计数口径不变），模板零函数调用 -->
							<text v-if="ev.hasRenderablePhotos" class="meta-item rust">{{ ev.photoCountText }}</text>
						</view>
						<view v-if="ev.hasRenderablePhotos" class="photo-strip">
							<image v-for="(p, pi) in ev.renderPhotoPaths" :key="pi" class="strip-img pressable" :src="p" mode="aspectFill" lazy-load="true" @tap="onPhotoTap(ev.renderPhotoIds[pi])" />
						</view>
						<!-- 语音卡：琥珀播放钮 + 波形竖条阵列（W0-2 播放态：钮变暂停 + 已播金/未播米 + 进度行） -->
						<view v-if="ev.voice != null" class="voice-card pressable" @tap="playVoice(ev.voice)">
							<view class="voice-play-btn">
								<view v-if="ev.voiceActive && ev.voicePlaying" class="voice-pause-icon">
									<view class="voice-pause-bar"></view>
									<view class="voice-pause-bar"></view>
								</view>
								<view v-else class="voice-play-icon"></view>
							</view>
							<view style="flex:1;">
								<view class="voice-wave">
									<VoiceWave :heights="ev.voice.waveHeights" :waveform="wf.waveformOf(ev.voice.contentId)" :active="ev.voiceActive" :progress="ev.voiceProgress" idle-color="#C4913C" />
								</view>
								<view v-if="ev.voiceActive" class="voice-progress-row">
									<text class="voice-progress-time">{{ ev.voiceCurText }}</text>
									<view class="voice-track">
										<!-- 2026-10-16（RC-F 播放态性能）：进度填充由 `width:%` 改 `transform:scaleX()`。
										     `width` 是**布局属性**，每 tick 改动都会触发布局重排；`transform` 走**合成层**，
										     只重绘不重排。值取自卡属性 `voiceProgress`（组装期/tick 预计算进卡片，
										     模板零函数调用——见 `syncVoiceCards`）。类仍是既有 `.voice-track-fill`
										     （零新增视觉元素），`transform-origin:left` 走内联样式（不动共享 CSS）。 -->
										<view class="voice-track-fill" :style="'transform:scaleX(' + ev.voiceProgress + ');transform-origin:left;'"></view>
									</view>
									<text class="voice-progress-time">{{ ev.voiceTotalText }}</text>
								</view>
								<view style="display:flex; flex-direction:row; align-items:center; margin-top:8rpx;">
									<text class="voice-title">{{ ev.voice.title }}</text>
									<text class="voice-duration">{{ ev.voiceActive ? ev.voiceTotalText : ev.voice.duration }}</text>
								</view>
							</view>
						</view>
						<!-- 文字卡：左侧琥珀引用竖线 + 引言体 -->
						<view v-if="ev.quote != null && ev.quote != ''" class="quote-card">
							<view class="quote-line"></view>
							<view class="quote-content">
								<text class="quote-text serif">{{ ev.quote }}</text>
								<text v-if="ev.quoteSource != null && ev.quoteSource != ''" class="quote-source">—— {{ ev.quoteSource }}</text>
							</view>
						</view>
						<view class="pending-actions">
							<view class="pending-btn pending-btn-ghost pressable" @tap="ignorePending(ev)">
								<text class="pending-btn-text">忽略</text>
							</view>
							<view class="pending-btn pending-btn-solid pressable" @tap="confirmPending(ev)">
								<!-- 2026-10-11 静态审查 #11：主按钮需白字类（`.pending-btn-text` 是深棕
								     #3a2e25，配 rust 实底后对比度极低、视觉像禁用态；而白字类
								     `.pending-btn-text-solid` 此前零使用者 = 规则写了没人用） -->
								<text class="pending-btn-text pending-btn-text-solid">确认</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 卡PB R1：尾部加载更多（点一次多 20 组；触底自动加载按卡面不做） -->
				<view v-if="visibleDayCount < historyDayCount" class="load-more pressable" @tap="loadMoreDays">
					<text class="load-more-text">加载更多 · 还有 {{ historyDayCount - visibleDayCount }} 组</text>
				</view>
			</view>
		</scroll-view>

		<!-- D-21（2026-10-25）：事件拆分面板。此前 `useEventOps.doSplit` 只设四态、
		     **模板无任何面板消费**（`split-panel` 全仓 0 命中、`tab-index.css:592-628` 的
		     `.split-*` 规则零使用者）⇒ 入口被移除、点不到。现面板落地，入口恢复。
		     样式**复用** `tab-index.css` 里那批零使用者的 `.split-*` 规则（不新造视觉）。 -->
		<view v-if="eo.showSplitPanel.value" class="split-mask" @tap="onCancelSplit">
			<view class="split-panel" @tap.stop>
				<text class="split-title">选择要拆出去的成员</text>
				<view v-if="eo.splitLoading.value" class="split-tip">
					<text class="split-item-text">正在读取成员…</text>
				</view>
				<view v-else-if="eo.splitItems.value.length < 2" class="split-tip">
					<text class="split-item-text">成员不足，无法拆分</text>
				</view>
				<scroll-view v-else class="split-scroll" direction="vertical">
					<view v-for="(it, i) in eo.splitItems.value" :key="it.contentId"
						class="split-item pressable" @tap="onToggleSplitItem(i)">
						<text class="split-check">{{ it.selected ? '✓' : '○' }}</text>
						<text class="split-item-text">{{ it.title }}</text>
						<text class="split-time">{{ eo.splitTimeText(it.takenAt) }}</text>
					</view>
				</scroll-view>
				<view class="split-actions">
					<view class="split-cancel pressable" @tap="onCancelSplit">
						<text class="split-cancel-text">取消</text>
					</view>
					<view class="split-ok pressable" @tap="onConfirmSplit">
						<text class="split-ok-text">拆分</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 卡PB R1：computed 显式引入（ref 沿页面现状未显式引入，避免重复声明）
	import { computed, onMounted, watch } from 'vue'
	import { WaveformCache } from '@/composables/useWaveform'
	import { PhotoAttach } from '@/composables/usePhotoAttach'
	import { EventOps } from '@/composables/useEventOps'
	import { requestShellTab, shellSheetSeq, shellSheetMode, shellActiveTab } from '@/utils/shell_state'
	import { fetchTimelineAsync, getCachedTimeline, getSnapshotTimeline, wasLastFetchFailed, TimelineEvent, EventVoice, buildDayGroups, DayGroup } from '@/utils/timeline'
	import {
		toggleVoice,
		voiceCurrentId,
		voicePlaying,
		voiceProgress,
		voiceCurSec,
		voiceTotalSec,
		fmtVoiceTime
	} from '@/utils/audio_player'
	// 2026-10-16（去重口径）：日分组键统一走 `time.dayKey`（本地时区）——历史区过滤「今天」的
	// 日组要用它，与 `entries_api`/`timeline.buildDayGroups` **同源** ✓。
	import { parseIsoMs, dayKey } from '@/utils/time'
	import { UploadProgress, UploadedPhoto, isoString } from '@/utils/uploader_types'
	import { uploadBatch } from '@/utils/uploader_batch'
	// 2026-09-11 D-19 修复：**行为入口** createPhotoWatch 走插件根（recorder 同款已验证路径，
	// 原生 dex 纳入靠这一条）；纯数据类 PhotoItem 的声明家在 utssdk/interface.uts——
	// 插件根代理不转发 interface 的再导出符号（实测：root 导入 PhotoItem 报
	// "is not exported by ...?uts-proxy"），故二者分开 import。
	import { createPhotoWatch } from '@/uni_modules/yishu-photo-watch'
	import { PhotoItem } from '@/uni_modules/yishu-photo-watch/utssdk/interface.uts'
	import { showErrorToast, ApiError, fetchDailySummary, DailySummary } from '@/utils/api'
	import { aggregateToEventsChunked, AggRunResult } from '@/utils/agg_runner.uts'
	import { syncClientEvents, SyncOutcome } from '@/utils/event_sync'
		// 2026-10-15（台账 §4.20 ㉘ · 「今天」块）：今天的**文字记录** —— 读 contents 而非 events
	//（文字不产 event，详见模块注释）
	import { fetchTodayEntries, wasLastEntriesFetchFailed, TodayEntry, buildLookback, LookbackRow } from '@/utils/entries_api'
import { fetchTodayEcho, dismissEcho, EchoCard, wasLastEchoFailed } from '@/utils/play_echo'
	import {
		flushOpQueue,
		pendingOpCount,
		EventPhotoEntry,
		mapAcceptedToClientIds
	} from '@/utils/event_ops'
	import { recordGrantTime, recordFirstDayRender } from '@/utils/agg/perf_timing.uts'

	// 响应式数据（uvue script setup 裸 let 非响应式，必须 ref —— 真机实锤：数据到位但界面停在加载态）
	let loaded = ref(false)
	// 2026-10-16（用户裁决 · 批准修冷启动空态闪现）：**今天记录（contents）是否已出结果**。
	// 与 `loaded`（时间轴 events 就绪）合起来才是真正的"加载中"（见 `loading`）——`showEmpty` 依赖
	// `todayEntries`，而它是**异步填充**的：只看 `loaded` 会让"只记文字、无事件"的用户在 contents
	// 返回前**闪现一次「还没有回忆」** ✗（一 RTT）。本标志**单调**（一旦 true 不再回 false），
	// 故下拉刷新不会重出骨架（刷新态走 `refreshing` 转圈）✓。
	let todayLoaded = ref(false)
	let refreshing = ref(false)
	let days = ref<Array<DayGroup>>([])
	let pendingEvents = ref<Array<TimelineEvent>>([])
	// 壳内空态（2026-10-09）：时间轴空时渲染拍照首页引导（替代原 redirectTo empty 整页跳转）
	let emptyState = ref(false)
	// 2026-10-15（真机反馈「空状态页不该嵌在有状态页里」+ 首拉失败整屏空白）：
	// **"加载失败" 与 "真·空" 必须分开**。原实现只有 emptyState 一个派生量：
	//   · 首拉失败时走 `loaded = true`（收起骨架）而 emptyState 仍 false ⇒ 空态块被
	//     `ui-hidden` 藏住、feed 又无内容 = **整屏空白**（无引导、无 CTA）✗；
	//   · 反过来，一旦把失败也收敛成空态，就会显示「还没有回忆」——那是**假空态** ✗
	//     （用户会以为云端记忆丢了）。
	// 故单列 loadFailed：失败且有旧数据 ⇒ 保持旧数据（不打扰）；失败且无任何数据 ⇒ 如实显示失败态。
	let loadFailed = ref(false)

	// 空态 CTA（经 shell_state 桥拉起全壳唯一 RecordSheet；'photo'=直达拍照流，同 empty 页口径）
	function emptyTakeFirst(): void {
		shellSheetMode.value = 'photo'
		shellSheetSeq.value = shellSheetSeq.value + 1
	}

	function emptyVoice(): void {
		shellSheetMode.value = ''
		shellSheetSeq.value = shellSheetSeq.value + 1
	}
	let uploading = ref(false)
	let uploadDone = ref(0)
	let uploadTotal = ref(0)
	let uploadFailed = ref(0)
	let echo = ref<EchoCard | null>(null)
	// R8：hero 副标题数据驱动（画布口径：sub1=「N月 · X 条新记忆」sub2=最新记忆摘要 · M月dd日 HH:mm）
	let heroSub1 = ref('')
	let heroSub2 = ref('')
	// L-02a（方案 A · 2026-09-25）：照片挂载/照片详情（状态 + 索引表 + 7 方法）整块进
	// `usePhotoAttach`；组件经 `pa` 访问同一 ref 对象，模板绑 `onPhotoTap` 由下方薄包装转发。
	const pa = new PhotoAttach()
	// 卡PA D2/R2：当前渲染数据源（与 timeline.uts 缓存同数组引用，本地补丁直接同步缓存）
	let currentEvents: Array<TimelineEvent> = []
	// L-02b（方案 A · 2026-09-25）：卡片操作/确认/合并/拆分整块进 `useEventOps`；注入
	// 「取值函数」（currentEvents 是 let、会被整组浅替换，不能传快照）+ 渲染/刷新出口 + 日组读取。
	const eo = new EventOps(
		() => currentEvents,
		(evs: Array<TimelineEvent>) => { renderFromEvents(evs) },
		() => { refreshSilently() },
		() => days.value
	)
	// 卡PA R2：上次成功拉取时间（onShow TTL 内不重拉）
	let lastFetchAt = 0
	// 卡PA R2：页面存活守卫（缩略图后台批次回调在 onUnload 后不再触发渲染）
	let pageAlive = ref(true)
	// 卡PA R2：onShow 静默刷新 TTL（与 timeline.uts TIMELINE_CACHE_TTL 同值口径）
	const SHOW_REFRESH_TTL: number = 60000
	// 卡PB R1：按日分批渲染——首屏 20 组，尾部按钮每点一次 +LOAD_MORE_STEP 组。
	// 协同铁律：缓存命中/refreshSilently/patchEventById 都是 days.value 整组浅替换，
	// visibleDayCount 不参与替换保持原值，visibleDays 每次渲染从 days 现切（不缓存 slice 结果），
	// 因此分批对闪屏缓存刷新路径零改动。
	const DAY_PAGE_INITIAL: number = 20
	let visibleDayCount = ref(DAY_PAGE_INITIAL)
	const LOAD_MORE_STEP: number = 20
	// RC-3b（2026-10-16 · 批次 6）：**分页窗口复位位**。`visibleDayCount` 只增不减 ⇒ 点过
	// 「加载更多」后，每次整组浅替换（60s 回壳补刷 / 缩略图补图 / 下拉刷新）都要重渲染越来越多的
	// 日组，代价**随使用时长单调增长**。现由 `onRefresh`（用户显式下拉刷新）置位，
	// `applyFetchedEvents`（唯一的"拿到真实结果"出口）成功时消费并复位。
	// 为什么不在静默刷新里复位：那会把用户已经拉出来的窗口在每次回壳补刷时抽走（列表跳变）。
	let resetPagingOnNextRender = false
	// 卡PB R1：可见日组窗口（computed 先例：favorites/search 页同款写法）
	// 🚨 2026-10-16（去重口径 · 用户明确要求）：历史区**只显示今天之前**的日组——
	// 「今天」的内容由上方「今天」块（读 `contents`）**独占**；若日分组里再出现今天的事件卡片，
	// 同一张今天的照片会**出现两次** ✗。事件日分组键 = `dayKey(startTime)`（见 buildDayGroups），
	// 与本处 `dayKey(Date.now())` 同源 ⇒ 排除 `d.key == 今天` 即可 ✓。
	let historyDays = computed((): Array<DayGroup> => {
		const today = dayKey(Date.now())
		return days.value.filter((d: DayGroup): boolean => d.key != today)
	})
	let visibleDays = computed((): Array<DayGroup> => {
		return historyDays.value.slice(0, visibleDayCount.value)
	})
	// 历史区总日组数（已排除今天）——「加载更多」的剩余数用它，**不能**用 `days.length`
	// （含今天会多算一组，按钮"还有 N 组"会虚高 ✗）
	let historyDayCount = computed((): number => {
		return historyDays.value.length
	})

	// 生命周期
	// B10 方案A 组件契约（2026-09-09 P2）：token 就绪由 shell ready 闸门保证（原 onLoad 内
	// ensureLogin().then 串行语义上收 shell）；shownSeq 每次切到本 tab ++（原页级 onShow TTL 刷新）；
	// savedSeq 记录保存成功 ++（原 RecordSheet @saved）。数据常驻=拍板项3；离页停播=拍板项2 退役
	// （原 onUnload stopVoice 删除，跨 tab 连播为正式行为；pageAlive 保 true——壳不销毁本页）。
	const props = defineProps({
		shownSeq: { type: Number, default: 0 },
		savedSeq: { type: Number, default: 0 }
	})
	// 原 onLoad 体（[perf] 埋点/卡PA D2 缓存先渲/photoWatch 初始化，逐字保留）
	onMounted((): void => {
		// P-4 内容出现时间埋点（新验收口径）：logcat 抓 [perf] 行，
		// content-visible(onLoad 起算) = 真实可感知指标；TotalTime 受 debug 基座固定成本支配基本不动
		console.log('[perf] index onLoad at ' + Date.now())
		console.log('[dbg-index] onLoad')
		// 卡PA D2：命中缓存先渲染（消除切页闪屏），再后台静默刷新、刷新完浅替换
		// （token 就绪由 shell ready 闸门保证——原 ensureLogin().then 包装解包直调）
		loadHeroSubs()  // R9-7：hero 副标题 API 拉取（与 timeline 刷新解耦）
		const hit = getCachedTimeline()
		if (hit != null) {
			console.log('[dbg-index] timeline cache hit, age=' + ((Date.now() - hit.fetchedAt) / 1000).toFixed(0) + 's -> instant render')
			applyFetchedEvents(hit.events)
			refreshSilently()
		} else {
			// 冷启动：内存缓存必空（模块级数组随进程销毁）⇒ 先用**持久快照**立刻出画面，
			// 再静默刷新覆盖（2026-10-14 · 用户反馈"每次打开都要等一会数据才出现"）。
			// 快照缺失/过旧（>7 天）/解析失败都返回 null ⇒ 此时才走全量拉取（reload）。
			const snap = getSnapshotTimeline()
			if (snap != null) {
				const ageH = ((Date.now() - snap.fetchedAt) / 3600000).toFixed(1)
				console.log('[dbg-index] timeline snapshot hit, age=' + ageH + 'h -> instant render')
				applyFetchedEvents(snap.events)
				refreshSilently()
			} else {
				reload()
			}
		}
		try {
			const photoWatch = createPhotoWatch()
			if (photoWatch.isReadPermissionGranted()) {
				watchStarted = true
				startWatch()
			} else {
				// 2026-09-11 D-24 修复：原实现此处**没有 else** —— 未授权时静默跳过，
				// 且 requestReadPermission() 全项目零调用 = 永远拿不到授权（死锁），
				// 全程零日志 ⇒ 真机表现成"什么都没发生"（无通知、无提示、无日志），
				// 掩盖了 D-23（SDK 硬编码致权限名错误）整整一轮。
				// 现在：显式打点（含真实 SDK 与权限名，用于区分"用户拒绝"与"本机无此权限"）
				//      + 拉起真实系统授权框，并**保证回调**驱动后续决策。
				console.log('[dbg-index] 相册读权限未授予，准备申请: perm=' + photoWatch.getReadPermissionName())
				photoWatch.requestReadPermission((granted: boolean, doNotAskAgain: boolean): void => {
					console.log('[dbg-index] 相册权限申请回调 granted=' + granted + ' doNotAskAgain=' + doNotAskAgain)
					if (granted) {
						watchStarted = true
						startWatch()
					} else if (doNotAskAgain) {
						// 用户已勾选"不再询问"：不再重复弹窗/打扰，仅留日志（须去系统设置手动开）
						console.log('[dbg-index] 相册权限被永久拒绝（不再询问），监听未启动；需到系统设置手动开启')
					} else {
						console.log('[dbg-index] 相册权限被拒，页面级监听未启动（下次进入会再次申请）')
						uni.showToast({ title: '未获得相册权限，暂不自动监听新照片', icon: 'none' })
					}
				})
			}
		} catch (e) {
			console.log('[dbg-index] photoWatch init failed (标准基座无原生插件，忽略): ' + e)
		}
	})
	watch((): number => props.shownSeq, (n: number): void => {
		// 2026-10-11 静态审查 #7：切回首页时**幂等复查**相册监听（用户去系统设置开权限后
		// 不杀进程也能生效）。成本 = 一次 checkSelfPermission + 日志，无权限框打扰。
		recheckWatchQuiet()
		// 原 onShow 体逐字（TTL 内不重拉，过期后台静默刷新）
		if (!loaded.value) {
			return
		}
		if (Date.now() - lastFetchAt < SHOW_REFRESH_TTL) {
			return
		}
		refreshSilently()
	})
	watch((): number => props.savedSeq, (n: number): void => {
		if (n > 0) {
			onRecordSaved()
		}
	})

	// 导航方法
	function goSearch(): void {
		requestShellTab('search', '') // B10 方案A：壳内零销毁切 tab（原 reLaunch 老页）
	}

	// 语音播放（W0-2 就地播放：播放钮变暂停 + 波形金色跳动 + 进度行，F5a 规范）
	function playVoice(voice: EventVoice | null): void {
		if (voice == null) {
			uni.showToast({ title: '语音文件不存在', icon: 'none' })
			return
		}
		// BB3：播放入口懒拉真实波形（列表不为每卡预拉；组件内 waveform prop 真值优先）
		wf.loadWaveform(voice.contentId)
		toggleVoice(voice.contentId)
	}

	// B5.2f：波形缓存收敛为共享组合式函数（唯一实现 client/composables/useWaveform.uts）
	const wf = new WaveformCache()

	/**
	 * RC-5（2026-10-14 · 台账 §4.20）：把播放态写进「正在播放那张卡」的**预计算字段**。
	 *
	 * 原实现是模板里每卡 4~6 次函数调用（`voiceIsActive` / `voiceIsPlaying` /
	 * `voiceProgressOfCard` / `voiceCurSecText` / `voiceTotalSecText`），其中**两处 `v-if`
	 * 直接依赖函数调用**——平台对 `v-if` 整树卸载处理不稳（`skills/hbuilderx-uniappx-
	 * runloop/SKILL.md:97-106`），且一次 tick 的整表重渲染会把**全部**语音卡的这些函数重算一遍。
	 * 现改为「组装期 / tick 写卡片字段、模板只读字段」，与 `TabSearch.syncActiveCard`
	 * （RC-1/RC-2 批次已落地的同款范式）保持一致。
	 *
	 * 三条要点（缺一不可）：
	 *  ① **相等守卫**：值没变不写，只有真值变化的卡走更新路径；
	 *  ② 真变过就 `days`/`pendingEvents` **整组浅替换**（`slice()`）——`buildDayGroups` 会
	 *     **新建**卡片对象，且 uvue 对"就地改字段"能否驱动重渲染不作保证 ⇒ 用一次廉价
	 *     slice 换**确定性重渲染**（`days.value` 整组替换本就是本页既有操作，见 `renderFromEvents`）；
	 *  ③ **渲染出口补同步**：每次 `renderFromEvents` 后调一次（见该函数内注释）。
	 */
	function syncVoiceCards(): void {
		const cid = voiceCurrentId.value
		const playing = voicePlaying.value
		const prog = voiceProgress.value
		const cur = fmtVoiceTime(voiceCurSec.value)
		const total = fmtVoiceTime(voiceTotalSec.value)
		let changed = false
		// 两处渲染源都要覆盖：待确认区 + 日卡片（同为 TimelineEvent）
		const pend = pendingEvents.value
		for (let i = 0; i < pend.length; i++) {
			if (applyVoiceState(pend[i], cid, playing, prog, cur, total)) {
				changed = true
			}
		}
		const ds = days.value
		for (let d = 0; d < ds.length; d++) {
			const evs = ds[d].events
			for (let i = 0; i < evs.length; i++) {
				if (applyVoiceState(evs[i], cid, playing, prog, cur, total)) {
					changed = true
				}
			}
		}
		if (changed) {
			days.value = ds.slice()
			pendingEvents.value = pend.slice()
		}
	}

	/** 把当前播放态写进一张卡；返回"是否发生了变化"（相等守卫，无变化零写入） */
	function applyVoiceState(
		ev: TimelineEvent,
		cid: string,
		playing: boolean,
		prog: number,
		cur: string,
		total: string
	): boolean {
		const v = ev.voice
		if (v == null) {
			return false // 无语音成员：本卡不参与播放态
		}
		const isActive = v.contentId == cid
		let changed = false
		if (ev.voiceActive != isActive) {
			ev.voiceActive = isActive
			changed = true
		}
		if (isActive) {
			if (ev.voicePlaying != playing) {
				ev.voicePlaying = playing
				changed = true
			}
			if (ev.voiceProgress != prog) {
				ev.voiceProgress = prog
				changed = true
			}
			if (ev.voiceCurText != cur) {
				ev.voiceCurText = cur
				changed = true
			}
			if (ev.voiceTotalText != total) {
				ev.voiceTotalText = total
				changed = true
			}
		} else if (ev.voicePlaying || ev.voiceProgress != 0 || ev.voiceCurText != '' || ev.voiceTotalText != '') {
			// 退出活动态：清干净（否则旧卡残留进度条/时长）
			ev.voicePlaying = false
			ev.voiceProgress = 0
			ev.voiceCurText = ''
			ev.voiceTotalText = ''
			changed = true
		}
		return changed
	}

	// 播放态源 ref（audio_player 全局单例）→ 单源 watch 逐个挂，tick 驱动面收敛到 syncVoiceCards。
	// 可见性守卫（RC-2 同款）：本组件在壳内**常驻**（shell 用 `v-show` 切换，组件不销毁）⇒ 隐藏时
	// 这些 watch 仍被全局 ref 驱动，重算+整组浅替换纯属空转。切回本 tab 时补一次同步对齐。
	function syncVoiceCardsIfVisible(): void {
		if (shellActiveTab.value != 'index') {
			return
		}
		syncVoiceCards()
	}
	watch(voiceCurrentId, (): void => {
		syncVoiceCardsIfVisible()
	})
	watch(voicePlaying, (): void => {
		syncVoiceCardsIfVisible()
	})
	watch(voiceProgress, (): void => {
		syncVoiceCardsIfVisible()
	})
	watch(shellActiveTab, (t: string): void => {
		if (t == 'index') {
			syncVoiceCards()
		}
	})

	// 数据加载
	// P-4（2026-09-04 峰宝拍板）：首拉不被离线队列阻塞——fetchAll 立即走；
	// flushOpQueue 并行冲刷，确有离线操作时冲刷完补一次静默刷新保最终一致
	// （此前串行：登录→冲刷→拉取，队列非空时内容出现晚 1~2 个 RTT）
	function reload(): void {
		console.log('[perf] index reload: fetchAll 与 flushOpQueue 并行')
		fetchAll()
		const hadOps = pendingOpCount() > 0
		flushOpQueue().then((_remain: number) => {
			console.log('[dbg-index] flushOpQueue done, remain=' + _remain + ', hadOps=' + hadOps)
			if (hadOps && pageAlive.value) {
				refreshSilently()
			}
		})
	}
	// 本地 mock 时间轴注入路径已于 2026-08-31 移除（峰宝拍板：这是 MVP，不是 demo）：
	// events==0 直接走诚实空态（fetch 失败重试一次后仍空 ⇒ 壳内 emptyState 渲染，
	// **不再跳 /pages/empty/empty**——整页跳转会销毁壳，见本文件空态块注释），
	// 不再注入 ev-m1~m4 假 id 数据。

	// 空状态重试去重：瞬态失败重试一次的守门位（成功后复位）
	let emptyRetryDone = false

	function fetchAll(): void {
		console.log('[dbg-index] fetchAll -> fetchTimelineAsync')
		fetchTimelineAsync(null, onThumbBatch).then((events: Array<TimelineEvent>) => {
			console.log('[dbg-index] fetchTimeline resolved: ' + events.length + ' events')
			// 🚨 2026-10-11 静态审查 #1 修复：**失败结果不得覆盖已渲染数据**。
			// `fetchTimelineAsync` 用「空数组」表达失败（resolve([])），原实现无条件
			// `applyFetchedEvents(events)` ⇒ 下拉刷新遇断网/502/401 时：①时间轴卡片整片消失
			// （且 emptyState 仍 false ⇒ 连"还没有回忆"引导都没有 = 一片空白）②回响卡被抹掉
			// ③2.5s 重试再失败 ⇒ 显示假空态「还没有回忆」（用户以为云端记忆丢了）。
			// `refreshSilently` 一直有同款守卫（同语义两条路径必须同守卫），唯独此处漏了。
			if (wasLastFetchFailed()) {
				console.log('[dbg-index] fetchTimeline failed -> keep current UI')
				// 首拉失败也要收起骨架屏与下拉转圈（否则骨架永驻/转圈不停）：
				// 失败态下"骨架收起 + 保持现状"与 refreshSilently 的语义一致。
				loaded.value = true
				refreshing.value = false
				// 2026-10-16（三态 · 分支 B2）：本支**不调** loadTodayEntries（失败不该再去拉今天记录）⇒
				// 必须显式置 `todayLoaded`，否则 `loading` 恒真 = **骨架永驻** ✗（用户裁决的硬要求）。
				todayLoaded.value = true
				// 2026-10-15（真机反馈后修）：**无任何可显示内容时，把"失败"如实标出来**。
				// 原实现只收起骨架屏就 return ⇒ 空态块被 ui-hidden 藏住、feed 又没内容
				// = **整屏空白**（无引导、无 CTA、用户以为 App 坏了）✗。
				// 有旧数据时**保持原样**（断网不该把正在看的记忆抹掉，同 #1 守卫口径）。
				if (days.value.length === 0 && pendingEvents.value.length === 0) {
					loadFailed.value = true
				}
				return
			}
			applyFetchedEvents(events)
		})
		fetchTodayEcho().then((card: EchoCard | null) => {
			// 🚨 2026-10-11 静态审查 #1 配套：区分"请求失败"与"真无回响"（二者都是 null）。
			// 失败 ⇒ **保持现状**（断网下拉刷新不该把用户正在看的回响卡抹掉）；
			// 真无回响（跨天/名额耗尽）⇒ 清空（R7 口径：防旧卡残留指向已删内容，见 messages.uvue）。
			if (card == null && wasLastEchoFailed()) {
				console.log('[dbg-index] echo fetch failed -> keep current card')
				return
			}
			echo.value = card
		})
	}

	// 卡PA D1：缩略图后台批次落地回调 → 整组 days.value 浅替换（改数据+一次性赋值，禁逐条 push）
	// ⚠️ 2026-10-14（台账 §4.20 批次 5 · RC-3）：**同帧合并**。缩略图池每 4 张回调一次
	// （步长在 `timeline.uts` 的缩略图池），而本回调一次要做「groupDays 全量重建 +
	// `pa.attachAll`（内含 `new Map()` 重建）+ `days.value` 整组替换」——50 张照片即十余次
	// 整树重建挤在几百毫秒内 ⇒ 列表掉帧、点击无响应（用户感知为"滑动不丝滑"）。
	// 现改为 16ms 窗口内**只渲染一次**（同帧合并）；尾批必定落帧，数据不丢。
	let thumbBatchTimer = 0
	function onThumbBatch(): void {
		if (!pageAlive.value || !loaded.value) {
			return
		}
		if (thumbBatchTimer != 0) {
			return // 本帧已排队，由它统一渲染（避免重复整树重建）
		}
		thumbBatchTimer = setTimeout((): void => {
			thumbBatchTimer = 0
			if (!pageAlive.value || !loaded.value) {
				return // 卸载/未加载：丢弃本帧渲染（同原守卫）
			}
			patchThumbsInPlace()
		}, 16)
	}

	/**
	 * RC-3（2026-10-16 · 批次 6）：缩略图**按内容标识增量补丁**（替代整组重建）。
	 *
	 * 病根：缩略图池每 4 张回调一次 → `renderFromEvents` → `groupDays`（`buildDayGroups` 为
	 * **每个** L1 `new TimelineEvent` 拷贝）→ `pa.attachAll`（`new Map()` + 逐卡重挂 + 一条长
	 * console.log）→ `days.value` 整组替换。一批 4 张图引发「O(全量卡) 的对象新建 + 重挂」，
	 * 50 张照片即十余次，挤在几百毫秒内 ⇒ 掉帧、点击无响应。
	 *
	 * 现按 `useEventOps.patchEventById` 的同一范式（**定位单卡 → 就地改 → 一次性通知**），
	 * 差异只是"定位条件"由事件 id 换成"本卡还有图没上屏"：
	 *   · 只对 `photos.length != renderPhotoPaths.length` 的卡重挂——缩略图池往 `ev.photos`
	 *     push（共享数组引用），而 `renderPhotoPaths` 只在 `attachEventPhotos` 里重算 ⇒
	 *     两者不等 ⇔ 有新图未上屏（**充分**判据；重复 content_id 的极端数据只会多挂一次，
	 *     无正确性问题）；
	 *   · 未变的卡**零 JS 工作**，`groupDays`/`attachAll`（含长日志）**完全不再参与补图路径**；
	 *   · 全部补完只做**一次** `days.value` 浅替换（`slice()` = O(n) 引用复制，非重建）通知渲染。
	 */
	function patchThumbsInPlace(): void {
		let patched = 0
		const ds = days.value
		for (let d = 0; d < ds.length; d++) {
			const evs = ds[d].events
			for (let i = 0; i < evs.length; i++) {
				const ev = evs[i]
				if (ev.photos.length != ev.renderPhotoPaths.length) {
					pa.attachEventPhotos(ev)
					patched++
				}
			}
		}
		const pend = pendingEvents.value
		for (let i = 0; i < pend.length; i++) {
			const ev = pend[i]
			if (ev.photos.length != ev.renderPhotoPaths.length) {
				pa.attachEventPhotos(ev)
				patched++
			}
		}
		if (patched > 0) {
			days.value = ds.slice()
			console.log('[dbg-index] 缩略图增量补丁: patched=' + patched + '/' + ds.length + ' 日组（未走 groupDays/attachAll）')
		}
	}

	// 卡PA D2：渲染出口（days/pending 整组浅替换；不清空、不回退加载态防闪屏）
	function renderFromEvents(events: Array<TimelineEvent>): void {
		const firstRender = !loaded.value
		days.value = groupDays(events)
		pa.attachAll(days.value, pendingEvents.value)
		// RC-5（2026-10-14）：`buildDayGroups` **新建**卡片对象（播放态字段回到初值）⇒ 每次渲染
		// 出口补一次同步，否则"正在播放/已暂停"在重渲染后会显示成"未播放"
		// （同 `TabSearch.rebuildVoice → syncActiveCard`）。
		syncVoiceCards()
		loaded.value = true
		refreshing.value = false
		// 🚨 2026-10-11 静态审查 #2 修复：`emptyState` 是**派生状态**，必须收敛在渲染出口。
		// 原实现只在 applyFetchedEvents 内重算，而 days/pending 还能被其它路径改变
		// （useEventOps 经 render 出口的 ignorePending / patchEventById / removeEventById）
		// ⇒ 已确证复现：新用户唯一一条事件是待确认态 → 点「忽略」→ days 与 pending 同时为空，
		// 但 emptyState 仍为 false ⇒ feed 无内容 + 空态块被 ui-hidden 藏住 = **整页白屏**
		// （无引导、无 CTA，只能靠下拉刷新自愈）。
		// ⚠️ 本收敛与 #1「失败结果不进入本函数」是**配套**的：先有 #1 才有无条件收敛
		// （否则失败时的空数组会立刻显示假空态）。
		emptyState.value = days.value.length === 0 && pendingEvents.value.length === 0
		// 渲染出口 = 本次**拿到了真实结果**（失败路径有 wasLastFetchFailed 守卫，不进入本函数）
		// ⇒ 清掉失败标记（否则下一次失败前会一直显示"加载失败"）✓
		loadFailed.value = false
		// P-4 内容出现时间埋点：onLoad → 首帧内容上屏（logcat [perf] 行）
		if (firstRender) {
			console.log('[perf] index content-visible at ' + Date.now())
		}
	}

	// R9-7（Q5 拍板）：hero 副标题 API 化——GET /stats/daily-summary 拉取，
	// 替代 R8 本地 timeline 全量计算。失败/空数据清空文案（诚实，不造假不残留——
	// 峰宝 09-06「模板 UI」投诉口径延续）。count=0 时 sub1 退化用「暂无新记忆」。
	function loadHeroSubs(): void {
		fetchDailySummary().then((s: DailySummary | null) => {
			if (s == null) {
				heroSub1.value = ''
				heroSub2.value = ''
				return
			}
			if (s.count == 0 || s.latestEventText == '' || s.latestEventTime == '') {
				heroSub1.value = '暂无新记忆'
				heroSub2.value = ''
				return
			}
			const d = new Date(parseIsoMs(s.latestEventTime))
			let hh = d.getHours().toString()
			if (hh.length < 2) {
				hh = '0' + hh
			}
			let mi = d.getMinutes().toString()
			if (mi.length < 2) {
				mi = '0' + mi
			}
			heroSub1.value = (d.getMonth() + 1).toString() + '月 · ' + s.count.toString() + ' 条新记忆'
			heroSub2.value = s.latestEventText + ' · ' + (d.getMonth() + 1).toString() + '月' + d.getDate().toString() + '日 ' + hh + ':' + mi
		})
	}

	// 卡PA D2/R2：拉取结果统一渲染入口（更新数据源引用 + lastFetchAt + 空状态守门）
	// 注（2026-10-11）：本函数现在**只被成功路径调用**（fetchAll / refreshSilently 都有
	// wasLastFetchFailed 守卫）⇒ lastFetchAt 天然只在成功时写（原"失败也写"使失败后
	// 60s TTL 内切 tab 不再补刷，属 #13）。
	function applyFetchedEvents(events: Array<TimelineEvent>): void {
		currentEvents = events
		lastFetchAt = Date.now()
		// 2026-10-15（台账 §4.20 ㉘）：「今天」块与主时间轴**同一刷新节拍** —— 下拉刷新、
		// 回壳补刷、`reload()` 全都汇到本函数（成功路径）⇒ 一个钩子覆盖所有刷新来源，
		// 不额外引监听、不重复造节拍 ✓。取数失败 resolve([])，不影响主内容 ✓。
		loadTodayEntries()
		// 2026-10-15（台账 §4.20 ㉘ · 批次 C）：「那年今日」——**纯本地判定**（全量 events 已在手；
		// 接口不带时间窗 ⇒ 不新增端点、不改契约、在野 APK 不受影响 ✓）；每年最多 3 条在
		// `buildLookback` 内部限流 ✓；无匹配则为空数组 ⇒ 模板整块不渲染（不占位 ✗）。
		lookbackRows.value = buildLookback(events)
		renderFromEvents(events)   // emptyState 已在渲染出口收敛（#2）
		// RC-3b（2026-10-16 · 批次 6）：**下拉刷新成功**才复位分页窗口（标志由 onRefresh 置位）。
		// 本函数是唯一的"拿到真实结果"出口（失败路径有 wasLastFetchFailed 守卫、不进入）⇒ 放在
		// 这里即"成功时消费"；失败时标志保留给下一次成功（语义 = 最近一次成功刷新已复位）。
		if (resetPagingOnNextRender) {
			resetPagingOnNextRender = false
			visibleDayCount.value = DAY_PAGE_INITIAL
			console.log('[dbg-index] 下拉刷新成功 → 分页窗口复位为 ' + DAY_PAGE_INITIAL)
		}
		// 空状态防误伤（2026-09-02 冷启动实锤）：请求失败（连接/鉴权瞬态）同样返回 0 条，
		// 不能当「真·空状态」——失败标记位成立时延迟重试一次，仍空才认空态。
		if (days.value.length === 0 && pendingEvents.value.length === 0) {
			if (wasLastFetchFailed() && !emptyRetryDone) {
				// 失败未确认：先收回刚收敛出来的空态，重试一次再定性（否则"还没有回忆"
				// 会先闪一下，再被 2.5s 后的重试结果改写）
				emptyState.value = false
				emptyRetryDone = true
				console.log('[dbg-index] timeline fetch failed -> retry in 2.5s')
				setTimeout(() => { fetchAll() }, 2500)
				return
			}
			emptyRetryDone = false
			// ⚠️ 2026-10-09 真机首测定案：空态为**壳内渲染**（emptyState 视图，视觉=empty 页），
			// 不 redirectTo('/pages/empty/empty')（B10 铁律「壳内零 redirectTo」）。
			// 空态置位已由 renderFromEvents 收敛，此处直接返回。
			return
		}
		emptyRetryDone = false
		if (days.value.length > 0 || pendingEvents.value.length > 0) {
			recordFirstDayRender()
		}
	}

	// 卡PA D2/R2：后台静默刷新（flushOpQueue → 拉取 → 成功才浅替换；失败保持现状不动）
	function refreshSilently(): void {
		if (!pageAlive.value) {
			return
		}
		console.log('[dbg-index] refreshSilently begin')
		flushOpQueue().then((_remain: number) => {
			if (!pageAlive.value) {
				return
			}
			fetchTimelineAsync(null, onThumbBatch).then((events: Array<TimelineEvent>) => {
				if (!pageAlive.value) {
					return
				}
				console.log('[dbg-index] refreshSilently resolved: ' + events.length + ' events')
				if (wasLastFetchFailed()) {
					console.log('[dbg-index] refreshSilently fetch failed -> keep current UI')
					return
				}
				applyFetchedEvents(events)
			})
		})
	}

	// 整卡进详情：detail 页要的是 **contentId**，而 TimelineEvent.id 是 event id，不能直接用。
	// 取数优先级：封面 content_id → 照片条第一张 → 都没有则提示（避免跳进空白详情页）
	// ── 「今天」块（2026-10-15 · 台账 §4.20 ㉘ · entry 流第一刀）──────────────────────────
	// 为什么：真机反馈「记录一条文字，时间轴没有任何东西」——根因是**文字不产 event**
	//（端侧聚合只收照片 / 云侧 L2L3 依赖标签与 GPS），而本页只读 events ⇒ 文字**永远不可见** ✗。
	// 现按 grill 后拍板的口径：**直接读 contents**（服务端事实、跨设备与重启都在 ✓），
	// 记录后立刻可见；今天没有记录时**也渲染本块**（一行静默引导替代"整页空态"，治冷启动空白 ✗）。
	// ⚠️ 本块**不能放在 `.feed` 里**：`.feed` 在 emptyState 时被整体 ui-hidden ⇒ 只记文字
	//（无照片事件）的用户会连它一起看不到 ✗ —— 故同时把空态/feed 的显示条件补上
	// `todayEntries.length === 0`（见模板注释）。
	let todayEntries = ref<Array<TodayEntry>>([])

	// 🚨 2026-10-16（三态显式化）：本页此前「骨架屏 / 空态 / feed」各自用不同表达式判显隐
	// （骨架看 `loaded`，空态/feed 看 `emptyState`）⇒ **加载期骨架与 feed 会同时可见**
	// = 真机反馈的"页面在闪"✗。现收敛成**两条派生量**（`loading` / `showEmpty`），三态互斥：
	//   · loading = `!loaded || !todayLoaded`              → 只显示骨架屏
	//   · empty   = `showEmpty`                           → 只显示空态块（loadFailed 文案在块内切换）
	//   · data    = `!loading && !showEmpty`              → 显示「今天」块 + feed
	// 互斥的算术保证：`showEmpty` 要求 `loaded && todayLoaded` ⇒ `showEmpty ⇒ !loading` ✓；
	// 「今天」块 / feed 用 `(showEmpty || loading)` 判藏 ⇒ 与骨架、空态**都不同屏** ✓。
	//
	// ⚠️ 2026-10-16（用户裁决 · 批准修冷启动空态闪现）：`todayLoaded`（见其 ref 注释）必须**全覆盖
	// 置位**，否则 `loading` 恒真 = **骨架永驻** ✗（比不修更糟）。已逐分支排查（清单 + 每支如何置位）：
	//   B1 fetchAll 成功 → applyFetchedEvents → `loadTodayEntries()`（其 then **无条件**置 todayLoaded）
	//      + `renderFromEvents` 置 loaded ✓
	//   B2 fetchAll 失败（wasLastFetchFailed）→ 本支**显式置 todayLoaded=true**（原实现此支不调
	//      loadTodayEntries ⇒ 必永驻 ✗）+ loaded=true，并按下方 loadFailed 口径如实标失败 ✓
	//   B3 applyFetchedEvents 内"失败重试"支（emptyRetryDone）→ loadTodayEntries 已在函数入口调用 ✓
	//   B4 onMounted 缓存 / 持久快照命中 → applyFetchedEvents（同 B1）✓；两者都未命中 → reload→fetchAll（B1/B2）✓
	//   B5 refreshSilently 各早返回（pageAlive=false / wasLastFetchFailed）→ **不置位**，但它只在首拉
	//      成功后才被调用（首拉恒走 B1/B2），彼时 loaded/todayLoaded 已 true ✓；且 pageAlive 在壳内
	//      本组件**恒 true**（壳不销毁本页）✓
	//   B6 EventOps 渲染出口（renderFromEvents）→ loaded 已 true、todayLoaded 已 true（B1 已置）✓
	// `todayLoaded` **单调不回退** ⇒ 下拉刷新不重出骨架（刷新态走 `refreshing` 转圈）✓。
	// 条件保留「今天也没有任何 entry」：只看 events 会把"今天记了文字/照片（还没聚合）"误判成空 ✗。
	// `loadFailed` 并入可见条件 = 修复"首拉失败 → 空态被 ui-hidden 藏住 + feed 又无内容 = 整屏空白"✗
	// （失败文案由空态块内部按 loadFailed 切换，**不是假空态** ✓，失败语义不丢）。
	let loading = computed((): boolean => {
		return !loaded.value || !todayLoaded.value
	})
	let showEmpty = computed((): boolean => {
		return loaded.value && todayLoaded.value && (emptyState.value || loadFailed.value) && todayEntries.value.length === 0
	})

	// ── 回顾位「那年今日」（2026-10-15 · 台账 §4.20 ㉘ · 批次 C 第一刀）────────────────────
	// 为什么放在「今天」块正下方：记忆产品的价值一半在"**它替我想起来**"（友商实证：Day One
	// 的 On This Day、Google/Apple Memories、朋友圈那年今日、flomo 每日回顾 ✓），而我们此前
	// 只有 AI 回响卡一种形态 ✗。口径：**有才出现**（空数组则整块不渲染，绝不占位 ✗）；
	// 数据源＝`applyFetchedEvents` 拿到的**全量 events**（接口不带时间窗 ⇒ 纯本地判定，
	// 不新增端点/契约 ✓）；视图字段在 `buildLookback` 里预计算（模板零函数调用 ✓）。
	let lookbackRows = ref<Array<LookbackRow>>([])

	function loadTodayEntries(): void {
		fetchTodayEntries().then((rows: Array<TodayEntry>) => {
			// 2026-10-16（三态 · 分支 B1）：**无条件先置位**——`fetchTodayEntries` 的 Promise 恒 resolve
			// （`get()` 失败也 resolve null ⇒ 本函数失败也 resolve []）⇒ 此处置位保证 `loading` 一定收敛，
			// **不会因下方失败守卫而漏置**（漏置 = 骨架永驻 ✗）。必须在守卫**之前**置。
			todayLoaded.value = true
			// 🚨 2026-10-16（复核补 · 沿 10-11 静态审查 #1 对 events / echo 的同一口径）：
			// **失败结果不得覆盖已渲染的今天记录**。`fetchTodayEntries` 用空数组表达"请求失败"与
			// "今天真的没有记录"两种情形 ⇒ 原实现无条件覆盖，则**断网下拉刷新会把用户正在看的
			// 今天的文字/照片整块抹掉**（"今天"块退回"今天还没有记录"）；只记文字（不产 event）
			// 的用户更会翻成假空态「还没有回忆」（`showEmpty` 依赖 `todayEntries`）✗。
			// 失败保持现状、成功才覆盖 ✓；首拉失败时 todayEntries 本就为空，最终显隐仍由下方
			// `showEmpty`（events/loadFailed 口径）统一裁决，不新增分支、不新增监听 ✓。
			if (wasLastEntriesFetchFailed()) {
				console.log('[dbg-index] today entries fetch failed -> keep current')
				return
			}
			todayEntries.value = rows
		})
	}

	function openEntry(e: TodayEntry): void {
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + e.id })
	}

	/** 回顾位点击 → 与 `openDetail` 同口径（封面优先、首图回退）；无可查看内容时诚实 toast */
	function openLookback(r: LookbackRow): void {
		if (r.contentId == '') {
			uni.showToast({ title: '这条记忆暂无可查看的内容', icon: 'none' })
			return
		}
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + r.contentId })
	}

	function openDetail(ev: TimelineEvent): void {
		let cid = ev.coverContentId
		if (cid == '' && ev.photoIds.length > 0) {
			cid = ev.photoIds[0]
		}
		if (cid == '') {
			uni.showToast({ title: '这条记忆暂无可查看的内容', icon: 'none' })
			return
		}
		console.log('[dbg-index] openDetail contentId=' + cid)
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + cid })
	}

	// W6（峰宝拍板 2026-09-04）：回响卡整卡 → 该记忆详情页（「去年今日」回响详情落点）
	function openEchoDetail(): void {
		const card = echo.value
		if (card == null || card.contentId == '') {
			uni.showToast({ title: '这条回响暂无可查看的内容', icon: 'none' })
			return
		}
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + card.contentId })
	}

	// L-02b：卡片操作 / 确认 / 合并 / 拆分已整块进 `useEventOps`（见 composable 头注）；
	// 组件只留模板入口的薄包装（转发到同一实例，行为等价）。
	function onCardOps(ev: TimelineEvent, dayIdx: number): void {
		eo.onCardOps(ev, dayIdx)
	}

	// 回响
	function dismissEchoCard(): void {
		const card = echo.value
		if (card == null) {
			return
		}
		dismissEcho(card.contentId).then((ok: boolean) => {
			// 🚨 2026-10-11 静态审查 #6 修复：失败**不得**乐观隐藏。
			// 原实现无论成败都 `echo.value = null` ⇒ 断网点"划掉"：卡片消失（像成功了），
			// 但服务端没记录 ⇒ 下次 fetchAll（下拉刷新/切 tab）卡片**复活**——
			// "划掉了又回来"比"划不掉"更像灵异事件，且无任何提示。
			if (!ok) {
				showErrorToast(new ApiError('ECHO_DISMISS', '划掉失败，请稍后重试', 0))
				return
			}
			echo.value = null
			uni.showToast({ title: '已划掉', icon: 'none' })
		})
	}

	// 照片映射
	// 卡PA D9：忽略表读一次进 Set 传入 buildDayGroups（key 镜像 event_ops.uts:35
	// IGNORE_KEY='yishu_ignored_events'——event_ops 不在本卡文件域，故此处镜像读；
	// buildDayGroups 循环内零 getStorageSync）
	function loadIgnoredIds(): Set<string> {
		const ids: Set<string> = new Set<string>()
		const raw = uni.getStorageSync('yishu_ignored_events') as string
		if (raw != '') {
			const parts = raw.split('\n')
			for (let i = 0; i < parts.length; i++) {
				if (parts[i] != '') {
					ids.add(parts[i])
				}
			}
		}
		return ids
	}
	function groupDays(events: Array<TimelineEvent>): Array<DayGroup> {
		const result = buildDayGroups(events, loadIgnoredIds())
		pendingEvents.value = result.pending
		return result.groups
	}
	// RecordSheet 保存成功回调：后台静默刷新（卡PA R2：新录入产生服务端新事件 id，
	// 本地无法合成 → 无闪屏 refreshSilently，刷新完浅替换让刚录入的记忆上屏）
	// R8 补刷：后端 AI 管线为异步（转写后分类/聚合秒~分钟级，2026-09-06 实测曾因
	// RQ worker 未启动积压 296 条致新录音永不进时间轴），保存瞬间刷新必然拉不到
	// 新事件 → 延迟补刷两次兜底；refreshSilently 自带 pageAlive 守卫，离页自动失效
	function onRecordSaved(): void {
		refreshSilently()
		setTimeout(() => {
			refreshSilently()
		}, 4000)
		setTimeout(() => {
			refreshSilently()
		}, 12000)
	}

	// L-02a：照片路径 / 挂载 已整块进 `usePhotoAttach`（见 composable 头注）。
	// 🚨 2026-10-11 静态审查 #3 修复：照片点按改为**直达内容详情页**。
	// 原实现转发到 `pa.onPhotoTap`——它只设置 `showPhotoDetail` 等四态，而**模板中根本没有
	// 消费它们的照片详情面板**（`photo-detail-panel` 在全仓 0 命中，`tab-index.css:631-659`
	// 的 `.photo-detail-*` 规则零使用者）⇒ 用户点照片**零反馈**，且照片条带 `.stop`
	// （连整卡进详情都不触发）——"点得动但没反应"的最差形态。
	// 保守修法：收口到**既有可用路径**（详情页），不新造 UI；面板若后续要做，
	// `pa.onPhotoTap` 四态仍在（届时把本函数换回转发即可）。
	function onPhotoTap(contentId: string): void {
		if (contentId == '') {
			uni.showToast({ title: '这张照片暂无可查看的内容', icon: 'none' })
			return
		}
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + contentId })
	}

	// 待确认（L-02b：逻辑进 `useEventOps`，此处仅模板入口薄包装）
	function confirmPending(ev: TimelineEvent): void {
		eo.confirmPending(ev)
	}
	function ignorePending(ev: TimelineEvent): void {
		eo.ignorePending(ev)
	}

	// 工具方法
	// 2026-10-16（RC-F）：`levelText(level)` 函数改为**查表常量**——模板用 `levelLabels[ev.level]`
	// 直取，零函数调用（列表整树重渲染时不再逐卡调用）。索引即 level，0 与旧实现的兜底同为
	// 「瞬间」（buildDayGroups 实际只产 L1/L2/L3，见其实现——不存在 >3 的取值）。
	const levelLabels: Array<string> = ['瞬间', '日卡片', '主题', '主题流']
	// 2026-10-16（RC-G 死代码清理）：原 `levelTag(level)`（返回日卡/主题/主题流/瞬间）与
	// `belongsMeta(ref: ContentEventRef)`（返回「N张 · 状态」）**全仓零调用**（模板只用
	// `levelText`），已删——连带 `ContentEventRef` 导入（它在本文件仅作 belongsMeta 的签名类型）。
	function onRefresh(): void {
		refreshing.value = true
		// RC-3b：下拉刷新 = 用户显式"重新加载" → 请求一次分页窗口复位（成功路径才消费）
		resetPagingOnNextRender = true
		reload()
	}

	// 卡PB R1：加载更多（每点一次多 LOAD_MORE_STEP 组）
	function loadMoreDays(): void {
		visibleDayCount.value = visibleDayCount.value + LOAD_MORE_STEP
		console.log('[dbg-index] loadMoreDays -> visibleDayCount=' + visibleDayCount.value)
	}

	// D-21（2026-10-25）：拆分面板的三个薄包装（逻辑全在 `useEventOps`，此处只做模板入口）。
	// 为什么要包装：模板里直接写 `eo.confirmSplit()` 在这种 class 实例上可行，但**取消后要
	// 同时隐藏遮罩**，而 `cancelSplit` 只清面板态 —— 遮罩态由 `showSplitPanel` 驱动，
	// 故取消就是调 `cancelSplit`（它已把 `showSplitPanel` 置 false）。包一层便于注释意图。
	function onToggleSplitItem(idx: number): void {
		eo.toggleSplitItem(idx)
	}
	function onConfirmSplit(): void {
		eo.confirmSplit()
	}
	function onCancelSplit(): void {
		eo.cancelSplit()
	}

	// 相册监听
	// 2026-10-11 静态审查 #7/#12：两个进程级标志（组件在壳内常驻、不销毁 ⇒ 等价会话级）
	//  · watchStarted：监听是否已启动 —— 供"切回首页时幂等复查"用（#7）
	//  · watchNotified：启动 toast 是否已提示过（#12：原实现每次冷启动都弹一次无意义提示）
	let watchStarted = false
	let watchNotified = false

	/** 幂等复查：**已授权但监听未启动**时补启动（不弹权限框、不打扰）。
	 *
	 * #7 背景：壳架构下 TabIndex 只挂载一次（everIndex 恒 true + v-show），原实现只在
	 * onMounted 初始化一次监听 ⇒「首次拒绝权限 → 去系统设置打开 → 回 App」时监听永不启动
	 * （旧注释"下次进入会再次申请"在壳架构下不成立）。挂在切回首页的 watch 上做廉价复查。 */
	function recheckWatchQuiet(): void {
		if (watchStarted) {
			return
		}
		try {
			const pw = createPhotoWatch()
			if (pw.isReadPermissionGranted()) {
				console.log('[dbg-index] recheck: 权限已就绪，补启动相册监听')
				watchStarted = true
				startWatch()
			}
		} catch (e) {
			// 标准基座无原生插件：忽略（onMounted 已打点）
		}
	}

	function startWatch(): void {
		console.log('[yishu] startWatch begin')
		recordGrantTime()
		const watch = createPhotoWatch()
		// 2026-10-24（B-18 两阶段提交）：回调**返回 boolean**，语义 = 「本批是否已经落到可重试的
		// 持久队列」。上传是异步的，返回时还没有结论 ⇒ 这里**必须返回 false**（= 暂不推进游标），
		// 由 handleBatch 在上传链结束后调 `watch.ackBatch(...)` 给出最终结论。
		// 旧实现（游标先推进再回调）的问题：上传失败时游标已前进 ⇒ 这批照片以后永远扫不到。
		watch.start((items: Array<PhotoItem>): boolean => {
			console.log('[yishu] batch received: ' + items.length)
			if (items.length === 0) {
				// 空批：没什么可接管，直接让插件推进游标（否则游标会卡住 forever）
				return true
			}
			handleBatch(items, watch)
			return false
		})
		console.log('[yishu] startWatch done, lastSeen=' + watch.getLastSeenId())
		// #12：只提示一次——老用户每次冷启动都吃一次「已开始监听相册」是纯噪音
		if (!watchNotified) {
			watchNotified = true
			uni.showToast({ title: '已开始监听相册', icon: 'none' })
		}
	}
	/**
	 * 处理一批新照片（B-18：**必须**在结论落地后调用 `watch.ackBatch(...)`）。
	 *
	 * ack 的判据 = 「这批照片现在是否有一条**可重试的持久路径**」：
	 *  · `uploadBatch` 正常 resolve ⇒ 每张要么已上传、要么已入 held（等 WiFi）/ failed（可重试）
	 *    ⇒ 都是持久的 ⇒ `ackBatch(true)`，游标前进（不会丢）；
	 *  · 上传链**抛异常/没能落库** ⇒ `ackBatch(false)`，游标不动 ⇒ 下次扫描从原处重扫，
	 *    最坏结果是重复上传（后端 init 按 path 幂等、register 按 cos_key 幂等）而**不是丢照片**。
	 */
	function handleBatch(items: Array<PhotoItem>, watch: PhotoWatch): void {
		uploading.value = true
		uploadDone.value = 0
		uploadTotal.value = items.length
		uploadFailed.value = 0
		uploadBatch(items, (p: UploadProgress) => {
			uploadDone.value = p.done
			uploadTotal.value = p.total
			uploadFailed.value = p.failed
		}).then((uploaded: Array<UploadedPhoto>) => {
			uploading.value = false
			// B-18 阶段②：上传链已把每张照片处置掉（成功 / 入 held / 入 failed 队列）⇒ 本批可接管。
			// ⚠️ 顺序很重要：**先 ack 再收尾**——收尾（聚合/上云）耗时且可能异常，
			// 而那些步骤失败不会让这批照片消失（照片已在 contents 或 held/failed 里），不该拖住游标。
			const acked = watch.ackBatch(true)
			if (!acked) {
				console.log('[yishu] ackBatch(true) 无待确认批次（可能已被 ack 看门狗兜底结算）')
			}
			if (uploadFailed.value > 0) {
				// B-13：失败与「暂缓」不是一回事 —— 这里只说失败；暂缓由横幅/记录面板按 held 计数说明
				uni.showToast({ title: '有 ' + uploadFailed.value + ' 张上传失败', icon: 'none' })
			}
			if (uploaded.length > 0) {
				for (let i = 0; i < uploaded.length; i++) {
					// L-02a：本地路径入列（数组 push + O(1) 查表 set 同进同出）已收敛进 composable
					pa.addLocalPath(uploaded[i].contentId, uploaded[i].item.path)
				}
				const tz = -new Date().getTimezoneOffset()
				// RC-7（2026-10-16 · 批次 6）：**分片**跑端侧聚合（片间 setTimeout(0) 让出主线程）。
				// 原 `aggregateToEvents` 整段同步跑：相册首次授权那种上百张会在"上传完成回调"里
				// 一次性独占主线程（UTS 无 worker）⇒ 掉帧、点不动。分片版只切**组装阶段**；聚类本体
				// 整体跑（逐位等价约束），规模由 agg_runner 的 AGG_CLIENT_MAX_N 兜底：越顶**降级跳过**
				// （WARN+计数，且文案写明后果——云侧无 L1 生产者 ⇒ 本次不出 L1，见其常量注释）。
				aggregateToEventsChunked(uploaded, tz, (agg: AggRunResult): void => {
					const events: Array<UTSJSONObject> = []
					for (let i = 0; i < agg.events.length; i++) {
						const ev = agg.events[i]
						const obj: UTSJSONObject = {
							client_event_id: ev.clientEventId,
							title: ev.title,
							start_time: isoString(ev.startTime),
							end_time: isoString(ev.endTime),
							photo_ids: ev.photoIds
						}
						events.push(obj)
					}
					if (events.length > 0) {
						syncClientEvents(events).then((out: SyncOutcome | null) => {
							if (out != null) {
								console.log('[yishu] 事件上云: accepted=' + out.accepted + ' dup=' + out.duplicates + ' rejected=' + out.rejected)
								const mapped: Array<EventPhotoEntry> = mapAcceptedToClientIds(events, out.acceptedEvents)
								for (let m = 0; m < mapped.length; m++) {
									pa.addEventPhoto(mapped[m])
								}
								console.log('[yishu] photoMap: clientEvents=' + events.length + ' accepted=' + out.acceptedEvents.length + ' mappedServerEvents=' + pa.eventPhotoIds.value.length)
							} else {
								console.error('[yishu] 事件上云失败（重试耗尽）')
								uni.showToast({ title: '事件同步失败，稍后重试', icon: 'none' })
							}
							// 卡PA R2（拍板采纳的偏差方案）：上传产生服务端新事件，本地无法合成 →
							// 无闪屏后台静默刷新
							refreshSilently()
						})
						return
					}
					// 卡PA R2：同上，上传完成走无闪屏静默刷新
					refreshSilently()
				})
				// 聚合已转异步（分片）：本回调到此为止，后续刷新由上面的分片回调负责
				return
			}
			// 卡PA R2：同上，上传完成走无闪屏静默刷新（uploaded 为空时的原有出口）
			refreshSilently()
		}, (e: Error): void => {
			// B-18：上传链**异常**（不是"某张失败"，而是整条链没跑完）⇒ 不能保证已持久接管
			// ⇒ ackBatch(false)：游标保持不动，下次扫描从原处重扫（宁重勿丢）。
			uploading.value = false
			const msg = e != null && e.message != null ? e.message : 'unknown'
			console.error('[yishu] handleBatch 上传链异常，ackBatch(false) 保留重扫：' + msg)
			watch.ackBatch(false)
			uni.showToast({ title: '照片同步异常，稍后会自动重试', icon: 'none' })
		})
	}
</script>

<style>
	@import '@/styles/tab-index.css';
</style>

<template>
	<view class="tabbar-container">
		<!-- TabBar 背景 -->
		<view class="tabbar-bg">
			<!-- 时间轴 -->
			<view class="tabbar-item" @tap="goIndex">
				<image :src="active === 'index' ? '/static/icons/tab-timeline-active.svg' : '/static/icons/tab-timeline-inactive.svg'" :width="15" :height="15" />
				<text class="tabbar-text" :class="{ 'text-active': active === 'index' }">时间轴</text>
			</view>

			<!-- AI -->
			<view class="tabbar-item" @tap="goAI">
				<image :src="active === 'ai' ? '/static/icons/tab-ai-active.svg' : '/static/icons/tab-ai-inactive.svg'" :width="15" :height="15" />
				<text class="tabbar-text" :class="{ 'text-active': active === 'ai' }">AI</text>
			</view>

			<!-- 中央加号（占位，保持间距） -->
			<view class="tabbar-center-placeholder"></view>

			<!-- 搜索 -->
			<view class="tabbar-item" @tap="goSearch">
				<image :src="active === 'search' ? '/static/icons/tab-search-active.svg' : '/static/icons/tab-search-inactive.svg'" :width="15" :height="15" />
				<text class="tabbar-text" :class="{ 'text-active': active === 'search' }">搜索</text>
			</view>

			<!-- 我的 -->
			<view class="tabbar-item" @tap="goProfile">
				<image :src="active === 'profile' ? '/static/icons/tab-profile-active.svg' : '/static/icons/tab-profile-inactive.svg'" :width="15" :height="15" />
				<text class="tabbar-text" :class="{ 'text-active': active === 'profile' }">我的</text>
			</view>
		</view>

		<!-- 中央大红加号按钮（凸起） -->
		<view class="tabbar-fab" @tap="goRecord">
			<image src="/static/icons/tab-plus.svg" :width="15" :height="15" />
		</view>
	</view>
</template>

<script setup>
	// Props
	const props = defineProps({
		active: {
			type: String,
			default: 'index'
		}
	})

	// 跳转方法
	const goIndex = () => {
		if (props.active !== 'index') {
			uni.redirectTo({ url: '/pages/index/index' })
		}
	}

	const goAI = () => {
		if (props.active !== 'ai') {
			uni.redirectTo({ url: '/pages/record/record' })
		}
	}

	const goSearch = () => {
		if (props.active !== 'search') {
			uni.redirectTo({ url: '/pages/search/search' })
		}
	}

	const goProfile = () => {
		if (props.active !== 'profile') {
			uni.redirectTo({ url: '/pages/profile/profile' })
		}
	}

	const goRecord = () => {
		uni.navigateTo({ url: '/pages/record/record' })
	}
</script>

<style>
	.tabbar-container {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		height: 92px;
		z-index: 999;
	}

	.tabbar-bg {
		position: absolute;
		left: 20px;
		right: 20px;
		bottom: 30px;
		height: 62px;
		background-color: rgba(255, 255, 255, 0.55);
		border-radius: 31px;
		border-width: 1px;
		border-color: rgba(255, 255, 255, 0.65);
		border-style: solid;
		box-shadow: 0 10rpx 14rpx rgba(58, 46, 37, 0.098);
		flex-direction: row;
		align-items: center;
		justify-content: space-around;
		padding-left: 10px;
		padding-right: 10px;
	}

	.tabbar-item {
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 50px;
		height: 50px;
	}

	.tabbar-center-placeholder {
		width: 56px;
		height: 56px;
	}

	.tabbar-text {
		font-size: 10px;
		color: #B3A696;
		margin-top: 2px;
	}

	.text-active {
		color: #B05A3A;
	}

	.tabbar-fab {
		position: absolute;
		left: 50%;
		margin-left: -28px;
		bottom: 44px;
		width: 56px;
		height: 56px;
		background-color: #B05A3A;
		border-radius: 28px;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 12px rgba(176, 90, 58, 0.4);
	}
</style>

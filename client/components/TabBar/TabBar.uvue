<template>
	<view class="tabbar-container">
		<!-- TabBar 背景 -->
		<view class="tabbar-bg">
			<!-- 时间轴 -->
			<view class="tabbar-item" @tap="goIndex">
				<hens-svg :src="iconTimeline" :width="22" :height="22" :color="active === 'index' ? '#B05A3A' : '#8A7A6A'" />
				<text class="tabbar-text" :class="{ 'text-active': active === 'index' }">时间轴</text>
			</view>

			<!-- AI -->
			<view class="tabbar-item" @tap="goAI">
				<hens-svg :src="iconAI" :width="22" :height="22" :color="active === 'ai' ? '#B05A3A' : '#8A7A6A'" />
				<text class="tabbar-text" :class="{ 'text-active': active === 'ai' }">AI</text>
			</view>

			<!-- 中央加号（占位，保持间距） -->
			<view class="tabbar-center-placeholder"></view>

			<!-- 搜索 -->
			<view class="tabbar-item" @tap="goSearch">
				<hens-svg :src="iconSearch" :width="22" :height="22" :color="active === 'search' ? '#B05A3A' : '#B3A696'" />
				<text class="tabbar-text" :class="{ 'text-active': active === 'search' }">搜索</text>
			</view>

			<!-- 我的 -->
			<view class="tabbar-item" @tap="goProfile">
				<hens-svg :src="iconProfile" :width="22" :height="22" :color="active === 'profile' ? '#B05A3A' : '#B3A696'" />
				<text class="tabbar-text" :class="{ 'text-active': active === 'profile' }">我的</text>
			</view>
		</view>

		<!-- 中央大红加号按钮（凸起） -->
		<view class="tabbar-fab" @tap="goRecord">
			<hens-svg :src="iconPlus" :width="28" :height="28" color="#F6F1E7" />
		</view>
	</view>
</template>

<script setup>
	import { computed } from 'vue'

	// Props
	const props = defineProps({
		active: {
			type: String,
			default: 'index'
		}
	})

	// SVG 图标数据（从设计稿提取）
	const iconTimeline = `<svg viewBox="0 0 8 8" xmlns="http://www.w3.org/2000/svg"><path d="M5.3333 0L3.75 3.75L0 5.3333L1.5833 1.5833L5.3333 0Z"/></svg>`

	const iconAI = `<svg viewBox="0 0 15 14" xmlns="http://www.w3.org/2000/svg"><path d="M11.987 10.6265Q14.1667 8.7145 14.1667 5.8333Q14.1667 2.9522 11.987 1.0402Q9.8512 -0.8333 6.6667 -0.8333Q3.4821 -0.8333 1.3463 1.0402Q-0.8333 2.9522 -0.8333 5.8333Q-0.8333 7.4372 -0.2973 8.8129Q0.1424 9.9416 0.8695 10.7269L0.0475 13.056Q-0.0782 13.3821 0.0815 13.6929Q0.2232 14.0124 0.556 14.1192Q0.7293 14.1813 0.9125 14.1629Q1.0959 14.1463 1.2543 14.0525L4.3594 12.2349Q5.3637 12.5 6.6667 12.5Q9.8512 12.5 11.987 10.6265Z"/></svg>`

	const iconSearch = `<svg viewBox="0 0 11 11" xmlns="http://www.w3.org/2000/svg"><path d="M5.1726 3.9941L0.5893 -0.5893Q0.3493 -0.8434 0 -0.8333Q-0.3493 -0.8434 -0.5893 -0.5893Q-0.8434 -0.3493 -0.8333 0Q-0.8434 0.3493 -0.5893 0.5893L3.9941 5.1726Q4.234 5.4267 4.5833 5.4167Q4.9327 5.4267 5.1726 5.1726Q5.4267 4.9327 5.4167 4.5833Q5.4267 4.234 5.1726 3.9941Z"/></svg>`

	const iconProfile = `<svg viewBox="0 0 15 12" xmlns="http://www.w3.org/2000/svg"><path d="M2.2844 0.2722Q0.2463 1.4765 -0.766 3.8384Q-0.9128 4.1555 -0.7737 4.4762Q-0.6533 4.8042 -0.3283 4.9326Q-0.0111 5.0795 0.3095 4.9404Q0.6376 4.82 0.766 4.4949Q2.3352 0.8333 6.6667 0.8333Q10.9981 0.8333 12.5674 4.4949Q12.6958 4.82 13.0238 4.9404Q13.3445 5.0795 13.6616 4.9326Q13.9867 4.8042 14.1071 4.4762Q14.2461 4.1555 14.0993 3.8384Q13.087 1.4765 11.049 0.2722Q9.1781 -0.8333 6.6667 -0.8333Q4.1552 -0.8333 2.2844 0.2722Z"/></svg>`

	const iconPlus = `<svg viewBox="0 0 20 12" xmlns="http://www.w3.org/2000/svg"><path d="M10.472 2.24L11.48 2.24L11.48 4.256L13.328 4.256L13.328 5.208L11.48 5.208L11.48 7.042L10.472 7.042L10.472 5.208L8.624 5.208L8.624 4.256L10.472 4.256L10.472 2.24Z"/></svg>`

	// 跳转方法
	const goIndex = () => {
		if (props.active !== 'index') {
			uni.redirectTo({ url: '/pages/index/index' })
		}
	}

	const goAI = () => {
		if (props.active !== 'ai') {
			uni.redirectTo({ url: '/pages/record/record' })
		}
	}

	const goSearch = () => {
		if (props.active !== 'search') {
			uni.redirectTo({ url: '/pages/search/search' })
		}
	}

	const goProfile = () => {
		if (props.active !== 'profile') {
			uni.redirectTo({ url: '/pages/profile/profile' })
		}
	}

	const goRecord = () => {
		uni.navigateTo({ url: '/pages/record/record' })
	}
</script>

<style>
	.tabbar-container {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		height: 92px;
		z-index: 999;
	}

	.tabbar-bg {
		position: absolute;
		left: 20px;
		right: 20px;
		bottom: 30px;
		height: 62px;
		background-color: rgba(246, 241, 231, 0.85);
		border-radius: 31px;
		flex-direction: row;
		align-items: center;
		justify-content: space-around;
		padding-left: 10px;
		padding-right: 10px;
	}

	.tabbar-item {
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 50px;
		height: 50px;
	}

	.tabbar-center-placeholder {
		width: 56px;
		height: 56px;
	}

	.tabbar-text {
		font-size: 10px;
		color: #B3A696;
		margin-top: 2px;
	}

	.text-active {
		color: #B05A3A;
	}

	.tabbar-fab {
		position: absolute;
		left: 50%;
		margin-left: -28px;
		bottom: 44px;
		width: 56px;
		height: 56px;
		background-color: #B05A3A;
		border-radius: 28px;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 12px rgba(176, 90, 58, 0.4);
	}
</style>

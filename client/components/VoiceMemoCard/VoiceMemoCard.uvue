<template>
	<!-- ═══ 详情页主语音卡（F5b）──── 2026-10-26 自 detail.uvue 抽出 ═══
	     为什么抽出：
	       ① 详情页 865 行 > 棘轮阈值 800（`audit_harness` 轴 5，新增超阈 = CRITICAL）；
	       ② 它本是**自含**的一块：播放钮 + 波形 + 进度行 + 标题，四个部分只依赖
	          传入的播放态，不读页面其余状态。留在页面里时，每个 tick 相关的改动
	          都要在 800 行的模板里找位置。

	     ⚠️ 播放态一律**由宿主预计算后传入**（本组件零函数调用、零全局 ref）：
	        这是 RC-F 的收敛结论 —— 原实现模板每 tick 调 6 个取值函数
	        （voiceIsActive/voiceProgressOfCard/voiceCurSecText…），而 audio_player 的
	        33ms 时钟每次都写全局 ref ⇒ 整页重算。现在组件只读 props，
	        `active/playing/progress` 不变时零重渲染。 -->
	<view class="vc-root" @tap="onPlay">
		<view class="vc-btn" :class="{ 'vc-btn-disabled': !playable }">
			<view v-if="active && playing" class="vc-btn-pause">
				<view class="vc-btn-pause-bar"></view>
				<view class="vc-btn-pause-bar"></view>
			</view>
			<view v-else class="vc-btn-play"></view>
		</view>
		<view class="vc-col">
			<!-- 禁播/处理中提示小字（显式说明为什么点不动，绝不静默） -->
			<text v-if="note != ''" class="vc-note">{{ note }}</text>
			<view class="vc-wave">
				<!-- waveform 是 BB3 的真实波形（空则 VoiceWave 内部回退伪波形），
				     与 TabSearch 同源：只在波形落表时 version++，非 tick 热点 -->
				<VoiceWave :heights="heights" :waveform="waveform" :active="active" :progress="progress" />
			</view>
			<view v-if="active" class="vc-prog">
				<text class="vc-prog-cur">{{ curText }}</text>
				<view class="vc-track">
					<!-- 进度填充 width:% → transform:scaleX()（合成层，免每 tick 重排） -->
					<view class="vc-track-fill" :style="'transform:scaleX(' + progress + ');transform-origin:left;'"></view>
				</view>
				<text class="vc-prog-total">{{ totalText }}</text>
			</view>
			<text v-if="active && playing" class="vc-title-playing">正在播放 · {{ title }}</text>
			<text v-else class="vc-title">{{ title }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	const props = defineProps({
		/** 波形高度数组（rpx，确定性生成见 genWaveHeights） */
		heights: {
			type: Array,
			default: (): Array<number> => []
		},
		/** 真实波形（0..1 峰值）；空数组 ⇒ VoiceWave 回退伪波形 */
		waveform: {
			type: Array,
			default: (): Array<number> => []
		},
		/** 是否当前正在播这一条 */
		active: {
			type: Boolean,
			default: false
		},
		/** 是否处于播放中（非暂停） */
		playing: {
			type: Boolean,
			default: false
		},
		/** 播放进度 0..1 */
		progress: {
			type: Number,
			default: 0
		},
		/** 当前秒文本（已格式化） */
		curText: {
			type: String,
			default: ''
		},
		/** 总时长文本（已格式化） */
		totalText: {
			type: String,
			default: ''
		},
		/** 卡片标题（记忆标题） */
		title: {
			type: String,
			default: ''
		},
		/** 禁播/处理中提示（空串=可播） */
		note: {
			type: String,
			default: ''
		},
		/** 是否可播（false ⇒ 钮变灰 + 点击由宿主 toast 解释） */
		playable: {
			type: Boolean,
			default: false
		}
	})

	const emit = defineEmits(['play'])

	function onPlay(): void {
		emit('play')
	}
</script>

<style>
	/* 画布 F5b y448pt=861.5rpx：白卡（--c-white） / r20pt / padding 14pt / 双层阴影
	   （DS 0,4,b16 a.06 + DS 0,1,b3 a.04）+ 行 gap 12pt。
	   色值一律 `var(--令牌, #回退)`（audit_token_literals 剔除回退值后计数）。 */
	.vc-root {
		margin-left: var(--d-card_margin_x, 38.5rpx);
		width: var(--d-card_width, 673.1rpx);
		flex-direction: row;
		/* 画布真值：钮 y=14（=padding）、信息列 y=14 亦从内容区顶部起 → 顶部对齐非居中 */
		align-items: flex-start;
		margin-bottom: var(--d-card_radius_small, 23.1rpx);
		padding-left: var(--d-lattice-p14, 26.9rpx);
		padding-right: var(--d-lattice-p14, 26.9rpx);
		padding-top: var(--d-lattice-p14, 26.9rpx);
		padding-bottom: var(--d-lattice-p14, 26.9rpx);
		background-color: var(--c-white, #FFFFFF);
		box-shadow: var(--d-lattice-p0, 0rpx) var(--d-lattice-p4, 7.7rpx) var(--d-lattice-p16, 30.8rpx) var(--a-ink-06, rgba(59, 46, 38, 0.06)), var(--d-lattice-p0, 0rpx) var(--d-lattice-p1, 1.9rpx) var(--d-lattice-p3, 5.8rpx) var(--a-ink-04, rgba(59, 46, 38, 0.04));
		border-radius: var(--d-card_margin_x, 38.5rpx);
		overflow: hidden;
	}
	/* 播放钮 40x40 r20 琥珀实心（画布 --c-amber-500），内 Vector 11x15 白三角 → 居中 */
	.vc-btn {
		width: var(--d-lattice-p40, 76.9rpx);
		height: var(--d-lattice-p40, 76.9rpx);
		border-radius: var(--d-card_margin_x, 38.5rpx);
		background-color: var(--c-amber-500, #C4913C);
		flex-direction: row;
		justify-content: center;
		align-items: center;
		/* 画布 gap=12pt（23.1rpx）→ 换 margin-right（uvue 无 flex gap） */
		margin-right: var(--d-card_radius_small, 23.1rpx);
	}
	/* 禁播态（峰宝拍板 2026-09-06）：独立类覆盖（uvue 禁复合选择器），:class 动态叠加 */
	.vc-btn-disabled {
		/* 2026-10-11 恢复（9-23 基准）：原令牌 --c-surface-neutral 与本处帧真值色差 Δ4，
		   属令牌化误映射 ⇒ 这里显式给出帧真值作回退，令牌名保留供将来收口 */
		background-color: var(--c-voice-btn-disabled, #D8CFC2);
	}
	.vc-btn-play {
		width: var(--d-lattice-p0, 0rpx);
		height: var(--d-lattice-p0, 0rpx);
		border-left: var(--d-lattice-p11, 21.2rpx) solid var(--c-white, #FFFFFF);
		border-top: 14.4rpx solid transparent;
		border-bottom: 14.4rpx solid transparent;
	}
	/* 播放中 → 暂停双竖条（F5a 真值：两条 4x14pt 白条；峰宝 09-03 拍板改常规分离，缝 10rpx） */
	.vc-btn-pause {
		flex-direction: row;
	}
	.vc-btn-pause-bar {
		width: var(--d-lattice-p4, 7.7rpx);
		height: var(--d-lattice-p14, 26.9rpx);
		border-radius: var(--d-lattice-p2, 3.8rpx);
		background-color: var(--c-white, #FFFFFF);
		margin-left: var(--d-raw-r5, 5rpx);
		margin-right: var(--d-raw-r5, 5rpx);
	}
	.vc-col {
		flex: 1;
		flex-direction: column;
	}
	/* 禁播/处理中提示小字（fs11 --c-ink-300，波形容器上方） */
	.vc-note {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: var(--d-raw-r22, 22rpx);
		color: var(--c-ink-300, #B3A696);
		margin-bottom: var(--d-lattice-p4, 7.7rpx);
	}
	/* 波形容器 w=fill_container / h=28pt（53.8rpx），与 F5a 播放态规范同高 */
	.vc-wave {
		width: 100%;
		flex-direction: row;
		align-items: center;
		height: var(--d-fab_radius, 53.8rpx);
	}
	/* 进度行（F5a 播放中）：当前时间 fs10 Medium --c-ink-900 / 轨道 h4 --c-paper-400 / 总时长 fs10 --c-ink-300 */
	.vc-prog {
		width: 100%;
		flex-direction: row;
		align-items: center;
		margin-top: var(--d-lattice-p8, 15.4rpx);
	}
	.vc-prog-cur {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 500;
		font-size: var(--d-raw-r22, 22rpx);
		color: var(--c-ink-900, #3A2E25);
	}
	.vc-track {
		flex: 1;
		height: var(--d-lattice-p4, 7.7rpx);
		background-color: var(--c-paper-400, #EDE5D5);
		border-radius: var(--d-lattice-p2, 3.8rpx);
		margin-left: var(--d-lattice-p8, 15.4rpx);
		margin-right: var(--d-lattice-p8, 15.4rpx);
	}
	.vc-track-fill {
		height: var(--d-lattice-p4, 7.7rpx);
		background-color: var(--c-amber-500, #C4913C);
		border-radius: var(--d-lattice-p2, 3.8rpx);
	}
	.vc-prog-total {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: var(--d-raw-r22, 22rpx);
		color: var(--c-ink-300, #B3A696);
	}
	/* 默认/暂停态标题（F5b：fs14 Medium --c-ink-900，满宽可换行） */
	.vc-title {
		width: 100%;
		margin-top: var(--d-lattice-p8, 15.4rpx);
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 500;
		font-size: var(--d-lattice-p14, 26.9rpx);
		color: var(--c-ink-900, #3A2E25);
	}
	/* 播放中态标题（F5a：fs12 Medium --c-ink-500「正在播放 · X」，满宽可换行） */
	.vc-title-playing {
		width: 100%;
		margin-top: var(--d-lattice-p8, 15.4rpx);
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 500;
		font-size: var(--d-card_radius_small, 23.1rpx);
		color: var(--c-ink-500, #8A7A6A);
	}
</style>

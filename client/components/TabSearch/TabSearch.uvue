<template>
	<!-- B10 方案A 金丝雀：自 pages/search/search.uvue 整体搬迁（TabBar/RecordSheet 挂载上收 shell，离页停播按拍板项 2 退役，处置记录见台账 §EE）
	     2026-10-16 搜索形态改造：入口转「描述式」+ 筛选转「用户维度」+ 结果可解释 + 空结果不空手 + 搜索历史；
	     样式块保持零改动（不新增视觉元素，所有新块复用既有 class）。 -->
<!-- ardot 直转 v2：搜索页（帧 2:386）· 审计化生成 -->
	<view class="search-root tk-root">
		<text class="n2_390">搜索</text> <!-- 大标题 -->
		<view class="n2_391"> <!-- 搜索胶囊 -->
			<image class="n2_392" src="/static/icons/i2_392.svg" /> <!-- icon: 搜索图标 -->
			<view class="n2_395"> <!-- 输入区（HEAD 交互接回：静态"湖边|"→受控 input） -->
				<!-- 2026-10-15（真机反馈「删掉关键词后页面动不了」）：补 `@input`，让「输入清空」
				     有状态转移（原实现只有 v-model + @confirm，删字到空时 hasSearched/hits 全不动 ✗） -->
				<!-- 2026-10-16（描述式入口）：占位由「输入关键词…」改为「描述一段回忆，帮你找」，
				     `@confirm` 直接发整句（后端 RAG 自带改写，无需用户自己拆关键词） -->
				<input :adjust-position="true" class="n2_396" style="color:var(--c-ink-900, #3A2E25);font-size:28.8rpx;" v-model="keyword" placeholder="描述一段回忆，帮你找" placeholder-style="color:#B3A696;font-size:28.8rpx" confirm-type="search" @input="onKeywordInput" @confirm="runSearch" />
			</view>
			<!-- 以图搜图入口（AG6 接线 · 2026-09-23）：此前 `searchByImage` 导出**零调用**
			     （audit_harness 轴 4 首查 CRITICAL 第 1 项）⇒ 后端 `POST /api/v1/search/image`
			     早已就绪，但用户完全触达不到——"多模态搜索"对用户等于不存在。
			     复用既有 s-chip 样式类（不新增 CSS，避免样式回归面） -->
			<view class="s-chip s-chip-ml" @tap="runImageSearch()">
				<text class="s-chip-text">以图搜</text>
			</view>
		</view>
		<!-- 筛选行（2026-10-16 改造：原「全部/照片/语音/文字」= 模态**内部概念**，用户不这么想记忆；
		     改为用户维度——时间（今天/本周/本月/那年）+ 有照片 + 有地点。
		     仍复用 .n2_397 行与 .s-chip 族；模态过滤降为机制层（见 useSearchState.filterContentTypes） -->
		<view class="n2_397">
			<view v-for="(f, idx) in filterChips" :key="idx" class="s-chip" :class="{ 's-chip-active': isFilterActive(idx), 's-chip-ml': idx > 0 }" @tap="onFilterTap(idx)">
				<text class="s-chip-text" :class="{ 's-chip-text-active': isFilterActive(idx) }">{{ f }}</text>
			</view>
		</view>
		<text class="n2_406">{{ resultCountText() }}</text> <!-- 结果提示（动态） -->
		<!-- 结果区（HEAD 交互接回：静态语音/文字卡→v-for 列表；绝对定位改滚动流） -->
		<!-- 2026-09-23：显式声明滚动方向（uni-app x 只认 direction；原先依赖默认值，属隐式行为） -->
		<scroll-view class="n2-results" direction="vertical" :show-scrollbar="false">
			<!-- 描述式示例提示（未搜索时，复用 .n2-empty 居中行 + .s-chip）：教用户「整句描述」，点了即搜索 -->
			<view v-if="!hasSearched && exampleHints.length > 0" class="n2-empty">
				<view v-for="(ex, i) in exampleHints" :key="'h' + i" class="s-chip" :class="{ 's-chip-ml': i > 0 }" @tap="onHint(ex)">
					<text class="s-chip-text">{{ ex }}</text>
				</view>
			</view>
			<!-- 最近搜索（进页面即可点重搜；最多展示 3 条，长串仅显示层截断、重搜仍用完整串） -->
			<view v-if="!hasSearched && recentHistory.length > 0" class="n2-empty">
				<view v-for="(h, i) in recentHistory" :key="'hs' + i" class="s-chip" :class="{ 's-chip-ml': i > 0 }" @tap="onHistory(h)">
					<text class="s-chip-text">{{ shortQuery(h) }}</text>
				</view>
				<view class="s-chip s-chip-ml" @tap="clearHistory()">
					<text class="s-chip-text">清空</text>
				</view>
			</view>
			<!-- 回答卡（2026-10-16 冻结契约 SearchResult.answer；无回答时空串 ⇒ 整块不渲染，不伪造） -->
			<view v-if="answer != ''" class="n2_598">
				<view class="n2_599">
					<view class="n2_601"></view>
					<text class="n2_602">{{ answer }}</text>
				</view>
			</view>
			<view v-for="(item, idx) in voiceResults" :key="'v' + item.id" class="n2_588" @tap="openResult(item)">
				<view class="n2_589"> <!-- 语音媒体 -->
					<view class="n2_591" @tap.stop="playVoice(item)"> <!-- 玻璃播放钮 -->
						<!-- W0-2 播放态：播放 SVG ↔ 暂停双竖条（tick 局部更新：读卡字段，非全局函数） -->
						<view v-if="item.active && item.playing" class="search-pause-icon">
							<view class="search-pause-bar"></view>
							<view class="search-pause-bar"></view>
						</view>
						<image v-else class="n2_595" src="/static/icons/i2_595.svg" /> <!-- icon: 播放图标 -->
					</view>
					<!-- 波形：空闲=画布 SVG（对拍保真）；活动=VoiceWave 已播金/未播米 + 进度行（F5a 规范） -->
					<VoiceWave v-if="item.active" class="n2_592" :heights="item.waveHeights" :waveform="wf.waveformOf(item.id)" :active="true" :progress="item.progress" />
					<view v-else class="n2_592">
						<image class="n2_596" src="/static/icons/i2_596.svg" />
					</view>
				</view>
				<view v-if="item.active" class="svp-row">
					<text class="svp-time">{{ item.curText }}</text>
					<view class="svp-track">
						<view class="svp-track-fill" :style="{ width: (item.progress * 100) + '%' }"></view>
					</view>
					<text class="svp-time">{{ item.totalText }}</text>
				</view>
				<view class="n2_590"> <!-- 语音文字区 -->
					<text class="n2_593">{{ item.title }}</text>
					<text class="n2_594">{{ item.meta }}</text>
				</view>
			</view>
			<view v-for="(item, idx) in textResults" :key="'t' + item.id" class="n2_598" @tap="openResult(item)">
				<!-- 照片命中：服务端票据 URL 直连回显（<image> 无法带 header，预签名/票据 URL 是唯一通路） -->
				<image v-if="item.thumb != ''" class="n2-result-photo" :src="item.thumb" mode="aspectFill" />
				<view class="n2_599"> <!-- 摘要块 -->
					<view class="n2_601"></view> <!-- 引用竖线 -->
					<text class="n2_602">{{ item.text }}</text>
				</view>
				<view class="n2_600"> <!-- 文字元信息区 -->
					<text class="n2_603">{{ item.meta }}</text>
				</view>
			</view>
			<view v-if="hasSearched && voiceResults.length === 0 && textResults.length === 0" class="n2-empty">
				<text class="n2-empty-text">{{ emptyText() }}</text>
			</view>
			<!-- 空结果不空手（2026-10-16）：改写建议 chips（点了直接重搜） -->
			<view v-if="hasSearched && voiceResults.length === 0 && textResults.length === 0" class="n2-empty">
				<view v-for="(s, i) in exampleHints" :key="'s' + i" class="s-chip" :class="{ 's-chip-ml': i > 0 }" @tap="onHint(s)">
					<text class="s-chip-text">{{ s }}</text>
				</view>
			</view>
			<!-- 引导去 AI 页问（复用既有 shell 内零销毁切 tab 方式） -->
			<view v-if="hasSearched && voiceResults.length === 0 && textResults.length === 0" class="n2-empty">
				<view class="s-chip" @tap="goAskAi()">
					<text class="s-chip-text">去 AI 页问</text>
				</view>
			</view>
		</scroll-view>

	</view>
</template>

<script setup lang="uts">
	import { ref, computed, watch, onMounted } from 'vue'
	import { WaveformCache } from '@/composables/useWaveform'
	import { searchByImage, SearchHitItem, contentTypeCn } from '@/utils/search_api'
	import { SearchState } from '@/composables/useSearchState'
	import { shortDate } from '@/utils/time'
	import { shellActiveTab, requestShellTab } from '@/utils/shell_state'
	import {
		toggleVoice,
		fmtVoiceTime,
		genWaveHeights,
		voiceCurrentId,
		voicePlaying,
		voiceProgress,
		voiceCurSec,
		voiceTotalSec
	} from '@/utils/audio_player'

	// ── 搜索状态机（2026-10-16 · 整块抽到 useSearchState；销 audit_harness 基线条目）──
	// 先例：useEventOps/usePhotoAttach —— 组件经 `ss` 访问**同一 ref 对象**（全项目零
	// defineExpose/$refs）；模板入口由下方薄包装转发，行为等价。抽走的正是该基线条目
	// target 列出的那批：keyword/hasSearched/hits/筛选/历史/onKeywordInput/runSearch/loadRecent。
	const ss = new SearchState()
	// 顶层 ref 绑定（模板自动解包；与 ss 内为同一 ref 对象 ⇒ 双向同步）
	let keyword = ss.keyword
	let hasSearched = ss.hasSearched
	let hits = ss.hits
	let answer = ss.answer
	let history = ss.history
	// 筛选行标签（顺序即 idx 语义）——数组常量，非 ref
	let filterChips = ss.filterLabels

	// 描述式示例提示 / 空结果改写建议（同一组短句，复用同一数组避免重复维护）
	const exampleHints: Array<string> = ['上个月的照片', '我提过的书', '湖边那天']

	// 最近搜索展示（最多 3 条；完整串留给重搜，显示截断见 shortQuery）
	let recentHistory = computed((): Array<string> => {
		return history.value.slice(0, 3)
	})

	// 模板入口薄包装（转发到同一实例）
	function onKeywordInput(): void { ss.onKeywordInput() }
	function runSearch(): void { ss.runSearch() }
	function onFilterTap(idx: number): void { ss.onFilterTap(idx) }
	function isFilterActive(idx: number): boolean { return ss.isFilterActive(idx) }
	function clearHistory(): void { ss.clearHistory() }
	function onHistory(q: string): void { ss.onHistory(q) }
	/** 点示例/建议：回填输入并直接搜索 */
	function onHint(q: string): void {
		ss.keyword.value = q
		ss.runSearch()
	}
	/** 引导去 AI 页问：复用既有跨 tab 跳转（壳内零销毁切换） */
	function goAskAi(): void {
		requestShellTab('ai', '')
	}
	/** 历史项显示层截断（仅显示；重搜用完整串） */
	function shortQuery(q: string): string {
		return q.length > 6 ? q.substring(0, 6) + '…' : q
	}

	// 本地 mock 数据注入路径已于 2026-08-31 移除（峰宝拍板：这是 MVP，不是 demo）：
	// 此前 onLoad 无条件灌 6 条假数据（v-mock-*/t-mock-*/p-mock-*）压住真实结果；
	// 现进入页面即拉「最近内容」兜底（见 onMounted），空结果走诚实空态文案。

	// B10 方案A 组件契约（shell → 组件）：savedSeq 每次记录保存成功 ++（原 onRecordSaved 回调）。
	// typeQuery 承接原 ?type= 预设筛选（shell onLoad 解析后注入）。数据常驻=拍板项 3 正式行为。
	const props = defineProps({
		typeQuery: { type: String, default: '' },
		savedSeq: { type: Number, default: 0 }
	})
	onMounted((): void => {
		ss.applyTypeQuery(props.typeQuery)
		ss.loadRecent()
	})
	// 🚨 2026-10-11 静态审查修复：**必须 watch typeQuery**。
	// 本组件在壳内**常驻不销毁**（shell 用 v-if 首次挂载 + v-show 切换），而原实现只在
	// onMounted 读一次 prop ⇒ 「先进过搜索 tab → 回"我的"点类型入口 → 再进搜索」时
	// `typeQuery` 变了但没人响应，筛选器**停留在上次的值**（用户以为点了没反应）。
	// 注：本项既有缺口非本次重构引入，但同属 seq 桥"看似完整实则有洞"一类。
	watch((): string => props.typeQuery, (t: string): void => {
		ss.applyTypeQuery(t)
	})
	/**
	 * 「记录保存成功」补刷（2026-10-16 · 批次 6 · RC-2：可见性守卫 + 修一处裸调用）。
	 *
	 * ① **可见性守卫**：本组件在壳内**常驻**（shell 用 `v-show` 切换，不销毁），而 `savedSeq`
	 *    是**全局广播**（在任意 tab 里记一笔都会 ++）⇒ 不加守卫时，用户在时间轴保存会让**隐藏的
	 *    搜索页**偷偷发一次网络请求（后台空转）。判据与上方 5 个播放态 watch 的
	 *    `syncActiveCardIfVisible` **完全一致**（同一个 `shellActiveTab`）。
	 * ② **修裸调用**：原 `onRecordSaved()` 在本文件**从未定义**（2026-10-16 搜索形态改造把状态机
	 *    抽进 `useSearchState` 时该回调没有随之迁移）⇒ 一旦触发必抛 ReferenceError。
	 *    现按语义显式分流：已搜索过 → 重跑当前查询（结果集里应有新内容）；未搜索过 → 刷新
	 *    「最近内容」兜底列表（与 `onMounted` 同一入口）。
	 */
	function refreshOnSaved(): void {
		if (shellActiveTab.value != 'search') {
			return // 隐藏标签页：不后台空转（对齐 syncActiveCardIfVisible）
		}
		if (ss.hasSearched.value) {
			ss.runSearch()
		} else {
			ss.loadRecent()
		}
	}
	watch((): number => props.savedSeq, (n: number): void => {
		if (n > 0) {
			refreshOnSaved()
		}
	})

	// ── 卡片视图模型（兼容模板：语音卡 / 文字卡） ──
	class VoiceResult {
		id: string
		title: string
		meta: string
		waveHeights: Array<number>
		// 播放态快照（tick 局部更新）：syncActiveCard 只写「正在播放那张卡」的这些属性，
		// 其余卡零写入零重渲染；默认值在 constructor 内赋（UTS 无字段默认初始化）
		active: boolean
		playing: boolean
		progress: number
		curText: string
		totalText: string
		constructor(id: string, title: string, meta: string, waveHeights: Array<number>) {
			this.id = id
			this.title = title
			this.meta = meta
			this.waveHeights = waveHeights
			this.active = false
			this.playing = false
			this.progress = 0
			this.curText = ''
			this.totalText = ''
		}
	}

	class TextResult {
		id: string
		text: string
		meta: string
		/** 照片缩略图票据 URL（仅 content_type=photo 有值；文字/语音为空串） */
		thumb: string
		constructor(id: string, text: string, meta: string, thumb: string) {
			this.id = id
			this.text = text
			this.meta = meta
			this.thumb = thumb
		}
	}

	/** 由 contentId 确定性生成装饰波形 → 统一走 audio_player.genWaveHeights（W0-2 三处一致） */
	function genWave(id: string): Array<number> {
		return genWaveHeights(id, 28)
	}

	// B5.2f：波形缓存收敛为共享组合式函数（唯一实现 client/composables/useWaveform.uts）
	const wf = new WaveformCache()

	/** 组装卡底元信息：类型 · 日期 · 地点 · 所属事件（2026-10-16 补地点——结果可解释要求） */
	function hitMeta(h: SearchHitItem): string {
		let s = contentTypeCn(h.contentType)
		if (h.takenAt != '') {
			s += ' · ' + shortDate(h.takenAt)
		}
		if (h.place != '') {
			s += ' · ' + h.place
		}
		if (h.eventTitle != '') {
			s += ' · ' + h.eventTitle
		}
		return s
	}

	// 语音结果（content_type=voice → 语音卡）。
	// 性能重构：computed → ref + 手动重建。33ms 播放 tick 不再走整列表重算，
	// 只由 syncActiveCard 写单卡属性（见下）；列表仅在 hits / 筛选变化时重建。
	let voiceResults = ref<Array<VoiceResult>>([])

	/**
	 * 播放 tick 局部更新：把全局播放态写进「正在播放那张卡」的属性。
	 * 带相等性守卫——值没变不写 → 不触发响应式 → 其余卡零重渲染；
	 * 状态迁移（切换/暂停/停止/播完）由 voiceCurrentId 清旧卡 active。
	 */
	function syncActiveCard(): void {
		const cid = voiceCurrentId.value
		const playing = voicePlaying.value
		const prog = voiceProgress.value
		const cur = fmtVoiceTime(voiceCurSec.value)
		const total = fmtVoiceTime(voiceTotalSec.value)
		for (let i = 0; i < voiceResults.value.length; i++) {
			const c = voiceResults.value[i]
			if (c.id == cid) {
				if (c.active == false) {
					c.active = true
				}
				if (c.playing != playing) {
					c.playing = playing
				}
				if (c.progress != prog) {
					c.progress = prog
				}
				if (c.curText != cur) {
					c.curText = cur
				}
				if (c.totalText != total) {
					c.totalText = total
				}
			} else if (c.active) {
				c.active = false
				c.playing = false
				c.progress = 0
			}
		}
	}

	/** 重建语音卡列表（hits / 筛选变化时触发；tick 不走这里）。
	 *  数据源＝ss.visibleHits()（命中 + 用户维度筛选，唯一入口，与 textResults 同源）。 */
	function rebuildVoice(): void {
		const out: Array<VoiceResult> = []
		const vis = ss.visibleHits()
		for (let i = 0; i < vis.length; i++) {
			const h = vis[i]
			if (h.contentType == 'voice') {
				const title = h.eventTitle != '' ? h.eventTitle : '语音记忆'
				out.push(new VoiceResult(h.contentId, title, hitMeta(h), genWave(h.contentId)))
			}
		}
		voiceResults.value = out
		syncActiveCard()
	}

	// 播放态源 ref（audio_player 全局单例）→ 单源 watch 逐个挂，tick 驱动面收敛到 syncActiveCard
	watch(hits, (): void => { rebuildVoice() })
	// 2026-10-16：筛选态（时间/有照片/有地点）改动即时重算语音卡（textResults 为 computed 自跟）
	watch(ss.timeFilter, (): void => { rebuildVoice() })
	watch(ss.hasPhoto, (): void => { rebuildVoice() })
	watch(ss.hasPlace, (): void => { rebuildVoice() })
	// 🚨 2026-10-14（台账 §4.20 批次 5 · RC-2）：**可见性守卫**。本组件在壳内**常驻**
	// （shell 用 `v-show` 切换，组件不销毁）⇒ 隐藏时这些 watch 仍被 audio_player 的全局 ref
	// 驱动，而 `syncActiveCard()` 要遍历**全部**语音结果卡重算播放态——纯空转
	// （配合 RC-1 的 1% 粒度后已由 30Hz 降到约 1.7Hz，但仍是"看不见却在算"）。
	// 现改为：**只有壳的当前 tab 就是 search 时才重算**；切回本 tab 时补一次同步（见下方 watch）。
	function syncActiveCardIfVisible(): void {
		if (shellActiveTab.value != 'search') {
			return
		}
		syncActiveCard()
	}
	watch(voiceCurrentId, (): void => { syncActiveCardIfVisible() })
	watch(voicePlaying, (): void => { syncActiveCardIfVisible() })
	watch(voiceProgress, (): void => { syncActiveCardIfVisible() })
	watch(voiceCurSec, (): void => { syncActiveCardIfVisible() })
	watch(voiceTotalSec, (): void => { syncActiveCardIfVisible() })
	// 切回本 tab 时补同步一次（隐藏期间被守卫跳过的变更需在此对齐，否则进度条会等下一跳才出现）
	watch(shellActiveTab, (t: string): void => {
		if (t == 'search') {
			syncActiveCard()
		}
	})

	// 文字 / 照片结果（photo 的 caption 与 text 同走引用文字卡）
	let textResults = computed((): Array<TextResult> => {
		const out: Array<TextResult> = []
		const vis = ss.visibleHits()
		for (let i = 0; i < vis.length; i++) {
			const h = vis[i]
			if (h.contentType == 'voice') {
				continue
			}
			const txt = h.text != '' ? h.text : '（无文本描述）'
			// 照片命中带服务端下发的缩略图票据 URL，其余类型为空串
			out.push(new TextResult(h.contentId, txt, hitMeta(h), h.contentType == 'photo' ? h.thumbnailUrl : ''))
		}
		return out
	})

	function resultCountText(): string {
		if (ss.loading.value) {
			return '搜索中…'
		}
		const n = voiceResults.value.length + textResults.value.length
		return hasSearched.value ? ('共 ' + n.toString() + ' 条结果') : '描述一段回忆，帮你找'
	}

	function emptyText(): string {
		if (!hasSearched.value) {
			return '描述一段回忆开始搜索'
		}
		if (ss.hasClientFilter()) {
			// 口径如实（2026-10-16）：时间/地点维度是**客户端对已取得结果**的过滤（后端仅支持模态），
			// 故空态要说明作用范围，避免用户误以为"全库都没有"。
			return '按当前筛选没有结果（筛选作用于已展示结果）'
		}
		return '没有找到相关记忆，换个说法试试'
	}

	/**
	 * 以图搜图（AG6 接线）：选一张图 → POST /api/v1/search/image（multipart）→ **复用同一结果区**。
	 *  · 取消选图静默（入口取消＝什么都不做，口径同 RecordSheet.pickPhotos）；
	 *  · 失败由封装 toast、结果置空（**不伪造命中**）；
	 *  · 图搜无关键词 ⇒ 清空 keyword 并置 hasSearched（由状态机 applyImageResult 统一处理），
	 *    避免结果区回落到"输入关键词开始搜索"这种与事实不符的空态文案。
	 */
	function runImageSearch(): void {
		uni.chooseImage({
			count: 1,
			sourceType: ['album', 'camera'],
			success: (res) => {
				const paths = res.tempFilePaths
				if (paths.length === 0) {
					return
				}
				ss.loading.value = true
				searchByImage(paths[0], 30).then((out) => {
					ss.loading.value = false
					ss.applyImageResult(out)
				})
			}
		})
	}

	function openResult(item: any): void {
		const id = (item as VoiceResult).id
		uni.navigateTo({ url: '/pages/detail/detail?contentId=' + id })
	}

	// W0-2 就地播放：真音频流（downloadFile 带 header → InnerAudioContext），
	// 播放态视觉与 index/detail 统一（F5a 规范：钮变暂停 + 已播金/未播米 + 进度行）。
	// tick 局部更新后，播放态进卡由 syncActiveCard 负责（watch audio_player refs 驱动），
	// 原模板包装函数 voiceIsActive/voiceIsPlaying/voiceProgressOfCard/voiceCurSecText/voiceTotalSecText 已删。
	function playVoice(item: VoiceResult): void {
		// BB3：播放入口懒拉真实波形（列表不为每卡预拉；组件内 waveform prop 真值优先）
		wf.loadWaveform(item.id)
		toggleVoice(item.id)
	}

	// （转换器遗留 setFilterAll/Photo/Voice/Text 字符串调用早已删除；2026-10-16 筛选行改为
	//   v-for filterChips + onFilterTap/isFilterActive，筛选状态与历史一并进 useSearchState）
</script>


<template>
	<!-- B10 方案A P2：自 pages/ai/ai.uvue 整体搬迁；TabBar/RecordSheet 挂载与浮层态上收 shell，
	     attachOpen 经 shell_state 共享（返回键协同）；处置记录台账 §EE -->
<!-- ardot 直转 v2：AI 对话页（帧 2:332）· W10.4 数据驱动改造（2026-09-01 峰宝拍板）
	     mock 契约（contract-first，B2 对话域接线时按此换真端点，mock 层整体可删）：
	     POST /api/v1/chat/messages   { conversation_id?, content, attachments?[] } → { reply }
	     GET  /api/v1/chat/replies/:id（流式分片轮询/SSE，形态由 reply.kind 决定：
	          bubble | plain+chips | cards | confirm | typing）
	     mock 开关：USE_MOCK_CHAT（2026-09-23 补真身——此前本行声称的常量在代码中**并不存在**，
	          属无条件硬编码，既无法配置关闭、也不告知用户是演示数据，见台账 §7.1）：
	          true  = 样张对话 + 本地闭环回复（内测期现状），页面顶部显式标注「内测演示数据」
	          false = 不注入样张；**走真端点** POST /api/v1/chat/messages（AG6 已接线，
	                  封装见 utils/chat_api.uts）——失败时撤掉 typing 占位、由 api 层提示原因，
	                  **绝不伪造 AI 回复**

	     翻转前提（2026-09-23 AG6 登记的诚实边界）：后端 AG5 已就绪且真代理 E2E 跑通（56.3s、
	     chat_messages/memories 落库实证），但 true→false 还需满足
	       ① 本文件改动过编译门（已过）② 后端在**客户端可达的地址**上——内测包指向部署域名，
	          当前只有本机 127.0.0.1:8000 ⇒ 上机前翻转只会得到"请求失败"（等于把演示数据换成错误提示）。
	     两条都满足后：删本常量与 mock 层（seedMockMessages/buildMockReply/REPLY_KIND_ROTATION）。 -->
	<view class="ai-root">
		<view class="ai-header">
			<text class="n2_336">AI</text>
			<text class="n2_337">问问你的回忆</text>
		</view>
		<!-- 演示数据标注（2026-09-23）：内测期智能体尚未接入后端，必须显式告知，
		     否则用户会把样张对话当成已上线的能力（台账 §7.1） -->
		<view v-if="USE_MOCK_CHAT" class="demo-note">
			<text class="demo-note-text">内测演示数据 · 智能体尚未接入后端</text>
		</view>
		<!-- 2026-09-23 编译门修复：`scroll-y` 在 uni-app x 的 <scroll-view> 上**不是受支持属性**
		     （编译器原话：Property 'scroll-y' is not supported），正确写法是 `direction`。
		     uni-app x 的 scroll-view 只定义 direction（none/vertical/horizontal/all）+ refresherEnabled
		     （HBuilderX 自带 dts dom2/UniNativeScrollView.d.ts）。 -->
		<scroll-view class="n4_88" direction="vertical" :scroll-into-view="scrollInto">
			<view v-for="m in messages" :key="m.id" :id="'msg-' + m.id">
				<!-- AI 消息组 -->
				<view v-if="m.role === 'ai'" class="ai-group">
					<view class="n2_339">
						<text class="n2_341">AI</text>
						<view class="n4_1">
							<image class="n4_2" src="/static/icons/i4_2.svg" />
						</view>
					</view>
					<!-- 形态①：普通气泡（可内嵌记忆卡） -->
					<view v-if="m.kind === 'bubble'" class="n2_342">
						<text class="n2_343">{{ m.text }}</text>
						<view v-if="m.cards.length > 0" class="n2_344">
							<image class="n2_345" :src="m.cards[0].img" mode="aspectFill" />
							<view class="n2_346">
								<text class="n2_347">{{ m.cards[0].title }}</text>
								<text class="n2_348">{{ m.cards[0].meta }}</text>
							</view>
						</view>
					</view>
					<!-- 形态②：直铺长答（无气泡 bullet 组，画布 ai_reply 4:311）+ 尾部追问 chips（4:333） -->
					<view v-else-if="m.kind === 'plain'" class="plain-block">
						<text class="plain-title">{{ m.text }}</text>
						<view v-for="(b, bi) in m.bullets" :key="bi" class="plain-bullet">
							<view class="plain-dot" />
							<text class="plain-text">{{ b }}</text>
						</view>
						<view v-if="m.chips.length > 0" class="chips-row">
							<view v-for="(c, ci) in m.chips" :key="ci" class="chip pressable" @tap="onChipTap(c)">
								<text class="chip-text">{{ c }}</text>
							</view>
						</view>
					</view>
					<!-- 形态③：记忆卡横滑组（画布 4:323，第二张露边示意滑动） -->
					<view v-else-if="m.kind === 'cards'" class="cards-wrap">
						<!-- 2026-09-23 编译门修复（**这是真缺陷，不只是警告**）：原 `scroll-x` 同样不受支持、被静默忽略
					     → 该横滑组退化为默认方向，而画布 4:323 的设计是"第二张露边示意滑动"
					     （横向可滑）。改 direction="horizontal" 才是设计意图。 -->
					<scroll-view class="cards-scroll" direction="horizontal">
							<view v-for="(cd, di) in m.cardList" :key="di" class="mem-card">
								<image class="mem-thumb" :src="cd.img" mode="aspectFill" />
								<text class="mem-title">{{ cd.title }}</text>
								<text class="mem-meta">{{ cd.meta }}</text>
							</view>
						</scroll-view>
						<view v-if="m.chips.length > 0" class="chips-row">
							<view v-for="(c, ci) in m.chips" :key="ci" class="chip pressable" @tap="onChipTap(c)">
								<text class="chip-text">{{ c }}</text>
							</view>
						</view>
					</view>
					<!-- 形态④：行动确认卡（AI 发起待确认操作，画布 4:339） -->
					<view v-else-if="m.kind === 'confirm'" class="confirm-card">
						<view class="confirm-row">
							<view class="confirm-star">
								<image class="confirm-star-img" src="/static/icons/i4_2.svg" />
							</view>
							<text class="confirm-text">{{ m.text }}</text>
						</view>
						<view class="confirm-btns">
							<view class="btn-ghost pressable" @tap="onConfirmAction(m, false)">
								<text class="btn-ghost-text">暂不</text>
							</view>
							<view class="btn-primary pressable" @tap="onConfirmAction(m, true)">
								<text class="btn-primary-text">加入胶囊</text>
							</view>
						</view>
					</view>
					<!-- 形态⑤：流式输出态（画布 4:349；点透明度阶梯模拟渐隐，App 端 keyframes 支持有限） -->
					<view v-else-if="m.kind === 'typing'" class="typing-row">
						<text class="typing-text">{{ m.text }}</text>
					<view class="td-1" />
					<view class="td-2" />
					<view class="td-3" />
					</view>
				</view>
				<!-- 用户消息行 -->
				<view v-else class="n2_349">
					<view class="n2_350">
						<text class="n2_351">{{ m.text }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
		<view class="n2_355">
			<input class="n2_357" v-model="draft" placeholder="问点什么…" placeholder-style="color:#B3A696;font-size:26.9rpx;" :maxlength="200" confirm-type="send" @confirm="onSend" />
			<view class="n2_358" @tap="onSend">
				<image class="n2_359" src="/static/icons/i2_359.svg" />
			</view>
			<!-- 附件入口（2026-09-01 峰宝拍板）：发送钮左移、入口放其右侧（最右端，画布终审同序） -->
			<view class="attach-btn pressable" @tap="openAttach">
				<image class="attach-btn-icon" src="/static/icons/icon-paperclip.svg" />
			</view>
		</view>

		<!-- 附件选择面板（画布 ai_typing 4:361 半屏形态）：scrim 点空收起 -->
		<view v-if="attachShown()" class="attach-scrim" @tap="closeAttach" />
		<view v-if="attachShown()" class="attach-panel">
			<view class="attach-handle" />
			<text class="attach-title">添加附件</text>
			<view class="attach-grid">
				<view class="grid-row">
					<image class="grid-thumb grid-thumb-first" src="/static/images/img2_345.png" mode="aspectFill" />
					<image class="grid-thumb" src="/static/images/img2_140.png" mode="aspectFill" />
					<image class="grid-thumb" src="/static/images/img2_256.png" mode="aspectFill" />
				</view>
				<view class="grid-row">
					<image class="grid-thumb grid-thumb-first" src="/static/images/img2_74.png" mode="aspectFill" />
					<image class="grid-thumb" src="/static/images/img4_406.png" mode="aspectFill" />
					<image class="grid-thumb" src="/static/images/img2_16.png" mode="aspectFill" />
				</view>
			</view>
			<view class="attach-entries">
				<view class="attach-entry attach-entry-first pressable" @tap="onAttachEntry('文件')">
					<image class="attach-entry-icon" src="/static/icons/icon-file.svg" />
					<text class="attach-entry-text">文件</text>
				</view>
				<view class="attach-entry pressable" @tap="onAttachEntry('粘贴链接')">
					<image class="attach-entry-icon" src="/static/icons/icon-link.svg" />
					<text class="attach-entry-text">粘贴链接</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onMounted, watch } from 'vue'
	import { aiAttachOpen } from '@/utils/shell_state'
	import { sendChatMessage, ChatSendResult } from '@/utils/chat_api'
	// AI 对话页（W10.4 数据驱动）：USE_MOCK_CHAT=true 时消息流全量 mock（形态族覆盖）、onSend 本地闭环；
	// =false 时 onSend 走**真端点** POST /api/v1/chat/messages（AG6 接线，封装见 utils/chat_api.uts）。

	let draft = ref('') // AI 输入草稿
	// attachOpen 上收 shell_state.aiAttachOpen（返回键优先级协同 shell 浮层；B10 P2）

	// ── 消息数据模型（contract-first：字段名与未来 B2 chat 契约对齐）──
	// uvue 约定：对象一律 class+constructor+new（项目已验证套路，对齐 messages.uvue MessageItem），
	// 不用 type 字面量构造（MemCard(title:...) 写法编译器不认，W10.4 编译失败实锤）
	class MemCard {
		title: string
		meta: string
		img: string
		constructor(title: string, meta: string, img: string) {
			this.title = title
			this.meta = meta
			this.img = img
		}
	}
	class AiMsg {
		id: number
		role: string // 'user' | 'ai'
		kind: string // 'bubble' | 'plain' | 'cards' | 'confirm' | 'typing'
		text: string
		bullets: Array<string> // plain 形态要点
		chips: Array<string> // 尾部快捷追问
		cards: Array<MemCard> // bubble 内嵌卡（0/1 张）；cards 横滑时用 cardList
		cardList: Array<MemCard>
		constructor(id: number, role: string, kind: string, text: string, bullets: Array<string>, chips: Array<string>, cards: Array<MemCard>, cardList: Array<MemCard>) {
			this.id = id
			this.role = role
			this.kind = kind
			this.text = text
			this.bullets = bullets
			this.chips = chips
			this.cards = cards
			this.cardList = cardList
		}
	}
	let messages = ref<Array<AiMsg>>([])
	let nextId = ref(1)
	let scrollInto = ref('') // scroll-view 锚点滚动（新消息自动落底）
	let replyKindIdx = ref(0) // AI 回复形态轮换指针
	const REPLY_KIND_ROTATION = ['bubble', 'plain', 'cards', 'confirm']

	// ── 演示开关（2026-09-23 补真身）──────────────────────────────────────────
	// 头注释自 08-01 起声称有本常量，但代码里**从未存在**（seedMockMessages/onSend/
	// onConfirmAction 全部无条件走 mock）→ 后果：① 无法通过配置关闭 ② 用户无从得知是演示
	// 数据，会把样张当成已上线的智能体（见 docs/决策台账.md §7.1）。
	// 现补真身并使三处接线点全部按其分支；**B2 对话域接线后本常量应删除**（改真端点）。
	const USE_MOCK_CHAT: boolean = true

	// 会话 ID（AG6）：后端按 conversation_id 存 thread（多轮上下文靠它，丢了就每轮失忆）；
	// 落盘以便重启后接续同一会话（键名前缀与仓内既有 storage 键风格一致）
	const CHAT_CONV_KEY = 'yishu_chat_conversation_id'
	let conversationId = ref('')

	// mock 相册图（static/images 现有资产）
	const MOCK_IMGS = ['/static/images/img2_345.png', '/static/images/img2_140.png', '/static/images/img2_256.png', '/static/images/img2_74.png']

	// AI 回复语料池（mock：B2 接入后删除；uts 数组单型约束，标题与要点拆两常量）
	const MOCK_PLAIN_TITLE = '你 8 月的记忆脉络'
	const MOCK_PLAIN_BULLETS = ['记录高峰在月末，共 23 条', '「湖边」是本月最强的记忆锚点', '语音占比 41%，转写准确率 98%']
	const MOCK_CARD_TITLES = ['清晨的湖边', '实验室的深夜', '桂花树下', '周末的菜场']

	// ── mock 对话样张（onLoad 注入，覆盖画布 ai_reply 板 ①②③④⑥ + 用户长文）──
	function seedMockMessages(): void {
		const seq: Array<AiMsg> = [
			mkUser('那天天气怎么样？'),
			mkAi('bubble', '那天早上有薄雾，07:42 拍下的这张照片，气温大概 26°C——你自己也在备注里写了「风很轻」。', [new MemCard('清晨的湖边，风很轻', '8月28日 · 照片', MOCK_IMGS[0])], [], [], []),
			mkUser('帮我回顾一下这个月'),
			mkAi('plain', MOCK_PLAIN_TITLE, [], ['那周最开心的事', '生成 8 月周报'], MOCK_PLAIN_BULLETS, []),
			mkAi('cards', '', [], ['看看那天还在做什么'], [], [new MemCard('清晨的湖边', '8月28日 · 照片', MOCK_IMGS[0]), new MemCard('实验室的深夜', '8月22日 · 文字', MOCK_IMGS[1])]),
			mkUser('这段语音转写的内容帮我整理一下：那天我们在湖边走了很久，聊到奶奶种的那棵桂花树，说秋天满院子都是甜香，还想约着国庆回去看看，把院子重新收拾一遍，拍照留个纪念。'),
			mkAi('bubble', '奶奶总说，老屋门口的那棵桂花树是她嫁过来那年种下的。每到秋天，满院子都是甜香，她总在树下摆一张小桌择菜，跟路过邻居打招呼。你上次回去是三年前的秋天，还拍了满地金黄的落花——要不要把这段整理成一条「桂花树」主题记忆？', [], [], [], []),
			mkAi('confirm', '要把「湖边晨雾」加入 8 月时间胶囊吗？', [], [], [], [])
		]
		messages.value = seq
	}

	// 工厂：减少字面量重复（全显式参数，不用默认值——uts 默认参数零先例不冒险）
	function mkUser(text: string): AiMsg {
		nextId.value = nextId.value + 1
		return new AiMsg(nextId.value, 'user', 'bubble', text, [], [], [], [])
	}
	function mkAi(kind: string, text: string, cards: Array<MemCard>, chips: Array<string>, bullets: Array<string>, cardList: Array<MemCard>): AiMsg {
		nextId.value = nextId.value + 1
		return new AiMsg(nextId.value, 'ai', kind, text, bullets, chips, cards, cardList)
	}

	// ── 发送闭环（mock）：用户消息 → typing → 1.8s 后 AI 回复（形态轮换）──
	function onSend(): void {
		const t = draft.value.trim()
		if (t == '') {
			return
		}
		if (USE_MOCK_CHAT === false) {
			// 真端点（AG6）：本地即时上屏用户消息 + typing 占位，等 POST /api/v1/chat/messages
			// （后端 AG5 已实现：JWT→可信 user_id、反代 Agent、失败返回 502/504 而**不伪造回复**）
			draft.value = ''
			const u2 = mkUser(t)
			const tp2 = mkAi('typing', '正在翻你的回忆', [], [], [], [])
			messages.value.push(u2)
			messages.value.push(tp2)
			scrollToBottom(tp2.id)
			const tpId = tp2.id
			sendChatMessage(conversationId.value, t).then((r: ChatSendResult | null) => {
				removeById(tpId)
				if (r == null) {
					// **不伪造回复**：只撤掉 typing 占位。失败原因由 api 层全局 toast（带后端 message）
					// 与 Sentry 承担；用户输入已上屏、可直接重发——比编一句假 AI 回复诚实，
					// 也便于按后端日志复盘"问了但没答上"（chat_messages 里用户行仍在）
					return
				}
				if (r.conversationId != '') {
					conversationId.value = r.conversationId
					uni.setStorageSync(CHAT_CONV_KEY, r.conversationId)
				}
				const ai = mkAi(r.reply.kind, r.reply.text, [], [], r.reply.bullets, [])
				messages.value.push(ai)
				scrollToBottom(ai.id)
			})
			return
		}
		draft.value = ''
		const u = mkUser(t)
		const tp = mkAi('typing', '正在翻你的回忆', [])
		messages.value.push(u)
		messages.value.push(tp)
		scrollToBottom(tp.id)
		const replyId = tp.id
		const userId = u.id
		setTimeout(() => {
			removeById(replyId)
			const kind = REPLY_KIND_ROTATION[replyKindIdx.value % REPLY_KIND_ROTATION.length]
			replyKindIdx.value = replyKindIdx.value + 1
			const ai = buildMockReply(kind, userId)
			messages.value.push(ai)
			scrollToBottom(ai.id)
		}, 1800)
	}

	// mock 回复生成器（B2 接线后删除）
	function buildMockReply(kind: string, _userId: number): AiMsg {
		if (kind == 'plain') {
			return mkAi('plain', MOCK_PLAIN_TITLE, [], ['那周最开心的事', '生成 9 月计划'], MOCK_PLAIN_BULLETS, [])
		}
		if (kind == 'cards') {
			const i = nextId.value % MOCK_CARD_TITLES.length
			return mkAi('cards', '', [], ['看看那天还在做什么'], [], [new MemCard(MOCK_CARD_TITLES[i], '8月 · 照片', MOCK_IMGS[i % MOCK_IMGS.length]), new MemCard(MOCK_CARD_TITLES[(i + 1) % MOCK_CARD_TITLES.length], '8月 · 文字', MOCK_IMGS[(i + 1) % MOCK_IMGS.length])])
		}
		if (kind == 'confirm') {
			return mkAi('confirm', '要把这条记忆加入本月时间胶囊吗？', [], [], [], [])
		}
		return mkAi('bubble', '翻到了——那天你拍了 4 张照片、留了 1 段 37 秒的语音，都在「湖边」这个主题下面。想听那段语音的转写吗？', [], [], [], [])
	}

	// 移除 typing 占位（uts 数组无 filter 先例，手写重建最稳）
	function removeById(id: number): void {
		const src = messages.value
		const out: Array<AiMsg> = []
		for (let i = 0; i < src.length; i++) {
			if (src[i].id != id) {
				out.push(src[i])
			}
		}
		messages.value = out
	}

	// 锚点滚动：scroll-into-view 指向最新消息 id（不支持时静默无滚动，不阻塞）
	function scrollToBottom(id: number): void {
		scrollInto.value = ''
		setTimeout(() => {
			scrollInto.value = 'msg-' + id
		}, 50)
	}

	// chips 点击 = 快捷追问当作输入发送（体验闭环）
	function onChipTap(c: string): void {
		draft.value = c
		onSend()
	}

	// 行动确认卡按钮（mock：B2 接线后改 POST 确认接口）
	function onConfirmAction(m: AiMsg, ok: boolean): void {
		if (USE_MOCK_CHAT === false) {
			// 措辞更正（AG6）：智能体**已接入**，未实现的是"确认卡"这条交互流程本身
			// （后端无 chat 域确认端点；确认卡目前只由 mock 生成，见文件头形态④）。
			// 原话"智能体尚未接入"会误导用户以为整个 AI 不可用——失实文案与失实注释同罪。
			uni.showToast({ title: '该操作暂未开放（内测）', icon: 'none', duration: 2500 })
			return
		}
		removeById(m.id)
		if (ok) {
			const ai = mkAi('bubble', '好，已把「湖边晨雾」收进 8 月时间胶囊。', [new MemCard('8 月时间胶囊', '已收录 12 条记忆', MOCK_IMGS[2])], [], [], [])
			messages.value.push(ai)
			scrollToBottom(ai.id)
		}
	}

	// 附件面板壳化协同（B10 P2）：开关经 shell_state 共享 ref（返回键优先级由 shell 消费）
	function attachShown(): boolean {
		return aiAttachOpen.value
	}
	function openAttach(): void {
		aiAttachOpen.value = true
	}
	function closeAttach(): void {
		aiAttachOpen.value = false
	}
	// 附件入口行（mock：MVP 文件/链接选择器未接，W0-4 措辞诚实化，与全项目占位口径统一）
	function onAttachEntry(name: string): void {
		closeAttach()
		uni.showToast({ title: name + '：即将上线', icon: 'none' })
	}


	// RecordSheet 保存成功回调（AI 页无可刷新数据，占位收口）
	function onRecordSaved(): void {
	}

	// ── B1 上下文预填接收端（detail 页 askAI 携带当前记忆上下文跳入）──
	// 主控裁决（2026-09-08）：统一走 detail.uvue askAI 的 storage 三键契约（含 content_id 供对话域后续用）：
	//   yishu_ai_context_title（记忆标题）/ yishu_ai_context_body（正文全文）/ yishu_ai_context_content_id（内容 id）
	// 读后即清防陈旧残留；url query 通道（memTitle/memSummary）保留作 manage→theme-detail 同族先例兼容
	const PREFILL_KEY_TITLE = 'memTitle'
	const PREFILL_KEY_SUMMARY = 'memSummary'
	const PREFILL_CTX_TITLE = 'yishu_ai_context_title'
	const PREFILL_CTX_BODY = 'yishu_ai_context_body'
	const PREFILL_CTX_CONTENT_ID = 'yishu_ai_context_content_id'
	const PREFILL_MAX_LEN = 200

	function prefillDraftFrom(title: string, summary: string): void {
		// 参数化签名（B10 P2：url query 解参上收 shell onLoad，双 prop 直传）；
		// 全空时仍走 storage 三键兜底（detail askAI 主通道，与来源无关）
		if (title == '' && summary == '') {
			// storage 三键兜底（detail.uvue askAI 契约，读后即清；JSON.parse 先例 api.uts:530）
			try {
				const ctxTitle = uni.getStorageSync(PREFILL_CTX_TITLE)
				const ctxBody = uni.getStorageSync(PREFILL_CTX_BODY)
				const ctxCid = uni.getStorageSync(PREFILL_CTX_CONTENT_ID)
				const hasCtx = (ctxTitle != null && ctxTitle != '') || (ctxBody != null && ctxBody != '')
					|| (ctxCid != null && ctxCid != '')
				if (hasCtx) {
					title = (ctxTitle != null ? (ctxTitle as string) : '')
					summary = (ctxBody != null ? (ctxBody as string) : '')
					// content_id 暂不入对话 payload（B2 对话域接线时用），先清防残留
					uni.removeStorageSync(PREFILL_CTX_TITLE)
					uni.removeStorageSync(PREFILL_CTX_BODY)
					uni.removeStorageSync(PREFILL_CTX_CONTENT_ID)
				}
			} catch (e) {
				console.log('[dbg-ai] prefill storage parse failed: ' + e)
			}
		}
		if (title == '' && summary == '') {
			return
		}
		let text = ''
		if (title != '') {
			text = '关于「' + title + '」'
			if (summary != '') {
				text = text + '：' + summary
			}
		} else {
			text = summary
		}
		if (text.length > PREFILL_MAX_LEN) {
			text = text.substring(0, PREFILL_MAX_LEN)
		}
		draft.value = text
	}

	// B10 方案A 组件契约（P2）：options（?memTitle=）与 RecordSheet @saved 上收 shell——
	// prefillTitle/prefillSummary 承接 url query 通道（shell 解参直传；三键 storage 通道本组件直读）；
	// savedSeq 每次记录保存成功 ++（原 onRecordSaved 占位收口语义不变）。
	const props = defineProps({
		prefillTitle: { type: String, default: '' },
		prefillSummary: { type: String, default: '' },
		savedSeq: { type: Number, default: 0 }
	})
	onMounted((): void => {
		aiAttachOpen.value = false // 原页级初值：进组件即收起
		if (USE_MOCK_CHAT) {
			seedMockMessages()
		} else {
			// 接续上次会话（多轮上下文）；空串 ⇒ 首轮由后端新建会话
			const saved = uni.getStorageSync(CHAT_CONV_KEY) as string
			if (saved != null && saved != '') {
				conversationId.value = saved
			}
		}
		prefillDraftFrom(props.prefillTitle, props.prefillSummary)
	})
	watch((): number => props.savedSeq, (n: number): void => {
		if (n > 0) {
			onRecordSaved()
		}
	})
</script>

<style>
	@import '@/styles/tab-ai.css';
</style>

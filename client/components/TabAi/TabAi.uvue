<template>
	<!-- B10 方案A P2：自 pages/ai/ai.uvue 整体搬迁；TabBar/RecordSheet 挂载与浮层态上收 shell，
	     attachOpen 经 shell_state 共享（返回键协同）；处置记录台账 §EE -->
<!-- ardot 直转 v2：AI 对话页（帧 2:332）· W10.4 数据驱动改造（2026-09-01 峰宝拍板）
     真端点契约（2026-10-09 起为**流式**；封装见 utils/chat_api.uts）：
     POST /api/v1/chat/messages/stream   { conversation_id?, content, attachments?[], include_profile? }
          → text/event-stream：status / preview / tool / replace / done / error
          （preview 为**累计全文**；客户端逐帧覆盖渲染 typing 气泡 ⇒ 逐字效果）
     2026-10-16「附件契约最小可用」：`attachments[]` **不再是空契约**——附件面板「图片」真选图、
         走既有上传链落库拿 content_id 后随消息上行（见 onPickImage/uploadOneImage/sendNow）；
         `include_profile` 为**契约能力**（当前无 UI 消费者：原隐私开关 2026-10-14 整行移除，
        台账 §7.18）——客户端恒 true；后端必须真的按它行事（false ⇒ 不携带画像上下文）。
     GET  /api/v1/chat/conversations/{id}/messages（进入会话回填历史）
     GET  /api/v1/chat/replies/:id（客户端当前无调用点；断线重取预留，contract.uts 有登记）
     注：非流式 POST /api/v1/chat/messages 仍在后端保留（脚本/降级路径），客户端不再走它。
     mock 开关：USE_MOCK_CHAT（2026-09-23 补真身——此前本行声称的常量在代码中**并不存在**，
          属无条件硬编码，既无法配置关闭、也不告知用户是演示数据，见台账 §7.1）：
          true  = 样张对话 + 本地闭环回复（仅演示/录屏），页面顶部显式标注「内测演示数据」
          false = 不注入样张；**走真端点**（流式，AG6 接线 + 2026-10-09 流式化）——失败时
                  撤掉 typing 占位、由 api 层提示原因，**绝不伪造 AI 回复**

	     翻转前提（2026-09-23 AG6 登记的诚实边界）：后端 AG5 已就绪且真代理 E2E 跑通（56.3s、
	     chat_messages/memories 落库实证），但 true→false 还需满足
	       ① 本文件改动过编译门（已过）② 后端在**客户端可达的地址**上——内测包指向部署域名，
	          当前只有本机 127.0.0.1:8000 ⇒ 上机前翻转只会得到"请求失败"（等于把演示数据换成错误提示）。
	     两条都满足后：删本常量与 mock 层（seedMockMessages/buildMockReply/REPLY_KIND_ROTATION）。 -->
	<view class="ai-root tk-root">
		<view class="ai-header">
			<view class="ai-title-row">
				<text class="n2_336">AI</text>
				<!-- 「新会话」真入口（2026-10-26 · AI 页重设计 ②）。
				     原来只有一枚 `.chip`「开启新对话」贴在副标题右侧 —— 与正文同色同层、
				     权重为零，用户原话「只有一个文字条」；而且它其实**只清上下文**，
				     视觉上却承诺了"开一个新会话"。
				     现改为标题行右侧的**独立描边按钮**（锈红字 + 白底 + 锈红细描边）：
				       · 热区 88.5rpx × ≥88.5rpx（≈44×44dp）—— 满足无障碍最小热区；
				       · 文字 24rpx、色 --c-rust-500 对白底 = **4.81:1**（AA 正文达标）；
				       · 只在"有活动会话"时出现（无会话时按下也无事可做 ⇒ 不给假按钮）。
				     行为仍走 onClearContext（删会话键 + 清内存态），但**多一步确认**：
				     原文案承诺的是"开新会话"，而空白会话并不会让旧消息消失 —— 必须说清楚。 -->
				<view v-if="!USE_MOCK_CHAT && conversationId != ''" class="ai-newchat pressable" @tap="onNewChat">
					<text class="ai-newchat-text">新会话</text>
				</view>
			</view>
			<text class="n2_337">问问你的回忆</text>
		</view>
		<!-- 演示数据标注（2026-09-23）：内测期智能体尚未接入后端，必须显式告知，
		     否则用户会把样张对话当成已上线的能力（台账 §7.1） -->
		<view v-if="USE_MOCK_CHAT" class="demo-note">
			<text class="demo-note-text">内测演示数据 · 智能体尚未接入后端</text>
		</view>
		<!-- 2026-09-23 编译门修复：`scroll-y` 在 uni-app x 的 <scroll-view> 上**不是受支持属性**
		     （编译器原话：Property 'scroll-y' is not supported），正确写法是 `direction`。
		     uni-app x 的 scroll-view 只定义 direction（none/vertical/horizontal/all）+ refresherEnabled
		     （HBuilderX 自带 dts dom2/UniNativeScrollView.d.ts）。 -->
		<scroll-view class="n4_88" direction="vertical" :scroll-into-view="scrollInto">
			<!-- 2026-09-25（Agent 接线补完）：**真链空态**。`USE_MOCK_CHAT` 翻转为 false 后，
			     全新用户（无历史）会看到一片空白 —— 那是我方翻开关引入的体验回归，故补一个
			     **诚实空态**：无假数据、不预填示例对话；有历史时不显示（由 onMounted 回填填充）。
			     2026-10-26（AI 页重设计）：空态从"两句灰字"升级为**可点的开场**——
			     原来用户面对一片空白只能自己想问什么，而"问问你的回忆"这个能力本身不难，
			     难的是**不知道能问什么**。三个代表性问题（时间回溯 / 主题回顾 / 找东西）
			     直接当输入发送，点一下就有真实回答（走同一条 sendNow，零新链路）。 -->
			<view v-if="messages.length == 0 && !USE_MOCK_CHAT" class="ai-empty">
				<view class="ai-empty-mark">
					<image class="ai-empty-mark-img" src="/static/icons/i4_2.svg" />
				</view>
				<text class="ai-empty-title">和你的回忆聊聊</text>
				<text class="ai-empty-sub">你的记录、照片和语音，都可以直接问</text>
				<view class="ai-empty-prompts">
					<view v-for="(q, qi) in EMPTY_PROMPTS" :key="'ep-' + qi" class="ai-prompt pressable" @tap="onPromptTap(q)">
						<text class="ai-prompt-text">{{ q }}</text>
					</view>
				</view>
			</view>
			<view v-for="m in messages" :key="m.id" :id="'msg-' + m.id">
				<!-- AI 消息组 -->
				<view v-if="m.role === 'ai'" class="ai-group">
					<view class="n2_339">
						<text class="n2_341">AI</text>
						<view class="n4_1">
							<image class="n4_2" src="/static/icons/i4_2.svg" />
						</view>
					</view>
					<!-- 形态①②（气泡/直铺）抽到 AiBody.uvue（2026-10-25 · 800 行棘轮先抽再改；
					     先例 SearchHitOps.uvue）。chips 经 @chip 回抛本文件 onChipTap，业务仍在此。 -->
					<AiBody
						v-if="m.kind === 'bubble' || m.kind === 'plain'"
						:kind="m.kind"
						:text="m.text"
						:bullets="m.bullets"
						:paragraphs="m.paragraphs"
						:chips="m.chips"
						:card-title="m.cards.length > 0 ? m.cards[0].title : ''"
						:card-meta="m.cards.length > 0 ? m.cards[0].meta : ''"
						:card-img="m.cards.length > 0 ? m.cards[0].img : ''"
						:source-count="m.sources.length"
						@chip="onChipTap"
					/>
					<!-- 形态③：记忆卡横滑组（画布 4:323，第二张露边示意滑动） -->
					<view v-else-if="m.kind === 'cards'" class="cards-wrap">
						<!-- 引导文案（2026-10-09 结构化回复）：卡片是 agent 正文的**结构化投影**，
						     但正文里可能有卡片装不下的信息（如"这让我想起你 X 月也记过类似的事"），
						     整段丢掉会让用户觉得答非所问 ⇒ 正文保留为一行引导语，卡片在下 -->
						<text v-if="m.text != ''" class="cards-lead">{{ m.text }}</text>
						<!-- 2026-09-23 编译门修复（**这是真缺陷，不只是警告**）：原 `scroll-x` 同样不受支持、被静默忽略
					     → 该横滑组退化为默认方向，而画布 4:323 的设计是"第二张露边示意滑动"
					     （横向可滑）。改 direction="horizontal" 才是设计意图。 -->
					<scroll-view class="cards-scroll" direction="horizontal">
							<view v-for="(cd, di) in m.cardList" :key="di" class="mem-card">
								<!-- 2026-10-09：文字记忆没有缩略图（agent 卡片 img 为空串）⇒ 跳过图片，
								     否则是一块空白碎图（比没有更难看，也让人以为加载失败） -->
								<image v-if="cd.img != ''" class="mem-thumb" :src="cd.img" mode="aspectFill" />
								<text class="mem-title">{{ cd.title }}</text>
								<text class="mem-meta">{{ cd.meta }}</text>
							</view>
						</scroll-view>
						<view v-if="m.chips.length > 0" class="chips-row">
							<view v-for="(c, ci) in m.chips" :key="ci" class="chip pressable" @tap="onChipTap(c)">
								<text class="chip-text">{{ c }}</text>
							</view>
						</view>
					</view>
					<!-- 形态④：行动确认卡（AI 发起待确认操作，画布 4:339） -->
					<view v-else-if="m.kind === 'confirm'" class="confirm-card">
						<view class="confirm-row">
							<view class="confirm-star">
								<image class="confirm-star-img" src="/static/icons/i4_2.svg" />
							</view>
							<text class="confirm-text">{{ m.text }}</text>
						</view>
						<view class="confirm-btns">
							<view class="btn-ghost pressable" @tap="onConfirmAction(m, false)">
								<text class="btn-ghost-text">暂不</text>
							</view>
							<view class="btn-primary pressable" @tap="onConfirmAction(m, true)">
								<text class="btn-primary-text">加入胶囊</text>
							</view>
						</view>
					</view>
					<!-- 形态⑤：流式等待/生成态（2026-10-25 · task-16 ② 重设计，抽到 AiTyping.uvue）
					     实测驱动：SSE 是真流式（帧间隔 8~205ms 分散），但**首帧延迟约 1s** —— 那一秒
					     用户看不到任何东西，正是"感觉不是流式"的主因。AiTyping 三档渐进叙事：
					     无信号→「忆光正在读你的话…」/ 有 tool 帧→「正在翻你的记忆…」/
					     有正文→逐字文本 + 行尾光标。文案纪律与判据见该组件头注。 -->
					<AiTyping v-else-if="m.kind === 'typing'" :text="chatStreamText" :tool="chatStreamTool" />
					<!-- 形态⑥：发送失败重试卡（2026-10-07 客户端加固）：保留原文，一键重发 -->
					<view v-else-if="m.kind === 'failed'" class="fail-card pressable" @tap="onRetry(m)">
						<text class="fail-text">发送失败 · 点此重试</text>
					</view>
				</view>
				<!-- 用户消息行 -->
				<view v-else class="n2_349">
					<view class="n2_350">
						<text class="n2_351">{{ m.text }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
		<!-- 输入区（2026-10-26 · AI 页重设计 ②③④）：整块移交 `AiComposer.uvue`。
		     为什么搬：本文件 793 行 / 阈值 800 / 无豁免，而这三件事全在输入区
		     （自适高输入框 / 已选附件可见 / 附件面板重排），原地改必然先撞棘轮。
		     同 `AiBody.uvue`（10-25）/ `SearchHitOps.uvue`（10-16）先例：先搬再改。
		     **边界**：待发附件的状态机（图片先落库拿 contentId 才入列 / 文件只带名字 /
		     两条选择链都不关面板）已抽到 `composables/useAiAttach.uts`，本文件只做
		     「扁平投影 → props」与「发送时 takeAll()」两件事。
		     组件抛事件、宿主执行：pick-image / pick-file / remove-image / remove-file / send。 -->
		<view class="ai-composer-wrap">
			<AiComposer :busy="chatStreamActive" :image-paths="pickedImagePaths" :image-sizes="pickedImageSizes"
				:file-names="pickedFileNames" :file-sizes="pickedFileSizes" :seed-text="draft" :seed-seq="draftSeq"
				@send="onComposerSend" @pick-image="onPickImage" @pick-file="onPickFile"
				@remove-image="onRemoveImage" @remove-file="removeFile" />
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onMounted, watch, computed } from 'vue'
	import { aiAttachOpen } from '@/utils/shell_state'
	import { sendChatMessage, fetchChatHistory, ChatSendResult, ChatHistoryItem, ChatCard, ChatAttachment, chatStreamText, chatStreamTool, chatStreamActive, CHAT_CONV_STORAGE_KEY } from '@/utils/chat_api'
	// 工具标签映射（2026-10-17）：抽离到 utils/chat_tool_labels.uts（structure 棘轮拆分包体积分，
	// 同 TabSearch 先例）；12 条映射单一真源在 utils，本文件只消费。
	import { toolLabel } from '@/utils/chat_tool_labels'
	// 待发附件（选图/选文件/删除/取走）= **图片上传链 + 文件选择链 + 两个待发列表**，
	// 2026-10-26 整块抽到 `composables/useAiAttach.uts`（本文件贴 800 行阈值，先搬再改；
	// 先例 usePhotoAttach / useSearchState / usePendingVoiceRetry）。
	// 行为与抽取前逐字一致：图片先落库拿 contentId 才入列、文件只带名字、两条链都不关面板。
	import { AiAttachState } from '@/composables/useAiAttach'
	// 输入区（2026-10-26 · AI 页重设计 ②③④）：自适高输入框 + 已选附件条 + 附件面板，
	// 整块抽到 AiComposer.uvue（本文件 793 行 / 阈值 800 / 无豁免，见模板处注释）
	import AiComposer from '@/components/TabAi/AiComposer.uvue'
	// 气泡正文（形态①②）子组件（2026-10-25 · structure 棘轮 800 行拆包；
	// 先例 TabSearch.uvue:155 的 SearchHitOps 同款 default import + 模板内直接用）
	import AiBody from '@/components/TabAi/AiBody.uvue'
	// AI 对话页（W10.4 数据驱动）：USE_MOCK_CHAT=true 时消息流全量 mock（形态族覆盖）、本地闭环；
	// =false 时发送走**真端点** POST /api/v1/chat/messages（AG6 接线，封装见 utils/chat_api.uts）。

	// AI 输入草稿的**外部投放通道**（2026-10-26）：输入框本体已迁入 AiComposer.uvue，
	// 本文件不再持有"用户正在打的字"，只持有**要投给输入框的文本**（detail 页 askAI 的上下文预填、
	// 切回本 tab 时重读三键）。`draftSeq` 每次投放 ++ ⇒ 组件侧 watch(seedSeq) 才写入
	// （用 seq 而不是 watch(seedText)：同一段文本重复预填也必须生效）。
	let draft = ref('')
	let draftSeq = ref(0)
	/** 投放一段文本到输入框（幂等：seq 递增才生效） */
	function seedDraft(text: string): void {
		draft.value = text
		draftSeq.value = draftSeq.value + 1
	}

	// attachOpen 上收 shell_state.aiAttachOpen（返回键优先级协同 shell 浮层；B10 P2）

	// ── 消息数据模型（contract-first：字段名与未来 B2 chat 契约对齐）──
	// uvue 约定：对象一律 class+constructor+new（项目已验证套路，对齐 messages.uvue MessageItem），
	// 不用 type 字面量构造（MemCard(title:...) 写法编译器不认，W10.4 编译失败实锤）
	class MemCard {
		title: string
		meta: string
		img: string
		constructor(title: string, meta: string, img: string) {
			this.title = title
			this.meta = meta
			this.img = img
		}
	}
	class AiMsg {
		id: number
		role: string // 'user' | 'ai'
		kind: string // 'bubble' | 'plain' | 'cards' | 'confirm' | 'typing'
		text: string
		bullets: Array<string> // plain 形态要点（**只有真正的列表项**，2026-10-25 task-16 ②）
		// 正文段落（2026-10-25 · task-16 ②）：plain 里**不是列表项**的行，渲染成连续散文。
		// 为什么单列一个字段而不是塞进 bullets：后端 `_kind_for` 只看"有没有 \n"就判 plain，
		// 把散文也当要点渲染 = 用户说的「不像对话」。字段初始化器先例同下方 `sources`。
		paragraphs: Array<string> = []
		chips: Array<string> // 尾部快捷追问
		cards: Array<MemCard> // bubble 内嵌卡（0/1 张）；cards 横滑时用 cardList
		cardList: Array<MemCard>
		// 附件（2026-10-16 附件契约最小可用）：挂在**用户消息**上——一是失败卡重试要能带上同一批
		// 附件重发（附件已落库，content_id 复用不重复上传），二是避免"待发列表"跨消息误带。
		attachments: Array<ChatAttachment>
		// 引用回溯（2026-10-17）：本条回复引用的记忆来源 content_id 列表——**只有数量用于渲染**
		// （气泡尾注"来自 N 条记忆"，N=0 不渲染），故不进构造函数（mkAi 调用点零改动），
		// 由真链路回调按需赋值；字段初始化器先例见 privacy.uvue PolicySection.blocks。
		sources: Array<string> = []
		constructor(id: number, role: string, kind: string, text: string, bullets: Array<string>, chips: Array<string>, cards: Array<MemCard>, cardList: Array<MemCard>, attachments: Array<ChatAttachment>) {
			this.id = id
			this.role = role
			this.kind = kind
			this.text = text
			this.bullets = bullets
			this.chips = chips
			this.cards = cards
			this.cardList = cardList
			this.attachments = attachments
		}
	}

	// ── 待发附件（2026-10-26 · AI 页重设计 ③）：状态与两条选择链已抽到 useAiAttach.uts ──
	// 本文件只保留两件事：① 扁平投影（喂给 AiComposer 的 props）
	// ② 发送时 `attach.takeAll()` 取走（见 sendNow / onRetry）。
	const attach = new AiAttachState()

	// 附件 → 输入区组件的**扁平投影**。
	// 为什么不在组件边界传 `Array<ChatAttachment>`（对象数组）：本仓铁律
	// 「对象 prop 在 UTS 组件边界有类型陷阱，零先例不冒险」（AiBody / DimEvidenceList 同款判断）。
	// 故拆成 4 个基本类型数组，**顺序与下标一一对应**（同进同出，同一实例产出）。
	// 作用：AiComposer 用它们在**输入框上方常驻**一条 chip 条 —— 面板关掉也能看见已添加了什么。
	const pickedImagePaths = computed((): Array<string> => attach.imagePaths())
	const pickedImageSizes = computed((): Array<number> => attach.imageSizes())
	const pickedFileNames = computed((): Array<string> => attach.fileNames())
	const pickedFileSizes = computed((): Array<number> => attach.fileSizes())
	let messages = ref<Array<AiMsg>>([])
	let nextId = ref(1)
	let scrollInto = ref('') // scroll-view 锚点滚动（新消息自动落底）
	let replyKindIdx = ref(0) // AI 回复形态轮换指针
	const REPLY_KIND_ROTATION = ['bubble', 'plain', 'cards', 'confirm']

	// ── 演示开关（2026-09-23 补真身；2026-09-25 **接线完成后翻转为 false**）────────────
	// 头注释自 08-01 起声称有本常量，但代码里**从未存在**（seedMockMessages/onSend/
	// onConfirmAction 全部无条件走 mock）→ 后果：① 无法通过配置关闭 ② 用户无从得知是演示
	// 数据，会把样张当成已上线的智能体（见 docs/决策台账.md §7.1）。
	//
	// **2026-09-25（功能修复波 · Agent 接线）**：客户端真端点已接（发送 → chat_api
	// sendChatMessage → POST /api/v1/chat/messages → 后端反代 agent 服务），故默认值翻转为
	// **false**（＝生产口径）。`true` 仅供演示/录屏（此时页面顶部显示「内测演示数据」标注）。
	// **门禁锁定**：`audit_harness client` 断言本常量为 false —— 防止"接线回退成占位"。
	// 为什么 mock 分支**未删除**：其形态族（cards/confirm）后端 agent 尚未产出，删掉会让这些
	// 形态的模板成为**不可达 UI**（正是本仓已判定为"缺口"的那类）；保留为演示设施而非产品路径。
	const USE_MOCK_CHAT: boolean = false

	// 会话 ID（AG6）：后端按 conversation_id 存 thread（多轮上下文靠它，丢了就每轮失忆）；
	// 落盘以便重启后接续同一会话。
	// 2026-10-11：键改为从 chat_api 导入（**单一来源**）——该键的"陈旧会话自愈"逻辑在
	// chat_api 内部（CHAT_003 ⇒ 清键 + 新会话重发），两处各写字符串迟早漂移。
	const CHAT_CONV_KEY = CHAT_CONV_STORAGE_KEY
	let conversationId = ref('')

	// mock 相册图（static/images 现有资产）
	const MOCK_IMGS = ['/static/images/img2_345.png', '/static/images/img2_140.png', '/static/images/img2_256.png', '/static/images/img2_74.png']

	// AI 回复语料池（mock：B2 接入后删除；uts 数组单型约束，标题与要点拆两常量）
	const MOCK_PLAIN_TITLE = '你 8 月的记忆脉络'
	const MOCK_PLAIN_BULLETS = ['记录高峰在月末，共 23 条', '「湖边」是本月最强的记忆锚点', '语音占比 41%，转写准确率 98%']
	const MOCK_CARD_TITLES = ['清晨的湖边', '实验室的深夜', '桂花树下', '周末的菜场']

	// ── mock 对话样张（onLoad 注入，覆盖画布 ai_reply 板 ①②③④⑥ + 用户长文）──
	function seedMockMessages(): void {
		const seq: Array<AiMsg> = [
			mkUser('那天天气怎么样？', []),
			mkAi('bubble', '那天早上有薄雾，07:42 拍下的这张照片，气温大概 26°C——你自己也在备注里写了「风很轻」。', [new MemCard('清晨的湖边，风很轻', '8月28日 · 照片', MOCK_IMGS[0])], [], [], []),
			mkUser('帮我回顾一下这个月', []),
			mkAi('plain', MOCK_PLAIN_TITLE, [], ['那周最开心的事', '生成 8 月周报'], MOCK_PLAIN_BULLETS, []),
			mkAi('cards', '', [], ['看看那天还在做什么'], [], [new MemCard('清晨的湖边', '8月28日 · 照片', MOCK_IMGS[0]), new MemCard('实验室的深夜', '8月22日 · 文字', MOCK_IMGS[1])]),
			mkUser('这段语音转写的内容帮我整理一下：那天我们在湖边走了很久，聊到奶奶种的那棵桂花树，说秋天满院子都是甜香，还想约着国庆回去看看，把院子重新收拾一遍，拍照留个纪念。', []),
			mkAi('bubble', '奶奶总说，老屋门口的那棵桂花树是她嫁过来那年种下的。每到秋天，满院子都是甜香，她总在树下摆一张小桌择菜，跟路过邻居打招呼。你上次回去是三年前的秋天，还拍了满地金黄的落花——要不要把这段整理成一条「桂花树」主题记忆？', [], [], [], []),
			mkAi('confirm', '要把「湖边晨雾」加入 8 月时间胶囊吗？', [], [], [], [])
		]
		messages.value = seq
	}

	// 工厂：减少字面量重复（全显式参数，不用默认值——uts 默认参数零先例不冒险）
	function mkUser(text: string, atts: Array<ChatAttachment>): AiMsg {
		nextId.value = nextId.value + 1
		return new AiMsg(nextId.value, 'user', 'bubble', text, [], [], [], [], atts)
	}
	function mkAi(kind: string, text: string, cards: Array<MemCard>, chips: Array<string>, bullets: Array<string>, cardList: Array<MemCard>): AiMsg {
		nextId.value = nextId.value + 1
		return new AiMsg(nextId.value, 'ai', kind, text, bullets, chips, cards, cardList, [])
	}

	// ── 发送闭环（2026-10-26 起由输入区组件回调驱动）──
	// 组件 `AiComposer` 在按下发送时**先清空自己的输入框再 emit('send', text)**，
	// 故本处拿到的就是待发文本；本文件不再持有"用户正在打的字"，`draft` 降级为**投放通道**
	// （detail 页 askAI 的上下文预填，见 seedDraft / prefillDraftFrom）。
	// 🚨 2026-10-26（本轮自查抓到的回归）：**必须先判重入、再 takeAll()**。
	// `attach.takeAll()` 是**破坏性**的（取走即清空待发列表）。若写成 `sendNow(t, attach.takeAll())`
	// 就会在"上一轮还在生成"的早退路径上**先把附件吞掉**（用户看到附件消失、消息却没发出去），
	// 而抽取前的老代码是先判 `chatStreamActive` 再清列表的 —— 顺序一换就是行为回归。
	function busyBlock(): boolean {
		if (!chatStreamActive.value) {
			return false
		}
		// 上一轮还在生成：**不并发发第二条**。流式预览走模块级共享 ref（chatStreamText），
		// 两轮流同时进行会互相串写，界面会出现"两段回复夹杂"这种最难解释的现象。
		uni.showToast({ title: '正在生成回复，稍等一下', icon: 'none', duration: 1500 })
		return true
	}

	function onComposerSend(t: string): void {
		if (busyBlock()) {
			return
		}
		// `takeAll()` 取走并清空待发列表（图片在前、文件在后；附件随消息转移）。
		sendNow(t, attach.takeAll())
	}

	// 真发送（onComposerSend 首发 / onRetry 重发 共用）。
	//  · atts 为空 ⇒ 行为与接入前**逐字相同**（请求体不带 attachments 键，见 chat_api.streamChatOnce）
	//  · includeProfile 恒传 true：它当前**无 UI 消费者**（两枚隐私开关 2026-10-14 因"全仓零读零写"
	//    整行移除，台账 §7.18），保留为契约能力（将来重开开关只改这一处，不动三层链路）。
	//    ⚠️ 不要为它补开关：没有真消费者就是新的空承诺。后端必须真的按它行事
	//    （false ⇒ 不携带画像上下文，见 services/chat_context.py `profile_context`）。
	function sendNow(t: string, atts: Array<ChatAttachment>): void {
		// 兜底重入判定（正常路径已在调用方 busyBlock() 拦过；重试 onRetry 也走这里）
		if (busyBlock()) {
			return
		}
		// 附件已由调用方 `takeAll()` 取走并清空（见 onComposerSend）；重试路径带的是
		// 消息自带的 `m.attachments` —— 附件已落库，content_id 复用不会重复上传/重复计费。
		// ⚠️ 这里**不再清 draft**（2026-10-26）：输入框文本由 AiComposer 自己持有并在 emit 前清空；
		// `draft` 现在只是"预填投放通道"，在这里清它等于把用户刚点开的上下文一并抹掉。
		if (USE_MOCK_CHAT === false) {
			// 真端点（AG6）：本地即时上屏用户消息 + typing 占位，等流式端点回终稿
			// （后端 AG5 已实现：JWT→可信 user_id、反代 Agent、失败返回 502/504 而**不伪造回复**）
			const u2 = mkUser(t, atts)
			const tp2 = mkAi('typing', '正在翻你的回忆', [], [], [], [])
			messages.value.push(u2)
			messages.value.push(tp2)
			scrollToBottom(tp2.id)
			const tpId = tp2.id
			sendChatMessage(conversationId.value, t, atts, true).then((r: ChatSendResult | null) => {
				removeById(tpId)
				// 预览用完即清：它是**模块级共享**状态，留着会让下一轮的占位气泡先闪出上一轮的尾句
				chatStreamText.value = ''
				if (r == null) {
					// **不伪造回复**（项目铁律）：不编假 AI 回复，但必须给用户可操作出口——
					// 插入「发送失败 · 点此重试」卡（2026-10-07 加固），保留原文一键重发；
					// 失败原因仍由 api 层全局 toast（带后端 message）与 Sentry 承担
					const failMsg = mkAi('failed', t, [], [], [], [])
					messages.value.push(failMsg)
					scrollToBottom(failMsg.id)
					return
				}
				if (r.conversationId != '') {
					conversationId.value = r.conversationId
					uni.setStorageSync(CHAT_CONV_KEY, r.conversationId)
				}
				const ai = mkAi(r.reply.kind, r.reply.text, [], r.reply.chips, r.reply.bullets, toMemCards(r.reply.cards))
				// 引用回溯（2026-10-17）：来源条数随消息带上（N=0 时模板不渲染尾注，零视觉副作用）
				ai.sources = r.reply.sources
				// 正文段落（2026-10-25 · task-16 ②）：plain 形态里非列表项的散文，
				// 交给 AiBody 渲染成连续正文（不塞进 bullets ⇒ 不再被切成一条条锈红圆点）
				ai.paragraphs = r.reply.paragraphs
				messages.value.push(ai)
				scrollToBottom(ai.id)
				})
				return
				}
		const u = mkUser(t, atts)
		// 2026-10-11 静态审查 A4：补齐 6 参（签名 (kind,text,cards,chips,bullets,cardList)）。
		// 原为 3 参调用——当前 USE_MOCK_CHAT=false 恒不可达，但一旦翻回 true，
		// 后四参为 undefined，模板 `m.cards.length` 类读取会崩（且 UTS 严格模式下
		// 参数个数不符属编译期错误，是潜伏的"翻转即炸"）。
		const tp = mkAi('typing', '正在翻你的回忆', [], [], [], [])
		messages.value.push(u)
		messages.value.push(tp)
		scrollToBottom(tp.id)
		const replyId = tp.id
		const userId = u.id
		setTimeout(() => {
			removeById(replyId)
			const kind = REPLY_KIND_ROTATION[replyKindIdx.value % REPLY_KIND_ROTATION.length]
			replyKindIdx.value = replyKindIdx.value + 1
			const ai = buildMockReply(kind, userId)
			messages.value.push(ai)
			scrollToBottom(ai.id)
		}, 1800)
	}

	// ── 「新会话」入口（2026-10-26 · AI 页重设计 ②）──
	// ## 改了什么
	// 原来是标题旁一枚 `.chip`「开启新对话」（与副标题同色同层，用户原话「只有一个文字条」），
	// 且**没有确认**：手滑一下就把多轮上下文 silently 丢掉，而界面上什么也没变
	// （本地消息不清）—— 用户无法判断"到底发生了什么"。
	// 现在：标题行右侧独立描边按钮 + 二次确认，确认文案**如实说明**三件事：
	//   ① 旧对话仍留在屏幕上（不是删除）；② 之后的提问不再带旧上下文；③ 不可撤销。
	//
	// ## 语义边界（不变）
	// 仍只清"会话身份"（存储键 + 内存态）—— 下一条消息由后端新建会话。
	// 不动本地已上屏消息（那是用户可见的记录，清了反而像"丢数据"）。
	// 删键用 chat_api 导出的常量（单一来源）；删键后首条消息与 CHAT_003 自愈完全同路。
	function onNewChat(): void {
		if (chatStreamActive.value) {
			// 正在流式生成时开会话：上一轮的终稿回来会写进**新**会话的消息列表里，
			// 表现为"新会话突然多出一段答非所问的回复"。先让这一轮收尾。
			uni.showToast({ title: '正在生成回复，稍等一下', icon: 'none', duration: 1500 })
			return
		}
		uni.showModal({
			title: '开始新会话',
			content: '之后的问题不再带上之前的对话内容。屏幕上已有的对话保留，不会被删除。',
			confirmText: '开始',
			cancelText: '取消',
			success: (res) => {
				if (!res.confirm) {
					return
				}
				uni.removeStorageSync(CHAT_CONV_KEY)
				conversationId.value = ''
				uni.showToast({ title: '已开始新会话', icon: 'none', duration: 1500 })
			}
		})
	}

	// 重试发送（2026-10-07 加固）：撤掉失败卡 → 用原文 + **同一批附件**重发（复用 sendNow）
	function onRetry(m: AiMsg): void {
		const text = m.text
		if (text == '') {
			return
		}
		removeById(m.id)
		sendNow(text, m.attachments)
	}

	// mock 回复生成器（B2 接线后删除）
	function buildMockReply(kind: string, _userId: number): AiMsg {
		if (kind == 'plain') {
			return mkAi('plain', MOCK_PLAIN_TITLE, [], ['那周最开心的事', '生成 9 月计划'], MOCK_PLAIN_BULLETS, [])
		}
		if (kind == 'cards') {
			const i = nextId.value % MOCK_CARD_TITLES.length
			return mkAi('cards', '', [], ['看看那天还在做什么'], [], [new MemCard(MOCK_CARD_TITLES[i], '8月 · 照片', MOCK_IMGS[i % MOCK_IMGS.length]), new MemCard(MOCK_CARD_TITLES[(i + 1) % MOCK_CARD_TITLES.length], '8月 · 文字', MOCK_IMGS[(i + 1) % MOCK_IMGS.length])])
		}
		if (kind == 'confirm') {
			return mkAi('confirm', '要把这条记忆加入本月时间胶囊吗？', [], [], [], [])
		}
		return mkAi('bubble', '翻到了——那天你拍了 4 张照片、留了 1 段 37 秒的语音，都在「湖边」这个主题下面。想听那段语音的转写吗？', [], [], [], [])
	}

	// 结构化卡片 → 视图模型（2026-10-09）：agent 侧 save_memory 的投影，img 可能为空串
	//（文字记忆没有缩略图 ⇒ 模板按空串跳过图片，不渲染占位碎图）
	function toMemCards(list: Array<ChatCard>): Array<MemCard> {
		const out: Array<MemCard> = []
		for (let i = 0; i < list.length; i++) {
			out.push(new MemCard(list[i].title, list[i].meta, list[i].img))
		}
		return out
	}

	// typing 文案逻辑已于 2026-10-25（task-16 ②）迁入 `AiTyping.uvue`：
	// 「预览全文 > 工具阶段 > 等待占位」的三档优先级现在由该组件的 computed 承担
	// （模板里直接绑 `chatStreamText` / `chatStreamTool` 两个模块级 ref）。
	// 原 `typingDisplay(m)` 因此零调用 ⇒ 删除（零调用函数留着只会误导后来者以为还有入口）。

	// 移除 typing 占位（uts 数组无 filter 先例，手写重建最稳）
	function removeById(id: number): void {
		const src = messages.value
		const out: Array<AiMsg> = []
		for (let i = 0; i < src.length; i++) {
			if (src[i].id != id) {
				out.push(src[i])
			}
		}
		messages.value = out
	}

	// 锚点滚动：scroll-into-view 指向最新消息 id（不支持时静默无滚动，不阻塞）
	//
	// 🚨 2026-10-14（台账 §4.20 批次 5 · RC-8）：**只在"锚点未变"时才清空重设**。
	// 原实现无条件 `=''` → 50ms 后设值 ⇒ **每次滚动都两轮布局**，而流式期间滚动很频繁。
	// 而"同值不触发"实际只发生在**同一锚点重复滚**时（打字机气泡长高、消息 id 不变）；
	// 锚点变化（新消息上屏）时直接赋值必然触发，无需清空。
	function scrollToBottom(id: number): void {
		const target = 'msg-' + id
		if (scrollInto.value == target) {
			// 同锚点重复滚：同值不触发 ⇒ 必须"先清再设"（两轮布局不可避免，但已限在此分支）
			scrollInto.value = ''
			setTimeout((): void => {
				scrollInto.value = target
			}, 50)
			return
		}
		// 锚点变化：一次赋值即可（省掉清空与 50ms 延迟）
		scrollInto.value = target
	}

	// 流式预览增长时跟随滚动（2026-10-11 交互审查 B5）：typing 气泡在逐字长高，而滚动
	// 锚点 id 不变 ⇒ 不主动滚，长回复的字会涨到屏幕外（用户感觉"字停住了"）。
	// 节流 400ms：preview 帧可达每秒数十帧，无节流会让 scroll-into-view 高频抖动。
	let lastStreamScrollAt = 0
	watch((): string => chatStreamText.value, (): void => {
		const now = Date.now()
		if (now - lastStreamScrollAt < 400) {
			return
		}
		lastStreamScrollAt = now
		const n = messages.value.length
		if (n > 0) {
			scrollToBottom(messages.value[n - 1].id)
		}
	})

	// chips 点击 = 快捷追问**直接当消息发送**（体验闭环）
	// 2026-10-26：原来走 `draft.value = c; onSend()` —— 即"先塞进输入框再立刻发送"，
	// 中间态没人看得见（输入框已迁到另一个组件）。改为直接调 sendNow，语义更直白；
	// chips 本身就带着完整文本，用户不需要先编辑它（想改的人自己会去输入框打）。
	function onChipTap(c: string): void {
		if (busyBlock()) {
			return
		}
		sendNow(c, attach.takeAll())
	}

	// 空态开场问题（2026-10-26 · AI 页重设计）。三条覆盖三种最常见的真实意图：
	// 时间回溯（去年今日）/ 主题回顾（这个月）/ 具体找东西（语音里说过的）。
	// ⚠️ 文案纪律：这些都是**能问得动**的问题（后端 tools 有对应能力），
	// 不写"AI 懂你的一切"这类承诺；点一下就走同一条 sendNow，**零新链路**。
	const EMPTY_PROMPTS: Array<string> = ['去年今日我在做什么？', '帮我回顾一下这个月', '我说过关于「桂花」的事吗？']

	function onPromptTap(q: string): void {
		if (busyBlock()) {
			return
		}
		sendNow(q, attach.takeAll())
	}

	// 行动确认卡按钮（mock：B2 接线后改 POST 确认接口）
	function onConfirmAction(m: AiMsg, ok: boolean): void {
		if (USE_MOCK_CHAT === false) {
			// 措辞更正（AG6）：智能体**已接入**，未实现的是"确认卡"这条交互流程本身
			// （后端无 chat 域确认端点；确认卡目前只由 mock 生成，见文件头形态④）。
			// 原话"智能体尚未接入"会误导用户以为整个 AI 不可用——失实文案与失实注释同罪。
			uni.showToast({ title: '该操作暂未开放（内测）', icon: 'none', duration: 2500 })
			return
		}
		removeById(m.id)
		if (ok) {
			const ai = mkAi('bubble', '好，已把「湖边晨雾」收进 8 月时间胶囊。', [new MemCard('8 月时间胶囊', '已收录 12 条记忆', MOCK_IMGS[2])], [], [], [])
			messages.value.push(ai)
			scrollToBottom(ai.id)
		}
	}

	// ── 附件操作（2026-10-26 · AI 页重设计 ③）：薄包装，实现全在 useAiAttach.uts ──
	// 为什么包一层而不是模板直接绑 `attach.pickImage`：① 模板里写 `@pick-image="attach.pickImage"`
	// 会丢掉 `this` 绑定（UTS 类方法不是箭头函数）；② 本仓模板入口一律走组件内局部函数
	// （同 useSearchState 的 runSearch 薄包装先例），读起来与其它页一致。
	// 三处要点（都在 composable 里，这里只提醒）：图片先落库拿 contentId 才入列、文件只带
	// 文件名不读内容、**两条选择链都不关附件面板**（关了就看不到刚加的东西 —— 真机原话）。
	function onPickImage(): void {
		attach.pickImage()
	}
	function onPickFile(): void {
		attach.pickFile()
	}
	function onRemoveImage(idx: number): void {
		attach.removeImage(idx)
	}
	function removeFile(idx: number): void {
		attach.removeFile(idx)
	}

	// RecordSheet 保存成功回调（AI 页无可刷新数据，占位收口）
	function onRecordSaved(): void {
	}

	// ── B1 上下文预填接收端（detail 页 askAI 携带当前记忆上下文跳入）──
	// 主控裁决（2026-09-08）：统一走 detail.uvue askAI 的 storage 三键契约（含 content_id 供对话域后续用）：
	//   yishu_ai_context_title（记忆标题）/ yishu_ai_context_body（正文全文）/ yishu_ai_context_content_id（内容 id）
	// 读后即清防陈旧残留；url query 通道（memTitle/memSummary）保留作 manage→theme-detail 同族先例兼容
	const PREFILL_KEY_TITLE = 'memTitle'
	const PREFILL_KEY_SUMMARY = 'memSummary'
	const PREFILL_CTX_TITLE = 'yishu_ai_context_title'
	const PREFILL_CTX_BODY = 'yishu_ai_context_body'
	const PREFILL_CTX_CONTENT_ID = 'yishu_ai_context_content_id'
	const PREFILL_MAX_LEN = 200

	function prefillDraftFrom(title: string, summary: string): void {
		// 参数化签名（B10 P2：url query 解参上收 shell onLoad，双 prop 直传）；
		// 全空时仍走 storage 三键兜底（detail askAI 主通道，与来源无关）
		if (title == '' && summary == '') {
			// storage 三键兜底（detail.uvue askAI 契约，读后即清；JSON.parse 先例 api.uts:530）
			try {
				const ctxTitle = uni.getStorageSync(PREFILL_CTX_TITLE)
				const ctxBody = uni.getStorageSync(PREFILL_CTX_BODY)
				const ctxCid = uni.getStorageSync(PREFILL_CTX_CONTENT_ID)
				const hasCtx = (ctxTitle != null && ctxTitle != '') || (ctxBody != null && ctxBody != '')
					|| (ctxCid != null && ctxCid != '')
				if (hasCtx) {
					title = (ctxTitle != null ? (ctxTitle as string) : '')
					summary = (ctxBody != null ? (ctxBody as string) : '')
					// content_id 暂不入对话 payload（B2 对话域接线时用），先清防残留
					uni.removeStorageSync(PREFILL_CTX_TITLE)
					uni.removeStorageSync(PREFILL_CTX_BODY)
					uni.removeStorageSync(PREFILL_CTX_CONTENT_ID)
				}
			} catch (e) {
				console.log('[dbg-ai] prefill storage parse failed: ' + e)
			}
		}
		if (title == '' && summary == '') {
			return
		}
		let text = ''
		if (title != '') {
			text = '关于「' + title + '」'
			if (summary != '') {
				text = text + '：' + summary
			}
		} else {
			text = summary
		}
		if (text.length > PREFILL_MAX_LEN) {
			text = text.substring(0, PREFILL_MAX_LEN)
		}
		// 投放给输入区组件（2026-10-26）：输入框已迁入 AiComposer，本文件只递增 seq
		seedDraft(text)
	}

	// B10 方案A 组件契约（P2）：options（?memTitle=）与 RecordSheet @saved 上收 shell——
	// prefillTitle/prefillSummary 承接 url query 通道（shell 解参直传；三键 storage 通道本组件直读）；
	// savedSeq 每次记录保存成功 ++（原 onRecordSaved 占位收口语义不变）。
	const props = defineProps({
		prefillTitle: { type: String, default: '' },
		prefillSummary: { type: String, default: '' },
		savedSeq: { type: Number, default: 0 },
		// RC-10（2026-10-14）：shell 每次切到 ai tab 时 ++ —— 回壳改走**栈内回退**后本组件
		// 不再重挂，上下文预填需靠这条"切到本 tab"广播来重读（见下方 watch）。
		shownSeq: { type: Number, default: 0 }
	})
	onMounted((): void => {
		aiAttachOpen.value = false // 原页级初值：进组件即收起
		if (USE_MOCK_CHAT) {
			seedMockMessages()
		} else {
			// 接续上次会话（多轮上下文）；空串 ⇒ 首轮由后端新建会话
			const saved = uni.getStorageSync(CHAT_CONV_KEY) as string
			if (saved != null && saved != '') {
				conversationId.value = saved
				// 2026-09-25（接线补完）：**回填历史**。后端 docstring 明确要求"客户端进入会话时
				// 回填"，而此前只恢复了会话 ID ⇒ 重启后会话虽接续、界面却空白（像丢了历史）。
				// 失败/空保持空列表 —— **不伪造历史**（同 onSend 的失败口径）。
				fetchChatHistory(saved).then((items: Array<ChatHistoryItem> | null) => {
					if (items == null || items.length == 0) {
						return
					}
					const seq: Array<AiMsg> = []
					for (let i = 0; i < items.length; i++) {
						const it = items[i]
						if (it.role == 'user') {
							// 历史条目不回填附件（后端历史契约当前不含 attachments；不回填≠伪造：
							// 附件内容早已作为文本提示并入该轮 AI 上下文，气泡只承载文本）——2026-10-16
							seq.push(mkUser(it.text, []))
						} else {
							// 形态用后端下发的 kind（见 api/chat.py `_kind_for`：bubble | plain | cards）；
							// 未知一律退回 'bubble' —— 不猜 confirm/typing，避免伪造结构。
							// ⚠️ kind=cards 但 cards 为空 ⇒ 退回 'plain'：否则渲染出一个空卡组（看不见内容）。
							const cl = toMemCards(it.cards)
							let k = (it.kind == 'plain' || it.kind == 'bubble' || it.kind == 'cards') ? it.kind : 'bubble'
							if (k == 'cards' && cl.length == 0) {
								k = 'plain'
							}
							seq.push(mkAi(k, it.text, [], it.chips, [], cl))
						}
					}
					messages.value = seq
					scrollToBottom(seq[seq.length - 1].id)
				})
			}
		}
		prefillDraftFrom(props.prefillTitle, props.prefillSummary)
	})
	watch((): number => props.savedSeq, (n: number): void => {
		if (n > 0) {
			onRecordSaved()
		}
	})
	// RC-10 配套（2026-10-14 · 台账 §4.20 批次 5）：切到本 tab 时重读上下文预填三键
	// （由 `detail.askAI` 写入）。为什么必须：回壳由 redirectTo（重建整个壳、本组件随之重挂）
	// 改为**栈内回退**后，本组件不会再挂载 ⇒ 仅靠 onMounted 里那次调用会**漏掉预填**。
	// `prefillDraftFrom('','')` 在无存储时早退，故本 watch 幂等（不会覆盖用户草稿）。
	watch((): number => props.shownSeq, (): void => {
		prefillDraftFrom('', '')
	})
</script>

<style>
	@import '@/styles/tab-ai.css';
</style>

<template>
	<!-- B10 方案A 金丝雀：自 pages/profile/profile.uvue 整体搬迁（模板/样式零改动；TabBar/RecordSheet 挂载上收 shell，离页停播按拍板项 2 退役，处置记录见台账 §EE） -->
<!-- ardot 直转 v2：我的页（帧 2:448）· 审计化生成 -->
	<view class="profile-root tk-root">
		<view class="n2_452"> <!-- 头像 -->
			<text class="n2_453">峰</text> <!-- 头像字 -->
		</view>
		<text class="n2_454">峰宝</text> <!-- 昵称 -->
		<text class="n2_455">已记录 {{ statMemories }} 段回忆</text> <!-- 签名行（修复：原硬编码"128 段 · 连续 6 天"，改真数据） -->
		<view class="n2_456"> <!-- 统计卡（修复：三个数字原硬编码 128/42/23，接 GET /contents 真数据） -->
			<view class="n2_457"> <!-- 统计-回忆 -->
				<text class="n2_458">{{ statMemories }}</text> <!-- 数 -->
				<text class="n2_459">回忆</text> <!-- 名 -->
			</view>
			<view class="n2_460"> <!-- 统计-照片 -->
				<text class="n2_461">{{ statPhotos }}</text> <!-- 数 -->
				<text class="n2_462">照片</text> <!-- 名 -->
			</view>
			<view class="n2_463"> <!-- 统计-语音 -->
				<text class="n2_464">{{ statVoices }}</text> <!-- 数 -->
				<text class="n2_465">语音</text> <!-- 名 -->
			</view>
		</view>
		<view class="list-flow"> <!-- 列表流式容器（流式重构三定律：组间 margin 表达画布 y 差，加行/加组自动下移，不再写死 top） -->
			<view class="n2_466"> <!-- 列表组1 -->
				<!-- task-21 第 6 条（信息架构 · 高频前置）：原顺序为
				     记忆访谈 / 我的记忆画像 / 画像设置 / **我的收藏** / 消息中心。
				     实测不合理：「我的收藏」是**查阅**类高频入口（用户会反复回来翻），
				     而「画像设置」是**配置**类低频入口（改一次就很少再进）。
				     把低频配置夹在两个高频查阅入口中间，等于每次找收藏都要先跨过设置。
				     现顺序（语义分层：访谈 → 查阅 → 配置 → 消息）：
				       记忆访谈 / 我的记忆画像 / **我的收藏** / 画像设置 / 消息中心
				     只调整顺序、不动任何样式与 handler（`@tap` 原样跟随）。 -->
				<view class="n2_467" @tap="goInterview"> <!-- 行-记忆访谈（旧版入口在还原中丢失，对齐旧版 profile goInterview() 补回；样式复用 467 行） -->
					<image class="n2_468" src="/static/icons/i2_468a.svg" /> <!-- icon: 麦克风（§P8 峰宝点名图标重复：访谈=麦） -->
					<text class="n2_472">记忆访谈</text> <!-- 文字 -->
					<image class="n2_473" src="/static/icons/i2_473.svg" /> <!-- icon: 箭头 -->
				</view>
				<!-- 2026-10-25 · 层级优化（用户真机：「画像详情页压根没有点开详情页的入口」）：
				     原为**一行**「画像管理」→ pages/portrait/manage，而画像详情页
				     （`pages/portrait/detail`）的**全仓唯一入口**是 manage 页里那张画像卡，
				     于是到详情页要：我的(0) → 画像管理行(1) → manage页(2) → 画像卡(3) → detail。
				     现拆成两行（视觉零新造：全部复用 .n2_467/.n2_468/.n2_472/.n2_473）：
				       · 「我的记忆画像」→ **直达 detail**，我的→详情 = **1 次点击**；
				       · 「画像设置」→ 原 manage 页（刷新/编辑标签/隐私设置在那边，语义不变）。
				     为什么不合并成一个入口：detail 是"看画像"，manage 是"改画像"，
				     两者用户意图不同；合并会把设置项埋进只读页，反而新增一次跳转。 -->
				<view class="n2_467" @tap="goProfileDetail"> <!-- 行-我的记忆画像（直达详情） -->
					<image class="n2_468" src="/static/icons/profile-info.svg" /> <!-- icon: 画像信息（既有未引用图标，同琥珀族） -->
					<text class="n2_472">我的记忆画像</text> <!-- 文字 -->
					<image class="n2_473" src="/static/icons/i2_473.svg" /> <!-- icon: 箭头 -->
				</view>
				<view class="n2_467" @tap="goFavorites"> <!-- 行-我的收藏（峰宝联调点名 2026-09-02：goFavorites 接线早已落盘但模板漏行，补入口；样式复用 467 行族） -->
					<image class="n2_468" src="/static/icons/i2_468b.svg" /> <!-- icon: 空心星（§P8 峰宝点名图标重复：收藏=星） -->
					<text class="n2_472">我的收藏</text> <!-- 文字 -->
					<image class="n2_473" src="/static/icons/i2_473.svg" /> <!-- icon: 箭头 -->
				</view>
				<view class="n2_467" @tap="goPortraitManage"> <!-- 行-画像设置（原「画像管理」，指向 manage 页） -->
					<image class="n2_468" src="/static/icons/i2_468.svg" /> <!-- icon: 图标 -->
					<text class="n2_472">画像设置</text> <!-- 文字 -->
					<image class="n2_473" src="/static/icons/i2_473.svg" /> <!-- icon: 箭头 -->
				</view>
				<view class="n2_475" @tap="goMessagesCenter"> <!-- 行-消息中心 -->
					<image class="n2_476" src="/static/icons/i2_476.svg" /> <!-- icon: 图标 -->
					<text class="n2_478">消息中心</text> <!-- 文字 -->
					<image class="n2_479" src="/static/icons/i2_479.svg" /> <!-- icon: 箭头 -->
				</view>
			</view>
			<view class="n2_481"> <!-- 列表组2（margin-top 73.1rpx = 画布组间距 38px，跟组1底部走） -->
				<view class="n2_482" @tap="goSettings"> <!-- 行-设置 -->
					<image class="n2_483" src="/static/icons/i2_483.svg" /> <!-- icon: 图标 -->
					<text class="n2_486">设置</text> <!-- 文字 -->
					<image class="n2_487" src="/static/icons/i2_487.svg" /> <!-- icon: 箭头 -->
				</view>
				<view class="n2_489" @tap="goStorageBackup"> <!-- 行-存储与备份（W0-4 错绑修复：原误绑 goPrivacy，audit F2 实锤） -->
					<image class="n2_490" src="/static/icons/i2_490.svg" /> <!-- icon: 图标 -->
					<text class="n2_493">存储与备份</text> <!-- 文字 -->
					<image class="n2_494" src="/static/icons/i2_494.svg" /> <!-- icon: 箭头 -->
				</view>
				<view class="n2_496" @tap="goAbout"> <!-- 行-关于 -->
					<image class="n2_550" src="/static/icons/i2_550.svg" /> <!-- icon: 关于图标 -->
					<text class="n2_501">关于忆述光华</text> <!-- 文字 -->
					<image class="n2_502" src="/static/icons/i2_502.svg" /> <!-- icon: 箭头 -->
				</view>
			</view>
		</view>

	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted, watch } from 'vue'
	import { requestShellTab } from '@/utils/shell_state'
	import { fetchRecentContents } from '@/utils/search_api'

	// ===== 设计稿图标（已落成 /static/icons/*.svg 静态资源） =====

	// TabBar 图标（我的=激活态锈红；其余=常态灰）


	// ===== 统计真数据（P2：接 GET /contents；57 条以内一次拉全，MVP 够用） =====
	let statMemories = ref(0)
	let statPhotos = ref(0)
	let statVoices = ref(0)

	// B10 方案A 组件契约：shownSeq 每次切到本 tab ++（原页级 onShow 等价恢复——统计需随
	// 新记录刷新，数据常驻但计数重拉）；savedSeq 记录保存成功 ++（原 RecordSheet @saved）。
	const props = defineProps({
		shownSeq: { type: Number, default: 0 },
		savedSeq: { type: Number, default: 0 }
	})
	// 2026-10-14（台账 §4.20 批次 5 · RC-4）：**切 tab 加 60s TTL**。
	// 原实现每次切到「我的」tab 都 `loadProfileStats()` ⇒ `fetchRecentContents(100, [])`
	// ——**一次拉 100 条内容重算全部统计**。用户在四个 tab 间来回点，就是连续打接口 +
	// 每次重算（掉帧）。口径与 `TabIndex` 的 `SHOW_REFRESH_TTL`（60000）一致：TTL 内切回不重拉。
	// 注意：记录保存成功（`savedSeq` → `onRecordSaved`）走的是**直调** `loadProfileStats()`，
	// 不受本 TTL 影响——保存后必须立刻反映新数据。
	const PROFILE_TTL: number = 60000
	let lastLoadMs = 0
	// 2026-10-16（批次 6 · RC-4 续）：**脏标记**——区分「时间到了」（TTL）与「**事实变了**」。
	// 来源有二：① 持久缓存过旧/无时间戳（见 restoreProfileStats：数字仍回放，但必须忽略 TTL 重拉）；
	// ② 记录保存成功（savedSeq）。两者都必须能**越过 TTL** 立即重拉，否则会出现
	// 「保存了但 60s 内切回「我的」看到的还是旧计数」。
	let statsDirty = false
	function loadProfileStatsIfStale(): void {
		const now = Date.now()
		// 脏 ⇒ 忽略 TTL（事实过期优先于时间过期）；不脏且 TTL 内 ⇒ 沿用已有数据（不闪、不打接口）
		if (!statsDirty && lastLoadMs != 0 && now - lastLoadMs < PROFILE_TTL) {
			return
		}
		lastLoadMs = now
		statsDirty = false // 已发起重拉即清脏（失败也不空转；下次 TTL 到期再拉）
		loadProfileStats()
	}
	// 2026-10-14（台账 §4.20 · 用户反馈"每次跳转都要等数据"）：**统计数字持久缓存**。
	// 原实现切到「我的」时三个统计从初值起、要等 `fetchRecentContents(100, [])` 回来才有数字
	// （用户感知"先空一会"）。现进入先用上次计数渲染（秒出），再由 `loadProfileStats` 覆盖。
	// 只存 3 个整数——**无用户文本、无序列化风险**；读写失败一律静默（绝不因缓存影响主流程）。
	const PROFILE_STATS_KEY = 'yishu_profile_stats'
	// 2026-10-16（批次 6 · RC-4 续）：**缓存写入时刻一并持久化**（第 4 段）。
	// 为什么：原缓存**不看年龄**就回放 —— 隔一天再打开，「我的」先显示**昨天的数字**（陈旧却像真的）。
	// 现：新鲜（≤ PROFILE_TTL）→ 正常回放 + 不脏；过旧/无时间戳（旧格式 3 段）→ **仍回放**
	// （避免"先空一会"的老问题回归）但**置脏** ⇒ 忽略 TTL 立即重拉，数字被真实值覆盖。
	function restoreProfileStats(): void {
		try {
			const raw = uni.getStorageSync(PROFILE_STATS_KEY) as string
			if (raw == '') {
				return
			}
			const parts = raw.split(',')
			if (parts.length != 3 && parts.length != 4) {
				return
			}
			statMemories.value = parseInt(parts[0])
			statPhotos.value = parseInt(parts[1])
			statVoices.value = parseInt(parts[2])
			let fresh = false
			if (parts.length == 4) {
				const ts = parseInt(parts[3])
				fresh = ts > 0 && Date.now() - ts <= PROFILE_TTL
			}
			statsDirty = !fresh
			console.log('[dbg-profile] 统计缓存回放: fresh=' + fresh + ' 置脏=' + statsDirty)
		} catch (e) {
			console.log('[dbg-profile] 统计缓存回放失败（忽略）: ' + e)
		}
	}
	function persistProfileStats(): void {
		try {
			uni.setStorageSync(PROFILE_STATS_KEY,
				'' + statMemories.value + ',' + statPhotos.value + ',' + statVoices.value + ',' + Date.now())
		} catch (e) {
			console.log('[dbg-profile] 统计缓存写入失败（忽略）: ' + e)
		}
	}
	onMounted((): void => {
		restoreProfileStats()
		loadProfileStatsIfStale()
	})
	watch((): number => props.shownSeq, (n: number): void => {
		if (n > 0) {
			loadProfileStatsIfStale()
		}
	})
	watch((): number => props.savedSeq, (n: number): void => {
		if (n > 0) {
			onRecordSaved()
		}
	})

	function loadProfileStats(): void {
		fetchRecentContents(100, []).then((out) => {
			if (out == null) {
				return
			}
			let photos = 0
			let voices = 0
			for (let i = 0; i < out.hits.length; i++) {
				const t = out.hits[i].contentType
				if (t == 'photo') {
					photos++
				} else if (t == 'voice') {
					voices++
				}
			}
			statMemories.value = out.hits.length
			statPhotos.value = photos
			statVoices.value = voices
			persistProfileStats()
		})
	}

	// ===== 交互 =====
	// 类型入口（照片/语音/文字）
	function goType(type: string): void {
		requestShellTab('search', 'type=' + type) // B10 P2：壳内零销毁切 tab（原 navigateTo 壳）
	}

	// RecordSheet 保存成功回调（统计数字随之刷新）
	// 2026-10-16（批次 6 · RC-4 续）：改走 `loadProfileStatsIfStale()` + **脏标记** ——
	// 保存 = **事实变了**（不是"时间到了"），必须越过 TTL 立即重拉；同时清脏，避免下一次
	// 切 tab 因为脏标记又白拉一次。行为与原来"直调 loadProfileStats()"等价（都是立即拉）。
	function onRecordSaved(): void {
		statsDirty = true
		loadProfileStatsIfStale()
	}

	// 菜单：记忆访谈（旧版 profile 页 goInterview() 入口，画布直转时整段丢失 → 对齐旧版补回）
	function goInterview(): void {
		uni.navigateTo({ url: '/pages/interview/interview' })
	}

	// 菜单：我的画像（**设置**语义：刷新画像 / 编辑标签 / 隐私设置在 manage 页）
	function goPortraitManage(): void {
		uni.navigateTo({ url: '/pages/portrait/manage' })
	}

	// 菜单：我的记忆画像（**查看**语义：直达画像详情页 · 2026-10-25 层级优化）
	// 为什么单开一行：`pages/portrait/detail` 此前全仓唯一入口是 manage 页的画像卡，
	// 到详情要 3 次点击；直达后 1 次。detail 页 `onLoad` 无必填参数（实测只读自身数据）
	// ⇒ 可直接 navigateTo，不需要经 manage 中转。
	function goProfileDetail(): void {
		uni.navigateTo({ url: '/pages/portrait/detail' })
	}

	// 菜单：我的收藏（卡16 集成接线，主窗口 2026-09-02：收藏页已建成，toast 占位退役）
	function goFavorites(): void {
		uni.navigateTo({ url: '/pages/favorites/favorites' })
	}

	// 菜单：设置 ⇒ **直达账号与安全**（2026-10-15 · 真机反馈「点设置为什么中间还要有一页」：
	// 原路径是 我的 → settings（仅两行）→ account/security，白多一次跳转；
	// 现按用户口径直连，settings 页随之退役（见台账 §7.30））
	function goSettings(): void {
		uni.navigateTo({ url: '/pages/account/security' })
	}

	// 菜单：存储与备份（W0-4 错绑修复：原 goPrivacy 误绑此行；W1-1 页面已落地改真跳转）
	function goStorageBackup(): void {
		uni.navigateTo({ url: '/pages/storage/storage' })
	}

	// 菜单：关于我们（W1-2 页面已落地改真跳转）
	function goAbout(): void {
		uni.navigateTo({ url: '/pages/about/about' })
	}


	// ardot 直转接线：消息中心入口
	function goMessagesCenter(): void {
		uni.navigateTo({ url: '/pages/messages/messages' })
	}
</script>

<style>

	.profile-root {
		flex: 1;
		flex-direction: column;
		font-family: "Sarasa Gothic SC", sans-serif;
		background-color: var(--c-paper-100, #F8F7F4);
	}
	/* 列表流式容器：组1/组2 依次入流，组间距 margin 表达（画布组1 y=250px=480.8rpx、组间距 38px=73.1rpx）。
	   头部四块（头像/昵称/签名/统计卡）为静态内容保留 absolute 定位，不参与流。 */
	.list-flow {
		margin-top: var(--d-lattice-p250, 480.8rpx);
		padding-left: var(--d-card_margin_x, 38.5rpx);
		padding-right: var(--d-card_margin_x, 38.5rpx);
		flex-direction: column;
	}
	.n2_452 {
		position: absolute;
		/* absolute-ok: 静态头部·头像（内容永不增长，画布锚点） */
		left: var(--d-card_margin_x, 38.5rpx);
		top: var(--d-lattice-p64, 123.1rpx);
		width: var(--d-lattice-p64, 123.1rpx);
		height: var(--d-lattice-p64, 123.1rpx);
		flex-direction: row;
		justify-content: center;
		align-items: center;
		background-color: var(--c-amber-500, #C4913C);
		border-radius: var(--d-lattice-p32, 61.5rpx);
		overflow: hidden;
	}
	.n2_453 {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: 600;
		font-size: var(--d-lattice-p24, 46.2rpx);
		color: var(--c-white, #FFFFFF);
	}
	.n2_454 {
		position: absolute;
		/* absolute-ok: 静态头部·昵称（同上） */
		left: var(--d-lattice-p98, 188.5rpx);
		top: var(--d-lattice-p72, 138.5rpx);
		width: var(--d-status_bar_height, 84.6rpx);
		height: 51.9rpx;
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: bold;
		font-size: var(--d-lattice-p22, 42.3rpx);
		color: var(--c-ink-900, #3A2E25);
	}
	.n2_455 {
		position: absolute;
		/* absolute-ok: 静态头部·签名行（同上） */
		left: var(--d-lattice-p98, 188.5rpx);
		top: var(--d-lattice-p104, 200rpx);
		width: var(--d-lattice-p192, 369.2rpx);
		height: var(--d-lattice-p15, 28.8rpx);
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: var(--d-card_radius_small, 23.1rpx);
		/* task-21 第 8 条：签名行 ink-500 对 paper-100 = 3.86:1（AA 需 4.5）⇒ ink-700 7.71:1。
		   这行是「已记录 N 段回忆」—— 用户判断"我这个 App 里到底有多少东西"的第一眼数据，
		   读不清会直接怀疑数据是不是没存上。 */
		color: var(--c-ink-700, #5A4C40);
	}
	.n2_456 {
		position: absolute;
		/* absolute-ok: 静态头部·统计卡（同上） */
		left: var(--d-card_margin_x, 38.5rpx);
		top: var(--d-lattice-p152, 292.3rpx);
		width: var(--d-card_width, 673.1rpx);
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-left: var(--d-lattice-p18, 34.6rpx);
		padding-right: var(--d-lattice-p18, 34.6rpx);
		padding-top: var(--d-lattice-p18, 34.6rpx);
		padding-bottom: var(--d-lattice-p18, 34.6rpx);
		background-color: var(--c-white, #FFFFFF);
		box-shadow: var(--d-lattice-p0, 0rpx) var(--d-lattice-p3, 5.8rpx) var(--d-card_radius_small, 23.1rpx) var(--a-ink-05, rgba(59, 46, 38, 0.05));
		border-radius: var(--d-card_margin_x, 38.5rpx);
		overflow: hidden;
	}
	.n2_457 {
		flex-direction: column;
		overflow: hidden;
	}
	.n2_458 {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-weight: bold;
		font-size: var(--d-lattice-p22, 42.3rpx);
		color: var(--c-ink-900, #3A2E25);
	}
	.n2_459 {
		font-family: "Sarasa Gothic SC", sans-serif;

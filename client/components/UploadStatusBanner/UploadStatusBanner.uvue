<template>
	<!-- 同步状态横幅（B4 §7 · Wave3 Agent H）：
	     待上传图标 / 失败标红可点击重试 / 暂停横幅"网络异常，已暂停同步" / 一键继续上传。
	     自包含：直接读 sync_client + uploader 模块状态，宿主页只需一行 <UploadStatusBanner />。
	     优先级：暂停 > 蜂窝暂缓原图 > 失败可重试 > 上传中。 -->
	<view v-if="show" class="banner" :class="bannerClass">
		<view class="banner-main" @tap="onBannerTap">
			<text class="banner-icon">{{ icon }}</text>
			<text class="banner-text">{{ text }}</text>
		</view>
		<view v-if="showAction" class="banner-action" @tap="onActionTap">
			<text class="banner-action-text">{{ actionText }}</text>
		</view>
	</view>
</template>

<script lang="uts">
	import { subscribeSyncStatus, isSyncPaused, getPauseReason, resumeSync } from '@/utils/sync_client'
	import { heldCount, failedCount, continuePendingUploads, getNetKind, NetKind } from '@/utils/uploader'

	export default {
		emits: ['continue-upload', 'retry-failed', 'upload-original'],
		data() {
			return {
				paused: false,
				pauseReason: '',
				held: 0,
				failed: 0,
				uploading: false,
				netKind: 'unknown' as NetKind,
				refresher: 0
			}
		},
		computed: {
			show(): boolean {
				return this.paused || this.held > 0 || this.failed > 0 || this.uploading
			},
			bannerClass(): string {
				if (this.paused) {
					return 'banner-paused'
				}
				if (this.held > 0) {
					return 'banner-held'
				}
				if (this.failed > 0) {
					return 'banner-failed'
				}
				return 'banner-uploading'
			},
			icon(): string {
				if (this.paused) {
					return '⏸'
				}
				if (this.held > 0) {
					return '📤'
				}
				if (this.failed > 0) {
					return '⚠️'
				}
				return '⏳'
			},
			text(): string {
				if (this.paused) {
					return this.pauseReason != '' ? this.pauseReason : '网络异常，已暂停同步'
				}
				if (this.held > 0) {
					if (this.netKind == 'wifi') {
						return this.held + ' 张照片待上传（原图）'
					}
					return this.held + ' 张照片待 WiFi 上传（蜂窝仅传缩略图+元数据）'
				}
				if (this.failed > 0) {
					return this.failed + ' 张照片上传失败，点击重试'
				}
				return '正在上传…'
			},
			showAction(): boolean {
				return this.paused || this.held > 0 || this.failed > 0
			},
			actionText(): string {
				if (this.paused) {
					return '继续上传'
				}
				if (this.held > 0 && this.netKind != 'wifi') {
					return '立即上传原图'
				}
				return '重试'
			}
		},
		mounted() {
			// 订阅暂停状态（sync_client 推送）+ 3s 轮询数量（uni storage 读，开销可忽略）
			subscribeSyncStatus((paused: boolean, reason: string) => {
				this.paused = paused
				this.pauseReason = reason
			})
			this.refresh()
			this.refresher = setInterval(() => {
				this.refresh()
			}, 3000)
		},
		beforeUnmount() {
			if (this.refresher != 0) {
				clearInterval(this.refresher)
				this.refresher = 0
			}
		},
		methods: {
			refresh(): void {
				this.paused = isSyncPaused()
				this.pauseReason = getPauseReason()
				this.held = heldCount()
				this.failed = failedCount()
				getNetKind((kind: NetKind) => {
					this.netKind = kind
				})
			},
			onBannerTap(): void {
				// 失败标红可点击重试（整条可点）
				if (this.failed > 0 && !this.paused) {
					this.doContinue('retry-failed')
				}
			},
			onActionTap(): void {
				if (this.paused) {
					this.doContinue('continue-upload')
				} else if (this.held > 0 && this.netKind != 'wifi') {
					this.doContinue('upload-original')
				} else {
					this.doContinue('retry-failed')
				}
			},
			/** 一键继续：解除暂停 + 上传 held/failed（原图模式） */
			doContinue(evt: string): void {
				this.uploading = true
				this.$emit(evt)
				continuePendingUploads(() => {
					this.uploading = false
					this.refresh()
				}).then(() => {
					this.uploading = false
					this.refresh()
				})
			}
		}
	}
</script>

<style>
	.banner {
		margin-left: 32rpx;
		margin-right: 32rpx;
		margin-top: 16rpx;
		border-radius: 12rpx;
		padding: 20rpx 28rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.banner-paused {
		background-color: #B05A3A;
	}
	.banner-held {
		background-color: #3A2E25;
	}
	.banner-failed {
		background-color: #B05A3A;
	}
	.banner-uploading {
		background-color: #3A2E25;
		opacity: 0.85;
	}
	.banner-main {
		flex: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.banner-icon {
		color: #F6F1E7;
		font-size: 30rpx;
		margin-right: 16rpx;
	}
	.banner-text {
		color: #F6F1E7;
		font-size: 26rpx;
		flex: 1;
	}
	.banner-action {
		margin-left: 20rpx;
		padding-left: 28rpx;
		padding-right: 28rpx;
		padding-top: 10rpx;
		padding-bottom: 10rpx;
		background-color: #FBF7EF;
		border-radius: 28rpx;
	}
	.banner-action-text {
		color: #B05A3A;
		font-size: 24rpx;
		font-weight: bold;
	}
</style>

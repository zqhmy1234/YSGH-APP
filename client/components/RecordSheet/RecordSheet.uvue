<template>
	<view class="page">
		<!-- ═══════════ 模态遮罩（55% 暗色，压暗真实页面） ═══════════
		     点遮罩 = 关闭浮层（原独立页无此交互，浮层化后必须补，否则只能靠系统返回键） -->
		<view class="scrim" @tap="onClose"></view>

		<!-- ═══════════ 底部弹层：新的记忆（设计稿默认态） ═══════════ -->
		<view class="sheet">
			<view class="grab"></view>
			<text class="sheet-title">新的记忆</text>
			<view class="sheet-options">
				<view class="option" @tap="openMode('photo')">
					<view class="option-circle c-photo">
						<image class="option-icon icon-camera" src="/static/icons/record-camera.svg" />
					</view>
					<text class="option-label">拍照</text>
				</view>
				<view class="option" @tap="openMode('gallery')">
					<view class="option-circle c-gallery">
						<image class="option-icon icon-gallery" src="/static/icons/record-gallery.svg" />
					</view>
					<text class="option-label">选照片</text>
				</view>
				<view class="option" @tap="openMode('voice')">
					<view class="option-circle c-voice">
						<image class="option-icon icon-mic" src="/static/icons/record-mic.svg" />
					</view>
					<text class="option-label">说一段</text>
				</view>
				<view class="option" @tap="openMode('text')">
					<view class="option-circle c-text">
						<image class="option-icon icon-keyboard" src="/static/icons/record-keyboard.svg" />
					</view>
					<text class="option-label">写几句</text>
				</view>
			</view>
			<view class="home-indicator"></view>
			<text class="sheet-hint">长按 + 可直达完整记录表单</text>
		</view>

		<!-- ═══════════ 功能层：选中入口后的记录表单 ═══════════ -->
		<view v-if="formMode != ''" class="form-layer">
			<view class="form-head">
				<view class="form-back" @tap="closeForm">
					<text class="form-back-text">‹</text>
				</view>
				<text class="form-title serif">{{ formTitle }}</text>
				<view class="form-save" @tap="onSave">
					<text class="form-save-text">{{ saveText }}</text>
				</view>
			</view>
			<scroll-view class="form-scroll">
				<!-- 文字入口 -->
				<view v-if="formMode == 'text'" class="form-body">
					<textarea class="text-input serif" v-model="draft" placeholder="此刻在想什么？记下来…" :maxlength="2000" />
					<view class="text-actions">
						<text class="muted">分类：{{ classifyLabel }}</text>
					</view>
					<view v-if="classifyLabel != '' && classifyLabel != '整理中…'" class="tag-row">
						<text class="tag-hint">分类不对？点标签纠正：</text>
						<view class="tag-list">
							<view v-for="t in allLabels" :key="t.key" class="tag" :class="t.key === currentLabel ? 'tag-active' : ''" @tap="onTagTap(t.key)">
								<text class="tag-text" :class="t.key === currentLabel ? 'tag-active-text' : ''">{{ t.cn }}</text>
							</view>
						</view>
					</view>
				</view>
				<!-- 语音入口 -->
				<view v-else-if="formMode == 'voice'" class="form-body">
					<view class="record-box">
						<view class="mic-btn" :class="recording ? 'mic-recording' : ''" @tap="toggleRecord">
							<text class="mic-icon">{{ recording ? '⏹' : '🎤' }}</text>
						</view>
						<text class="record-hint">{{ recordHint }}</text>
						<text v-if="recording" class="record-timer">{{ recordSeconds }}s</text>
						<view v-if="recording && (recState === 'interrupted' || recState === 'paused')" class="interrupt-bar">
							<text class="interrupt-text">{{ recState === 'interrupted' ? '录音被来电/系统中断，已暂停' : '已暂停' }}</text>
							<view class="resume-btn" @tap="resumeRecordNow">
								<text class="resume-text">继续录音</text>
							</view>
						</view>
					</view>
					<view v-if="transcribing" class="center-box">
						<text class="muted">正在转写…</text>
					</view>
					<!-- D-08（09-01）：转写失败段重试条（录音已持久保留，跨重启找回） -->
					<view v-else-if="retryVoicePath != ''" class="interrupt-bar">
						<text class="interrupt-text">转写失败，录音已保留在本地</text>
						<view class="resume-btn" @tap="retryTranscribe">
						<text class="resume-text">重试转写</text>
						</view>
					</view>
					<view v-else-if="transcript != ''" class="transcript-box">
						<view class="transcript-head">
							<text class="transcript-title serif">转写结果</text>
							<text v-if="emotion != ''" class="emotion-chip">情绪：{{ emotion }}</text>
						</view>
						<view v-if="voiceHints != ''" class="voice-hints">
							<text class="muted">{{ voiceHints }}</text>
						</view>
						<textarea class="text-input serif" v-model="transcript" :maxlength="2000" />
						<view class="text-actions">
							<text class="muted">{{ guardMsg }}</text>
						</view>
					</view>
				</view>
				<!-- 照片 / 相册入口 -->
				<view v-else class="form-body">
					<view class="photo-box" @tap="pickPhoto">
						<image v-if="photoPreview != ''" class="photo-preview" :src="photoPreview" mode="aspectFill" />
						<view v-else class="photo-empty">
							<image class="photo-empty-icon" src="/static/icons/record-camera-gray.svg" />
							<text class="photo-empty-text">{{ formMode == 'photo' ? '点击拍照' : '点击从相册选择' }}</text>
						</view>
					</view>
					<textarea class="text-input serif" v-model="draft" placeholder="补充一句此刻的感想（可选）" :maxlength="500" />
					<view class="text-actions">
						<text class="muted">拍摄或选择后点保存，将上传到你的记忆库</text>
					</view>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
	// ⚠️ 不要 import 生命周期：uni-app x 规定 ref/computed/onLoad/onMounted 等由框架自动引入，
	// 手写 `import { onMounted } from '@dcloudio/uni-app'` 会编译失败
	// （真机实锤 2026-08-31："onMounted" is not exported by "@dcloudio/uni-app/dist-x/uni-app.es.js"）。
	import { ensureLogin } from '@/utils/auth'
	import { labelCn, createTextContent, submitClassify, pollClassify, submitCorrection, submitArbitrate, pollArbitrate, ALL_LABELS } from '@/utils/text_recorder'
	import {
		startRecord,
		stopRecord,
		resumeRecord,
		setShouldResume,
		recorderState,
		transcribeWav,
		saveVoiceContent,
		uploadVoicePersistent,
		addPendingTranscription,
		clearPendingTranscription,
		loadPendingTranscriptions,
		REC_STATE_PAUSED
	} from '@/utils/voice'
	import { showErrorToast } from '@/utils/api'
	import { uploadBatch, UploadProgress, UploadedPhoto } from '@/utils/uploader'
	import { PhotoItem } from '@/uni_modules/yishu-photo-watch/utssdk/app-android/index.uts'

	// ===== 对外事件 =====
	// 浮层化后（2026-08-31 峰宝拍板）：记录面板 = 全局浮层，不是页面。
	// 关闭由宿主页决定（<RecordSheet v-if="sheetOpen" @close="sheetOpen=false" />）
	const emit = defineEmits(['close', 'saved'])

	// ===== 响应式数据 =====
	// 弹层 / 表单状态
	let formMode = ref('')
	let formTitle = ref('写几句')
	let saveText = ref('记下来')
	let photoPreview = ref('')
	let photoSize = ref(0)
	let photoUploading = ref(false)
	// 文字记录
	let draft = ref('')
	let submitting = ref(false)
	let classifyLabel = ref('')
	let currentLabel = ref('')
	let lastContentId = ref('')
	let lastText = ref('')
	let allLabels = ref(ALL_LABELS)
	// 语音记录
	let recording = ref(false)
	let recordSeconds = ref(0)
	let recordTimer = ref(0)
	let recState = ref('idle')
	let recordHint = ref('点击开始录音（≤30 分钟）')
	let voiceHints = ref('')
	let transcribing = ref(false)
	let transcript = ref('')
	let emotion = ref('')
	let guardMsg = ref('')
	let saving = ref(false)
	let lastVoiceDuration = ref(0)
	let lastVoiceFile = ref('')
	let retryVoicePath = ref('') // D-08：转写失败段重试入口

	// ===== 生命周期（组件化：onLoad/onUnload → onMounted/onUnmounted） =====
	onMounted(() => {
		ensureLogin().then((ok: boolean) => {
			if (!ok) {
				showErrorToast(new Error('登录失败，请重试'))
			}
		})
		// D-08（09-01）：跨重启找回失败段（队列持久于 prefs，不随组件销毁）
		const pend = loadPendingTranscriptions()
		if (pend.length > 0) {
			const p0 = pend[0].getString('path') ?? ''
			if (p0 != '') {
				retryVoicePath.value = p0
				lastVoiceFile.value = p0
				lastVoiceDuration.value = (pend[0].getNumber('duration_ms') ?? 0)
				voiceHints.value = '发现未转写录音 ' + pend.length + ' 段，可点「重试转写」'
			}
		}
	})
	onUnmounted(() => {
		if (recordTimer.value > 0) {
			clearInterval(recordTimer.value)
			recordTimer.value = 0
		}
	})

	// ===== 浮层整体关闭（点遮罩 / 宿主页调用） =====
	function onClose(): void {
		// 铁律 11：closeForm 曾因 stopRecord 抛异常导致状态永不复位 → 此处同样无条件通知宿主页
		try {
			if (recording.value) {
				stopRecordNow()
			}
		} catch (e) {
			console.log('[yishu] onClose 停止录音失败（忽略，仍强制关闭浮层）: ' + e)
		}
		formMode.value = ''
		emit('close')
	}

	// ===== 弹层交互 =====
	function openMode(m: string): void {
		formMode.value = m
		if (m == 'photo') {
			formTitle.value = '拍照'
			saveText.value = '保存'
		} else if (m == 'gallery') {
			formTitle.value = '选照片'
			saveText.value = '保存'
		} else if (m == 'voice') {
			formTitle.value = '说一段'
			saveText.value = '确认入库'
		} else {
			formTitle.value = '写几句'
			saveText.value = '记下来'
		}
	}
	function closeForm(): void {
		// 录音中返回弹层：停止录音，避免后台空转
		// 铁律：formMode 必须**无条件**复位——原生插件抛异常曾导致「录音中关不掉表单、出不去」
		try {
			if (recording.value) {
				stopRecordNow()
			}
		} catch (e) {
			console.log('[yishu] closeForm 停止录音失败（忽略，仍强制关闭表单）: ' + e)
		}
		formMode.value = ''
	}
	function onSave(): void {
		if (formMode.value == 'text') {
			submitText()
		} else if (formMode.value == 'voice') {
			submitVoice()
		} else {
			savePhoto()
		}
	}

	// ===== 照片 / 相册（uni.chooseImage，保存后端待接入 → 仅本地预览提示） =====
	function pickPhoto(): void {
		const srcs: Array<string> = formMode.value == 'photo' ? ['camera'] : ['album']
		uni.chooseImage({
			count: 1,
			sourceType: srcs,
			success: (res) => {
				const tp = res.tempFilePaths[0]
				if (tp != null) {
					photoPreview.value = tp
				}
				const tf = res.tempFiles[0]
				if (tf != null) {
					photoSize.value = tf.size
				}
			},
			fail: () => {
				showErrorToast(new Error('未选择照片'))
			}
		})
	}
	function savePhoto(): void {
		if (photoPreview.value == '') {
			showErrorToast(new Error('请先拍照或选一张照片'))
			return
		}
		if (photoUploading.value) {
			return
		}
		photoUploading.value = true
		uni.showLoading({ title: '上传中…', mask: true })
		const now = Date.now()
		// 手动选图无 MediaStore id，用负时间戳作临时 id（上传只用 path/size/takenAt）
		const item = new PhotoItem(-now, photoPreview.value, now, 0, 0, null, null, photoSize.value)
		const items: Array<PhotoItem> = [item]
		uploadBatch(items, (p: UploadProgress): void => {}).then((uploaded: Array<UploadedPhoto>) => {
			uni.hideLoading()
			photoUploading.value = false
			if (uploaded.length > 0) {
				uni.showToast({ title: '照片已保存', icon: 'success' })
				emit('saved') // 修复（2026-08-31）：保存成功要通知宿主刷新（原只 emit close → timeline 不刷新）
				photoPreview.value = ''
				photoSize.value = 0
				closeForm()
			} else {
				uni.showToast({ title: '上传失败，请重试', icon: 'none' })
			}
		})
	}

	// ===== 文字记录方法 =====
	function submitText(): void {
		const text = draft.value.trim()
		console.log('[yishu] submitText: ' + text)
		if (text == '') {
			showErrorToast(new Error('先写点什么吧'))
			return
		}
		submitting.value = true
		classifyLabel.value = '整理中…'
		currentLabel.value = ''
		createTextContent(text).then((contentId: string | null) => {
			console.log('[yishu] createTextContent -> ' + contentId)
			if (contentId == null) {
				submitting.value = false
				classifyLabel.value = ''
				return
			}
			lastContentId.value = contentId
			lastText.value = text
			draft.value = ''
			submitClassify(text).then((jobId: string | null) => {
				console.log('[yishu] submitClassify -> ' + jobId)
				if (jobId == null) {
					submitting.value = false
					classifyLabel.value = '已记录'
					uni.showToast({ title: '已记下', icon: 'success' })
					emit('saved') // 文字已入库，通知宿主刷新
					return
				}
				pollClassify(jobId, 20, 3000).then((result) => {
					console.log('[yishu] pollClassify done, result=' + (result != null ? result.label : 'null'))
					submitting.value = false
					if (result != null) {
						currentLabel.value = result.label
						classifyLabel.value = result.labelCn
						uni.showToast({ title: '已分类：' + result.labelCn, icon: 'none' })
						emit('saved') // 文字已入库（分类完成），通知宿主刷新
					} else {
						classifyLabel.value = '已记录（分类暂不可用）'
						uni.showToast({ title: '已记下', icon: 'success' })
						emit('saved') // 文字已入库，通知宿主刷新
					}
				})
			})
		})
	}
	function onTagTap(key: string): void {
		if (lastContentId.value == '' || key === currentLabel.value) {
			return
		}
		const oldLabel = currentLabel.value
		// D-22（09-01 意图先落重构，P2 报告 §2.3）：用户点击标签=唯一意图，立即乐观更新并
		// 写层①（POST /corrections source=active，服务端同时回写 content_class）；
		// 仲裁降级为纯参考回显——绝不覆盖用户选择（硬约束：用户操作优先）。
		currentLabel.value = key
		classifyLabel.value = labelCn(key)
		submitCorrection(lastContentId.value, lastText.value, key, oldLabel).then((ok: boolean) => {
			if (!ok) {
				uni.showToast({ title: '纠错记录失败，请重试', icon: 'none' })
				return
			}
			uni.showToast({ title: '已纠正', icon: 'none' })
			submitArbitrate(lastText.value, lastContentId.value, key).then((jobId: string | null) => {
				if (jobId == null) {
					return
				}
				pollArbitrate(jobId, 20, 3000).then((ref: UTSJSONObject | null) => {
					if (ref == null) {
						return
					}
					if ((ref.getBoolean('degraded') ?? false) == true) {
						console.log('[yishu] arbitrate degraded: 引擎降级，忽略参考意见')
						return
					}
					const refLabel = ref.getString('label') ?? ''
					if (refLabel != '' && refLabel != key) {
						uni.showToast({ title: '模型参考：' + labelCn(refLabel) + '（以你的选择为准）', icon: 'none' })
					}
				})
			})
		})
	}

	// ===== 语音录音方法 =====
	function toggleRecord(): void {
		if (recording.value) {
			stopRecordNow()
		} else {
			recording.value = true
			recordSeconds.value = 0
			recState.value = 'idle'
			recordHint.value = '录音中，再点停止'
			transcript.value = ''
			emotion.value = ''
			guardMsg.value = ''
			voiceHints.value = ''
			lastVoiceFile.value = ''
			setShouldResume(true)
			recordTimer.value = setInterval(() => {
				recordSeconds.value++
			}, 1000) as number
			// 原生录音插件在标准基座缺失（UTSAndroid is not defined）→ 同步抛出会让状态机卡死，
			// 导致「录音中关不掉表单」。必须兜底：失败即回滚状态 + 提示。
			try {
			startRecord(
				() => {
					console.log('[yishu] record started')
				},
				(path: string, durationMs: number) => {
					onRecordStopped(path, durationMs)
				},
				(msg: string) => {
					console.error('[yishu] record error: ' + msg)
					recording.value = false
					recState.value = 'idle'
					recordHint.value = '点击开始录音（≤30 分钟）'
					if (recordTimer.value > 0) {
						clearInterval(recordTimer.value)
						recordTimer.value = 0
					}
					showErrorToast(new Error('录音失败：' + msg))
				},
				(autoPaused: boolean) => {
					console.log('[yishu] record interrupted (autoPaused=' + autoPaused + ')')
					recState.value = recorderState()
					recordHint.value = '录音被中断，已暂停'
				},
				(path: string, durationMs: number) => {
					console.log('[yishu] record auto-stop at 30min, saving.value segment: ' + durationMs + 'ms')
					onRecordStopped(path, durationMs)
				}
			)
			} catch (e) {
				console.log('[yishu] startRecord failed (标准基座无原生录音插件，状态回滚): ' + e)
				recording.value = false
				recState.value = 'idle'
				recordHint.value = '当前基座不支持录音（需自定义基座）'
				if (recordTimer.value > 0) {
					clearInterval(recordTimer.value)
					recordTimer.value = 0
				}
				// 铁律 10.8：能力不可用必须给 toast。只改 recordHint 文案用户看不见
				// （真机 2026-08-31 峰宝复验：「点麦克风不会有任何提示」）
				uni.showToast({ title: '当前基座不支持录音，请改用自定义基座', icon: 'none' })
			}
		}
	}
	function resumeRecordNow(): void {
		try {
			resumeRecord()
			recState.value = recorderState()
			recordHint.value = recState.value == REC_STATE_PAUSED ? '录音中，再点停止' : '已继续录音'
		} catch (e) {
			console.log('[yishu] resumeRecord failed (标准基座无原生插件，忽略): ' + e)
		}
	}
	function stopRecordNow(): void {
		try {
			stopRecord()
		} catch (e) {
			console.log('[yishu] stopRecord failed (标准基座无原生插件，忽略): ' + e)
			// 兜底：原生不可用也要把 UI 状态复位，否则「录音中」永远退不出去
			recording.value = false
			recState.value = 'idle'
			recordHint.value = '点击开始录音（≤30 分钟）'
			if (recordTimer.value > 0) {
				clearInterval(recordTimer.value)
				recordTimer.value = 0
			}
		}
	}
	function onRecordStopped(path: string, durationMs: number): void {
		recording.value = false
		recState.value = 'idle'
		recordHint.value = '点击开始录音（≤30 分钟）'
		if (recordTimer.value > 0) {
			clearInterval(recordTimer.value)
			recordTimer.value = 0
		}
		if (durationMs < 500) {
			showErrorToast(new Error('录音太短'))
			return
		}
		lastVoiceDuration.value = durationMs
		lastVoiceFile.value = path
		transcribing.value = true
		// D-07（09-01）：分档点 300s→250s——16k/16bit/mono wav 32KB/s，8MB 直传上限
		// ≈262s；原 4.2~5min 段两不沾（直传被 413 拒→静默 null 黑洞）。宁早进分片档。
		if (durationMs >= 250000) {
			transcribing.value = false
			voiceHints.value = '长录音已提交，云端整理中（>5min 自动分段转写）'
			uploadVoicePersistent(path, durationMs).then((res: UTSJSONObject | null) => {
				console.log('[yishu] long voice uploaded: ' + (res != null ? JSON.stringify(res) : 'null'))
			})
			return
		}
		transcribeWav(path, durationMs).then((res: AsrResult | null) => {
			transcribing.value = false
			if (res == null) {
				// D-08（09-01）：失败段不孤儿——入本地持久队列 + 卡片保留重试入口
				addPendingTranscription(path, durationMs)
				retryVoicePath.value = path
				return
			}
			clearPendingTranscription(path)
			retryVoicePath.value = ''
			transcript.value = res.text
			emotion.value = res.emotion
			const hints: Array<string> = []
			if (res.notOral) {
				hints.push('疑似非口述（键盘/环境音）')
			}
			if (res.silenceHint) {
				hints.push('检测到静音空段，可删除')
			}
			const merge = res.emotionMerge
			if (merge != null) {
				const dm = merge.getJSON('dominant')
				if (dm != null) {
					const dominantEmotion = dm.getString('emotion')
					if (dominantEmotion != null && dominantEmotion != '') {
						hints.push('主导情绪：' + dominantEmotion + '（时长最长段）')  // D-16: 未测得(null)不再输出空提示
					}
				}
			}
			if (res.noiseWeight == 'equal') {
				hints.push('噪音较大，情绪权重已降为持平')
			}
			voiceHints.value = hints.join('；')
			if (!res.guardPassed) {
				guardMsg.value = '内容未通过安全审核：' + res.guardReason
			} else {
				guardMsg.value = res.channel + ' 通道' + (res.mock ? '（mock）' : '') + ' · 置信度 ' + Math.round(res.confidence * 100) + '%'
			}
		})
	}
	function submitVoice(): void {
		const text = transcript.value.trim()
		if (text == '') {
			showErrorToast(new Error('转写内容为空'))
			return
		}
		saving.value = true
		// D-07（09-01）：短录音带音频走分片持久化入库（complete 直建带文本内容）——
		// 根治「转写失败」误感知 + 音频永久不可回放 + AUDIO_NOT_FOUND 判死。
		const vf = lastVoiceFile.value
		if (vf == '') {
			saveVoiceContent(text, lastVoiceDuration.value, emotion.value, '', '').then((contentId: string | null) => {
				finishVoiceSave(contentId != null)
			})
			return
		}
		uploadVoicePersistent(vf, lastVoiceDuration.value, text).then((res: UTSJSONObject | null) => {
			finishVoiceSave(res != null)
		})
	}

	function finishVoiceSave(ok: boolean): void {
		saving.value = false
		if (ok) {
			uni.showToast({ title: '已入库', icon: 'success' })
			emit('saved') // 修复（2026-08-31）：语音入库后通知宿主刷新
			transcript.value = ''
			emotion.value = ''
			guardMsg.value = ''
			voiceHints.value = ''
			lastVoiceFile.value = ''
		} else {
			showErrorToast(new Error('入库失败'))
		}
	}

	function retryTranscribe(): void {
		const p = retryVoicePath.value
		if (p == '') {
			return
		}
		transcribing.value = true
		transcribeWav(p, lastVoiceDuration.value).then((res: AsrResult | null) => {
			transcribing.value = false
			if (res == null) {
				voiceHints.value = '重试仍失败，录音已保留，可稍后再试'
				return
			}
			clearPendingTranscription(p)
			retryVoicePath.value = ''
			transcript.value = res.text
			emotion.value = res.emotion
			voiceHints.value = ''
		})
	}
</script>


		justify-content: center;
	}
	.f1e-confirm-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 31rpx;
		color: #ffffff;
		font-weight: 500;

	/* ═══════ F1c 语音预览态 ═══════ */
	.preview-layer {
		position: absolute;
		top: 0;
		left: 0;
		width: 750rpx;
		height: 100%;
		background-color: #f8f7f4;
		z-index: 40;
	}
	.pv-status-time {
		font-family: "Sarasa Gothic SC", sans-serif;
		position: absolute;
		left: 46rpx;
		top: 31rpx;
		font-size: 29rpx;
		color: #3a2e25;

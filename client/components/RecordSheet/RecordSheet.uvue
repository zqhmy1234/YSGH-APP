		   （GPU 合成不触发 layout；§O P1 废弃的是 rotate+translate 多函数组合，单函数规避） */
	}
	.wd {
		/* 圆点本体：白色+悬浮投影（视觉铁律：淡底白点必须带 DROP_SHADOW）——R3 静态类承载，不再逐帧内联 */
		background-color: #ffffff;
		border-radius: 50%;
		box-shadow: 0 4rpx 10rpx rgba(58, 46, 37, 0.16);
	}
	/* R3 尺寸静态类（width/height 不再逐帧内联；主点档位=DOT_SPECS dia，幽灵=主点 75%。
	   不用 transform scale 缩幽灵——会与动态 translate 组成多函数（§O P1 实锤坑） */
	.wds0 { width: 40rpx; height: 40rpx; }
	.wds1 { width: 22rpx; height: 22rpx; }
	.wds2 { width: 32rpx; height: 32rpx; }
	.wds3 { width: 20rpx; height: 20rpx; }
	.wds4 { width: 48rpx; height: 48rpx; }
	.wds5 { width: 26rpx; height: 26rpx; }
	.wds6 { width: 56rpx; height: 56rpx; }

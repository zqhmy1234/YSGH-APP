		color: #3A2E25;
	}
	.f1e-divider {
		height: 2rpx;
		background-color: #F0EBE3;
		margin-top: 29rpx;
		margin-bottom: 31rpx;
	}
	.f1e-icon-location {
		width: 38rpx;
		height: 38rpx;
		position: relative;
		margin-right: 27rpx;
	}
	.loc-ring {
		position: absolute;
		width: 26rpx;
		height: 26rpx;
		border-radius: 13rpx;
		border-width: 2rpx;
		border-color: #8A7A6A;
		border-style: solid;
		left: 4rpx;
		top: 2rpx;
	}
	.loc-dot {
		position: absolute;

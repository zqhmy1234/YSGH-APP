<template>
	<view class="page">
		<!-- ═══════════ 模态遮罩（55% 暗色，压暗真实页面） ═══════════
		     点遮罩 = 关闭浮层（原独立页无此交互，浮层化后必须补，否则只能靠系统返回键） -->
		<view class="scrim" @tap="onClose"></view>

		<!-- ═══════════ 底部弹层：新的记忆（设计稿默认态） ═══════════ -->
		<view class="sheet">
			<view class="grab"></view>
			<text class="sheet-title">新的记忆</text>
			<view class="sheet-options">
				<view class="option" @tap="openMode('photo')">
					<view class="option-circle c-photo">
						<image class="option-icon icon-camera" src="/static/icons/record-camera.svg" />
					</view>
					<text class="option-label">拍照</text>
				</view>
				<view class="option" @tap="openMode('gallery')">
					<view class="option-circle c-gallery">
						<image class="option-icon icon-gallery" src="/static/icons/record-gallery.svg" />
					</view>
					<text class="option-label">选照片</text>
				</view>
				<view class="option" @tap="openMode('voice')">
					<view class="option-circle c-voice">
						<image class="option-icon icon-mic" src="/static/icons/record-mic.svg" />
					</view>
					<text class="option-label">说一段</text>
				</view>
				<view class="option" @tap="openMode('text')">
					<view class="option-circle c-text">
						<image class="option-icon icon-keyboard" src="/static/icons/record-keyboard.svg" />
					</view>
					<text class="option-label">写几句</text>
				</view>
			</view>
			<view class="home-indicator"></view>
			<text class="sheet-hint">长按 + 可直达完整记录表单</text>
		</view>

		<!-- ═══════════ 功能层：选中入口后的记录表单 ═══════════ -->
		<view v-if="formMode != ''" class="form-layer">

			<!-- ═══════ 照片模式：F1h–F1k 多图网格编辑态（卡09 F1i 2/9） ═══════ -->
			<!-- F1a 语音待录态：全屏轮盘设计（canvas JSON 真值还原，390x844） -->
			<view v-if="formMode == 'voice' && !recording && transcript == '' && !transcribing" class="voice-idle">
				<text class="vi-time">{{ statusTime }}</text>
				<view class="vi-battery"></view>
				<view class="vi-back" @tap="closeForm">
					<text class="vi-back-icon">‹</text>
				</view>
				<text class="vi-title">说一段</text>
				<view class="vi-close" @tap="onClose">
					<text class="vi-close-icon">×</text>
				</view>
				<view class="vi-wheel">
					<view class="wheel-center" @tap="toggleRecord"></view>
					<view class="wheel-dot wd1"></view>
					<view class="wheel-dot wd2"></view>
					<view class="wheel-dot wd3"></view>
					<view class="wheel-dot wd4"></view>
					<view class="wheel-dot wd5"></view>
					<view class="wheel-dot wd6"></view>
					<view class="wheel-dot wd7"></view>
				</view>
				<text class="vi-timer">00:00</text>
				<text class="vi-hint">轻触中央圆点 · 开始录音</text>
				<view class="vi-home"></view>
			</view>

			<view v-else-if="formMode == 'photo' || formMode == 'gallery'" class="photo-layout">
				<!-- 自定义头部：状态栏(9:41+电池) + 返回‹ + 居中标题"照片"，无头部保存钮（确定钮在信息卡之后随流） -->
				<view class="photo-head">
					<text class="ph-status-time">{{ statusTime }}</text>
					<view class="ph-status-battery"></view>
					<view class="photo-back" @tap="closeForm">
						<text class="photo-back-text">‹</text>
					</view>
					<text class="photo-title">照片</text>
					<view class="photo-head-spacer"></view>
				</view>

				<scroll-view class="photo-scroll" scroll-y>
					<!-- 节标：照片 · N/9 -->
					<text class="photo-section-label">照片 · {{ photoList.length }}/9</text>

					<!-- 照片卡：白底圆角阴影，内建自适应网格（2张=单行大图 / 3张=单行小图 / 4张=2×2大图 / 5-9张=九宫格，逐帧画布真值） -->
					<view class="photo-card" :style="{ height: photoCardHeight + 'rpx' }" @tap="onPhotoCardTap">
						<view class="photo-grid">
							<view v-for="(p, idx) in photoList" :key="idx"
										class="photo-item" @tap="openF1gDetail(idx)"
										:style="{ width: photoItemSize + 'rpx', height: photoItemSize + 'rpx', marginRight: photoGridGap + 'rpx', marginBottom: photoGridGap + 'rpx', borderRadius: photoItemRadius + 'rpx' }">
								<image class="photo-img" :src="p" mode="aspectFill" />
								<view class="photo-delete" @tap.stop="removePhoto(idx)"
											:style="{ width: photoDeleteSize + 'rpx', height: photoDeleteSize + 'rpx', top: photoDeleteTop + 'rpx', right: photoDeleteRight + 'rpx', borderRadius: photoDeleteRadius + 'rpx' }">
									<text class="photo-delete-text" :style="{ fontSize: photoDeleteFont + 'rpx', lineHeight: photoDeleteFont + 'rpx' }">×</text>
								</view>
							</view>
							<!-- F1h：可见添加格（5张以上九宫格模式，未满9张时显示；4张为2×2大图无添加格） -->
							<view v-if="photoList.length >= 5 && photoList.length < 9"
										class="photo-add-cell"
										:style="{ width: photoItemSize + 'rpx', height: photoItemSize + 'rpx', marginRight: photoGridGap + 'rpx', marginBottom: photoGridGap + 'rpx', borderRadius: photoItemRadius + 'rpx' }"
										@tap.stop="pickPhoto">
								<text class="photo-add-text">＋</text>
							</view>
						</view>
					</view>

					<!-- 分类区 -->
					<view class="cat-section">
						<view class="cat-head">
							<text class="cat-label">分类</text>
							<text class="cat-hint">AI 已预选 · 点标签可纠正</text>
						</view>
						<view class="cat-chips">
							<view v-for="c in categoryList" :key="c.key"
										class="cat-chip"
										:class="c.key === currentCategory ? 'cat-chip-active' : ''"
										@tap="selectCategory(c.key)">
								<text class="cat-chip-text"
											:class="c.key === currentCategory ? 'cat-chip-text-active' : ''">{{ c.cn }}</text>
							</view>
							<view class="cat-chip cat-chip-add" @tap="addCategory">
								<text class="cat-chip-add-text">＋</text>
							</view>
						</view>
					</view>

					<!-- 信息卡：时间 + 地点 -->
					<view class="info-card">
						<view class="info-row">
							<view class="info-icon-wrap">
								<text class="info-icon-text">◷</text>
							</view>
							<text class="info-text">{{ photoTime }}</text>
						</view>
						<view class="info-divider"></view>
						<view class="info-row">
							<view class="info-icon-wrap">
								<text class="info-icon-text">⌖</text>
							</view>
							<text class="info-text">{{ photoLocation }}</text>

						</view>
					</view>

					<!-- 确定钮：随内容流放置（canvas y=550 F1j / y=756 F1k，位于信息卡之后，非固定底栏） -->
					<view class="photo-confirm" @tap="confirmPhoto">
						<text class="photo-confirm-text">确定</text>
					</view>
					<!-- 底部留白（Home 指示条区域） -->
					<view style="height: 140rpx;"></view>
				</scroll-view>
				<!-- Home 指示条（canvas y=828 140x5 r3） -->
				<view class="photo-home-indicator"></view>
				<!-- ═══════ F1g 单图详情覆盖层（卡07 还原：canvas 390x844 → 750rpx SCALE=1.9231） ═══════ -->
				<view v-if="f1gView" class="f1g-overlay">
					<!-- 导航栏：返回网格 + 标题"照片"（canvas y=60） -->
					<view class="f1g-nav">
						<view class="f1g-back" @tap="closeF1gDetail">
							<text class="f1g-back-text">‹</text>
						</view>
						<text class="f1g-title">照片</text>
						<view class="f1g-nav-spacer"></view>
					</view>

					<!-- 可滚动内容区 -->
					<scroll-view class="f1g-scroll" scroll-y>
						<view class="f1g-content">
							<!-- 节标：照片 · N/9（canvas y=116，fontSize13 Medium #8A7A6A） -->
							<text class="f1g-section-label">照片 · {{ f1gPhotoIdx + 1 }}/{{ photoList.length }}</text>

							<!-- 照片卡（canvas y=146 w=342 h=292，白bg圆角20 shadow 0,6,18 6%） -->
							<view class="f1g-photo-card">
								<!-- 照片（canvas x=20 y=20 w=302 h=226，圆角12） -->
								<image v-if="f1gPhotoIdx < photoList.length" class="f1g-photo-img" :src="photoList[f1gPhotoIdx]" mode="aspectFill" />
								<view v-else class="f1g-photo-placeholder">
									<text class="f1g-placeholder-icon">◫</text>
								</view>
								<!-- AI 描述（canvas y=254，fontSize13 Regular #8A7A6A，帧真值写死） -->
								<text class="f1g-ai-desc">AI 描述：{{ f1gPhotoIdx < photoAiDescs.length ? photoAiDescs[f1gPhotoIdx] : '' }}</text>
							</view>

							<!-- 分类节标行（canvas y=488：左"分类" + 右"AI 已预选·点标签可纠正"） -->
							<view class="f1g-cat-header">
								<text class="f1g-cat-label">分类</text>
								<text class="f1g-cat-hint">AI 已预选 · 点标签可纠正</text>
							</view>

							<!-- 分类 chips（canvas y=518：日常生活[选中]/家人与朋友/旅行/＋） -->
							<view class="f1g-chips">
								<view v-for="c in categoryList" :key="c.key" class="f1g-chip" :class="c.key === currentCategory ? 'f1g-chip-active' : ''" @tap="selectCategory(c.key)">
									<text class="f1g-chip-text" :class="c.key === currentCategory ? 'f1g-chip-active-text' : ''">{{ c.cn }}</text>
								</view>
								<view class="f1g-chip f1g-chip-add" @tap="addCategory">
									<text class="f1g-chip-add-text">＋</text>
								</view>
							</view>

							<!-- 信息卡（canvas y=590 w=342 h=116，时间+分隔线+地点） -->
							<view class="f1g-info-card">
								<view class="f1g-info-row">
									<image class="f1g-info-icon" src="/static/icons/i2_319.svg" />
									<text class="f1g-info-text">{{ photoTime }}</text>
								</view>
								<view class="f1g-info-divider"></view>
								<view class="f1g-info-row">
									<image class="f1g-info-icon f1g-info-icon-loc" src="/static/icons/i2_320.svg" />
									<text class="f1g-info-text">{{ photoLocation }}</text>
								</view>
							</view>

							<!-- 底部占位（防止内容被固定钮遮挡） -->
							<view style="height: 180rpx;"></view>
						</view>
					</scroll-view>

					<!-- 固定底部确定钮（canvas y=746 w=342 h=54，#B05A3A 圆角27 shadow） -->
					<view class="f1g-confirm" @tap="confirmPhoto">
						<text class="f1g-confirm-text">确定</text>
					</view>
				</view>
			</view>

			<!-- ═══════ 文字 / 语音模式：原有布局 ═══════ -->
			<view v-else class="form-standard">
				<view class="form-head">
					<view class="form-back" @tap="closeForm">
						<text class="form-back-text">‹</text>
					</view>
					<text class="form-title serif">{{ formTitle }}</text>
					<view v-if="formMode != 'text'" class="form-save" @tap="onSave">
						<text class="form-save-text">{{ saveText }}</text>
					</view>
				</view>
				<scroll-view class="form-scroll">
					<!-- 文字入口 · F1e 写几句空态 -->
					<view v-if="formMode == 'text'" class="f1e-body">
						<text class="f1e-section-label">正文</text>
						<view class="f1e-input-card">
							<textarea class="f1e-textarea" v-model="draft" placeholder="今天遇到了什么想记下来的？比如：陪妈逛了趟菜市场，她挑了茄子" :maxlength="2000" />
						</view>
						<view class="f1e-category-head">
							<text class="f1e-section-label f1e-category-label">分类</text>
							<text class="f1e-category-hint">选一个合适的分类</text>
						</view>
						<CategoryChips :categories="textCategories" :selected-key="textSelectedCategory" variant="manual" @select="onTextCategorySelect" @add="onTextCategoryAdd" />
						<view class="f1e-info-card">
							<view class="f1e-info-row">
								<view class="f1e-icon-clock">
									<view class="clock-face"></view>
									<view class="clock-hand-h"></view>
									<view class="clock-hand-m"></view>
								</view>
								<text class="f1e-info-text">{{ timeDisplay }}</text>
							</view>
							<view class="f1e-divider"></view>
							<view class="f1e-info-row">
								<view class="f1e-icon-location">
									<view class="loc-ring"></view>
									<view class="loc-dot"></view>
								</view>
								<text class="f1e-info-text">{{ locationDisplay }}</text>
							</view>
						</view>
						<text class="f1e-section-label f1e-label-top">备注</text>
						<view class="f1e-note-card">
							<textarea class="f1e-note-input" v-model="note" placeholder="补充几句…" :maxlength="500" />
						</view>
						<view class="f1e-confirm-btn" @tap="onSave">
							<text class="f1e-confirm-text">确定</text>
						</view>
					</view>
					<!-- 语音入口 -->
					<view v-else class="form-body">
						<view class="record-box">
							<view class="mic-btn" :class="recording ? 'mic-recording' : ''" @tap="toggleRecord">
								<text class="mic-icon">{{ recording ? '⏹' : '🎤' }}</text>
							</view>
							<text class="record-hint">{{ recordHint }}</text>
							<text v-if="recording" class="record-timer">{{ recordSeconds }}s</text>
							<view v-if="recording && (recState === 'interrupted' || recState === 'paused')" class="interrupt-bar">
								<text class="interrupt-text">{{ recState === 'interrupted' ? '录音被来电/系统中断，已暂停' : '已暂停' }}</text>
								<view class="resume-btn" @tap="resumeRecordNow">
									<text class="resume-text">继续录音</text>
								</view>
							</view>
						</view>
						<view v-if="transcribing" class="center-box">
							<text class="muted">正在转写…</text>
						</view>
						<view v-else-if="transcript != ''" class="transcript-box">
							<view class="transcript-head">
								<text class="transcript-title serif">转写结果</text>
								<text v-if="emotion != ''" class="emotion-chip">情绪：{{ emotion }}</text>
							</view>
							<view v-if="voiceHints != ''" class="voice-hints">
								<text class="muted">{{ voiceHints }}</text>
							</view>
							<textarea class="text-input serif" v-model="transcript" :maxlength="2000" />
							<view class="text-actions">
								<text class="muted">{{ guardMsg }}</text>
							</view>
						</view>
					</view>
				</scroll-view>
			</view>
		</view>

		<!-- ═══════════ F1c 语音预览态 ═══════════ -->
		<view v-if="voicePreview" class="preview-layer">
			<!-- 状态栏 -->
			<text class="pv-status-time">9:41</text>
			<view class="pv-status-battery"></view>
			<!-- 头部：返回 / 标题 / 关闭 -->
			<view class="pv-back" @tap="onPreviewBack">
				<image class="pv-back-icon" src="/static/icons/detail-back.svg" />
			</view>
			<text class="pv-title">说一段</text>
			<view class="pv-close" @tap="onPreviewClose">
				<text class="pv-close-text">×</text>
			</view>
			<!-- 转写卡 -->
			<view class="pv-card">
				<scroll-view class="pv-card-scroll" scroll-y="true">
					<text class="pv-card-text">{{ transcript }}</text>
				</scroll-view>
				<text class="pv-card-meta">时长 {{ previewDuration }} · {{ previewTime }}</text>
			</view>
			<!-- 底部双按钮 -->
			<view class="pv-btn-rerecord" @tap="onRerecord">
				<text class="pv-btn-rerecord-text">重新录</text>
			</view>
			<view class="pv-btn-confirm" @tap="onPreviewConfirm">
				<text class="pv-btn-confirm-text">确定</text>
			</view>
			<!-- Home 指示条 -->
	// ===== F1g 单图详情视图（卡07 还原：单张照片 + AI描述 + 分类chips） =====
	let f1gView = ref(false)
	let f1gPhotoIdx = ref(0)
	// F1g：每张照片的 AI 描述（帧真值写死，USE_MOCK 模式）
	let photoAiDescs: Array<string> = ['傍晚的江边，梧桐叶沙沙作响', '', '', '', '', '', '', '', '']

			<view class="pv-home-indicator"></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	// ⚠️ 不要 import 生命周期：uni-app x 规定 ref/computed/onLoad/onMounted 等由框架自动引入，
	// 手写 `import { onMounted } from '@dcloudio/uni-app'` 会编译失败
	// （真机实锤 2026-08-31："onMounted" is not exported by "@dcloudio/uni-app/dist-x/uni-app.es.js"）。
	import { ensureLogin } from '@/utils/auth'
	import { labelCn, createTextContent, submitClassify, pollClassify, submitCorrection, submitArbitrate, pollArbitrate, ALL_LABELS } from '@/utils/text_recorder'
	import {
		startRecord,
		stopRecord,
		resumeRecord,
		setShouldResume,
		recorderState,
		transcribeWav,
		saveVoiceContent,
		uploadVoicePersistent,
		REC_STATE_PAUSED
	} from '@/utils/voice'
	import { showErrorToast } from '@/utils/api'
	import { uploadBatch, UploadProgress, UploadedPhoto } from '@/utils/uploader'
	import { PhotoItem } from '@/uni_modules/yishu-photo-watch/utssdk/app-android/index.uts'
	import CategoryChips from './CategoryChips.uvue'

	// ===== 对外事件 =====
	// 浮层化后（2026-08-31 峰宝拍板）：记录面板 = 全局浮层，不是页面。
	// 关闭由宿主页决定（<RecordSheet v-if="sheetOpen" @close="sheetOpen=false" />）
	const emit = defineEmits(['close', 'saved'])

	// ===== Mock 常量（发版前 grep USE_MOCK_ 统一清理） =====
	// F1i–F1k 照片态帧共用网格：USE_MOCK_PHOTO_COUNT 控制演示张数（2=F1i / 3=F1j / 4=F1k / 6=F1h 九宫格）
	const USE_MOCK_PHOTO_GRID = true
	const USE_MOCK_PHOTO_COUNT = 4

	// ===== 响应式数据 =====
	// 弹层 / 表单状态
	let formMode = ref('')
	let formTitle = ref('写几句')
	let saveText = ref('记下来')
	let photoUploading = ref(false)
	// 照片模式：多图列表（替代原单图 photoPreview）
	let photoList = ref<Array<string>>([])
	// 照片模式：分类
	interface PhotoCategory {
		key: string
		cn: string
	}
	let categoryList = ref<Array<PhotoCategory>>([
		{ key: 'daily', cn: '日常生活' },
		{ key: 'family', cn: '家人与朋友' },
		{ key: 'travel', cn: '旅行' }
	])
	let currentCategory = ref('daily')
	// 照片模式：信息卡
	let photoTime = ref('今天 17:42')
	let photoLocation = ref('上海 · 江边')
	// 文字记录
	let draft = ref('')
	let submitting = ref(false)
	let classifyLabel = ref('')
	let currentLabel = ref('')
	let lastContentId = ref('')
	let lastText = ref('')
	let allLabels = ref(ALL_LABELS)
	// 语音记录
	let recording = ref(false)
	let recordSeconds = ref(0)
	let recordTimer = ref(0)
	let recState = ref('idle')
	let recordHint = ref('点击开始录音（≤30 分钟）')
	let voiceHints = ref('')
	let transcribing = ref(false)
	let transcript = ref('')
	let emotion = ref('')
	let guardMsg = ref('')
	let saving = ref(false)
	let lastVoiceDuration = ref(0)
	let lastVoiceFile = ref('')
	// F1a 状态栏时间（canvas 还原：9:41 位置，动态真实时间）
	let statusTime = ref('9:41')
	// F1c 预览态
	let voicePreview = ref(false)
	let previewDuration = ref('')
	let previewTime = ref('')

	// ===== F1e 文字空态数据 =====
	let note = ref('')
	let textSelectedCategory = ref('daily')
	let textCategories = ref([
		{ key: 'daily', label: '日常生活' },
		{ key: 'family', label: '家人与朋友' },
		{ key: 'travel', label: '旅行' }
	])
	let timeDisplay = ref('今天 17:42')
	let locationDisplay = ref('上海 · 江边')

	// ===== 照片网格自适应（F1i–F1k 逐帧真值：画布 JSON 定制尺寸，非均分） =====
	// 大图模式（2/4 张）：146px 方格 · gap 10px · 圆角 10px · 删除角标 20px
	// 小图模式（3/5-9 张）：96px 方格 · gap 7px · 圆角 8px · 删除角标 18px
	const PHOTO_CARD_PAD = 38 // 20px × 1.9231 ≈ 38rpx（上下左右）
	const PHOTO_LARGE_SIZE = 281 // 146px × 1.9231 ≈ 281rpx（F1i 2张 / F1k 4张）
	const PHOTO_LARGE_GAP = 19 // 10px × 1.9231 ≈ 19rpx
	const PHOTO_LARGE_RADIUS = 19 // 10px × 1.9231 ≈ 19rpx
	const PHOTO_LARGE_DEL = 38 // 20px × 1.9231 ≈ 38rpx
	const PHOTO_LARGE_DEL_TOP = 12 // 6px × 1.9231 ≈ 12rpx
	const PHOTO_SMALL_SIZE = 185 // 96px × 1.9231 ≈ 185rpx（F1j 3张 / F1h 5-9张）
	const PHOTO_SMALL_GAP = 13 // 7px × 1.9231 ≈ 13rpx
	const PHOTO_SMALL_RADIUS = 15 // 8px × 1.9231 ≈ 15rpx
	const PHOTO_SMALL_DEL = 35 // 18px × 1.9231 ≈ 35rpx
	const PHOTO_SMALL_DEL_TOP = 8 // 4px × 1.9231 ≈ 8rpx
	const PHOTO_CARD_H_SQUARE = 658 // 342px × 1.9231 ≈ 658rpx（F1k 4张 2×2 / F1h 5-9张 九宫格）

	// 小图（九宫格）模式 = 3 张或 5-9 张；大图模式 = 2/4 张
	const photoIsSmall = computed((): boolean => {
		const c = photoList.value.length
		return c == 3 || c >= 5
	})
	const photoGridGap = computed((): number => photoIsSmall.value ? PHOTO_SMALL_GAP : PHOTO_LARGE_GAP)
	const photoItemRadius = computed((): number => photoIsSmall.value ? PHOTO_SMALL_RADIUS : PHOTO_LARGE_RADIUS)
	const photoDeleteSize = computed((): number => photoIsSmall.value ? PHOTO_SMALL_DEL : PHOTO_LARGE_DEL)
	const photoDeleteTop = computed((): number => photoIsSmall.value ? PHOTO_SMALL_DEL_TOP : PHOTO_LARGE_DEL_TOP)
	const photoDeleteRadius = computed((): number => Math.floor(photoDeleteSize.value / 2))
	const photoDeleteFont = 23 // 12px × 1.9231 ≈ 23rpx（× 号字号，两模式一致）
	const photoDeleteRight = 8 // 4px × 1.9231 ≈ 8rpx（两模式一致）

	const photoItemSize = computed((): number => {
		const count = photoList.value.length
		if (count <= 0) {
			return 181 // 空态3列占位
		}
		if (count == 1) {
			return 581 // 单张全宽（无帧真值，保留既有全宽）
		}
		return photoIsSmall.value ? PHOTO_SMALL_SIZE : PHOTO_LARGE_SIZE
	})

	const photoCardHeight = computed((): number => {
		const count = photoList.value.length
		if (count == 2) {
			return PHOTO_CARD_PAD * 2 + PHOTO_LARGE_SIZE // F1i 186px：单行大图
		}
		if (count == 3) {
			return PHOTO_CARD_PAD * 2 + PHOTO_SMALL_SIZE // F1j 136px：单行小图
		}
		if (count == 4) {
			return PHOTO_CARD_H_SQUARE // F1k 342px：2×2 大图
		}
		if (count >= 5) {
			return PHOTO_CARD_H_SQUARE // F1h 342px：3 列九宫格固定高
		}
		if (count == 1) {
			return PHOTO_CARD_PAD * 2 + 581 // 单张全宽
		}
		return PHOTO_CARD_H_SQUARE // 空态：3 行占位
	})

	// ===== 生命周期（组件化：onLoad/onUnload → onMounted/onUnmounted） =====
	onMounted(() => {
		// F1a 状态栏时间初始化
		const _now = new Date()
		statusTime.value = _now.getHours() + ':' + (_now.getMinutes() < 10 ? '0' : '') + _now.getMinutes()
		ensureLogin().then((ok: boolean) => {
			if (!ok) {
				showErrorToast(new Error('登录失败，请重试'))
			}
		})
		// Mock 注入：F1i–F1k 演示态预填 USE_MOCK_PHOTO_COUNT 张照片
		if (USE_MOCK_PHOTO_GRID && photoList.value.length == 0) {
			photoList.value = buildMockPhotoList()
		}
	})
	onUnmounted(() => {
		if (recordTimer.value > 0) {
			clearInterval(recordTimer.value)
			recordTimer.value = 0
		}
	})

	// ===== 浮层整体关闭（点遮罩 / 宿主页调用） =====
	function onClose(): void {
		// 铁律 11：closeForm 曾因 stopRecord 抛异常导致状态永不复位 → 此处同样无条件通知宿主页
		try {
			if (recording.value) {
				stopRecordNow()
			}
		} catch (e) {
			console.log('[yishu] onClose 停止录音失败（忽略，仍强制关闭浮层）: ' + e)
		}
		formMode.value = ''
		emit('close')
	}

	// ===== 弹层交互 =====
	function openMode(m: string): void {
		formMode.value = m
		if (m == 'photo') {
			formTitle.value = '拍照'
			saveText.value = '保存'
		} else if (m == 'gallery') {
			formTitle.value = '选照片'
			saveText.value = '保存'
		} else if (m == 'voice') {
			formTitle.value = '说一段'
			saveText.value = '确认入库'
		} else {
			formTitle.value = '写几句'
			saveText.value = '记下来'
		}
		// 进入照片模式时确保 mock 数据已注入（onMounted 可能已执行过）
		if ((m == 'photo' || m == 'gallery') && USE_MOCK_PHOTO_GRID && photoList.value.length == 0) {
			photoList.value = buildMockPhotoList()
		}
	}
	// F1i–F1k mock 生成：按 USE_MOCK_PHOTO_COUNT 循环轮换两张示例图
	function buildMockPhotoList(): Array<string> {
		const srcs = ['/static/hero-lake.jpg', '/static/hero-ai.jpg']
		const out: Array<string> = []
		for (let i = 0; i < USE_MOCK_PHOTO_COUNT; i++) {
			out.push(srcs[i % 2])
		}
		return out
	}
	function closeForm(): void {
		// 录音中返回弹层：停止录音，避免后台空转
		// 铁律：formMode 必须**无条件**复位——原生插件抛异常曾导致「录音中关不掉表单、出不去」
		try {
			if (recording.value) {
				stopRecordNow()
			}
		} catch (e) {
			console.log('[yishu] closeForm 停止录音失败（忽略，仍强制关闭表单）: ' + e)
		}
		formMode.value = ''
	}
	function onSave(): void {
		if (formMode.value == 'text') {
			submitText()
		} else if (formMode.value == 'voice') {
			submitVoice()
		}
	}

	// ===== 照片 / 相册（多图网格，F1h–F1k） =====
	function pickPhoto(): void {
		if (photoList.value.length >= 9) {
			uni.showToast({ title: '最多 9 张照片', icon: 'none' })
			return
	// F1g 单图详情：从网格下钻 / 返回
	function openF1gDetail(idx: number): void {
		f1gPhotoIdx.value = idx
		f1gView.value = true
	}
	function closeF1gDetail(): void {
		f1gView.value = false
	}

		}
		const srcs: Array<string> = formMode.value == 'photo' ? ['camera'] : ['album']
		const remaining = 9 - photoList.value.length
		uni.chooseImage({
			count: remaining,
			sourceType: srcs,
			success: (res) => {
				const paths = res.tempFilePaths
				for (let i = 0; i < paths.length; i++) {
					if (photoList.value.length < 9) {
						photoList.value.push(paths[i])
					}
				}
			},
			fail: () => {
				showErrorToast(new Error('未选择照片'))
			}
		})
	}
	function onPhotoCardTap(): void {
		// 点击照片卡空白区 = 添加更多照片（F1i 无可见添加钮，卡可点）
		pickPhoto()
	}
	function removePhoto(idx: number): void {
		if (idx < 0 || idx >= photoList.value.length) {
			return
		}
		photoList.value.splice(idx, 1)
	}
	function selectCategory(key: string): void {
		currentCategory.value = key
	}
	function addCategory(): void {
		uni.showToast({ title: '自定义分类（待接入）', icon: 'none' })
	}
	function confirmPhoto(): void {
		if (photoList.value.length == 0) {
			showErrorToast(new Error('请先添加照片'))
			return
		}
		if (photoUploading.value) {
			return
		}
		photoUploading.value = true
		uni.showLoading({ title: '上传中…', mask: true })
		const now = Date.now()
		const items: Array<PhotoItem> = []
		for (let i = 0; i < photoList.value.length; i++) {
			// 手动选图无 MediaStore id，用负时间戳作临时 id（上传只用 path/size/takenAt）
			const item = new PhotoItem(-now - i, photoList.value[i], now, 0, 0, null, null, 0)
			items.push(item)
		}
		uploadBatch(items, (p: UploadProgress): void => {}).then((uploaded: Array<UploadedPhoto>) => {
			uni.hideLoading()
			photoUploading.value = false
			if (uploaded.length > 0) {
				uni.showToast({ title: '照片已保存', icon: 'success' })
				emit('saved')
				photoList.value = []
				closeForm()
			} else {
				uni.showToast({ title: '上传失败，请重试', icon: 'none' })
			}
		})
	}

	// ===== 文字记录方法 =====
	function submitText(): void {
		const text = draft.value.trim()
		console.log('[yishu] submitText: ' + text)
		if (text == '') {
			showErrorToast(new Error('先写点什么吧'))
			return
		}
		submitting.value = true
		classifyLabel.value = '整理中…'
		currentLabel.value = ''
		createTextContent(text).then((contentId: string | null) => {
			console.log('[yishu] createTextContent -> ' + contentId)
			if (contentId == null) {
				submitting.value = false
				classifyLabel.value = ''
				return
			}
			lastContentId.value = contentId
			lastText.value = text
			draft.value = ''
			submitClassify(text).then((jobId: string | null) => {
				console.log('[yishu] submitClassify -> ' + jobId)
				if (jobId == null) {
					submitting.value = false
					classifyLabel.value = '已记录'
					uni.showToast({ title: '已记下', icon: 'success' })
					emit('saved') // 文字已入库，通知宿主刷新
					return
				}
				pollClassify(jobId, 20, 3000).then((result) => {
					console.log('[yishu] pollClassify done, result=' + (result != null ? result.label : 'null'))
					submitting.value = false
					if (result != null) {
						currentLabel.value = result.label
						classifyLabel.value = result.labelCn
						uni.showToast({ title: '已分类：' + result.labelCn, icon: 'none' })
						emit('saved') // 文字已入库（分类完成），通知宿主刷新
					} else {
						classifyLabel.value = '已记录（分类暂不可用）'
						uni.showToast({ title: '已记下', icon: 'success' })
						emit('saved') // 文字已入库，通知宿主刷新
					}
				})
			})
		})
	}
	function onTagTap(key: string): void {
		if (lastContentId.value == '' || key === currentLabel.value) {
			return
		}
		const oldLabel = currentLabel.value
		currentLabel.value = key
		classifyLabel.value = '纠正中…'
		submitArbitrate(lastText.value).then((jobId: string | null) => {
			if (jobId == null) {
				classifyLabel.value = labelCn(key)
				submitCorrection(lastContentId.value, lastText.value, key, oldLabel).then((ok: boolean) => {
					uni.showToast({ title: ok ? '已纠正' : '纠错记录失败', icon: 'none' })
				})
				return
			}
			pollArbitrate(jobId, 20, 3000).then((finalLabel: string | null) => {
				if (finalLabel != null) {
					currentLabel.value = finalLabel
					classifyLabel.value = labelCn(finalLabel)
					submitCorrection(lastContentId.value, lastText.value, finalLabel, oldLabel)
					uni.showToast({ title: '已纠正为：' + labelCn(finalLabel), icon: 'none' })
				} else {
					currentLabel.value = key
					classifyLabel.value = labelCn(key)
					submitCorrection(lastContentId.value, lastText.value, key, oldLabel)
					uni.showToast({ title: '已纠正', icon: 'none' })
				}
			})
		})
	}

	// ===== F1e 文字空态方法 =====
	function onTextCategorySelect(key: string): void {
		textSelectedCategory.value = key
	}
	function onTextCategoryAdd(): void {
		uni.showToast({ title: '自定义分类（二期）', icon: 'none' })
	}

	// ===== 语音录音方法 =====
	function toggleRecord(): void {
		if (recording.value) {
			stopRecordNow()
		} else {
			recording.value = true
			recordSeconds.value = 0
			recState.value = 'idle'
			recordHint.value = '录音中，再点停止'
			transcript.value = ''
			emotion.value = ''
			guardMsg.value = ''
			voiceHints.value = ''
			lastVoiceFile.value = ''
			setShouldResume(true)
			recordTimer.value = setInterval(() => {
				recordSeconds.value++
			}, 1000) as number
			// 原生录音插件在标准基座缺失（UTSAndroid is not defined）→ 同步抛出会让状态机卡死，
			// 导致「录音中关不掉表单」。必须兜底：失败即回滚状态 + 提示。
			try {
			startRecord(
				() => {
					console.log('[yishu] record started')
				},
				(path: string, durationMs: number) => {
					onRecordStopped(path, durationMs)
				},
				(msg: string) => {
					console.error('[yishu] record error: ' + msg)
					recording.value = false
					recState.value = 'idle'
					recordHint.value = '点击开始录音（≤30 分钟）'
					if (recordTimer.value > 0) {
						clearInterval(recordTimer.value)
						recordTimer.value = 0
					}
					showErrorToast(new Error('录音失败：' + msg))
				},
				(autoPaused: boolean) => {
					console.log('[yishu] record interrupted (autoPaused=' + autoPaused + ')')
					recState.value = recorderState()
					recordHint.value = '录音被中断，已暂停'
				},
				(path: string, durationMs: number) => {
					console.log('[yishu] record auto-stop at 30min, saving.value segment: ' + durationMs + 'ms')
					onRecordStopped(path, durationMs)
				}
			)
			} catch (e) {
				console.log('[yishu] startRecord failed (标准基座无原生录音插件，状态回滚): ' + e)
				recording.value = false
				recState.value = 'idle'
				recordHint.value = '当前基座不支持录音（需自定义基座）'
				if (recordTimer.value > 0) {
					clearInterval(recordTimer.value)
					recordTimer.value = 0
				}
				// 铁律 10.8：能力不可用必须给 toast。只改 recordHint 文案用户看不见
				// （真机 2026-08-31 峰宝复验：「点麦克风不会有任何提示」）
				uni.showToast({ title: '当前基座不支持录音，请改用自定义基座', icon: 'none' })
			}
		}
	}
	function resumeRecordNow(): void {
		try {
			resumeRecord()
			recState.value = recorderState()
			recordHint.value = recState.value == REC_STATE_PAUSED ? '录音中，再点停止' : '已继续录音'
		} catch (e) {
			console.log('[yishu] resumeRecord failed (标准基座无原生插件，忽略): ' + e)
		}
	}
	function stopRecordNow(): void {
		try {
			stopRecord()
		} catch (e) {
			console.log('[yishu] stopRecord failed (标准基座无原生插件，忽略): ' + e)
			// 兜底：原生不可用也要把 UI 状态复位，否则「录音中」永远退不出去
			recording.value = false
			recState.value = 'idle'
			recordHint.value = '点击开始录音（≤30 分钟）'
			if (recordTimer.value > 0) {
				clearInterval(recordTimer.value)
				recordTimer.value = 0
			}
		}
	}
	function onRecordStopped(path: string, durationMs: number): void {
		recording.value = false
		recState.value = 'idle'
		recordHint.value = '点击开始录音（≤30 分钟）'
		if (recordTimer.value > 0) {
			clearInterval(recordTimer.value)
			recordTimer.value = 0
		}
		if (durationMs < 500) {
			showErrorToast(new Error('录音太短'))
			return
		}
		lastVoiceDuration.value = durationMs
		lastVoiceFile.value = path
		transcribing.value = true
		if (durationMs >= 300000) {
			transcribing.value = false
			voiceHints.value = '长录音已提交，云端整理中（>5min 自动分段转写）'
			uploadVoicePersistent(path, durationMs).then((res: UTSJSONObject | null) => {
				console.log('[yishu] long voice uploaded: ' + (res != null ? JSON.stringify(res) : 'null'))
			})
			return
		}
		transcribeWav(path).then((res) => {
			transcribing.value = false
			if (res == null) {
				return
			}
			transcript.value = res.text
			emotion.value = res.emotion
			const hints: Array<string> = []
			if (res.notOral) {
				hints.push('疑似非口述（键盘/环境音）')
			}
			if (res.silenceHint) {
				hints.push('检测到静音空段，可删除')
			}
			const merge = res.emotionMerge
			if (merge != null) {
				const dm = merge.getJSON('dominant')
				if (dm != null) {
					hints.push('主导情绪：' + (dm.getString('emotion') ?? '') + '（时长最长段）')
				}
			}
			if (res.noiseWeight == 'equal') {
				hints.push('噪音较大，情绪权重已降为持平')
			}
			voiceHints.value = hints.join('；')
			if (!res.guardPassed) {
				guardMsg.value = '内容未通过安全审核：' + res.guardReason
			} else {
				guardMsg.value = res.channel + ' 通道' + (res.mock ? '（mock）' : '') + ' · 置信度 ' + Math.round(res.confidence * 100) + '%'
			}
			enterPreview()
		})
	}

	// ===== F1c 预览态方法 =====
	function formatDuration(ms: number): string {
		const totalSec = Math.floor(ms / 1000)
		const m = Math.floor(totalSec / 60)
		const s = totalSec % 60
		return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s
	}
	function formatPreviewTime(ts: number): string {
		const d = new Date(ts)
		const h = d.getHours()
		const min = d.getMinutes()
		return '今天 ' + (h < 10 ? '0' : '') + h + ':' + (min < 10 ? '0' : '') + min
	}
	function enterPreview(): void {
		previewDuration.value = formatDuration(lastVoiceDuration.value)
		previewTime.value = formatPreviewTime(Date.now())
		voicePreview.value = true
	}
	function onPreviewBack(): void {
		voicePreview.value = false
	}
	function onPreviewClose(): void {
		voicePreview.value = false
		onClose()
	}
	function onRerecord(): void {
		voicePreview.value = false
		transcript.value = ''
		emotion.value = ''
		guardMsg.value = ''
		voiceHints.value = ''
		transcribing.value = false
		recording.value = false
		recState.value = 'idle'
		recordHint.value = '点击开始录音（≤30 分钟）'
		lastVoiceFile.value = ''
		lastVoiceDuration.value = 0
	}
	function onPreviewConfirm(): void {
		voicePreview.value = false
		submitVoice()
		closeForm()
	}
	function submitVoice(): void {
		const text = transcript.value.trim()
		if (text == '') {
			showErrorToast(new Error('转写内容为空'))
			return
		}
		saving.value = true
		saveVoiceContent(text, lastVoiceDuration.value, emotion.value, '', lastVoiceFile.value).then((contentId: string | null) => {
			saving.value = false
			if (contentId != null) {
				uni.showToast({ title: '已入库', icon: 'success' })
				emit('saved') // 修复（2026-08-31）：语音入库后通知宿主刷新
				transcript.value = ''
				emotion.value = ''
				guardMsg.value = ''
				voiceHints.value = ''
			} else {
				showErrorToast(new Error('入库失败'))
			}
		})
	}
</script>

<style>
	/* 视觉规范 v3：像素级还原 SVG 设计稿（390x844 画布）
	   背景 #f8f7f4 / 主文字 #3a2e25 / 次文字 #8a7a6a / 辅助 #b3a694
	   琥珀 #c4913c / 锈红 #b05a3a / 卡片 #ffffff / 弹层面板 #faf9f5 */
	.page {
		position: fixed;
		left: 0;
		top: 0;
		width: 750rpx;
		height: 100%;
		font-family: "Sarasa Gothic SC", sans-serif;
		/* 浮层根容器：透明底，遮罩交给 .scrim（z-index:10）。
		   z-index 1000 > TabBar 的 999，保证面板浮在 TabBar 之上。 */
		z-index: 1000;
	}
	.serif {
		font-family: "Sarasa Gothic SC", "Noto Serif CJK SC", serif;
	}

	/* ═══════ 模态遮罩 ═══════ */
	.scrim {
		position: absolute;
		top: 0;
		left: 0;
		width: 750rpx;
		height: 100%;
		background-color: rgba(26, 20, 15, 0.55);
		z-index: 10;
	}

	/* ═══════ 底部弹层：新的记忆 ═══════ */
	.sheet {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 654rpx;
		background-color: #faf9f5;
		border-top-left-radius: 77rpx;
		border-top-right-radius: 77rpx;
		z-index: 20;
	}
	.grab {
		position: absolute;
		top: 27rpx;
		left: 50%;
		margin-left: -46rpx;
		width: 92rpx;
		height: 10rpx;
		border-radius: 5rpx;
		background-color: #b3a696;
	}
	.sheet-title {
		font-family: "Sarasa Gothic SC", sans-serif;
		position: absolute;
		top: 74rpx;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 34rpx;
		color: #3a2e25;
		font-weight: 600;
	}
	.sheet-options {
		position: absolute;
		top: 192rpx;
		left: 38rpx;
		right: 38rpx;
		flex-direction: row;
		justify-content: space-between;
	}
	.option {
		width: 123rpx;
		flex-direction: column;
		align-items: center;
	}
	.option-icon {
		/* 尺寸走 CSS（uvue <image> 不支持 width/height 属性绑定） */
	}
	.icon-camera {
		/* 画布「相机」FRAME 26x26（i4_7 导出即 26x26，内径留白在 SVG 里） */
		width: 50rpx;
		height: 50rpx;
	}
	.icon-gallery {
		width: 50rpx;
		height: 50rpx;
	}
	.icon-mic {
		width: 50rpx;
		height: 50rpx;
	}
	.icon-keyboard {
		width: 50rpx;
		height: 50rpx;
	}
	.option-circle {
		width: 123rpx;
		height: 123rpx;
		border-radius: 62rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 3rpx 4rpx rgba(0, 0, 0, 0.067);
	}
	.c-photo {
		background-color: rgba(176, 89, 59, 0.12);
	}
	.c-gallery {
		background-color: rgba(196, 145, 60, 0.12);
	}
	.c-voice {
		background-color: rgba(122, 140, 90, 0.14);
	}
	.c-text {
		background-color: rgba(78, 125, 140, 0.13);
	}
	.option-label {
		font-family: "Sarasa Gothic SC", sans-serif;
		margin-top: 20rpx;
		font-size: 24rpx;
		color: #3a2e25;
	}
	.home-indicator {
		position: absolute;
		/* absolute-ok: 浮层底部 Home 指示条装饰 */
		left: 50%;
		margin-left: -134rpx;
		top: 615rpx;
		width: 269rpx;
		height: 10rpx;
		border-radius: 5rpx;
		background-color: #3a2e25;
		opacity: 0.18;
	}
	.sheet-hint {
		font-family: "Sarasa Gothic SC", sans-serif;
		position: absolute;
		top: 538rpx;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 22rpx;
		color: #b3a696;
	}

	/* ═══════ 功能层：记录表单 ═══════ */
	.form-layer {
		position: absolute;
		/* absolute-ok: 记录浮层表单层（浮层结构本体） */
		top: 0;
		left: 0;
		width: 750rpx;
		height: 100%;
		background-color: #faf9f5;
		z-index: 30;
		flex-direction: column;
	}

	/* ═══════ 照片模式布局（F1h–F1k，卡09 F1i 2/9） ═══════ */
	.photo-layout {
		flex: 1;
		flex-direction: column;
		position: relative;
		background-color: #f8f7f4;
	}
	.photo-head {
		position: relative;
		/* 状态栏区 16px 约 31rpx + 导航行 y=60px 约 115rpx */
		padding-top: 115rpx;
		padding-bottom: 24rpx;
		padding-left: 40rpx;
		padding-right: 40rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.ph-status-time {
		position: absolute;
		left: 46rpx;
		top: 31rpx;
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 29rpx;
		color: #3A2E25;
		font-weight: 500;
	}
	.photo-back {
		width: 48rpx;
		height: 48rpx;
		align-items: center;
		justify-content: center;
	}
	.ph-status-battery {
		position: absolute;
		right: 46rpx;
		top: 38rpx;
		width: 46rpx;
		height: 23rpx;
		border-radius: 8rpx;
		background-color: #3A2E25;
	}
	.photo-back-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 48rpx;
		color: #3a2e25;
		line-height: 48rpx;
	}
	.photo-title {
		font-family: "Sarasa Gothic SC", sans-serif;
		flex: 1;
		text-align: center;
		font-size: 33rpx;
		color: #3a2e25;
		font-weight: 600;
	}
	.photo-head-spacer {
		width: 48rpx;
		height: 48rpx;
	}
	.photo-scroll {
		flex: 1;
	}
	.photo-home-indicator {
		position: absolute;
		left: 240rpx;
		bottom: 21rpx;
		width: 269rpx;
		height: 10rpx;
		border-radius: 6rpx;
		background-color: #3A2E25;
	}
	.photo-section-label {
		font-family: "Sarasa Gothic SC", sans-serif;
		margin-left: 46rpx;
		margin-top: 8rpx;
		font-size: 25rpx;
		color: #8a7a6a;
		font-weight: 500;
	}
	.photo-card {
		margin-left: 46rpx;
		margin-right: 46rpx;
		margin-top: 23rpx;
		background-color: #ffffff;
		border-radius: 38rpx;
		padding: 38rpx;
		box-shadow: 0 12rpx 35rpx rgba(58, 46, 37, 0.06);
		overflow: hidden;
	}
	.photo-grid {
		flex-direction: row;
		flex-wrap: wrap;
	}
	.photo-item {
		position: relative;
		/* absolute-ok: 照片项内删除角标定位 */
		border-radius: 19rpx;
		overflow: hidden;
	}
	.photo-img {
		width: 100%;
		height: 100%;
		border-radius: 19rpx;
	}
	.photo-delete {
		position: absolute;
		/* absolute-ok: 删除角标固定在照片右上角（尺寸/位置/圆角由内联动态绑定，随大小图模式变化） */
		background-color: rgba(58, 46, 37, 0.6);
		align-items: center;
		justify-content: center;
	}
	.photo-delete-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 23rpx;
		color: #ffffff;
		line-height: 23rpx;
		text-align: center;
	}

	/* F1h：可见添加格（九宫格模式下的 ＋ 格） */
	.photo-add-cell {
		background-color: #ede5d5;
		/* 圆角由内联动态绑定：小图模式 15rpx（8px） */
		align-items: center;
		justify-content: center;
	}
	.photo-add-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 46rpx;
		color: #b3a696;
		line-height: 46rpx;
	}

	/* 分类区 */
	.cat-section {
		margin-left: 46rpx;
		margin-right: 46rpx;
		margin-top: 58rpx;
	}
	.cat-head {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}
	.cat-label {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 25rpx;
		color: #8a7a6a;
		font-weight: 500;
	}
	.cat-hint {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 23rpx;
		color: #b3a694;
		text-align: right;
	}
	.cat-chips {
		margin-top: 23rpx;
		flex-direction: row;
		align-items: center;
		height: 69rpx;
	}
	.cat-chip {
		height: 69rpx;
		padding-left: 27rpx;
		padding-right: 27rpx;
		background-color: #ffffff;
		border-radius: 35rpx;
		margin-right: 19rpx;
		align-items: center;
		justify-content: center;
	}
	.cat-chip-active {
		background-color: #ede5d5;
		border-width: 2rpx;
		border-color: #c4913c;
		border-style: solid;
		padding-left: 25rpx;
		padding-right: 25rpx;
	}
	.cat-chip-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 27rpx;
		color: #8a7a6a;
	}
	.cat-chip-text-active {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 27rpx;
		color: #8a5a20;
		font-weight: 500;
	}
	.cat-chip-add {
		width: 65rpx;
		padding-left: 0;
		padding-right: 0;
		margin-right: 0;
	}
	.cat-chip-add-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 31rpx;
		color: #b3a694;
		line-height: 31rpx;
	}

	/* 信息卡 */
	.info-card {
		margin-left: 46rpx;
		margin-right: 46rpx;
		margin-top: 73rpx;
		background-color: #ffffff;
		border-radius: 38rpx;
		padding-top: 42rpx;
		padding-bottom: 42rpx;
		padding-left: 38rpx;
		padding-right: 38rpx;
		box-shadow: 0 12rpx 35rpx rgba(58, 46, 37, 0.06);
	}
	.info-row {
		flex-direction: row;
		align-items: center;
	}
	.info-icon-wrap {
		width: 38rpx;
		height: 38rpx;
		align-items: center;
		justify-content: center;
	}
	.info-icon-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 28rpx;
		color: #8a7a6a;
		line-height: 28rpx;
	}
	.info-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		margin-left: 23rpx;
		font-size: 29rpx;
		color: #3a2e25;
	}
	.info-divider {
		margin-top: 29rpx;
		margin-bottom: 31rpx;
		margin-left: 0;
		height: 2rpx;
		background-color: #f0ebe2;
	}

	/* 确定钮：随内容流放置（位于信息卡之后） */
	.photo-confirm {
		/* 随内容流放置：canvas 真值 F1j y=550 / F1k y=756（信息卡之后，非固定底栏） */
		margin-left: 46rpx;
		margin-right: 46rpx;
		margin-top: 38rpx;
		height: 104rpx;
		background-color: #b05a3a;
		border-radius: 52rpx;
		align-items: center;
		justify-content: center;
		box-shadow: 0 12rpx 31rpx rgba(176, 90, 58, 0.3);
	}
	.photo-confirm-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 31rpx;
		color: #ffffff;
		font-weight: 500;
		line-height: 31rpx;
	}

	/* ═══════ 文字/语音模式：原有布局 ═══════ */
	.form-head {
		padding-top: 24rpx;
		padding-bottom: 24rpx;
		padding-left: 40rpx;
		padding-right: 40rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		border-bottom-width: 1rpx;
		border-bottom-color: rgba(58, 46, 37, 0.08);
		border-bottom-style: solid;
	}
	.form-back {
		width: 64rpx;
		height: 64rpx;
		align-items: center;
		justify-content: center;
	}
	.form-back-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 52rpx;
		color: #3a2e25;
		line-height: 52rpx;
	}
	.form-title {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 34rpx;
		color: #3a2e25;
		font-weight: 600;
	}
	.form-save {
		padding-left: 36rpx;
		padding-right: 36rpx;
		padding-top: 14rpx;
		padding-bottom: 14rpx;
		background-color: #b05a3a;
		border-radius: 28rpx;
	}
	.form-save-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		color: #f8f7f4;
		font-size: 26rpx;
	}
	.form-scroll {
		flex: 1;
	}
	.form-body {
		padding: 32rpx 40rpx 40rpx 40rpx;
		flex-direction: column;
	}

	/* 文字/语音通用 */
	.text-input {
		background-color: #ffffff;
		border-radius: 24rpx;
		padding: 24rpx;
		min-height: 280rpx;
		font-size: 30rpx;
		color: #3a2e25;
		box-shadow: 0 6rpx 16rpx rgba(58, 46, 37, 0.08);
	}
	.text-actions {
		margin-top: 24rpx;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}
	.muted {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 24rpx;
		color: #b3a696;
	}

	/* 语音面板 */
	.record-box {
		align-items: center;
		padding-top: 40rpx;
		padding-bottom: 40rpx;
		flex-direction: column;
	}
	.mic-btn {
		width: 160rpx;
		height: 160rpx;
		border-radius: 80rpx;
		background-color: #b05a3a;
		align-items: center;
		justify-content: center;
		display: flex;
		box-shadow: 0 8rpx 20rpx rgba(176, 90, 58, 0.4);
	}
	.mic-recording {
		background-color: #3a2e25;
	}
	.mic-icon {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 64rpx;
		color: #f8f7f4;
	}
	.record-hint {
		font-family: "Sarasa Gothic SC", sans-serif;
		margin-top: 24rpx;
		font-size: 26rpx;
		color: #8a7a6a;
	}
	.record-timer {
		font-family: "Sarasa Gothic SC", sans-serif;
		margin-top: 12rpx;
		font-size: 40rpx;
		color: #b05a3a;
		font-weight: bold;
	}
	.center-box {
		align-items: center;
		padding-top: 80rpx;
		flex-direction: column;
	}
	.transcript-box {
		flex-direction: column;
	}
	.transcript-head {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16rpx;
	}
	.transcript-title {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 30rpx;
		color: #3a2e25;
		font-weight: bold;
	}
	.emotion-chip {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 24rpx;
		color: #b05a3a;
		background-color: #F3E8DC;
		padding-left: 16rpx;
		padding-right: 16rpx;
		padding-top: 6rpx;
		padding-bottom: 6rpx;
		border-radius: 20rpx;
	}
	.interrupt-bar {
		margin-top: 24rpx;
		flex-direction: row;
		align-items: center;
		background-color: #F3E8DC;
		border-radius: 16rpx;
		padding-left: 24rpx;
		padding-right: 24rpx;
		padding-top: 16rpx;
		padding-bottom: 16rpx;
	}
	.interrupt-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		flex: 1;
		font-size: 26rpx;
		color: #8a7a6a;
	}
	.resume-btn {
		background-color: #b05a3a;
		border-radius: 24rpx;
		padding-left: 28rpx;
		padding-right: 28rpx;
		padding-top: 10rpx;
		padding-bottom: 10rpx;
	}
	.resume-text {
		font-family: "Sarasa Gothic SC", sans-serif;
		color: #f8f7f4;
		font-size: 26rpx;
	}
	.voice-hints {
		margin-top: 12rpx;
		margin-bottom: 12rpx;
		background-color: #F3E8DC;
		border-radius: 16rpx;
		padding-left: 20rpx;
		padding-right: 20rpx;
		padding-top: 10rpx;
		padding-bottom: 10rpx;
	}

	/* ===== F1e 写几句空态（卡05 还原，390x844 -> 750rpx SCALE=1.9231） ===== */
	.f1e-body {
		padding: 23rpx 46rpx 46rpx 46rpx;
		flex-direction: column;
	}
	.f1e-section-label {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 25rpx;
		color: #8A7A6A;
		font-weight: 500;
		margin-bottom: 23rpx;
	}
	.f1e-label-top {
		margin-top: 58rpx;
	}
	.f1e-category-label {
		margin-bottom: 0;
	}
	.f1e-input-card {
		height: 250rpx;
		background-color: #ffffff;
		border-radius: 38rpx;
		box-shadow: 0 12rpx 35rpx rgba(58, 46, 37, 0.06);
		overflow: hidden;
	}
	.f1e-textarea {
		width: 100%;
		height: 100%;
		padding: 38rpx;
		font-size: 29rpx;
		color: #3A2E25;
		line-height: 54rpx;
	}
	.f1e-category-head {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-top: 96rpx;
		margin-bottom: 23rpx;
	}
	.f1e-category-hint {
		font-family: "Sarasa Gothic SC", sans-serif;
		font-size: 23rpx;
		color: #B3A696;
	}
	.f1e-info-card {
		margin-top: 69rpx;
		background-color: #ffffff;
		border-radius: 38rpx;
		box-shadow: 0 12rpx 35rpx rgba(58, 46, 37, 0.06);
		padding-top: 42rpx;
		padding-bottom: 42rpx;
		padding-left: 38rpx;
		padding-right: 38rpx;
	}
	.f1e-info-row {
		flex-direction: row;
		align-items: center;
	}
	.f1e-icon-clock {
		width: 38rpx;
		height: 38rpx;
		position: relative;
		margin-right: 27rpx;
	}
	.clock-face {
		position: absolute;
		width: 34rpx;
		height: 34rpx;
		border-radius: 17rpx;
		border-width: 2rpx;
		border-color: #8A7A6A;
		border-style: solid;
		left: 0;
		top: 0;
	}
	.clock-hand-h {
		position: absolute;
		width: 2rpx;
		height: 9rpx;
		background-color: #8A7A6A;
		left: 16rpx;
		top: 9rpx;
	}
	.clock-hand-m {
		position: absolute;
		width: 9rpx;
		height: 2rpx;
		background-color: #8A7A6A;
		left: 12rpx;
		top: 16rpx;
	}
	.f1e-info-text {

<template>
	<!-- F5a 语音播放态规范：波形竖条阵列（index / search / detail 三处共用）
	     尺寸真值（F5a 帧）：容器 h=28pt(53.8rpx)、竖条 4pt 宽、gap 3pt、r=2pt
	     默认态：全部 idleColor —— detail 帧(F5b) 真值 #E5DCC8；index/search 现传 #C4913C（属其帧卡范围）
	     活动态：已播段 playedColor #C4913C、未播段 idleColor #E5DCC8（F5a 拍板色值），
	     当前根 bar 呼吸缩放（UniElement.animate，RecordSheet 轮盘同款真机先例） -->
	<view class="wave">
		<view
			v-for="(s, i) in barStyles"
			:key="i"
			class="wave-bar"
			:class="i === liveBarIdx ? 'wave-bar-live' : ''"
			:style="s"
			:id="barId(i)"
		></view>
	</view>
</template>

<script setup lang="uts">
	// BB3：呼吸门控要读全局播放态（audio_player 单例 ref，跨模块绑走 search.uvue 先例）
	import { voicePlaying } from '@/utils/audio_player'

	// 运行时声明 props（项目先例 TabBar.uvue；数组默认值按 UTS 已知问题需显式断言）
	const props = defineProps({
		/** 波形高度数组（rpx），由 genWaveHeights 生成 */
		heights: {
			type: Array,
			required: true
		},
		/** 是否为当前播放条（决定着色与呼吸动画） */
		active: {
			type: Boolean,
			default: false
		},
		/** 播放进度 0..1（非活动条恒传 0） */
		progress: {
			type: Number,
			default: 0
		},
		/** 已播段/空闲色（index 卡默认琥珀 #C4913C） */
		playedColor: {
			type: String,
			default: '#C4913C'
		},
		/** 未播段色（F5a 拍板 #E5DCC8） */
		idleColor: {
			type: String,
			default: '#E5DCC8'
		},
		/** BB3 真实波形（可选，0..1 峰值数组，来自后端 /contents/{id}/waveform）：
		     真值优先——非空且 len≥2 时按线性映射渲染真实波形；无效/缺省显式回退
		     genWaveHeights 伪波形（warn 日志不静默）。宿主零改动兼容（可不传） */
		waveform: {
			type: Array,
			required: false,
			default: null
		}
	})

	// BB3 真实波形有效性门（显式回退不静默）：warn 只发一次防 computed 重算刷屏
	let waveformWarned = false
	let useRealWave = computed((): boolean => {
		const wf = props.waveform
		if (wf == null) {
			return false
		}
		const arr = wf as Array<number>
		if (arr.length < 2) {
			if (!waveformWarned) {
				console.warn('[VoiceWave] waveform 无效（空/长度<2），回退伪波形')
				waveformWarned = true
			}
			return false
		}
		return true
	})

	/**
	 * F5a 真值：波形容器 h=28pt（53.8rpx），竖条高 12pt~28pt（23.1~53.8rpx）。
	 * heights（伪波形 8~40rpx 原始序列）按 min/max 归一化映射到真值区间；
	 * waveform（真实 0..1 峰值）直接线性映射（保真不重归一，静音段=最矮条）。
	 */
	let bars = computed((): Array<number> => {
		const out: Array<number> = []
		if (useRealWave.value) {
			const wf = props.waveform as Array<number>
			for (let i = 0; i < wf.length; i++) {
				let v = wf[i]
				if (v < 0) { v = 0 }
				if (v > 1) { v = 1 }
				out.push(23.1 + v * 30.7)
			}
			return out
		}
		const hs = props.heights as Array<number>
		let min = 0
		let max = 0
		for (let i = 0; i < hs.length; i++) {
			const v = hs[i]
			if (i === 0) {
				min = v
				max = v
			} else {
				if (v < min) {
					min = v
				}
				if (v > max) {
					max = v
				}
			}
		}
		const span = max - min
		for (let i = 0; i < hs.length; i++) {
			let r = 0.5
			if (span > 0) {
				r = (hs[i] - min) / span
			}
			out.push(23.1 + r * 30.7)
		}
		return out
	})

	let playedCount = computed((): number => {
		if (!props.active || props.progress <= 0) {
			return 0
		}
		const n = Math.floor((bars.value.length * props.progress))
		if (n > bars.value.length) {
			return bars.value.length
		}
		return n
	})

	/** 呼吸动画落在进度前沿那根 bar 上；未开播/播完则无 */
	let liveBarIdx = computed((): number => {
		if (!props.active || props.progress <= 0 || props.progress >= 1) {
			return -1
		}
		const c = playedCount.value
		return c > 0 ? c - 1 : 0
	})

	// R7 性能刀（2026-09-04）：每 bar 最终 style 预生成字符串 + 逐 bar 缓存对比——
	// 旧实现 :style 内联对象逐 tick 全量重建（28 对象/次渲染）；现值不变的 bar 复用缓存
	// 里的同一字符串（渲染层判等跳过原生更新），进度 tick 只有分界 ±1 与呼吸 bar
	// （height×1.3）两三根真正产生新串。:style 字符串绑定走 manage badgeStyle 先例；
	// 色值仍走 props（index/detail/favorites/search/theme-detail 五处宿主有自定义色），不入静态类
	let barStyleCache: Array<string> = []
	let barStyles = computed((): Array<string> => {
		const hs = bars.value
		const pc = playedCount.value
		const live = liveBarIdx.value
		const out: Array<string> = []
		for (let i = 0; i < hs.length; i++) {
			const h = (i === live ? hs[i] * 1.3 : hs[i])
			const bg = i < pc ? props.playedColor : props.idleColor
			const s = 'height:' + h + 'rpx;background-color:' + bg + ';'
			if (i < barStyleCache.length && barStyleCache[i] == s) {
				out.push(barStyleCache[i])
			} else {
				if (i < barStyleCache.length) {
					barStyleCache[i] = s
				} else {
					barStyleCache.push(s)
				}
				out.push(s)
			}
		}
		return out
	})

	// ===== B9 呼吸动画（BB3 · 2026-09-08） =====
	// 多实例元素定位：组件 setup 时生成实例唯一 id 前缀（挂载点 6 处，全局固定 id 必冲突；
	// RecordSheet :id="'rs-dot'+i" 动态绑定 + uni.getElementById 真机先例同款），不用全局固定 id
	const instPrefix = 'vw' + Math.floor(Math.random() * 1000000000) + '_'
	function barId(i: number): string {
		return instPrefix + i
	}

	// 呼吸门控 = 自条活动（liveBarIdx≥0）&& 全局真在出声（voicePlaying，暂停即停）；
	// 目标 bar 随进度前沿切换：watch 里 cancel 旧元素动画 → 新元素起 900ms 三关键帧
	// 三角波 scaleY 1→0.5→1（RecordSheet UniElement.animate 写法，§I A' 拍板机制）

	let liveAnim: UniAnimation | null = null
	function stopLiveAnim(): void {
		liveAnim?.cancel()
		liveAnim = null
	}
	function startLiveAnim(idx: number): void {
		stopLiveAnim()
		const el = uni.getElementById(barId(idx))
		if (el == null) {
			// 首帧竞态防御：bar 元素未就绪则本轮不呼吸（进度推进下轮 watch 再试）
			console.warn('[VoiceWave] live bar 元素未就绪 idx=' + idx)
			return
		}
		liveAnim = el.animate([
			{ transform: 'scaleY(1)' },
			{ transform: 'scaleY(0.5)' },
			{ transform: 'scaleY(1)' }
		], {
			duration: 900,
			iterations: Infinity,
			easing: 'linear'
		})
	}
	function syncLiveAnim(): void {
		const idx = liveBarIdx.value
		if (idx < 0 || !voicePlaying.value) {
			stopLiveAnim()
			return
		}
		startLiveAnim(idx)
	}
	watch(liveBarIdx, (): void => { syncLiveAnim() })
	watch(voicePlaying, (): void => { syncLiveAnim() })
	onUnmounted(() => { stopLiveAnim() })
</script>

<style>
	/* F5a 真值：容器 h=28pt（53.8rpx）；竖条 4pt 宽（7.7rpx）/ gap 3pt（5.8rpx）/ r2pt（3.8rpx） */
	.wave {
		flex: 1;
		flex-direction: row;
		align-items: center;
		height: 53.8rpx;
		overflow: hidden;
	}
	.wave-bar {
		width: 7.7rpx;
		border-radius: 3.8rpx;
		margin-right: 5.8rpx;
	}
	/* 呼吸缩放（F5a「波形跳动」）B9 已接线：目标 bar 由 watch(liveBarIdx/voicePlaying)
	   驱动 UniElement.animate scaleY 1↔0.5（RecordSheet 真机先例机制）；本类保留作语义标记 */
	.wave-bar-live {
		/* 动画走命令式 animate，此类无静态样式 */
	}
</style>

	}
	/* 组2 y250：说明 y232+13=245 → gap5=9.6rpx */
	.group-2 {
		margin-top: var(--d-lattice-p5, 9.6rpx);
	}
	/* ── 行：p12 图标20 文字15 值13；开关行 h52 / 值行 h44 ── */
	.row {
		padding: var(--d-card_radius_small, 23.1rpx);
		flex-direction: row;
		align-items: center;
	}
	/* 64:299 行图标：20×20 → 38.5rpx（库存 svg 见台账：眼睛无库存降级 icon-chat） */
	.row-icon {
		width: var(--d-card_margin_x, 38.5rpx);
		height: var(--d-card_margin_x, 38.5rpx);

/**
 * 忆述光华 · 相册监听插件 Android 纯 UTS 实现（B-UT-1/2/3/4 · 2026-08-24 决策调整）
 * Wave4 Agent K · B5d 升级（K-1a）：前台服务短命化 + microphone/dataSync 互斥
 *
 * 纯 UTS（无 .kt）：标准基座即可运行。UTS 直接继承 android.database.ContentObserver
 * 并调用 MediaStore/SharedPreferences/ActivityCompat（标准基座内置 androidx.core）。
 *
 * B5d 升级点：
 *  1. dataSync 前台服务（DataSyncService，注册于工程根 client/AndroidManifest.xml，FQN
 *     uts.sdk.modules.yishuPhotoWatch.DataSyncService —— 2026-09-11 D-19 实包定稿）：
 *     - 监听期间后台存活保活；短命化（自停：持续 30min 或空闲 10min → stopForeground+stopSelf）
 *     - 标准基座未注册服务 → 运行时检测自动回退页面级监听（与第一波行为一致，无回归）
 *  2. 类型互斥：录音中（setRecordingActive(true)，Agent J 录音插件调用）停止 dataSync 让位
 *     microphone；录音结束恢复 dataSync。两前台服务类型不同时开（B5d §3）。
 *  3. 统一调度：start() 自动引导 yishu-background-tasks 插件的 2h 周期 WorkManager（B5d §2）。
 *
 * 注意：不在此处 `export * from '../interface.uts'`——函数声明在 interface.uts，
 * 本文件按同名实现即可（重复导出曾触发编译器 overload panic）；
 * 类型单独具名再导出（error3：页面需从平台模块引用插件类型）。
 */
import { PhotoItem, PhotoBatchCallback, PhotoWatch, ForegroundActiveType, PermissionResultCallback } from '../interface.uts'
import { initBackgroundTasks } from '@/uni_modules/yishu-background-tasks/utssdk/app-android/index.uts'

// 类型具名再导出（供页面从平台模块路径引用）
export { PhotoItem, PhotoBatchCallback, PhotoWatch, ForegroundActiveType, PermissionResultCallback } from '../interface.uts'

/** 静默窗口：4s 无新照片变更 → 触发攒批回调（B-UT-4，3-5s 区间） */
const DEBOUNCE_MS: Long = 4000
const KEY_LAST_SEEN = 'last_seen_photo_id'
const REQ_READ_MEDIA = 2001
const ZERO_LONG: Long = 0

/**
 * 设备实际 SDK 等级（运行时读取）。
 *
 * ⚠️ 2026-09-11 D-23 修复（本波最致命缺陷）：
 * 原实现是 `const Build_VERSION_SDK_INT: Int = 33` —— 一个**硬编码字面量**，
 * 只是**命名伪装**成 android.os.Build.VERSION.SDK_INT，与设备毫无关系。
 * 后果链（实测设备 Android 12 / SDK 31）：
 *   readPermissionName() 恒走 >=33 分支 → 返回 API 33 才引入的 READ_MEDIA_IMAGES
 *   → 该权限在 API 31 上【物理不存在】（`pm grant` 报 Unknown permission，非用户拒授）
 *   → checkSelfPermission 恒 PERMISSION_DENIED
 *   → 宿主 `if (isReadPermissionGranted())` 恒 false
 *   → PhotoWatch.start() 从未执行 → dataSync 前台服务从未被 startService
 *   → 无通知渠道 / 无 ServiceRecord / 无通知（峰宝复验看到的"什么都没发生"）
 *
 * 写法依据：本文件已用同构写法 `android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI`
 * （嵌套类 + 静态字段），UTS 支持；官方文档 native/use/androidcomm.md 亦为 `Build.VERSION.SDK_INT`。
 *
 * 读取失败返回 0（走 legacy 权限分支）：fail-safe —— 宁可用兼容性最好的旧权限，
 * 也绝不"假装新版"去要一个本机不存在的权限。
 */
function sdkInt(): Int {
	try {
		return android.os.Build.VERSION.SDK_INT
	} catch (e: Throwable) {
		console.error('[yishu] 读取 Build.VERSION.SDK_INT 失败，按 legacy 分支处理: ' + (e != null && e.message != null ? e.message : 'unknown'))
		return 0
	}
}

// ---------- B5d · dataSync 前台服务（短命化）常量 ----------

/** 服务全限定名（与工程根 client/AndroidManifest.xml 的 <service android:name> 一致）。
 *  2026-09-11 D-19 实包定稿：UTS 插件默认命名空间 = uts.sdk.modules.<插件名驼峰>，
 *  本地模块 dex 实证类名 uts.sdk.modules.yishuPhotoWatch.DataSyncService
 *  （原值 'uni.UNIYISHU001.DataSyncService' 是手写 .kt 包名范式，对 UTS 源码类不成立——类不存在）。 */
const SERVICE_CLASS_FQN = 'uts.sdk.modules.yishuPhotoWatch.DataSyncService'
/** 前台服务通知 ID */
const NOTIF_ID: Int = 1002
const CHANNEL_ID = 'yishu_data_sync'
/** 短命化：服务最长存活（不常驻 24h，B5d §3）——30 分钟自停 */
const DATA_SYNC_MAX_LIFETIME_MS: Long = 30 * 60 * 1000
/** 短命化：空闲自停（无新照片）——10 分钟 */
const DATA_SYNC_IDLE_MS: Long = 10 * 60 * 1000
/** 看门狗轮询间隔 */
const WATCHDOG_INTERVAL_MS: Long = 60 * 1000

// ---------- B5d · 模块级状态（进程级共享：observer / 服务 / 互斥） ----------

let _recordingActive: boolean = false
let _serviceRunning: boolean = false
let _serviceStartedAt: Long = ZERO_LONG
let _lastActivityMs: Long = ZERO_LONG

let _appContext: android.content.Context | null = null
function appContext(): android.content.Context {
	const cached = _appContext
	if (cached != null) {
		return cached
	}
	const created = UTSAndroid.getAppContext()
	_appContext = created
	return created!
}

function prefs(): android.content.SharedPreferences {
	return appContext().getSharedPreferences('yishu_photo_watch', 0)
}

/**
 * 当前设备应请求的相册读权限名。
 * ⚠️ 2026-09-11 D-23：分支依据 `sdkInt()`（真实设备 SDK），**不再是硬编码字面量**。
 * 设备 Android 12/SDK 31 → READ_EXTERNAL_STORAGE；API 33+ → READ_MEDIA_IMAGES。
 */
function readPermissionName(): string {
	if (sdkInt() >= 33) {
		return "android.permission.READ_MEDIA_IMAGES"
	}
	return "android.permission.READ_EXTERNAL_STORAGE"
}

/** Array<string> → "a,b"（UTS 的 Array 无 join 先例，手写循环最稳） */
function listText(arr: Array<string>): string {
	let s = ''
	for (let i = 0; i < arr.length; i++) {
		if (i > 0) {
			s += ','
		}
		s += arr[i]
	}
	return s == '' ? '(空)' : s
}

/** EXIF DateTimeOriginal → epoch ms（EXIF 无时区=相机本地时间；设备本地即 +08） */
function readExifTaken(path: string): Long {
	try {
		const exif = new android.media.ExifInterface(path)
		const dt = exif.getAttribute(android.media.ExifInterface.TAG_DATETIME_ORIGINAL)
		if (dt != null && dt != '') {
			const parts = dt.split(' ')
			const d = parts[0].split(':')
			const t = parts.length > 1 ? parts[1].split(':') : ['0', '0', '0']
			if (d.length === 3) {
				const year = parseInt(d[0])
				const month = parseInt(d[1])
				const day = parseInt(d[2])
				const hour = t.length > 0 ? parseInt(t[0]) : 0
				const minute = t.length > 1 ? parseInt(t[1]) : 0
				const second = t.length > 2 ? parseInt(t[2]) : 0
				return new Date(year, month - 1, day, hour, minute, second).getTime() as Long
			}
		}
	} catch (e: Throwable) {
		// 读 EXIF 失败忽略，走 DATE_TAKEN/DATE_ADDED 回退（2026-08-24 真机：加日志定位端侧时间偏移根因）
		console.error('[yishu] EXIF 读取失败 ' + path + ': ' + (e != null && e.message != null ? e.message : 'unknown'))
	}
	return ZERO_LONG
}

/** ContentObserver 监听器：UTS 继承原生类（POC-01 路径，纯 UTS 版） */
class PhotoObserver extends android.database.ContentObserver {
	callback: PhotoBatchCallback | null = null
	debounceMs: Long
	pending: boolean = false

	constructor(handler: android.os.Handler, debounceMs: Long, callback: PhotoBatchCallback) {
		super(handler)
		this.debounceMs = debounceMs
		this.callback = callback
	}

	override onChange(selfChange: boolean, uri: android.net.Uri | null): void {
		// 静默窗口：多次变更合并为一次查询（连拍/批量导入折成 1 批）
		if (this.pending) {
			return
		}
		this.pending = true
		// 延迟查询（Handler 主线程 postDelayed）
		new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(() => {
			this.pending = false
			this.emitIncremental()
		}, this.debounceMs)
	}
/** 查询 last_seen 之后的照片并回调（无新照片则静默） */
	emitIncremental(): void {
		console.log('[yishu] emitIncremental begin')
		const cb = this.callback
		if (cb == null) {
			return
		}
		let lastSeen = prefs().getLong(KEY_LAST_SEEN, 0)
		const collectionUri: android.net.Uri = sdkInt() >= 29
			? android.provider.MediaStore.Images.Media.getContentUri("external")
			: android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI
		// projection/selectionArgs 传 null（UTSArray 与 Java Array 互转受限），
		// lastSeen 直接拼入 selection（值为自有存储的 long，无注入面）
		const selection: String = android.provider.MediaStore.Images.Media._ID + ' > ' + lastSeen
		const sortOrder: String = android.provider.MediaStore.Images.Media._ID + ' ASC'

		const items: Array<PhotoItem> = []
		let maxId = lastSeen
		try {
			const cursor = appContext().getContentResolver().query(
				collectionUri, null, selection, null, sortOrder
			)
			if (cursor != null) {
				while (cursor.moveToNext()) {
					const id = cursor.getLong(cursor.getColumnIndexOrThrow(android.provider.MediaStore.Images.Media._ID))
					if (id <= maxId) {
						continue
					}
					maxId = id
					const path = cursor.getString(cursor.getColumnIndexOrThrow(android.provider.MediaStore.Images.Media.DATA)) ?? ''
					// 优先级：EXIF(相机拍摄时间) → DATE_TAKEN → DATE_ADDED
					// （实测：MediaProvider scan_file 会把 DATE_TAKEN 写成扫描时间，EXIF 最可靠）
					let taken = readExifTaken(path)
					if (taken <= 0) {
						taken = cursor.getLong(cursor.getColumnIndexOrThrow(android.provider.MediaStore.Images.Media.DATE_TAKEN))
					}
					if (taken <= 0) {
						taken = cursor.getLong(cursor.getColumnIndexOrThrow(android.provider.MediaStore.Images.Media.DATE_ADDED)) * 1000
					}
					// GPS（LATITUDE/LONGITUDE，API 29+ 才有列；无 GPS 为 null → 端侧按时间窗归组）
					const latCol = cursor.getColumnIndex(android.provider.MediaStore.Images.Media.LATITUDE)
					const lngCol = cursor.getColumnIndex(android.provider.MediaStore.Images.Media.LONGITUDE)
					let lat: number | null = null
					let lng: number | null = null
					if (latCol >= 0 && lngCol >= 0 && !cursor.isNull(latCol) && !cursor.isNull(lngCol)) {
						lat = cursor.getDouble(latCol)
						lng = cursor.getDouble(lngCol)
					}
					// 文件大小（SIZE 列；2026-08-25 真机修复：getFileSystemManager().getFileInfo 沙箱读不了绝对路径）
					let size: number = 0
					const sizeCol = cursor.getColumnIndex(android.provider.MediaStore.Images.Media.SIZE)
					if (sizeCol >= 0 && !cursor.isNull(sizeCol)) {
						size = cursor.getLong(sizeCol)
					}
					items.push(new PhotoItem(
						id,
						path,
						taken,
						0,
						0,
						lat,
						lng,
						size
					))
				}
				cursor.close()
			}
		} catch (e: Throwable) {
			console.error('[yishu] 相册查询失败: ' + (e != null ? e.message : 'unknown'))
			return
		}

		// 首次启动：游标初始化为当前最大照片 id，跳过存量相册（隐私 + 首波只监听新增）
		if (lastSeen == ZERO_LONG) {
			prefs().edit().putLong(KEY_LAST_SEEN, maxId).apply()
			console.log('[yishu] init cursor to ' + maxId + ' (skip existing library)')
			return
		}

		if (items.length > 0) {
			// 先推进游标再回调：即使回调消费失败也不重复触发（轻量去重，B-UT-3）
			prefs().edit().putLong(KEY_LAST_SEEN, maxId).apply()
			console.log('[yishu] emitIncremental found ' + items.length + ', maxId=' + maxId)
			// B5d：记录最近活动时间（dataSync 前台服务看门狗空闲自停依据）
			_lastActivityMs = Date.now() as Long
			cb(items)
		} else {
			console.log('[yishu] emitIncremental found 0 (lastSeen=' + lastSeen + ')')
		}
	}
}

// ---------- B5d · dataSync 前台服务（短命化，microphone/dataSync 互斥中的 dataSync 侧） ----------

/** 服务是否已在本应用 AndroidManifest 注册（自定义基座 true / 标准基座 false） */
function isDataSyncServiceRegistered(): boolean {
	try {
		// queryIntentServices（List 接口，size() 方法——规避 UTSArray.length 类型问题）
		const probe = new android.content.Intent()
		probe.setClassName(appContext().getPackageName(), SERVICE_CLASS_FQN)
		const matches = appContext().getPackageManager().queryIntentServices(probe, 0)
		return matches != null && matches.size > 0
	} catch (e: Throwable) {
		// 查询失败按未注册处理（回退页面级监听）
	}
	return false
}

export class DataSyncService extends android.app.Service {
	// UTS 规则：父类有构造器时必须显式初始化（error：This type has a constructor）
	constructor() {
		super()
	}

	override onBind(intent: android.content.Intent | null): android.os.IBinder | null {
		return null
	}

	override onCreate(): void {
		super.onCreate()
		this.createChannel()
	}

	override onStartCommand(intent: android.content.Intent | null, flags: Int, startId: Int): Int {
		this.startForegroundInternal()
		this.scheduleWatchdog()
		return 2
	}

	override onDestroy(): void {
		_serviceRunning = false
		_serviceStartedAt = ZERO_LONG
		console.log('[yishu] dataSync 前台服务已停止（onDestroy）')
		super.onDestroy()
	}

	private createChannel(): void {
		if (sdkInt() < 26) {
			return
		}
		try {
			const channel = new android.app.NotificationChannel(CHANNEL_ID, '数据同步', 2)
			channel.setShowBadge(false)
			const nm = this.getSystemService("notification") as android.app.NotificationManager
			if (nm != null) {
				nm.createNotificationChannel(channel)
			}
		} catch (e: Throwable) {
			console.error('[yishu] 通知渠道创建失败: ' + (e != null && e.message != null ? e.message : 'unknown'))
		}
	}

	private buildNotification(): android.app.Notification {
		// API 26+ 必须挂 channelId，否则 startForeground 抛 RemoteServiceException（无通道）
		const builder = sdkInt() >= 26
			? new android.app.Notification.Builder(this, CHANNEL_ID)
			: new android.app.Notification.Builder(this)
		builder.setContentTitle('忆述光华 · 数据同步中')
		builder.setContentText('正在监听新照片，稍后自动停止')
		builder.setSmallIcon(17301633)
		builder.setOngoing(true)
		builder.setPriority(-2)
		return builder.build()
	}

	private startForegroundInternal(): void {
		try {
			const notification = this.buildNotification()
			if (sdkInt() >= 34) {
				this.startForeground(NOTIF_ID, notification, 1 << 7)
			} else {
				this.startForeground(NOTIF_ID, notification)
			}
			_serviceRunning = true
			_serviceStartedAt = Date.now() as Long
			console.log('[yishu] dataSync 前台服务 startForeground（type=dataSync）')
		} catch (e: Throwable) {
			console.error('[yishu] dataSync startForeground 失败: ' + (e != null && e.message != null ? e.message : 'unknown'))
			_serviceRunning = false
		}
	}

	private stopForegroundInternal(): void {
		try {
			this.stopForeground(true)
		} catch (e: Throwable) {
			console.error('[yishu] dataSync stopForeground 异常（忽略）: ' + (e != null && e.message != null ? e.message : 'unknown'))
		}
	}

	/** 短命化看门狗：持续超时（30min）或空闲超时（10min）→ 降级自停（后续转 WorkManager 静默任务） */
	private scheduleWatchdog(): void {
		new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(() => {
			if (!_serviceRunning) {
				return
			}
			const now: Long = Date.now() as Long
			const lifetime: Long = now - _serviceStartedAt
			const idle: Long = _lastActivityMs > 0 ? now - _lastActivityMs : ZERO_LONG
			if (lifetime >= DATA_SYNC_MAX_LIFETIME_MS || (idle > 0 && idle >= DATA_SYNC_IDLE_MS)) {
				console.log('[yishu] dataSync 短命化自停 lifetime=' + lifetime + 'ms idle=' + idle + 'ms')
				this.stopForegroundInternal()
				this.stopSelf()
				return
			}
			this.scheduleWatchdog()
		}, WATCHDOG_INTERVAL_MS)
	}
}

// ---------- 权限申请终态守卫（D-24 配套） ----------

/**
 * 单次权限申请的终态守卫 —— 保证宿主回调**恰好被调用一次**，且上报**复查后的真实**授予态。
 *
 * 为什么需要（两个真实约束，非防御性编程）：
 *  1. 官方文档明确：用户"部分授予"时 `success` 与 `fail` **都会被调用**。
 *     宿主若据此重复 `startWatch()` 会重复注册 ContentObserver（并重复拉起前台服务）。
 *  2. 回调参数是**系统自述**，未必等于最终态（如授权后用户立刻在后台撤销）。
 *     统一以 `checkSelfPermission` **复查值**为准，杜绝"回调说 true 但实际 false"。
 *
 * 拒绝路径也**必须打点**（违反即 D-24 同类缺陷：静默 = 无从定位）。
 */
class PermissionRequest {
	callback: PermissionResultCallback
	perm: string
	settled: boolean = false

	constructor(callback: PermissionResultCallback, perm: string) {
		this.callback = callback
		this.perm = perm
	}

	/** 落地终态；重复到达一律打点忽略（不静默丢弃） */
	settle(granted: boolean, doNotAskAgain: boolean, why: string): void {
		if (this.settled) {
			console.log('[yishu] 权限回调重复到达，已忽略 perm=' + this.perm + ' 来源=' + why)
			return
		}
		this.settled = true
		const real = appContext().checkSelfPermission(this.perm) == 0
		console.log('[yishu] 权限申请终态 perm=' + this.perm + ' sdk=' + sdkInt()
			+ ' 回调值=' + granted + ' 复查值=' + real + ' doNotAskAgain=' + doNotAskAgain + ' 来源=' + why)
		this.callback(real, doNotAskAgain)
	}
}

// ---------- PhotoWatch 实现 ----------

class PhotoWatchImpl implements PhotoWatch {
	observer: PhotoObserver | null = null
	registered: boolean = false

	start(callback: PhotoBatchCallback): void {
		const existing = this.observer
		if (existing == null) {
			this.observer = new PhotoObserver(android.os.Handler(android.os.Looper.getMainLooper()), DEBOUNCE_MS, callback)
		} else {
			// 幂等重启：仅替换回调，不重复注册
			existing.callback = callback
		}
		if (!this.registered) {
			const obs = this.observer
			if (obs != null) {
				const collectionUri: android.net.Uri = sdkInt() >= 29
					? android.provider.MediaStore.Images.Media.getContentUri("external")
					: android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI
				appContext().getContentResolver().registerContentObserver(collectionUri, true, obs)
				this.registered = true
				// 注册后立即初扫（B-UT-4）：授权后拉取 last_seen 之后的存量照片（MediaScanner 已入库）
				obs.emitIncremental()
			}
		}
		// B5d 统一调度：相册监听启动即拉起 2h 周期后台同步（WorkManager；标准基座 no-op，App 存活期 setInterval 兜底）
		initBackgroundTasks(2)
		// B5d 短命化前台服务（dataSync）：录音中不启（互斥）；服务未注册（标准基座）自动回退页面级监听
		if (!_recordingActive) {
			this.ensureDataSyncService()
		}
	}

	stop(): void {
		this.stopDataSyncService()
		const obs = this.observer
		if (this.registered && obs != null) {
			appContext().getContentResolver().unregisterContentObserver(obs)
			this.registered = false
		}
	}

	/** 启动 dataSync 前台服务（幂等 + 服务注册检测 + Android 12 后台启动限制兜底） */
	ensureDataSyncService(): void {
		if (_serviceRunning) {
			return
		}
		if (!isDataSyncServiceRegistered()) {
			console.log('[yishu] dataSync 服务未注册（标准基座），保持页面级监听')
			return
		}
		try {
			// UTS 不支持 X.class 字面量（error18），用 setClassName 显式指定服务组件
			const intent = new android.content.Intent()
			intent.setClassName(appContext().getPackageName(), SERVICE_CLASS_FQN)
			appContext().startService(intent)
			console.log('[yishu] dataSync 前台服务启动（startService）')
		} catch (e: Throwable) {
			// 服务未注册 / Android 12+ 后台启动限制 → 回退页面级监听（不崩）
			console.error('[yishu] dataSync 服务启动失败（回退页面级监听）: ' + (e != null && e.message != null ? e.message : 'unknown'))
			_serviceRunning = false
		}
	}

	/** 停止 dataSync 前台服务 */
	stopDataSyncService(): void {
		if (!_serviceRunning) {
			return
		}
		try {
			const intent = new android.content.Intent()
			intent.setClassName(appContext().getPackageName(), SERVICE_CLASS_FQN)
			appContext().stopService(intent)
		} catch (e: Throwable) {
			console.error('[yishu] dataSync 服务停止异常（忽略）: ' + (e != null && e.message != null ? e.message : 'unknown'))
		}
		_serviceRunning = false
	}

	getLastSeenId(): number {
		return prefs().getLong(KEY_LAST_SEEN, 0)
	}

	requestReadPermission(callback: PermissionResultCallback): void {
		const perm = readPermissionName()
		const req = new PermissionRequest(callback, perm)

		// 错误边界①：Activity 未就绪（App 不在前台 / 启动早期）—— 显式声明原因，不静默返回
		const activity = UTSAndroid.getUniActivity()
		if (activity == null) {
			req.settle(false, false, 'uniActivity 为 null（App 不在前台或 Activity 未就绪），未弹窗')
			return
		}

		const perms: Array<string> = [perm]

		// 错误边界②：已授予 —— 不弹窗，直接给终态
		if (UTSAndroid.checkSystemPermissionGranted(activity, perms)) {
			req.settle(true, false, '已授予，无需弹窗')
			return
		}

		console.log('[yishu] 拉起系统权限框 perm=' + perm + ' sdk=' + sdkInt())
		try {
			// 官方签名（UTSAndroid.d.ts:144）：(activity, permissions, success, fail, shallUnCheck)
			// 第 5 参显式传 false（doc 默认值），避免依赖可选参数推断
			UTSAndroid.requestSystemPermission(activity, perms,
				(allRight: boolean, grantedList: Array<string>): void => {
					req.settle(allRight, false, 'success(allRight=' + allRight + ' grantedList=' + listText(grantedList) + ')')
				},
				(doNotAskAgain: boolean, grantedList: Array<string>): void => {
					req.settle(false, doNotAskAgain, 'fail(doNotAskAgain=' + doNotAskAgain + ' grantedList=' + listText(grantedList) + ')')
				},
				false)
		} catch (e: Throwable) {
			// 错误边界③：系统拒绝拉起（隐私协议未同意 / 组件不可用等）—— 显式声明原因
			req.settle(false, false, 'requestSystemPermission 抛异常: ' + (e != null && e.message != null ? e.message : 'unknown'))
		}
	}

	/** 当前设备应请求的权限名（宿主打点用：区分"用户拒绝"与"本机无此权限"） */
	getReadPermissionName(): string {
		return readPermissionName()
	}

	isReadPermissionGranted(): boolean {
		const perm = readPermissionName()
		const granted = appContext().checkSelfPermission(perm) == 0
		// 不静默：每次守卫判定都打点（含真实 SDK 与权限名）。
		// 本次 D-23 事故正是因此处零日志，导致真机"什么都没发生"而无法定位。
		console.log('[yishu] 权限守卫 perm=' + perm + ' sdk=' + sdkInt() + ' granted=' + granted)
		return granted
	}

	// ---------- B5d · microphone/dataSync 互斥（录音插件 Agent J 域调用） ----------

	setRecordingActive(active: boolean): void {
		_recordingActive = active
		if (active) {
			// 录音开始：立即停止 dataSync 前台服务，让位 microphone 前台服务（B5d §3 两类型不同时开）
			this.stopDataSyncService()
			console.log('[yishu] 录音开始：dataSync 前台服务让位 microphone')
		} else {
			// 录音结束：恢复 dataSync（若监听仍挂载；stopForeground 降级后转 WorkManager）
			if (this.registered) {
				this.ensureDataSyncService()
			}
			console.log('[yishu] 录音结束：dataSync 前台服务恢复')
		}
	}

	isForegroundServiceActive(): boolean {
		return _serviceRunning
	}

	getActiveType(): ForegroundActiveType {
		if (_recordingActive) {
			return 'microphone'
		}
		if (_serviceRunning) {
			return 'dataSync'
		}
		if (!isDataSyncServiceRegistered()) {
			return 'unsupported'
		}
		return 'none'
	}
}

let _watch: PhotoWatchImpl | null = null

export function createPhotoWatch(): PhotoWatch {
	const w = _watch
	if (w == null) {
		const created = new PhotoWatchImpl()
		_watch = created
		return created
	}
	return w
}

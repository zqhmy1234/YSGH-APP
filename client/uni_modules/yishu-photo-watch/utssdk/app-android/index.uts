/**
 * 忆述光华 · 相册监听插件 Android 纯 UTS 实现（B-UT-1/2/3/4 · 2026-08-24 决策调整）
 *
 * 纯 UTS（无 .kt）：标准基座即可运行。UTS 直接继承 android.database.ContentObserver
 * 并调用 MediaStore/SharedPreferences/ActivityCompat（标准基座内置 androidx.core）。
 *
 * 注意：不在此处 `export * from '../interface.uts'`——函数声明在 interface.uts，
 * 本文件按同名实现即可（重复导出曾触发编译器 overload panic）；
 * 类型单独具名再导出（error3：页面需从平台模块引用插件类型）。
 */
import { PhotoItem, PhotoBatchCallback, PhotoWatch } from '../interface.uts'
import Build from 'android.os.Build'
import Manifest from 'android.Manifest'
import PackageManager from 'android.content.pm.PackageManager'
import Handler from 'android.os.Handler'
import Looper from 'android.os.Looper'
import ContentObserver from 'android.database.ContentObserver'
import Uri from 'android.net.Uri'
import MediaStore from 'android.provider.MediaStore'
import SharedPreferences from 'android.content.SharedPreferences'
import Context from 'android.content.Context'
import Intent from 'android.content.Intent'
import Settings from 'android.provider.Settings'
import ExifInterface from 'android.media.ExifInterface'

// 类型具名再导出（供页面从平台模块路径引用）
export { PhotoItem, PhotoBatchCallback, PhotoWatch } from '../interface.uts'

/** 静默窗口：4s 无新照片变更 → 触发攒批回调（B-UT-4，3-5s 区间） */
const DEBOUNCE_MS: Long = 4000
const KEY_LAST_SEEN = 'last_seen_photo_id'
const REQ_READ_MEDIA = 2001
const ZERO_LONG: Long = 0

let _appContext: Context | null = null
function appContext(): Context {
	const cached = _appContext
	if (cached != null) {
		return cached
	}
	const created = UTSAndroid.getAppContext()
	_appContext = created
	return created!
}

function prefs(): SharedPreferences {
	return appContext().getSharedPreferences('yishu_photo_watch', Context.MODE_PRIVATE)
}

function readPermissionName(): string {
	if (Build.VERSION.SDK_INT >= 33) {
		return Manifest.permission.READ_MEDIA_IMAGES
	}
	return Manifest.permission.READ_EXTERNAL_STORAGE
}

/** EXIF DateTimeOriginal → epoch ms（EXIF 无时区=相机本地时间；设备本地即 +08） */
function readExifTaken(path: string): Long {
	try {
		const exif = new ExifInterface(path)
		const dt = exif.getAttribute(ExifInterface.TAG_DATETIME_ORIGINAL)
		if (dt != null && dt != '') {
			const parts = dt.split(' ')
			const d = parts[0].split(':')
			const t = parts.length > 1 ? parts[1].split(':') : ['0', '0', '0']
			if (d.length === 3) {
				const year = parseInt(d[0])
				const month = parseInt(d[1])
				const day = parseInt(d[2])
				const hour = t.length > 0 ? parseInt(t[0]) : 0
				const minute = t.length > 1 ? parseInt(t[1]) : 0
				const second = t.length > 2 ? parseInt(t[2]) : 0
				return new Date(year, month - 1, day, hour, minute, second).getTime() as Long
			}
		}
	} catch (e: Error) {
		// 读 EXIF 失败忽略，走 DATE_TAKEN/DATE_ADDED 回退（2026-08-24 真机：加日志定位端侧时间偏移根因）
		console.error('[yishu] EXIF 读取失败 ' + path + ': ' + (e != null && e.message != null ? e.message : 'unknown'))
	}
	return ZERO_LONG
}

/** ContentObserver 监听器：UTS 继承原生类（POC-01 路径，纯 UTS 版） */
class PhotoObserver extends ContentObserver {
	callback: PhotoBatchCallback | null = null
	debounceMs: Long
	pending: boolean = false

	constructor(handler: Handler, debounceMs: Long, callback: PhotoBatchCallback) {
		super(handler)
		this.debounceMs = debounceMs
		this.callback = callback
	}

	override onChange(selfChange: boolean, uri: Uri | null): void {
		// 静默窗口：多次变更合并为一次查询（连拍/批量导入折成 1 批）
		if (this.pending) {
			return
		}
		this.pending = true
		// 延迟查询（Handler 主线程 postDelayed）
		Handler(Looper.getMainLooper()).postDelayed(() => {
			this.pending = false
			this.emitIncremental()
		}, this.debounceMs)
	}
/** 查询 last_seen 之后的照片并回调（无新照片则静默） */
	emitIncremental(): void {
		console.log('[yishu] emitIncremental begin')
		const cb = this.callback
		if (cb == null) {
			return
		}
		let lastSeen = prefs().getLong(KEY_LAST_SEEN, 0)
		const collectionUri: Uri = Build.VERSION.SDK_INT >= 29
			? MediaStore.Images.Media.getContentUri(MediaStore.VOLUME_EXTERNAL)
			: MediaStore.Images.Media.EXTERNAL_CONTENT_URI
		// projection/selectionArgs 传 null（UTSArray 与 Java Array 互转受限），
		// lastSeen 直接拼入 selection（值为自有存储的 long，无注入面）
		const selection: String = MediaStore.Images.Media._ID + ' > ' + lastSeen
		const sortOrder: String = MediaStore.Images.Media._ID + ' ASC'

		const items: Array<PhotoItem> = []
		let maxId = lastSeen
		try {
			const cursor = appContext().getContentResolver().query(
				collectionUri, null, selection, null, sortOrder
			)
			if (cursor != null) {
				while (cursor.moveToNext()) {
					const id = cursor.getLong(cursor.getColumnIndexOrThrow(MediaStore.Images.Media._ID))
					if (id <= maxId) {
						continue
					}
					maxId = id
					const path = cursor.getString(cursor.getColumnIndexOrThrow(MediaStore.Images.Media.DATA)) ?? ''
					// 优先级：EXIF(相机拍摄时间) → DATE_TAKEN → DATE_ADDED
					// （实测：MediaProvider scan_file 会把 DATE_TAKEN 写成扫描时间，EXIF 最可靠）
					let taken = readExifTaken(path)
					if (taken <= 0) {
						taken = cursor.getLong(cursor.getColumnIndexOrThrow(MediaStore.Images.Media.DATE_TAKEN))
					}
					if (taken <= 0) {
						taken = cursor.getLong(cursor.getColumnIndexOrThrow(MediaStore.Images.Media.DATE_ADDED)) * 1000
					}
					// GPS（LATITUDE/LONGITUDE，API 29+ 才有列；无 GPS 为 null → 端侧按时间窗归组）
					const latCol = cursor.getColumnIndex(MediaStore.Images.Media.LATITUDE)
					const lngCol = cursor.getColumnIndex(MediaStore.Images.Media.LONGITUDE)
					let lat: number | null = null
					let lng: number | null = null
					if (latCol >= 0 && lngCol >= 0 && !cursor.isNull(latCol) && !cursor.isNull(lngCol)) {
						lat = cursor.getDouble(latCol)
						lng = cursor.getDouble(lngCol)
					}
					items.push(new PhotoItem(
						id,
						path,
						taken,
						0,
						0,
						lat,
						lng
					))
				}
				cursor.close()
			}
		} catch (e: Error) {
			console.error('[yishu] 相册查询失败: ' + (e != null ? e.message : 'unknown'))
			return
		}

		// 首次启动：游标初始化为当前最大照片 id，跳过存量相册（隐私 + 首波只监听新增）
		if (lastSeen == ZERO_LONG) {
			prefs().edit().putLong(KEY_LAST_SEEN, maxId).apply()
			console.log('[yishu] init cursor to ' + maxId + ' (skip existing library)')
			return
		}

		if (items.length > 0) {
			// 先推进游标再回调：即使回调消费失败也不重复触发（轻量去重，B-UT-3）
			prefs().edit().putLong(KEY_LAST_SEEN, maxId).apply()
			console.log('[yishu] emitIncremental found ' + items.length + ', maxId=' + maxId)
			cb(items)
		} else {
			console.log('[yishu] emitIncremental found 0 (lastSeen=' + lastSeen + ')')
		}
	}
}

class PhotoWatchImpl implements PhotoWatch {
	observer: PhotoObserver | null = null
	registered: boolean = false

	start(callback: PhotoBatchCallback): void {
		if (this.observer == null) {
			this.observer = new PhotoObserver(Handler(Looper.getMainLooper()), DEBOUNCE_MS, callback)
		} else {
			// 幂等重启：仅替换回调，不重复注册
			this.observer.callback = callback
		}
		if (!this.registered) {
			const collectionUri: Uri = Build.VERSION.SDK_INT >= 29
				? MediaStore.Images.Media.getContentUri(MediaStore.VOLUME_EXTERNAL)
				: MediaStore.Images.Media.EXTERNAL_CONTENT_URI
			appContext().getContentResolver().registerContentObserver(collectionUri, true, this.observer)
			this.registered = true
			// 注册后立即初扫（B-UT-4）：授权后拉取 last_seen 之后的存量照片（MediaScanner 已入库）
			this.observer.emitIncremental()
		}
	}

	stop(): void {
		if (this.registered && this.observer != null) {
			appContext().getContentResolver().unregisterContentObserver(this.observer)
			this.registered = false
		}
	}

	getLastSeenId(): number {
		return prefs().getLong(KEY_LAST_SEEN, 0)
	}

	requestReadPermission(): void {
		const activity = UTSAndroid.getUniActivity()
		if (activity == null) {
			return
		}
		const perms: Array<string> = [readPermissionName()]
		if (UTSAndroid.checkSystemPermissionGranted(activity, perms)) {
			return
		}
		// 第一波简化：跳系统设置授权页（正式权限交互随自定义基座波次完善）
		const intent = new Intent(
			Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
			Uri.parse('package:' + appContext().getPackageName())
		)
		intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
		appContext().startActivity(intent)
	}

	isReadPermissionGranted(): boolean {
		const granted = PackageManager.PERMISSION_GRANTED
		return appContext().checkSelfPermission(readPermissionName()) == granted
	}
}

let _watch: PhotoWatchImpl | null = null

export function createPhotoWatch(): PhotoWatch {
	const w = _watch
	if (w == null) {
		const created = new PhotoWatchImpl()
		_watch = created
		return created
	}
	return w
}

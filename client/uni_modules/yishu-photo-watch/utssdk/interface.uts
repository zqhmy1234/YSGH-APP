/**
 * 忆述光华 · 相册监听与安全存储插件接口（B-UT-1）
 *
 * 系统能力层（UTS 插件）：
 *  1. 相册监听（PhotoObserver.kt，Hybrid Mode 平移自 research/poc/android）
 *     - ContentObserver + MediaScanner 兼容（POC-01 已验证）
 *     - 游标去重：SharedPreferences last_seen（照片 _id），已处理跳过（B-UT-3）
 *     - 静默窗口攒批：3-5s 无新照片 → 回调 uvue 层（B-UT-4）
 *  2. 安全存储（SecurePrefs.kt）：EncryptedSharedPreferences（token 等敏感值，B-CL-3）
 *
 * 接口文件只声明；实现位于 app-android/index.uts（函数声明由平台目录实现）。
 */

/** 单张新照片元数据（跨 UTS/Kotlin 以 JSON 桥接，字段与 MediaStore 游标一一对应） */
export interface PhotoItem {
	/** MediaStore _id */
	id: number
	/** 文件绝对路径（DATA） */
	path: string
	/** 拍摄时间 epoch 毫秒（DATE_TAKEN，缺失回退 DATE_ADDED*1000） */
	takenAt: number
	/** 宽（WIDTH，API 29+ 有值） */
	width: number
	/** 高（HEIGHT，API 29+ 有值） */
	height: number
}

/** 攒批回调：一批新照片（已按静默窗口去重） */
export type PhotoBatchCallback = (items: Array<PhotoItem>) => void

/** 相册监听器（实现位于 app-android，工厂函数创建） */
export interface PhotoWatch {
	/** 启动监听（幂等）；首次调用会在应用存活期间保持挂载 */
	start(callback: PhotoBatchCallback): void
	/** 停止监听 */
	stop(): void
	/** 读取当前游标（last_seen photo _id，用于 UI 展示状态） */
	getLastSeenId(): number
}

/** 创建相册监听器实例（跨端工厂，平台目录实现） */
export function createPhotoWatch(): PhotoWatch

/** 安全存储（EncryptedSharedPreferences，token/敏感值专用） */
export function setSecureString(key: string, value: string): void
export function getSecureString(key: string): string
export function removeSecureString(key: string): void

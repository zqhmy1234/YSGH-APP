/**
 * 语音录制状态机（B5.2f-2d · 2026-09-24 重构波 · **方案 A：整块 view-model 进 composable**）
 *
 * 自 `components/RecordSheet/RecordSheet.uvue` **纯移动**而来：
 *   · 13 个语音状态 ref（recording/recordSeconds/recordTimer/recState/lastTapAt/recordHint/
 *     voiceHints/transcribing/transcript/emotion/guardMsg/lastVoiceDuration/lastVoiceFile）；
 *   · 6 个状态机方法（setRecordingOff / toggleRecord / pauseRecordNow / endFromTap /
 *     resumeRecordNow / stopRecordNow）—— 注释与真机实锤记录**逐字保留**。
 *
 * 注入（组件侧仍持有的东西）：
 *   · `anim`：轮盘/圆点动画实例（暂停/恢复联动，原为组件内 `ra`）；
 *   · （2e 起）`onRecordStopped` 也已在类内，原先的 `onStopped` 注入**已撤销**；
 *   · `resetAiLabel`：清空组件 `aiLabel` 的动作（原 `aiLabel.value = ''` 一行，改回调等价）。
 *
 * 行为等价：状态为实例字段（组件用顶层绑定取同一 ref 对象，模板仍自动解包）；方法体逐字保留，
 * 仅把 `x.value`→`this.x.value`、`ra.`→`this.anim.`、内部互调→`this.<方法>`、`onRecordStopped(`→
 * `this.onRecordStopped(`。
 */
import { ref } from 'vue'

import { showErrorToast } from '@/utils/api'
import { createVoiceContentRemark } from '@/utils/capsule_api'
import { submitCorrection } from '@/utils/text_recorder'
import {
	addVoiceFailure,
	AsrResult,
	MSG_INTERRUPTED,
	MSG_NO_SOUND,
	pauseRecord,
	promptVoiceInvalid,
	promptVoiceRetry,
	REC_STATE_PAUSED,
	recorderState,
	removeVoiceFailure,
	resumeRecord,
	SCAN_SILENT,
	scanWavSilence,
	setShouldResume,
	startRecord,
	startRecordWatchdog,
	stopRecord,
	stopRecordWatchdog,
	transcribeWav,
	uploadVoicePersistent,
	VoiceScan
} from '@/utils/voice'

import { RecordAnimations } from '@/composables/useRecordAnimations'


export class VoiceRecorder {
	recording = ref(false)
	recordSeconds = ref(0)
	recordTimer = ref(0)
	recState = ref('idle')
	lastTapAt: number = 0
	recordHint = ref('轻触中央圆点 · 开始录音')
	voiceHints = ref('')
	transcribing = ref(false)
	transcript = ref('')
	emotion = ref('')
	guardMsg = ref('')
	lastVoiceDuration = ref(0)
	lastVoiceFile = ref('')
	// GAP-2 修复（2026-09-25）：2e 迁入时**漏声明本字段**（方法体已写 `this.saving.value`），
	// 而编译报绿（GAP-1）+ 轴 6 只管跨模块 import ⇒ 逃逸。现补声明，并新增轴 7 兜底。
	saving = ref(false)

	private anim: RecordAnimations
	private resetAiLabel: () => void
	/** 「放弃本次录音」标记（2026-10-11 静态审查）：组件卸载/关面板时置位 ⇒ 原生 onStop
	 *  回调走 onRecordStopped 时**只复位状态，不进入转写/上传/保存链**。
	 *  为什么需要：卸载时若直接 stopRecordNow，原生回调会带着时长进保存链 ⇒
	 *  「录音中按返回键」会变成"边退出边把这段录音存下来"（用户意图是取消）。 */
	private abandonFlag: boolean = false
	/** B-08（2026-10-24）：本次录音是否被判过"中断"（用于停录时给用户**合并**的一条明确提示）。
	 *  看门狗本身是 `voice.uts` 的模块单例（插件只可能有一段录音在录），这里只留判定结果。 */
	private interrupted: boolean = false

	private emitSaved: () => void
	private emitClose: () => void
	private setVoiceStage: (s: string) => void
	private effLabel: () => string
	private remarkTrimmed: () => string
	private resetFormFields: () => void

	constructor(
		anim: RecordAnimations,
		emitSaved: () => void,
		emitClose: () => void,
		setVoiceStage: (s: string) => void,
		effLabel: () => string,
		resetAiLabel: () => void,
		remarkTrimmed: () => string,
		resetFormFields: () => void
	) {
		this.anim = anim
		this.emitSaved = emitSaved
		this.emitClose = emitClose
		this.setVoiceStage = setVoiceStage
		this.effLabel = effLabel
		this.resetAiLabel = resetAiLabel
		this.remarkTrimmed = remarkTrimmed
		this.resetFormFields = resetFormFields
	}

	setRecordingOff(): void {
		this.recording.value = false
		this.anim.stop()
	}

	toggleRecord(): void {
		if (this.transcribing.value) {
			return
		}
		if (this.recording.value) {
			// 峰宝 09-02 拍板：单击=暂停/继续（立即生效，无 300ms 等待），连点两下=结束录音
			const now = Date.now()
			if (this.lastTapAt > 0 && now - this.lastTapAt < 400) {
				this.lastTapAt = 0
				this.endFromTap()
			} else {
				this.lastTapAt = now
				if (this.recState.value == REC_STATE_PAUSED) {
					this.resumeRecordNow()
				} else {
					this.pauseRecordNow()
				}
			}
		} else {
			this.lastTapAt = 0
			this.recording.value = true
			this.anim.start()
			this.recordSeconds.value = 0
			this.recState.value = 'idle'
			this.recordHint.value = '轻触暂停 · 连点两次结束'
			this.transcript.value = ''
			this.resetAiLabel()
			this.emotion.value = ''
			this.guardMsg.value = ''
			this.voiceHints.value = ''
			this.lastVoiceFile.value = ''
			// B-08：新一轮录音重置中断标记
			this.interrupted = false
			setShouldResume(true)
			this.recordTimer.value = setInterval(() => {
				this.recordSeconds.value++
			}, 1000) as number
			// 原生录音插件在标准基座缺失（UTSAndroid is not defined）→ 同步抛出会让状态机卡死，
			// 导致「录音中关不掉表单」。必须兜底：失败即回滚状态 + 提示。
			try {
			startRecord(
				() => {
					console.log('[yishu] record started')
					// B-08 ①（2026-10-24）：**真开录后**再起中断轮询自检。
					// 为什么不在 startRecord 之前起：权限未授予时 startRecord 走异步申请分支，
					// 此时原生态恒为 idle ⇒ 看门狗会立刻误判"录音被中断"（假阳性比缺陷更糟）。
					this.startWatchdogNow()
				},
				(path: string, durationMs: number) => {
					this.onRecordStopped(path, durationMs)
				},
				(msg: string) => {
					console.error('[yishu] record error: ' + msg)
					this.stopWatchdogNow()
					this.setRecordingOff()
					this.recState.value = 'idle'
					this.recordHint.value = '轻触中央圆点 · 开始录音'
					if (this.recordTimer.value > 0) {
						clearInterval(this.recordTimer.value)
						this.recordTimer.value = 0
					}
					// R7（2026-09-06）：Android RecorderManager 的 errMsg 是系统原文（如 "other errors"），
					// 用户看不懂。按常见根因翻译；无法识别时给可行动建议。常见触发：
					// 上次录音未正确释放（强退路径）后立刻再录 / 麦克风被系统占用 / 快速 start-stop 竞态。
					const m = msg.toLowerCase()
					if (m.indexOf('other') >= 0 || m.indexOf('fail') >= 0) {
						showErrorToast(new Error('录音器未就绪（可能被上次录音占用），请重试一次；仍失败请杀掉 App 重开'))
					} else if (m.indexOf('permission') >= 0 || m.indexOf('denied') >= 0) {
						showErrorToast(new Error('麦克风权限未开启，请在系统设置中允许'))
					} else {
						showErrorToast(new Error('录音失败：' + msg))
					}
				},
				(autoPaused: boolean) => {
					console.log('[yishu] record interrupted (autoPaused=' + autoPaused + ')')
					// B-08：原生回调来了就如实记下（能来是好事，但**不能指望它来**——
					// 真机抢麦实证两轮都不来，所以还有 ① 的轮询自检兜底）
					this.onInterrupted('native onInterruptionBegin')
					this.recState.value = recorderState()
					this.recordHint.value = '录音被中断，已暂停'
					// R7 补缺口：系统中断（来电/音频焦点/省电）时原生录音已自动暂停，但轮盘动画
					// 与计时器此前不联动——轮盘继续转+计时继续跑，与手动暂停（§M：全联动）不一致。
					// 对齐 pauseRecordNow 的联动集（轮盘/圆点动画 pause + 计时器冻结）
					this.anim.pause()
					if (this.recordTimer.value > 0) {
						clearInterval(this.recordTimer.value)
						this.recordTimer.value = 0
					}
				},
				(path: string, durationMs: number) => {
					console.log('[yishu] record auto-stop at 30min, saving segment: ' + durationMs + 'ms')
					this.onRecordStopped(path, durationMs)
				}
			)
			} catch (e) {
				console.log('[yishu] startRecord failed (标准基座无原生录音插件，状态回滚): ' + e)
				this.setRecordingOff()
				this.recState.value = 'idle'
				this.recordHint.value = '轻触中央圆点 · 开始录音'
				if (this.recordTimer.value > 0) {
					clearInterval(this.recordTimer.value)
					this.recordTimer.value = 0
				}
				// 铁律 10.8：能力不可用必须给 toast。只改 recordHint 文案用户看不见
				// （真机 2026-08-31 峰宝复验：「点麦克风不会有任何提示」）
				uni.showToast({ title: '当前基座不支持录音，请改用自定义基座', icon: 'none' })
			}
		}
	}
	// §M 手动暂停（方案 B，峰宝 2026-09-02 拍板）：原生已暂停，UI 计时器冻结 + 轮盘停转，
	// 恢复入口复用 interrupt-bar「继续录音」
	pauseRecordNow(): void {
		try {
			pauseRecord()
			this.recState.value = recorderState()
			this.anim.pause()
			if (this.recordTimer.value > 0) {
				clearInterval(this.recordTimer.value)
				this.recordTimer.value = 0
			}
			this.recordHint.value = '已暂停 · 轻触继续'
		} catch (e) {
			console.log('[yishu] pauseRecord failed (标准基座无原生插件，忽略): ' + e)
		}
	}

	// ── B-08 中断看门狗的启停（2026-10-24）────────────────────────────────────

	/** 起轮询自检（**只在该起的时机调**：原生 onStart 之后；停止时必调 `stopWatchdogNow`） */
	startWatchdogNow(): void {
		startRecordWatchdog((reason: string): void => {
			this.onInterrupted(reason)
		})
	}

	stopWatchdogNow(): void {
		stopRecordWatchdog()
	}

	/**
	 * 判定"录音被中断"后的 UI 联动（① 轮询自检 与 原生回调共用）。
	 *
	 * **只标记、不自动停录**（刻意）：中止判定可能来自 2.5s 的短暂卡顿，若自动 stop
	 * 会把用户正在说的话截断——那才是真正的数据损失。这里做的是**让用户当场知道**
	 * （hint 文案 + 恢复入口），最终是否有声音由停录后的零能量看门狗**客观裁定**。
	 */
	onInterrupted(reason: string): void {
		console.log('[yishu] 判定录音中断: ' + reason)
		this.interrupted = true
		this.recState.value = recorderState()
		this.recordHint.value = '录音被中断（可能来电），松开后可重录'
		this.anim.pause()
		if (this.recordTimer.value > 0) {
			clearInterval(this.recordTimer.value)
			this.recordTimer.value = 0
		}
	}
	// 双击结束：第一击可能已把原生录音置为暂停，先恢复原生态再停（stopped 回调统一走 onRecordStopped）
	endFromTap(): void {
		if (this.recState.value == REC_STATE_PAUSED) {
			try {
				resumeRecord()
			} catch (e) {
				console.log('[yishu] endFromTap resumeRecord failed (忽略): ' + e)
			}
		}
		this.stopRecordNow()
	}
	resumeRecordNow(): void {
		try {
			resumeRecord()
			this.recState.value = recorderState()
			this.anim.resume()
			// 计时器随恢复重启（暂停期间已冻结）
			if (this.recordTimer.value > 0) {
				clearInterval(this.recordTimer.value)
			}
			this.recordTimer.value = setInterval(() => {
				this.recordSeconds.value++
			}, 1000) as number
			this.recordHint.value = this.recState.value == REC_STATE_PAUSED ? '录音被中断，已暂停' : '轻触暂停 · 连点两次结束'
		} catch (e) {
			console.log('[yishu] resumeRecord failed (标准基座无原生插件，忽略): ' + e)
		}
	}
	stopRecordNow(): void {
		// B-08：**先收**看门狗再 stop——否则 stop 之后原生态转 idle 的那几毫秒里，
		// 看门狗会把"正常停止"误判成"录音被中断"（假阳性：用户明明是自己点的结束）。
		this.stopWatchdogNow()
		try {
			stopRecord()
		} catch (e) {
			console.log('[yishu] stopRecord failed (标准基座无原生插件，忽略): ' + e)
			// 兜底：原生不可用也要把 UI 状态复位，否则「录音中」永远退不出去
			this.setRecordingOff()
			this.recState.value = 'idle'
			this.recordHint.value = '轻触中央圆点 · 开始录音'
			if (this.recordTimer.value > 0) {
				clearInterval(this.recordTimer.value)
				this.recordTimer.value = 0
			}
		}
	}

	/**
	 * 放弃本次录音（**只停，不转写/不上传/不保存**）——组件卸载/面板关闭时用。
	 *
	 * 2026-10-11 静态审查：修复"卸载时停录音会顺带保存"——先置 `abandonFlag`，
	 * 原生 onStop 回调进入 `onRecordStopped` 时即走早退分支。
	 * 与 `stopRecordNow` 的区别只在语义：后者是"用户主动结束并要求处理"（进保存链）。
	 */
	abandonRecording(): void {
		// B-08：放弃也必收看门狗（否则卸载后定时器还在跑，回调和已销毁组件交互）
		this.stopWatchdogNow()
		this.interrupted = false
		if (!this.recording.value) {
			return
		}
		this.abandonFlag = true
		try {
			stopRecord()
		} catch (e) {
			console.log('[yishu] abandon stopRecord failed (标准基座无原生插件，忽略): ' + e)
			// 原生不可用：没有回调，直接自行复位
			this.abandonFlag = false
			this.setRecordingOff()
			this.recState.value = 'idle'
			this.recordHint.value = '轻触中央圆点 · 开始录音'
			if (this.recordTimer.value > 0) {
				clearInterval(this.recordTimer.value)
				this.recordTimer.value = 0
			}
		}
	}

	onRecordStopped(path: string, durationMs: number): void {
		// B-08：录音已停 ⇒ 立刻收中断看门狗（它只服务"录的过程中"）
		this.stopWatchdogNow()
		this.setRecordingOff()
		this.recState.value = 'idle'
		if (this.recordTimer.value > 0) {
			clearInterval(this.recordTimer.value)
			this.recordTimer.value = 0
		}
		// 🚨 2026-10-11 静态审查：放弃态（组件卸载中调 abandonRecording）**只复位、不进保存链**。
		// 否则「录音中按返回键关闭面板」会触发转写+上传+保存（用户意图是取消）。
		if (this.abandonFlag) {
			this.abandonFlag = false
			this.recordHint.value = '轻触中央圆点 · 开始录音'
			console.log('[yishu] 放弃态：录音已停止，不上传不保存')
			return
		}
		if (durationMs < 500) {
			this.recordHint.value = '轻触中央圆点 · 开始录音'
			// B-08 同族：太短也是"无效录音"的一种，这条不是静默（有 toast），但要清中断标记
			this.interrupted = false
			showErrorToast(new Error('录音太短'))
			return
		}
		this.lastVoiceDuration.value = durationMs
		this.lastVoiceFile.value = path
		if (durationMs >= 300000) {
			// 长录音（>5min）：分段转写走持久上传，无标注态（画布无此帧）——诚实收栈
			this.transcribing.value = false
			this.recordHint.value = '轻触中央圆点 · 开始录音'
			uni.showToast({ title: '长录音已提交，云端整理中', icon: 'none' })
			uploadVoicePersistent(path, durationMs).then((res: UTSJSONObject | null) => {
				console.log('[yishu] long voice uploaded: ' + (res != null ? JSON.stringify(res) : 'null'))
				if (res == null) {
					// B-09 同族（不许静默）：长录音上传失败也必须留可重试的记录
					addVoiceFailure(path, durationMs, '长录音上传失败')
					promptVoiceRetry('长录音上传失败', (): void => {
						this.retryLongUpload()
					})
					return
				}
				uni.showToast({ title: '已记录', icon: 'success' })
				this.emitSaved()
				this.emitClose()
			})
			return
		}
		// ② 零能量看门狗（B-08 核心）：**先用客观证据判这段有没有声音，再决定要不要转写**。
		// 顺序刻意如此——旧链路是"先转写再看结果"，于是全零录音要花一次网络往返才被告知没声音。
		this.transcribing.value = true
		this.recordHint.value = '正在检查录音…'
		const wasInterrupted = this.interrupted
		this.interrupted = false
		scanWavSilence(path).then((scan: VoiceScan) => {
			console.log('[yishu] voice scan verdict=' + scan.verdict + ' peak=' + scan.peak
				+ ' samples=' + scan.samples + ' reason=' + scan.reason)
			if (scan.verdict == SCAN_SILENT) {
				// **判死：不转写、不入队、不当成功**。用户看到的是明确的"没有声音 + 可重录"。
				this.transcribing.value = false
				this.recordHint.value = '轻触中央圆点 · 开始录音'
				this.transcript.value = ''
				// 中断过的段给"被中断"的文案（更贴近真实原因），否则给"没录到声音"
				const why = wasInterrupted ? MSG_INTERRUPTED : MSG_NO_SOUND
				// 取证留痕：真机上一句日志就能判断这是"抢占"还是"用户没说话"
				addBreadcrumb('voice', 'silent segment rejected: peak=' + scan.peak + ' samples=' + scan.samples + ' interrupted=' + wasInterrupted)
				promptVoiceInvalid(why, (): void => {
					this.startAgain()
				})
				return
			}
			// has_signal / unknown（unknown = 端侧读不到，**如实交回后端判**，不替它下结论）
			this.recordHint.value = '正在转写…'
			this.transcribeAndPreview(path, durationMs)
		})
	}

	/**
	 * 转写 → 填充预览态（**B-09 抽出来**：失败重试要复用同一条链，不能复制一份）。
	 *
	 * 三条"禁止静默"的落点都在这里：
	 * ① `res == null`（HTTP 非 200 / 超时 / 过大）⇒ 入失败队列 + modal「重试/稍后」；
	 * ② `outcome == 'no_speech'`（后端已判数字零）⇒ 按"没录到声音"处理，**不进预览态**；
	 * ③ `text` 为空 ⇒ 同上（旧行为是进一张空白卡片，用户到点保存才被告知空）。
	 */
	transcribeAndPreview(path: string, durationMs: number): void {
		this.transcribing.value = true
		transcribeWav(path).then((res: AsrResult | null) => {
			this.transcribing.value = false
			if (res == null) {
				// B-09：失败段**入本地待发队列** + 给可行动反馈（不再只 toast 一次就丢弃）
				this.recordHint.value = '转写失败 · 这段录音已保留'
				addVoiceFailure(path, durationMs, '转写失败（网络或服务不可用）')
				promptVoiceRetry('网络或服务不可用，转写没成功。', (): void => {
					this.retryTranscribe(path, durationMs)
				})
				return
			}
			// ② 后端说"没语音"（outcome=no_speech，来自 _wav_is_digital_silence）
			if (res.outcome == 'no_speech') {
				this.recordHint.value = '轻触中央圆点 · 开始录音'
				this.transcript.value = ''
				addBreadcrumb('voice', 'backend no_speech rejected (端侧扫描未能判定)')
				promptVoiceInvalid(MSG_NO_SOUND, (): void => {
					this.startAgain()
				})
				return
			}
			// ③ 有 outcome=succeeded 但文本为空：同样不能进"空白预览"
			if (res.text.trim() == '') {
				this.recordHint.value = '轻触中央圆点 · 开始录音'
				this.transcript.value = ''
				promptVoiceInvalid(MSG_NO_SOUND, (): void => {
					this.startAgain()
				})
				return
			}
			// 成功：销掉这条 path 可能残留的失败记录（重试成功后不留僵尸队列项）
			removeVoiceFailure(path)
			this.transcript.value = res.text
			this.emotion.value = res.emotion
			const hints: Array<string> = []
			if (res.notOral) {
				hints.push('疑似非口述（键盘/环境音）')
			}
			if (res.silenceHint) {
				hints.push('检测到静音空段，可删除')
			}
			const merge = res.emotionMerge
			if (merge != null) {
				const dm = merge.getJSON('dominant')
				if (dm != null) {
					// 🚨 2026-10-11 静态审查修复：原为 `dm.getString('this.emotion')` ——
					// 搬迁时「x.value → this.x.value」的批量替换**误伤了字符串字面量**
					// （emotion 是后端 JSON 键，不是 JS 成员），导致主导情绪永远取空。
					hints.push('主导情绪：' + (dm.getString('emotion') ?? '') + '（时长最长段）')
				}
			}
			if (res.noiseWeight == 'equal') {
				hints.push('噪音较大，情绪权重已降为持平')
			}
			this.voiceHints.value = hints.join('；')
			if (!res.guardPassed) {
				this.guardMsg.value = '内容未通过安全审核：' + res.guardReason
			} else {
				this.guardMsg.value = res.channel + ' 通道' + (res.mock ? '（mock）' : '') + ' · 置信度 ' + Math.round(res.confidence * 100) + '%'
			}
			this.setVoiceStage('preview') // F1c
		})
	}

	/** B-09：重试转写（保留同一 path / 时长；成功即销账，再失败则更新原因） */
	retryTranscribe(path: string, durationMs: number): void {
		if (this.transcribing.value) {
			return
		}
		this.lastVoiceDuration.value = durationMs
		this.lastVoiceFile.value = path
		this.recordHint.value = '正在重试转写…'
		this.transcribeAndPreview(path, durationMs)
	}

	/** B-09 同族：长录音上传重试 */
	retryLongUpload(): void {
		const path = this.lastVoiceFile.value
		const dur = this.lastVoiceDuration.value
		if (path == '') {
			showErrorToast(new Error('没有可重试的录音文件'))
			return
		}
		uni.showToast({ title: '正在重试上传…', icon: 'none' })
		uploadVoicePersistent(path, dur).then((res: UTSJSONObject | null) => {
			if (res == null) {
				addVoiceFailure(path, dur, '长录音上传失败')
				promptVoiceRetry('长录音上传仍然失败，已保留。', (): void => {
					this.retryLongUpload()
				})
				return
			}
			removeVoiceFailure(path)
			uni.showToast({ title: '已记录', icon: 'success' })
			this.emitSaved()
			this.emitClose()
		})
	}

	/**
	 * B-08 ③：用户点「重录」⇒ 复位到可录态。
	 *
	 * 注意**不自动开录**（刻意）：showModal 关闭后立刻 start 在部分机型上会被
	 * 音频焦点抢回（反而录出坏段）。这里把入口交给用户手指，只保证状态干净。
	 */
	startAgain(): void {
		this.stopWatchdogNow()
		this.interrupted = false
		this.setRecordingOff()
		this.recState.value = 'idle'
		this.transcript.value = ''
		this.guardMsg.value = ''
		this.voiceHints.value = ''
		this.lastVoiceFile.value = ''
		this.lastVoiceDuration.value = 0
		this.recordSeconds.value = 0
		this.recordHint.value = '轻触中央圆点 · 开始录音'
		if (this.recordTimer.value > 0) {
			clearInterval(this.recordTimer.value)
			this.recordTimer.value = 0
		}
		this.setVoiceStage('record')
	}
	submitVoice(): void {
		const text = this.transcript.value.trim()
		if (text == '') {
			showErrorToast(new Error('转写内容为空'))
			return
		}
		if (this.saving.value) {
			return
		}
		this.saving.value = true
		const picked = this.effLabel()
		const duration = this.lastVoiceDuration.value
		const vFile = this.lastVoiceFile.value
		const emo = this.emotion.value
		// BA1（FE2）：备注卡接真——remark 快照（保存成功后会清空，闭包内不能读 ref）
		const remarkVal = this.remarkTrimmed()
		// R9-B1（2026-09-06 峰宝拍板「有音频数据必须能播=P0」）：主链走分片上传——
		// wav 先落对象存储（cos_key），后端 complete 直接建 voice content（本地转写 text
		// 预填 + 入队 ASR 管线）。旧 saveVoiceContent(''cosKey) 只落文本不传文件，
		// 造成「有转写无音频」恒不可播（28 条 failed=AUDIO_DOWNLOAD_FAILED 实锤）。
		// A8 主链闭环（2026-09-09）：后端 complete voice 分支已收 remark → uploadVoicePersistent
		// 透传 remarkVal，主链成功路径备注一次落库（不再仅降级链入库）。
		if (vFile == '') {
			// 无本地录音文件（异常路径，如实降级）：仅落文本，toast 显式告知无音频
			createVoiceContentRemark(text, duration, remarkVal, '').then((contentId: string | null) => {
				this.saving.value = false
				if (contentId != null) {
					this.afterVoiceSaved(contentId, text, picked, false)
				} else {
					showErrorToast(new Error('语音入库失败（无本地录音文件且文本入库未成功）'))
				}
			})
			return
		}
		uploadVoicePersistent(vFile, duration, text, emo, remarkVal).then((res: UTSJSONObject | null) => {
			let contentId: string | null = null
			if (res != null) {
				contentId = res.getString('content_id')
			}
			if (contentId != null && contentId != '') {
				this.saving.value = false
				this.afterVoiceSaved(contentId, text, picked, true)
			} else {
				// 音频上传失败（显式降级，不静默）：仅落转写文本，cos_key 留空 → 播放链
				// 会诚实报「音频未上传」；toast 明说原因，峰宝铁律：不允许静默
			console.error('[yishu] voice upload failed, fallback text-only save')
			createVoiceContentRemark(text, duration, remarkVal, vFile).then((fbId: string | null) => {
					this.saving.value = false
					if (fbId != null) {
						this.afterVoiceSaved(fbId, text, picked, false)
					} else {
						showErrorToast(new Error('语音保存失败（音频上传与文本入库均未成功）'))
					}
				})
			}
		})
	}

	/** 语音保存成功后的统一收尾（R9-B1 抽取）：手选分类纠正 + toast + 清态 + 收起浮层 */
	afterVoiceSaved(contentId: string, text: string, picked: string, audioOk: boolean): void {
		if (picked != '' && picked.indexOf('custom:') != 0) {
			// 手选分类 → 纠正端点真持久化（custom: 前缀 = 自定义分类跳过，后端白名单不支持——台账 A 类）
			submitCorrection(contentId, text, picked, '', 'voice').then((ok: boolean) => {
				console.log('[yishu] voice manual correction ok=' + ok)
			})
		}
		if (audioOk) {
			uni.showToast({ title: '已记录', icon: 'success' })
		} else {
			// 降级路径显式告知：文本已存但音频没有（峰宝铁律：不允许静默）
			uni.showToast({ title: '已存文本（音频未上传）', icon: 'none', duration: 2500 })
		}
		this.emitSaved()
		this.transcript.value = ''
		this.emotion.value = ''
		this.guardMsg.value = ''
		this.voiceHints.value = ''
		this.resetFormFields()
		this.setVoiceStage('record')
		this.emitClose() // 拍板（2026-09-01）：保存去向 = 整栈收起回宿主页 + 轻 toast
	}
}

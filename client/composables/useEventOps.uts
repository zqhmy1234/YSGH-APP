/**
 * 事件卡片操作 / 确认 / 合并 / 拆分（L-02b · 2026-09-25 重构波 · **方案 A：整块 view-model 进 composable**）
 *
 * 自 `components/TabIndex/TabIndex.uvue` **纯移动**而来：
 *   · 状态：拆分面板四态（showSplitPanel / splitEventId / splitItems / splitLoading）；
 *   · 方法：onCardOps（动作面板）/ doConfirm / confirmPending / ignorePending /
 *     patchEventById / removeEventById / getPrevL1Id / doMerge / doSplit /
 *     toggleSplitItem / confirmSplit / cancelSplit / splitTimeText —— 注释与「2026-08-31 修复」
 *     这类真机实锤记录**逐字保留**。
 *
 * 注入（仍属组件渲染管线核心、不随本 composable 搬走的东西）：
 *   · `getCurrent`：读当前渲染数据源——组件里 `currentEvents` 是 `let`、会被**整组浅替换**，
 *     故传**取值函数**而非数组快照（传快照会在下次刷新后指向旧数组）；
 *   · `render`：整组浅替换渲染出口（原 `renderFromEvents`）；
 *   · `refresh`：无闪屏静默刷新（原 `refreshSilently`）；
 *   · `getDays`：读日组（原 `days.value`，`getPrevL1Id` 用）。
 *
 * 行为等价：状态为实例字段（组件经顶层绑定取同一 ref 对象）；方法体逐字保留，仅把
 * `x.value`→`this.x.value`、`currentEvents`→`this.getCurrent()`、`renderFromEvents(currentEvents)`
 * →`this.render(evs)`、`refreshSilently()`→`this.refresh()`、`days.value`→`this.getDays()`、
 * 内部互调→`this.<方法>`。
 */
import { ref } from 'vue'

import {
	confirmEvent,
	mergeEvent,
	fetchEventItems,
	splitEvent,
	SplitItem,
	ignoreEventLocally
} from '@/utils/event_ops'
import { formatMonthDay } from '@/utils/time'
import { TimelineEvent, DayGroup } from '@/utils/timeline'

export class EventOps {
	showSplitPanel = ref(false)
	splitEventId = ref('')
	splitItems = ref<Array<SplitItem>>([])
	splitLoading = ref(false)

	private getCurrent: () => Array<TimelineEvent>
	private render: (evs: Array<TimelineEvent>) => void
	private refresh: () => void
	private getDays: () => Array<DayGroup>

	constructor(
		getCurrent: () => Array<TimelineEvent>,
		render: (evs: Array<TimelineEvent>) => void,
		refresh: () => void,
		getDays: () => Array<DayGroup>
	) {
		this.getCurrent = getCurrent
		this.render = render
		this.refresh = refresh
		this.getDays = getDays
	}

	onCardOps(ev: TimelineEvent, dayKeyStr: string): void {
		// ── 菜单恒稳（2026-10-25 · D-21 可供性修复）─────────────────────────────
		// 旧行为：L1 出三项、L2 只出一项 ⇒ **菜单项数量随卡片变化**，用户点每张卡都得
		// 重新读一遍（"上次这里能拆分，这次怎么没了"），也就形成不了"操作入口在这里"的预期。
		// 现在：**任何卡都是三项**，不可用的项不消失，而是**在标签里写明原因**；
		// 点它则给一条 toast 解释为什么不可用 —— 不做"点了没反应"的死项（那是更差的静默）。
		//
		// 判定全部用**本地已加载数据**（零网络）：拆分看 `contentCount`（后端 timeline 随卡下发，
		// `events.py` 的 `_counts_by_event` GROUP BY 真实计数）；合并看"前面还有没有更早的 L1 日卡片"。
		// ⚠️ 这只是**前置提示**，不是硬闸：真正的保护仍在 `doSplit`（成员不足自会 toast）
		// 与后端 `split_event`（内容必须属于该事件）。本函数**不改** doSplit/doMerge 的行为，
		// 也不碰 `getPrevL1Id(fromDayKey)` 那条 task-12 的日键修复。
		const isL1 = ev.level === 1
		const canSplit = ev.contentCount >= 2
		const canMerge = isL1 && this.getPrevL1Id(dayKeyStr) != ''

		const items: Array<string> = []
		const reasons: Array<string> = []   // 与 items 同下标：空串 = 可用
		const acts: Array<string> = []      // 'confirm' | 'split' | 'merge'

		// ① 确认（恒可用）
		items.push(isL1 ? '确认这张卡' : '确认这个主题')
		reasons.push('')
		acts.push('confirm')

		// ② 拆分（恒在；不可用时在标签里说明）
		if (canSplit) {
			items.push(isL1 ? '拆分这张卡' : '拆分这个主题')
			reasons.push('')
		} else {
			items.push((isL1 ? '拆分这张卡' : '拆分这个主题') + '（只有 1 条内容）')
			reasons.push('这张只有 1 条内容，拆不出来（至少要 2 条）')
		}
		acts.push('split')

		// ③ 合并到上一张（恒在；不可用时在标签里说明）
		if (canMerge) {
			items.push('合并到上一张')
			reasons.push('')
		} else if (!isL1) {
			// L2 主题不是"某一天的卡"，并入上一张日卡会跨层级（后端 `merge_events` 只搬成员，
			// 会把主题内容挂进日卡）⇒ 刻意只对日卡片开放，并**明确告知**而不是藏起来。
			items.push('合并到上一张（仅日卡片可合并）')
			reasons.push('合并只对日卡片开放：主题请先确认，再到日卡片上合并')
		} else {
			items.push('合并到上一张（前面没有日卡片）')
			reasons.push('这张是当前最早的一张，前面没有可合并的日卡片')
		}
		acts.push('merge')

		uni.showActionSheet({
			itemList: items,
			success: (res) => {
				const idx = res.tapIndex
				if (idx < 0 || idx >= items.length) {
					return
				}
				const why = reasons[idx]
				if (why != '') {
					// 不可用项：**必须给反馈**（点了没反应 = 静默，正是本卡要消灭的形态）
					uni.showToast({ title: why, icon: 'none', duration: 2500 })
					return
				}
				const act = acts[idx]
				if (act == 'confirm') {
					this.doConfirm(ev)
				} else if (act == 'split') {
					this.doSplit(ev)
				} else if (act == 'merge') {
					this.doMerge(ev, dayKeyStr)
				}
			},
			fail: () => {}
		})
	}
	// 卡PA R2：按事件 id 定位局部替换单事件对象（改 currentEvents=缓存同引用 → 整组浅替换触发）
	patchEventById(eventId: string, mutate: (ev: TimelineEvent) => void): void {
		const evs = this.getCurrent()
		for (let i = 0; i < evs.length; i++) {
			if (evs[i].id == eventId) {
				mutate(evs[i])
				break
			}
		}
		this.render(evs)
	}
	// 卡PA R2：结构性变化（合并=事件消失）按 id splice 掉（同数组改动直接同步缓存）
	removeEventById(eventId: string): void {
		const evs = this.getCurrent()
		for (let i = 0; i < evs.length; i++) {
			if (evs[i].id == eventId) {
				evs.splice(i, 1)
				break
			}
		}
		this.render(evs)
	}
	doConfirm(ev: TimelineEvent): void {
		confirmEvent(ev.id).then((ok: boolean) => {
			if (ok) {
				uni.showToast({ title: '已确认', icon: 'none' })
				// 卡PA R2：本地补丁 status，confirmed 自动离开待确认区落入日组
				this.patchEventById(ev.id, (e: TimelineEvent): void => { e.status = 'confirmed' })
			} else {
				uni.showToast({ title: '确认失败', icon: 'none' })
			}
		})
	}
	/**
	 * 向前找第一张更早的 L1 事件（「合并到上一张」的目标）。
	 *
	 * 🚨 2026-10-25（task-12 ③ · **真 bug 修复**）：入参由 **日组下标** 改为 **日组键**。
	 *
	 * 原缺陷：模板 `v-for="(day, dayIdx) in visibleDays"` 的 `dayIdx` 是**过滤后**数组的下标，
	 * 而本函数拿 `this.getDays()`（**未过滤、含今天**）去索引 —— 两个数组不同长不同位：
	 *   · `visibleDays = historyDays.slice(0, N)`，`historyDays = days.filter(d => d.key != today)`；
	 *   · `days` 按 `startTime` **倒序** ⇒ **今天恒在 `days[0]`** ⇒ 历史区所有日组整体**偏移 1**。
	 * 后果（用户可见）：
	 *   · 最新历史日（`dayIdx=0`）永远 toast「没有可合并的上一张」（它检查的是今天那组，看有没有更早的 —— 循环 `i = -1` 直接不跑）；
	 *   · `dayIdx=1` 时实际检查的是**今天**组，且「上一张」会落在今天的卡上 —— **把历史卡合并进今天** ✗。
	 *
	 * 修法选择「传日键」而不是「传过滤后的日组列表」：日键是**稳定标识**（`yyyy-mm-dd`，
	 * 与 `buildDayGroups`/`history_days` 同源），不随分页窗口 `visibleDayCount` 变化而漂移；
	 * 传列表则每次 slice 变化后必须重算，且调用方（模板）要多维护一份状态 ✗。
	 *
	 * @param fromDayKey 当前卡所在**日组的键**（`DayGroup.key` / `HistoryDay.key`）
	 */
	getPrevL1Id(fromDayKey: string): string {
		const days = this.getDays()
		// 先定位当前日组在**未过滤**数组里的真实下标（找不到 = 数据已刷新，按"没有上一张"处理）
		let startIdx = -1
		for (let i = 0; i < days.length; i++) {
			if (days[i].key == fromDayKey) {
				startIdx = i
				break
			}
		}
		if (startIdx < 0) {
			return ''
		}
		// 从**当前日组的前一组**开始向前找第一张更早的 L1（原 2026-08-31 修复的正解：向前逐日找）
		for (let i = startIdx - 1; i >= 0; i--) {
			const evs = days[i].events
			for (let j = 0; j < evs.length; j++) {
				if (evs[j].level === 1) {
					return evs[j].id
				}
			}
		}
		return ''
	}
	doMerge(ev: TimelineEvent, fromDayKey: string): void {
		const targetId = this.getPrevL1Id(fromDayKey)
		if (targetId == '') {
			uni.showToast({ title: '没有可合并的上一张', icon: 'none' })
			return
		}
		mergeEvent(ev.id, targetId).then((ok: boolean) => {
			if (ok) {
				uni.showToast({ title: '已合并', icon: 'none' })
				// 卡PA R2：合并后源卡消失 → 按 id 局部移除（目标卡计数待下次 TTL 刷新自愈）
				this.removeEventById(ev.id)
			} else {
				uni.showToast({ title: '合并失败', icon: 'none' })
			}
		})
	}

	// 拆分
	doSplit(ev: TimelineEvent): void {
		this.splitLoading.value = true
		this.showSplitPanel.value = true
		this.splitEventId.value = ev.id
		this.splitItems.value = []
		fetchEventItems(ev.id).then((items: Array<SplitItem>) => {
			this.splitLoading.value = false
			this.splitItems.value = items
			if (items.length < 2) {
				uni.showToast({ title: '成员不足，无法拆分', icon: 'none' })
			}
		})
	}
	toggleSplitItem(idx: number): void {
		const items = this.splitItems.value
		if (idx < 0 || idx >= items.length) {
			return
		}
		const it = items[idx]
		it.selected = !it.selected
		items[idx] = it
		this.splitItems.value = items
	}
	confirmSplit(): void {
		const items = this.splitItems.value
		const ids: Array<string> = []
		for (let i = 0; i < items.length; i++) {
			if (items[i].selected) {
				ids.push(items[i].contentId)
			}
		}
		if (ids.length == 0) {
			uni.showToast({ title: '至少选择一条', icon: 'none' })
			return
		}
		if (ids.length >= items.length) {
			uni.showToast({ title: '需至少留一条在原卡', icon: 'none' })
			return
		}
		splitEvent(this.splitEventId.value, ids).then((ok: boolean) => {
			this.showSplitPanel.value = false
			if (ok) {
				uni.showToast({ title: '已拆分', icon: 'none' })
			} else {
				uni.showToast({ title: '拆分失败', icon: 'none' })
			}
			// 卡PA R2（拍板采纳的偏差方案）：拆分产生服务端新事件 id，本地无法合成 →
			// 无闪屏后台静默刷新（不清 days、不回退加载态），刷新完浅替换
			this.refresh()
		})
	}
	cancelSplit(): void {
		this.showSplitPanel.value = false
		this.splitItems.value = []
	}
	splitTimeText(ts: number): string {
		if (ts <= 0) {
			return '时间未知'
		}
		return formatMonthDay(ts)
	}

	// 待确认
	confirmPending(ev: TimelineEvent): void {
		confirmEvent(ev.id).then((ok: boolean) => {
			if (ok) {
				uni.showToast({ title: '已确认', icon: 'none' })
				// 卡PA R2：本地补丁 status，confirmed 自动离开待确认区落入日组
				this.patchEventById(ev.id, (e: TimelineEvent): void => { e.status = 'confirmed' })
			} else {
				uni.showToast({ title: '确认失败', icon: 'none' })
			}
		})
	}
	ignorePending(ev: TimelineEvent): void {
		ignoreEventLocally(ev.id)
		uni.showToast({ title: '已忽略（本机隐藏）', icon: 'none' })
		// 卡PA R2：本地补丁后直接重渲染（loadIgnoredIds 每次现读，忽略表即时生效）
		this.render(this.getCurrent())
	}
}
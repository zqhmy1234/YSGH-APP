/**
 * 「今天」的 entry（记录）—— 2026-10-15 · 台账 §4.20 ㉘「entry 流」第一刀（10-16 扩面到照片）。
 *
 * ## 为什么需要它（真机反馈的头号问题）
 *
 * 用户实测：「记录一条文字，时间轴没有出现任何东西」「冷启动时 App 时间轴没有任何内容」。
 * 根因（代码 + 真库双证）：**时间轴只读 `events`，而文字内容不产 event**（端侧 L1 聚合
 * `aggregateToEvents` 的入参就是**照片数组** `Array<UploadedPhoto>`；云侧默认只跑 L2/L3，
 * 且其规则依赖标签/GPS/照片张数）⇒ 文字在时间轴上**永远不可见** ✗；同时 `emptyState`
 * 由 `days/pending` 推导 ⇒ 明明有内容却显示空态「还没有回忆」✗。
 *
 * ## 口径（grill 三轮后用户已拍板，见台账 §4.20 ㉘）
 *
 * 1. **记录后立刻可见**是硬要求 ⇒ 实现口径＝**读 `contents`**（服务端事实，跨设备/重启都在 ✓），
 *    而不是等事件聚合（那是"照片中心"的老路 ✗）；也不做客户端本地草稿（会出现"本地有、别处没有"✗）。
 * 2. **收文字 + 照片**（2026-10-16 扩面）：第一刀只收文字时，今天的照片只能绕"日卡片/事件"
 *    一大圈才看得到，且**当天刚拍、还没聚合成事件**的照片在「今天」块里是**缺席**的 ✗
 *    （用户要的是"今天完整的记录流"）。现补上照片 ⇒ 文字/照片同构进「今天」块；
 *    **语音仍留到下一批**（要接播放管道/波形，属独立工作面 ✗）。
 * 3. 文字时间用 `created_at`（文字**没有 `taken_at`**，后端不赋值 ⇒ 不假装有 ✗）；
 *    照片以 **`taken_at` 拍摄时刻优先、缺失回退 `created_at`**：见 `fetchTodayEntries` 内注释
 *    （与事件日分组同一时间轴 ⇒ 是下面第 4 条"零重复"口径成立的前提）。
 * 4. **去重口径（用户明确要求）**：今天的照片**只出现在「今天」块**；时间轴下方的历史区
 *    （`TabIndex.visibleDays`）**只显示今天之前**的日组 ⇒ 同一张照片天然不会出现两次 ✓。
 * 5. **排列＝日记式正序（早上 → 现在）**：用户视角"回看今天"是从头读到尾（Day One/flomo 同款），
 *    倒序只适合"翻旧账"✗。排序时刻用 `TodayEntry.orderMs`（组装期预计算，模板零函数调用 ✓）。
 *
 * ## 与 `search_api.fetchRecentContents` 的关系
 *
 * 同一个端点（`GET /api/v1/contents`：`Page[ContentOut]`、游标分页、limit 1..100），
 * 但**用途不同**：那个给搜索页做"最近内容"列表（含各类型、不做日期切分）；
 * 本模块只服务时间轴的「今天」块 ⇒ 独立命名空间，避免两处口径互相牵制 ✓。
 * 该端点**没有日期过滤参数** ⇒ 由本模块按**本地日期**就地筛（拉 50 条足够覆盖单日记录量 ✓）。
 */
import { get, dataObj } from './api'
// 2026-10-16 修正：PATH_CONTENTS 定义在 `contract.uts`，此前从 `./api` 导入是**悬空导出**
// （`api.uts` 不 re-export contract）——按 search_api/voice 的既有正确写法收到 `./contract` ✓。
import { PATH_CONTENTS } from './contract'
import { parseIsoMs, dayKey, friendlyDay } from './time'
import { resolveMediaUrl } from './config'
import { TimelineEvent } from './timeline'

/** 时间轴「今天」块里的一条记录（2026-10-16：文字 + 照片；语音待下一批） */
export class TodayEntry {
	id: string
	kind: string        // 'text' | 'photo'（下一批扩 'voice'）
	text: string        // 文字正文；照片为空串（照片没有 caption，不假装有 ✗）
	photoUrl: string    // 照片缩略图票据 URL（已 resolve，可直接喂 <image :src>）；文字为空串
	timeLabel: string   // HH:mm（本地时区）
	place: string
	orderMs: number     // 排序用的时刻（仅供数组排序，不下发到视图）

	constructor(id: string, kind: string, text: string, photoUrl: string, timeLabel: string, place: string, orderMs: number) {
		this.id = id
		this.kind = kind
		this.text = text
		this.photoUrl = photoUrl
		this.timeLabel = timeLabel
		this.place = place
		this.orderMs = orderMs
	}
}

/**
 * 按本地自然日分组的一天记录（2026-10-25 · task-12 ①）。
 *
 * 与 `TimelineEvent` 的日组（`timeline.DayGroup`）**同款语义**（`key` = `yyyy-mm-dd`
 * 本地日键、`label` = 日头文案），只是载荷换成原始 `contents` 条目 —— 这样两者能
 * 按日期键合并成一个历史区（见 `history_days.mergeHistoryDays`）。
 */
export class EntryDay {
	key: string
	label: string
	entries: Array<TodayEntry>

	constructor(key: string, label: string) {
		this.key = key
		this.label = label
		this.entries = []
	}
}

/**
 * 一次内容拉取的结果（2026-10-25 · task-12 ①）。
 *
 * 为什么把它做成一个对象而不是「一个数组」：历史区同时需要
 *   ① **今天**的条目（给「今天」块）、② **所有天**的分组（给历史区兜底）、
 *   ③ **这次到底拉全了没有**（`truncated`）——三者是同一次请求的结果，
 *   分三次拉等于三倍延迟且可能不一致。
 */
export class EntryFeed {
	/** 今天的条目（正序：早上 → 现在） */
	today: Array<TodayEntry>
	/** 全部按天分组（**含今天**；历史区渲染前由 `mergeHistoryDays` 去掉今天） */
	days: Array<EntryDay>
	/** 实际扫过多少条内容（诊断/提示用） */
	scanned: number
	/**
	 * 是否**因为达到扫描上限而提前停止**（仍有更早的内容没拉）。
	 *
	 * 这是 2026-10-16 那条「拉 50 条再就地筛会静默截断」的**如实暴露**：
	 * 截断不再是"用户看不见"的静默行为，而是页面上一行「仅显示最近 N 天」的提示。
	 */
	truncated: boolean

	constructor(today: Array<TodayEntry>, days: Array<EntryDay>, scanned: number, truncated: boolean) {
		this.today = today
		this.days = days
		this.scanned = scanned
		this.truncated = truncated
	}
}

/**
 * 回顾位「那年今日」的一行（2026-10-15 · 台账 §4.20 ㉘ · 批次 C 第一刀）。
 *
 * 视图字段**组装期预计算**（沿用卡PA R4 口径：模板零函数调用 ✓）——
 * 尤其是"N 年前的今天"这类需要 `new Date()` 的标签，**绝不能**放进模板里现算（会逐帧重算 ✗）。
 */
export class LookbackRow {
	contentId: string   // 点击进详情的 contentId（与 openDetail 同口径：封面优先、首图回退）
	yearLabel: string   // "1 年前的今天" / "3 年前的今天"
	title: string
	metaText: string    // 如 "主题 · 12 张"（无信息则空串，模板据此不渲染该行）
	coverUrl: string    // 服务端票据 URL（**不用本地路径**：往年的原件/缩略图可能已被清理 ✗）

	constructor(contentId: string, yearLabel: string, title: string, metaText: string, coverUrl: string) {
		this.contentId = contentId
		this.yearLabel = yearLabel
		this.title = title
		this.metaText = metaText
		this.coverUrl = coverUrl
	}
}

/**
 * 从**全量事件**里挑出"往年的今天"（同月同日、年份更早），每年最多 3 条。
 *
 * 为什么客户端算：时间轴事件接口**不带时间窗**（一次给全量），"哪年的同一天"是个纯本地判定
 * ⇒ 不新增端点、不改契约、不动后端 ✓（在野 APK 也不受影响 ✓）。
 * 口径：① 只取 level ≤ 2（与时间轴可见层级一致，L3 主题流不在时间轴渲染 ✗）；
 *      ② **有才出现**（空数组 ⇒ 调用方整块不渲染，绝不占位 ✗）；
 *      ③ 每年最多 3 条：防"那年今天有 40 条"把首屏撑爆 ✗（长尾可按年展开，属下一批）。
 */
export function buildLookback(events: Array<TimelineEvent>): Array<LookbackRow> {
	const now = new Date()
	const m = now.getMonth()
	const d = now.getDate()
	const y = now.getFullYear()
	const perYear = new Map<number, number>()
	const out: Array<LookbackRow> = []
	for (let i = 0; i < events.length; i++) {
		const ev = events[i]
		if (ev.level > 2 || ev.startTime <= 0) {
			continue
		}
		const t = new Date(ev.startTime)
		const yr = t.getFullYear()
		if (t.getMonth() != m || t.getDate() != d || yr >= y) {
			continue
		}
		const n = perYear.get(yr) ?? 0
		if (n >= 3) {
			continue
		}
		perYear.set(yr, n + 1)
		let cid = ev.coverContentId
		if (cid == '' && ev.photoIds.length > 0) {
			cid = ev.photoIds[0]
		}
		let meta = ''
		if (ev.level == 2) {
			meta = '主题'
		}
		if (ev.photoCount > 0) {
			meta = meta == '' ? (ev.photoCount.toString() + ' 张') : (meta + ' · ' + ev.photoCount.toString() + ' 张')
		}
		out.push(new LookbackRow(
			cid,
			(y - yr).toString() + ' 年前的今天',
			ev.title,
			meta,
			ev.coverUrl
		))
	}
	return out
}

// 「是否今天」判定统一用 `time.dayKey`（yyyy-mm-dd，**本地时区**）——与 `timeline.buildDayGroups`
// 的日分组键**同源**；此前本模块自持一份 `localDayKey`（未补零），两处口径各写各的 ✗。
// 不用 UTC（会跨零点错切 ✗）。不再自持重复实现。

/** HH:mm（本地时区，补零） */
function hhmm(ms: number): string {
	const d = new Date(ms)
	let h = d.getHours().toString()
	if (h.length < 2) {
		h = '0' + h
	}
	let m = d.getMinutes().toString()
	if (m.length < 2) {
		m = '0' + m
	}
	return h + ':' + m
}

// ⚠️ 2026-10-25（task-12）：**失败标志 `wasLastEntriesFetchFailed` 已删除**。
// 原因：它存在的前提是「`fetchTodayEntries` 用空数组同时表达失败与"今天真没记录"」——
// 必须外加一个模块级布尔才能区分。新入口 `fetchEntryFeed` **直接返回 `null` 表示失败**
// （类型系统承担这件事，不再依赖"读一下模块级变量"这种易忘的时序约定），
// 旧函数因此失去唯一调用方 ⇒ 一并删除（零调用导出会被 `audit_harness` 轴 4 判 CRITICAL）。

/**
 * 拉内容并按本地自然日分组（2026-10-25 · task-12 ① 的核心）。
 *
 * ## 为什么要多页
 *
 * `GET /contents` 是**游标分页**（`Page{items, cursor, has_more}`，limit 1..100，
 * 见 `backend/app/api/contents/__init__.py:403`）。旧实现只拉 **1 页 50 条**，而老账号
 * 有 316 条内容 ⇒ **更早的历史根本拉不到**（不是"今天之外被筛掉"，是**没请求过**）。
 * 本函数按 `maxPages` 逐页跟游标，直到：① 拿满 `maxPages` 页；② 服务端 `has_more=false`。
 *
 * ## 三件事一次做完（同一份响应，不分三次请求）
 *
 *   ① `today`：只留今天（「今天」块）——判定口径与旧实现**逐字相同**
 *      （文字用 `created_at`；照片 `taken_at` 优先、缺失回退 `created_at`）；
 *   ② `days`：**全部按天分组**（历史区兜底；含今天，合并时再去掉）；
 *   ③ `truncated`：**拉满了 maxPages 但服务端还有更多** ⇒ 如实标记，页面提示
 *      「仅显示最近 N 天」。这是对 2026-10-16 那条"静默截断"的正面处置：
 *      截断仍然存在（端点无日期参数，不做假承诺），但**不再静默** ✓。
 *
 * ## 失败语义（与 `fetchTodayEntries` 同口径）
 *
 * 任一分页请求失败 ⇒ **一页都没收到**时返回 `null`（调用方保持现状不覆盖）；
 * 已收到的页**不丢**（宁可显示"真实但可能不全"的数据，也不要因为第 3 页失败
 * 而把第 1~2 页的内容一起抹掉 ✗），此时 `truncated=true` 让页面如实提示。
 *
 * ⚠️ 写法约束（沿 `agg_runner.chunkStep` 的血泪）：**不在函数内定义函数** ——
 * 内层函数声明曾把 UTS 编译器卡死 300s+。故分页状态一律挂**模块级变量**，
 * `feedAssemble` / `feedFinish` / `feedFetchPage` 均为**模块级函数**。
 */
/**
 * 单页扫描上限。
 *
 * ⚠️ 取 **100** 而不是旧实现的 50：后端 `pagination_params` 的 limit 范围就是 `1..100`
 * （`backend/app/api/deps.py:30`）⇒ 100 是**服务端允许的最大页**，用它等于"每页装最多"。
 *
 * 实测依据（真实账号 `e4134743-…`，316 条内容）：
 *   · 50 条/页 × 4 页 = 200 条 ⇒ 只覆盖 8 天，最早到 10/05；
 *   · **100 条/页 × 4 页 = 400 条 ⇒ 覆盖全部 27 天（最早到 2025-09-05），`truncated=false`**。
 * ⇒ 同样 4 次请求装下 2 倍数据；这个账号**一次请求链就把历史拉全**（用户的核心诉求）。
 * 服务端另有硬上限 100 ⇒ 再想拉更多只能加页，不能加大 limit（见 `FEED_MAX_PAGES`）。
 */
const TODAY_SCAN_LIMIT: number = 100

let _feedRaw: Array<UTSJSONObject> = []
let _feedSeen: Set<string> = new Set<string>()
let _feedPages = 0
let _feedMaxPages = 1
let _feedCursor = ''
let _feedTruncated = false
let _feedFailed = false
let _feedTodayKey = ''
let _feedResolve: ((f: EntryFeed | null) => void) | null = null

/** 收齐后的组装：`_feedRaw` → EntryFeed（today + days）。纯计算，无副作用外的日志。 */
function feedAssemble(): EntryFeed {
	const today: Array<TodayEntry> = []
	const byKey: Map<string, EntryDay> = new Map<string, EntryDay>()
	const dayOrder: Array<string> = []
	for (let i = 0; i < _feedRaw.length; i++) {
		const c = _feedRaw[i]
		const ct = c.getString('content_type') ?? ''
		let entry: TodayEntry | null = null
		if (ct == 'text') {
			const text = c.getString('text') ?? ''
			if (text == '') {
				continue // 空文字不占一行（诚实：没有内容就不假装有卡片 ✓）
			}
			// 文字：时刻＝`created_at`（文字没有 taken_at，后端不赋值 ⇒ 不假装有 ✓）
			const ms = parseIsoMs(c.getString('created_at') ?? '')
			if (ms <= 0) {
				continue
			}
			entry = new TodayEntry(c.getString('id') ?? '', 'text', text, '', hhmm(ms), c.getString('place') ?? '', ms)
		} else if (ct == 'photo') {
			// 照片：图片 URL 用服务端已下发的**缩略图票据**（thumbnail_url），
			// 经 resolveMediaUrl 拼直连地址（<image :src> 带不了 Bearer header ✓）。
			// 无票据（原件未上传的占位 / 已被清理）⇒ 本张**跳过**：不给"没有图的照片卡"
			// （诚实：展示不了就不占一行 ✓）。
			const url = resolveMediaUrl(c.getString('thumbnail_url'))
			if (url == '') {
				continue
			}
			// 照片用 **`taken_at` 拍摄时刻**优先（与 `buildDayGroups` 事件日分组同一时间轴，
			// 保证"照片+它所在事件"一起进今天块或一起被历史区排除，不重复出现 ✓）；
			// 缺失 taken_at（早期数据）才回退 `created_at`（记录时刻）。
			let ms = parseIsoMs(c.getString('taken_at') ?? '')
			if (ms <= 0) {
				ms = parseIsoMs(c.getString('created_at') ?? '')
			}
			if (ms <= 0) {
				continue
			}
			// ⚠️ 2026-10-26 审查记录（**未改，留作待办**）：照片卡这里 `text` 传空串，
			// 而服务端已能下发 `caption`（一句话描述）。故时间轴照片卡只有图+时间+地点，
			// 扫读时不知道拍的是什么。**本批刻意不改**：① 它属"信息缺口"而非
			// "机器产物当人话"（本次修复的病因）；② 要在 EntryCard 增图注槽位 +
			// `tab-index.css` 增类，而该 CSS 是主屏共享件（1500+ 行、多卡族共用），
			// 改它需单独一轮视觉回归。已登记为后续项，见本轮交付清单。
			entry = new TodayEntry(c.getString('id') ?? '', 'photo', '', url, hhmm(ms), c.getString('place') ?? '', ms)
		}
		// 其余 content_type（voice/article）不在本刀（见模块注释 2）；它们**也不进历史区**
		// ——历史区复用同一 TodayEntry 渲染原子，语音要接播放管道/波形，属独立工作面 ✗
		if (entry == null) {
			continue
		}
		const e = entry as TodayEntry
		const k = dayKey(e.orderMs)
		let day = byKey.get(k)
		if (day == null) {
			day = new EntryDay(k, friendlyDay(e.orderMs))
			byKey.set(k, day)
			dayOrder.push(k)
		}
		day.entries.push(e)
		if (k == _feedTodayKey) {
			today.push(e)
		}
	}
	// 每天内部正序（早上 → 现在）；日组本身倒序（近 → 远）
	const days: Array<EntryDay> = []
	for (let i = 0; i < dayOrder.length; i++) {
		const d = byKey.get(dayOrder[i])
		if (d == null) {
			continue
		}
		d.entries.sort((a: TodayEntry, b: TodayEntry): number => a.orderMs - b.orderMs)
		days.push(d)
	}
	days.sort((a: EntryDay, b: EntryDay): number => {
		if (a.key == b.key) {
			return 0
		}
		return a.key < b.key ? 1 : -1
	})
	// 日记式正序（早上 → 现在），理由见模块注释 5
	today.sort((a: TodayEntry, b: TodayEntry): number => a.orderMs - b.orderMs)
	return new EntryFeed(today, days, _feedRaw.length, _feedTruncated)
}

/** 收尾：**先清模块级状态、再回调**（回调里可能再次触发拉取 ⇒ 必须防重入，同 `chunkStep`）。
 *
 *  `built` 由调用方在清状态**之前**组装好并传入 —— 这样"清状态"与"组装"没有先后陷阱
 *  （上一版把组装放在清状态之后，会读到空数组 ⇒ 历史区恒空，正是本次要修的那类 bug）。
 *
 *  失败语义（**唯一**判据是 `null`，不再有模块级失败标志）：
 *   · `built == null` ⇒ 一页都没成功、且没有任何已收条目 ⇒ 调用方**保持现状不覆盖**；
 *   · 非 null 但部分页失败 ⇒ 返回"真实但可能不全"的数据（比整块抹掉好，见 `fetchEntryFeed`）。 */
function feedFinish(built: EntryFeed | null): void {
	const cb = _feedResolve
	_feedResolve = null
	_feedRaw = []
	_feedSeen = new Set<string>()
	_feedPages = 0
	_feedCursor = ''
	_feedTruncated = false
	_feedFailed = false
	if (cb == null) {
		return
	}
	cb(built)
}

/** 分页失败时的收尾：**已收条目仍要交付**（"真实但可能不全" > 整块抹掉）。
 *  一页都没收到才返回 null（= 真失败，调用方保持现状）。 */
function feedFail(): void {
	_feedFailed = true
	if (_feedRaw.length == 0) {
		feedFinish(null)
		return
	}
	// 部分成功：数据集**必须**标记为截断（用户看到「仅显示最近的部分记录」），
	// 因为确实还有更早的内容没拉到 —— 这与"服务端无更多"是两件事，不能混 ✗
	_feedTruncated = true
	feedFinish(feedAssemble())
}

/** 逐页请求；靠「游标严格前进」规则防死循环（`next == cursor` 即停） */
function feedFetchPage(): void {
	const path = _feedCursor == ''
		? PATH_CONTENTS + '?limit=' + TODAY_SCAN_LIMIT
		: PATH_CONTENTS + '?limit=' + TODAY_SCAN_LIMIT + '&cursor=' + encodeURIComponent(_feedCursor)
	get(path).then((body: UTSJSONObject | null) => {
		if (body == null) {
			feedFail()
			return
		}
		const d = dataObj(body)
		if (d == null) {
			feedFail()
			return
		}
		// 🚨 2026-10-26（**永久加载态**修复 · 与 `timeline.fetchTimelineAsync` 同款）：
		// 下面这一段（读字段 + 组装）**必须整体在 try 里**。原实现裸跑：任一 `getString`
		// / `getBoolean` 在形状不符时同步抛出，异常从 `.then` 回调冒出成未处理 rejection，
		// 而 `feedFinish(...)` 永远不会执行 ⇒ `_feedResolve` 一直挂着 ⇒ 调用方
		// `loadTodayEntries` 的 `.then` 永不触发 ⇒ `todayLoaded` 恒 false
		// ⇒ `loading` 恒真 ⇒ **骨架屏永驻、内容永不出现**。
		// 这不是假设：本模块注释自己记着「上一版把组装放在清状态之后 ⇒ 历史区恒空」
		// 那类状态机事故；而"抛异常 ⇒ 永不收敛"是同一个病更彻底的形式。
		// 失败口径沿用 `feedFail()`：已收条目仍交付（真实但可能不全），一页都没收到才 null
		// —— 由调用方"保持现状/如实提示"消化，绝不假装还在加载。
		try {
			const raw = d.getArray('items')
			if (raw != null) {
				const arr = raw as Array<UTSJSONObject>
				for (let i = 0; i < arr.length; i++) {
					const c = arr[i]
					const id = c.getString('id') ?? ''
					// ⚠️ 去重：游标是 `(created_at, id)` 复合键，**翻页期间有新内容写入**时同一 id
					// 可能出现在两页（服务端 limit+1 取 has_more，不保证快照隔离）⇒ 重复会在
					// 时间轴里显示成两张一样的卡 ✗。
					if (id != '' && _feedSeen.has(id)) {
						continue
					}
					if (id != '') {
						_feedSeen.add(id)
					}
					_feedRaw.push(c)
				}
			}
			_feedPages = _feedPages + 1
			const hasMore = d.getBoolean('has_more') ?? false
			const next = d.getString('cursor') ?? ''
			// 「服务端还有更多、但我这轮不拉了」= 截断（如实标记，见函数注释 ③）
			_feedTruncated = hasMore
			const canGo = _feedPages < _feedMaxPages && hasMore && next != '' && next != _feedCursor
			if (canGo) {
				_feedCursor = next
				feedFetchPage()
				return
			}
			// 收齐 → **先组装，再 finish**（finish 清状态并回调；组装必须在清状态之前）
			feedFinish(feedAssemble())
		} catch (e) {
			console.log('[dbg-index] entry feed 解析/组装失败 -> 按失败收敛: ' + e)
			feedFail()
		}
	})
}

export function fetchEntryFeed(maxPages: number): Promise<EntryFeed | null> {
	return new Promise<EntryFeed | null>((resolve) => {
		if (maxPages < 1) {
			resolve(new EntryFeed([], [], 0, false))
			return
		}
		// 重置模块级分页状态（并防重入：上一次未完成的回调会被**覆盖**，其 Promise 永不
		// resolve —— 这比让两次拉取共用同一份状态、互相串数据要好；调用方均为"刷新覆盖"语义）
		_feedRaw = []
		_feedSeen = new Set<string>()
		_feedPages = 0
		_feedMaxPages = maxPages
		_feedCursor = ''
		_feedTruncated = false
		_feedFailed = false
		_feedTodayKey = dayKey(Date.now())
		_feedResolve = resolve
		feedFetchPage()
	})
}

/**
 * 玩法层 · 内容 AI 元数据 / 波形 / 用户 / 备注（B5a 2026-09-24 重构波：自 utils/play.uts 按域拆出）
 *
 * 约定（与原 play.uts 一致）：resolve-only（永不 reject），失败 resolve(null/[]/false) + toast。
 * 对外导出：ContentAiMeta, fetchContentAiMeta, fetchWaveform, fetchUsersMe, updateContentRemark
 */
import { get, request, dataObj } from './api'
import { getBaseUrl } from './config'
import { getToken } from './auth'
import { enqueueFieldOp } from './sync_client'
import { getNetKind } from './uploader'
import { PATH_WAVEFORM } from './contract'

export class ContentAiMeta {
	tags: Array<string>
	aiDescription: string

	constructor(tags: Array<string>, aiDescription: string) {
		this.tags = tags
		this.aiDescription = aiDescription
	}
}

/** GET /contents?content_id=：拉单条 AI 增量字段（ContentDetail 未承载 tags/ai_description，
 *  event_ops 域外只读 → 本封装独立拉取；失败/无内容 resolve null（api 层已 toast） */
export function fetchContentAiMeta(contentId: string): Promise<ContentAiMeta | null> {
	return new Promise<ContentAiMeta | null>((resolve) => {
		get('/api/v1/contents?content_id=' + contentId + '&limit=1').then((res: UTSJSONObject | null) => {
			if (res == null) {
				resolve(null)
				return
			}
			const d = dataObj(res)
			if (d == null) {
				resolve(null)
				return
			}
			const items = d.getArray('items')
			if (items == null || items.length == 0) {
				resolve(null)
				return
			}
			const it = items[0] as UTSJSONObject
			// tags_json：list|null → 逐项过滤空串（整表 cast 先例 play.uts flattenDimensions getArray as Array<string>）
			const tags: Array<string> = []
			const raw = it.getArray('tags_json') as Array<string> | null
			if (raw != null) {
				for (let i = 0; i < raw.length; i++) {
					if (raw[i] != '') {
						tags.push(raw[i])
					}
				}
			}
			resolve(new ContentAiMeta(tags, it.getString('ai_description') ?? ''))
		})
	})
}

/** GET /contents/{id}/waveform?buckets=28：真实播放波形（0..1 峰值数组，BB3；data.buckets）。
 *  静默降级封装（增强项，fetchThumbnailPath 先例）：404（非语音内容/文件非 WAV，MEDIA_003）
 *  与网络失败一律 resolve null + console.warn，**不 toast**——波形缺失宿主回退伪波形；
 *  直连带 Authorization（token 只能走 header，patchJson 自持封装同款；不重试不 refresh，
 *  token 失效由业务请求先触发自愈） */
export function fetchWaveform(contentId: string): Promise<Array<number> | null> {
	return new Promise<Array<number> | null>((resolve) => {
		const path = PATH_WAVEFORM.replace('{id}', contentId) + '?buckets=28'
		const header: UTSJSONObject = {}
		const token = getToken()
		if (token != '') {
			header.set('Authorization', 'Bearer ' + token)
		}
		const onSuccess = (res: any): void => {
			if (res.statusCode != 200) {
				console.warn('[play] fetchWaveform HTTP ' + res.statusCode + ' ' + contentId)
				resolve(null)
				return
			}
			// 裸值强转 UTSJSONObject 会主线程 FATAL（api.uts 2026-08-26 先例）：先守卫再转换
			if (res.data == null || typeof res.data != 'object') {
				console.warn('[play] fetchWaveform 非对象响应 ' + contentId)
				resolve(null)
				return
			}
			const d = res.data as UTSJSONObject
			const buckets = d.getArray('buckets') as Array<number> | null
			if (buckets == null || buckets.length == 0) {
				console.warn('[play] fetchWaveform buckets 空 ' + contentId)
				resolve(null)
				return
			}
			resolve(buckets)
		}
		const onFail = (): void => {
			console.warn('[play] fetchWaveform FAIL ' + contentId)
			resolve(null)
		}
		uni.request({
			url: getBaseUrl() + path,
			method: 'GET',
			header: header,
			success: onSuccess,
			fail: onFail
		})
	})
}

// ═══════════ 用户域 + 内容备注（BB1 · 2026-09-08）═══════════
// 契约（backend app/api/users.py / app/api/contents.py 实证）：
//  GET   /api/v1/users/me     → UserMeOut{id, nickname, avatar, phone(服务端掩码 138****XXXX|null)}
//  PATCH /api/v1/contents/{id} → {"remark": string|null}（仅 remark 单字段，其他字段 422）→ ContentOut

/** GET /users/me：当前用户信息（掩码手机号下发，完整号码不出网）；失败 null（api 层已全局 toast） */
export function fetchUsersMe(): Promise<UTSJSONObject | null> {
	return new Promise<UTSJSONObject | null>((resolve) => {
		get('/api/v1/users/me').then((res: UTSJSONObject | null) => {
			if (res == null) {
				resolve(null)
				return
			}
			resolve(dataObj(res))
		})
	})
}

/** PATCH 单发（BB1 自持封装）：api.uts 的 Method 联合类型无 PATCH（域外文件不动）；
 *  uni-app x uni.request method 官方合法值含 PATCH（app-android 支持，doc.dcloud.net.cn/uni-app-x/api/request）。
 *  非 200/网络失败 → resolve null（不静默：调用方显式 toast；对象守卫对齐 api.uts 2026-08-26 先例） */
function patchJson(path: string, data: UTSJSONObject): Promise<UTSJSONObject | null> {
	return new Promise<UTSJSONObject | null>((resolve) => {
		const header: UTSJSONObject = { 'Content-Type': 'application/json' }
		const token = getToken()
		if (token != '') {
			header.set('Authorization', 'Bearer ' + token)
		}
		const onSuccess = (res: any): void => {
			if (res.statusCode != 200) {
				console.error('[yishu] patchJson HTTP ' + res.statusCode + ' ' + path)
				resolve(null)
				return
			}
			// 裸值强转 UTSJSONObject 会主线程 FATAL（api.uts 先例）：先守卫再转换
			if (res.data != null && typeof res.data == 'object') {
				resolve(res.data as UTSJSONObject)
			} else {
				resolve(null)
			}
		}
		const onFail = (): void => {
			console.error('[yishu] patchJson FAIL ' + path)
			resolve(null)
		}
		uni.request({
			url: getBaseUrl() + path,
			method: 'PATCH',
			data: data,
			header: header,
			success: onSuccess,
			fail: onFail
		})
	})
}

/** PATCH /contents/{id}：更新备注（B12 补充说明真保存）；返回是否成功 */
export function updateContentRemark(contentId: string, remark: string): Promise<boolean> {
	const body: UTSJSONObject = { remark: remark }
	return new Promise<boolean>((resolve) => {
		patchJson('/api/v1/contents/' + contentId, body).then((res: UTSJSONObject | null) => {
			if (res != null) {
				resolve(true)
				return
			}
			// B12：离线时备注同样入队（upsert_field），联网后补发；仍返回 false，
			// 由调用方据 getNetKind()=='none' 改口（同 deleteContent 的注释口径）。
			if (getNetKind() == 'none') {
				enqueueFieldOp('content', contentId, 'remark', remark)
				console.log('[yishu] 离线：备注已入队 content=' + contentId)
			}
			resolve(false)
		})
	})
}

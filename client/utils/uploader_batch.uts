/**
 * 上传域 · 并发池与批量入口（B5c 2026-09-24 重构波：自 utils/uploader.uts 按分节拆出）
 *
 * UploadPool ≤3 并发 / failWholeBatch / uploadBatch / continuePendingUploads / 网络恢复钩子。
 * 对外导出：continuePendingUploads, uploadBatch
 */
import { ensureLogin } from './auth'
import { PhotoItem } from '@/uni_modules/yishu-photo-watch/utssdk/interface.uts'
import { pauseSync, resumeSync, isSyncPaused, registerConsecutiveFailure, resetConsecutiveFailures, MAX_BATCH_FAILURES } from './pause_controller'
import { onNetworkRestored } from './sync_schedule'
import { MAX_CONCURRENCY, UploadMode, UploadOptions, UploadProgress, UploadedPhoto } from './uploader_types'
import { NetKind, getNetKind, resolveMode } from './uploader_net'
import { addFailed, addHeld, failedCount, failedPhotos, heldCount, heldPhotos, removeFailed, removeHeld, setLastUploadError } from './uploader_queue'
import { uploadWithRetry } from './uploader_photo'
// 2026-10-16（蜂窝省流 A1）：压缩预检（失败退回 held）+ 待补原件队列（缩略图**已传**，独立于 held）
import { compressForThumbnail, addPendingOriginal, pendingOriginalItems } from './upload_pipeline'
// 2026-10-16（D-05 缺口，origin/develop）：WiFi 恢复自动补传同样要上云，否则补传的照片不进时间轴
import { submitUploadsAsL1 } from './l1_submit.uts'

/** 并发池（游标式分配，天然实现 ≤3 并发；批量失败 ≥10 暂停剩余） */
class UploadPool {
	items: Array<PhotoItem>
	onProgress: (p: UploadProgress) => void
	resolve: (out: Array<UploadedPhoto>) => void
	uploadMode: string = 'original'
	index: number = 0
	done: number = 0
	failed: number = 0
	consecutive: number = 0
	total: number
	results: Array<UploadedPhoto> = []
	/** 因省流压缩不可用而退回 held 的条数（既不计 done 也不计 failed，但要计入池收束判定，
	 *  否则压缩退回的项会让 done+failed 永远凑不齐 total ⇒ 池永不 resolve） */
	held: number = 0

	constructor(items: Array<PhotoItem>, onProgress: (p: UploadProgress) => void, resolve: (out: Array<UploadedPhoto>) => void) {
		this.items = items
		this.onProgress = onProgress
		this.resolve = resolve
		this.total = items.length
	}

	start(uploadMode: string): void {
		this.uploadMode = uploadMode
		const slots = this.total < MAX_CONCURRENCY ? this.total : MAX_CONCURRENCY
		for (let s = 0; s < slots; s++) {
			this.next()
		}
	}

	/** 暂停：剩余项入 held 队列 + 提前返回已成功部分（横幅"继续上传"恢复） */
	holdRemaining(): void {
		for (let i = this.index; i < this.total; i++) {
			addHeld(this.items[i])
		}
		this.resolve(this.results)
	}

	next(): void {
		if (isSyncPaused()) {
			this.holdRemaining()
			return
		}
		const i = this.index
		this.index++
		if (i >= this.total) {
			return
		}
		const item = this.items[i]
		if (this.uploadMode == 'thumbnail') {
			// 蜂窝省流（2026-10-16 · A1）：先压缩再上传。**压缩不可用/失败 ⇒ 退回 held**
			// （挂起等 WiFi / 手动"立即上传原图"），绝不继续上传原图冒充缩略图
			// ——后者会把 3MB 原图当缩略图上传、偷跑用户流量，比"传不了"更严重。
			compressForThumbnail(item.path).then((_thumbPath: string) => {
				this.runUpload(item)
			}, (e: Error) => {
				const msg = e != null && e.message != null ? e.message : 'unknown'
				console.error('[yishu] 缩略图压缩不可用，退回 held 等 WiFi：' + msg)
				// 留痕（不许静默）：横幅/失败明细能看到"为何退回等 WiFi"
				setLastUploadError('蜂窝省流不可用（' + msg + '）⇒ 已改为等 WiFi 上传原图')
				addHeld(item)
				this.held++
				this.advance()
			})
			return
		}
		this.runUpload(item)
	}

	/** 单条上传（含退避重试）。成功后按完成 → held/failed 分桶，再推进池。 */
	runUpload(item: PhotoItem): void {
		uploadWithRetry(item, this.uploadMode).then((cid: string | null) => {
			if (cid != null) {
				if (this.uploadMode == 'thumbnail') {
					// 缩略图已入库（后端占位 extra.original_pending=true）⇒ 记入**待补原件队列**
					// （独立于 held：它已经"成功上传"了，不能再催用户"待 WiFi 上传" ✗）。
					// WiFi 恢复/点"立即上传原图"时由 continuePendingUploads 补元件（A1 ④）。
					addPendingOriginal(item, cid)
				}
				this.done++
				this.consecutive = 0
				this.results.push(new UploadedPhoto(item, cid))
				resetConsecutiveFailures()
			} else {
				this.failed++
				this.consecutive++
				addFailed(item)
				registerConsecutiveFailure()
				if (this.consecutive >= MAX_BATCH_FAILURES) {
					console.error('[yishu] 连续失败 ' + MAX_BATCH_FAILURES + ' 条，暂停剩余（横幅可继续）')
					pauseSync('网络异常，已暂停同步')
					this.holdRemaining()
					return
				}
			}
			this.advance()
		})
	}

	/** 推进进度并按需派发下一项（held 计入收束：three-way done/failed/held == total） */
	advance(): void {
		const p = new UploadProgress(this.done, this.total, this.failed)
		this.onProgress(p)
		if (this.done + this.failed + this.held === this.total) {
			this.resolve(this.results)
		} else {
			this.next()
		}
	}
}

/** 整批失败（登录失败/后端不可达）：全部入 failed 队列 + 连续失败计数（≥N 触发暂停横幅） */
function failWholeBatch(items: Array<PhotoItem>, onProgress: (p: UploadProgress) => void, resolve: (out: Array<UploadedPhoto>) => void): void {
	for (let i = 0; i < items.length; i++) {
		addFailed(items[i])
	}
	// 2026-10-16（真机反馈「不知道是哪六张、点了重试没反应」）：整批失败（上传前 `ensureLogin()`
	// 不通过 = 后端不可达 / 登录态失效）**最有诊断价值**，原先只 console.error ✗ ⇒ 设备上不可见。
	// 本函数是两处登录失败调用点（uploadBatch 与 uploadItems）的唯一汇聚点 ✓。
	setLastUploadError('连不上服务端（登录态失效或后端不可达）⇒ 整批 ' + items.length.toString() + ' 张未上传')
	for (let i = 0; i < items.length; i++) {
		registerConsecutiveFailure()
	}
	const fail = new UploadProgress(0, items.length, items.length)
	onProgress(fail)
	resolve([])
}

/** 批量上传主入口（并发 ≤3）；成功项返回（上传前确保已登录）。
 *  opts.mode：auto（WiFi 原图 / 蜂窝缩略图省流）/ original（强制原图）/ thumbnail（强制省流）/ hold（暂缓） */
export function uploadBatch(items: PhotoItem[], onProgress: (p: UploadProgress) => void, opts: UploadOptions | null = null): Promise<Array<UploadedPhoto>> {
	return new Promise<Array<UploadedPhoto>>((resolve) => {
		if (items.length === 0) {
			const empty = new UploadProgress(0, 0, 0)
			onProgress(empty)
			resolve([])
			return
		}
		const mode: UploadMode = opts != null && opts.mode != null ? opts.mode : 'auto'
		getNetKind((kind: NetKind) => {
			const effective = resolveMode(mode, kind)
			if (effective == 'hold') {
				// 离线(none)/未知(unknown)：暂缓入 held（流量约束），横幅展示"待 WiFi 上传/立即上传原图"
			// （蜂窝已改走 'thumbnail' 省流分支——见 resolveMode；仅无网/网络类型不明才落此处）
				for (let i = 0; i < items.length; i++) {
					addHeld(items[i])
				}
				const held = new UploadProgress(0, items.length, 0)
				onProgress(held)
				console.log('[yishu] 蜂窝/离线暂缓 ' + items.length + ' 张原图（held=' + heldCount() + '）')
				resolve([])
				return
			}
			ensureLogin().then((ok: boolean) => {
				if (!ok) {
					console.error('[yishu] 上传前登录失败（后端不可达），整批入失败队列')
					failWholeBatch(items, onProgress, resolve)
					return
				}
				const pool = new UploadPool(items, onProgress, resolve)
				pool.start(effective)
			})
		})
	})
}

/** 原样上传一批（原图模式）+ **统一成功清理**：resolve 出口集中做 removeHeld/removeFailed。
 *  2026-10-16（批次 6 · 单张重试）：自 continuePendingUploads 抽出 —— 横幅「单张重传」与「一键继续」
 *  必须共用本出口，否则清理路径分叉，会出现「重传成功但队列未清/清错」的隐性分叉 ✗。
 *  失败项保留在 failed 队列（UploadPool.runUpload → addFailed 去重按 path 覆盖），失败原因由
 *  uploader_photo / failWholeBatch 写 setLastUploadError（机制已存在，不在此重复）。 */
export function uploadItems(items: Array<PhotoItem>, onProgress: (p: UploadProgress) => void): Promise<Array<UploadedPhoto>> {
	return new Promise<Array<UploadedPhoto>>((resolve) => {
		if (items.length === 0) {
			const empty = new UploadProgress(0, 0, 0)
			onProgress(empty)
			resolve([])
			return
		}
		ensureLogin().then((ok: boolean) => {
			if (!ok) {
				console.error('[yishu] uploadItems：登录失败（后端不可达），整批入失败队列')
				failWholeBatch(items, onProgress, resolve)
				return
			}
			const pool = new UploadPool(items, onProgress, (out: Array<UploadedPhoto>) => {
				// 成功后从 held/failed 队列移除（无论池是否因暂停提前返回，只清已成功项）——
				// 单张重试与全量续传共此清理出口，勿在各调用处另写清理。
				for (let i = 0; i < out.length; i++) {
					removeHeld(out[i].item.path)
					removeFailed(out[i].item.path)
				}
				resolve(out)
			})
			pool.start('original')
		})
	})
}

/** 一键继续：解除暂停 + 上传 held/failed 待处理照片 + 补传**待补原件**（缩略图已传、原图待补）
 *  —— 原图模式；B4 §5"立即上传原图"手动入口，亦为 WiFi 恢复自动补传的复用出口。
 *  待补原件不在 held（已成功上传缩略图），故单独并入；补原件的清理由管线按成功清除。 */
export function continuePendingUploads(onProgress: (p: UploadProgress) => void): Promise<Array<UploadedPhoto>> {
	resumeSync()
	const held = heldPhotos()
	const failed = failedPhotos()
	const pendingOriginal = pendingOriginalItems()
	const items: Array<PhotoItem> = []
	for (let i = 0; i < held.length; i++) {
		items.push(held[i])
	}
	for (let i = 0; i < failed.length; i++) {
		items.push(failed[i])
	}
	for (let i = 0; i < pendingOriginal.length; i++) {
		items.push(pendingOriginal[i])
	}
	// 2026-10-16（批次 6）：上传执行 + 成功清理（removeHeld/removeFailed）并入 uploadItems，
	// 与「单张重传」共用同一出口；resumeSync 为同步调用，移出 Promise 执行器语义不变。
	return uploadItems(items, onProgress)
}

/** WiFi 恢复时自动补传暂缓原图 + 待补原件（B4 §5 流量约束闭环：蜂窝暂缓/省流 → 到 WiFi 自动续传）；
 *  由 sync_client.onNetworkRestored 在网络恢复时调用，本文件模块加载时注册（无循环依赖）。 */
function maybeUploadHeldOnWifi(): void {
	const pendingOriginalCount = pendingOriginalItems().length
	if (heldCount() === 0 && failedCount() === 0 && pendingOriginalCount === 0) {
		return
	}
	if (isSyncPaused()) {
		return
	}
	getNetKind((kind: NetKind) => {
		if (kind == 'wifi') {
			console.log('[yishu] WiFi 恢复，自动补传暂缓原图（held=' + heldCount() + ' failed=' + failedCount() + ' 待补原件=' + pendingOriginalCount + '）')
			continuePendingUploads(() => {}).then((uploaded: Array<UploadedPhoto>) => {
				submitUploadsAsL1(uploaded)
			})
		}
	})
}

// 模块加载时注册网络恢复钩子（sync_client 触发；App 启动经 index/profile 引入 uploader 即生效）
onNetworkRestored((): void => {
	maybeUploadHeldOnWifi()
})

/**
 * 预处理（B3-4）：连拍折叠 + GPS 漂移修正（UTS 移植）
 *
 * 与 backend/app/services/event_aggregation/pipeline.py 的 preprocess 同逻辑（AGG-016 双跑）。
 *  - 连拍折叠：<5s 间隔折叠为 1 个时间点（保留首张，burstGroup 记组）
 *  - 漂移修正：相邻照片速度超物理上限 → 坐标置空（存疑标记，由调用方取众数）
 */
import { BURST_GAP_SEC, DRIVE_SPEED_MS } from './agg_config.uts'
import { Photo, haversineM } from './st_dbscan.uts'

/** 原始照片（预处理输入；ts 为 epoch ms UTC） */
export class RawPhoto {
	id: string
	ts: number
	lat: number | null
	lng: number | null
	tags: string[]

	constructor(id: string, ts: number, lat: number | null, lng: number | null, tags: string[]) {
		this.id = id
		this.ts = ts
		this.lat = lat
		this.lng = lng
		this.tags = tags
	}
}

/** 预处理：连拍折叠 + GPS 漂移修正（B3-4） */
export function preprocess(photos: RawPhoto[]): Photo[] {
	const sorted: RawPhoto[] = []
	for (let i = 0; i < photos.length; i++) {
		sorted.push(photos[i])
	}
	sorted.sort((a: RawPhoto, b: RawPhoto): number => {
		return a.ts < b.ts ? -1 : (a.ts > b.ts ? 1 : 0)
	})

	// --- 连拍折叠（与原始序列的紧邻上一张比较：<5s 归入当前组）---
	const folded: Photo[] = []
	let group = 0
	let prevTs: number | null = null
	for (let i = 0; i < sorted.length; i++) {
		const p = sorted[i]
		if (prevTs != null && (p.ts - prevTs) / 1000.0 < BURST_GAP_SEC) {
			// 归入当前折叠组：改写上一张（首张）的 burstGroup 保持组号一致
			const last = folded[folded.length - 1]
			last.burstGroup = group
		} else {
			group++
			folded.push(new Photo(p.id, p.ts, p.lat, p.lng, group, p.tags))
		}
		prevTs = p.ts
	}

	// --- GPS 漂移修正（速度校验：超驾车上限 → 坐标置空标记存疑）---
	const corrected: Photo[] = []
	for (let i = 0; i < folded.length; i++) {
		const p = folded[i]
		let drift = false
		if (p.lat != null && p.lng != null && i > 0 && corrected.length > 0) {
			const prev = corrected[corrected.length - 1]
			if (prev.lat != null && prev.lng != null) {
				const dt = (p.ts - prev.ts) / 1000.0
				if (dt > 0) {
					const speed = haversineM(prev.lat, prev.lng, p.lat, p.lng) / dt
					if (speed > DRIVE_SPEED_MS) {
						drift = true
					}
				}
			}
		}
		if (drift) {
			corrected.push(new Photo(p.id, p.ts, null, null, p.burstGroup, p.tags))
		} else {
			corrected.push(p)
		}
	}
	return corrected
}

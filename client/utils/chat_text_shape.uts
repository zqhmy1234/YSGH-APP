/**
 * AI 回复文本的**客户端形态判定**（2026-10-25 从 chat_api.uts 拆出）。
 *
 * ## 为什么单独一个文件
 *
 * `chat_api.uts` 已 793 行、阈值 800（structure 棘轮 · 无豁免）——在里面加任何判定
 * 都会把文件顶过阈值判 CRITICAL。而这段逻辑本身**与网络/会话态无关**（纯字符串判定），
 * 抽出来反而更该独立：它是"渲染前该不该展示"的**唯一判据**，被 chat_api 与将来任何
 * 需要过滤的地方复用，不该埋在 700 行的网络封装里。
 *
 * ## 为什么客户端也要判（后端已有一道闸）
 *
 * 后端 `model_text.strip_model_markup` 是**第一道闸且更严**；但两处必须都有：
 *   · **预览帧在流式过程中先上屏**（后端校验发生在流之后，泄漏窗口天然存在）；
 *   · 老客户端可能连老后端；
 *   · 终稿替换失败时留在屏上的就是预览文本。
 * 客户端这层职责很窄：**别把 JSON 切片当要点渲染**——不是替代后端清洗。
 */

/**
 * 该行是否像"JSON/工具结果碎片"。
 *
 * 判据只认"一眼就不是给人读的"两种，**刻意保守**（正常中文回复不该被误伤）：
 *   ① 行内含 `_hint` —— 内部提示词键，永远不该出现在用户可见文本里；
 *   ② 行首是 `{`/`[` **且**行内有 ≥2 个 `":` 形态的键值对 —— 单行压平的 JSON 片段。
 *
 * 为什么不用 `JSON.parse` 判：预览帧常是**半截**的（流式中途），合法解析必然失败，
 * 用它判会漏掉绝大多数真实泄漏样本。这里只数结构特征，对半截文本同样有效。
 *
 * 为什么阈值取 2 个键值对而不是 1：`{"name": "小明"}` 这种用户要的单键 JSON 示例
 * 属于"可能该保留"的内容，而工具结果必然有十几个键 —— 取 2 既能抓住泄漏，
 * 又不会把短示例判死（与后端 `test_keeps_legitimate_json` 同一守则）。
 */
export function looksLikeJsonFragment(line: string): boolean {
	const s = line.trim()
	if (s == '') {
		return false
	}
	if (s.indexOf('_hint') >= 0) {
		return true
	}
	const head = s.charAt(0)
	if (head != '{' && head != '[') {
		return false
	}
	let pairs = 0
	for (let i = 0; i + 1 < s.length; i++) {
		if (s.charAt(i) == '"' && s.charAt(i + 1) == ':') {
			pairs++
			if (pairs >= 2) {
				return true
			}
		}
	}
	return false
}

/**
 * 从整段文本里**整行剔除** JSON 碎片（保留原有行序与空行语义由调用方处理）。
 *
 * 为什么在**切标题/要点之前**做：`plain` 形态把首行当标题、其余每行当 bullet。
 * 若切分后才过滤，一段压平的 JSON 已经被拆成"标题 + 十条要点"（每行还带一个圆点），
 * 那正是用户原话里"非常丑"的形态。故分组前先剔行。
 */
export function dropJsonFragments(lines: Array<string>): Array<string> {
	const kept: Array<string> = []
	for (let i = 0; i < lines.length; i++) {
		if (!looksLikeJsonFragment(lines[i])) {
			kept.push(lines[i])
		}
	}
	return kept
}

/**
 * 去掉列表项的行内标记（`- ` / `* ` / `1. ` 等），只留正文。
 *
 * 为什么必须剥：列表项在客户端会**渲染成 `.plain-dot` 圆点 + 文本**。若保留原标记，
 * 用户看到的是「• - 记录高峰在月末」—— 一个圆点加一个减号，比原来更丑 ✗。
 * 模型用的是 Markdown 习惯（`-` / `1.`），我们用自己的圆点表达同一语义，故标记必须剥。
 */
export function stripListMarker(line: string): string {
	let s = line.trim()
	const head = s.charAt(0)
	if ((head == '-' || head == '*' || head == '•' || head == '·') && s.length > 1) {
		const second = s.charAt(1)
		if (second == ' ' || second == '\u3000') {
			return s.substring(2).trim()
		}
	}
	if (s.length > 2) {
		const c0 = s.charAt(0)
		if (c0 == '(') {
			const close = s.indexOf(')')
			if (close > 1 && close <= 4) {
				// `(1) xxx` → 剥到右括号之后
				return s.substring(close + 1).trim()
			}
		}
		if (c0 >= '0' && c0 <= '9') {
			// `1.` / `1、` / `1)` 前缀：跳过连续数字后跟一个分隔符
			let i = 0
			while (i < s.length && s.charAt(i) >= '0' && s.charAt(i) <= '9') {
				i++
			}
			if (i > 0 && i < s.length - 1) {
				const sep = s.charAt(i)
				if (sep == '.' || sep == '\u3001' || sep == ')') {
					return s.substring(i + 1).trim()
				}
			}
		}
	}
	return s
}

/**
 * 该行是否是一条**真正的列表项**（渲染时该加锈红圆点）。
 *
 * ## 为什么需要它（2026-10-25 · task-16 ② 的核心）
 *
 * 旧实现把 `plain` 形态的**每一行**都当 bullet 渲染（`chat_api.parseReply` 里
 * `for (i = 1; i < lines.length; i++) bullets.push(lines[i])`）。而 `_kind_for` 判定
 * `plain` 的依据只是「**文本里有 \\n**」—— 于是**任何多行回复**都会变成
 * 「大标题 + 一串锈红圆点」，包括一段正常的分段散文。用户原话：「不像对话」。
 *
 * ## 判据：**只认显式列表标记**（这条是踩过一次后收紧的）
 *
 * 初版还加了一条「短行 + 无句末标点 ⇒ 算列表项」。实测（见 task-16 的验证脚本）它会把
 * 中文散文短句整片误判成要点 —— **中文短句本来就经常不带句号**（「那天早上有薄雾」
 * 「你自己也在备注里写了风很轻」），于是散文照样被切成一串圆点，等于没修 ✗。
 *
 * 现在只认模型真正会打的标记：
 *   · `-` / `*` / `•` / `·` 后跟空格或全角空格；
 *   · 数字序：`1.` / `1、` / `1)` / `(1)`。
 *
 * 取舍（**宁可少圆点，不可多圆点**）：
 *   · 漏判（模型输出无标记的换行列表）⇒ 渲染成连续段落，读起来是散文，**可读性不受损** ✓；
 *   · 误判（把散文短句当要点）⇒ 一段话被切成一串锈红圆点，正是用户投诉的形态 ✗。
 *   两害相权，只认显式标记是唯一安全的一侧。
 */
export function isListItem(line: string): boolean {
	const s = line.trim()
	if (s == '') {
		return false
	}
	// ① 项目符号：`-` / `*` / `•` / `·` + 空白（防误伤 "3-5 条" 这种行内连字符）
	const head = s.charAt(0)
	if ((head == '-' || head == '*' || head == '•' || head == '·') && s.length > 1) {
		const second = s.charAt(1)
		if (second == ' ' || second == '\u3000') {
			return true
		}
	}
	// ② 数字序：`1.` / `1、` / `1)` / `(1)`
	if (s.length > 2) {
		const c0 = s.charAt(0)
		const c1 = s.charAt(1)
		if (c0 == '(') {
			const close = s.indexOf(')')
			if (close > 1 && close <= 4) {
				return true
			}
		}
		if (c0 >= '0' && c0 <= '9' && (c1 == '.' || c1 == '\u3001' || c1 == ')')) {
			return true
		}
	}
	return false
}

/** 段落切分结果：首段（可当小标题）+ 其余段（每条自带"是不是列表项"标记） */
export class ReplyBody {
	/** 首段文本：**只在它确实是"短标题行"时**由调用方当小标题，否则并入正文 */
	first: string
	/** 首段是否适合当小标题（短、无句末标点） */
	firstIsTitle: boolean
	/** 其余段落（已剔 JSON 碎片） */
	rest: Array<string>
	/** `rest` 里每条是否为列表项（与 `rest` 下标一一对应；避免渲染层再判一次） */
	restIsList: Array<boolean>

	constructor(first: string, firstIsTitle: boolean, rest: Array<string>, restIsList: Array<boolean>) {
		this.first = first
		this.firstIsTitle = firstIsTitle
		this.rest = rest
		this.restIsList = restIsList
	}
}

/**
 * 从整段回复文本算出「标题 / 段落 / 列表项」三份结果（`parseReply` 直接消费）。
 *
 * 为什么把这个编排放在本文件而不是 `chat_api.parseReply`：后者已 794 行 / 阈值 800
 * （structure 棘轮**无豁免**），在里面加逻辑就会顶过阈值。而"怎么切分"本就是本文件职责。
 */
export class ReplyShape {
	/** 当小标题的首行；空串 = 没有标题（首行已并入 paragraphs） */
	title: string
	/** 正文段落（非列表项） */
	paragraphs: Array<string>
	/** 要点（真正的列表项，渲染时带圆点） */
	bullets: Array<string>

	constructor(title: string, paragraphs: Array<string>, bullets: Array<string>) {
		this.title = title
		this.paragraphs = paragraphs
		this.bullets = bullets
	}
}

/**
 * `plain` 形态的最终切分（title / paragraphs / bullets）。
 *
 * @param text   回复正文
 * @param isPlain 后端判定的形态是否为 `plain`（非 plain 不切分，全部交 bubble 渲染）
 */
export function shapeReply(text: string, isPlain: boolean): ReplyShape {
	const lines = splitTextLines(text)
	const body = shapeReplyBody(lines)
	if (!isPlain) {
		return new ReplyShape('', [], [])
	}
	const paragraphs: Array<string> = []
	const bullets: Array<string> = []
	for (let i = 0; i < body.rest.length; i++) {
		if (body.restIsList[i]) {
			// 剥掉 `- ` / `1. ` 等标记：客户端自己画圆点，保留标记会变成「• - 内容」✗
			bullets.push(stripListMarker(body.rest[i]))
		} else {
			paragraphs.push(body.rest[i])
		}
	}
	let title = ''
	if (body.firstIsTitle) {
		title = body.first
	} else if (body.first != '') {
		// 首行不是短标题（长句/列表项）⇒ 它是正文第一段，不能硬拔成标题 ✗
		paragraphs.unshift(body.first)
	}
	return new ReplyShape(title, paragraphs, bullets)
}

/** 按行切分（保留原行序；`\r\n` 归一；末行空串丢弃） */
export function splitTextLines(text: string): Array<string> {
	const norm = text.replace('\r\n', '\n')
	const parts = norm.split('\n')
	const out: Array<string> = []
	for (let i = 0; i < parts.length; i++) {
		out.push(parts[i])
	}
	// 末尾若因结尾换行产生空串，去掉（否则会多一个空段落）
	if (out.length > 0 && out[out.length - 1] == '') {
		out.pop()
	}
	return out
}

export function shapeReplyBody(lines: Array<string>): ReplyBody {
	const kept = dropJsonFragments(lines)
	if (kept.length == 0) {
		return new ReplyBody('', false, [], [])
	}
	const head = kept[0].trim()
	// 首行当标题的条件：**不是列表项** + 足够短（>18 字就不是标题，是正文第一句）
	const firstIsTitle = !isListItem(head) && head.length <= 18
	const restStart = 1
	const rest: Array<string> = []
	const restIsList: Array<boolean> = []
	for (let i = restStart; i < kept.length; i++) {
		const t = kept[i].trim()
		if (t == '') {
			continue
		}
		rest.push(t)
		restIsList.push(isListItem(t))
	}
	return new ReplyBody(head, firstIsTitle, rest, restIsList)
}


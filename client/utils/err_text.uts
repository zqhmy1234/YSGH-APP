/**
 * 原生错误文案清洗（2026-10-31 · 走查：JSON 直接暴露给用户）
 *
 * ## 问题
 * Android 端很多回调的 `errMsg` 是**对象序列化后的 JSON 串**，例如：
 *   `{"errMsg":"operateRecorder:fail other errors"}`
 * 而代码里常见写法是 `'录音失败：' + msg` ⇒ toast 直接把
 * `录音失败：{"errMsg":"operateRecorder:fail other errors"}` 怼到用户脸上。
 * 用户看到一堆花括号引号，观感极差，也完全读不懂。
 *
 * ## 策略
 * 1. 是 JSON 对象 ⇒ 只取 `errMsg` / `message` / `msg` 里的人话；
 * 2. 取不到就**丢弃原串**，宁可给一句通用文案，也不把结构体漏给用户；
 * 3. 兜底再清洗一次：去掉残留的引号/花括号/方括号，压缩连续空格，超长截断。
 *
 * 纯函数、无 UI 依赖，可单测。
 */

/** 从 JSON 结构里按优先级找一句人话；找不到返回空串。 */
function pickHuman(obj: UTSJSONObject): string {
	const keys: Array<string> = ['errMsg', 'message', 'msg', 'error', 'detail']
	for (let i = 0; i < keys.length; i++) {
		const v = obj.getString(keys[i])
		if (v != null && v != '') {
			return v
		}
	}
	return ''
}

/**
 * 纯文本按键取值：在 JSON 串里找 `"<key>"` 后面的字符串值。
 *
 * 不用正则、不用 JSON API —— 只用 indexOf/substring，纯 JS 与 UTS 行为一致，
 * 因此可以被单测直接覆盖（`UTSJSONObject.getString` 在纯 JS 里不存在）。
 */
export function extractByKey(raw: string, key: string): string {
	const k = '"' + key + '"'
	const ki = raw.indexOf(k)
	if (ki < 0) {
		return ''
	}
	const colon = raw.indexOf(':', ki + k.length)
	if (colon < 0) {
		return ''
	}
	const q1 = raw.indexOf('"', colon + 1)
	if (q1 < 0) {
		return ''
	}
	const q2 = raw.indexOf('"', q1 + 1)
	if (q2 < 0) {
		return ''
	}
	return raw.substring(q1 + 1, q2)
}

/** 判断字符串是否"长得像 JSON 结构体"（以 { 或 [ 开头且能解析）。 */
function looksLikeJson(raw: string): boolean {
	const t = raw.trim()
	if (t.length < 2) {
		return false
	}
	const c = t.substring(0, 1)
	return (c == '{' || c == '[') && (t.indexOf('}') > 0 || t.indexOf(']') > 0)
}

/**
 * 原生错误 → 可给用户看的短句。
 *
 * @param raw 原始 errMsg（可能是 JSON 串、可能是普通文本）
 * @param fallback 清洗不出人话时的兜底文案（调用方给"可执行"的建议）
 */
export function humanizeErr(raw: string, fallback: string): string {
	const t = raw.trim()
	if (t == '') {
		return fallback
	}
	if (looksLikeJson(t)) {
		// 路径 A：解析成对象后按字段取（UTS 运行时首选）
		try {
			const obj = JSON.parse(t) as UTSJSONObject
			const human = pickHuman(obj)
			if (human != '') {
				return cleanText(human)
			}
		} catch (e) {
			// 解析失败继续走路径 B（纯文本提取），不要直接放弃
		}
		// 路径 B：**纯文本提取**，不依赖任何对象 API。
		// 为什么需要它：`UTSJSONObject.getString` 是 UTS 专有方法，在纯 JS/单测环境里不存在，
		// 只有路径 A 时"能不能取到人话"就没法在单测里验证；而这段字符串索引逻辑在两种环境
		// 下行为完全一致，既可测，也能兜住"JSON 里带嵌套结构"的情况。
		const byKey = extractByKey(t, 'errMsg')
		if (byKey != '') {
			return cleanText(byKey)
		}
		for (let i = 0; i < 3; i++) {
			const k = i == 0 ? 'message' : (i == 1 ? 'msg' : 'error')
			const v = extractByKey(t, k)
			if (v != '') {
				return cleanText(v)
			}
		}
		// 是 JSON 但里面没有可读字段：不把结构体漏出去
		return fallback
	}
	return cleanText(t)
}

/**
 * 正文类文本清洗（消息详情、卡片摘要等"展示内容"）。
 *
 * 与 `humanizeErr` 的区别：这里不讲"失败"，讲"内容"——如果后端某条消息的 body
 * 是 JSON（系统消息 / 服务端拼接payload 的常见形态），界面就会把整段花括号
 * 直接呈现给用户。此处按 `text/summary/title/body/message` 顺序取人话，
 * 取不到就给一句中性说明，**绝不把结构体露出去**。
 */
export function prettyText(raw: string, fallback: string): string {
	const t = raw.trim()
	if (t == '') {
		return fallback
	}
	if (!looksLikeJson(t)) {
		return t
	}
	const keys: Array<string> = ['text', 'summary', 'title', 'body', 'message', 'content']
	for (let i = 0; i < keys.length; i++) {
		const v = extractByKey(t, keys[i])
		if (v != '') {
			return cleanText(v)
		}
	}
	return fallback
}

/** 去掉引号/括号等结构残留，压缩空白，限长。 */
function cleanText(s: string): string {
	let out = s
	const junk: Array<string> = ['{', '}', '[', ']', '"', '\'']
	for (let i = 0; i < junk.length; i++) {
		out = out.split(junk[i]).join('')
	}
	out = out.split('\n').join(' ').split('\t').join(' ').trim()
	while (out.indexOf('  ') >= 0) {
		out = out.split('  ').join(' ')
	}
	// 限长 80：既挡住系统结构体那种超长垃圾串，又不至于把正常的中文提示截断
	if (out.length > 80) {
		out = out.substring(0, 80) + '…'
	}
	return out == '' ? '操作失败，请重试' : out
}

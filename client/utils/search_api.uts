/**
 * 搜索入口（T-SR-1/2/3/4）：描述性搜索 + 以图搜图 + 降级态
 *
 * 链路（后端契约）：
 *  POST /api/v1/search            → {q, intent, content_types?, time_from?, time_to?, place?, tag?, limit, want_answer?}
 *    → SearchResult {query, rewritten_query, intent, hits[], total, latency_ms, degraded, answer?, answer_sources?}
 *  POST /api/v1/search/image      → multipart file（jpg/png ≤10MB）+ limit → SearchResult
 *  SearchHit {content_id, content_type, text, taken_at, place, event_id, event_title, score, trace{}}
 *
 * 降级态（T-SR-4）：degraded=true（Qdrant 降级纯 PG 检索）→ 页面黄条提示；
 * 网络失败/后端 5xx → 错误态（resolve(null) + toast）。
 *
 * 约定：resolve-only（永不 reject），失败 resolve(null) + toast。
 */
// O9 收口：错误信封解析统一走 api.ts 的 parseErrorString（原本地 parseSearchError 副本已删）
// R1#17：multipart 上传统一走 api.ts uploadFileHttp（401 重放 + 5xx Sentry + 信封解析）
// O15：搜索端点路径统一走 contract.ts（与 OpenAPI 对齐）
import { post, get, dataObj, showErrorToast, uploadFileHttp, HttpResult } from './api'
import { addBreadcrumb, captureMessage } from './sentry'
import { resolveMediaUrl } from './config'
import { PATH_SEARCH, PATH_SEARCH_IMAGE, PATH_SEARCH_ANSWER, PATH_CONTENTS } from './contract'

export class SearchHitItem {
	contentId: string
	contentType: string
	text: string
	takenAt: string
	place: string
	eventId: string
	eventTitle: string
	score: number
	trace: string // 溯源摘要（trace dict → 可读文本）
	/** 缩略图 URL（已 resolve；照片类结果卡显示用；空串=无图） */
	thumbnailUrl: string

	constructor(
		contentId: string,
		contentType: string,
		text: string,
		takenAt: string,
		place: string,
		eventId: string,
		eventTitle: string,
		score: number,
		trace: string,
		thumbnailUrl: string
	) {
		this.contentId = contentId
		this.contentType = contentType
		this.text = text
		this.takenAt = takenAt
		this.place = place
		this.eventId = eventId
		this.eventTitle = eventTitle
		this.score = score
		this.trace = trace
		this.thumbnailUrl = thumbnailUrl
	}
}

export class SearchOutcome {
	query: string
	rewrittenQuery: string
	intent: string
	hits: Array<SearchHitItem>
	total: number
	latencyMs: number
	degraded: boolean
	/** 回答卡正文（2026-10-16 冻结契约 SearchResult.answer；后端 null / 未请求 ⇒ 空串） */
	answer: string
	/** 回答引用的证据 content_id 列表（必为 hits 子集；空数组=模型未引用，属正常非错误） */
	answerSources: Array<string>
	/**
	 * 异步回答任务 id（A-11 ③ · 2026-10-24）。
	 * 非空 ⇒ 本次响应**没等回答**，正文要用 `fetchAnswerJob(jobId)` 轮询取回；
	 * 空串 ⇒ 后端是同步路径（老契约）或未请求回答。
	 */
	answerJobId: string

	constructor(
		query: string,
		rewrittenQuery: string,
		intent: string,
		hits: Array<SearchHitItem>,
		total: number,
		latencyMs: number,
		degraded: boolean,
		answer: string,
		answerSources: Array<string>,
		answerJobId: string = ''
	) {
		this.query = query
		this.rewrittenQuery = rewrittenQuery
		this.intent = intent
		this.hits = hits
		this.total = total
		this.latencyMs = latencyMs
		this.degraded = degraded
		this.answer = answer
		this.answerSources = answerSources
		this.answerJobId = answerJobId
	}
}

/**
 * 异步回答轮询结果（A-11 ③）。
 *
 * 三态的语义差别是**故意保留**的，调用方必须区分（否则会误导用户）：
 *   · `status == 'done'` 且 answer 为空  ⇒ **证据不足，本来就没有答案**（正常空态）；
 *   · `status == 'failed'`              ⇒ 系统降级（LLM 不可用/超时），可重试；
 *   · `status == 'pending'`             ⇒ 还在生成（调用方继续等）。
 * 把后两者当"没有答案"会让用户以为自己没记过这件事 —— 那正是本仓反复清理的一类谎。
 */
export class AnswerJobResult {
	status: string
	answer: string
	sources: Array<string>
	reason: string
	elapsedMs: number

	constructor(status: string, answer: string, sources: Array<string>, reason: string, elapsedMs: number) {
		this.status = status
		this.answer = answer
		this.sources = sources
		this.reason = reason
		this.elapsedMs = elapsedMs
	}
}

/** 内容类型中文名（结果卡片徽标） */
export function contentTypeCn(t: string): string {
	if (t == 'photo') {
		return '照片'
	}
	if (t == 'voice') {
		return '语音'
	}
	if (t == 'article') {
		return '文章'
	}
	return '文字'
}

/** 溯源 dict → 可读摘要（后端 trace 结构：{matched, dense_score, sparse_score, rrf}） */
function traceToText(trace: UTSJSONObject | null): string {
	if (trace == null) {
		return ''
	}
	const parts: Array<string> = []
	// matched 召回通道
	const matched = trace.getArray('matched')
	if (matched != null && matched.length > 0) {
		const names: Array<string> = []
		for (let i = 0; i < matched.length; i++) {
			const m = matched[i] as string
			if (m == 'dense') {
				names.push('语义')
			} else if (m == 'sparse') {
				names.push('关键词')
			} else {
				names.push(m)
			}
		}
		parts.push('召回：' + names.join('+'))
	}
	// 分数
	const dense = trace.getNumber('dense_score')
	const sparse = trace.getNumber('sparse_score')
	if (dense != null && dense > 0) {
		parts.push('语义分 ' + Math.round(dense * 1000) / 10)
	}
	if (sparse != null && sparse > 0) {
		parts.push('关键词分 ' + Math.round(sparse * 1000) / 10)
	}
	return parts.join(' · ')
}

/** 解析 SearchResult 信封 → SearchOutcome；失败 resolve(null) */
function parseSearch(body: UTSJSONObject | null): SearchOutcome | null {
	if (body == null) {
		return null
	}
	const d = dataObj(body)
	if (d == null) {
		return null
	}
	const hits: Array<SearchHitItem> = []
	const arr = d.getArray('hits')
	if (arr != null) {
		for (let i = 0; i < arr.length; i++) {
			const h = arr[i] as UTSJSONObject
			hits.push(
				new SearchHitItem(
					h.getString('content_id') ?? '',
					h.getString('content_type') ?? 'text',
					h.getString('text') ?? '',
					h.getString('taken_at') ?? '',
					h.getString('place') ?? '',
					h.getString('event_id') ?? '',
					h.getString('event_title') ?? '',
					h.getNumber('score') as number,
					traceToText(h.getJSON('trace')),
					// 2026-09-04 后端 SearchHit 补 thumbnail_url（Valet Key 票据，
					// 仅 photo 命中有值）→ resolveMediaUrl 拼直连地址，结果卡带图
					resolveMediaUrl(h.getString('thumbnail_url'))
				)
			)
		}
	}
	// 回答卡（2026-10-16 冻结契约）：字段缺失/为 null 一律落空串（容错——后端未部署新字段时不崩）
	const srcRaw = d.getArray('answer_sources')
	const answerSources: Array<string> = []
	if (srcRaw != null) {
		for (let i = 0; i < srcRaw.length; i++) {
			const sid = srcRaw[i] as string
			if (sid != null) {
				answerSources.push(sid)
			}
		}
	}
	return new SearchOutcome(
		d.getString('query') ?? '',
		d.getString('rewritten_query') ?? '',
		d.getString('intent') ?? '',
		hits,
		d.getNumber('total') as number,
		d.getNumber('latency_ms') as number,
		d.getBoolean('degraded') ?? false,
		d.getString('answer') ?? '',
		answerSources,
		// A-11 ③：异步路径下非空（老后端/同步路径 ⇒ 空串，容错不崩）
		d.getString('answer_job_id') ?? ''
	)
}

/**
 * 轮询取回异步回答（A-11 ③）。
 *
 * @param jobId `searchText(..., answerAsync=true)` 返回的 `answerJobId`
 * @param tries 最多轮询次数（每次间隔 `intervalMs`）
 * @param intervalMs 间隔毫秒。默认 400ms：后端实测 0.4~1.8s 出结果，
 *        400ms 首次通常在 1~2 次内拿到，又不至于把后端打满。
 * @return 终态结果；超时/网络失败/JSON 坏 ⇒ `null`（调用方按"没拿到"渲染诚实空态）
 *
 * ⚠️ 判「终态」的口径：`done` 与 `failed` 都算终态（继续等没有意义）；
 *    `pending` 才继续。**不要**只认 `done` —— 那会让 failed 白等到超时。
 */
export function fetchAnswerJob(jobId: string, tries: number = 15, intervalMs: number = 400): Promise<AnswerJobResult | null> {
	return new Promise<AnswerJobResult | null>((resolve) => {
		if (jobId == '') {
			resolve(null)
			return
		}
		fetchAnswerJobTick(jobId, tries, intervalMs, 0, resolve)
	})
}

function fetchAnswerJobTick(
	jobId: string,
	tries: number,
	intervalMs: number,
	count: number,
	done: (r: AnswerJobResult | null) => void
): void {
	const path = PATH_SEARCH_ANSWER.replace('{job_id}', jobId)
	get(path).then((res: UTSJSONObject | null) => {
		if (res == null) {
			// 404（过期/不存在）或网络失败：如实结束，不无限重试
			done(null)
			return
		}
		const d = dataObj(res)
		if (d == null) {
			done(null)
			return
		}
		const status = d.getString('status') ?? ''
		if (status == 'done' || status == 'failed') {
			const srcRaw = d.getArray('sources')
			const sources: Array<string> = []
			if (srcRaw != null) {
				for (let i = 0; i < srcRaw.length; i++) {
					const sid = srcRaw[i] as string
					if (sid != null) {
						sources.push(sid)
					}
				}
			}
			done(
				new AnswerJobResult(
					status,
					d.getString('answer') ?? '',
					sources,
					d.getString('reason') ?? '',
					d.getNumber('elapsed_ms') as number
				)
			)
			return
		}
		// pending：继续等；到上限仍 pending ⇒ 交回 null（调用方说"还在生成"）
		const next = count + 1
		if (next >= tries) {
			done(null)
			return
		}
		setTimeout(() => {
			fetchAnswerJobTick(jobId, tries, intervalMs, next, done)
		}, intervalMs)
	})
}

/**
 * 最近内容（搜索页进入时的默认列表）——2026-08-31 新增
 *
 * 为什么需要：后端 `SearchQuery.q` 要求 min_length=1，**不支持空词查询**；
 * 而搜索页进入时关键词为空 → 结果区一片空白，页面看着像坏了。
 * 改用 GET /api/v1/contents 拉最近内容兜底，用户一进页面就能看到自己的记忆。
 *
 * 与真实搜索的语义差异（调用方需知）：
 *  - score 恒为 0：表示"按时间倒序"，不是"按相关度"
 *  - intent='recent'：区别于搜索的 text/image/mixed
 *  - eventId/eventTitle 为空：contents 列表端点不返回事件归属
 *  - 命中缩略图 URL（contents 端点有 thumbnail_url，搜索端点暂无）
 */
export function fetchRecentContents(limit: number, contentTypes: Array<string>): Promise<SearchOutcome | null> {
	return new Promise<SearchOutcome | null>((resolve) => {
		get(PATH_CONTENTS + '?limit=' + limit).then((body: UTSJSONObject | null) => {
			if (body == null) {
				resolve(null)
				return
			}
			const d = dataObj(body)
			if (d == null) {
				resolve(null)
				return
			}
			const raw = d.getArray('items')
			const hits: Array<SearchHitItem> = []
			if (raw != null) {
				const arr = raw as Array<UTSJSONObject>
				for (let i = 0; i < arr.length; i++) {
					const c = arr[i]
					const ct = c.getString('content_type') ?? 'text'
					if (contentTypes.length > 0 && contentTypes.indexOf(ct) < 0) {
						continue // 与 filterContentTypes() 同源，服务端不筛则在端上筛
					}
					hits.push(new SearchHitItem(
						c.getString('id') ?? '',
						ct,
						c.getString('text') ?? '',
						c.getString('taken_at') ?? c.getString('created_at') ?? '',
						c.getString('place') ?? '',
						'',
						'',
						0,
						'',
						resolveMediaUrl(c.getString('thumbnail_url'))
					))
				}
			}
			resolve(new SearchOutcome('', '', 'recent', hits, hits.length, 0, false, '', []))
		})
	})
}

/** POST /search：描述性搜索；contentTypes 非空时按 photo/voice/text/article 过滤；返回 SearchOutcome 或 null
 *  2026-10-16：wantAnswer 为真时下发 `want_answer`（冻结契约，默认 false=完全旧行为）→ 结果带 `answer`/`answer_sources`。
 *  2026-10-24（A-11 ③）：`answerAsync` 为真时**额外**下发 `answer_async`
 *    ⇒ 响应不等回答、带 `answer_job_id`，正文由 `fetchAnswerJob` 轮询取回。
 *    ⚠️ 只有 `wantAnswer=true` 时本参数才有效（且关系，与后端契约一致）。 */
export function searchText(
	query: string,
	limit: number,
	contentTypes: Array<string>,
	wantAnswer: boolean = false,
	answerAsync: boolean = false
): Promise<SearchOutcome | null> {
	const body: UTSJSONObject = {
		q: query,
		limit: limit
	}
	// 仅在指定类型时下发 content_types（空数组=全部，不下发避免后端误判）
	if (contentTypes.length > 0) {
		body.set('content_types', contentTypes)
	}
	if (wantAnswer) {
		body.set('want_answer', true)
		// 且关系：want_answer=false 时后端不会起 job，故不必下发（少一个字段=少一种误解）
		if (answerAsync) {
			body.set('answer_async', true)
		}
	}
	// B13 面包屑（2026-09-23）：addBreadcrumb 此前**零调用**⇒ 上报事件到达时没有任何
	// "之前发生了什么"的轨迹。**隐私纪律：只记长度/标签，绝不记用户原文**——面包屑随事件
	// 发往 Sentry（外部服务），用户搜索词属于个人内容。
	addBreadcrumb('search', 'text q_len=' + query.length + (contentTypes.length > 0 ? ' filtered' : ''))
	return new Promise<SearchOutcome | null>((resolve) => {
		post(PATH_SEARCH, body).then((res: UTSJSONObject | null) => {
			const out = parseSearch(res)
			if (out != null && out.degraded) {
				// 降级＝关键词检索退回兜底结果：用户会看到"有结果但不是想要的"，
				// 而**没有任何异常抛出** ⇒ 只能靠消息事件上报，否则线上完全无迹可循
				// （captureMessage 此前零调用，正是这类"非异常但用户可感"状态的唯一载体）
				captureMessage('search degraded fallback', 'warning')
			}
			resolve(out)
		})
	})
}

/** POST /search/image：以图搜图（multipart）；返回 SearchOutcome 或 null
 *  R1#17：multipart 上传统一走 api.ts uploadFileHttp（401 重放 + 5xx Sentry + 信封解析） */
export function searchByImage(filePath: string, limit: number): Promise<SearchOutcome | null> {
	// B13 面包屑：只记动作与上限，不记文件路径（路径含用户隐私且对排障无增量信息）
	addBreadcrumb('search', 'image upload limit=' + limit)
	return new Promise<SearchOutcome | null>((resolve) => {
		uploadFileHttp(PATH_SEARCH_IMAGE + '?limit=' + limit, filePath, 'file', null, 30000).then((hr: HttpResult) => {
			if (hr.status === 200) {
				// uploadFile res.data 是 string（lessons.md #3）；uploadFileHttp 已按信封解析
				resolve(parseSearch(hr.body))
				return
			}
			const msg = hr.body != null ? (hr.body.getString('message') ?? '搜索失败（HTTP ' + hr.status + '）') : '搜索失败（HTTP ' + hr.status + '）'
			showErrorToast(new Error(msg))
			resolve(null)
		})
	})
}

/**
 * 单文件上传管线（O16 收口：uploader/voice 的 init→status→chunk→complete 编排统一封装）
 *
 * uploader.ts 与 voice.ts 此前各自写一遍 init→chunk→complete（含 4xx 停条 / 网络·5xx
 * 可重试的语义映射），两处漂移。现统一本模块：
 *  - 状态机：init（建任务，client_upload_id 幂等）→ status（断点查询缺失分片）→
 *    chunk（传单片）→ complete（建内容记录）→ {content_id, file_key}
 *  - 断点续传：调用方把已有 upload_id 传 resumeUploadId（应用重启后从持久化恢复），
 *    本模块跳过 init 直接 status 补传；新建时经 onNewUploadId 回调让调用方持久化 upload_id
 *  - 错误语义：UploadPipeError.permanent=true（4xx 停条，重试无意义）/ false（网络·5xx 可退避重试）
 * 调用方保留业务编排：uploader 批量并发池 + held/failed 队列 / voice 录音状态机。
 */
import { getBaseUrl } from './config'
// 2026-10-11 固定地址模式：出网头统一走 api.uts 的 buildHeader（含 ngrok-skip-browser-warning，
// 见 api.uts 的 buildHeader 注释）。本文件此前的 statusMissing 自拼 header，会漏掉通用头。
import { buildHeader } from './api'
import { initUpload, putChunk, completeUpload, fieldOf, UploadResp } from './upload_protocol'
// 待补原件队列连 PhotoItem 一起存（WiFi 补原件时才能重跑 uploadWithRetry）
import { PhotoItem } from '@/uni_modules/yishu-photo-watch/utssdk/interface.uts'
import { PATH_UPLOAD_STATUS, FIELD_UPLOAD_ID, FIELD_MISSING_CHUNKS, FIELD_FILE_KEY, FIELD_CONTENT_ID, FIELD_UPLOAD_MODE } from './contract'

/** 单文件上传规格（调用方组装） */
export class UploadSpec {
	/** 幂等键（client_upload_id：照片 path / voice|path） */
	clientUploadId: string
	fileName: string
	fileSize: number
	filePath: string
	uploadMode: string
	/** 断点续传：已有 upload_id（'' = 新建任务） */
	resumeUploadId: string

	constructor(clientUploadId: string, fileName: string, fileSize: number, filePath: string, uploadMode: string, resumeUploadId: string = '') {
		this.clientUploadId = clientUploadId
		this.fileName = fileName
		this.fileSize = fileSize
		this.filePath = filePath
		this.uploadMode = uploadMode
		this.resumeUploadId = resumeUploadId
	}
}

/** 管线结果：content_id + file_key + 实际使用的 upload_id */
export class UploadOutcome {
	contentId: string
	fileKey: string
	uploadId: string

	constructor(contentId: string, fileKey: string, uploadId: string) {
		this.contentId = contentId
		this.fileKey = fileKey
		this.uploadId = uploadId
	}
}

/** 管线错误：permanent=true（4xx 停条，重试无意义）/ false（网络·5xx，可退避重试） */
export class UploadPipeError extends Error {
	status: number
	permanent: boolean

	constructor(status: number, message: string, permanent: boolean) {
		super(message)
		this.status = status
		this.permanent = permanent
	}
}

// ═══════════ 蜂窝省流：缩略图压缩 + 待补原件队列（2026-10-16 · A1 五步方案）═══════════
//
// 背景（根因 RC-D）：`uploader_net.resolveMode(auto+cellular)` 曾恒返回 `hold` ⇒ 蜂窝下
// **整批照片一张都不传**，全部挂起等 WiFi（"链路中段被恒假条件短路"）。B4 流量约束的本意是
// "蜂窝只传缩略图+元数据"（省流），缺的只是"压缩步骤从未接线"。
//
// 本段接线（五步）：① resolveMode 返回 'thumbnail'（见 uploader_net）→ ② 此处压缩 →
// ③ 用**压缩件**大小/路径走同一 init→chunk→complete，complete 的 meta.upload_mode='thumbnail_meta'
// 让后端只落缩略图占位（extra.original_pending=true）→ ④ 登记**待补原件队列**（独立于 held：
// 缩略图已传故不得算"待上传"，见 PENDING_ORIGINAL_KEY 注释）；WiFi 恢复/点"立即上传原图"时
// `continuePendingUploads` 复用同一管线，凭 meta.content_id 走 update 补原件 → ⑤ 压缩失败退回 held（真·未成功）。
//
// 两条**硬约束**（决定实现形态，勿简化）：
//  1. **压缩失败必须退回 hold**，绝不许用原图冒充缩略图——那会把 3MB 原图当缩略图上传、偷跑用户流量，
//     比"传不了"更严重。故压缩在"批量入口"先做一次预检，失败即入 held（见 uploader_batch.UploadPool）。
//  2. **后端 complete 要求合并后字节数 == init 声明的 file_size**（services/upload/protocol.py:261），
//     故缩略图上传必须以**压缩件大小**重新 init（不能沿用原图 size）；压缩件大小取自
//     `getFileSystemManager().getFileInfo`（沙箱临时文件可读，voice.uts 同款；"MediaStore 绝对路径读不到"
//     是 uploader_photo 的另一回事）。声明偏小/偏大都会被后端拒绝。

/** 缩略图压缩质量（0-100；60 兼顾清晰度与体积） */
const THUMBNAIL_QUALITY: number = 60

/** 补原件任务的 client_upload_id 后缀——**必须与缩略图任务区分**：后端 init 按 client_upload_id
 *  幂等（protocol.py:100-107），若复用同一 id，补原件会命中已完成的缩略图任务，后端 complete 对
 *  已完成任务直接回旧 file_key（protocol.py:246-247）、不会用新字节重新合并 ⇒ 原件永远挂不上且不报错。 */
const SUPPLEMENT_ID_SUFFIX: string = '_orig'

/** 待补原件队列存储键：`path|content_id|takenAt|width|height|size|lat|lng|id` 行分隔。
 *
 *  语义（2026-10-16 · 评审后修正）：**单独成队列，绝不混入 uploader_queue 的 held**——
 *  held 必须只代表"还没成功上传的"；而本队列每一项的**缩略图已经传上去了**（只是原图待 WiFi 补）。
 *  若混进 held，横幅会显示"N 张待 WiFi 上传"去催已经传完的照片（观感"传完还在催我" ✗）。
 *  故本队列不参与 heldCount()；消费方＝continuePendingUploads（"立即上传原图"按钮 + WiFi 自动恢复）。
 *
 *  ⚠️ 降级（如实登记、不静默）：本表存 uni storage。若被清空（用户"清除应用数据"/换机重装/系统回收存储），
 *  该 path 不再被判为"补原件"，退化成普通 original 上传：init 幂等键仍为 path、会命中此前**已完成的
 *  缩略图任务** ⇒ 后端 complete 对已完成任务直接回旧 file_key、不重新合并字节（protocol.py:246-247）；
 *  register 又因 cos_key 命中占位而返回既有 content_id ⇒ **表面成功但原图未真正挂上**（不报错）。
 *  彻底修法需后端配合（或改用可区分幂等键），超出本轮边界，先登记。 */
const PENDING_ORIGINAL_KEY: string = 'yishu_pending_original'

/** 缩略图压缩件内存缓存（原图 path → 压缩件临时路径；避免"批量入口预检 + 管线"两次压缩）。
 *  仅 get/set；失效用置空串标记（UTS Map 的 delete 在本仓无先例，不引入）。 */
const _thumbPathCache: Map<string, string> = new Map<string, string>()

/** 压缩不可用/失败（平台不支持 uni.compressImage / 调用失败 / 大小读不到）。
 *  调用方（uploader_batch 批量入口）捕获后**退回 held**，不得继续上传。 */
export class ThumbnailUnavailableError extends Error {
	constructor(message: string) {
		super(message)
	}
}

/** 待补原件队列行（PhotoItem 行前置 content_id，补原件时走后端 update 模式） */
function pendingOriginalEntry(item: PhotoItem, contentId: string): string {
	const la = item.lat != null ? '' + item.lat : ''
	const ln = item.lng != null ? '' + item.lng : ''
	return item.path + '|' + contentId + '|' + item.takenAt + '|' + item.width + '|' + item.height + '|' + item.size + '|' + la + '|' + ln + '|' + item.id
}

function readPendingOriginal(): Array<string> {
	const raw = uni.getStorageSync(PENDING_ORIGINAL_KEY) as string
	if (raw == null || raw == '') {
		return []
	}
	const out: Array<string> = []
	const lines = raw.split('\n')
	for (let i = 0; i < lines.length; i++) {
		if (lines[i] != '') {
			out.push(lines[i])
		}
	}
	return out
}

function writePendingOriginal(lines: Array<string>): void {
	uni.setStorageSync(PENDING_ORIGINAL_KEY, lines.join('\n'))
}

/** 读某 path 的待补原件 content_id（无则空串） */
export function pendingOriginalContentId(path: string): string {
	const lines = readPendingOriginal()
	for (let i = 0; i < lines.length; i++) {
		const parts = lines[i].split('|')
		if (parts.length >= 2 && parts[0] == path) {
			return parts[1]
		}
	}
	return ''
}

/** 登记待补原件（缩略图入库时由批量入口调用——它才有 PhotoItem；同 path 覆盖式，幂等） */
export function addPendingOriginal(item: PhotoItem, contentId: string): void {
	const line = pendingOriginalEntry(item, contentId)
	const lines = readPendingOriginal()
	for (let i = 0; i < lines.length; i++) {
		if (lines[i].startsWith(item.path + '|')) {
			lines[i] = line
			writePendingOriginal(lines)
			return
		}
	}
	lines.push(line)
	writePendingOriginal(lines)
}

/** 待补原件列表（消费方：continuePendingUploads 补原图时；行残缺的跳过） */
export function pendingOriginalItems(): Array<PhotoItem> {
	const lines = readPendingOriginal()
	const out: Array<PhotoItem> = []
	for (let i = 0; i < lines.length; i++) {
		const parts = lines[i].split('|')
		if (parts.length < 9) {
			continue
		}
		const la = parts[6] == '' ? null : parseFloat(parts[6])
		const ln = parts[7] == '' ? null : parseFloat(parts[7])
		const id = parts[8] != '' ? parseInt(parts[8]) : 0
		out.push(new PhotoItem(id, parts[0], parseInt(parts[2]), parseInt(parts[3]), parseInt(parts[4]), la, ln, parseInt(parts[5])))
	}
	return out
}

/** 清除待补原件（原件补齐后调用） */
export function clearPendingOriginal(path: string): void {
	const lines = readPendingOriginal()
	const kept: Array<string> = []
	for (let i = 0; i < lines.length; i++) {
		if (!lines[i].startsWith(path + '|')) {
			kept.push(lines[i])
		}
	}
	writePendingOriginal(kept)
}

/** 生成缩略图压缩件（`uni.compressImage`；app-android 受支持，HBuilderX dts 已取证：
 *  CompressImageOptions{src,quality,...} → CompressImageSuccess{tempFilePath}）。
 *  命中缓存直接返回（批量入口已预压过）。成功 resolve 压缩件临时路径。 */
export function compressForThumbnail(srcPath: string): Promise<string> {
	// 读法对齐 api.uts.fetchThumbnailPath（本仓已验证的 UTS Map 取用惯用法）
	const cached = _thumbPathCache.get(srcPath)
	if (cached != null && cached != '') {
		return Promise.resolve(cached as string)
	}
	return new Promise<string>((resolve, reject) => {
		try {
			uni.compressImage({
				src: srcPath,
				quality: THUMBNAIL_QUALITY,
				success: (res) => {
					const p: string = res.tempFilePath
					if (p == null || p == '') {
						reject(new ThumbnailUnavailableError('compressImage 未返回压缩件路径'))
						return
					}
					_thumbPathCache.set(srcPath, p)
					resolve(p)
				},
				fail: () => {
					reject(new ThumbnailUnavailableError('compressImage 调用失败'))
				}
			})
		} catch (e) {
			// 平台不支持 uni.compressImage 时**同步抛错**——必须转成可识别失败（调用方退回 held），
			// 绝不能静默继续（继续就会拿原图冒充缩略图）。
			reject(new ThumbnailUnavailableError('本平台不支持 uni.compressImage: ' + e))
		}
	})
}

/** 压缩件字节数（init 必填；后端 complete 会按此校验合并大小，见文件段头硬约束 2） */
function compressedSizeOf(filePath: string): Promise<number> {
	return new Promise<number>((resolve, reject) => {
		uni.getFileSystemManager().getFileInfo({
			filePath: filePath,
			success: (info) => {
				if (info.size > 0) {
					resolve(info.size)
					return
				}
				reject(new ThumbnailUnavailableError('压缩件大小异常（' + info.size + '）'))
			},
			fail: () => {
				reject(new ThumbnailUnavailableError('压缩件大小读取失败'))
			}
		})
	})
}

/** 压缩件用完即弃：置空串作失效标记（临时文件由系统回收） */
function forgetThumbnail(srcPath: string): void {
	_thumbPathCache.set(srcPath, '')
}

/** 建任务（client_upload_id 幂等）→ upload_id；4xx → permanent 错误 */
function initFor(spec: UploadSpec): Promise<string> {
	return new Promise<string>((resolve, reject) => {
		initUpload(spec.clientUploadId, spec.fileName, spec.fileSize, spec.uploadMode).then((resp: UploadResp) => {
			if (resp.status === 200) {
				const uploadId = fieldOf(resp.raw, FIELD_UPLOAD_ID)
				if (uploadId == '') {
					reject(new UploadPipeError(0, 'init 无 upload_id', false))
					return
				}
				resolve(uploadId)
				return
			}
			reject(new UploadPipeError(resp.status, 'init HTTP ' + resp.status, resp.status >= 400 && resp.status < 500))
		})
	})
}

/** 查断点状态：缺失分片 true（缺 0 或空数组=已完成）；非 200 视为需补传（交给 chunk 暴露真实错误） */
function statusMissing(uploadId: string): Promise<boolean> {
	return new Promise<boolean>((resolve) => {
		const header: UTSJSONObject = buildHeader('')
		uni.request({
			url: getBaseUrl() + PATH_UPLOAD_STATUS + '?upload_id=' + uploadId,
			method: 'GET',
			header: header,
			timeout: 15000,
			success: (res) => {
				if (res.statusCode === 200) {
					const raw = JSON.stringify(res.data)
					const missing = fieldOf(raw, FIELD_MISSING_CHUNKS)
					resolve(missing != '[]' && missing != '')
				} else {
					resolve(true)
				}
			},
			fail: () => resolve(true)
		})
	})
}

/** 传单片（multipart；后端幂等 + 大小校验）；4xx → permanent 错误 */
function putChunkFor(uploadId: string, filePath: string): Promise<boolean> {
	return new Promise<boolean>((resolve, reject) => {
		putChunk(uploadId, filePath, 60000).then((status: number) => {
			if (status === 200) {
				resolve(true)
				return
			}
			if (status >= 400 && status < 500) {
				reject(new UploadPipeError(status, 'chunk HTTP ' + status, true))
				return
			}
			reject(new UploadPipeError(status, 'chunk 网络失败', false))
		})
	})
}

/** complete：建内容记录（meta 调用方构造）→ content_id/file_key；4xx → permanent 错误 */
function completeFor(uploadId: string, meta: UTSJSONObject): Promise<UploadOutcome> {
	return new Promise<UploadOutcome>((resolve, reject) => {
		completeUpload(uploadId, meta).then((resp: UploadResp) => {
			if (resp.status === 200) {
				const cid = fieldOf(resp.raw, FIELD_CONTENT_ID)
				if (cid == '') {
					reject(new UploadPipeError(0, 'complete 无 content_id', false))
					return
				}
				resolve(new UploadOutcome(cid, fieldOf(resp.raw, FIELD_FILE_KEY), uploadId))
				return
			}
			reject(new UploadPipeError(resp.status, 'complete HTTP ' + resp.status, resp.status >= 400 && resp.status < 500))
		})
	})
}

/** 状态机执行（内部）：给定已决的 spec（路径/大小/幂等键/后端模式）+ meta 构造器，
 *  走 init（建任务，client_upload_id 幂等）→ status（断点查询）→ chunk → complete。 */
function runSpecPipeline(
	spec: UploadSpec,
	buildMeta: () => UTSJSONObject,
	onNewUploadId: (uploadId: string) => void,
	onCompleted: (uploadId: string) => void
): Promise<UploadOutcome> {
	return new Promise<UploadOutcome>((resolve, reject) => {
		const finish: (uploadId: string, meta: UTSJSONObject) => void = (uploadId, meta) => {
			completeFor(uploadId, meta).then((out: UploadOutcome) => {
				onCompleted(uploadId)
				resolve(out)
			}, (e: Error) => {
				reject(e)
			})
		}
		const send: (uploadId: string) => void = (uploadId) => {
			putChunkFor(uploadId, spec.filePath).then(() => {
				finish(uploadId, buildMeta())
			}, (e: Error) => {
				reject(e)
			})
		}
		const resumeOrChunk: (uploadId: string) => void = (uploadId) => {
			statusMissing(uploadId).then((missing: boolean) => {
				if (!missing) {
					finish(uploadId, buildMeta())
				} else {
					send(uploadId)
				}
			})
		}
		if (spec.resumeUploadId != '') {
			// 断点：已有 upload_id → 直接 status 补传（应用重启后续传路径）
			resumeOrChunk(spec.resumeUploadId)
			return
		}
		initFor(spec).then((uploadId: string) => {
			onNewUploadId(uploadId)
			resumeOrChunk(uploadId)
		}, (e: Error) => {
			reject(e)
		})
	})
}

/** 走完整上传管线（含断点补传 + 蜂窝省流）；成功 resolve UploadOutcome；失败 reject upload 错误。
 *
 *  蜂窝省流（2026-10-16 · A1）：spec.uploadMode=='thumbnail' 时先压缩再上传缩略图
 *  （complete 的 meta.upload_mode='thumbnail_meta'），成功后登记待补原件；WiFi 恢复补原件时走
 *  **同一管线**，凭 meta.content_id 触发后端 update（复用同 complete 端点，不新建监听）。
 *
 *  onNewUploadId：新建任务时回调（调用方持久化 upload_id 供重启续传）；
 *  onCompleted：成功完成时回调（调用方清理持久化的 upload_id）。 */
export function runUploadPipeline(
	spec: UploadSpec,
	buildMeta: () => UTSJSONObject,
	onNewUploadId: (uploadId: string) => void,
	onCompleted: (uploadId: string) => void
): Promise<UploadOutcome> {
	const isThumb: boolean = spec.uploadMode == 'thumbnail'
	// 补原件判定：该 path 已在待补队列（缩略图已入库、原图未补）⇒ 本次要"挂原件到既有占位"
	const pendingCid: string = isThumb ? '' : pendingOriginalContentId(spec.clientUploadId)
	const isSupplement: boolean = pendingCid != ''
	// 后端 upload_mode 只认 original / thumbnail_meta（services/upload/protocol.py:28）；
	// 客户端的 'thumbnail' 是内部模式名，这里映射。补原件走 original + meta.content_id。
	const backendMode: string = isThumb ? 'thumbnail_meta' : 'original'

	const metaBuilder: () => UTSJSONObject = (): UTSJSONObject => {
		const meta: UTSJSONObject = buildMeta()
		meta.set(FIELD_UPLOAD_MODE, backendMode)
		if (isSupplement) {
			// 后端 register 见 meta.content_id 即转 update 模式（services/upload/register.py:88-89），
			// 把原件挂到缩略图占位内容并触发完整管线（不新建重复内容）。
			meta.set(FIELD_CONTENT_ID, pendingCid)
		}
		return meta
	}

	const afterDone: (out: UploadOutcome) => UploadOutcome = (out: UploadOutcome): UploadOutcome => {
		if (isThumb) {
			// 缩略图入库：只释放压缩件缓存。**待补原件登记由批量入口做**（它才有 PhotoItem——
			// 队列须连 PhotoItem 一起存，WiFi 补原件时才能重跑 uploadWithRetry）。
			forgetThumbnail(spec.filePath)
		} else if (isSupplement) {
			// 原件已补齐 ⇒ 清待补登记
			clearPendingOriginal(spec.clientUploadId)
		}
		return out
	}

	if (!isThumb) {
		// 补原件**另起任务**：幂等键加后缀 + 不复用断点 id（见 SUPPLEMENT_ID_SUFFIX 注释）；
		// 其余（WiFi 原图 / 手动"立即上传原图"）行为不变（沿用调用方幂等键与断点 id）。
		const target = new UploadSpec(
			isSupplement ? spec.clientUploadId + SUPPLEMENT_ID_SUFFIX : spec.clientUploadId,
			spec.fileName,
			spec.fileSize,
			spec.filePath,
			'original',
			isSupplement ? '' : spec.resumeUploadId
		)
		return runSpecPipeline(target, metaBuilder, onNewUploadId, onCompleted).then(afterDone)
	}

	// thumbnail：先压缩（缓存命中即复用批量入口的预压结果），再用**压缩件**大小/路径走同一状态机。
	return compressForThumbnail(spec.filePath).then((thumbPath: string) => {
		return compressedSizeOf(thumbPath).then((thumbSize: number) => {
			const target = new UploadSpec(
				spec.clientUploadId,
				spec.fileName,
				thumbSize,
				thumbPath,
				'thumbnail_meta',
				spec.resumeUploadId
			)
			return runSpecPipeline(target, metaBuilder, onNewUploadId, onCompleted).then(afterDone)
		})
	})
}

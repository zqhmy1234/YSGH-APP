/**
 * 端侧聚合运行器（S-AG-3/4 · B3-6 端侧 L0/L1 真值）
 *
 * 上传成功照片（本地元数据 + 云侧 content_id）→ UTS ST-DBSCAN 算法层
 * → L1 日卡片事件（client_event_id 幂等键）→ 供 POST /events/sync 上云。
 * 与云侧 AGG-016 同参同逻辑（agg_config 单一来源）。
 */
import { ref } from 'vue'
import { L0_EPS_S_M, L0_MIN_PTS, l0EpsTsec } from '@/utils/agg/agg_config.uts'
import { preprocess, RawPhoto } from '@/utils/agg/pipeline.uts'
import { DayCard, Photo, l1DailyAggregate, stDbscan } from '@/utils/agg/st_dbscan.uts'
import { UploadedPhoto } from '@/utils/uploader_types'

/** 端侧 L1 事件（POST /events/sync 载荷） */
export class ClientL1Event {
	clientEventId: string
	title: string
	startTime: number      // epoch ms
	endTime: number        // epoch ms
	photoIds: string[]     // 云侧 content_id 列表

	constructor(clientEventId: string, title: string, startTime: number, endTime: number, photoIds: string[]) {
		this.clientEventId = clientEventId
		this.title = title
		this.startTime = startTime
		this.endTime = endTime
		this.photoIds = photoIds
	}
}

export class AggRunResult {
	events: ClientL1Event[]
	clusterCount: number

	constructor(events: ClientL1Event[], clusterCount: number) {
		this.events = events
		this.clusterCount = clusterCount
	}
}

/** 生成客户端事件幂等键（时间戳 + 随机后缀，同用户唯一） */
function genClientEventId(): string {
	return 'ev-' + Date.now() + '-' + Math.floor(Math.random() * 1000000)
}

/**
 * 照片去重键（djb2 → hex；同文件重扫/重复注入取同键）
 *
 * MVP 感知哈希占位：UTS 无像素解码 API，以「文件路径 + 字节数」做内容身份键，
 * 与云端 contents.perceptual_hash 语义对齐（同用户同哈希只保留一条）——
 * 真实像素级感知哈希由后端 CI 管线计算（本键仅做端侧预处理去重用）。
 */
function photoHashOf(u: UploadedPhoto): string {
	const s = u.item.path + '|' + u.item.size
	let h = 5381
	for (let i = 0; i < s.length; i++) {
		const c = s.charCodeAt(i) ?? 0
		h = ((h << 5) + h + c) & 0x7fffffff
	}
	return h.toString(16)
}

/**
 * 端侧聚类**降级阈值**（数值为**量级估计**，非实测标定）（2026-10-16 · 批次 6 · RC-7）。
 *
 * 语义：`pts.length > AGG_CLIENT_MAX_N` ⇒ **跳过**端侧 ST-DBSCAN（O(n²) 且 UTS 无 worker，
 * 大 n 同步跑会一次性独占主线程），**本次不产端侧 L1**。O(n²) 只在大 n 致命，故"大 n 降级"
 * 与"小 n 端侧跑（保住拍照即出日卡）"是同一枚硬币的两面（方向经复核确认）。
 *
 * ⚠️ **后果必须知道（不许静默）**：本仓**云侧只产 L2/L3，没有 L1 生产者**
 * （`backend/app/services/events/aggregate.py:82-84`）⇒ 跳过就等于**当天时间轴空**
 * ⇒ 降级分支必须 **WARN + 计数**（`degradeRuns` / `getDegradeRuns()`）并写明这一后果。
 *
 * 为什么**几乎永不触发**（实测依据）：真库观测**单用户单日最多 81 条**照片 ⇒ 400 有 **5× 余量**。
 * 阈值数值本身是**量级估计**（同 `st_dbscan` 的 `CANDIDATE_WARN=200000` 与「60min 窗内可达
 * 点数上界≈720（<5s 连拍折叠）」同源量级），**非实测标定**。
 *
 * ❗遗留**产品决策**：「端侧硬顶（降级）以上是否需要云端产 L1」——**现在没有 L1 生产者**，
 *   所以降级即空白；是否补后端 L1 生产者、或改由端侧无条件跑，由产品/协调者定，本文件不擅自决定。
 */
export const AGG_CLIENT_MAX_N: number = 400
/** 降级次数（越顶跳过时 ++，配合 WARN 使用；`getDegradeRuns()` 可核对是否真被触发） */
let degradeRuns = 0
export function getDegradeRuns(): number {
	return degradeRuns
}

// ─────────────────────────────────────────────────────────────────────────────
// B-17（2026-10-24）：降级**必须让用户看得见**——日志/计数只服务排障，不服务用户
//
// 缺陷形态：`pts.length > AGG_CLIENT_MAX_N` ⇒ 跳过端侧 ST-DBSCAN ⇒ **本次不出 L1**；而云侧
// 只产 L2/L3、**没有 L1 生产者**（见上方常量注释）⇒ 这些照片**当天在时间轴上不存在**。
// 修前处置只有 `console.warn` + `degradeRuns++`：用户看到的是「时间轴空着」，**零感知**、
// 也无从知道"稍后重试可能有"——这是「静默降级」最坏的一类（用户以为记忆丢了）。
//
// 处置：把"本次聚合被跳过"这个**事实**导出成一个响应式字符串（用户能读懂的一句话），
// 由 UI 用一行低调提示渲染（`components/AggDegradeNotice`，宿主 TabIndex）。
// 口径边界（**不撒谎**）：
//   · 文案只说"本次未生成" + "可稍后重试"，**不写"加载中"**（那是假状态：没有任何在跑的
//     任务会把它变成有），也不承诺"明天一定有"（云侧无 L1 生产者这一前提未变）；
//   · 该值**只反映最近一次聚合运行**：一次成功的运行（`pts.length > 0` 且未越顶）会把它清回
//     空串——否则警告会永久挂在页面上，变成噪音（用户对常驻红字会免疫）。
//   · 空输入/未运行过 ⇒ 空串 ⇒ UI 不显示任何东西（无"占位行"）。
// 为什么用 `ref` 而不是普通 getter：UI 要**在降级发生的当拍**改变显示，普通函数返回值没有
// 响应式依赖，computed 会永久缓存（本仓 RC-12 已踩过"裸 let 不响应"的同族坑）。
// ─────────────────────────────────────────────────────────────────────────────

/** 降级提示文案（单一真源；改文案只改这里） */
const AGG_DEGRADE_NOTICE: string = '照片较多，本次未生成今日时间轴 · 可稍后重试'

/** 端侧聚类降级的**用户可见**提示；`''` = 最近一次聚合未降级（正常） */
export let aggDegradeNotice = ref('')

/** 分片粒度：组装阶段每片处理多少张（片间 `setTimeout(0)` 让出主线程） */
const AGG_CHUNK_N: number = 50

// ─────────────────────────────────────────────────────────────────────────────
// B-12 下游（2026-10-24）：「拍摄时间未知」进聚合时必须**显式 fallback**，不许静默
//
// 背景：`PhotoItem.takenAt` 的三档语义是 `>0` 真值 / `==0` 未知。手动选图读不到 EXIF
// DateTimeOriginal 时是 `0`，而**本函数就是"靠 takenAt 分日卡"的那一环**：
//   `bucketDay(0, tz)` ⇒ `1970-01-01` ⇒ 这张照片会孤零零落进**1970 年那张卡**。
// 那不是"时间未知"，那是"时间错了"——用户在时间轴里翻到 1970 会以为数据坏了，比落错今天更荒谬。
//
// 处置（**显式 fallback**，即任务书要求的"不要静默用 now"）：
//   · 仍用 `Date.now()` 兜底入聚合 —— 否则这张照片**根本不进时间轴**
//     （云侧只产 L2/L3、无 L1 生产者，见 AGG_CLIENT_MAX_N 注释），等于"补记的照片看不见"；
//   · 但**必须** WARN + 计数 + 记 content_id，文案写明"这是 fallback，不是拍摄时刻"，
//     使"落到了今天这张卡"这件事**可观测、可解释**，而不是悄悄发生。
// 取舍依据：落今天（可见 + 日志说明"时间未知，按记录日归卡"）> 落 1970（可见但时间错）
//           > 不进时间轴（不可见）。三项里只有第一项既保可见性又不撒谎。
let timeFallbackN = 0
/** 本次聚合运行内的 fallback 次数（诊断用） */
let runFallbackN = 0

/** 累计 fallback 次数（非 0 ⇒ 确有"时间未知"的照片被按记录日归卡） */
export function getTimeFallbackN(): number {
	return timeFallbackN
}

/**
 * 取入聚合用的时间戳：`takenAt > 0` 用真值；否则回落 `Date.now()` 并计数 + WARN。
 * **回落是显式且被记录的**（见上方注释），绝不假装它就是拍摄时刻。
 */
function aggTsOf(u: UploadedPhoto): number {
	const t: number = u.item.takenAt
	if (t > 0) {
		return t
	}
	timeFallbackN++
	runFallbackN++
	console.warn('[yishu-agg] 拍摄时间未知（takenAt=0）⇒ 按**记录日**归卡（fallback，非拍摄时刻）content=' + u.contentId)
	return Date.now()
}

/** 组装算法层输入（photo id = content_id；ts = 本地拍摄时间；phash = 文件身份键） */
function buildRaws(uploads: Array<UploadedPhoto>): Array<RawPhoto> {
	const raws: RawPhoto[] = []
	for (let i = 0; i < uploads.length; i++) {
		const u = uploads[i]
		raws.push(new RawPhoto(u.contentId, aggTsOf(u), u.item.lat, u.item.lng, [], photoHashOf(u)))
	}
	return raws
}

/** 日卡片 → L1 事件（title 用卡片日期；时间窗取成员首末） */
function buildEventsFromDays(days: Array<DayCard>): Array<ClientL1Event> {
	const events: Array<ClientL1Event> = []
	for (let i = 0; i < days.length; i++) {
		const d = days[i]
		if (d.photos.length === 0) {
			continue
		}
		const ids: string[] = []
		let minTs = d.photos[0].ts
		let maxTs = d.photos[0].ts
		for (let j = 0; j < d.photos.length; j++) {
			const p = d.photos[j]
			ids.push(p.id)
			if (p.ts < minTs) {
				minTs = p.ts
			}
			if (p.ts > maxTs) {
				maxTs = p.ts
			}
		}
		events.push(new ClientL1Event(
			genClientEventId(),
			d.date + ' · ' + d.photos.length + '条',
			minTs,
			maxTs,
			ids
		))
	}
	return events
}

/**
 * 预处理 → L0 → L1 → 事件（同步入口的核心；同步/分片两个入口共用）。
 *
 * **分片不切聚类本体**（2026-10-16 · 批次 6 · RC-7）：ST-DBSCAN 是**连通分量**算法（簇靠链式
 * 扩展，可能跨任意时间距离），切输入会改变簇归属 ⇒ 废掉 RC-7 用 `scripts/bench_st_dbscan.py`
 * 挣来的**逐位等价**保证。故分片只作用在**组装阶段**（见 `chunkStep`），聚类一律整体跑；
 * 规模靠 `AGG_CLIENT_MAX_N` 兜底：越顶**降级（跳过）**并 WARN + 计数，后果见该常量注释。
 */
function finishAgg(pts: Array<Photo>, tzOffsetMin: number): AggRunResult {
	// B-17：**每次运行都先归零**——本值语义是「最近一次聚合是否降级」，不是"历史上降没降过"。
	// 放在这里（而不是只在成功分支清）能保证「降级 → 用户重试 → 这次只有 0 张照片」也不会
	// 留下一句过期的告警（过期告警＝撒谎的另一种形态）。
	aggDegradeNotice.value = ''
	// B-12：本次 run 有「时间未知 ⇒ 按记录日归卡」的 fallback 时，聚合结果行要**带上这个事实**
	// （只在有 fallback 时多打一行，不新造日志行、不影响既有 [yishu] 端侧聚合行）。
	if (runFallbackN > 0) {
		// 累计值经**公开访问器**读出而非直接插值模块私有变量（同 degradeRuns / getDegradeRuns 的
		// 口径：audit exports 轴会把"导出了但零调用"判成能力没接线，取数落在日志行上即为真实读面）。
		console.warn('[yishu-agg] 本次聚合含拍摄时间未知照片 ' + runFallbackN
			+ ' 张 ⇒ 已按**记录日**归卡（fallback）；累计 ' + getTimeFallbackN() + ' 次')
	}
	runFallbackN = 0
	// ⚠️ 降级分支（可观测性是硬要求，**不许静默**）：跳过端侧聚类 = **本次不出 L1**，
	// 而云侧没有 L1 生产者（见 AGG_CLIENT_MAX_N 注释）⇒ 当天时间轴要等客户端重跑/后续策略。
	// 故这里必须 WARN + 计数，并把**后果**写进日志文案。
	if (pts.length > AGG_CLIENT_MAX_N) {
		degradeRuns++
		// B-17：把"本次跳过"这件事**暴露给 UI**（不只是日志/计数）。响应式赋值 ⇒
		// 宿主那一行提示当拍出现，不需要用户杀进程重进。
		aggDegradeNotice.value = AGG_DEGRADE_NOTICE
		// 2026-10-16（audit exports 轴）：累计值改为经**公开访问器** getDegradeRuns() 读出——
		// 此前只插值模块私有的 degradeRuns，导出函数零调用被门禁判成"能力写了没接线"。
		// 取值口径不变（同一变量），只是把唯一读面落在既有 [yishu-agg] 告警行上（不新造日志行）。
		console.warn('[yishu-agg] 端侧聚类降级 n=' + pts.length + ' > ' + AGG_CLIENT_MAX_N
			+ '（量级估计阈值；实测单用户单日最多 81 条 ⇒ 5× 余量，几乎不触发）'
			+ ' ⇒ **本次不出 L1，时间轴需等后续聚合**（当前云侧只产 L2/L3，无 L1 生产者）'
			+ '；累计降级 ' + getDegradeRuns() + ' 次')
		return new AggRunResult([], 0)
	}
	const clusters = stDbscan(pts, l0EpsTsec(), L0_EPS_S_M, L0_MIN_PTS)
	const clustered: Set<string> = new Set<string>()
	for (let i = 0; i < clusters.length; i++) {
		const cl = clusters[i]
		for (let j = 0; j < cl.length; j++) {
			clustered.add(cl[j].id)
		}
	}
	const noise: Photo[] = []
	for (let i = 0; i < pts.length; i++) {
		if (!clustered.has(pts[i].id)) {
			noise.push(pts[i])
		}
	}
	const days = l1DailyAggregate(clusters, noise, tzOffsetMin)
	const events = buildEventsFromDays(days)
	console.log('[yishu] 端侧聚合: ' + pts.length + ' 点 → ' + clusters.length + ' 簇 → ' + events.length + ' 个 L1 事件')
	return new AggRunResult(events, clusters.length)
}

/**
 * 端侧聚合（**同步**入口）：小批量调用走它（`RecordSheet` 用户自选最多 9 张）。
 * 相册监听那种可能上百张的批量请走 `aggregateToEventsChunked`（分片，不独占主线程）。
 * @param uploads 上传成功结果（本地元数据 + content_id）
 * @param tzOffsetMin 设备本地时区偏移（分钟；日界按本地自然日）
 */
export function aggregateToEvents(uploads: Array<UploadedPhoto>, tzOffsetMin: number): AggRunResult {
	return finishAgg(preprocess(buildRaws(uploads)), tzOffsetMin)
}

// ─────────────────────────────────────────────────────────────────────────────
// 分片版（2026-10-16 · 批次 6 · RC-7「分片」）
//
// 为什么需要：上传完成回调里一次可能来上百张；组装 + 预处理 + 聚类 + 日聚合整段同步跑，
// 在无 worker 的 UTS 上就是一次性独占主线程。处置：**组装阶段按 AGG_CHUNK_N 切片，片间
// `setTimeout(0)` 让出主线程**（时间切片，让宿主有机会处理输入/绘制），使单次占用有界；
// 聚类本体因上面的逐位等价约束**整体跑**，规模由 AGG_CLIENT_MAX_N 界住。
//
// 埋点**复用**（不新造）：`st_dbscan` 内既有 `[yishu-agg] stDbscan n=… 判定=… 耗时=…` 行，
// 以及 `perf_timing.uts` 的「授权→首批日卡片渲染」（recordGrantTime → recordFirstDayRender
// 恰好夹住本段：startWatch 记前者、applyFetchedEvents 记后者）。
//
// ⚠️ 写法约束（沿 st_dbscan 的血泪）：**不在函数内定义函数**（内层函数声明曾把 UTS 编译器
//    卡死 300s+）⇒ 分片状态挂模块级变量，步进函数 `chunkStep` 也是模块级的。
// ─────────────────────────────────────────────────────────────────────────────
let chunkUploads: Array<UploadedPhoto> = []
let chunkRaws: Array<RawPhoto> = []
let chunkIdx: number = 0
let chunkTz: number = 0
let chunkCb: ((r: AggRunResult) => void) | null = null

/** 组装一片 → 未完则 `setTimeout(0)` 续下一片（让出主线程）；完则跑下游并回调 */
function chunkStep(): void {
	const n = chunkUploads.length
	const end = chunkIdx + AGG_CHUNK_N < n ? chunkIdx + AGG_CHUNK_N : n
	for (let i = chunkIdx; i < end; i++) {
		const u = chunkUploads[i]
		// B-12：与 buildRaws **同一出口**（aggTsOf）——分片路径与同步路径必须同判，否则
		// 「同一张时间未知的照片」在两条入口下落进不同日卡（端侧两条上传链都会走到这里）。
		chunkRaws.push(new RawPhoto(u.contentId, aggTsOf(u), u.item.lat, u.item.lng, [], photoHashOf(u)))
	}
	chunkIdx = end
	if (chunkIdx < n) {
		setTimeout((): void => { chunkStep() }, 0)
		return
	}
	const cb = chunkCb
	const tz = chunkTz
	const raws = chunkRaws
	// 先清状态再回调（回调里可能再次触发上传完成 → 重入本模块）
	chunkCb = null
	chunkUploads = []
	chunkRaws = []
	chunkIdx = 0
	if (cb != null) {
		cb(finishAgg(preprocess(raws), tz))
	}
}

/**
 * 端侧聚合（**分片**入口）：上传完成回调请用此入口。
 *
 * @param onDone 结果回调（异步；空输入也会回调，结果为 0 事件）
 */
export function aggregateToEventsChunked(
	uploads: Array<UploadedPhoto>,
	tzOffsetMin: number,
	onDone: (r: AggRunResult) => void
): void {
	if (uploads.length == 0) {
		onDone(new AggRunResult([], 0))
		return
	}
	chunkUploads = uploads
	chunkRaws = []
	chunkIdx = 0
	chunkTz = tzOffsetMin
	chunkCb = onDone
	chunkStep()
}

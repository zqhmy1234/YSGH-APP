/**
 * AI 对话域薄封装（AG6 · 对齐 backend/app/api/chat.py —— AG5 已实现且**真代理 E2E 跑通**）
 *
 * 后端契约（实证：docs/openapi.json 全路径对齐；scripts/e2e_agent_chat.ps1 真 E2E
 * 实测端到端 56.3s，chat_messages 落库 2 行、Agent 工具写入本仓 memories 1 行）：
 *   POST /api/v1/chat/messages/stream  {conversation_id?, content, attachments?[]}
 *        → **text/event-stream**：status / preview / tool / replace / done / error
 *   POST /api/v1/chat/messages（非流式）→ data{ conversation_id, reply{…}, latency_ms }
 *        —— 客户端已不再走它（保留给脚本与降级路径；单测在 backend/tests/test_chat.py）
 *   GET  /api/v1/chat/replies/{reply_id} → data{ reply 同构 }
 *   GET  /api/v1/chat/conversations/{id}/messages
 *        → data{ conversation_id, messages[]{ id, role, kind, text, created_at } }（历史含 user 行）
 *
 * 形态映射（**必须**，否则 TabAi 渲染走错分支）：
 *   · 后端 reply.kind 只有 bubble | plain（客户端 AiMsg.kind 同名 ⇒ 直接可用）；plain 需 `bullets`
 *     ⇒ 按「首行作标题、其余非空行作要点」切分（正是 V3 SOP 确认块的形态）。
 *   · 后端 kind=cards/confirm/typing **当前不会产生**（需 agent 侧结构化输出）⇒ 本模块**不臆造**：
 *     契约里预留 ≠ 现在能回，写死假 cards 就是把演示数据又塞回真链路。
 *
 * ── 流式通道（AG6 余项 · 2026-10-09）──
 * `sendChatMessage` 走 SSE：`uni.request({enableChunked:true})` + `onChunkReceived`（5.24 编译实测
 * 通过；二者未收录进 5.24 dts，结论落 docs/lessons.md）。预览走**模块级 ref**（同 audio_player.uts
 * 先例，不传回调——UTS 导出函数带函数类型参数零先例）。**兜底**：桥接吞 chunk 时 `success` 里再解析
 * 整段响应体（拿不到 done 帧就如实返回 null，绝不把预览当终稿）。
 * 约定同 utils/api.uts：resolve-only；失败 resolve(null) 且**已 showErrorToast** ⇒ 调用方不重复 toast；
 * 401 单飞刷新重放一次（本通道绕开 doRequest，故显式对齐）。
 */
import { ref } from 'vue'
import { get, dataObj, buildHeader, showErrorToast, ApiError, parseEnvelopeString } from './api'
import { refreshToken, clearToken } from './auth'
import { getBaseUrl } from './config'
import { addBreadcrumb, captureException } from './sentry'
import { PATH_CHAT_MESSAGES_STREAM, PATH_CHAT_CONVERSATION_MESSAGES } from './contract'

/** 记忆卡片（agent 侧 `save_memory` 结构化投影；img 为空串=文字记忆无缩略图） */
export class ChatCard {
	title: string
	meta: string
	img: string
	topics: Array<string>
	constructor(title: string, meta: string, img: string, topics: Array<string>) {
		this.title = title
		this.meta = meta
		this.img = img
		this.topics = topics
	}
}

/** 一条智能体回复（客户端可用子集） */
export class ChatReply {
	id: string
	kind: string
	text: string
	bullets: Array<string>
	chips: Array<string>
	cards: Array<ChatCard>
	constructor(id: string, kind: string, text: string, bullets: Array<string>, chips: Array<string>, cards: Array<ChatCard>) {
		this.id = id
		this.kind = kind
		this.text = text
		this.bullets = bullets
		this.chips = chips
		this.cards = cards
	}
}

/** 发送结果：**必须回传 conversationId**——多轮上下文靠它（丢了就每轮失忆） */
export class ChatSendResult {
	conversationId: string
	reply: ChatReply
	constructor(conversationId: string, reply: ChatReply) {
		this.conversationId = conversationId
		this.reply = reply
	}
}

/** 把整段纯文本切成非空行数组（plain 形态的 title/bullets 由此得来） */
export function splitLines(text: string): Array<string> {
	const out: Array<string> = []
	const lines = text.split('\n')
	for (let i = 0; i < lines.length; i++) {
		const s = lines[i].trim()
		if (s != '') {
			out.push(s)
		}
	}
	return out
}

/** 解析字符串数组字段（元素非字符串一律丢弃——UTS 强转 null/数字会崩或污染渲染） */
function parseStringArray(arr: Array<any> | null): Array<string> {
	const out: Array<string> = []
	if (arr == null) {
		return out
	}
	for (let i = 0; i < arr.length; i++) {
		const v = arr[i]
		if (typeof v == 'string') {
			out.push(v as string)
		}
	}
	return out
}

/** 解析 cards 字段（元素是对象；缺 title/meta/img 一律回退空串，绝不强转 null） */
function parseCards(arr: Array<any> | null): Array<ChatCard> {
	const out: Array<ChatCard> = []
	if (arr == null) {
		return out
	}
	for (let i = 0; i < arr.length; i++) {
		const v = arr[i]
		if (v instanceof UTSJSONObject) {
			out.push(new ChatCard(
				v.getString('title') ?? '',
				v.getString('meta') ?? '',
				v.getString('img') ?? '',
				parseStringArray(v.getArray('topics'))
			))
		}
	}
	return out
}

/** 解析 reply 对象 → ChatReply；字段缺失不崩（防御：后端升级/降级期字段可能缺） */
function parseReply(obj: UTSJSONObject | null): ChatReply | null {
	if (obj == null) {
		return null
	}
	const text = obj.getString('text') ?? ''
	const kind = obj.getString('kind') ?? 'bubble'
	// plain：首行作标题，其余行作要点；单行/非 plain 时 bullets 为空（页面另有渲染分支）
	const lines = splitLines(text)
	const bullets: Array<string> = []
	if (kind == 'plain' && lines.length > 1) {
		for (let i = 1; i < lines.length; i++) {
			bullets.push(lines[i])
		}
	}
	// 2026-10-30（P2 D-5）：非 plain 回复的正文原被截成**首行**（title=lines[0]），其余行直接丢 ——
	// 而 bullets 只在 kind=='plain' 时才有渲染点 ⇒ 卡片/气泡类回复在多行正文下只显示"半句话"。
	// 现：plain 维持「首行=标题、其余=要点」；其他 kind 的正文保留**全文**。
	const title = kind == 'plain' ? (lines.length > 0 ? lines[0] : text) : text
	return new ChatReply(
		obj.getString('id') ?? '',
		kind,
		title,
		bullets,
		parseStringArray(obj.getArray('chips')),
		parseCards(obj.getArray('cards'))
	)
}

// ═══════════ 流式通道（AG6 余项 · 2026-10-09）═══════════

/** 流式预览文本（**累计全文**，不是增量）；TabAi 的 typing 气泡直接读它渲染"逐字" */
export let chatStreamText = ref('')
/** 是否有一轮流式正在进行（TabAi 据此决定 typing 气泡的去留） */
export let chatStreamActive = ref(false)

// 2026-10-30（P1-24）：在途请求句柄 + 主动取消标记。原 task 是函数局部变量、不外露 ⇒ 页面销毁/
// 切走后**无法中断**：连接还在收帧写共享 chatStreamText，而 chatStreamActive 只有 finish 才复位
// ⇒ 重进页面后每次发送都弹「正在生成回复，稍等一下」（永久卡死）。
let _activeTask: RequestTask | null = null
let _cancelRequested: boolean = false

/** 中断当前流式请求（页面卸载 / 切离对话 tab 时调用）。已结束则无副作用。 */
export function cancelChatStream(): void {
	_cancelRequested = true
	if (_activeTask != null) {
		_activeTask.abort()
		_activeTask = null
	}
	chatStreamActive.value = false
	chatStreamText.value = ''
	chatStreamTool.value = ''
}
/** 工具状态文案（后端 `tool` 帧的 name；空串 = 没有工具在跑） */
export let chatStreamTool = ref('')

// ═══════════ 流式文本合并（2026-10-14 · 台账 §4.20 批次 5 · RC-8）═══════════
// 为什么：预览帧每 token/chunk 一帧（每秒可达数十帧），原实现每帧直接写 `chatStreamText`
// ⇒ 每帧一次 TabAi 重渲染，而打字机气泡处在 `v-for` 消息列表内 ⇒ **整列表跟着重渲染**
// （长会话下"打字时卡顿、输入滞涩"）。做法：**合帧落定**——新文本先落非响应式变量，最多每
// 80ms 落一次 ref（12.5Hz 对"逐字"观感足够），重渲染次数降到 1/N（N ≈ 帧率/12.5）。
// 安全边界（必须成对，否则"回复闪回"）：每轮**开始**（sendChatMessage）与**结束**（promise
// settle）都要 `cancelStreamTextFlush()`，否则调用方清空 ref 后残留定时器会把上一轮尾句写回去；
// `replace` 帧（校验重试的整段替换）与 `preview` 同走这一入口，天然覆盖。
let pendingStreamText = ''
let streamFlushTimer = 0

function stageStreamText(t: string): void {
	pendingStreamText = t
	if (streamFlushTimer != 0) {
		return // 本窗口已排队，由它统一落定
	}
	streamFlushTimer = setTimeout((): void => {
		streamFlushTimer = 0
		chatStreamText.value = pendingStreamText
	}, 80)
}

function cancelStreamTextFlush(): void {
	if (streamFlushTimer != 0) {
		clearTimeout(streamFlushTimer)
		streamFlushTimer = 0
	}
	pendingStreamText = ''
}

/** 流式总超时（与旧非流式通道同口径 90s；后端 agent 上限 180s，须留出让后端如实 504 的余量） */
const STREAM_TIMEOUT_MS: number = 90000

/**
 * 会话 id 的本地存储键（**单一来源**：TabAi 也 import 本常量）。
 * 2026-10-11 审查 A3：陈旧会话 id 的自愈在本文件内（streamChatOnce 的 404 分支），键须与写入方同源。
 */
export const CHAT_CONV_STORAGE_KEY = 'yishu_chat_conversation_id'

/** UTF-8 解码结果：text = 解出的文本；usedBytes = 消耗的字节数（其后是不完整的尾部） */
class Utf8Decoded {
	text: string
	usedBytes: number
	constructor(text: string, usedBytes: number) {
		this.text = text
		this.usedBytes = usedBytes
	}
}

/**
 * 2026-10-30（P1-22）：解析**非 200** 响应体。
 *
 * 本通道 `responseType: 'arraybuffer'` ⇒ 失败时 `res.data` 是 ArrayBuffer 而**不是** JSON 对象。
 * 原实现两处都用 `res.data instanceof UTSJSONObject` 判断，恒 false ⇒ 后端 `code`/`message`
 * 全丢（自愈分支与错误文案双双失效）。这里统一三种形态：对象 / ArrayBuffer / 字符串。
 */
function parseChatErrBody(data: any): UTSJSONObject | null {
	if (data == null) {
		return null
	}
	if (data instanceof UTSJSONObject) {
		return data as UTSJSONObject
	}
	if (data instanceof ArrayBuffer) {
		const dec = decodeUtf8(new Uint8Array(data as ArrayBuffer))
		return parseEnvelopeString(dec.text)
	}
	if (typeof data == 'string') {
		return parseEnvelopeString(data as string)
	}
	return null
}

/**
 * 整块字节是否为 UTF-8 的**合法前缀**（末尾可能被截断）：RFC 3629 逐序列校验，
 * 且 E0/ED/F0/F4 的首续字节另有区间（排除 overlong 与 UTF-16 代理区）。
 * 2026-10-31（P2 D-2）：兜底分支靠它区分「还没收完、等下一片」与「真损坏」。
 */
function isTruncatedUtf8(bytes: Uint8Array): boolean {
	let i = 0
	while (i < bytes.length) {
		const b = bytes[i]
		if (b < 0x80) {
			i = i + 1
			continue
		}
		// 续字节个数由 lead 决定；0x80-0xC1（游离续字节/overlong）与 0xF5+ 一律判损坏
		const need = b < 0xc2 ? -1 : b < 0xe0 ? 1 : b < 0xf0 ? 2 : b < 0xf5 ? 3 : -1
		if (need < 0) {
			return false
		}
		const lo = b == 0xe0 ? 0xa0 : b == 0xf0 ? 0x90 : 0x80
		const hi = b == 0xed ? 0x9f : b == 0xf4 ? 0x8f : 0xbf
		for (let g = 0; g < need; g++) {
			const idx = i + 1 + g
			if (idx >= bytes.length) {
				return true // 末尾还没收完：合法截断
			}
			const c = bytes[idx]
			if (c < (g == 0 ? lo : 0x80) || c > (g == 0 ? hi : 0xbf)) {
				return false // 续字节越界 ⇒ 真损坏，不能干等
			}
		}
		i = i + 1 + need
	}
	return false
}

/**
 * 字节数组 → UTF-8 文本（**不依赖 TextDecoder**：uni-app x 未提供该全局对象，已核对 5.24 dts）。
 *
 * 做法：逐字节拼 `%XX` 再交 `decodeURIComponent`（既有用例：shell.uvue 解 url query）。
 * ⚠️ 流式下汉字 3 字节可能被切在两个 chunk 之间 ⇒ 整串解码抛 URIError。故从尾部最多回退 4 字节
 * 重试，把回退掉的字节数交给调用方（`usedBytes`），下一片到达时补全 —— 这也是每次都把**累积字节
 * 整体**解码、而非"逐块解码再拼"的原因（后者必产乱码，只在中文长回复的特定切分下暴露）。
 */
function decodeUtf8(bytes: Uint8Array): Utf8Decoded {
	let end = bytes.length
	const floor = end > 4 ? end - 4 : 0
	while (end > floor) {
		try {
			let pct = ''
			for (let i = 0; i < end; i++) {
				const b = bytes[i]
				pct += '%' + (b < 16 ? '0' : '') + b.toString(16)
			}
			return new Utf8Decoded(decodeURIComponent(pct), end)
		} catch (e) {
			end = end - 1
		}
	}
	// 兜底：连「回退 4 字节」都解不开，必须区分 (a) 整块就是一个**没收完的字符** / (b) 真损坏。
	// 2026-10-31（P2 D-2）：原实现一律按 (b) 丢 1 字节 —— 对 (a) 是灾难点：首片落在字符中间时
	// pending 从续字节开始，之后每片都解不开、每片再丢 1 字节 ⇒ 不止少一个字，而是**整条回复全丢**
	// （SSE 帧永远拼不出两个换行）。故 (a) 一字节都不消费，等下一片；(b) 仍丢 1 字节推进（可终止）。
	if (isTruncatedUtf8(bytes)) {
		return new Utf8Decoded('', 0)
	}
	return new Utf8Decoded('', bytes.length > 0 ? 1 : 0)
}

/** 一条 SSE 帧（event + 单行 data） */
class SseFrame {
	event: string
	data: string
	constructor(event: string, data: string) {
		this.event = event
		this.data = data
	}
}

/**
 * 解析一条 SSE 帧文本（`event: x` + `data: {...}` 两行）。
 * 注释帧（`: ping`）在调用方已按"没有 event/data"跳过；未知事件**忽略**（协议向前兼容）。
 */
function parseSseFrame(raw: string): SseFrame {
	let event = ''
	let data = ''
	const lines = raw.split('\n')
	for (let i = 0; i < lines.length; i++) {
		const line = lines[i].trim()
		if (line.startsWith('event:')) {
			event = line.substring(6).trim()
		} else if (line.startsWith('data:')) {
			data = line.substring(5).trim()
		}
	}
	return new SseFrame(event, data)
}

/**
 * 发一条消息并**流式**取回复：POST /api/v1/chat/messages/stream。
 *
 * 失败 resolve(null)（**不伪造回复**——调用方据此撤掉 typing 占位即可，绝不补一句假 AI 文本）。
 * 预览期间把累计全文写进 `chatStreamText`（TabAi 绑它渲染），终稿由本函数返回值给出。
 * ⚠️ 同一时刻只允许一轮（并发调用会串写共享 ref），调用方（TabAi）在 `chatStreamActive` 为真时不再发起。
 */
export function sendChatMessage(conversationId: string, content: string): Promise<ChatSendResult | null> {
	// B13 面包屑：只记"新建/续会话"与文本长度，**不记用户对 AI 说了什么**（隐私纪律同 search_api）
	addBreadcrumb('chat', (conversationId == '' ? 'stream new conversation' : 'stream existing conversation') + ' len=' + content.length)
	// 2026-10-14（RC-8）：先取消上一轮**可能残留**的合帧定时器——否则它会把这轮开头的内容
	// 或上一轮的尾句写到清空之后（"回复闪回"）。
	cancelStreamTextFlush()
	chatStreamText.value = ''
	chatStreamTool.value = ''
	chatStreamActive.value = true
	return streamChatOnce(conversationId, content, false, false).then((r: ChatSendResult | null) => {
		// 本轮结束（成功/失败/超时都走这里）：同样取消待落定的窗口。
		// 终稿由返回值 `r` 承载（TabAi 据此上屏并清空 `chatStreamText`），故此处**无需**补落——
		// 若强行落定，反而会在"调用方已清空"之后写入旧文本。
		cancelStreamTextFlush()
		return r
	})
}

function streamChatOnce(conversationId: string, content: string, retried: boolean, newConvTried: boolean): Promise<ChatSendResult | null> {
	const body: UTSJSONObject = { content: content }
	if (conversationId != '') {
		// 空串不发：后端对"显式传入但不存在"的会话返回 404（IDOR 防护），
		// 而""不是合法 UUID ⇒ 会被判 404，故新建会话时必须**省略**该字段
		body.set('conversation_id', conversationId)
	}
	return new Promise<ChatSendResult | null>((resolve) => {
		// 2026-10-30（P1-24）：新一轮请求开始 ⇒ 复位取消标记（上一轮的取消不得影响本轮）
		_cancelRequested = false
		let settled = false
		let consumed = 0 // 已消费到 `decoded` 的哪个字符位置（帧可能跨 chunk，按位置推进才不重不漏）
		let decoded = ''
		let chunkSeen = false
		let pending = new Uint8Array(0) // 未成完整字符的尾部字节（≤3）
		// 打点：release 包里 console 不可见，故这些只在 HBuilderX 真机运行时看得到
		// （首字延迟是流式唯一的硬指标，没它就只能靠截图肉眼看，拿不出证据）
		const t0 = Date.now()
		let firstPreviewLogged = false
		let frameCount = 0
		let chunkCount = 0
		// 2026-10-30（P2 D-1）：`success` 之后的「静默期」计时器（收到新分片就重排），
		// 声明在 finish 之前 —— finish 要能清掉它（Kotlin 侧局部变量必须先用后声明不了）。
		let httpDone = false
		let graceTimer = 0

		const finish = (result: ChatSendResult | null, abortConn: boolean): void => {
			if (settled) {
				return
			}
			settled = true
			if (graceTimer != 0) {
				clearTimeout(graceTimer)
				graceTimer = 0
			}
			// 🚨 2026-10-11 静态审查 A1 修复（**本批引入的回归**）：这里必须是「**取消**看门狗」，
			// 而初版写法是 `resetWatchdog()` —— 那是「先 clear 再**新建**一个 90s 定时器」，
			// 于是**每次成功回复结束后约 90s，都会凭空弹出一次「AI 回复超时，请稍后重试」**
			// （用户已拿到回复，却收到超时提示；真机必现，静置 90s 即可复现）。
			// 对照：api.uts 的同类 finish 用的是 clearTimeout —— 本文件是当时唯一的孤例。
			if (watchdog >= 0) {
				clearTimeout(watchdog)
				watchdog = -1
			}
			chatStreamActive.value = false
			chatStreamTool.value = ''
			// 2026-10-30（P1-24）：本次请求已结束，撤销在途句柄登记
			if (_activeTask == task) {
				_activeTask = null
			}
			resolve(result)
			// 2026-10-11：判失败时主动断开连接——原实现看门狗超时后请求仍挂在后台继续
			// 收数据（连接白占、数据白收）。A-1 修复后 backend 断连也会跑完落库，客户端
			// 侧更没有理由继续挂着。fail 回调以 settled 挡掉 abort 引发的二次 toast。
			if (abortConn) {
				try {
					task.abort()
				} catch (e) {
					// 连接可能已自然结束：abort 抛错无害，忽略
				}
			}
		}
		// ⚠️ 2026-10-11 B-3：看门狗是「**idle 时长**」而非总时长——原 90s 总超时 < agent 单轮
		// 实测 56~76s + 校验重试可破 90s（backend 上限 180s），正常长回复必被错杀（余量是负的）。
		// 改：每收到一帧就续命，连续 90s 无帧才判超时，总时长上限交还 backend 的 180s。
		// 前提是**真的有保活帧**（B3 实锤：": ping" 在 backend `_iter_sse` 被按 `:` 丢弃，从未
		// 到客户端；当时 backend 也不发心跳）⇒ backend 已在 `_frames` 补 5s 保活（`_KEEPALIVE_INTERVAL_S`）。
		// 二者配套：改一侧必须对侧同改。
		let watchdog = -1
		const resetWatchdog = (): void => {
			if (watchdog >= 0) {
				clearTimeout(watchdog)
			}
			watchdog = setTimeout(() => {
				console.log('[dbg-chat] stream watchdog timeout (idle ' + STREAM_TIMEOUT_MS + 'ms)')
				showErrorToast(new ApiError('TIMEOUT', 'AI 回复超时，请稍后重试'))
				finish(null, true)
			}, STREAM_TIMEOUT_MS)
		}
		resetWatchdog()

		// 2026-10-30（P2 D-1）：「success 之后还有没有数据在来」用**静默期**判定，而不是固定时刻。
		// 每收到新分片就重排（见 appendBytes 末尾），真的连续 1.2s 无任何字节才判失败。
		const scheduleGrace = (): void => {
			if (graceTimer != 0) {
				clearTimeout(graceTimer)
			}
			graceTimer = setTimeout((): void => {
				graceTimer = 0
				if (!settled) {
					// 全链路唯一静默失败分支：HTTP 200、已渲染若干预览、但流里始终没有 done 帧
					// （后端中途挂/中间层截断）。必须显式提示，否则用户看到"字打了一半消失"。
					showErrorToast(new ApiError('CHAT_001', 'AI 回复未完成，请重试', 0))
				}
				finish(null, false)
			}, 1200)
		}

		const handleFrame = (raw: string): void => {
			// 2026-10-11：单帧解析失败（半截 JSON/异常数据）只丢这一帧，**绝不让异常冒出
			// onChunkReceived 回调**——否则当前 chunk 里排在后面的帧全部陪葬，表现为
			// "回复偶尔缺一段"这种最难复现的丢帧。帧到达同时喂看门狗（B-3 idle 续命）。
			try {
				resetWatchdog()
				const f = parseSseFrame(raw)
				frameCount = frameCount + 1
				if (f.event == 'preview' || f.event == 'replace') {
					if (!firstPreviewLogged) {
						firstPreviewLogged = true
						console.log('[dbg-chat] first preview at ' + (Date.now() - t0) + 'ms (chunks=' + chunkCount + ')')
					}
					// replace = 校验重试后的整段替换（预览作废）；两者都是"**当前应显示的全文**"
					// 2026-10-14（RC-8）：改走**合帧落定**（80ms 窗口），不再每帧直接写 ref。
					const obj = JSON.parse(f.data) as UTSJSONObject
					stageStreamText(obj.getString('text') ?? '')
					return
				}
				if (f.event == 'tool') {
					const obj = JSON.parse(f.data) as UTSJSONObject
					// 2026-10-11 静态审查 C1：工具**结束**（phase=done）必须清空工具文案——
					// 否则"工具已跑完、正文还没到"的窗口里，typing 气泡继续显示
					// 「正在翻你的记忆…」（残留文案），用户以为工具卡住了。
					chatStreamTool.value = obj.getString('phase') == 'done' ? '' : (obj.getString('name') ?? '')
					return
				}
				if (f.event == 'done') {
					const obj = JSON.parse(f.data) as UTSJSONObject
					const reply = parseReply(obj.getJSON('reply'))
					if (reply == null) {
						// 2026-10-11 静态审查 C2：终稿帧到了但解析不出回复 ⇒ 必须提示。
						// 静默 finish(null) 会让用户看到"字打完了却什么都没有"，比报错更费解。
						showErrorToast(new ApiError('CHAT_001', 'AI 回复未完成，请重试', 0))
						finish(null, false)
						return
					}
					console.log('[dbg-chat] done at ' + (Date.now() - t0) + 'ms (frames=' + frameCount + ', chunks=' + chunkCount + ')')
					finish(new ChatSendResult(obj.getString('conversation_id') ?? '', reply), false)
					return
				}
				if (f.event == 'error') {
					// 后端在流内报错（HTTP 头已发出，改不了状态码）：CHAT_001/002/004
					const obj = JSON.parse(f.data) as UTSJSONObject
					showErrorToast(new ApiError(
						obj.getString('code') ?? 'UNKNOWN',
						obj.getString('message') ?? 'AI 回复失败，请稍后重试',
						0
					))
					finish(null, true)
				}
				// status/ping 等其余事件：忽略（但已喂过看门狗）
			} catch (e) {
				console.log('[dbg-chat] frame parse failed: ' + raw.substring(0, 120))
			}
		}

		const consumeFrames = (): void => {
			while (!settled) {
				const idx = decoded.indexOf('\n\n', consumed)
				if (idx < 0) {
					break // 还有半帧没到齐：等下一个 chunk
				}
				const raw = decoded.substring(consumed, idx)
				consumed = idx + 2
				handleFrame(raw)
			}
			// 2026-10-30（P2 D-3）：`decoded` 原**只增不减** ⇒ 每个 chunk 都在变长字符串上 indexOf/substring，
			// 累计 O(n²) 且已消费前缀永不释放。这里在帧边界（安全点）丢掉它，只留半帧尾巴。
			if (consumed > 0) {
				decoded = decoded.substring(consumed)
				consumed = 0
			}
		}

		const appendBytes = (bytes: Uint8Array): void => {
			const total = pending.length + bytes.length
			const merged = new Uint8Array(total)
			for (let i = 0; i < pending.length; i++) {
				merged[i] = pending[i]
			}
			for (let i = 0; i < bytes.length; i++) {
				merged[pending.length + i] = bytes[i]
			}
			const dec = decodeUtf8(merged)
			pending = merged.slice(dec.usedBytes)
			decoded += dec.text
			consumeFrames()
			// 2026-10-30（P2 D-1）：HTTP 200 已返回但还在收数据 ⇒ 重排静默期，别把在途终稿判死
			if (httpDone && !settled) {
				scheduleGrace()
			}
		}

		const task = uni.request({
			url: getBaseUrl() + PATH_CHAT_MESSAGES_STREAM,
			method: 'POST',
			data: body,
			header: buildHeader(),
			responseType: 'arraybuffer',
			enableChunked: true,
			success: (res: any) => {
				const status = typeof res.statusCode == 'number' ? (res.statusCode as number) : 0
				// 2026-10-30（P1-22）：非 200 时 `res.data` 是 ArrayBuffer 而非对象，原用
				// `instanceof UTSJSONObject` 判断**恒 false** ⇒ ① `code404` 恒空，CHAT_003 陈旧会话
				// 自愈是**死代码**（"换账号后每条都 404、只能清 App 数据"的砖一直在）；② 错误码/文案
				// 全丢，只剩 "HTTP_xxx"。现统一走 errBody（ArrayBuffer → UTF-8 解码 → 信封解析）。
				const errBody = parseChatErrBody(res.data)
				// 🚨 2026-10-11 静态审查 A3 修复：陈旧会话 id 的**自愈**。
				// 背景：会话 id 是**设备级**存储（不随用户切换清理），而后端对未知/他人会话
				// 一律 404 CHAT_003（IDOR 防护）。换账号 / 后端库重置后，本地这条 id 必然失效，
				// 而原实现只 toast 不重置 ⇒ **此后每一条消息都 404**（永久砖，只能清 App 数据）。
				// 自愈：仅对 CHAT_003 ⇒ 清掉本地会话 id + 以**新会话**重发一次（仅一次，防循环）。
				// 其他 404（如路径错误）不自愈，避免掩盖真问题。
				if (status == 404 && !newConvTried) {
					const code404 = errBody != null ? (errBody.getString('code') ?? '') : ''
					if (code404 == 'CHAT_003') {
						console.log('[dbg-chat] stale conversation -> retry as new conversation')
						uni.removeStorageSync(CHAT_CONV_STORAGE_KEY)
						if (watchdog >= 0) {
							clearTimeout(watchdog)
							watchdog = -1
						}
						streamChatOnce('', content, retried, true).then((r: ChatSendResult | null) => {
							finish(r, false)
						})
						return
					}
				}
				if (status == 401 && !retried) {
					// 401 单飞刷新重放一次（语义与 api.uts.doRequest 一致；本通道绕开了它，故在此复刻）。
					// 🚨 2026-10-11 审查 B2：外层看门狗必须**彻底停掉（交接给内层）**——重放的帧
					// 只喂内层看门狗，只 resetWatchdog() 续命一次的话外层 90s 到点仍会误杀，
					// 且 abort 打在已结束的外层 task 上 ⇒ 回复被判失败而后端继续落库（历史多出用户没见过的回复）。
					if (watchdog >= 0) {
						clearTimeout(watchdog)
						watchdog = -1
					}
					refreshToken().then((ok: boolean) => {
						if (ok) {
							streamChatOnce(conversationId, content, true, newConvTried).then((r: ChatSendResult | null) => {
								finish(r, false)
							})
						} else {
							clearToken()
							showErrorToast(new ApiError('AUTH_005', '登录已过期，请重新登录', 401))
							finish(null, false)
						}
					})
					return
				}
				if (status != 200) {
					// 非 200：响应体是**普通 JSON 错误信封**（不是 SSE）⇒ 同 api.uts 口径取 code/message
					let code = 'HTTP_' + status
					let msg = 'AI 回复失败（HTTP ' + status + '）'
					if (errBody != null) {
						code = errBody.getString('code') ?? code
						msg = errBody.getString('message') ?? msg
					}
					showErrorToast(new ApiError(code, msg, status))
					finish(null, false)
					return
				}
				if (!chunkSeen && res.data != null) {
					// **兜底**：蒸汽模式桥接可能吞掉 chunk 回调（api.uts:260 / auth.uts:66 两处自证同族坑）。
					// 此时整段响应体仍会到 success，解析它至少能拿到 done 帧——只是没有"逐字"效果。
					try {
						appendBytes(new Uint8Array(res.data as ArrayBuffer))
					} catch (e) {
						decoded += res.data as string
						consumeFrames()
					}
				}
				// 走到这里仍没 settled ⇒ 没有 done 帧：**如实失败**，绝不拿预览当终稿。
				// ⚠️ 但**不能立刻判失败**：部分平台的 chunk 回调可能排在 success 之后，
				// 立即收尾会把"已经在途的终稿帧"丢掉（表现为"文字渲染完了却没显示回复"的偶发丢帧）。
				// 2026-10-30（P2 D-1）：原实现固定 400ms 一次性判死且不随后续分片续命 ⇒ 未等到 done
				// 就弹「AI 回复未完成」并丢掉仍在途的终稿（后端已落库，用户看到失败）。现为「静默期」：
				// scheduleGrace 每收到新分片重排，连续 1.2s 无字节才判失败（与看门狗同为 idle 口径）。
				httpDone = true
				scheduleGrace()
			},
			fail: (_err: any) => {
				// 2026-10-11：finish(null, true) 的主动 abort 会走到这里（fail: request:fail abort）
				// ——已 settled（toast 已弹过）⇒ 直接吞掉，不二次报错。
				if (settled) {
					return
				}
				// 2026-10-30（P1-24）：用户主动取消（离页/切 tab）不算网络失败，
				// 不弹 toast、不上报 Sentry（否则每次切 tab 都产生一条假告警）。
				if (_cancelRequested) {
					_cancelRequested = false
					finish(null, false)
					return
				}
				captureException('network fail: chat stream @' + getBaseUrl(), 'api.network', null)
				showErrorToast(new ApiError('NETWORK', '网络异常，请检查连接', 0))
				finish(null, false)
			}
		})
		// 2026-10-30（P1-24）：登记在途 task，供 cancelChatStream() 中断
		_activeTask = task
		task.onChunkReceived((res: any) => {
			chunkSeen = true
			chunkCount = chunkCount + 1
			try {
				appendBytes(new Uint8Array(res.data as ArrayBuffer))
			} catch (e) {
				// 2026-10-11（P-5 防御）：enableChunked/onChunkReceived 不在 5.24 dts，
				// res.data 的运行时类型（ArrayBuffer?）未经验证——形态不符时丢这个 chunk
				// 并留痕，绝不让异常冒进 uni 回调栈（炸掉后续所有 chunk）。
				console.log('[dbg-chat] chunk decode failed: ' + e)
			}
		})
	})
}

// ⚠️ 这里**故意没有** `fetchChatReply`（GET /chat/replies/{id}）：POST 已内联返回完整回复 ⇒ 零调用，
// 而"零调用的能力导出"正是 `audit_harness.py` 轴 4 判 CRITICAL 的形态（图搜先例）。
// 真需要时（断线重取等）连同**调用点**一起加，别只加壳。

/** 历史消息项（后端 `ChatHistoryItemOut` 的客户端子集） */
export class ChatHistoryItem {
	id: string
	role: string
	kind: string
	text: string
	chips: Array<string>
	cards: Array<ChatCard>

	constructor(id: string, role: string, kind: string, text: string, chips: Array<string>, cards: Array<ChatCard>) {
		this.id = id
		this.role = role
		this.kind = kind
		this.text = text
		this.chips = chips
		this.cards = cards
	}
}

// ── 历史回填的三态信号（2026-10-30 · P2 D-10 / D-11）──────────────────────────
// 与 `play_messages.uts::messagesFetchFailed()` **同一范式**（模块级标记 + getter）：
// 本模块所有取数都是 resolve-only、失败给 null ⇒ 页面无法区分
// 「真的没有历史」与「这次没拉到」，两者都渲染成空态（D-10 的假空态）。
// ⚠️ `<script setup>` 顶层变量是"每实例"的，只有 `.uts` 模块作用域能跨页面实例存活。
let _historyFetchFailed: boolean = false

/** 最近一次 `fetchChatHistory` 是否**失败**（失败 ≠ 没有历史：页面据此给重试入口） */
export function chatHistoryFetchFailed(): boolean {
	return _historyFetchFailed
}

// 2026-10-30：`chatHistoryHasMore()` / `chatHistoryNextCursor()` 因**零消费方**（AI 页无上拉容器）
// 命中审计轴 4「零调用能力导出」⇒ 按「接线或删除」删掉 accessor 与私有状态。`fetchChatHistory`
// 的三形参保留（后端 `has_more/cursor` 已就位），等上拉容器就位时**连调用点一起加**。

/**
 * 取会话历史（时间正序）：`GET /api/v1/chat/conversations/{id}/messages`。
 *
 * 2026-09-25（功能修复波 · Agent 接线补完）：后端**早已实现**该端点并在 docstring 里要求
 * "客户端进入会话时回填"，但客户端**从未调用** —— 后果是重启后会话虽接续（conversationId
 * 已落盘）、界面却空白（用户以为历史丢了）。
 * 失败 `resolve(null)`：调用方保持空列表即可，**不伪造历史**（失败标记见 chatHistoryFetchFailed）。
 *
 * 2026-10-30（P2 D-11）分页：新增 `cursor` / `limit` 两个**可选**参数（不传 = 全量，
 * 与改造前逐字一致，老调用方 `fetchChatHistory(convId)` 行为不变）。
 *   · `limit > 0` → 只取**最近** limit 条（进入会话时的首屏，别再把几十轮前的历史一起拉）；
 *   · `cursor` 非空 → 取比该游标更早的一页（"加载更早"按钮）；
 *   · 返回的数组**恒为时间正序**（后端保证），页面拼接时把更早的一页插到最前面；
 *   · 是否还有更早、下一页游标从 `chatHistoryHasMore()` / `chatHistoryNextCursor()` 取。
 */
export function fetchChatHistory(
	conversationId: string,
	cursor: string = '',
	limit: number = 0
): Promise<Array<ChatHistoryItem> | null> {
	if (conversationId == '') {
		// 空会话 id = 不是"加载失败"，是一个确定的空结果 ⇒ 不清失败标记之外的状态
		_historyFetchFailed = false
		return new Promise<Array<ChatHistoryItem> | null>((resolve) => {
			resolve(null)
		})
	}
	let path = PATH_CHAT_CONVERSATION_MESSAGES.replace('{id}', conversationId)
	const params: Array<string> = []
	if (limit > 0) {
		params.push('limit=' + limit)
	}
	if (cursor != '') {
		// 游标是后端不透明串（含 `|` 与 `:`）⇒ 必须编码，否则被 URL 解析截断
		params.push('cursor=' + encodeURIComponent(cursor))
	}
	if (params.length > 0) {
		path = path + '?' + params.join('&')
	}
	// B13 面包屑口径同 sendChatMessage：只记"取历史"，不记内容
	addBreadcrumb('chat', 'fetch history' + (params.length > 0 ? ' paged' : ''))
	return new Promise<Array<ChatHistoryItem> | null>((resolve) => {
		get(path).then((body: UTSJSONObject | null) => {
			if (body == null) {
				_historyFetchFailed = true
				resolve(null)
				return
			}
			const d = dataObj(body)
			if (d == null) {
				_historyFetchFailed = true
				resolve(null)
				return
			}
			// 🚨 2026-10-11 静态审查 A2 修复：后端 `ChatHistoryOut` 把数组放在 **data.messages**，
			// 而初版读的 `dataArr(d)` 取的是 `data.data`（该键不存在）⇒ 恒得空数组：
			// **历史回填自 2026-09-25"接线补完"以来从未生效过**（用户重启 App 后会话永远空白，
			// 与 TabAi 注释声称的"已回填"完全相反）。
			// 后端实证：backend/app/schemas/chat.py（ChatHistoryOut.messages）、
			// backend/tests/test_chat.py 断言 hist.json()["data"]["messages"]。
			const arrAny = d.getArray('messages')
			const out: Array<ChatHistoryItem> = []
			if (arrAny != null) {
				// 显式转 UTSJSONObject（**不能留 any**：UTS 里在 `any` 上调方法是历史
				// FATAL 坑——"数组上调 UTSJSONObject 方法致 Promise 永不 resolve"同源）
				const arr = arrAny as Array<UTSJSONObject>
				for (let i = 0; i < arr.length; i++) {
					const o = arr[i]
					out.push(new ChatHistoryItem(
						o.getString('id') ?? '',
						o.getString('role') ?? '',
						o.getString('kind') ?? '',
						o.getString('text') ?? '',
						parseStringArray(o.getArray('chips')),
						parseCards(o.getArray('cards'))
					))
				}
			}
			// 2026-10-30（P2 D-10）：只保留失败标记（分页元信息暂不落私有状态，见上方删除说明）。
			_historyFetchFailed = false
			resolve(out)
		})
	})
}

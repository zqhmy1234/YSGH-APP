/**
 * 上传域 · 流量约束（网络类型 / 模式解析）（B5c 2026-09-24 重构波：自 utils/uploader.uts 按分节拆出）
 *
 * NetKind 枚举 / getNetKind 回调式探测 / resolveMode 模式解析。
 * 对外导出：NetKind, getNetKind, resolveMode
 */
import { UploadMode } from './uploader_types'

// ---------- 流量约束：网络类型判断 ----------

/** 网络类型：wifi（wifi/ethernet 无限流量视为 wifi）/ cellular / none / unknown */
export type NetKind = 'wifi' | 'cellular' | 'none' | 'unknown'

/** uni.getNetworkType 回调式封装（uni-app x）；ethernet 有线视为 wifi
 *
 * ⚠️ **必须传回调**——本函数返回 void，`if (getNetKind() == 'none')` 这类同步判断恒为假
 * （2026-10-11 静态审查实锤：B12 离线改口批在 4 处按同步签名调用过，见下方 currentNetKind 注释）。
 * 需要同步判断的场合请用 `currentNetKind()`。 */
export function getNetKind(cb: (kind: NetKind) => void): void {
	uni.getNetworkType({
		success: (res) => {
			const t = res.networkType
			if (t == 'wifi' || t == 'ethernet') {
				cb('wifi')
			} else if (t == 'none' || t == '') {
				cb('none')
			} else {
				cb('cellular') // 4g/5g/3g/2g/unknown 一律按蜂窝保守处理
			}
		},
		fail: () => {
			cb('unknown')
		}
	})
}

// ═══════════ 同步网络状态缓存（2026-10-11 静态审查新增）═══════════

/** 最近一次已知网络类型（同步可读）。由「模块加载时的首次探测」与「网络变化监听」共同维护。 */
let _lastNetKind: NetKind = 'unknown'
let _netWatchBound = false

/**
 * 同步读「最近已知」的网络类型。
 *
 * 为什么需要它（真实缺陷背景）：B12「离线不白丢用户操作」批在 4 处写了
 * `if (getNetKind() == 'none') { 改口为"已离线，联网后自动完成" }`——而 `getNetKind` 是
 * **回调式且返回 void**，`void == 'none'` 恒假 ⇒ 离线分支**永不进入**，用户看到的仍是
 * 「删除失败」而操作其实已入队（正是该批注释要避免的"状态与事实不符"）；
 * 同时按同步签名传参（不传 cb）在运行时是 undefined 回调，网络探测成功时调用即抛。
 *
 * ⚠️ 语义边界（重要）：本函数是**缓存值**，初始 `'unknown'`——模块加载时自动绑
 * `uni.onNetworkStatusChange` 并首次探测，此后随网络事件更新。
 * 因此：**只能判 `currentNetKind() == 'none'`（确定离线），不得用 `!= 'wifi'` 当离线**
 * （unknown 会被误判成离线 ⇒ 把"未知"当成"已排队"，同样是与事实不符）。
 * 若需即时准确值，请用回调式 `getNetKind(cb)`。
 */
export function currentNetKind(): NetKind {
	return _lastNetKind
}

/** 主动刷新缓存（幂等；模块加载时自动调用一次） */
export function refreshNetKind(): void {
	getNetKind((kind: NetKind) => {
		_lastNetKind = kind
	})
}

/** 绑定网络变化监听（幂等）——与 sync_schedule 的「网络恢复补跑」监听互补：
 *  这里只维护 cache，不触发任何业务副作用。 */
function _bindNetWatch(): void {
	if (_netWatchBound) {
		return
	}
	_netWatchBound = true
	try {
		uni.onNetworkStatusChange((res) => {
			if (!res.isConnected) {
				_lastNetKind = 'none'
				return
			}
			const t = res.networkType
			_lastNetKind = (t == 'wifi' || t == 'ethernet') ? 'wifi' : 'cellular'
		})
	} catch (e) {
		// 标准基座/不支持该 API 时降级为「仅首次探测」（幂等失败不影响主链）
		console.log('[yishu] onNetworkStatusChange 注册失败（降级为仅首次探测）: ' + e)
	}
	refreshNetKind()
}

// 模块加载即初始化（utt 顶层语句在本仓已有先例：uploader_batch 的网络恢复注册）
_bindNetWatch()

/** 按请求模式 + 实际网络解析上传模式：
 *  - original：强制原图（WiFi 默认 / "立即上传原图"手动入口）
 *  - thumbnail：缩略图+元数据（蜂窝省流；压缩与上传接线见 upload_pipeline.uts）
 *  - auto：WiFi→original；蜂窝→thumbnail；离线(none)/未知(unknown)→hold
 *  - hold：一律暂缓
 * 返回 'original' | 'thumbnail' | 'hold' */
export function resolveMode(mode: UploadMode, kind: NetKind): string {
	if (mode == 'original') {
		return 'original'
	}
	if (mode == 'thumbnail') {
		// 2026-10-16（A1 五步方案接线）：压缩步骤已在 upload_pipeline.uts 接好——
		// 蜂窝先 `uni.compressImage` 压缩略图再用同一协议上传（meta.upload_mode=thumbnail_meta），
		// 压缩失败由批量入口退回 held，**绝不拿原图冒充缩略图**。故本分支不再"恒 hold"。
		return 'thumbnail'
	}
	if (mode == 'hold') {
		return 'hold'
	}
	// auto
	if (kind == 'wifi') {
		return 'original'
	}
	if (kind == 'cellular') {
		// 2026-10-16（根因 RC-D 修复）：此处曾恒返回 'hold' ⇒ 蜂窝下**整批照片一张都不传**、
		// 全部挂起等 WiFi（"链路中段被恒假条件短路 ⇒ 蜂窝上传整体停摆"）。
		// B4 流量约束的本意是"蜂窝只传缩略图+元数据"，故改为 'thumbnail'：蜂窝也能上传（省流），
		// 原图待 WiFi 恢复由 continuePendingUploads 凭 meta.content_id 补传。
		return 'thumbnail'
	}
	// none / unknown：无网或网络类型不确定 ⇒ 暂缓。unknown 不能当"可省流上传"，
	// 否则离线空转（把"未知"当成"已排队"同样是状态与事实不符，见 currentNetKind 注）。
	console.log('[yishu] 网络不可用或未知（' + kind + '）：暂缓原图')
	return 'hold'
}


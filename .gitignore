# ============================================================
# 忆述光华 · .gitignore（2026-08-20 系统化重写）
# 原则：只上传 生产代码/测试代码/harness文档/设计文档；
#       本地隐私（API key、个人路径、构建缓存、语料数据）一律不上传。
# ============================================================

# --- 密钥与隐私（最高优先级，绝不入库）---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
local.properties
**/local.properties
*.local
secrets/
credentials/

# --- 语言构建缓存 ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
npm-debug.log*
package-lock.json.tmp

# Gradle / Android 构建（research/poc 用）
.gradle/
build/
*.apk
*.aab
*.wgt
*.hprof
.kotlin/

# --- 构建产物 ---
dist/
out/
*.exe
*.dmg
*.o
*.so
*.dll.bak

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- AI agent 工作区（本机会话产物，不入库）---
.cowork-temp/
.workbuddy/
.wt/
*.log
last-failure.json

# --- 数据库 / 备份 ---
*.dump
*.sha256
backups/*.dump
backups/*.sha256
*.sql.bak

# --- ML 模型与语料（可下载/可再生，不入库）---
backend/models/
*.safetensors
backend/checkpoints/
research/rag_benchmark/corpus.json
research/asr_bench/wav/
research/asr_bench/*.wav
*.onnx
*.pt
*.pth

# --- 个人截图/照片语料（隐私，绝不上传）---
research/**/Screenshots/
research/**/Pictures/
research/**/photos/
research/**/screenshots/
*.png.bak
*.jpg.bak

# --- 临时文件 ---
*.tmp
*.temp
*~
*.bak
*.bak.json
*.merge_bak

# --- 归档与本地 CLI 关联（2026-08-21 安全加固：含 workspaceId，不入库）---
backups/
.infisical.json

# 本地文件系统存储后端（STORAGE_BACKEND=fs）
backend/data/storage/
# --- 数据库文件 / 本地语料下载（2026-08-25 整理追加）---
*.db
*.sqlite
*.sqlite3
*.sql3
research/rag_benchmark/external/

# --- 会话与临时产物 ---
session-memory-*.md
# uni-app x / HBuilderX Android 构建残留（2026-08-26 系统性审查）
# ⚠️ 这些无锚点通配会连 client/ 工程真源一并吞（D-19 伴生雷）——
# 工程真源豁免三连统一放在本块末尾（gitignore 后匹配者胜，前置 ! 无效）。
AndroidManifest.xml
R.txt
classes.jar
annotations.zip
aidl/
# Android 解包产物（2026-08-27 收口补齐：res/ drawable* layout* values* META-INF ProGuard/资源索引）
res/
drawable/
drawable-*/
layout/
layout-*/
values/
values-*/
META-INF/
proguard.txt
public.txt
# D-19 伴生雷豁免（2026-09-10）：云打包 manifest 合并点=client/AndroidManifest.xml、
# nativeResources=官方静态资源注入通道——两真源必须可入库；根目录解包残留继续被上方忽略。
# 验证：git check-ignore client/AndroidManifest.xml → 不忽略；AndroidManifest.xml → 忽略
!client/AndroidManifest.xml
!client/nativeResources/
!client/nativeResources/**

# 后端联调敏感/临时文件
backend/token.txt
backend/.venv/
backend/pip_install*.log
backend/uvicorn*.log
backend/__pycache__/


backend/routes.txt


# 审查/部署证据留本地（36e0b64 铁律延伸）
review/out/

# --- 部署工程运行时产物（S1 卡 · 2026-09-21）---
# 数据卷 / 日志 / 真实环境文件：绝不入库
deploy/data/
deploy/logs/
deploy/backup/
deploy/.env
# ⚠️ 与本文件上方 `.env.*` 通配的冲突（同 client/AndroidManifest.xml 被吞的 D-19 伴生雷）：
#    `.env.*` 会连带吞掉**模板真源** deploy/.env.production.template（S3 卡交付物），
#    导致「文件写了、git 里却不存在」= diff 审查永久盲区。故在本文件末尾白名单豁免（后匹配者胜）。
# 验证：git check-ignore -v deploy/.env.production.template  → 应无输出（= 可入库）
#       git check-ignore -v deploy/.env                     → 应输出命中（= 被忽略，正确）
!deploy/.env.production.template
!deploy/.env.template

# --- 内测自有签名证书（C3 卡 · 2026-09-21）---
# 真源存放在仓库之外：%USERPROFILE%\.yishu-signing\（keystore + 密码说明 + 导出证书）
# 此处为防御性忽略：任何被误放进仓库的 keystore/私钥一律不得入库。
# 注：`*.jks` 已由本文件第 14 行（密钥与隐私块）覆盖，此处补 keystore 后缀变体。
*.keystore
*.keystore.bak

# --- 临时脚本/日志（一次性产物，不入库）---
# 为什么：一次性产物（E2E 运行日志、临时修/导出脚本）不入档会一直显示为未跟踪噪音，
# 并有被误 git add 进提交的风险（2026-09-23 实发生：_tmp/ag5_commit_msg.txt 被误入库）。
# 可复用的工具请放 scripts/（如 scripts/e2e_agent_chat.ps1，AG5 真代理 E2E）。
_tmp/

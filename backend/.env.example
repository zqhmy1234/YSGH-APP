# 忆述光华 backend 配置
# 复制为 .env 并填写真实值；.env 已被 .gitignore 排除

# --- 环境 ---
APP_ENV=development          # development / production
DEBUG=true
# CORS 白名单（逗号分隔；留空=开发/测试放开、生产同源）
CORS_ORIGINS=

# --- 服务 ---
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000

# --- 数据库（PostgreSQL 28 表）---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/yishu

# --- Redis / RQ（决策 #9）---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant 向量库（B2；BGE-M3 混合检索，Docker 容器 yishu-qdrant 6333）---
QDRANT_URL=http://localhost:6333

# --- JWT（决策 #8：access 2h + refresh 30d；密钥 ≥32 字节）---
JWT_SECRET=change-me-32-bytes-min-secret-0000
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=30
JWT_ALGORITHM=HS256

# --- 阿里云百炼（qwen-flash / 护栏，决策 #2 后端）---
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
# 可选：直接覆盖完整 API Host（优先级高于 WORKSPACE_ID + REGION）
DASHSCOPE_BASE_URL=

# --- 本地声学情绪（SenseVoice）---
# auto=主通道已有情绪则跳过本地；always=强制本地覆盖；off=关闭
ASR_LOCAL_EMOTION_MODE=auto
# 生产环境必须指向由 scripts/prepare_sensevoice.py 预置完成的目录
SENSEVOICE_MODEL_DIR=

# --- 腾讯云（COS STS 直传，决策 #10）---
# 子账号密钥：支持别名（TENCENT_SECRET_ID ↔ TENCENT_CI_SECRET_ID；
# TENCENT_SECRET_KEY ↔ TENCENT_GUANHAIFENG_CI_SECRET_KEY）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 腾讯云业务标识（非敏感，公开参数）
TENCENT_APPID=
# 可选：客户端直传 STS 角色（未配自动降级后端中转）
TENCENT_STS_ROLE_ARN=

# --- 对象存储后端（S5-03）---
# fake=内存（默认/测试）/ fs=本地文件系统（跨进程共享）/ minio=本地模拟 / cos=生产
STORAGE_BACKEND=fake
# fs 后端根目录（相对 backend/ 解析）
FS_STORAGE_ROOT=data/storage
# minio 本地模拟（Docker 启动，见 docs/COS开通与验证.md）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yishu-photos

# --- 百度 OCR（决策 #2 图片塔/OCR）---
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# --- 高德逆地理编码（B3-3，5000 次/日免费）---
AMAP_API_KEY=

# --- Sentry（决策 #12）---
SENTRY_DSN=

# --- Mock 模式 ---
# true 时所有外部 AI 调用走本地 mock（不产生费用），契约消费方可联调。
# 2026-08-26 生产安全默认 false（fail-closed：漏配不降级 mock 验证码）；
# dev/CI 联调显式设 true；测试套件由 conftest 自动强制 true。
MOCK_EXTERNAL_AI=false

# --- 企业微信客服回调（F6；沙箱测试凭证见 scripts/wecom_sandbox.py）---
WECHAT_CORP_ID=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# --- 微信开放平台 code2session 登录（决策 #8；未配置时 dev/test 走 mock、生产 501）---
# 小程序/公众号 AppID 与 AppSecret（开通「登录」能力，绑定微信开放平台才返回 unionid）
WECHAT_APPID=
WECHAT_SECRET=

# --- 用户内容安全审核（B5b #8 · Wave4-L：文本/图片审核适配器）---
# tencent_ci=当前顶替（文本=规则预检+护栏 / 图片=CI image_audit）；aliyun=上架前启用；off=关闭外部审核
CONTENT_SAFETY_PROVIDER=tencent_ci
# 阿里云内容安全（Green）AccessKey——⚠️ 非百炼 DashScope key，需阿里云账号 AccessKey + 开通「内容安全」服务
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_CONTENT_SAFETY_REGION=cn-beijing

# --- 检索 RAG 开关（B2 · 与 config.py 字段逐一对齐）---
# 第一层 bge-reranker 本地模型文件名（相对 backend/models/，目录不存在则跳过重排）
RERANKER_MODEL=bge-reranker-v2-m3
# 重排低相关过滤阈值（0=不过滤）
RERANK_MIN_SCORE=0.0
# 显式总开关：默认关（CPU 单对 ~850ms 超 P95<3s 门禁，GPU 部署可开）
RERANK_ENABLED=false
# 运行时自检自动启用（GPU+模型就绪 → 等效 enabled；CPU/缺失 → 保持关）
RERANK_AUTO_ENABLE=false
# 重排候选上限（防 CPU 延迟爆表）
RERANK_MAX_CANDIDATES=20
# 第二层 LLM 精排总开关（默认开，运行时按 llm_available 自门控）
RERANK_LLM_ENABLED=true
RERANK_LLM_CANDIDATES=10
RERANK_LLM_TOP_K=5
# P1-A 类目路由：描述性查询按规则词表分类 → content_class 过滤
CLASS_ROUTING_ENABLED=true
# P0-A LLM 改写/路由：prompt v2 有门控（短关键词原样返回）+ 双路召回 + 类目路由跑原查询
LLM_REWRITE_ENABLED=true

# 忆述光华 backend 配置
# 复制为 .env 并填写真实值；.env 已被 .gitignore 排除

# --- 环境 ---
APP_ENV=development          # development / production
DEBUG=true
# CORS 白名单（逗号分隔；留空=开发/测试放开、生产同源）
CORS_ORIGINS=

# --- 服务 ---
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000

# --- 数据库（PostgreSQL 28 表）---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/yishu

# --- Redis / RQ（决策 #9）---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant 向量库（B2；BGE-M3 混合检索，Docker 容器 yishu-qdrant 6333）---
QDRANT_URL=http://localhost:6333

# --- JWT（决策 #8：access 2h + refresh 30d；密钥 ≥32 字节）---
JWT_SECRET=change-me-32-bytes-min-secret-0000
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=30
JWT_ALGORITHM=HS256

# B-3 画像敏感话题加密：两把不同的 32 字节随机密钥，分别 base64 编码。
# 仅填入未跟踪的 backend/.env 或密钥管理系统；勿使用 JWT/refresh 密钥。
PROFILE_FIELD_ENCRYPTION_KEY=
PROFILE_FIELD_HMAC_KEY=

# --- 阿里云百炼（qwen-flash / 护栏，决策 #2 后端）---
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
# 可选：直接覆盖完整 API Host（优先级高于 WORKSPACE_ID + REGION）
DASHSCOPE_BASE_URL=

# --- 本地声学情绪（SenseVoice）---
# auto=主通道已有情绪则跳过本地；always=强制本地覆盖；off=关闭
ASR_LOCAL_EMOTION_MODE=auto
# 生产环境必须指向由 scripts/prepare_sensevoice.py 预置完成的目录
SENSEVOICE_MODEL_DIR=

# --- 腾讯云（COS STS 直传，决策 #10）---
# 子账号密钥：支持别名（TENCENT_SECRET_ID ↔ TENCENT_CI_SECRET_ID；
# TENCENT_SECRET_KEY ↔ TENCENT_GUANHAIFENG_CI_SECRET_KEY）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 腾讯云业务标识（非敏感，公开参数）
TENCENT_APPID=
# 可选：客户端直传 STS 角色（未配自动降级后端中转）
TENCENT_STS_ROLE_ARN=

# --- 对象存储后端（S5-03）---
# fake=内存（默认/测试）/ fs=本地文件系统（跨进程共享）/ minio=本地模拟 / cos=生产
STORAGE_BACKEND=fake
# fs 后端根目录（相对 backend/ 解析）
FS_STORAGE_ROOT=data/storage
# minio 本地模拟（Docker 启动，见 docs/COS开通与验证.md）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yishu-photos

# --- 百度 OCR（决策 #2 图片塔/OCR）---
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# --- 高德逆地理编码（B3-3，5000 次/日免费）---
AMAP_API_KEY=

# --- Sentry（决策 #12）---
SENTRY_DSN=

# --- 推送通道（B-02 · 2026-10-24：从 mock 升级为可配置的真实通道）---
# 背景：此前只有 MockPushChannel（只写 INFO 日志）且 set_push_channel() 零调用 ⇒
# 每日复盘 / 语音完成 / 胶囊到期等 push 消息**真实落库但手机端没有任何通知**
# （打开 App 进消息页能看到，锁屏什么都没有）。
# 现在：配了 PUSH_WEBHOOK_URL 就**真的 POST**（企业微信群机器人 / 自建中继 / 任意厂商网关），
# 未配置时**显式 WARNING + 计数**（`notify.push_delivery_stats()`），不伪装成功。
# ⚠️ 端上真正弹出系统通知仍需客户端接 push SDK（uni-push 等），本批**未接**——不谎称已闭环。
# 未配置 = 消息照常落库 + 仅 in-app 消息中心可见。
PUSH_WEBHOOK_URL=
# webhook 鉴权头（可选）：配了就带 `Authorization: Bearer <token>`，留空不带
PUSH_WEBHOOK_TOKEN=
# 单次推送超时（秒；推送是旁路，绝不能拖慢消息落库主链路）
PUSH_WEBHOOK_TIMEOUT_S=5.0

# --- Mock 模式 ---
# true 时所有外部 AI 调用走本地 mock（不产生费用），契约消费方可联调。
# 2026-08-26 生产安全默认 false（fail-closed：漏配不降级 mock 验证码）；
# dev/CI 联调显式设 true；测试套件由 conftest 自动强制 true。
MOCK_EXTERNAL_AI=false

# --- 企业微信客服回调（F6；沙箱测试凭证见 scripts/wecom_sandbox.py）---
WECHAT_CORP_ID=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# --- 微信开放平台 code2session 登录（决策 #8；未配置时 dev/test 走 mock、生产 501）---
# 小程序/公众号 AppID 与 AppSecret（开通「登录」能力，绑定微信开放平台才返回 unionid）
WECHAT_APPID=
WECHAT_SECRET=

# --- 内测期设备码登录通道（临时 · 2026-09-21；与 config.py allow_device_login 对齐）---
# false（默认）= fail-closed：POST /api/v1/auth/device 一律 501 AUTH_014，不泄露通道行为。
# true          = 内测期开启：客户端按 device_id 自助建档（20 人内测零 UI 改动的前提）。
# ⚠️ 上架前必须置回 false 并回收（docs/决策台账.md §1.13）。
ALLOW_DEVICE_LOGIN=false

# --- 用户内容安全审核（B5b #8 · Wave4-L：文本/图片审核适配器）---
# tencent_ci=当前顶替（文本=规则预检+护栏 / 图片=CI image_audit）；aliyun=上架前启用；off=关闭外部审核
CONTENT_SAFETY_PROVIDER=tencent_ci
# 用户**照片**的图片内容审核开关（D-24 · 2026-10-25 用户拍板「只审增量」）。
# 背景：实测全仓 check_image 只被微信链调用过 ⇒ 用户自己上传的照片**一张都没过图片审核**，
#       而 contents.sensitive_status 默认值是「正常」⇒ 造成「以为审了、其实没审」。
# 生效前提（缺一条就 skipped 且日志写明）：STORAGE_BACKEND=cos + provider≠off + 有 cos_key。
# ⚠️ 只审增量，**不回溯存量**；历史照片的 sensitive_status 仍可能是出厂默认值。
CONTENT_IMAGE_MODERATION_ENABLED=true
# 阿里云内容安全（Green）AccessKey——⚠️ 非百炼 DashScope key，需阿里云账号 AccessKey + 开通「内容安全」服务
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_CONTENT_SAFETY_REGION=cn-beijing

# --- 检索 RAG 开关（B2 · 与 config.py 字段逐一对齐）---
# BGE-M3 运行档位（2026-10-19 搜索性能治理②；详见 docs/性能验收_搜索_20261016.md）
# 空=自动（有 CUDA 用 GPU，否则 CPU）；显式填 cpu / cuda
BGE_DEVICE=
# CPU 线程数（默认 4；满核曾致 16GB 机器 OOM，调大须配合内存复测）
BGE_THREADS=4
# 启动期后台预热（部署/压测机建议 true；本地开发可留 false）
BGE_WARMUP_ON_START=false
# 照片 AI 描述（第二次 VL 调用，只写 ai_description 展示用，不参与检索向量）；
# 回填/限流/省钱时可设 false，少一次 Qwen3-VL 往返
PHOTO_DESCRIPTION_ENABLED=true
# 第一层 bge-reranker 本地模型文件名（相对 backend/models/，目录不存在则跳过重排）
RERANKER_MODEL=bge-reranker-v2-m3
# 重排低相关过滤阈值（0=不过滤）
RERANK_MIN_SCORE=0.0
# 显式总开关：默认关（CPU 单对 ~850ms 超 P95<3s 门禁，GPU 部署可开）
RERANK_ENABLED=false
# 运行时自检自动启用（GPU+模型就绪 → 等效 enabled；CPU/缺失 → 保持关）
RERANK_AUTO_ENABLE=false
# 重排候选上限（防 CPU 延迟爆表）
RERANK_MAX_CANDIDATES=20
# 第二层 LLM 精排总开关（默认开，运行时按 llm_available 自门控）
RERANK_LLM_ENABLED=true
RERANK_LLM_CANDIDATES=10
RERANK_LLM_TOP_K=5
# R-1 拒答地板：召回层稠密相似度低于此值的命中整条剔除，全低则返回空（"答不出来就不答"）。
# 0.0 = 关闭（保持既有行为）。⚠️ **当前不要开**：2026-10-09 在合成语料上标定，
# 任何阈值都无法同时满足 负样本误召回≤0.05 与 hit_rate@3≥0.70 —— 见
# research/rag_benchmark/r1_calibrate.py（含完整权衡表）。待 §2.1#3 扩真实语料后重标再定值。
RETRIEVAL_MIN_DENSE_SCORE=0.0
# answerability 拒答（2026-10-23）：LLM 精排明确判过的候选【全部】不可回答 → 返回空。
# 比调稠密阈值更贴近问题本质（利用正文语义），也不动 hit_rate@3：只要一条能回答就保留。
# false = 关闭（保持既有行为）。⚠️ 开启前提：真实 LLM（mock/无 key 时自动失效）+ 真实负样本
# ≥50 条验收；合成语料上的负样本数字不作数（理由同上面的 R-1）。
ANSWERABILITY_REJECT_ENABLED=false
# R-4 图片塔后端：bge_caption=现状（图片→Qwen3-VL caption→BGE-M3 编码，替代路径）；
# dashscope_vision=真图片塔（tongyi-embedding-vision-plus，需百炼「多模态向量」开通）。
# ⚠️ 两者是互不相通的向量空间 —— 切换前必须先用 scripts/rebuild_image_index.py
# 把已有图片点重灌，再改这里；否则新查询向量会与旧点混检索、排序全错。
# IMAGE_TOWER_BACKEND=bge_caption
# 视觉嵌入维度，必须等于 vector_store.VECTOR_SIZE(1024)，否则写入 Qdrant 报维度不符。
# IMAGE_TOWER_DIMENSION=1024
# P1-A 类目路由：描述性查询按规则词表分类 → content_class 过滤
# ⚠️ 2026-10-25 改 false（原为 true，与 config.py 默认值 False 不一致 —— **本就存在漂移**）。
# 实测：开/关的 hit@1 完全相同（0.8372）、hit@3 关掉还高 1 条；且词表曾含 14 个单字关键词
# 导致真查询被误过滤（A-06 的根因）。**方向：不继续维护这份手写词表。**
CLASS_ROUTING_ENABLED=false
# P0-A LLM 改写：**2026-10-25 默认改 false**（用户拍板）。
# 四档实测（n=43，两轮复跑）：改写关 + 精排开 = hit@1 0.907 / MRR 0.930 / P95 3335ms，
# 全面优于改写开（0.837 / 0.888 / 5150ms）——改写会把时间/地点限定词扩写掉导致向量漂移。
# ⚠️ **精排（RERANK_LLM_ENABLED）必须保留**：关掉会掉 2 条 hit@3。
LLM_REWRITE_ENABLED=false

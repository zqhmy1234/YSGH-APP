# 忆述光华 backend 配置
# 复制为 .env 并填写真实值；.env 已被 .gitignore 排除

# --- 环境 ---
APP_ENV=development          # development / production
DEBUG=true

# --- 服务 ---
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000

# --- 数据库（PostgreSQL 28 表）---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/yishu

# --- Redis / RQ（决策 #9）---
REDIS_URL=redis://localhost:6379/0

# --- JWT（决策 #8：access 2h + refresh 30d；密钥 ≥32 字节）---
JWT_SECRET=change-me-32-bytes-min-secret-0000
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=30

# --- 阿里云百炼（qwen-flash / 护栏，决策 #2 后端）---
DASHSCOPE_API_KEY=

# --- 腾讯云（COS STS 直传，决策 #10）---
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# --- 百度 OCR（决策 #2 图片塔/OCR）---
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# --- 高德逆地理编码（B3-3，5000 次/日免费）---
AMAP_API_KEY=

# --- Sentry（决策 #12）---
SENTRY_DSN=

# --- Mock 模式 ---
# true 时所有外部 AI 调用走本地 mock（不产生费用），契约消费方可联调
MOCK_EXTERNAL_AI=true

# --- 企业微信客服回调（F6；沙箱测试凭证见 scripts/wecom_sandbox.py）---
WECHAT_CORP_ID=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

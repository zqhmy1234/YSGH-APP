#!/bin/sh
# Pre-commit hook：调用代码质量审核 Agent
# 安装：git config core.hooksPath .githooks
# 失败时阻断 commit（不允许 --no-verify 绕过，见 AGENTS.md）

echo "=== [pre-commit] 代码质量审核 ==="
if ! python scripts/review_agent.py; then
    echo ""
    echo "!!! [pre-commit] 审核未通过 — 禁止提交"
    echo "    修复后重跑：python scripts/review_agent.py"
    echo "    报告：.cowork-temp/review-report.json"
    exit 1
fi
echo "=== [pre-commit] 审核通过 ==="
exit 0

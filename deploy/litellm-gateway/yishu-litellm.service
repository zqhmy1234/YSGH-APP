[Unit]
Description=YiShu LiteLLM Model Gateway
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/yishu/litellm
EnvironmentFile=/opt/yishu/litellm/.env
ExecStart=/opt/yishu/litellm/.venv/bin/litellm --config /opt/yishu/litellm/config.yaml --host 127.0.0.1 --port 4000
Restart=always
RestartSec=5
TimeoutStopSec=20
StandardOutput=append:/var/log/yishu-litellm.log
StandardError=append:/var/log/yishu-litellm.log

[Install]
WantedBy=multi-user.target

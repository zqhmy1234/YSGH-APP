# LiteLLM gateway environment. Copy to /opt/yishu/litellm/.env and chmod 600.
# Never commit real keys.

LITELLM_MASTER_KEY=sk-CHANGE_ME
LITELLM_SALT_KEY=sk-CHANGE_ME
DATABASE_URL=postgresql://litellm:CHANGE_ME@127.0.0.1:5432/litellm

# Upstream provider keys. Fill only the providers you have.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# DashScope workspace endpoint, e.g.
# https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Leave empty to use the public compatible endpoint.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================================================
# 忆述光华 · 生产环境变量模板（S3 卡 · 2026-09-21）
#
# 用法（在仓库根执行）：
#   cp deploy/.env.production.template deploy/.env
#   chmod 600 deploy/.env
#   # 按下方说明填入密钥（**只从 Infisical 取**：skills/infisical-secrets/SKILL.md）
#   bash deploy/scripts/deploy_one.sh
#
# ⚠️ 本文件承担**双重职责**（改一处须同步 `deploy/README.md` §3）：
#   ① 第 1 节 = docker compose 的容器参数（compose 自动读取 deploy/.env）
#   ② 第 2 节起 = **宿主侧**后端进程的环境（systemd 的 EnvironmentFile）
#
# ⚠️⚠️ 密钥纪律：本文件**入库且不含任何真实值**。真实密钥只进 `deploy/.env`（已 gitignore）。
#
# ⚠️ 必填项一律**保持注释状态**，不要留成 `KEY=`（空值）：
#   config.py 的生产兜底只拦「默认字符串」，**拦不住空串**——写成 `JWT_SECRET=` 会让服务
#   带着空签名密钥启动。保持注释 → 走字段默认值 → `_apply_production_safety` 直接抛错拒绝启动（fail-closed）。
#   （`POSTGRES_PASSWORD` 是唯一例外：compose 用 `${VAR:?}` 语法，留空会立刻报错，故写成空值即安全。）
# ============================================================================

# =========================== 1. 容器参数（compose 读取） ===========================
# 留空 POSTGRES_PASSWORD → compose 的 `${POSTGRES_PASSWORD:?}` 立刻中止并给出明确提示（既定行为）。
# bootstrap.sh 在 deploy/.env 缺失时会自动生成一份随机密码的最小版；此处仅供手工填写。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=yishu
# 三个依赖服务端口**只绑 127.0.0.1**；如宿主已有原生 PG 占用 5432，改这里（并同步下方 DATABASE_URL）
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# 后端监听端口（客户端 config.uts 的 getBaseUrl() 写死 8010，改动需两端同步）
API_PORT=8010

# 镜像与内存护栏（可留空走 compose 默认值；首次 bring-up 成功后建议把 QDRANT_IMAGE 回填为实际 tag/digest）
# POSTGRES_IMAGE=pgvector/pgvector:pg16
# REDIS_IMAGE=redis:7-alpine
# QDRANT_IMAGE=qdrant/qdrant:latest
# POSTGRES_MEM_LIMIT=768m
# REDIS_MEM_LIMIT=384m
# QDRANT_MEM_LIMIT=768m
# POSTGRES_MAX_CONNECTIONS=50
# WAL 归档 / PITR（RPO ≤5min）：**默认 off**（内测期 RPO ≤24h 由每日 dump 满足）。
# 开启步骤、目录属主要求与验证 SQL 见 deploy/RUNBOOK.md §6 —— 属主不对会让 archive_command 反复失败、
# PG 持续保留 WAL 直至 pg_wal 打满磁盘，故刻意不默认开启。
# PG_ARCHIVE_MODE=off
# PG_ARCHIVE_COMMAND=test ! -f /var/lib/postgresql/wal-archive/%f && cp %p /var/lib/postgresql/wal-archive/%f

# =========================== 2. 环境与服务 ===========================
APP_ENV=production
DEBUG=false
# CORS：生产默认空 = 同源（客户端是原生 App，不走浏览器 CORS；如将来有 Web 端再填）
CORS_ORIGINS=
HOST=0.0.0.0
PORT=8010
# 对外可达基址（生成链接/回调用）；内测期是明文 IP:端口，上架前换 https 域名
BASE_URL=http://<公网IP>:8010

# =========================== 3. 依赖服务连接串（宿主视角 = 127.0.0.1） ===========================
# ⚠️ 密码须与第 1 节 POSTGRES_PASSWORD 一致；若用 profile=app 跑容器内后端，HOST 要改服务名（见 README §3）
DATABASE_URL=postgresql+psycopg://postgres:<PG_PASSWORD>@127.0.0.1:5432/yishu
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333

# =========================== 4. 密钥（生产兜底强制项） ===========================
# 三项必须**互相独立**的强随机值（各自 `openssl rand -hex 32`）。
# 留注释 = 走默认值 = 启动时 RuntimeError 拒绝启动（fail-closed，见 config.py:_apply_production_safety）。
# JWT_SECRET=<必填>
# REFRESH_TOKEN_HMAC_KEY=<必填：独立于 JWT；JWT 密钥泄漏时 devices 表哈希仍不可构造>
# MEDIA_URL_SECRET=<必填：独立于 JWT；媒体票据（Valet Key）签名，留空会回退 jwt_secret（削弱"泄漏面隔离"）>
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=30
JWT_ALGORITHM=HS256
# 媒体票据双 TTL（缩略图长时效配合客户端缓存秒开；原图短时效防泄漏）
MEDIA_THUMB_TTL=86400
MEDIA_ORIGINAL_TTL=900

# =========================== 5. Mock（fail-closed） ===========================
# 生产强制 false：漏配不会降级为 mock（防 mock 验证码直返导致任意手机号账户接管）
MOCK_EXTERNAL_AI=false

# =========================== 6. 对象存储（内测期已拍板 = COS） ===========================
STORAGE_BACKEND=cos
COS_BUCKET=<必填：桶名>
COS_REGION=<必填：如 ap-shanghai>
TENCENT_SECRET_ID=<必填（Infisical）>
TENCENT_SECRET_KEY=<必填（Infisical）>
TENCENT_APPID=<必填：腾讯云账号 appid（公开参数）>
TENCENT_STS_ROLE_ARN=<建议：客户端直传 STS 角色；未配则上传走后端中转（带宽/磁盘压力上服务器）>
# 备用后端（仅在临时回退时启用，二者与 cos 三选一）
# STORAGE_BACKEND=fs
# FS_STORAGE_ROOT=data/storage
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=yishu-photos

# =========================== 7. 外部 AI / 位置 / OCR ===========================
# 百炼：LLM 改写/路由/精排 + 护栏 + 画像标注
DASHSCOPE_API_KEY=<必填（Infisical）>
DASHSCOPE_WORKSPACE_ID=<必填：sk-ws- 工作空间级 key 必须带此头，缺失会 403 Workspace access denied>
DASHSCOPE_REGION=cn-beijing
# DASHSCOPE_BASE_URL=   # 可选：直接覆盖完整 Host（优先级高于 WORKSPACE_ID + REGION）
# 高德逆地理（照片位置 → 地名；5000 次/日免费）
AMAP_API_KEY=<必填（Infisical）>
# 百度 OCR（图片塔备用通道）
BAIDU_API_KEY=<必填（Infisical）>
BAIDU_SECRET_KEY=<必填（Infisical）>
# 内容安全（US-44）：tencent_ci = 当前顶替；aliyun = 上架前启用；off = 不调外部审核
CONTENT_SAFETY_PROVIDER=tencent_ci
ALIYUN_ACCESS_KEY_ID=<上架前：阿里云「内容安全」AccessKey（⚠️ 不是百炼 key）>
ALIYUN_ACCESS_KEY_SECRET=<上架前：同上 SecretKey>
ALIYUN_CONTENT_SAFETY_REGION=cn-beijing
# Agent 服务（AG5 接线）：本后端**反代**调用独立的 agent 进程（客户端只认本后端 JWT）
# 默认指向同机 127.0.0.1:8300；agent 服务自身不鉴权用户身份，故绝不可暴露公网
AGENT_SERVICE_BASE_URL=http://127.0.0.1:8300
# 单轮对话超时（秒）：Agent 含多轮工具调用 + 推理，实测 76s 量级，故默认给足
AGENT_SERVICE_TIMEOUT_S=180.0
# AGENT_SERVICE_TOKEN=<与 agent 侧共享密钥；留空 = 不带 X-Agent-Token 头（仅限 localhost 部署可接受）>

# 本地自然日口径（D04-1 修复）：云侧"本地日"的单一来源（L1 日聚合 + 去年今日回响）。
# **不依赖容器 TZ**（未设 TZ 时容器为 UTC，沿用"服务器本地"会复现"沪区 0:00-8:00 落前一天"）。
# 值＝IANA 名；MVP 面向单城（沪）故默认 Asia/Shanghai；跨时区用户需 per-user 偏移（待拍板）。
APP_LOCAL_TZ=Asia/Shanghai

# =========================== 8. 本地模型（必须预置，否则首请求联网下载） ===========================
# auto = 主通道已有情绪则跳过本地；always = 强制本地覆盖；off = 关闭本地（省 ~0.6G 内存，见核算书 §2 降载预案）
ASR_LOCAL_EMOTION_MODE=auto
SENSEVOICE_MODEL_DIR=<必填：deploy/scripts/pull_models.sh 预置后的绝对路径>
# 检索 RAG（与 backend/.env.example 基线一致；GPU 且 P95<3s 探针通过才动第一层重排）
RERANKER_MODEL=bge-reranker-v2-m3
RERANK_MIN_SCORE=0.0
RERANK_ENABLED=false
RERANK_AUTO_ENABLE=false
RERANK_MAX_CANDIDATES=20
RERANK_LLM_ENABLED=true
RERANK_LLM_CANDIDATES=10
RERANK_LLM_TOP_K=5
CLASS_ROUTING_ENABLED=true
LLM_REWRITE_ENABLED=true

# =========================== 9. 内测期临时开关（上架前必须回收） ===========================
# 设备码登录通道（2026-09-21 拍板）：内测 20 人零 UI 改动，按 device_id 自助建档。
# 默认 false → POST /api/v1/auth/device 返回 501 AUTH_014。
# ⚠️ 上架前必须置回 false（决策台账 §1.13）。
ALLOW_DEVICE_LOGIN=true

# =========================== 10. 限流 ===========================
# 通用限流（auth/asr/search 三域）。直连（无反向代理）必须保持 trust_proxy=false——
# 否则 X-Forwarded-For 可被客户端伪造，限流维度失效。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=false
RATE_LIMIT_WHITELIST=
# 阈值留空走 config.py 默认（auth 120/300、asr 20/40、search 60/120）；调优前先看压测报告
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_AUTH_IP=120
# RATE_LIMIT_AUTH_USER=300
# RATE_LIMIT_ASR_IP=20
# RATE_LIMIT_ASR_USER=40
# RATE_LIMIT_SEARCH_IP=60
# RATE_LIMIT_SEARCH_USER=120

# =========================== 11. 可观测 ===========================
SENTRY_DSN=<必填（Infisical）>

# =========================== 12. 待接 key 项（不阻塞内测；接 key 即启用，后端已有 501 门控） ===========================
# 企业微信「微信客服」（F6 收/找）：缺 CORP_ID/TOKEN/AES_KEY 时回调验签必拒
# 别名：WECOM_CORP_ID / WECOM_TOKEN / WECOM_ENCODING_AES_KEY 亦可（D09-8 已支持）
# WECHAT_CORP_ID=
# WECHAT_TOKEN=            # 【回调 Token】自定随机串（用于验签/解密），**不是**应用 Secret
# WECHAT_CORP_SECRET=      # 【应用 Secret】企微后台生成，gettoken 用（D09-4；留空回退上面的 TOKEN ⇒ 媒体链必 40001）
# WECHAT_ENCODING_AES_KEY=
# 微信开放平台登录：未配 → dev/test 走 mock、**production 保持 501**（不静默降级）
# WECHAT_APPID=
# WECHAT_SECRET=
# 短信（阿里云）：⚠️ config.py 目前**无 SMS_* 配置项**，后端未接线，属预留备忘
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# uni-push（客户端侧配置，非 backend .env；此处仅备忘）
# UNI_PUSH_APPID=
# UNI_PUSH_APPKEY=
# UNI_PUSH_MASTER_SECRET=

# =========================== 13. 自证：模板与 config.py 是否仍对齐 ===========================
# 改 config.py 字段（新增/删除/改名）后**必须**跑一次；退出码 0 = 对齐：
#   python deploy/scripts/check_env_template.py
# 它会把「真缺口」（config 有、模板无）与「过期项」（模板有、config 已无）逐条列出，
# 并豁免两族本就不属于 config 的键：容器参数（POSTGRES_/REDIS_/QDRANT_/PG_/API_PORT）与待接 key 备忘（SMS_/UNI_PUSH_）。

# ============================================================================
# Local overrides for `deploy/compose.agent-v3.yml` (copy to deploy/.env).
# deploy/.env is gitignored. Production values live in the deployment system,
# never in this file.
# ============================================================================

# --- MinIO ---
# Docker Hub's minio/minio returns 403 through every mirror reachable from this
# network; the Bitnami build is the drop-in equivalent used locally.
# Leave unset in production to use the upstream image pinned in the compose file.
MINIO_IMAGE=docker.1panel.live/bitnami/minio:latest
MINIO_ROOT_USER=yishu
MINIO_ROOT_PASSWORD=local-v3-only-change-me

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-v3-only
POSTGRES_DB=yishu

# --- Host ports (all bound to 127.0.0.1) ---
V3_POSTGRES_PORT=55432
V3_REDIS_PORT=56379
V3_QDRANT_HTTP_PORT=56333
V3_QDRANT_GRPC_PORT=56334
V3_MINIO_PORT=59000
V3_MINIO_CONSOLE_PORT=59001
V3_AGENT_PORT=8300
V3_API_PORT=8010

# --- Service-to-service auth (agent <-> backend) ---
# Used twice: backend validates X-Agent-Token against it, agent sends it.
AGENT_SERVICE_TOKEN=local-agent-service-token
# Token protecting the agent's own endpoints (cards/models/chat). It MUST equal
# AGENT_SERVICE_TOKEN: the backend sends the same value as X-Agent-Token, and the
# agent validates it against AGENT_V3_TOKEN. Different values => 401 on every turn.
AGENT_V3_TOKEN=local-agent-service-token

# --- Agent -> backend L3 endpoints (inside the compose network) ---
AGENT_SEARCH_BASE_URL=http://backend:8010
AGENT_EVENT_BASE_URL=http://backend:8010
BACKEND_URL=http://backend:8010

# --- Lingqu model gateway (never put a real key in a committed file) ---
LINGQU_DEFAULT_PROFILE=deepseek/deepseek-v4.1-flash
COMPANY_LLM_BASE_URL=http://host.docker.internal:4001/v1
# export COMPANY_LLM_API_KEY="$(ssh yishu 'cat /opt/yishu/litellm/agent.key')"
COMPANY_LLM_API_KEY=

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POC-01 注册相册监听（然后去拍张照）" />

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POC-02 前台录音 10 秒（可灭屏）" />

        <Button
            android:id="@+id/btnSqlcipher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POC-04 SQLCipher 加密验证" />

        <Button
            android:id="@+id/btnAttribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POC-03 attribution 信息" />

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="（日志将显示在这里）\n" />
    </LinearLayout>
</ScrollView>

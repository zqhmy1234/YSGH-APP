# 忆光 - 企业微信版环境变量配置
# 复制此文件为 .env 并填写实际值

# ============================================
# 企业微信智能机器人配置
# ============================================

# 企业ID（在 企业微信管理后台 -> 我的企业 -> 企业信息 中获取）
WECHAT_CORP_ID=your_corp_id

# 应用Secret（在 企业微信管理后台 -> 应用管理 -> 智能机器人 -> 查看Secret 中获取）
WECHAT_CORP_SECRET=your_corp_secret

# Token（在机器人配置页面获取，用于消息加解密）
WECHAT_TOKEN=your_token

# EncodingAESKey（在机器人配置页面获取，用于消息加解密）
WECHAT_ENCODING_AES_KEY=your_encoding_aes_key

# 机器人ID（在机器人配置页面获取）
WECHAT_BOT_ID=your_bot_id

# ============================================
# 企业微信Webhook配置（用于主动推送消息）
# ============================================

# Webhook Key（在 企业微信 -> 群聊 -> 机器人 -> 查看Webhook 中获取）
WECHAT_WEBHOOK_KEY=your_webhook_key

# ============================================
# 定时复盘配置
# ============================================

# 复盘推送时间（24小时制）
REVIEW_HOUR=21
REVIEW_MINUTE=0

# ============================================
# 数据库配置（Supabase）
# ============================================

# Supabase URL（在 Supabase 项目设置中获取）
SUPABASE_URL=your_supabase_url

# Supabase API Key（在 Supabase 项目设置中获取）
SUPABASE_API_KEY=your_supabase_api_key

# ============================================
# LLM配置
# ============================================

# 模型API Key（从环境变量自动获取，无需配置）
# COZE_WORKLOAD_IDENTITY_API_KEY=auto

# 模型Base URL（从环境变量自动获取，无需配置）
# COZE_INTEGRATION_MODEL_BASE_URL=auto

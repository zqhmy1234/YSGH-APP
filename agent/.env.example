# Agent 服务环境变量模板（去 Coze 后 · 2026-09-23）
#
# 用法：复制为 agent/.env 并填值（.env 已被 agent/.gitignore 忽略，**永不入库**）。
# 与上游 .env.example 的差异见 agent/UPSTREAM.md「四、去 Coze 改造映射表」：
#   上游那份列的是 SUPABASE_*/WECHAT_*，且**代码实际读的是 COZE_***（三处不一致，见 UPSTREAM 五-4）。
#   本文件是改造后的**唯一真源**。

# ── 模型（阿里云百炼 · 官方依据见 src/llm_provider.py 文件头）──
# 模型 ID 实证：qwen3.8-flash（ctx 1,000,000；能力 TG+VU+Reasoning；features 含 function-calling）
#
# ⚠️⚠️ 账号口径（2026-10-04 实测修订，推翻 2026-09-23 的「必须用 Token Plan key」）
#   【原口径】必须填 Token Plan 账号的 key，`backend/.env` 里的是另一个账号，不可混用。
#   【为什么推翻】那条口径的前提是"Token Plan 账号能用qwen3.8-flash"，而实测**不成立**：
#     · Token Plan key（sk-sp-）+ token-plan 专属端点 ⇒ 唯一存在的模型 qwen3.8-flash
#       返回 **403 AccessDenied.Unpurchased**（key 有效、端点正确，是**套餐未开通该模型**）；
#       其余候选（qwen3-max / qwen3-coder-plus / qwen-plus / deepseek-v3 / glm-4.6 …）
#       全部 `model_not_found`（token-plan 端点只暴露套餐内模型）⇒ 换模型救不回来。
#     · backend 的工作空间级 key（sk-ws-）+ workspace 专属 Host ⇒ 同一模型**实测可用**
#       （qwen3.8-flash 2.7s / qwen3-max 2.1s）。
#     · 且 agent 与 backend **本就同库同账号**（DATABASE_URL 同为 yishu 库），LLM 共用账号
#       不违背架构。
#   【结论】agent 与 backend 共用**同一个工作空间级 key**：本文件填 backend/.env 那套
#   （`DASHSCOPE_API_KEY` + `DASHSCOPE_WORKSPACE_ID`），base_url 由 llm_provider 按前缀自动推导。
#
#   ⚠️⚠️ **启动前必须清掉继承来的 DASHSCOPE_***（用 `scripts/local_run.ps1`）：本机 shell 里
#   长期存在一个陈旧的系统级 DASHSCOPE_API_KEY（旧的 sk-sp- key），而本项目配置一律
#   `load_dotenv(override=False)`（**进程环境变量优先于 .env**，为容器注入留口）⇒
#   改了本文件也不生效，服务仍拿旧 key ⇒ 400 /403 鉴权错；同一个变量还会让**后端护栏**
#   401 → fail-closed → **每一句 AI 回复都被拦成 422**。这是 2026-10-04 定位到的
#   「AI 极不稳定」真根因，务必按脚本启动。
#
#   指纹核对（不可逆）：`python scripts/probe_model.py` 会打印 key 指纹与实际 base_url。
#
# ⚠️ **端点必须与 key 配对**（官方 error-code.md 原文：套餐专属 key "必须配合各自的专属 Base URL
#   使用，不可与通用 API Key/Base URL 混用（混用会返回本鉴权错误）"）。实测印证：
#   `sk-sp-` key + 公共端点 = **401 invalid_api_key**。本服务已按 key 前缀自动推导专属端点
#   （`src/llm_provider.py`），无需手填；只在用自建/私有化网关时才设 `DASHSCOPE_BASE_URL` 覆盖。
#
# ── 通用 OpenAI 兼容供应商（2026-10-08 W适配；DeepSeek / 任意兼容网关）──
# 三项同时配置即切换供应商，**优先级高于上面的 DASHSCOPE_* 同名项**；
# 切换后百炼专有行为（workspace header / enable_thinking extra_body）自动关闭。
# AGENT_LLM_API_KEY=sk-xxx
# AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
# AGENT_LLM_MODEL=deepseek-chat
#
# 优先级：**进程环境变量 > 本文件**（`load_dotenv(override=False)`）。若你已在系统环境变量里设置
#   DASHSCOPE_API_KEY，本文件可留空；但注意**已启动的进程不会感知新设的系统环境变量**，
#   需重启宿主进程（或直接写在本文件里，服务每次启动都会读）。
DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID **可选**：仅当 key 是**空间级**（`sk-ws-` 前缀）时必须填，
# 此时 base_url 走 `https://<id>.<region>.maas.aliyuncs.com/compatible-mode/v1` 且请求带
# X-DashScope-WorkSpace header；普通 key（Token Plan 为 `sk-sp-` 前缀）**留空**即走公共端点
# `https://dashscope.aliyuncs.com/compatible-mode/v1`。
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
# 可选：整体覆盖 base_url（默认由上面两项拼为
# https://<workspace-id>.<region>.maas.aliyuncs.com/compatible-mode/v1）
# DASHSCOPE_BASE_URL=
AGENT_LLM_MODEL=qwen3.8-flash
AGENT_ENABLE_THINKING=true
AGENT_LLM_TEMPERATURE=0.7
# ⚠️ 这三个默认值必须与 llm_provider.load_llm_settings 的实际口径一致（漂移过一次）：
#   max_tokens 2048（实测回复均百字内）、timeout 120 秒（超时快速失败好过长时间挂起）、
#   enable_thinking 默认 **true** —— 2026-10-04 A/B 实测开着反而更快（19.1s → 14.4s，
#   推理帮模型判断"这条已存过"从而少走工具循环，而工具循环才是延迟主因）。
#   要做对照实验设 AGENT_ENABLE_THINKING=0。
AGENT_LLM_MAX_TOKENS=2048
AGENT_LLM_TIMEOUT=120

# ── 数据库（我们自己的 Postgres；三表由 backend 的 alembic 建，见 AG3）──
# 与 backend/.env 的 DATABASE_URL 同库同账号
DATABASE_URL=

# ── backend 检索复用（W2 检索升级 · 2026-10-06）──
# search_memories 会把 backend 的 RAG 检索结果（App 侧 contents）与本地结果合并，
# 让 AI 页也能搜到用户在 App 里记的图文/语音。**这是增强不是依赖**：
# 不可达/未配置时静默降级为只搜本地表，对话照常。
#
# AGENT_BACKEND_BASE_URL 默认 http://127.0.0.1:8010 = **生产约定**（deploy 的
# API_PORT=8010）。**本地开发** backend 默认起在 8000，请显式设成 8000。
# AGENT_BACKEND_TOKEN 不设时回落用 AGENT_SERVICE_TOKEN 的值 —— 两个服务必须
# 配同一个值（backend 侧叫 agent_service_token，见 deploy/.env.production.template:124）。
# backend 侧未配置该 token 时会 503 fail-closed（这是有意为之：那条通道能以
# 任意用户身份检索，绝不裸奔），agent 侧相应降级。
AGENT_BACKEND_BASE_URL=http://127.0.0.1:8010
# AGENT_BACKEND_TOKEN=
AGENT_BACKEND_SEARCH_TIMEOUT_S=6
# 设 0 可整体关闭 backend 检索（只搜本地表）
# AGENT_BACKEND_SEARCH=1

# ── 对象存储（复用我们后端口径；预签名走 COS 原生能力，不再走 Coze /sign-url 代理）──
STORAGE_BACKEND=fs
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_ENDPOINT=

# ── 服务 ──
AGENT_HTTP_PORT=8300
AGENT_LOG_LEVEL=INFO

# ── 安全（2026-10-05 补齐：此前模板里完全没有这一段，运维无从得知必配项）──
#
# ⚠️ AGENT_SERVICE_TOKEN 是**共享密钥**，我们后端反代调用时放在 X-Agent-Token 头。
#    **未配置时服务不校验该头**（放行 + 记审计），这是本地开发的唯一合法场景；
#    一旦 APP_ENV=production 却没配它，服务**启动即失败**（fail-fast，好过跑起来裸奔）。
#    ⇒ 部署到公网/多人环境时这两项都必须配。
AGENT_SERVICE_TOKEN=
# APP_ENV=production          # 打开后强制要求上面的 token
#
# 单用户每分钟请求上限（超限返回 429，防单人打爆 LLM 配额）
AGENT_RATE_LIMIT_RPM=20
# thread_id 归属校验：1=必须由 user_id 派生（防跨用户读他人对话历史）；
# 确有不符合派生规则的历史会话可临时设 0 放宽，**每次放宽都会记审计**
AGENT_THREAD_ID_STRICT=1
# 工具循环上限（LangGraph recursion_limit）：撞上限时 agent 会捞回已生成的回复
AGENT_RECURSION_LIMIT=10
# 输出校验：最多几轮 + 整轮延迟预算（秒）。超预算即返回当前结果，不让用户干等
AGENT_MAX_ROUNDS=2
AGENT_VALIDATOR_BUDGET_S=20
# save_memory 近似判重的时间窗（分钟）；设 0 关闭第二级近似去重
AGENT_DEDUP_WINDOW_MIN=10
# 对话上下文（checkpointer）Postgres 连接池上限，1~16，默认 4。
# 说明：checkpoint 读写被 PostgresSaver 内部锁串行化，调大**不会**提升吞吐，
# 只会多占 DB 连接。调小到 1 可进一步省连接；池负责断连自愈，无需手动干预。
AGENT_MEM_POOL_MAX=4
# 调试开关：设 1 时工具结果会截断 400 字进日志（默认关闭，隐私纪律）
# AGENT_DEBUG_TOOL_RESULT=0

# ── 企微（2026-10-08 W5 拍板：agent 侧智能机器人链已删除，企微唯一入口 =
# backend「微信客服」，其配置在 deploy/.env.production.template，此处不再保留）──

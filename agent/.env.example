# Agent 服务环境变量模板（去 Coze 后 · 2026-09-23）
#
# 用法：复制为 agent/.env 并填值（.env 已被 agent/.gitignore 忽略，**永不入库**）。
# 与上游 .env.example 的差异见 agent/UPSTREAM.md「四、去 Coze 改造映射表」：
#   上游那份列的是 SUPABASE_*/WECHAT_*，且**代码实际读的是 COZE_***（三处不一致，见 UPSTREAM 五-4）。
#   本文件是改造后的**唯一真源**。

# ── 模型（阿里云百炼 · 官方依据见 src/llm_provider.py 文件头）──
# 模型 ID 实证：qwen3.8-flash（ctx 1,000,000；能力 TG+VU+Reasoning；features 含 function-calling）
#
# ⚠️⚠️ 账号口径（2026-09-23 用户更正）：**必须填 Token Plan 账号的 key**。
#   `backend/.env` 里的 DASHSCOPE_API_KEY 是**另一个账号**（后端既有用途），两者不可混用。
#   危险点：**填错账号不会报错**——两边都是有效 key，只是账号/额度/业务空间不同，
#   探针会"调用成功"从而假通过。故 `scripts/probe_model.py` 会打印 key 与 workspace 的**指纹**
#   （长度+前缀+sha256 前 8 位），请每次核对是否为 Token Plan 账号。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
# 可选：整体覆盖 base_url（默认由上面两项拼为
# https://<workspace-id>.<region>.maas.aliyuncs.com/compatible-mode/v1）
# DASHSCOPE_BASE_URL=
AGENT_LLM_MODEL=qwen3.8-flash
AGENT_ENABLE_THINKING=true
AGENT_LLM_TEMPERATURE=0.7
AGENT_LLM_MAX_TOKENS=4096
AGENT_LLM_TIMEOUT=600

# ── 数据库（我们自己的 Postgres；三表由 backend 的 alembic 建，见 AG3）──
# 与 backend/.env 的 DATABASE_URL 同库同账号
DATABASE_URL=

# ── 对象存储（复用我们后端口径；预签名走 COS 原生能力，不再走 Coze /sign-url 代理）──
STORAGE_BACKEND=fs
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_ENDPOINT=

# ── 服务 ──
AGENT_HTTP_PORT=8300
AGENT_LOG_LEVEL=INFO

# ── 企微（本轮不动，见 UPSTREAM 三·企微入口；启用时再填）──
# WECHAT_CORP_ID=
# WECHAT_CORP_SECRET=
# WECHAT_TOKEN=
# WECHAT_ENCODING_AES_KEY=
# WECHAT_BOT_ID=
# WECHAT_BOT_SECRET=
# REVIEW_HOUR=22
# REVIEW_MINUTE=0
